# ══ 畳み目 —— 「源のバイト → 規則の形」と「規則の形 → 機械語」を繋ぐ ══
#
# 上（33_self）は源のバイトから場・種・規則・ループ・項・ガード・座標を導く。
# 下（31_gen）はそれらを読んで静的 ELF を書く。**間にホストは居ない** ——
# 写しは場の名づけ直しであって、判断は一つも持たない。
#
# 導出の側は「文番号」で数え、生成の側は「規則番号」で数える。違うのは
# **並び順だけ**（規則は層の昇順に並べる）なので、鎖を二本引けば足りる。

# ── 場の一覧 ───────────────────────────────────────────────────────
field nfl : max bound 1                        # 場の数
nfl[0] <- 0                                     # 場の無い源もある（無いは 0）
nfl[z] <- fdno[t] + 1                for (t,zc) in ch for (z) in 0 .. 0 if isdcl[t]
field fdlat : max bound 1024                     # 場 f の束
fdlat[f] <- flatt[f]                for (f) in 0 .. nfdz[0]
field fdar : max bound 1024                      # 場 f の次数
fdar[f] <- farr[f]                  for (f) in 0 .. nfdz[0]
field fw : max bound 1024 2                         # 場 f の次元 d の広さ
fw[f,0] <- fwid[f]                  for (f) in 0 .. nfdz[0]
fw[f,1] <- fwid2[f]                 for (f) in 0 .. nfdz[0]

# ── 種の番号（文に沿った前置きの鎖）────────────────────────────────
field sdcnt : max bound 4096           # 文 s までに数えた種（s を含む）
sdcnt[s] <- 0                       for (s) in 0 .. nstz[0]
sdcnt[s] <- sdcnt[s-1]              for (s) in 1 .. nstz[0]
sdcnt[s] <- sdcnt[s-1] + 1          for (s) in 1 .. nstz[0] if isseed[s]
sdcnt[s] <- 1                       for (s) in 0 .. 0 if isseed[s]
field sdno : max bound 4096            # 種の番号（0 起点）
sdno[s] <- sdcnt[s] - 1             for (s) in 0 .. nstz[0] if isseed[s]
field nsd : max bound 1
nsd[z] <- sdno[s] + 1                for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if isseed[s]
# **番号は 4096 まで数えるのに、置き場は 1024 しか無かった。**
# `sdno` の bound と、その `sdno` で引く三つの場の bound は
# **同じ一つの判断**である。片方だけ 4096 に上げた日があり、もう片方は
# 1024 のまま残った —— 1024 本目の種を書いた日に、生成器は黙って
# 隣を踏み、焼けたプログラムは終了コード 6 で落ちた（知らせは無い）。
# 気づき34: 同じ判断を二箇所に書くと、片方だけ直る。
field sdf : max bound 4096
sdf[sdno[s]] <- sedf[s]             for (s) in 0 .. nstz[0] if isseed[s]
field sdc : max bound 4096
sdc[sdno[s]] <- 0                   for (s) in 0 .. nstz[0] if isseed[s]
sdc[sdno[s]] <- sedc[s]             for (s) in 0 .. nstz[0] if isseed[s]
field sdv : max bound 4096
sdv[sdno[s]] <- 0                   for (s) in 0 .. nstz[0] if isseed[s]
sdv[sdno[s]] <- sedv[s]             for (s) in 0 .. nstz[0] if isseed[s]

# ── 規則の番号。**層の昇順**（層ごとに数えて、層の頭を足す）────────────
field rcnt : max bound 4096 128          # 文 s までに層 k で数えた規則（s を含む）
rcnt[s,k] <- 0                      for (s) in 0 .. nstz[0] for (k) in 0 .. 127
rcnt[s,k] <- rcnt[s-1,k]            for (s) in 1 .. nstz[0] for (k) in 0 .. 127
rcnt[s,k] <- rcnt[s-1,k] + 1        for (s) in 1 .. nstz[0] for (k) in 0 .. 127
      if isrec[s] if rst[s] == k
rcnt[s,k] <- 1                      for (s) in 0 .. 0 for (k) in 0 .. 127
      if isrec[s] if rst[s] == k
field rtot : max bound 128               # 層 k の規則の数
# 層 k の規則の数は「最後の文までに数えた数」＝ **s についての最大**である
# （鎖は増える一方なので、最大がそのまま最後の値）。4095 番を読むのはやめる。
rtot[k] <- rcnt[s,k]                for (s) in 0 .. nstz[0] for (k) in 0 .. 127
field rbase : max bound 128              # 層 k の最初の規則番号（前置きの鎖）
rbase[0] <- 0
rbase[k] <- rbase[k-1] + rtot[k-1]  for (k) in 1 .. 127
field rno : max bound 4096             # 文 s の規則番号
rno[s] <- rbase[rst[s]] + rcnt[s,rst[s]] - 1
      for (s) in 0 .. nstz[0] if isrec[s]

field nrl : max bound 1                        # 規則の数
# **規則が一本も無い源もある**（宣言と種だけ）。数えるものが無いと数は ⊥ で、
# 命令の数（`nins` は規則の数から出る）まで ⊥ になり、焼けた実行ファイルは
# 符号を一つも持たずに segfault した。**無いは 0 である** —— 種で置く。
nrl[0] <- 0
nrl[z] <- rno[s] + 1                 for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if isrec[s]
field rrst : max bound 2048
rrst[rno[s]] <- rst[s]              for (s) in 0 .. nstz[0] if isrec[s]
field rrlt : max bound 2048
rrlt[rno[s]] <- rlt[s]              for (s) in 0 .. nstz[0] if isrec[s]
field rrar : max bound 2048
rrar[rno[s]] <- rarr[s]             for (s) in 0 .. nstz[0] if isrec[s]
field rrwf : max bound 2048
rrwf[rno[s]] <- hfz[s]              for (s) in 0 .. nstz[0] if isrec[s]
field rroo : max bound 2048                       # 書き先の座標を持つ出現
rroo[rsn[o]] <- o              for (o) in 0 .. nocz[0]
      if okk[o] == 2 if isrec[osn[o]]

# ── ループ。**通し番号は `for` に沿った鎖** ─────────────────────────
field isgl : or bound 589824            # 規則の for 節の `for`
isgl[t] <- true                     for (t,zc) in ch if kwfor[t] if isrec[snum[t]]
field glno : max bound 589824           # ループの通し番号
glno[t] <- 0                        for (t,zc) in ch
glno[t] <- glno[t-1] + 1            for (t,zc) in ch if t >= 1 if isgl[t-1]
glno[t] <- glno[t-1]                for (t,zc) in ch if t >= 1 if not isgl[t-1]
field ngl : max bound 1
ngl[z] <- glno[t] + 1               for (t,zc) in ch for (z) in 0 .. 0 if isgl[t]
field lpr : max bound 2048
lpr[glno[t]] <- rno[snum[t]]        for (t,zc) in ch if isgl[t]
field lpi : max bound 2048
lpi[glno[t]] <- lz[t]               for (t,zc) in ch if isgl[t]
field lpk : max bound 2048
lpk[glno[t]] <- lkd[snum[t], lz[t]]      for (t,zc) in ch if isgl[t]
field lplo : max bound 2048
lplo[glno[t]] <- 0                       for (t,zc) in ch if isgl[t]
lplo[glno[t]] <- llo2[snum[t], lz[t]]    for (t,zc) in ch if isgl[t]
field lphi : max bound 2048
lphi[glno[t]] <- 0                       for (t,zc) in ch if isgl[t]
lphi[glno[t]] <- lhi2[snum[t], lz[t]]    for (t,zc) in ch if isgl[t]
field lpar : max bound 2048
lpar[glno[t]] <- 0                       for (t,zc) in ch if isgl[t]
lpar[glno[t]] <- lar2[snum[t], lz[t]]    for (t,zc) in ch if isgl[t]
field lpbf : max bound 2048                       # 上端が場のとき、その場
lpbf[glno[t]] <- 0                       for (t,zc) in ch if isgl[t]
lpbf[glno[t]] <- lbf2[snum[t], lz[t]]    for (t,zc) in ch if isgl[t]
field lpbc : max bound 2048                       # その座標
lpbc[glno[t]] <- 0                       for (t,zc) in ch if isgl[t]
lpbc[glno[t]] <- lbc2[snum[t], lz[t]]    for (t,zc) in ch if isgl[t]

# ── ガード。**通し番号は節に沿った鎖**（規則をまたいで一本）──────────
# 一つの節が足すガードは 0 / 1 / 2（比較は左右で二本）。だから節ごとの
# 前置きの鎖が、そのまま通し番号の基になる —— 同じ規則のガードは
# 節が連続しているので必ず隣り合う。
field nclz : max bound 1               # 大域の節の数（最後の節番号）
nclz[z] <- gcl[t]                   for (t,zc) in ch for (z) in 0 .. 0
field gadd2 : max bound 65536          # 大域の節 c が足すガードの数
gadd2[c] <- 0                       for (c) in 0 .. nclz[0]
gadd2[gcl[t]] <- gadd[snum[t], cnum[t]]  for (t,zc) in ch if isrec[snum[t]]
field ggb : max bound 65536            # 節 c の最初のガードの通し番号
ggb[c] <- 0                         for (c) in 0 .. nclz[0]
ggb[c] <- ggb[c-1] + gadd2[c-1]     for (c) in 1 .. nclz[0]
field isgc : or bound 589824            # 規則のガードを持つ節の頭
isgc[t] <- true                     for (t,zc) in ch if cbrk[t] if isrec[snum[t]]
      if gadd[snum[t], cnum[t]] >= 1
field isgc2 : or bound 589824           # 二本足す節（比較）
isgc2[t] <- true                    for (t,zc) in ch if cbrk[t] if isrec[snum[t]]
      if gadd[snum[t], cnum[t]] == 2
field ngg : max bound 1
ngg[z] <- ggb[gcl[t]] + 1           for (t,zc) in ch for (z) in 0 .. 0 if isgc[t]
ngg[z] <- ggb[gcl[t]] + 2           for (t,zc) in ch for (z) in 0 .. 0 if isgc2[t]
field gdr : max bound 4096
gdr[gbt[t]] <- rno[snum[t]]         for (t,zc) in ch if isgc[t]
gdr[gbt[t] + 1] <- rno[snum[t]]     for (t,zc) in ch if isgc2[t]
field gdi : max bound 4096
gdi[gbt[t]] <- gno2[t]              for (t,zc) in ch if isgc[t]
gdi[gbt[t] + 1] <- gno2[t] + 1      for (t,zc) in ch if isgc2[t]
field gdk : max bound 4096
gdk[gbt[t]] <- gkd[snum[t], gno2[t]]          for (t,zc) in ch if isgc[t]
gdk[gbt[t] + 1] <- gkd[snum[t], gno2[t] + 1]  for (t,zc) in ch if isgc2[t]
field gdf : max bound 4096
gdf[gbt[t]] <- 0                              for (t,zc) in ch if isgc[t]
gdf[gbt[t]] <- gfd[snum[t], gno2[t]]          for (t,zc) in ch if isgc[t]
gdf[gbt[t] + 1] <- 0                          for (t,zc) in ch if isgc2[t]
gdf[gbt[t] + 1] <- gfd[snum[t], gno2[t] + 1]  for (t,zc) in ch if isgc2[t]
field gdc1 : max bound 4096
gdc1[gbt[t]] <- 0                             for (t,zc) in ch if isgc[t]
gdc1[gbt[t]] <- gc1[snum[t], gno2[t]]         for (t,zc) in ch if isgc[t]
gdc1[gbt[t] + 1] <- 0                         for (t,zc) in ch if isgc2[t]
gdc1[gbt[t] + 1] <- gc1[snum[t], gno2[t] + 1] for (t,zc) in ch if isgc2[t]
field gdgv : max bound 4096
gdgv[gbt[t]] <- 0                             for (t,zc) in ch if isgc[t]
gdgv[gbt[t]] <- ggv[snum[t], gno2[t]]         for (t,zc) in ch if isgc[t]
gdgv[gbt[t] + 1] <- 0                         for (t,zc) in ch if isgc2[t]
gdgv[gbt[t] + 1] <- ggv[snum[t], gno2[t] + 1] for (t,zc) in ch if isgc2[t]
field gdok : max bound 4096
gdok[gbt[t]] <- 0                             for (t,zc) in ch if isgc[t]
gdok[gbt[t]] <- gok2[snum[t], gno2[t]]        for (t,zc) in ch if isgc[t]
gdok[gbt[t] + 1] <- 0                         for (t,zc) in ch if isgc2[t]
gdok[gbt[t] + 1] <- gok2[snum[t], gno2[t] + 1] for (t,zc) in ch if isgc2[t]
field gdov : max bound 4096
gdov[gbt[t]] <- 0                             for (t,zc) in ch if isgc[t]
gdov[gbt[t]] <- gov[snum[t], gno2[t]]         for (t,zc) in ch if isgc[t]
gdov[gbt[t] + 1] <- 0                         for (t,zc) in ch if isgc2[t]
gdov[gbt[t] + 1] <- gov[snum[t], gno2[t] + 1] for (t,zc) in ch if isgc2[t]
field ocl : max bound 16384             # 出現 o の属する大域の節
ocl[o] <- gcl[otok[o]]              for (o) in 0 .. nocz[0] if oin[o]
field ogn : max bound 16384             # 出現 o の節のガード番号
ogn[o] <- gno2[otok[o]]             for (o) in 0 .. nocz[0] if oin[o]
field gdoo : max bound 4096                       # ガードの辺を持つ出現
gdoo[gbo[o]] <- o              for (o) in 0 .. nocz[0]
      if okk[o] == 1 if isrec[osn[o]] if oix[o] == ogn[o]
gdoo[gbo[o] + 1] <- o          for (o) in 0 .. nocz[0]
      if okk[o] == 1 if isrec[osn[o]] if oix[o] > ogn[o]

# ── 項。**通し番号はトークンに沿った鎖**（規則をまたいで一本）──────────
# 規則ごとの (規則, 番号) で持つと場が 2次元になり、位置の場を引くのに
# 二段の添字が要る —— 焼ける読みは一段の添字までである。項はトークンの
# 順で数えれば **同じ規則の項が必ず隣り合う**ので、鎖はこれで足りる。
field isgt : or bound 589824            # 規則の中の項のトークン
isgt[t] <- true                     for (t,zc) in ch if istm[t] if isrec[snum[t]]
field gtno : max bound 589824           # 項の通し番号
gtno[t] <- 0                        for (t,zc) in ch
gtno[t] <- gtno[t-1] + 1            for (t,zc) in ch if t >= 1 if isgt[t-1]
gtno[t] <- gtno[t-1]                for (t,zc) in ch if t >= 1 if not isgt[t-1]
field ngt : max bound 1
ngt[z] <- gtno[t] + 1               for (t,zc) in ch for (z) in 0 .. 0 if isgt[t]
field tmr : max bound 4096
tmr[gtno[t]] <- rno[snum[t]]        for (t,zc) in ch if isgt[t]
field tmi : max bound 4096
tmi[gtno[t]] <- tcnt[t]             for (t,zc) in ch if isgt[t]
field tmk : max bound 4096
tmk[gtno[t]] <- trkd[snum[t], tcnt[t]]   for (t,zc) in ch if isgt[t]
field tmf : max bound 4096
tmf[gtno[t]] <- 0                   for (t,zc) in ch if isgt[t]
tmf[gtno[t]] <- trfl[snum[t], tcnt[t]]   for (t,zc) in ch if isgt[t]
field tmc1 : max bound 4096
tmc1[gtno[t]] <- 0                  for (t,zc) in ch if isgt[t]
tmc1[gtno[t]] <- trcl[snum[t], tcnt[t]]  for (t,zc) in ch if isgt[t]
field tmv : max bound 4096
tmv[gtno[t]] <- 0                   for (t,zc) in ch if isgt[t]
tmv[gtno[t]] <- trvl[snum[t], tcnt[t]]   for (t,zc) in ch if isgt[t]
field tmoo : max bound 4096                       # 項の座標を持つ出現
tmoo[gtt[o]] <- o            for (o) in 0 .. nocz[0]
      if okk[o] == 0 if isrec[osn[o]]

# ── 座標。所有者は出現そのもの。**スロット（所有者×次元）にも通し番号**を
# 振る —— 位置の場 `cpos` を一次元にするためで、鎖は出現に沿って引ける。
field ncdo : max bound 16384            # 出現 o の次元の数
ncdo[o] <- 0                        for (o) in 0 .. nocz[0]
ncdo[o] <- 1                        for (o) in 0 .. nocz[0]
      if oin[o] if isrec[osn[o]] if c0sr[o] >= 0
ncdo[o] <- 2                        for (o) in 0 .. nocz[0]
      if oin[o] if isrec[osn[o]] if c0sr[o] >= 0 if has1[o]
field csb : max bound 16384             # 出現 o の最初のスロット番号（鎖）
csb[o] <- 0                         for (o) in 0 .. nocz[0]
csb[o] <- csb[o-1] + ncdo[o-1]      for (o) in 1 .. nocz[0]
field hasc : or bound 16384             # 座標を持つ出現
hasc[o] <- true                     for (o) in 0 .. nocz[0]
      if oin[o] if isrec[osn[o]] if c0sr[o] >= 0
field hasc2 : or bound 16384            # 次元1 も持つ
hasc2[o] <- true                    for (o) in 0 .. nocz[0] if hasc[o] if has1[o]
field now : max bound 1                        # 所有者の数
now[z] <- o + 1                     for (o) in 0 .. nocz[0] for (z) in 0 .. 0 if oin[o]
field ngc : max bound 1                        # スロットの総数
ngc[z] <- csb[o] + 1                for (o) in 0 .. nocz[0] for (z) in 0 .. 0 if hasc[o]
ngc[z] <- csb[o] + 2                for (o) in 0 .. nocz[0] for (z) in 0 .. 0 if hasc2[o]
field cso : max bound 16384
cso[csb[o]] <- o                    for (o) in 0 .. nocz[0] if hasc[o]
cso[csb[o] + 1] <- o                for (o) in 0 .. nocz[0] if hasc2[o]
field csd : max bound 16384
csd[csb[o]] <- 0                    for (o) in 0 .. nocz[0] if hasc[o]
csd[csb[o] + 1] <- 1                for (o) in 0 .. nocz[0] if hasc2[o]
field cdr : max bound 16384
cdr[csb[o]] <- rno[osn[o]]          for (o) in 0 .. nocz[0] if hasc[o]
cdr[csb[o] + 1] <- rno[osn[o]]      for (o) in 0 .. nocz[0] if hasc2[o]
field cdsr : max bound 16384
cdsr[csb[o]] <- c0sr[o]             for (o) in 0 .. nocz[0] if hasc[o]
cdsr[csb[o] + 1] <- c1sr[o]         for (o) in 0 .. nocz[0] if hasc2[o]
field cdcf : max bound 16384
cdcf[csb[o]] <- 0                   for (o) in 0 .. nocz[0] if hasc[o]
cdcf[csb[o]] <- c0cf[o]             for (o) in 0 .. nocz[0] if hasc[o]
cdcf[csb[o] + 1] <- 0               for (o) in 0 .. nocz[0] if hasc2[o]
cdcf[csb[o] + 1] <- c1cf[o]         for (o) in 0 .. nocz[0] if hasc2[o]
# ── **内側の読みが二次元なら、内側の出現そのものを所有者にする** ───────
#  `o[p[i,j]]` の `p[i,j]` は二次元の読みである。源2/3 は内側の次元を一本しか
#  持てないので、内側の次元1 が黙って落ちて **別の升を読んでいた**
#  （o[0] と o[1] にしか書かない）。だが内側の出現はもう所有者の番号を持ち、
#  座標のスロットも持っている —— 外側は **源5 でその番号を指す**だけでよい。
#  表に列は一つも増えない（気づき23: 形を足すのに列を足すな）。
field d1to : max bound 16384            # 出現 o の次元1 の索引トークン
d1to[o] <- d1t[otok[o]]             for (o) in 0 .. nocz[0] if hasc2[o]
field in2a : max bound 16384            # 次元0 の索引が指す内側の出現
in2a[o] <- oseq[otok[o] + 2]        for (o) in 0 .. nocz[0] if hasc[o]
      if c0sr[o] >= 2 if c0sr[o] <= 3
field in2b : max bound 16384            # 次元1 の索引が指す内側の出現
in2b[o] <- oseq[d1to[o]]            for (o) in 0 .. nocz[0] if hasc2[o]
      if c1sr[o] >= 2 if c1sr[o] <= 3
field innr0 : or bound 16384            # 次元0 の内側の読みが二次元
innr0[o] <- true                    for (o) in 0 .. nocz[0] if hasc[o]
      if in2a[o] >= 0 if has1[in2a[o]]
field innr1 : or bound 16384            # 次元1 の内側の読みが二次元
innr1[o] <- true                    for (o) in 0 .. nocz[0] if hasc2[o]
      if in2b[o] >= 0 if has1[in2b[o]]
cdsr[csb[o]] <- 5                   for (o) in 0 .. nocz[0] if innr0[o]
cdsr[csb[o] + 1] <- 5               for (o) in 0 .. nocz[0] if innr1[o]
field cdcc : max bound 16384
cdcc[csb[o]] <- 0                   for (o) in 0 .. nocz[0] if hasc[o]
cdcc[csb[o]] <- c0cc[o]             for (o) in 0 .. nocz[0] if hasc[o]
      if not innr0[o]
cdcc[csb[o]] <- in2a[o]             for (o) in 0 .. nocz[0] if innr0[o]
cdcc[csb[o] + 1] <- 0               for (o) in 0 .. nocz[0] if hasc2[o]
cdcc[csb[o] + 1] <- c1cc[o]         for (o) in 0 .. nocz[0] if hasc2[o]
      if not innr1[o]
cdcc[csb[o] + 1] <- in2b[o]         for (o) in 0 .. nocz[0] if innr1[o]
field cdhf : max bound 16384
cdhf[csb[o]] <- 0                   for (o) in 0 .. nocz[0] if hasc[o]
cdhf[csb[o]] <- c0hf[o]             for (o) in 0 .. nocz[0] if hasc[o]
cdhf[csb[o] + 1] <- 0               for (o) in 0 .. nocz[0] if hasc2[o]
cdhf[csb[o] + 1] <- c1hf[o]         for (o) in 0 .. nocz[0] if hasc2[o]
field cdof : max bound 16384
cdof[csb[o]] <- 0                   for (o) in 0 .. nocz[0] if hasc[o]
cdof[csb[o]] <- c0of[o]             for (o) in 0 .. nocz[0] if hasc[o]
cdof[csb[o] + 1] <- 0               for (o) in 0 .. nocz[0] if hasc2[o]
cdof[csb[o] + 1] <- c1of[o]         for (o) in 0 .. nocz[0] if hasc2[o]

# ── 口。**二列の表は (位置, バイト) と読む** ────────────────────────
# これは導出ではなく **約束**である（源のどこにも「生バイトで読む」とは
# 書いていない）。三列以上の表は 8バイト小端の列として読む。
# 表が二つ以上なら口を 0 にする —— 生成器はそれを「焼けない」と読む
field inpw : min bound 1 bound 1
inpw[0] <- 8
inpw[z] <- 1                         for (z) in 0 .. 0 for (z) in 0 .. 0 if ncol[z] == 2
inpw[z] <- 0                         for (z) in 0 .. 0 for (z) in 0 .. 0 if ntb[0] >= 2
# 源が断片の外だと分かったときも 0 —— 生成器はそれを「焼けない」と読む
inpw[z] <- 0                         for (z) in 0 .. 0 for (z) in 0 .. 0 if onod[0]
inpw[z] <- 0                         for (z) in 0 .. 0 for (z) in 0 .. 0 if not hastb[0]
# **名前は 16 文字まで。** 鍵は 8 文字を二本ぶんしか持てないので、
# 17 文字以上は綴りが違っても同じ鍵になる —— 黙って間違えるより言う。
inpw[z] <- 0                         for (t,zc) in ch for (z) in 0 .. 0 if isocc[t] if tlen[t] >= 17
inpw[z] <- 0                         for (t,zc) in ch for (z) in 0 .. 0 if isdcl[t] if tlen[t] >= 17
# **入れ子は三重まで。** 計数器は rcx / r13 / r14 の三本しかない ——
# 四重目は黙って壊れた符号（segfault）になっていた。
inpw[z] <- 0                         for (t,zc) in ch for (z) in 0 .. 0 if isgl[t] if lz[t] >= 3
# **項は八つまで。** 九つ目は `trkd[文, 番号]` が隣の文の枠を踏み、
# 答えが黙って変わっていた（`1+1+…+1` 九個が 9 でなく 13 になった）。
inpw[z] <- 0                         for (t,zc) in ch for (z) in 0 .. 0 if isgt[t] if tcnt[t] >= 8

# ── **どこが悪いかを言う。** 行番号と理由を生成器へ渡す ──────────────
#   1 名前が 17 文字以上 / 2 入れ子が四重以上 / 3 項が九つ以上
#   4 宣言の無い場を読んだ / 5 二のべきでない除数 / 6 表が無い・二つ以上
#   7 成層できない / 8 焼けない形（項・ガード・座標・ループ・規則・種）
# **`lnum` は文字位置の索引、`t` はトークン番号。** 取り違えると
# 「別の行」が出る（黙って間違う）—— トークンの始まる位置を一度置く。
field tlin : min bound 589824                     # トークン t の書かれた行
tlin[t] <- lnum[tstart[t]]           for (t,zc) in ch
# `rlin[rno[snum[t]]]` は **三段の読み**で書けない —— 名前を一つ置く。
field snr : max bound 589824                      # トークン t の文の規則番号
snr[t] <- rno[snum[t]]               for (t,zc) in ch if isrec[snum[t]]
field rlin : min bound 2048                       # 規則 r の書かれた行
rlin[snr[t]] <- tlin[t]              for (t,zc) in ch if isrec[snum[t]]
# **行と理由を別々の min で選ぶと、対が揃わない。** 一方は行の最小、
# もう一方は理由の最小で、違う場所のものが並びうる。**一つの鍵に畳む**
# （行 * 16 + 理由）—— min は鍵の最小を取るので、行が最小のものの中で
# 理由が最小のものが出る。対は構造上ずれない（気づき42 の三度目）。
# **知らない文は、黙って読み飛ばしてはいけない。** `constructor` も
# `include` も `use` も `budget` も、断片は実装していないのに素通しして
# いた —— 焼けた実行ファイルは segfault した（14_iosig / 20_lex_full）。
# 断片が知っているのは四つの頭（`table` / `field` / `render` / `print`）と
# **矢印のある文**（種と規則）だけである。それ以外は焼かずに言う。
field sknown : or bound 4096                      # 文 s は断片が知っている種類
sknown[snum[t]] <- true  for (t,zc) in ch if sbrk[t] if kwtbl[t]
sknown[snum[t]] <- true  for (t,zc) in ch if sbrk[t] if kwfld[t]
sknown[snum[t]] <- true  for (t,zc) in ch if sbrk[t] if kwrnd[t]
sknown[snum[t]] <- true  for (t,zc) in ch if sbrk[t] if kwprn[t]
sknown[s] <- true        for (s) in 0 .. nstz[0] if arrowt[s] >= 0
field sunk : or bound 4096                        # 知らない種類（否定は層を切る）
sunk[s] <- true          for (s) in 0 .. nstz[0] if not sknown[s]

field badk : min bound 1                          # 最初に焼けなかった (行 * 16 + 理由)
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if sbrk[t] if sunk[snum[t]]
badk[z] <- tlin[t] * 16 + 1   for (t,zc) in ch for (z) in 0 .. 0 if isocc[t] if tlen[t] >= 17
badk[z] <- tlin[t] * 16 + 1   for (t,zc) in ch for (z) in 0 .. 0 if isdcl[t] if tlen[t] >= 17
badk[z] <- tlin[t] * 16 + 2   for (t,zc) in ch for (z) in 0 .. 0 if isgl[t] if lz[t] >= 3
badk[z] <- tlin[t] * 16 + 3   for (t,zc) in ch for (z) in 0 .. 0 if isgt[t] if tcnt[t] >= 8
badk[z] <- tlin[otok[o]] * 16 + 4   for (o) in 0 .. nocz[0] for (z) in 0 .. 0 if oin[o] if not ohas[o]
badk[z] <- 6        for (z) in 0 .. 0 for (z) in 0 .. 0 if ntb[0] >= 2
badk[z] <- 6        for (z) in 0 .. 0 for (z) in 0 .. 0 if not hastb[0]
# **同じ名前を二度宣言したら言う**（理由 A）。解釈実行は「redeclared」と断る。
# 焼いた側は二つの宣言を別々の場として置き場を数え、出現は鍵の合う宣言の
# **番号の大きい方**を指す（`ofl` は max）—— 数え方と指し方が食い違い、
# 焼けた実行ファイルは **segfault** していた（声ではない）。
field ddup : or bound 1024                        # 宣言 d は前の宣言と同じ名前
ddup[d] <- true   for (d) in 0 .. ndcz[0] for (e) in 0 .. ndcz[0] if din[d] if din[e]
      if e < d if dkey[e] == dkey[d] if dkey2[e] == dkey2[d]
badk[z] <- tlin[t] * 16 + 10  for (t,zc) in ch for (z) in 0 .. 0 if isdcl[t]
      if ddup[dseq[t]]
# **or の値は `true` か or の読み一つ**（理由 9）。`true + none[i]` を解釈実行は
# 断るのに、焼く側は `true` を項と見ないので `none[i]` だけを焼いていた。
badk[z] <- tlin[t] * 16 + 9   for (t,zc) in ch for (z) in 0 .. 0 if vop[t] if sor[snum[t]]
# **集約の規則はループ一つまで**（理由 8）。sum / count の「一度だけ数える印」は
# 外側の表の行（rcx）でしか引いていない —— 二重のループでは内側の実例が同じ印を
# 踏み、`for (i,c) in ch for (k) in 0 .. 2` の count が 12 でなく 4 になっていた。
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if kwfor[t] if lseq[t] >= 2
      if sagg[snum[t]]
# **形の崩れた源は焼かない**（理由 8）。解釈実行は構文で断るのに、焼く側は
# 頭の無い矢印の文（`ri] <- …`）を規則でないものとして黙って落とし、答えを出していた。
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if sbrk[t]
      if arrowt[snum[t]] >= 0 if not hasr[snum[t]]
# 括弧が閉じないまま次の文に入った（あるいは閉じすぎた）
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if sbrk[t] if tdep[t] != 0
field lastc : max bound 1                         # 源の最後の文字
lastc[z] <- i                 for (i,c) in ch for (z) in 0 .. 0
badk[z] <- lnum[lastc[z]] * 16 + 8   for (z) in 0 .. 0 if pre[lastc[z]] != 0
# **同じ場を一次元と二次元の両方で使ったら言う**（理由 8）。解釈実行は `q[i]` と
# `q[i,k]` を別の鍵として持つが、焼く側の置き場は場ごとに次数が一つしか無く、
# 一次元の書き込みを二次元の面に黙って畳んでいた。
field obk : or bound 589824                       # `[` の付いた出現（描画・print の名は除く）
obk[t] <- true   for (t,zc) in ch if isocc[t] if tch[t+1,0] == 91
field fuse1 : or bound 1024                       # 場 f を一次元で使った
fuse1[ixcf[t]] <- true   for (t,zc) in ch if obk[t] if not iscom[d0cm[t]]
field fuse2 : or bound 1024                       # 場 f を二次元で使った
fuse2[ixcf[t]] <- true   for (t,zc) in ch if obk[t] if iscom[d0cm[t]]
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if obk[t]
      if fuse1[ixcf[t]] if fuse2[ixcf[t]]
# **種の座標は宣言の広さの内側**（理由 B）。種は規則と違って走るときに濾さず、升へ
# 直に置く —— `r[5] <- 7`（r は bound 4）が **隣の場の升に 7 を置いていた**（解釈実行は
# 広さを見ないので r[5] = 7、焼いた側は s[1] = 7）。種の座標は数なので、焼くときに分かる。
# 数でない種の座標（`r[k] <- 7` で k が束縛されていない）は解釈実行が断るので、焼かない（理由 8）。
field sdbad : or bound 4096                       # 種 s の座標が広さの外
sdbad[s] <- true   for (s) in 0 .. nstz[0] if isseed[s] if tval[hotok[s] + 2] >= fwid[hfz[s]]
sdbad[s] <- true   for (s) in 0 .. nstz[0] if isseed[s] if h2d[s]
      if tval[hotok[s] + 4] >= fwid2[hfz[s]]
badk[z] <- tlin[hotok[s]] * 16 + 11   for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if sdbad[s]
field sdnum : or bound 4096                       # 種 s の座標は数（一つだけ。`d[0+1]` は式）
sdnum[s] <- true   for (s) in 0 .. nstz[0] if isseed[s] if isnum[hotok[s] + 2] if not h2d[s]
      if isclo[hotok[s] + 3]
sdnum[s] <- true   for (s) in 0 .. nstz[0] if isseed[s] if isnum[hotok[s] + 2] if h2d[s]
      if iscom[hotok[s] + 3] if isnum[hotok[s] + 4] if isclo[hotok[s] + 5]
badk[z] <- tlin[hotok[s]] * 16 + 8   for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if isseed[s]
      if hasr[s] if not sdnum[s]
# **種の値は数か `true` 一つ**（理由 8）。種は矢印の次の語だけを置く（`sedvt`）ので、
# `t[0] <- 1 + 2` は 1、`t[0] <- u[0]` は何も置かず、黙って違う答えになっていた。
badk[z] <- tlin[hotok[s]] * 16 + 8   for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if isseed[s]
      if hasr[s] if not isnum[sedvt[s]] if not kwtru[sedvt[s]]
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if vop[t] if isseed[snum[t]]
# **or の種も `true`**（理由 9）。規則の値は見ていたが、種は見ていなかった。
badk[z] <- tlin[hotok[s]] * 16 + 9   for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if isseed[s]
      if sor[s] if not kwtru[sedvt[s]]
# **区間の上端は数か `f[数]` だけ**（理由 8）。`for (j) in 0 .. n[i] - 1` を焼く側は
# `n[?]` と読み、`i` も `- 1` も黙って落として 3,3,3 を答えていた（解釈実行は 2,0,1。
# `work/t/z_depint.lx` —— 変異の種に本を足したら出た）。for 節の、括弧の外の演算子と、
# 上端の場の添字が数でないものを断る。
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if isop[t] if tdep[t] == 0
      if cnum[t] >= 1 if not clif2[snum[t], cnum[t]]
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if kwin[t] if isnum[int1[t]]
      if isocc[int4[t]] if not isnum[int4b[t]]
# **三次元の場は焼かない**（理由 8）。次数は一か二しか数えていないので、`w[i,j,k]` の
# k を黙って落とし、升を取り違えていた（`work/t/z_dim2rd.lx`）。次元1 の添字の後ろに
# もう一つ `,` があれば三次元である。
field ix1e : max bound 589824                     # 次元1 の添字の終わり（ずれ込み）
ix1e[t] <- ixend[d1t[t]]  for (t,zc) in ch if isocc[t] if iscom[d0cm[t]] if not ixhf[d1t[t]]
ix1e[t] <- ixnm[d1t[t]]   for (t,zc) in ch if isocc[t] if iscom[d0cm[t]] if ixhf[d1t[t]]
field d1cm : max bound 589824                     # 次元1 の直後の語
d1cm[t] <- nextw[ix1e[t]] for (t,zc) in ch if isocc[t] if iscom[d0cm[t]]
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if isocc[t] if iscom[d1cm[t]]
# **前置と後置のずれを一つの行に両方は持てない**（`k[k[i+1] - 1]`）。座標の行はずれを
# 一つしか持たず、二つが max で混ざって別の升を読んでいた。焼かずに言う（理由 8）。
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if isocc[t]
      if ixhf[t+2] if ixpr2[t+2]
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if isocc[t] if iscom[d0cm[t]]
      if ixhf[d1t[t]] if ixpr2[d1t[t]]
# **数は符号つき 32 ビットの即値に収まる所まで**（理由 C）。焼いた符号は定数を即値で
# 持つので、`x[0] <- 3000000000` が -1294967296 になっていた（解釈実行は大きい数をそのまま
# 持つ）。割る数・余りの数は二のべきで、即値ではなく「ずらし」と「覆い」になるので
# 大きくてよい（`/ 4294967296`）。表の行は走るときに 8 バイトで読むので関わらない。
# （閾は `> 2147483647` と書く —— `>= 2147483648` と書いたら、その 2147483648 自身が即値に
# 収まらず -2147483648 に化け、焼き手はすべての数を「大きすぎる」と言った。穴が自分を踏んだ。）
badk[z] <- tlin[t] * 16 + 12   for (t,zc) in ch for (z) in 0 .. 0 if isnum[t] if not tcom[t]
      if tval[t] > 2147483647 if not pdiv[t] if not pmod[t] if not istb[snum[t]]
badk[z] <- tlin[t] * 16 + 12   for (t,zc) in ch for (z) in 0 .. 0 if isnum[t] if not tcom[t]
      if tlen[t] >= 11 if not pdiv[t] if not pmod[t] if not istb[snum[t]]
# **種の値が印と重なるなら焼かない**（理由 D）。種は升に直に置くので、走るときの見張り
# （終了コード 4）を通らない。min と flat の ⊥ の印 2147483647、flat の ⊤ の印 2147483646。
# （max の ⊥ は負で、種の値は数なので重ならない。）
badk[z] <- tlin[hotok[s]] * 16 + 13   for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if isseed[s]
      if sdn[s] if sedv[s] == 2147483647
badk[z] <- tlin[hotok[s]] * 16 + 13   for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if isseed[s]
      if flatt[hfz[s]] == 6 if sedv[s] >= 2147483646
# **焼けない束は宣言の行で言う**（理由 8）。断片の束は六つ（min / max / or /
# flat / sum / count）。set / and / fourv / bag を宣言の行で断らないと、その場を
# 読む規則で **別の理由が先に出る** —— fourv の `not` は Belnap の否定で単調なのに、
# 断片はそれを否定として数え、「成層できない」（理由 7）と言っていた。断るのは
# 正しいが、理由が嘘である。
field dknown : or bound 589824                    # 宣言 t の束を断片が知っている
dknown[t] <- true   for (t,zc) in ch if isdcl[t] if flatt[fdno[t]] >= 1
badk[z] <- tlin[t] * 16 + 8   for (t,zc) in ch for (z) in 0 .. 0 if isdcl[t]
      if not dknown[t]
# **層を振れない源は焼かない**（理由 7）。前段は「層が深すぎる」（`lvl[s,127]`、
# 33_self の `toodeep`）を数えていたのに、**誰も読んでいなかった** ——
# `alive[i] <- true ... if not alive[i]`（問いの答えがその問い自身に依る）を
# 解釈実行は「成層できない」と断り、焼いた側は黙って答えを出していた。
# 非単調な読みが閉路の中にあると層は上がり続け、127 で止まる。
# 行は層を振れなかった文の頭（いちばん前のもの）。
badk[z] <- tlin[t] * 16 + 7   for (t,zc) in ch for (z) in 0 .. 0 if sbrk[t]
      if lvl[snum[t], 127]
field outf : max bound 1                       # 出す場（`render f`）
outf[z] <- rndf[z]                   for (z) in 0 .. 0 for (z) in 0 .. 0
field outw : min bound 1                       # 1 ならバイトで出す
outw[0] <- 8
outw[z] <- 1                         for (z) in 0 .. 0 for (z) in 0 .. 0 if rndf[z] >= 0

# **三段の読みは頭に書けない。** —— `ggb[gcl[t]]` は「場を引いた場」であって、
# 焼ける座標は一段の添字までである。名前を一つ置けば、ただの二段の読みになる。
field gbt : max bound 589824           # トークン t の節の最初のガード番号
gbt[t] <- ggb[gcl[t]]               for (t,zc) in ch
field rsn : max bound 16384             # 出現 o の属する規則の番号
rsn[o] <- rno[osn[o]]               for (o) in 0 .. nocz[0]
field gbo : max bound 16384             # 出現 o の節の最初のガード番号
gbo[o] <- ggb[ocl[o]]               for (o) in 0 .. nocz[0]
field gtt : max bound 16384             # 出現 o の項の通し番号
gtt[o] <- gtno[otok[o]]             for (o) in 0 .. nocz[0]
