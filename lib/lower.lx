lx[crow[c], j + 1] <- 48 + ch2[c] / 1000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 3 if ch2[c] >= 1000
lx[crow[c], j + 1] <- 48 + ch2[c] / 10000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 4 if ch2[c] >= 10000
lx[crow[c], j + 1] <- 48 + ch2[c] / 100000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 5 if ch2[c] >= 100000
