lx[crow[c], j + 1] <- lnw[cnd[c], 0]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 1
lx[crow[c], j + 1] <- lnw[cnd[c], 1]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 2
