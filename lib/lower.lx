lx[crow[c], j + 1] <- 48 + ch1[c] / 100000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 5 if ch1[c] >= 100000
lx[crow[c], j + 1] <- 48 + ch1[c] / 1000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 6 if ch1[c] >= 1000000
lx[crow[c], j + 1] <- 48 + ch1[c] / 10000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 7 if ch1[c] >= 10000000
lx[crow[c], j + 1] <- 48 + ch1[c] / 100000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 8 if ch1[c] >= 100000000
lx[crow[c], j + 1] <- 48 + ch1[c] / 1000000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 9 if ch1[c] >= 1000000000
lx[crow[c], j + 1] <- 48 + ch2[c] % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 0
lx[crow[c], j + 1] <- 48 + ch2[c] / 10 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 1 if ch2[c] >= 10
