# ══ 下ろし —— 自由に書かれた .lx を、焼ける形（SPEC §12）の .lx に書き換える ══════════
#
# **行を保つ書き換え。** 書き換えは二つしか無い ——「字を消す」と「字の後ろに切れ端を差す」。
# Lattix の答えは規則の順に依らない（最小不動点）ので、生成する規則は **末尾に足せば済み**、
# 元の行は元の行番号のまま残る。焼き手の `line N reason R` は利用者の書いた行を指す。
#
# **出力は ⊥ を飛ばす render で詰める。** 行 r ごとに 64 升 `lx[r, s]`：本文の行 r は源の
# 字 r で、升 0 が元の字（消すなら ⊥）、升 1.. がその後ろに差す切れ端。生成部の行は本文の
# 後ろ（262,144 から）に置く。使わない升は ⊥ のまま —— 長さの違う名前も数も「決まった席に
# 置くだけ」で詰まって出る。位置を足し算する鎖が要らない（⊥ は幅 0 の glue）。
#
# **切れ端は型紙から出る。** 型紙（`tpc` / `tph` / `tpd` / `tpn`）は work/mklower.py が読める
# 形から起こす種で、切れ端は「型紙・穴の値四つ・名前一つ」の組（実例）にすぎない。実例は
# 字 i ごとに八つまで（`[i + 127, e]`）置け、一度だけ鎖で詰めてから型紙を開く。
#
# いま下ろすもの:
#   表 `table t = (…), …`    → 消して、列ごとの flat の場と種を末尾に（`_t<k>c<j>`）
#   `for (i,j,w) in t`       → `for (_r<L>) in 0 .. <行数-1>`、変数の出現は `_t<k>c<j>[_r<L>]`
#   広さの無い `field`       → ` bound 4096`（二次元は ` bound 256 256`。超えれば焼いた本が 6 で言う）
#   `n[]`                    → `n[0]`
#   `print f`                → 消して、末尾で `_o[行, 桁]` に字を置く規則に。行は印字する升の
#                              座標の線形の番号 —— 無い升は何も書かないので、詰める鎖が要らない
#   末尾に print の機械（work/lower/engine.lx。一度だけ）と `table ch = (0,32)`
#   `fourv` の場              → or の旗二つ（`x[e, 0]` T / `x[e, 1]` F。否定は旗の入れ替え —— 14b）
#   負の数の座標を書く場        → 次元0 / 1 の原点を k ずらす（全部の出現に + k。広さも + k —— 14c / 14e。print は `座標 - k` を書く —— 14k）
#   アクセサ `c_f[e]` / `_size[e]` → 場所の番地を比べて引く塊（14d）

# ── 型紙 ───────────────────────────────────────────────────────────────
field tpc : max bound 320 64                 # 型紙 k の升 j の字
field tph : max bound 320 64                 # 型紙 k の升 j の穴（1..4。字の升には無い）
field tpd : max bound 320 64                 # その穴の何桁目か（右から）
field tpn : max bound 320 64                 # 宣言の名前の升（1..16 = 何文字目 + 1）
field tpm : max bound 320 64                 # トークンの綴りの升（1..8。束縛の変数名）
field lk : max bound 4096                   # print の機械（字 0..127 と句 128 + m を三バイトずつ畳んだ並び）
field lkz : max bound 1                     # その最後の番号
field lep : max bound 4096 3                # 種 i の j バイト目の位置
field leb : max bound 12288                 # 位置 p のバイト
field ex : max bound 12288 48               # 開いた字: 字は ex[p, 0]、句は ex[p, k] = 型紙 200 + m の字（⊥ は幅 0）
# ── 帯を開く: 型紙の帯 `tv`（三バイトずつ）→ 位置 p のバイト → 型紙の番号と升の番号（区切り 0 の鎖）
field tv : max bound 4096                   # 帯の三バイトの種（14l で 2048 を越えた —— 型紙 188〜190。五つとも一緒に上げる）
field tvz : max bound 1
field tvp : max bound 4096 3                # 種 i の j バイト目の位置
tvp[i, j] <- i * 3 + j              for (i) in 0 .. tvz[0] for (j) in 0 .. 2
field tvb : max bound 12288                 # 帯の位置 p のバイト
tvb[tvp[i, 0]] <- tv[i] % 256       for (i) in 0 .. tvz[0]
tvb[tvp[i, 1]] <- tv[i] / 256 % 256 for (i) in 0 .. tvz[0]
tvb[tvp[i, 2]] <- tv[i] / 65536     for (i) in 0 .. tvz[0]
field tvn : max bound 1                     # 帯の最後の位置
tvn[z] <- tvz[0] * 3 + 2            for (z) in 0 .. 0
field tvk : max bound 12288                 # 位置 p の型紙の番号（区切りを数える鎖）
tvk[0] <- 0
tvk[p] <- tvk[p - 1] + 1            for (p) in 1 .. tvn[0] if tvb[p - 1] == 0
tvk[p] <- tvk[p - 1]                for (p) in 1 .. tvn[0] if tvb[p - 1] >= 1
field tvj : max bound 12288                 # 型紙の中の升の番号
tvj[0] <- 0
tvj[p] <- 0                         for (p) in 1 .. tvn[0] if tvb[p - 1] == 0
tvj[p] <- tvj[p - 1] + 1            for (p) in 1 .. tvn[0] if tvb[p - 1] >= 1
tpc[tvk[p], tvj[p]] <- tvb[p]       for (p) in 0 .. tvn[0] if tvb[p] >= 1 if tvb[p] <= 127
tph[tvk[p], tvj[p]] <- tvb[p] / 16 - 7   for (p) in 0 .. tvn[0] if tvb[p] >= 128 if tvb[p] <= 191
tpd[tvk[p], tvj[p]] <- tvb[p] % 16  for (p) in 0 .. tvn[0] if tvb[p] >= 128 if tvb[p] <= 191
tpn[tvk[p], tvj[p]] <- tvb[p] - 191 for (p) in 0 .. tvn[0] if tvb[p] >= 192 if tvb[p] <= 207
tpm[tvk[p], tvj[p]] <- tvb[p] - 207 for (p) in 0 .. tvn[0] if tvb[p] >= 208 if tvb[p] <= 215
# <<templates>>
