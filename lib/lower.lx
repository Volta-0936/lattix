iti[lpd1[t], 6] <- 15              for (t,zc) in ch if lp2[t] if lpor[t]
ih0[lpd1[t], 6] <- lpp[t]          for (t,zc) in ch if lp2[t] if lpor[t]
#   輪（18）は 2 / 4 / 6 と二文字目の 1 に置く（値・座標の規則の続きの行）
iti[lpd[t], 2] <- 18               for (t,zc) in ch if lp2[t]
iti[lpd[t], 4] <- 18               for (t,zc) in ch if lp2[t] if not lpfl[t] if not lp4[t]
#   flat の二次元（13e）: 値の写し（19 + 18）を三文字目へ移して ⊤ の行を避ける後ろ（153）を付け、
#   ⊤ の行（154 + 18 + 155 + 156）を四文字目に（四文字目は集合の print も使うが、集合は flat でない）
iti[lpd2[t], 3] <- 19              for (t,zc) in ch if lp2[t] if lpfl[t]
