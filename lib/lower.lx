# ── 型紙ここまで ──
# <</templates>>

# ── トークンの終わりと数 ─────────────────────────────────────────────────
field lte : max bound 262144                # トークン t の最後の字
lte[t] <- tstart[t] + tlen[t] - 1   for (t,zc) in ch if tlen[t] >= 1
field lin : max bound 262144                # トークン t の実例の番号（最後の字 + 127）
lin[t] <- lte[t] + 127              for (t,zc) in ch if tlen[t] >= 1
field lis : max bound 262144                # トークン t の最初の字の実例の番号
lis[t] <- tstart[t] + 127           for (t,zc) in ch if tlen[t] >= 1
field nnz : max bound 1                     # 最後の実例の番号
nnz[z] <- i + 127                   for (i,c) in ch for (z) in 0 .. 0

# ── 束縛を十まで ─────────────────────────────────────────────────────────
# 33_self は文の束縛を六つまで引く（焼き手の文は表を一つしか回さないので足りる）。下ろす文は
# 表の列を全部束縛したうえで別のループも回す（`for (pc,op,d,s1,s2,tg) in prog for (v) in vars`）。
# 下ろしの前段にだけ足す（焼き手の前段は変えない —— 下ろした後の文に表の変数は残らない）
field bp6 : max bound 8192
bp6[snum[t]] <- t for (t,zc) in ch if isbind[t] if bnum[t] == 6
field ub6 : max bound 262144
ub6[t] <- bp6[snum[t]] for (t,zc) in ch
field vd6 : or bound 262144
vd6[t] <- true for (t,zc) in ch for (k) in 0 .. 7 if tch[t,k] != tch[ub6[t],k]
field vm6 : or bound 262144
vm6[t] <- true for (t,zc) in ch if tkind[t] == 1 if ub6[t] >= 0 if tlen[t] == tlen[ub6[t]] if not vd6[t]
vbnd[t] <- ub6[t] for (t,zc) in ch if vm6[t]
field bp7 : max bound 8192
bp7[snum[t]] <- t for (t,zc) in ch if isbind[t] if bnum[t] == 7
field ub7 : max bound 262144
ub7[t] <- bp7[snum[t]] for (t,zc) in ch
field vd7 : or bound 262144
vd7[t] <- true for (t,zc) in ch for (k) in 0 .. 7 if tch[t,k] != tch[ub7[t],k]
field vm7 : or bound 262144
vm7[t] <- true for (t,zc) in ch if tkind[t] == 1 if ub7[t] >= 0 if tlen[t] == tlen[ub7[t]] if not vd7[t]
vbnd[t] <- ub7[t] for (t,zc) in ch if vm7[t]
field bp8 : max bound 8192
bp8[snum[t]] <- t for (t,zc) in ch if isbind[t] if bnum[t] == 8
field ub8 : max bound 262144
ub8[t] <- bp8[snum[t]] for (t,zc) in ch
field vd8 : or bound 262144
vd8[t] <- true for (t,zc) in ch for (k) in 0 .. 7 if tch[t,k] != tch[ub8[t],k]
field vm8 : or bound 262144
vm8[t] <- true for (t,zc) in ch if tkind[t] == 1 if ub8[t] >= 0 if tlen[t] == tlen[ub8[t]] if not vd8[t]
vbnd[t] <- ub8[t] for (t,zc) in ch if vm8[t]
field bp9 : max bound 8192
bp9[snum[t]] <- t for (t,zc) in ch if isbind[t] if bnum[t] == 9
field ub9 : max bound 262144
ub9[t] <- bp9[snum[t]] for (t,zc) in ch
field vd9 : or bound 262144
vd9[t] <- true for (t,zc) in ch for (k) in 0 .. 7 if tch[t,k] != tch[ub9[t],k]
field vm9 : or bound 262144
vm9[t] <- true for (t,zc) in ch if tkind[t] == 1 if ub9[t] >= 0 if tlen[t] == tlen[ub9[t]] if not vd9[t]
vbnd[t] <- ub9[t] for (t,zc) in ch if vm9[t]

# **出現 t の場（0 起点）を値で一度引く。** 書き先の座標に `f[ofl[oseq[t]] - 1]` と書くと、宣言の無い
# 出現（ofl が ⊥）で焼いた本が 6 で止まる —— 焼き手の穴（三段の読みに後置のずれを付けた書き先は、
# ⊥ を見る前にずれを足してしまう。読みの側は正しい）。値で引けば ⊥ は規則ごと飛ぶ
field lof : max bound 262144
lof[t] <- ofl[oseq[t]] - 1         for (t,zc) in ch if isocc[t]

# ── 十七文字以上の場の名前 ─────────────────────────────────────────────
# 焼き手の名前は十六文字まで（鍵が二本 —— 気づき44）。長い名前の場は `_f<宣言の番号>` に付け替える。
# 付け替えた綴りは `lnw`（`@` の升が書く綴り —— print の規則が場を名指すのもこれ）。print の名の席は
# 元の綴りを三十二文字まで書く。（十六文字目まで同じで十七文字目から違う二つの名前は、前段の鍵が
# 同じ場と読む —— 焼き手と同じ限り）
field llg : or bound 1024                   # 宣言 d（1 起点）の名前は十七文字以上
llg[dseq[t]] <- true               for (t,zc) in ch if isdcl[t] if tlen[t] >= 17
field lnw : max bound 1024 16               # 宣言 d の下ろした後の綴り
lnw[d, k] <- dch[d, k]             for (d) in 0 .. ndcz[0] for (k) in 0 .. 15 if not llg[d]
lnw[d, 0] <- 95                    for (d) in 0 .. ndcz[0] if llg[d]
lnw[d, 1] <- 102                   for (d) in 0 .. ndcz[0] if llg[d]
lnw[d, 2] <- 48 + d % 10           for (d) in 0 .. ndcz[0] if llg[d] if d < 10
lnw[d, 2] <- 48 + d / 10 % 10      for (d) in 0 .. ndcz[0] if llg[d] if d >= 10 if d < 100
lnw[d, 3] <- 48 + d % 10           for (d) in 0 .. ndcz[0] if llg[d] if d >= 10 if d < 100
lnw[d, 2] <- 48 + d / 100 % 10     for (d) in 0 .. ndcz[0] if llg[d] if d >= 100 if d < 1000
lnw[d, 3] <- 48 + d / 10 % 10      for (d) in 0 .. ndcz[0] if llg[d] if d >= 100 if d < 1000
lnw[d, 4] <- 48 + d % 10           for (d) in 0 .. ndcz[0] if llg[d] if d >= 100 if d < 1000
lnw[d, 2] <- 48 + d / 1000 % 10    for (d) in 0 .. ndcz[0] if llg[d] if d >= 1000
lnw[d, 3] <- 48 + d / 100 % 10     for (d) in 0 .. ndcz[0] if llg[d] if d >= 1000
lnw[d, 4] <- 48 + d / 10 % 10      for (d) in 0 .. ndcz[0] if llg[d] if d >= 1000
lnw[d, 5] <- 48 + d % 10           for (d) in 0 .. ndcz[0] if llg[d] if d >= 1000
field lnt : max bound 262144                # 付け替える名のトークン → 宣言（1 起点）
lnt[t] <- dseq[t]                  for (t,zc) in ch if isdcl[t] if llg[dseq[t]]
lnt[t] <- ofl[oseq[t]]             for (t,zc) in ch if isocc[t] if llg[ofl[oseq[t]]] if not lpo[t]

# ── 表 ─────────────────────────────────────────────────────────────────
field tbk : max bound 8192                  # 文 s の表の番号（0 起点）
tbk[s] <- ctb[s] - 1                for (s) in 0 .. nstz[0] if istb[s]
field ntbz : max bound 1                    # 最後の表の番号
ntbz[z] <- tbk[s]                   for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if istb[s]
field tbn : max bound 16                    # 表 k の名のトークン
tbn[tbk[snum[t]]] <- nextw[t]       for (t,zc) in ch if kwtbl[t] if sbrk[t]
field nrw : max bound 16                    # 表 k の行数
nrw[tbk[snum[t]]] <- rowc[t]        for (t,zc) in ch if isnum[t] if istb[snum[t]] if tdep[t] == 1
# `table t = range(a, b)` は区間の表（行は a .. b-1 の一列）。ループは区間に書き換え、変数はそのまま
field kwrng : or bound 262144               # `range`
kwrng[t] <- true                    for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 114 if tch[t,1] == 97 if tch[t,2] == 110 if tch[t,3] == 103 if tch[t,4] == 101
field ltr : or bound 16                     # 表 k は range
ltr[tbk[snum[t]]] <- true           for (t,zc) in ch if kwrng[t] if istb[snum[t]]
field trl : max bound 16                    # range の下端
trl[tbk[snum[t]]] <- tval[t]        for (t,zc) in ch if isnum[t] if istb[snum[t]] if tdep[t] == 1
      if colc[t] == 0 if ltr[tbk[snum[t]]]
field trh : max bound 16                    # range の上端（含まない）
trh[tbk[snum[t]]] <- tval[t]        for (t,zc) in ch if isnum[t] if istb[snum[t]] if tdep[t] == 1
      if colc[t] == 1 if ltr[tbk[snum[t]]]
field isfr : or bound 262144                # 表の升の数（深さ一の数。range の表は升を持たない）
isfr[t] <- true                     for (t,zc) in ch if isnum[t] if istb[snum[t]] if tdep[t] == 1
      if not ltr[tbk[snum[t]]]

# ── `in t` の t はどの表か（綴りを比べる。八文字まで）───────────────────
field tnd : or bound 262144 16              # `in` の後ろの名と表 k の名の字が違う
tnd[u, k] <- true   for (u,zc) in ch for (k) in 0 .. ntbz[0] for (j) in 0 .. 7
      if kwin[u] if tch[int1[u], j] != tch[tbn[k], j]
field tix : max bound 262144                # `in` のトークン u が回す表
tix[u] <- k         for (u,zc) in ch for (k) in 0 .. ntbz[0]
      if kwin[u] if lkd[snum[u], lz[u]] == 0 if tlen[int1[u]] == tlen[tbn[k]] if not tnd[u, k]
field ltk : max bound 8192 8                # 文 s の for 節 L が回す表
ltk[snum[u], lz[u]] <- tix[u]       for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
field lft : max bound 8192 8                # 文 s の for 節 L の `for`
lft[snum[t], lz[t]] <- t            for (t,zc) in ch if kwfor[t] if lz[t] >= 0 if lz[t] <= 7
field lit : max bound 8192 8                # 文 s の for 節 L の表の名（表のループだけ）
lit[snum[u], lz[u]] <- int1[u]      for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
field lrn : max bound 262144                # range の表の名のトークン（`in` の後ろ）→ 表
lrn[int1[u]] <- tix[u]              for (u,zc) in ch if kwin[u] if ltr[tix[u]]

# ── 原子（綴り → 綴りの順の番号）───────────────────────────────────────
# 表の裸の名前（`tokyo`）と文字列（`"tokyo"`）は原子である。焼ける値は整数だけなので、**綴りの順の
# 番号**（0 起点）に置き換える —— 等しさも大小も min/max も、print の並び（解釈実行は綴りの辞書順に
# 並べる）もそのまま保たれる。print では番号を綴りに戻す（`_an[番号, k]`）。
# 記号表は作らない（気づき22・42）: 綴りを 6 バイトずつ四本の鍵に畳み（256 進 —— UTF-8 のバイト順は
# 符号点の順）、鍵の同じ最初の出現を正体にし、正体どうしを鍵で比べて **自分より小さい正体を数える**。
# 文字列は `"` の数の偶奇で切る（解釈実行と同じく一行の中で閉じる）。`emit "ch"`・`from "ch"`・
# `include "…"` の綴りは口や本の名前で値ではない —— 表と、矢印のある文の値・座標の中だけを原子にする。
field qq : or bound 262144                  # `"`
qq[t] <- true          for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 34
field qn : max bound 262144                 # t までの `"` の数（鎖）
qn[0] <- 0
qn[z] <- 1             for (z) in 0 .. 0 if qq[0]
qn[t] <- qn[t-1] + 1   for (t,zc) in ch if t >= 1 if qq[t]
qn[t] <- qn[t-1]       for (t,zc) in ch if t >= 1 if not qq[t]
field qpr : max bound 262144                # その偶奇（1 = 開きの `"` か、文字列の中）
qpr[t] <- qn[t] % 2    for (t,zc) in ch
field qa : max bound 262144                 # トークン t を含む文字列の開きの `"`（閉じも開きを指す）
qa[t] <- t             for (t,zc) in ch if qq[t] if qpr[t] == 1
qa[t] <- qa[t-1]       for (t,zc) in ch if t >= 1 if not qq[t] if qpr[t] == 1
qa[t] <- qa[t-1]       for (t,zc) in ch if t >= 1 if qq[t] if qpr[t] == 0
field qi : or bound 262144                  # 文字列の中身のトークン
qi[t] <- true          for (t,zc) in ch if not qq[t] if qpr[t] == 1
field qcl : max bound 262144                # 開きの `"` → 閉じの `"`
qcl[qa[t]] <- t        for (t,zc) in ch if qq[t] if qpr[t] == 0
field atv : or bound 262144                 # 原子の出現: 表の裸の名前か、原子にする文字列の開きの `"`
atv[t] <- true   for (t,zc) in ch if istb[snum[t]] if tdep[t] == 1 if tkind[t] == 1 if not isnum[t]
      if not tcom[t] if not qi[t] if not kwtru[t]
atv[t] <- true   for (t,zc) in ch if qq[t] if qpr[t] == 1 if istb[snum[t]]
atv[t] <- true   for (t,zc) in ch if qq[t] if qpr[t] == 1 if arrowt[snum[t]] >= 0 if t > arrowt[snum[t]]
atv[t] <- true   for (t,zc) in ch if qq[t] if qpr[t] == 1 if arrowt[snum[t]] >= 0 if t < arrowt[snum[t]]
      if tdep[t] >= 1
field atc : max bound 262144                # t までの原子の出現の数（鎖）
atc[0] <- 0
atc[z] <- 1            for (z) in 0 .. 0 if atv[0]
atc[t] <- atc[t-1] + 1 for (t,zc) in ch if t >= 1 if atv[t]
atc[t] <- atc[t-1]     for (t,zc) in ch if t >= 1 if not atv[t]
field atx : max bound 262144                # 出現 t の通し番号（0 起点。千二十四まで —— 越えれば 6 で言う）
atx[t] <- atc[t] - 1   for (t,zc) in ch if atv[t]
field atz : max bound 1                     # 最後の通し番号
atz[z] <- atx[t]       for (t,zc) in ch for (z) in 0 .. 0 if atv[t]
# 綴りの字: 裸の名前はトークンの字、文字列は開きの `"` の後ろから閉じの手前まで
field qat : max bound 262144                # 綴りを持つトークン t の出現の番号
qat[t] <- atx[t]       for (t,zc) in ch if atv[t] if not qq[t]
qat[t] <- atx[qa[t]]   for (t,zc) in ch if qi[t] if atv[qa[t]]
field atci : max bound 262144               # 字 i の出現の番号
atci[i] <- qat[tnum[i]]   for (i,c) in ch if qat[tnum[i]] >= 0
field atcp : max bound 262144               # 字 i の綴りの中の位置
atcp[i] <- cpos[i]        for (i,c) in ch if atv[tnum[i]] if not qq[tnum[i]]
atcp[i] <- i - tstart[qa[tnum[i]]] - 1   for (i,c) in ch if qi[tnum[i]] if atv[qa[tnum[i]]]
field atb : max bound 1024 24               # 出現 a の k バイト目（24 バイトまで。越えれば面の外 —— 6 で言う）
atb[atci[i], atcp[i]] <- c   for (i,c) in ch if atci[i] >= 0
field atl : max bound 1024                  # 出現 a のバイト数
atl[a] <- 0                  for (a) in 0 .. atz[0]
atl[atci[i]] <- atcp[i] + 1  for (i,c) in ch if atci[i] >= 0
# **⊥ は番兵ではない**（気づき22）—— 綴りの後ろは 0 で埋めてから畳む（短い綴りが先に並ぶ）
atb[a, k] <- 0               for (a) in 0 .. atz[0] for (k) in 0 .. 23 if k >= atl[a]
field atkk : max bound 1024 24              # 鍵を畳む途中（6 バイトごとに 0 から）
atkk[a, 0] <- atb[a, 0]      for (a) in 0 .. atz[0]
atkk[a, k] <- atkk[a, k-1] * 256 + atb[a, k]   for (a) in 0 .. atz[0] for (k) in 1 .. 5
atkk[a, 6] <- atb[a, 6]      for (a) in 0 .. atz[0]
atkk[a, k] <- atkk[a, k-1] * 256 + atb[a, k]   for (a) in 0 .. atz[0] for (k) in 7 .. 11
atkk[a, 12] <- atb[a, 12]    for (a) in 0 .. atz[0]
atkk[a, k] <- atkk[a, k-1] * 256 + atb[a, k]   for (a) in 0 .. atz[0] for (k) in 13 .. 17
atkk[a, 18] <- atb[a, 18]    for (a) in 0 .. atz[0]
atkk[a, k] <- atkk[a, k-1] * 256 + atb[a, k]   for (a) in 0 .. atz[0] for (k) in 19 .. 23
field ak0 : max bound 1024                  # 鍵（1〜6 バイト目）
ak0[a] <- atkk[a, 5]         for (a) in 0 .. atz[0]
field ak1 : max bound 1024                  # 鍵（7〜12 バイト目）
ak1[a] <- atkk[a, 11]        for (a) in 0 .. atz[0]
field ak2 : max bound 1024                  # 鍵（13〜18 バイト目）
ak2[a] <- atkk[a, 17]        for (a) in 0 .. atz[0]
field ak3 : max bound 1024                  # 鍵（19〜24 バイト目）
ak3[a] <- atkk[a, 23]        for (a) in 0 .. atz[0]
field atn : min bound 1024                  # 出現 a と同じ綴りの最初の出現（正体）
atn[a] <- b   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0]
      if ak0[a] == ak0[b] if ak1[a] == ak1[b] if ak2[a] == ak2[b] if ak3[a] == ak3[b]
field atf : or bound 1024                   # 出現 a は正体
atf[a] <- true   for (a) in 0 .. atz[0] if atn[a] == a
field alt : or bound 1024 1024              # 正体 a の綴りは出現 b の綴りより小さい（鍵の辞書順）
alt[a, b] <- true   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0] if atf[a] if ak0[a] < ak0[b]
alt[a, b] <- true   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0] if atf[a] if ak0[a] == ak0[b]
      if ak1[a] < ak1[b]
alt[a, b] <- true   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0] if atf[a] if ak0[a] == ak0[b]
      if ak1[a] == ak1[b] if ak2[a] < ak2[b]
alt[a, b] <- true   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0] if atf[a] if ak0[a] == ak0[b]
      if ak1[a] == ak1[b] if ak2[a] == ak2[b] if ak3[a] < ak3[b]
# 数えるのは集約ではなく鎖（a に沿って、b より小さい正体を数える）
field arc : max bound 1024 1024
arc[b, 0] <- 0                 for (b) in 0 .. atz[0] if not alt[0, b]
arc[b, 0] <- 1                 for (b) in 0 .. atz[0] if alt[0, b]
arc[b, a] <- arc[b, a-1] + 1   for (b) in 0 .. atz[0] for (a) in 1 .. atz[0] if alt[a, b]
arc[b, a] <- arc[b, a-1]       for (b) in 0 .. atz[0] for (a) in 1 .. atz[0] if not alt[a, b]
field atr : max bound 1024                  # 出現 a の番号（綴りの順。同じ綴りは同じ番号）
atr[a] <- arc[a, k]          for (a) in 0 .. atz[0] for (k) in 0 .. atz[0]   # 鎖は増えるだけなので max が末尾を拾う
field qv : max bound 262144                 # 原子の出現 t の番号
qv[t] <- atr[atx[t]]         for (t,zc) in ch if atv[t]
# ── 集合 ─────────────────────────────────────────────────────────────
# `field s : set` は **or の場に要素の次元を一つ足したもの**である（`s[k] = {a, b}` ⟺ `s'[k, a]` と
# `s'[k, b]` が true）。和集合の join は or の join、空集合（⊥）は全部 ⊥ —— 束ごと焼ける。
# 下ろすのは `s[] <- {e}` / `s[k] <- {e}`（要素一つ）の書き先と print だけ。集合の読み・二次元の鍵・
# 要素が二つ以上の字面・広さを書いた集合は下ろさない（`set` のまま残る → 焼き手が理由 8 で言う）。
# print は解釈実行と同じく **要素を str の順に**並べる（数も綴りで: 10 < 2。原子は番号の順が綴りの順）。
field kwset : or bound 262144               # `set`
kwset[t] <- true   for (t,zc) in ch if tlen[t] == 3 if not tcom[t] if tch[t,0] == 115 if tch[t,1] == 101
      if tch[t,2] == 116
field lset : or bound 1024                  # 場 f は集合
lset[fdno[t]] <- true   for (t,zc) in ch if isdcl[t] if kwset[latt[t]]
field lsvb : max bound 8192                 # 集合の文 s の値の `{`
lsvb[s] <- lvf[s]       for (s) in 0 .. nstz[0] if hasr[s] if lset[hfz[s]] if tch[lvf[s], 0] == 123
field lsve : max bound 8192                 # その要素の最初のトークン
lsve[s] <- nextw[lsvb[s]]   for (s) in 0 .. nstz[0] if lsvb[s] >= 0
field lsee : max bound 8192                 # 要素の最後のトークン（文字列なら閉じの `"`）
lsee[s] <- lsve[s]          for (s) in 0 .. nstz[0] if lsve[s] >= 0 if not qq[lsve[s]]
lsee[s] <- qcl[lsve[s]]     for (s) in 0 .. nstz[0] if lsve[s] >= 0 if qq[lsve[s]]
field lsvc : max bound 8192                 # 要素の後ろの語（`}` なら要素は一つ）
lsvc[s] <- nextw[lsee[s]]   for (s) in 0 .. nstz[0] if lsee[s] >= 0
field lsk1s : or bound 8192                 # 文 s の値は要素一つの集合 `{e}`
lsk1s[s] <- true            for (s) in 0 .. nstz[0] if lsvc[s] >= 0 if tch[lsvc[s], 0] == 125
field lsek : max bound 8192                 # 要素の書き方（1 表の変数 / 2 区間の変数 / 3 数か文字列）
lsek[s] <- 1                for (s) in 0 .. nstz[0] if lsk1s[s] if lvlk[lsve[s]] == 0 if not ltr[lvt[lsve[s]]]
lsek[s] <- 2                for (s) in 0 .. nstz[0] if lsk1s[s] if vbnd[lsve[s]] >= 0 if lvlk[lsve[s]] >= 1
lsek[s] <- 2                for (s) in 0 .. nstz[0] if lsk1s[s] if lvlk[lsve[s]] == 0 if ltr[lvt[lsve[s]]]
lsek[s] <- 3                for (s) in 0 .. nstz[0] if lsk1s[s] if isnum[lsve[s]]
lsek[s] <- 3                for (s) in 0 .. nstz[0] if lsk1s[s] if qq[lsve[s]]
field lsekf : or bound 8192                 # 要素の書き方が分かった
lsekf[s] <- true            for (s) in 0 .. nstz[0] if lsek[s] >= 1
field lsbd : or bound 1024                  # 集合 f は下ろせない
lsbd[hfz[s]] <- true        for (s) in 0 .. nstz[0] if lsk1s[s] if not lsekf[s]
lsbd[hfz[s]] <- true        for (s) in 0 .. nstz[0] if hasr[s] if lset[hfz[s]] if not lsk1s[s]
lsbd[lof[t]] <- true        for (t,zc) in ch if isocc[t] if not lhd[t] if not lpo[t]
lsbd[f] <- true             for (f) in 0 .. nfdz[0] if lset[f] if farr[f] == 2
lsbd[fdno[t]] <- true       for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
field lsk : or bound 1024                   # 集合 f を下ろす
lsk[f] <- true              for (f) in 0 .. nfdz[0] if lset[f] if not lsbd[f]
field lsk0 : or bound 1024                  # 鍵の無い集合（`s[]`）→ 一次元の or
lsk0[f] <- true             for (f) in 0 .. nfdz[0] if lsk[f] if lf0[f]
field lsk1 : or bound 1024                  # 鍵が一つの集合（`s[k]`）→ 二次元の or
lsk1[f] <- true             for (f) in 0 .. nfdz[0] if lsk[f] if not lf0[f]
field lss : or bound 8192                   # 文 s は下ろす集合の書き先
lss[s] <- true              for (s) in 0 .. nstz[0] if lsk1s[s] if lsk[hfz[s]]
field lsel : or bound 262144                # 下ろす集合の要素のトークン（消して、書き先の座標に書く）
lsel[t] <- true             for (t,zc) in ch if lss[snum[t]] if t >= lsve[snum[t]] if t <= lsee[snum[t]]
field lsde : max bound 8192                 # 文 s の要素の次元（鍵の無い集合は 0、鍵が一つなら 1）
lsde[s] <- 0                for (s) in 0 .. nstz[0] if lss[s] if lsk0[hfz[s]]
lsde[s] <- 1                for (s) in 0 .. nstz[0] if lss[s] if lsk1[hfz[s]]
lbm[hfz[s], lsde[s]] <- ljm[lsve[s]]   for (s) in 0 .. nstz[0] if lss[s] if ljk[lsve[s]]
lbu[hfz[s], lsde[s]] <- true           for (s) in 0 .. nstz[0] if lss[s] if not ljk[lsve[s]]
ljm[j] <- qv[j]             for (j,zc) in ch if lsel[j] if qq[j] if atv[j]
ljk[j] <- true              for (j,zc) in ch if lsel[j] if qq[j] if atv[j]
lb2[f] <- lbm[f, 1] + 1     for (f) in 0 .. nfdz[0] if lsk1[f] if lbm[f, 1] >= 0
lb2[f] <- 256               for (f) in 0 .. nfdz[0] if lsk1[f] if lbu[f, 1]
field lsea : or bound 1024                  # 集合 f の要素は原子
lsea[hfz[s]] <- true        for (s) in 0 .. nstz[0] if lss[s] if qq[lsve[s]]
lsea[hfz[s]] <- true        for (s) in 0 .. nstz[0] if lss[s] if lta[lvt[lsve[s]], vcolz[lsve[s]]]
      if lvlk[lsve[s]] == 0
# 字の差し替え: 値 `{e}` → `true`（`{` が差し、要素と `}` は消える）。書き先 `s[]` → `s[e]`（`[` が差す）、
# `s[k]` → `s[k, e]`（`]` を消して `, e]` を差す）。要素の書き方は四つ（表の変数・区間の変数・数・文字列）
field lsh : max bound 8192                  # 集合の文 s の書き先の出現
lsh[s] <- hotok[s]          for (s) in 0 .. nstz[0] if lss[s]
field lsx0 : max bound 262144               # 鍵の無い集合の書き先の `[` → 文
lsx0[obr[lsh[s]]] <- s      for (s) in 0 .. nstz[0] if lss[s] if lsde[s] == 0
field lsx1 : max bound 262144               # 鍵が一つの集合の書き先の `]` → 文
lsx1[tclos[obr[lsh[s]]]] <- s   for (s) in 0 .. nstz[0] if lss[s] if lsde[s] == 1
field lsev : max bound 8192                 # 数か文字列の要素の値
lsev[s] <- tval[lsve[s]]    for (s) in 0 .. nstz[0] if lss[s] if isnum[lsve[s]]
lsev[s] <- qv[lsve[s]]      for (s) in 0 .. nstz[0] if lss[s] if qq[lsve[s]]
field lsxs : max bound 262144               # 書き先の `[` か `]` のトークン → 文
lsxs[t] <- lsx0[t]          for (t,zc) in ch if lsx0[t] >= 0
lsxs[t] <- lsx1[t]          for (t,zc) in ch if lsx1[t] >= 0
field lsxf : or bound 262144                # 集合の書き先の `[` か `]`（否定で読むための旗）
lsxf[t] <- true             for (t,zc) in ch if lsxs[t] >= 0

# ── `is`（上集合の帰属 x ⊒ c）──────────────────────────────────────────
# 単調な読みだが、焼ける形では比較で書く: min は `<=`、max・sum・count は `>=`、flat は `==`
# （flat の ⊤ は、比較で読めば焼いた側が 5 で止まって言う）。左は場の読み（解釈実行もそれしか取らない）
field kwis : or bound 262144                # `is`
kwis[t] <- true   for (t,zc) in ch if tlen[t] == 2 if not tcom[t] if tch[t,0] == 105 if tch[t,1] == 115
field lis1 : max bound 262144               # `is` の左の出現
lis1[t] <- lbo[tmatch[prevw[t]]]   for (t,zc) in ch if kwis[t]
field lisl : max bound 262144               # その場の束
lisl[t] <- flatt[ofl[oseq[lis1[t]]] - 1]   for (t,zc) in ch if kwis[t]
field lisk : max bound 262144               # 差し替える型紙（66 `<=` / 67 `>=` / 68 `==`）
lisk[t] <- 66      for (t,zc) in ch if kwis[t] if lisl[t] == 1
lisk[t] <- 67      for (t,zc) in ch if kwis[t] if lisl[t] == 2
lisk[t] <- 67      for (t,zc) in ch if kwis[t] if lisl[t] == 8
lisk[t] <- 67      for (t,zc) in ch if kwis[t] if lisl[t] == 9
lisk[t] <- 68      for (t,zc) in ch if kwis[t] if lisl[t] == 6

# 表の升は数か原子。列が原子を持つかは (表, 列) の旗
field ltc : or bound 262144                 # 表の升（range の表は升を持たない）
ltc[t] <- true    for (t,zc) in ch if isfr[t]
ltc[t] <- true    for (t,zc) in ch if atv[t] if istb[snum[t]]
field ltv : max bound 262144                # 表の升の値
ltv[t] <- tval[t] for (t,zc) in ch if isfr[t]
ltv[t] <- qv[t]   for (t,zc) in ch if atv[t] if istb[snum[t]]
nrw[tbk[snum[t]]] <- rowc[t]        for (t,zc) in ch if atv[t] if istb[snum[t]]
field lta : or bound 16 16                  # 表 k の列 c は原子の列
lta[tbk[snum[t]], colc[t]] <- true  for (t,zc) in ch if atv[t] if istb[snum[t]]
# 規則の中の文字列は字を消して番号を差す（表の文は丸ごと消える）
field qdl : or bound 262144                 # 原子にする文字列のトークン（`"` も中身も）
qdl[t] <- true    for (t,zc) in ch if atv[qa[t]]
field qrl : or bound 262144                 # 規則・種の中の原子の文字列（開きの `"`）
qrl[t] <- true    for (t,zc) in ch if atv[t] if qq[t] if not istb[snum[t]] if not lsel[t]
# **どの (場, 次元) が原子を持つか**は不動点で決まる: 原子・原子の列の変数・値が原子の場の読みが
# 書き先の座標や値の頭に立てば、その場のその次元（値）は原子。print はそれを見て綴りに戻す
field ltat : or bound 262144                # トークン t は原子を指す
field aav : or bound 1024                   # 場 f の値は原子
field aat : or bound 1024 2                 # 場 f の次元 d は原子
field lvf : max bound 8192                  # 文 s の値の最初の語
lvf[s] <- nextw[arrowt[s] + 1]     for (s) in 0 .. nstz[0] if arrowt[s] >= 0
ltat[t] <- true   for (t,zc) in ch if qrl[t]
ltat[t] <- true   for (t,zc) in ch if lvu[t] if lta[lvt[t], vcolz[t]]
ltat[t] <- true   for (t,zc) in ch if isocc[t] if aav[ofl[oseq[t]] - 1]
aat[lhf[o], 0] <- true   for (o,zc) in ch if lhd[o] if ltat[lhj0[o]]
aat[lhf[o], 1] <- true   for (o,zc) in ch if lhd[o] if ltat[lhj1[o]]
aav[lhf[o]] <- true      for (o,zc) in ch if lhd[o] if ltat[lvf[snum[o]]]

# ── 場の広さ（下ろした後の）─────────────────────────────────────────────
# **広さは書き先の座標が言う**（区間解析）。書き先の次元ごとに添字の最大を出す: 数ならその数、
# 表の変数なら列の最大、区間の変数なら上端、それぞれ ± ずれ。分からない（読み・式・上端が場）
# 次元は既定（一次元 4096、二次元 256）以上。読みは広さに効かない（外は両方で ⊥）。
# 狭く推しすぎれば焼いた本が「宣言が嘘」（終了コード 6）と言う —— 黙って違う答えにはならない。
field lhb : or bound 1024                   # 場 f は広さを書いてある
lhb[fdno[t]] <- true                for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
field ltcm : max bound 16 16                # 表 k の列 j の最大の値
ltcm[tbk[snum[t]], colc[t]] <- ltv[t]   for (t,zc) in ch if ltc[t] if colc[t] <= 15
field ljo : max bound 262144                # 添字 j のずれ（無ければ 0）
ljo[j] <- 0                        for (j,zc) in ch if not ixhf[j]
ljo[j] <- ixnv[j]                  for (j,zc) in ch if ixhf[j] if isplus[ixop[j]]
ljo[j] <- 0 - ixnv[j]              for (j,zc) in ch if ixhf[j] if ismin[ixop[j]]
field ljm : max bound 262144                # 添字 j の最大（ずれ込み）
field ljk : or bound 262144                 # 添字 j の最大が分かる
ljm[j] <- tval[j] + ljo[j]         for (j,zc) in ch if isnum[j]
ljk[j] <- true                     for (j,zc) in ch if isnum[j]
ljm[j] <- qv[j]                    for (j,zc) in ch if qrl[j]
ljk[j] <- true                     for (j,zc) in ch if qrl[j]
field lvlk : max bound 262144               # 変数 j のループの書き方（lkd）
lvlk[j] <- lkd[snum[j], vlpz[j]]   for (j,zc) in ch if tkind[j] == 1 if vbnd[j] >= 0 if not isocc[j]
ljm[j] <- ltcm[lvt[j], vcolz[j]] + ljo[j]   for (j,zc) in ch if lvlk[j] == 0 if not ltr[lvt[j]]
ljk[j] <- true                     for (j,zc) in ch if lvlk[j] == 0 if not ltr[lvt[j]]
ljm[j] <- trh[lvt[j]] - 1 + ljo[j] for (j,zc) in ch if lvlk[j] == 0 if ltr[lvt[j]]
ljk[j] <- true                     for (j,zc) in ch if lvlk[j] == 0 if ltr[lvt[j]]
ljm[j] <- lhi2[snum[j], vlpz[j]] + ljo[j]   for (j,zc) in ch if lvlk[j] == 1
ljk[j] <- true                     for (j,zc) in ch if lvlk[j] == 1
field lhj0 : max bound 262144               # 書き先 o の次元 0 の添字
lhj0[o] <- ob1[o]                  for (o,zc) in ch if lhd[o] if obk[o]
field lhj1 : max bound 262144               # 書き先 o の次元 1 の添字
lhj1[o] <- d1t[o]                  for (o,zc) in ch if lhd[o] if obk[o] if iscom[d0cm[o]]
field lhf : max bound 262144                # 書き先 o の場（0 起点）
lhf[o] <- ofl[oseq[o]] - 1         for (o,zc) in ch if lhd[o]
field lbm : max bound 1024 2                # 場 f の次元 d の書き先の添字の最大
field lbu : or bound 1024 2                 # 場 f の次元 d に分からない書き先がある
lbm[lhf[o], 0] <- ljm[lhj0[o]]     for (o,zc) in ch if lhd[o] if ljk[lhj0[o]] if not lcs0[lhj0[o]]
lbu[lhf[o], 0] <- true             for (o,zc) in ch if lhd[o] if obk[o] if not ljk[lhj0[o]] if not lemp[obr[o]]
lbu[lhf[o], 0] <- true             for (o,zc) in ch if lhd[o] if lcs0[lhj0[o]]
lbm[lhf[o], 0] <- 0                for (o,zc) in ch if lhd[o] if lemp[obr[o]]
lbm[lhf[o], 1] <- ljm[lhj1[o]]     for (o,zc) in ch if lhd[o] if ljk[lhj1[o]] if not lcs0[lhj1[o]]
lbu[lhf[o], 1] <- true             for (o,zc) in ch if lhd[o] if lhj1[o] >= 0 if not ljk[lhj1[o]]
lbu[lhf[o], 1] <- true             for (o,zc) in ch if lhd[o] if lcs0[lhj1[o]]
field lb1 : max bound 1024                  # 場 f の次元0 の広さ
lb1[f] <- fwid[f]                   for (f) in 0 .. nfdz[0] if lhb[f]
lb1[f] <- 1                         for (f) in 0 .. nfdz[0] if not lhb[f]
lb1[f] <- lbm[f, 0] + 1             for (f) in 0 .. nfdz[0] if not lhb[f] if lbm[f, 0] >= 0
lb1[f] <- 4096                      for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 1 if lbu[f, 0]
lb1[f] <- 256                       for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 2 if lbu[f, 0]
field lb2 : max bound 1024                  # 場 f の次元1 の広さ（一次元は 1）
lb2[f] <- 1                         for (f) in 0 .. nfdz[0] if farr[f] == 1
lb2[f] <- fwid2[f]                  for (f) in 0 .. nfdz[0] if lhb[f] if farr[f] == 2
lb2[f] <- 1                         for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 2
lb2[f] <- lbm[f, 1] + 1             for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 2 if lbm[f, 1] >= 0
lb2[f] <- 256                       for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 2 if lbu[f, 1]
field lsz : max bound 1024                  # 場 f の升の数
lsz[f] <- lb1[f] * lb2[f]           for (f) in 0 .. nfdz[0]

# ── print（文の順に数える）──────────────────────────────────────────────
field lsp : or bound 8192                   # 文 s は print
lsp[snum[t]] <- true                for (t,zc) in ch if sbrk[t] if kwprn[t]
field pdo : max bound 8192                  # 文 s より前にある print の数
pdo[s] <- 0                         for (s) in 0 .. nstz[0]
pdo[s] <- pdo[s-1] + 1              for (s) in 1 .. nstz[0] if lsp[s-1]
pdo[s] <- pdo[s-1]                  for (s) in 1 .. nstz[0] if not lsp[s-1]
field lpo : or bound 262144                 # print の名のトークン
lpo[t] <- true                      for (t,zc) in ch if isocc[t] if kwprn[prevw[t]]
field pfd : max bound 64                    # print p の場（宣言の番号。1 起点）
pfd[pdo[snum[t]]] <- ofl[oseq[t]]   for (t,zc) in ch if lpo[t] if pdo[snum[t]] <= 63
field psz : max bound 64                    # print p の行の数（⊥ の行 + 升）
psz[p] <- lsz[pfd[p] - 1] + 1       for (p) in 0 .. 63 if pfd[p] >= 1
field pbs : max bound 64                    # print p の頭の行
pbs[0] <- 0
pbs[p] <- pbs[p-1] + psz[p-1]       for (p) in 1 .. 63 if psz[p-1] >= 1
# print の名のトークン t の場（0 起点）・番号・広さ
field lpf : max bound 262144
lpf[t] <- ofl[oseq[t]] - 1          for (t,zc) in ch if lpo[t]
field lpp : max bound 262144
lpp[t] <- pdo[snum[t]]              for (t,zc) in ch if lpo[t]
field lpb : max bound 262144                # その print の頭の行
lpb[t] <- pbs[lpp[t]]               for (t,zc) in ch if lpo[t]
field lpe : max bound 262144                # その print の最後の行
lpe[t] <- pbs[lpp[t]] + lsz[lpf[t]] for (t,zc) in ch if lpo[t]
field lpd : max bound 262144                # 名のトークン t の print のトークンの実例の番号
lpd[t] <- lis[prevw[t]]             for (t,zc) in ch if lpo[t]
field lp1 : or bound 262144                 # 一次元の print
lp1[t] <- true                      for (t,zc) in ch if lpo[t] if farr[lpf[t]] == 1 if not lsk[lpf[t]]
field lp2 : or bound 262144                 # 二次元の print
lp2[t] <- true                      for (t,zc) in ch if lpo[t] if farr[lpf[t]] == 2 if not lsk[lpf[t]]
field lpor : or bound 262144                 # or の場の print（`true` と書く）
lpor[t] <- true                      for (t,zc) in ch if lpo[t] if flatt[lpf[t]] == 3
field lf0 : or bound 1024                   # 場 f は `[]` で使われる（print は座標を書かない: `n[] = v`）
lf0[lof[prevw[t]]] <- true   for (t,zc) in ch if lemp[t] if isocc[prevw[t]]

# ── ANF: ガードの辺の算術に名前を置く ───────────────────────────────────
# 焼ける形のガードの辺は「読み・列・計数器・定数」だけ（SPEC §12）。`if x % 2 == 1` の `x % 2` は
# 辺に書けない —— **文の反復空間の上に場を一つ置き**（`_g<ta>[ループの変数] <- x % 2`）、辺を
# その読みに差し替える。コンパイラの ANF（部分式に名前を付ける）を反復空間に開いたもの。
# 区間は **字を動かすだけ** で作る: 区間の字は本文の行から塊の行へ移り（字に付く差し替えも一緒に）、
# 本文の抜けた行に参照 `_g<ta>[…]` を置く。場は flat（座標ごとに値は一つ。比べる前に閉じる）。
field lsym : or bound 262144                # 算術の記号（矢印の `-` を除く）
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 43
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 45 if not arrw[t-1]
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 42
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 47
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 37
field lgz : max bound 1                     # 最後の節の番号
lgz[z] <- gcl[t]                   for (t,zc) in ch for (z) in 0 .. 0
field lch : max bound 262144                # 節 g の頭のトークン
lch[gcl[t]] <- t                   for (t,zc) in ch if cbrk[t]
field lgi : or bound 262144                 # 節 g は `if` の節
lgi[g] <- true                     for (g) in 0 .. lgz[0] if kwif[lch[g]]
field lgd : max bound 262144                # 節 g の深さ（`if` の括弧の深さ）
lgd[g] <- tdep[lch[g]]             for (g) in 0 .. lgz[0] if lgi[g]
field lcm : min bound 262144                # 節 g の最初の比較の記号（節の深さで）
lcm[gcl[t]] <- t                   for (t,zc) in ch if cmpt[t] if tdep[t] == lgd[gcl[t]]
field lcx : max bound 262144                # 節 g の最後の比較の記号
lcx[gcl[t]] <- t                   for (t,zc) in ch if cmpt[t] if tdep[t] == lgd[gcl[t]]
field lce : max bound 262144                # 節 g の最後の語か記号
lce[gcl[t]] <- t                   for (t,zc) in ch if tkind[t] != 3 if not tcom[t] if lgi[gcl[t]]
field lal : or bound 262144                 # 節 g の左辺に算術
lal[gcl[t]] <- true                for (t,zc) in ch if lsym[t] if tdep[t] == lgd[gcl[t]] if t < lcm[gcl[t]]
      if t > lch[gcl[t]]
field lar : or bound 262144                 # 節 g の右辺に算術
lar[gcl[t]] <- true                for (t,zc) in ch if lsym[t] if tdep[t] == lgd[gcl[t]] if t > lcx[gcl[t]]
# 文 s のループ（0 起点で二つまで。種を規則にした文は一点のループ `_z`）
field lnlp : max bound 8192                 # 文 s の for 節の数
lnlp[snum[t]] <- lz[t] + 1         for (t,zc) in ch if kwfor[t] if lz[t] >= 0
field lok : or bound 8192                   # 文 s は持ち上げてよい（ループが二つまで）
lok[s] <- true                     for (s) in 0 .. nstz[0] if lnlp[s] >= 1
lok[s] <- true                     for (s) in 0 .. nstz[0] if lsx[s]
field lcd : max bound 262144                # 持ち上げる候補の区間: 最初のトークン → 最後のトークン
lcd[nextw[lch[g]]] <- prevw[lcm[g]]   for (g) in 0 .. lgz[0] if lal[g] if lok[snum[lch[g]]]
lcd[nextw[lcx[g]]] <- lce[g]          for (g) in 0 .. lgz[0] if lar[g] if lok[snum[lch[g]]]
# **座標の次元**: 焼き手の前段（lib/fold.lx）が「座標の語として読めた」と数えなかった語 u
# （`c[i*2]` の `*`・`2`、`out[o[x], x - o[x]]` の `- o[x]` …）—— 焼き手が理由 8 で断る語
# **そのもの**を見て、その語を含む次元を持ち上げる。何を持ち上げるかの判断を下ろしに
# 二度書かない（気づき34）。書き先の座標の「定数で引いた読み」（`op[n[0] + 1]`）も同じく持ち上げる。
field lbo : max bound 262144                # `[` のトークン → その出現
lbo[obr[t]] <- t                   for (t,zc) in ch if obk[t]
field lqx : max bound 262144                # 次元を持ち上げさせる語 → その出現
lqx[u] <- lbo[ibr[u]]              for (u,zc) in ch if tdep[u] >= 1 if tch[ibr[u], 0] == 91
      if tkind[u] != 3 if not tcom[u] if not crdok[u] if not qdl[u]
field lhd : or bound 262144                 # 出現のトークン t は書き先
lhd[t] <- true                     for (t,zc) in ch if isocc[t] if ohd[oseq[t]]
lqx[p] <- lbo[ibr[p]]              for (p,zc) in ch if obk[p] if isnum[ob1[p]] if lhd[lbo[ibr[p]]]
lqx[p] <- lbo[ibr[p]]              for (p,zc) in ch if obk[p] if lemp[obr[p]] if lhd[lbo[ibr[p]]]
      if not lsxf[obr[p]]
lqx[p] <- lbo[ibr[p]]              for (p,zc) in ch if obk[p] if qrl[ob1[p]] if lhd[lbo[ibr[p]]]
field lq2 : or bound 262144                 # 語 u は出現の次元 1 に居る
lq2[u] <- true                     for (u,zc) in ch if lqx[u] >= 0 if iscom[d0cm[lqx[u]]] if u > d0cm[lqx[u]]
field lqo : max bound 262144                # 次元 0 を持ち上げる出現
lqo[u] <- lqx[u]                   for (u,zc) in ch if lqx[u] >= 0 if not lq2[u]
field lqo1 : max bound 262144               # 次元 1 を持ち上げる出現
# **三次元以上の出現の次元1 は持ち上げない。** 焼き手の前段は次元1 の後ろの語を座標と数えないので、
# 持ち上げると `,` ごと塊に入り、焼き手は **下ろしが足した行**（利用者の知らない行番号）で断る。
# 持ち上げなければ利用者の書いた行で断る（三次元は焼き手の資源 —— 次の口）
field lbc : max bound 262144                # 添字の `,` → その `[` の出現
lbc[c] <- lbo[ibr[c]]              for (c,zc) in ch if iscom[c] if tch[ibr[c], 0] == 91
field l3o : or bound 262144                 # 三次元以上の出現（次元1 の後ろにもう一つ `,`）
l3o[lbc[c]] <- true                for (c,zc) in ch if lbc[c] >= 0 if c > d0cm[lbc[c]]
lqo1[u] <- lqx[u]                  for (u,zc) in ch if lq2[u] if not l3o[lqx[u]]
lcd[ob1[lqo[u]]] <- prevw[d0cm[lqo[u]]]      for (u,zc) in ch if lqo[u] >= 0 if iscom[d0cm[lqo[u]]]
      if lok[snum[u]]
lcd[ob1[lqo[u]]] <- prevw[tclos[obr[lqo[u]]]]   for (u,zc) in ch if lqo[u] >= 0 if not iscom[d0cm[lqo[u]]]
      if lok[snum[u]]
lcd[d1t[lqo1[u]]] <- prevw[tclos[obr[lqo1[u]]]] for (u,zc) in ch if lqo1[u] >= 0 if lok[snum[u]]
# **値の丸括弧**（`(120 + c[0]) % 256`）: 焼ける値は群の和で、丸括弧を持たない。区間は括弧ごと取り、
# 括弧の字は消す（中身だけが塊へ移る）
field lpc : max bound 262144                # `(` → 対の `)`（tclos は `[` だけ）
lpc[tmatch[t]] <- t                for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 41
lcd[t] <- lpc[t]                   for (t,zc) in ch if isopn[t] if aftarw[t] if not tcom[t] if lok[snum[t]]
# **いちばん外の候補だけ**を持ち上げる（入れ子はまだ無し: 一つの字は一つの区間まで）。
# 候補の開きと閉じで深さの鎖を引き、深さ 1 で始まる候補が外側
field lcs0 : or bound 262144                # 候補の最初のトークン
lcs0[t] <- true                    for (t,zc) in ch if lcd[t] >= 0
field lce0 : or bound 262144                # 候補の最後のトークン
lce0[lcd[t]] <- true               for (t,zc) in ch if lcd[t] >= 0
field ldp : max bound 262144                # トークン t を含む候補の数
ldp[0] <- 0
ldp[0] <- 1                        for (z) in 0 .. 0 if lcs0[0]
ldp[t] <- ldp[t-1] + 1             for (t,zc) in ch if t >= 1 if lcs0[t] if not lce0[t-1]
ldp[t] <- ldp[t-1]                 for (t,zc) in ch if t >= 1 if lcs0[t] if lce0[t-1]
ldp[t] <- ldp[t-1] - 1             for (t,zc) in ch if t >= 1 if not lcs0[t] if lce0[t-1]
ldp[t] <- ldp[t-1]                 for (t,zc) in ch if t >= 1 if not lcs0[t] if not lce0[t-1]
# **塊の場の次元は、区間が使うループだけ**（ループ不変の持ち上げ）。区間の値が依らないループは
# 塊の座標に要らない —— 四重のループの文でも、区間が二つのループの変数しか使わなければ二次元の場で
# 済む（多面体の射影）。使うループが三つ以上の区間は持ち上げない（焼き手が理由 8 で言う）。
# 使うループは区間の中身で決まり、区間は候補の深さの鎖で決まる —— 絞る前の区間（lse0）で数えて、
# それから絞る（絞った結果で数えると、数えたものが自分の区間を決める輪になる）
field lse0 : max bound 262144               # いちばん外の候補: 最初のトークン → 最後のトークン
lse0[t] <- lcd[t]                  for (t,zc) in ch if lcd[t] >= 0 if ldp[t] == 1
field lsa0 : or bound 262144
lsa0[t] <- true                    for (t,zc) in ch if lse0[t] >= 0
field lend0 : or bound 262144
lend0[lse0[t]] <- true             for (t,zc) in ch if lsa0[t]
field lcur0 : max bound 262144              # トークン t を含む外の候補の最初のトークン
lcur0[t] <- t                      for (t,zc) in ch if lsa0[t]
lcur0[t] <- lcur0[t-1]             for (t,zc) in ch if t >= 1 if not lsa0[t] if not lend0[t-1]
field lru : or bound 262144 8               # 候補 ta はループ L の変数を使う
lru[lcur0[u], vlpz[u]] <- true     for (u,zc) in ch if lcur0[u] >= 0 if tkind[u] == 1 if vbnd[u] >= 0
      if not isbind[u] if not tcom[u] if not qi[u] if vlpz[u] <= 7
field lrn0 : min bound 262144               # 使う最初のループ
lrn0[t] <- l                       for (t,zc) in ch for (l) in 0 .. 7 if lru[t, l]
field lrn1 : max bound 262144               # 使う最後のループ
lrn1[t] <- l                       for (t,zc) in ch for (l) in 0 .. 7 if lru[t, l]
field lr3 : or bound 262144                 # 三つ以上のループを使う
lr3[t] <- true                     for (t,zc) in ch for (l) in 0 .. 7 if lru[t, l] if l > lrn0[t] if l < lrn1[t]
field lse : max bound 262144                # 持ち上げる区間の最初のトークン → 最後のトークン
lse[t] <- lse0[t]                  for (t,zc) in ch if lsa0[t] if not lr3[t]
field lsa : or bound 262144                 # 区間の最初のトークン
lsa[t] <- true                     for (t,zc) in ch if lse[t] >= 0
field lend : or bound 262144                # 区間の最後のトークン
lend[lse[t]] <- true               for (t,zc) in ch if lsa[t]
# **鎖の値を比べない。** `if lse[lcur[t-1]] >= t` と書くと、鎖が自分を比較で読む（成層できない）。
# 終わりの印は鎖に依らないので、「一つ前が終わりでなければ続く」と書ける
field lcur : max bound 262144               # トークン t を含む区間の最初のトークン
lcur[t] <- t                       for (t,zc) in ch if lsa[t]
lcur[t] <- lcur[t-1]               for (t,zc) in ch if t >= 1 if not lsa[t] if not lend[t-1]
field lcs : max bound 262144                # 区間 ta の最初の字
lcs[t] <- tstart[t]                for (t,zc) in ch if lsa[t]
field lcl : max bound 262144                # 区間 ta の字の数
lcl[t] <- lte[lse[t]] - tstart[t] + 1   for (t,zc) in ch if lsa[t]
field lbz : max bound 262144                # 区間 ta の塊の行の数（頭二 + 字 + ループ二 + 宣言 + 予備）
lbz[t] <- lcl[t] + 6               for (t,zc) in ch if lsa[t]
field lbk : max bound 262144                # トークン t より前の塊の行の数（前置きの鎖）
lbk[0] <- 0
lbk[t] <- lbk[t-1] + lbz[t-1]      for (t,zc) in ch if t >= 1 if lbz[t-1] >= 1
lbk[t] <- lbk[t-1]                 for (t,zc) in ch if t >= 1 if not lbz[t-1]
field lhbk : max bound 262144               # 区間 ta の塊の最初の行（末尾の 393216 から）
lhbk[t] <- lbk[t] + 393216          for (t,zc) in ch if lsa[t]
# 字 i の行: ふだんは i（本文）、区間の中なら塊の行（頭の二行の後ろ）
field lin2 : or bound 262144                # 字 i は区間の中
lin2[i] <- true                    for (i,c) in ch if lcur[tnum[i]] >= 0
field lrw : max bound 262144                # 字 i の行
lrw[i] <- i                        for (i,c) in ch if not lin2[i]
lrw[i] <- lhbk[lcur[tnum[i]]] + 2 + i - lcs[lcur[tnum[i]]]   for (i,c) in ch if lin2[i]
# 文 s のループ L の書き方（1 表 / 2 区間の数 / 3 上端が場 / 4 一点）と穴
field lkk : max bound 8192 8
field lkv : max bound 8192 8                # 束縛のトークン（区間のループ）
field lkl : max bound 8192 8                # 下端（区間）/ L（表）
field lkh : max bound 8192 8                # 上端（数）/ 行数-1（表）/ 上端の場の添字
field lkf : max bound 8192 8                # 上端の場（宣言の番号。1 起点）
field lkb : max bound 8192 8                # 塊の場のその次元の広さ
lkk[snum[u], lz[u]] <- 1           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
lkl[snum[u], lz[u]] <- lz[u]       for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
lkh[snum[u], lz[u]] <- nrw[tix[u]] - 1   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
lkb[snum[u], lz[u]] <- nrw[tix[u]] for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
lkk[snum[u], lz[u]] <- 2           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if ltr[tix[u]]
lkl[snum[u], lz[u]] <- trl[tix[u]] for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if ltr[tix[u]]
lkh[snum[u], lz[u]] <- trh[tix[u]] - 1   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if ltr[tix[u]]
lkb[snum[u], lz[u]] <- trh[tix[u]] for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if ltr[tix[u]]
lkk[snum[u], lz[u]] <- 2           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 1
lkl[snum[u], lz[u]] <- llo2[snum[u], lz[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 1
lkh[snum[u], lz[u]] <- lhi2[snum[u], lz[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 1
lkb[snum[u], lz[u]] <- lhi2[snum[u], lz[u]] + 1   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 1
lkk[snum[u], lz[u]] <- 3           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2
lkl[snum[u], lz[u]] <- llo2[snum[u], lz[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2
lkh[snum[u], lz[u]] <- tval[int4b[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2 if isnum[int4b[u]]
lkh[snum[u], lz[u]] <- 0           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2 if not isnum[int4b[u]]
lkf[snum[u], lz[u]] <- lbf2[snum[u], lz[u]] + 1   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2
lkb[snum[u], lz[u]] <- 4096        for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2
lkv[snum[t], lz[t]] <- nextw[nextw[t]]   for (t,zc) in ch if kwfor[t] if lz[t] >= 0 if lz[t] <= 7
lkk[s, 0] <- 4                     for (s) in 0 .. nstz[0] if lsx[s]
lkb[s, 0] <- 1                     for (s) in 0 .. nstz[0] if lsx[s]
field lnk : max bound 8192                  # 文 s のループの数（一点も一つ）
lnk[s] <- lnlp[s]                  for (s) in 0 .. nstz[0] if lnlp[s] >= 1
lnk[s] <- 1                        for (s) in 0 .. nstz[0] if lsx[s]

# ── 消すもの ─────────────────────────────────────────────────────────────
field ltd : or bound 262144                 # 消すトークン
# 表のループの for 節（`for` の後ろから表の名まで）
ltd[t] <- true      for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7
      if t > lft[snum[t], lz[t]] if t <= lit[snum[t], lz[t]]
# 表のループの変数の出現（束縛そのものは for 節と一緒に消える）
field lvt : max bound 262144                # 変数の出現 t のループが回す表
lvt[t] <- ltk[snum[t], vlpz[t]]    for (t,zc) in ch if tkind[t] == 1 if vbnd[t] >= 0
field lvu : or bound 262144
lvu[t] <- true      for (t,zc) in ch if tkind[t] == 1 if not tcom[t] if not isbind[t] if not qi[t] if not lsel[t]
      if not kwin[prevw[t]]
      if vbnd[t] >= 0 if lkd[snum[t], vlpz[t]] == 0 if not ltr[lvt[t]]
ltd[t] <- true      for (t,zc) in ch if lvu[t]
ltd[t] <- true      for (t,zc) in ch if lrn[t] >= 0
field ldl : or bound 262144                 # 消す字
ldl[i] <- true      for (i,c) in ch if istb[snum[tnum[i]]] if c != 10
ldl[i] <- true      for (i,c) in ch if lsp[snum[tnum[i]]] if c != 10
ldl[i] <- true      for (i,c) in ch if ltd[tnum[i]]
ldl[i] <- true      for (i,c) in ch if qdl[tnum[i]]
# 集合: 宣言の `set`、値の `{` と要素と `}`、鍵が一つの書き先の `]`、`is`
field lsdl : or bound 262144
lsdl[latt[t]] <- true              for (t,zc) in ch if isdcl[t] if lsk[fdno[t]]
lsdl[lsvb[s]] <- true              for (s) in 0 .. nstz[0] if lss[s]
lsdl[lsvc[s]] <- true              for (s) in 0 .. nstz[0] if lss[s]
lsdl[t] <- true                    for (t,zc) in ch if lsel[t]
lsdl[t] <- true                    for (t,zc) in ch if lsx1[t] >= 0
lsdl[t] <- true                    for (t,zc) in ch if lisk[t] >= 1
ldl[i] <- true      for (i,c) in ch if lsdl[tnum[i]]
ldl[i] <- true      for (i,c) in ch if lnt[tnum[i]] >= 1
field lpp0 : or bound 262144                # 持ち上げる丸括弧の `(`
lpp0[t] <- true     for (t,zc) in ch if lsa[t] if isopn[t]
ldl[tstart[t]] <- true         for (t,zc) in ch if lpp0[t]
ldl[tstart[lse[t]]] <- true    for (t,zc) in ch if lpp0[t]

# ── 差すもの（実例）: 型紙・穴・名前。本文の実例は行（irw）も持つ ──────────────────
field iti : max bound 262272 8              # 実例 [n, e] の型紙
field irw : max bound 262272 8              # 本文の実例の行（源の字の位置）。無ければ末尾
field ih0 : max bound 262272 8
field ih1 : max bound 262272 8
field ih2 : max bound 262272 8
field ih3 : max bound 262272 8
field ind : max bound 262272 8              # 名前の升が引く宣言（1 起点）
field inm : max bound 262272 8              # 綴りの升が引くトークン（束縛の変数名）
field ibd : or bound 262272 8               # 本文の実例（行は ibr）
# 型紙 0: 表のループの `for` の後ろ → ` (_r<L>) in 0 .. <行数-1>`
field lfk0 : max bound 262144               # `for` のトークン t が回す表
lfk0[t] <- ltk[snum[t], lz[t]]     for (t,zc) in ch if kwfor[t] if lz[t] >= 0 if lz[t] <= 7
      if lkd[snum[t], lz[t]] == 0
field lfk : max bound 262144                # そのうち行を持つ表（range でない）
lfk[t] <- lfk0[t]                  for (t,zc) in ch if lfk0[t] >= 0 if not ltr[lfk0[t]]
iti[lin[t], 0] <- 0                for (t,zc) in ch if lfk[t] >= 0
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lfk[t] >= 0
ibd[lin[t], 0] <- true           for (t,zc) in ch if lfk[t] >= 0
ih0[lin[t], 0] <- lz[t]            for (t,zc) in ch if lfk[t] >= 0
ih1[lin[t], 0] <- nrw[lfk[t]] - 1  for (t,zc) in ch if lfk[t] >= 0
# 型紙 1: 表の変数 → `_t<k>c<j>[_r<L>]`
iti[lin[t], 0] <- 1                for (t,zc) in ch if lvu[t]
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lvu[t]
ibd[lin[t], 0] <- true           for (t,zc) in ch if lvu[t]
ih0[lin[t], 0] <- lvt[t]          for (t,zc) in ch if lvu[t]
ih1[lin[t], 0] <- vcolz[t]         for (t,zc) in ch if lvu[t]
ih2[lin[t], 0] <- vlpz[t]          for (t,zc) in ch if lvu[t]
# 型紙 7: range の表の名 → ` a .. b-1`
iti[lin[t], 0] <- 7                for (t,zc) in ch if lrn[t] >= 0
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lrn[t] >= 0
ibd[lin[t], 0] <- true             for (t,zc) in ch if lrn[t] >= 0
ih0[lin[t], 0] <- trl[lrn[t]]      for (t,zc) in ch if lrn[t] >= 0
ih1[lin[t], 0] <- trh[lrn[t]] - 1  for (t,zc) in ch if lrn[t] >= 0
# 型紙 8: 焼ける種の形でない種（値が式・読み・負の数、座標が式）→ 末尾に ` for (_z) in 0 .. 0`
#   焼ける種は「数の座標 <- 数か true」だけ（SPEC §12）。規則にすれば一点の区間で同じ意味になる。
field lsx : or bound 8192                   # 文 s は種だが、焼ける種の形でない
lsx[snum[t]] <- true               for (t,zc) in ch if isseed[snum[t]] if tkind[t] == 4 if not tcom[t]
      if tch[t,0] != 91 if tch[t,0] != 93 if tch[t,0] != 44 if not arrw[t] if not arrw[t-1] if not qq[t]
lsx[snum[t]] <- true               for (t,zc) in ch if isseed[snum[t]] if isocc[t] if not tcom[t]
      if t > arrowt[snum[t]]
field lsl : max bound 8192                  # 文 s の最後の語か記号
lsl[snum[t]] <- t                  for (t,zc) in ch if tkind[t] != 3 if not tcom[t]
field lsq : or bound 262144                 # 規則にする種の最後のトークン
lsq[t] <- true                     for (t,zc) in ch if lsx[snum[t]] if lsl[snum[t]] == t
iti[lin[t], 0] <- 8                for (t,zc) in ch if lsq[t]
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lsq[t]
ibd[lin[t], 0] <- true             for (t,zc) in ch if lsq[t]
# 型紙 2 / 3: 広さの無い場 → ` bound …`（束のトークンの後ろ）
field lnb : or bound 262144                 # 宣言 t は広さを書いていない
lnb[t] <- true                     for (t,zc) in ch if isdcl[t] if not kwbnd[bndt[t]]
field lnl : max bound 262144                # その束のトークン
lnl[t] <- latt[t]                  for (t,zc) in ch if lnb[t]
iti[lin[lnl[t]], 0] <- 2           for (t,zc) in ch if lnb[t] if farr[fdno[t]] == 1 if not lsk[fdno[t]]
iti[lin[lnl[t]], 0] <- 3           for (t,zc) in ch if lnb[t] if farr[fdno[t]] == 2 if not lsk[fdno[t]]
ih0[lin[lnl[t]], 0] <- lb1[fdno[t]] for (t,zc) in ch if lnb[t]
ih1[lin[lnl[t]], 0] <- lb2[fdno[t]] for (t,zc) in ch if lnb[t] if farr[fdno[t]] == 2
irw[lin[lnl[t]], 0] <- lrw[lte[lnl[t]]] for (t,zc) in ch if lnb[t]
ibd[lin[lnl[t]], 0] <- true for (t,zc) in ch if lnb[t]
# 型紙 4: `n[]` → `n[0]`
field lob : or bound 262144                 # `[`
lob[t] <- true                     for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 91
field lcb : or bound 262144                 # `]`
lcb[t] <- true                     for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 93
field lemp : or bound 262144                # 中身の無い `[]` の `[`
lemp[t] <- true                    for (t,zc) in ch if lob[t] if lcb[nextw[t]]
iti[lin[t], 0] <- 4                for (t,zc) in ch if lemp[t] if not lsxf[t]
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lemp[t]
ibd[lin[t], 0] <- true           for (t,zc) in ch if lemp[t]
# 型紙 5: 表の升 → 種 `_t<k>c<j>[<行>] <- <値>`（末尾。原子は綴りの順の番号）
iti[lin[t], 0] <- 5                for (t,zc) in ch if ltc[t]
ih0[lin[t], 0] <- tbk[snum[t]]     for (t,zc) in ch if ltc[t]
ih1[lin[t], 0] <- colc[t]          for (t,zc) in ch if ltc[t]
ih2[lin[t], 0] <- rowc[t] - 1      for (t,zc) in ch if ltc[t]
ih3[lin[t], 0] <- ltv[t]           for (t,zc) in ch if ltc[t]
# 型紙 6: 表の列 → `field _t<k>c<j> : flat bound <行数>`（一行目の升の手前の `(` か `,` が持つ）
field lfc : max bound 262144                # 一行目の升 t の手前の記号
lfc[t] <- prevw[t]                 for (t,zc) in ch if ltc[t] if rowc[t] == 1
iti[lin[lfc[t]], 0] <- 6           for (t,zc) in ch if ltc[t] if rowc[t] == 1
ih0[lin[lfc[t]], 0] <- tbk[snum[t]] for (t,zc) in ch if ltc[t] if rowc[t] == 1
ih1[lin[lfc[t]], 0] <- colc[t]     for (t,zc) in ch if ltc[t] if rowc[t] == 1
ih2[lin[lfc[t]], 0] <- nrw[tbk[snum[t]]] for (t,zc) in ch if ltc[t] if rowc[t] == 1
# 型紙 10〜24: print（名のトークン t が、手前の `print` の最初の字に並べる）
#   一次元: 10 宣言 / 11 行の番号 / 12 値を集める / 13 頭と終わり / 14 行と print の上限 / 15 or
iti[lpd[t], 0] <- 10               for (t,zc) in ch if lp1[t]
ih0[lpd[t], 0] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih1[lpd[t], 0] <- lb1[lpf[t]]      for (t,zc) in ch if lp1[t]
iti[lpd[t], 1] <- 11               for (t,zc) in ch if lp1[t]
ih0[lpd[t], 1] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih1[lpd[t], 1] <- lpb[t] + 1       for (t,zc) in ch if lp1[t]
ih2[lpd[t], 1] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lp1[t]
iti[lpd[t], 2] <- 12               for (t,zc) in ch if lp1[t]
ih0[lpd[t], 2] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih2[lpd[t], 2] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lp1[t]
ind[lpd[t], 2] <- lpf[t] + 1       for (t,zc) in ch if lp1[t]
iti[lpd[t], 3] <- 13               for (t,zc) in ch if lp1[t]
ih0[lpd[t], 3] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih1[lpd[t], 3] <- lpb[t]           for (t,zc) in ch if lp1[t]
ih2[lpd[t], 3] <- lpe[t]           for (t,zc) in ch if lp1[t]
iti[lpd[t], 4] <- 14               for (t,zc) in ch if lp1[t]
ih0[lpd[t], 4] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih2[lpd[t], 4] <- lpe[t]           for (t,zc) in ch if lp1[t]
iti[lpd[t], 5] <- 15               for (t,zc) in ch if lp1[t] if lpor[t]
ih0[lpd[t], 5] <- lpp[t]           for (t,zc) in ch if lp1[t] if lpor[t]
iti[lpd[t], 6] <- 25               for (t,zc) in ch if lp1[t] if lf0[lpf[t]]
ih0[lpd[t], 6] <- lpp[t]           for (t,zc) in ch if lp1[t] if lf0[lpf[t]]
#   二次元: 16 宣言 / 17 行の番号 + 18 輪 / 19 値 + 18 / 20 座標0 + 18 + 22 / 21 座標1 + 18 + 22 /
#           13 / 14 / 23 二次元の印 / 15 or
field lpd1 : max bound 262144               # print のトークンの二文字目の実例の番号
lpd1[t] <- lpd[t] + 1              for (t,zc) in ch if lpo[t]
iti[lpd[t], 0] <- 16               for (t,zc) in ch if lp2[t]
ih0[lpd[t], 0] <- lpp[t]           for (t,zc) in ch if lp2[t]
ih1[lpd[t], 0] <- lb1[lpf[t]]      for (t,zc) in ch if lp2[t]
ih2[lpd[t], 0] <- lb2[lpf[t]]      for (t,zc) in ch if lp2[t]
iti[lpd[t], 1] <- 17               for (t,zc) in ch if lp2[t]
ih0[lpd[t], 1] <- lpp[t]           for (t,zc) in ch if lp2[t]
ih1[lpd[t], 1] <- lb2[lpf[t]]      for (t,zc) in ch if lp2[t]
ih2[lpd[t], 1] <- lpb[t] + 1       for (t,zc) in ch if lp2[t]
iti[lpd[t], 3] <- 19               for (t,zc) in ch if lp2[t]
ih0[lpd[t], 3] <- lpp[t]           for (t,zc) in ch if lp2[t]
ind[lpd[t], 3] <- lpf[t] + 1       for (t,zc) in ch if lp2[t]
iti[lpd[t], 5] <- 20               for (t,zc) in ch if lp2[t]
ih0[lpd[t], 5] <- lpp[t]           for (t,zc) in ch if lp2[t]
iti[lpd[t], 7] <- 22               for (t,zc) in ch if lp2[t]
ind[lpd[t], 7] <- lpf[t] + 1       for (t,zc) in ch if lp2[t]
iti[lpd1[t], 0] <- 21              for (t,zc) in ch if lp2[t]
ih0[lpd1[t], 0] <- lpp[t]          for (t,zc) in ch if lp2[t]
iti[lpd1[t], 2] <- 22              for (t,zc) in ch if lp2[t]
ind[lpd1[t], 2] <- lpf[t] + 1      for (t,zc) in ch if lp2[t]
iti[lpd1[t], 3] <- 13              for (t,zc) in ch if lp2[t]
ih0[lpd1[t], 3] <- lpp[t]          for (t,zc) in ch if lp2[t]
ih1[lpd1[t], 3] <- lpb[t]          for (t,zc) in ch if lp2[t]
ih2[lpd1[t], 3] <- lpe[t]          for (t,zc) in ch if lp2[t]
iti[lpd1[t], 4] <- 14              for (t,zc) in ch if lp2[t]
ih0[lpd1[t], 4] <- lpp[t]          for (t,zc) in ch if lp2[t]
ih2[lpd1[t], 4] <- lpe[t]          for (t,zc) in ch if lp2[t]
iti[lpd1[t], 5] <- 23              for (t,zc) in ch if lp2[t]
ih0[lpd1[t], 5] <- lpp[t]          for (t,zc) in ch if lp2[t]
iti[lpd1[t], 6] <- 15              for (t,zc) in ch if lp2[t] if lpor[t]
ih0[lpd1[t], 6] <- lpp[t]          for (t,zc) in ch if lp2[t] if lpor[t]
#   輪（18）は 2 / 4 / 6 と二文字目の 1 に置く（値・座標の規則の続きの行）
iti[lpd[t], 2] <- 18               for (t,zc) in ch if lp2[t]
iti[lpd[t], 4] <- 18               for (t,zc) in ch if lp2[t]
iti[lpd[t], 6] <- 18               for (t,zc) in ch if lp2[t]
iti[lpd1[t], 1] <- 18              for (t,zc) in ch if lp2[t]
ih1[lpd[t], 2] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih2[lpd[t], 2] <- lb2[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih1[lpd[t], 4] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih2[lpd[t], 4] <- lb2[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih1[lpd[t], 6] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih2[lpd[t], 6] <- lb2[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih1[lpd1[t], 1] <- lb1[lpf[t]] - 1 for (t,zc) in ch if lp2[t]
ih2[lpd1[t], 1] <- lb2[lpf[t]] - 1 for (t,zc) in ch if lp2[t]
#   名前の字（24）: 名のトークンの字 i ごとに `_pnm[<p>, <k>] <- <字>`
iti[i + 127, 0] <- 24              for (i,c) in ch if lpo[tnum[i]] if cpos[i] <= 31
ih0[i + 127, 0] <- lpp[tnum[i]]    for (i,c) in ch if lpo[tnum[i]] if cpos[i] <= 31
ih1[i + 127, 0] <- cpos[i]         for (i,c) in ch if lpo[tnum[i]] if cpos[i] <= 31
ih2[i + 127, 0] <- c               for (i,c) in ch if lpo[tnum[i]] if cpos[i] <= 31
#   原子（26 座標0 / 27 座標1 / 28 値）: print のトークンの三文字目に並べる
field lpd2 : max bound 262144
lpd2[t] <- lpd[t] + 2              for (t,zc) in ch if lpo[t]
iti[lpd2[t], 0] <- 26              for (t,zc) in ch if lpo[t] if aat[lpf[t], 0]
ih0[lpd2[t], 0] <- lpp[t]          for (t,zc) in ch if lpo[t] if aat[lpf[t], 0]
iti[lpd2[t], 1] <- 27              for (t,zc) in ch if lpo[t] if aat[lpf[t], 1]
ih0[lpd2[t], 1] <- lpp[t]          for (t,zc) in ch if lpo[t] if aat[lpf[t], 1]
iti[lpd2[t], 2] <- 28              for (t,zc) in ch if lpo[t] if aav[lpf[t]]
ih0[lpd2[t], 2] <- lpp[t]          for (t,zc) in ch if lpo[t] if aav[lpf[t]]
# 型紙 9: 規則・種の中の文字列 → 番号（開きの `"` が差す。字は消える）
iti[lin[t], 0] <- 9                for (t,zc) in ch if qrl[t]
irw[lin[t], 0] <- lrw[lte[t]]      for (t,zc) in ch if qrl[t]
ibd[lin[t], 0] <- true             for (t,zc) in ch if qrl[t]
ih0[lin[t], 0] <- qv[t]            for (t,zc) in ch if qrl[t]
# 型紙 29: 正体の綴り → `_an[番号, k] <- バイト`（綴りの字 i が一つずつ。末尾）
iti[i + 127, 1] <- 29              for (i,c) in ch if atci[i] >= 0 if atf[atci[i]]
ih0[i + 127, 1] <- atr[atci[i]]    for (i,c) in ch if atci[i] >= 0 if atf[atci[i]]
ih1[i + 127, 1] <- atcp[i]         for (i,c) in ch if atci[i] >= 0 if atf[atci[i]]
ih2[i + 127, 1] <- c               for (i,c) in ch if atci[i] >= 0 if atf[atci[i]]

# 集合（48〜65）: 宣言 `set` → `or bound …`
iti[lin[latt[t]], 0] <- 48         for (t,zc) in ch if isdcl[t] if lsk0[fdno[t]]
iti[lin[latt[t]], 0] <- 49         for (t,zc) in ch if isdcl[t] if lsk1[fdno[t]]
ih0[lin[latt[t]], 0] <- lb1[fdno[t]]   for (t,zc) in ch if isdcl[t] if lsk[fdno[t]]
ih1[lin[latt[t]], 0] <- lb2[fdno[t]]   for (t,zc) in ch if isdcl[t] if lsk1[fdno[t]]
irw[lin[latt[t]], 0] <- lrw[lte[latt[t]]]   for (t,zc) in ch if isdcl[t] if lsk[fdno[t]]
ibd[lin[latt[t]], 0] <- true       for (t,zc) in ch if isdcl[t] if lsk[fdno[t]]
#   値 `{e}` → `true`
iti[lin[lsvb[s]], 0] <- 54         for (s) in 0 .. nstz[0] if lss[s]
irw[lin[lsvb[s]], 0] <- lrw[lte[lsvb[s]]]   for (s) in 0 .. nstz[0] if lss[s]
ibd[lin[lsvb[s]], 0] <- true       for (s) in 0 .. nstz[0] if lss[s]
#   書き先: `s[]` の `[` が要素を差す（1 / 50 / 9）、`s[k]` の `]` が `, 要素]` を差す（51 / 52 / 53）
field lsxe : max bound 262144               # 書き先の括弧 t の要素のトークン
lsxe[t] <- lsve[lsxs[t]]           for (t,zc) in ch if lsxf[t]
field lsxk : max bound 262144               # その書き方
lsxk[t] <- lsek[lsxs[t]]           for (t,zc) in ch if lsxf[t]
iti[lin[t], 0] <- 1                for (t,zc) in ch if lsx0[t] >= 0 if lsxk[t] == 1
iti[lin[t], 0] <- 50               for (t,zc) in ch if lsx0[t] >= 0 if lsxk[t] == 2
iti[lin[t], 0] <- 9                for (t,zc) in ch if lsx0[t] >= 0 if lsxk[t] == 3
iti[lin[t], 0] <- 51               for (t,zc) in ch if lsx1[t] >= 0 if lsxk[t] == 1
iti[lin[t], 0] <- 52               for (t,zc) in ch if lsx1[t] >= 0 if lsxk[t] == 2
iti[lin[t], 0] <- 53               for (t,zc) in ch if lsx1[t] >= 0 if lsxk[t] == 3
ih0[lin[t], 0] <- lvt[lsxe[t]]     for (t,zc) in ch if lsxk[t] == 1
ih1[lin[t], 0] <- vcolz[lsxe[t]]   for (t,zc) in ch if lsxk[t] == 1
ih2[lin[t], 0] <- vlpz[lsxe[t]]    for (t,zc) in ch if lsxk[t] == 1
inm[lin[t], 0] <- lsxe[t]          for (t,zc) in ch if lsxk[t] == 2
ih0[lin[t], 0] <- lsev[lsxs[t]]    for (t,zc) in ch if lsxk[t] == 3
irw[lin[t], 0] <- lrw[lte[t]]      for (t,zc) in ch if lsxf[t]
ibd[lin[t], 0] <- true             for (t,zc) in ch if lsxf[t]
#   `is` → `<=` / `>=` / `==`
iti[lin[t], 0] <- lisk[t]          for (t,zc) in ch if lisk[t] >= 1
irw[lin[t], 0] <- lrw[lte[t]]      for (t,zc) in ch if lisk[t] >= 1
ibd[lin[t], 0] <- true             for (t,zc) in ch if lisk[t] >= 1
#   print（鍵の無い集合 lps0 / 鍵が一つ lps1。要素が数なら綴りの順の番号 `_sc` で並べる）
field lps0 : or bound 262144
lps0[t] <- true                    for (t,zc) in ch if lpo[t] if lsk0[lpf[t]]
field lps1 : or bound 262144
lps1[t] <- true                    for (t,zc) in ch if lpo[t] if lsk1[lpf[t]]
field lpsa : or bound 262144                # 要素は原子
lpsa[t] <- true                    for (t,zc) in ch if lpo[t] if lsea[lpf[t]]
field lpsi : or bound 262144                # 要素は数
lpsi[t] <- true                    for (t,zc) in ch if lpo[t] if lsk[lpf[t]] if not lsea[lpf[t]]
field lpd3 : max bound 262144
lpd3[t] <- lpd[t] + 3              for (t,zc) in ch if lpo[t]
iti[lpd[t], 0] <- 10               for (t,zc) in ch if lps0[t]
ih0[lpd[t], 0] <- lpp[t]           for (t,zc) in ch if lps0[t]
ih1[lpd[t], 0] <- lb1[lpf[t]]      for (t,zc) in ch if lps0[t]
iti[lpd[t], 1] <- 11               for (t,zc) in ch if lps0[t] if lpsa[t]
iti[lpd[t], 1] <- 55               for (t,zc) in ch if lps0[t] if lpsi[t]
ih0[lpd[t], 1] <- lpp[t]           for (t,zc) in ch if lps0[t]
ih1[lpd[t], 1] <- lpb[t] + 1       for (t,zc) in ch if lps0[t]
ih2[lpd[t], 1] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lps0[t]
iti[lpd[t], 2] <- 56               for (t,zc) in ch if lps0[t] if lpsi[t]
ih2[lpd[t], 2] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lps0[t] if lpsi[t]
iti[lpd[t], 3] <- 12               for (t,zc) in ch if lps0[t]
ih0[lpd[t], 3] <- lpp[t]           for (t,zc) in ch if lps0[t]
ih2[lpd[t], 3] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lps0[t]
ind[lpd[t], 3] <- lpf[t] + 1       for (t,zc) in ch if lps0[t]
iti[lpd[t], 4] <- 58               for (t,zc) in ch if lps0[t]
ih0[lpd[t], 4] <- lpp[t]           for (t,zc) in ch if lps0[t]
ih2[lpd[t], 4] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lps0[t]
iti[lpd[t], 5] <- 59               for (t,zc) in ch if lps0[t]
ih0[lpd[t], 5] <- lpp[t]           for (t,zc) in ch if lps0[t]
ih1[lpd[t], 5] <- lpb[t] + 1       for (t,zc) in ch if lps0[t]
ih2[lpd[t], 5] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lps0[t]
iti[lpd[t], 6] <- 13               for (t,zc) in ch if lps0[t]
ih0[lpd[t], 6] <- lpp[t]           for (t,zc) in ch if lps0[t]
ih1[lpd[t], 6] <- lpb[t]           for (t,zc) in ch if lps0[t]
ih2[lpd[t], 6] <- lpe[t]           for (t,zc) in ch if lps0[t]
iti[lpd[t], 7] <- 14               for (t,zc) in ch if lps0[t]
ih0[lpd[t], 7] <- lpp[t]           for (t,zc) in ch if lps0[t]
ih2[lpd[t], 7] <- lpe[t]           for (t,zc) in ch if lps0[t]
iti[lpd1[t], 1] <- 62              for (t,zc) in ch if lps0[t]
ih0[lpd1[t], 1] <- lpp[t]          for (t,zc) in ch if lps0[t]
iti[lpd1[t], 2] <- 63              for (t,zc) in ch if lps0[t] if lpsa[t]
iti[lpd1[t], 2] <- 64              for (t,zc) in ch if lps0[t] if lpsi[t]
ih0[lpd1[t], 2] <- lpp[t]          for (t,zc) in ch if lps0[t]
iti[lpd1[t], 3] <- 65              for (t,zc) in ch if lps0[t] if lpsi[t]
ih0[lpd1[t], 3] <- lpp[t]          for (t,zc) in ch if lps0[t] if lpsi[t]
ih2[lpd1[t], 3] <- lb1[lpf[t]] - 1 for (t,zc) in ch if lps0[t] if lpsi[t]
iti[lpd[t], 0] <- 16               for (t,zc) in ch if lps1[t]
ih0[lpd[t], 0] <- lpp[t]           for (t,zc) in ch if lps1[t]
ih1[lpd[t], 0] <- lb1[lpf[t]]      for (t,zc) in ch if lps1[t]
ih2[lpd[t], 0] <- lb2[lpf[t]]      for (t,zc) in ch if lps1[t]
iti[lpd[t], 1] <- 17               for (t,zc) in ch if lps1[t] if lpsa[t]
iti[lpd[t], 1] <- 57               for (t,zc) in ch if lps1[t] if lpsi[t]
ih0[lpd[t], 1] <- lpp[t]           for (t,zc) in ch if lps1[t]
ih1[lpd[t], 1] <- lb2[lpf[t]]      for (t,zc) in ch if lps1[t]
ih2[lpd[t], 1] <- lpb[t] + 1       for (t,zc) in ch if lps1[t]
iti[lpd[t], 3] <- 19               for (t,zc) in ch if lps1[t]
ih0[lpd[t], 3] <- lpp[t]           for (t,zc) in ch if lps1[t]
ind[lpd[t], 3] <- lpf[t] + 1       for (t,zc) in ch if lps1[t]
iti[lpd[t], 5] <- 20               for (t,zc) in ch if lps1[t]
ih0[lpd[t], 5] <- lpp[t]           for (t,zc) in ch if lps1[t]
iti[lpd[t], 7] <- 22               for (t,zc) in ch if lps1[t]
ind[lpd[t], 7] <- lpf[t] + 1       for (t,zc) in ch if lps1[t]
iti[lpd1[t], 0] <- 60              for (t,zc) in ch if lps1[t]
ih0[lpd1[t], 0] <- lpp[t]          for (t,zc) in ch if lps1[t]
iti[lpd1[t], 2] <- 61              for (t,zc) in ch if lps1[t]
ih0[lpd1[t], 2] <- lpp[t]          for (t,zc) in ch if lps1[t]
ih1[lpd1[t], 2] <- lb2[lpf[t]]     for (t,zc) in ch if lps1[t]
ih2[lpd1[t], 2] <- lpb[t] + 1      for (t,zc) in ch if lps1[t]
iti[lpd1[t], 4] <- 13              for (t,zc) in ch if lps1[t]
ih0[lpd1[t], 4] <- lpp[t]          for (t,zc) in ch if lps1[t]
ih1[lpd1[t], 4] <- lpb[t]          for (t,zc) in ch if lps1[t]
ih2[lpd1[t], 4] <- lpe[t]          for (t,zc) in ch if lps1[t]
iti[lpd1[t], 5] <- 14              for (t,zc) in ch if lps1[t]
ih0[lpd1[t], 5] <- lpp[t]          for (t,zc) in ch if lps1[t]
ih2[lpd1[t], 5] <- lpe[t]          for (t,zc) in ch if lps1[t]
iti[lpd1[t], 6] <- 62              for (t,zc) in ch if lps1[t]
ih0[lpd1[t], 6] <- lpp[t]          for (t,zc) in ch if lps1[t]
iti[lpd1[t], 7] <- 63              for (t,zc) in ch if lps1[t] if lpsa[t]
iti[lpd1[t], 7] <- 64              for (t,zc) in ch if lps1[t] if lpsi[t]
ih0[lpd1[t], 7] <- lpp[t]          for (t,zc) in ch if lps1[t]
iti[lpd3[t], 0] <- 65              for (t,zc) in ch if lps1[t] if lpsi[t]
ih0[lpd3[t], 0] <- lpp[t]          for (t,zc) in ch if lps1[t] if lpsi[t]
ih2[lpd3[t], 0] <- lb2[lpf[t]] - 1 for (t,zc) in ch if lps1[t] if lpsi[t]
#     輪（18）: 行の番号・値・鍵・要素・組の頭の規則の続きの行
iti[lpd[t], 2] <- 18               for (t,zc) in ch if lps1[t]
iti[lpd[t], 4] <- 18               for (t,zc) in ch if lps1[t]
iti[lpd[t], 6] <- 18               for (t,zc) in ch if lps1[t]
iti[lpd1[t], 1] <- 18              for (t,zc) in ch if lps1[t]
iti[lpd1[t], 3] <- 18              for (t,zc) in ch if lps1[t]
ih1[lpd[t], 2] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lps1[t]
ih2[lpd[t], 2] <- lb2[lpf[t]] - 1  for (t,zc) in ch if lps1[t]
ih1[lpd[t], 4] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lps1[t]
ih2[lpd[t], 4] <- lb2[lpf[t]] - 1  for (t,zc) in ch if lps1[t]
ih1[lpd[t], 6] <- lb1[lpf[t]] - 1  for (t,zc) in ch if lps1[t]
ih2[lpd[t], 6] <- lb2[lpf[t]] - 1  for (t,zc) in ch if lps1[t]
ih1[lpd1[t], 1] <- lb1[lpf[t]] - 1 for (t,zc) in ch if lps1[t]
ih2[lpd1[t], 1] <- lb2[lpf[t]] - 1 for (t,zc) in ch if lps1[t]
ih1[lpd1[t], 3] <- lb1[lpf[t]] - 1 for (t,zc) in ch if lps1[t]
ih2[lpd1[t], 3] <- lb2[lpf[t]] - 1 for (t,zc) in ch if lps1[t]

# 型紙 69: 長い名前 → `_f<宣言の番号>`（`@` が lnw を書く）
iti[lin[t], 0] <- 69               for (t,zc) in ch if lnt[t] >= 1
ind[lin[t], 0] <- lnt[t]           for (t,zc) in ch if lnt[t] >= 1
irw[lin[t], 0] <- lrw[lte[t]]      for (t,zc) in ch if lnt[t] >= 1
ibd[lin[t], 0] <- true             for (t,zc) in ch if lnt[t] >= 1

# ANF（30〜47）: 区間の最初のトークン ta の実例に e = 1..7 で並べる（e = 0 はトークン自身の差し替え）
#   1 塊の頭 A / 2 塊の頭 B / 3・4 ループの節 / 5 宣言 / 6・7 本文の参照 A・B
field las : max bound 262144                # 区間 ta の文
las[t] <- snum[t]                  for (t,zc) in ch if lsa[t]
# 塊の場の次元 = 区間が使うループ（一つか二つ。一つも使わなければ文のループ 0 —— 一点の文なら `_z`）
field lrany : or bound 262144               # 区間はどれかのループを使う
lrany[t] <- true                   for (t,zc) in ch for (l) in 0 .. 7 if lru[t, l]
field lky0 : max bound 262144               # 塊の次元0 のループ
lky0[t] <- lrn0[t]                 for (t,zc) in ch if lsa[t] if lrany[t]
lky0[t] <- 0                       for (t,zc) in ch if lsa[t] if not lrany[t]
field lky1 : max bound 262144               # 塊の次元1 のループ（無ければ ⊥）
lky1[t] <- lrn1[t]                 for (t,zc) in ch if lsa[t] if lrany[t] if lrn1[t] > lrn0[t]
field lkyn : max bound 262144               # 塊の次元の数
lkyn[t] <- 1                       for (t,zc) in ch if lsa[t]
lkyn[t] <- 2                       for (t,zc) in ch if lsa[t] if lky1[t] >= 0
field lak0 : max bound 262144               # 塊の次元0 のループの書き方
lak0[t] <- lkk[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field lak1 : max bound 262144               # 次元1 のループの書き方（無ければ ⊥）
lak1[t] <- lkk[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lav0 : max bound 262144
lav0[t] <- lkv[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field lav1 : max bound 262144
lav1[t] <- lkv[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lal0 : max bound 262144
lal0[t] <- lkl[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field lal1 : max bound 262144
lal1[t] <- lkl[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lah0 : max bound 262144
lah0[t] <- lkh[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field lah1 : max bound 262144
lah1[t] <- lkh[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field laf0 : max bound 262144
laf0[t] <- lkf[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field laf1 : max bound 262144
laf1[t] <- lkf[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lab0 : max bound 262144
lab0[t] <- lkb[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field lab1 : max bound 262144
lab1[t] <- lkb[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lae : max bound 262144                # 塊の字の後ろの行（ループの節の一行目）
lae[t] <- lhbk[t] + lcl[t] + 2      for (t,zc) in ch if lsa[t]
field lap : max bound 262144                # 本文の参照の行（区間の最初の字 —— 字は塊へ移った）
lap[t] <- lcs[t]                   for (t,zc) in ch if lsa[t]
# 1: 塊の頭 A
iti[lin[t], 1] <- 30               for (t,zc) in ch if lak0[t] == 1
iti[lin[t], 1] <- 31               for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3
iti[lin[t], 1] <- 32               for (t,zc) in ch if lak0[t] == 4
ih0[lin[t], 1] <- t                for (t,zc) in ch if lsa[t]
ih1[lin[t], 1] <- lal0[t]          for (t,zc) in ch if lak0[t] == 1
inm[lin[t], 1] <- lav0[t]          for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3
irw[lin[t], 1] <- lhbk[t]           for (t,zc) in ch if lsa[t]
ibd[lin[t], 1] <- true             for (t,zc) in ch if lsa[t]
# 2: 塊の頭 B
iti[lin[t], 2] <- 33               for (t,zc) in ch if lsa[t] if lkyn[t] == 1
iti[lin[t], 2] <- 34               for (t,zc) in ch if lak1[t] == 1
iti[lin[t], 2] <- 35               for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3
ih1[lin[t], 2] <- lal1[t]          for (t,zc) in ch if lak1[t] == 1
inm[lin[t], 2] <- lav1[t]          for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3
irw[lin[t], 2] <- lhbk[t] + 1       for (t,zc) in ch if lsa[t]
ibd[lin[t], 2] <- true             for (t,zc) in ch if lsa[t]
# 3・4: ループの節
iti[lin[t], 3] <- 36               for (t,zc) in ch if lak0[t] == 1
iti[lin[t], 3] <- 37               for (t,zc) in ch if lak0[t] == 2
iti[lin[t], 3] <- 38               for (t,zc) in ch if lak0[t] == 3
iti[lin[t], 3] <- 39               for (t,zc) in ch if lak0[t] == 4
ih0[lin[t], 3] <- lal0[t]          for (t,zc) in ch if lak0[t] >= 1 if lak0[t] <= 3
ih1[lin[t], 3] <- lah0[t]          for (t,zc) in ch if lak0[t] >= 1 if lak0[t] <= 3
inm[lin[t], 3] <- lav0[t]          for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3
ind[lin[t], 3] <- laf0[t]          for (t,zc) in ch if lak0[t] == 3
irw[lin[t], 3] <- lae[t]           for (t,zc) in ch if lsa[t]
ibd[lin[t], 3] <- true             for (t,zc) in ch if lsa[t]
iti[lin[t], 4] <- 36               for (t,zc) in ch if lak1[t] == 1
iti[lin[t], 4] <- 37               for (t,zc) in ch if lak1[t] == 2
iti[lin[t], 4] <- 38               for (t,zc) in ch if lak1[t] == 3
ih0[lin[t], 4] <- lal1[t]          for (t,zc) in ch if lak1[t] >= 1
ih1[lin[t], 4] <- lah1[t]          for (t,zc) in ch if lak1[t] >= 1
inm[lin[t], 4] <- lav1[t]          for (t,zc) in ch if lak1[t] >= 2
ind[lin[t], 4] <- laf1[t]          for (t,zc) in ch if lak1[t] == 3
irw[lin[t], 4] <- lae[t] + 1       for (t,zc) in ch if lak1[t] >= 1
ibd[lin[t], 4] <- true             for (t,zc) in ch if lak1[t] >= 1
# 5: 宣言
iti[lin[t], 5] <- 40               for (t,zc) in ch if lsa[t] if lkyn[t] == 1
iti[lin[t], 5] <- 41               for (t,zc) in ch if lsa[t] if lkyn[t] == 2
ih0[lin[t], 5] <- t                for (t,zc) in ch if lsa[t]
ih1[lin[t], 5] <- lab0[t]          for (t,zc) in ch if lsa[t]
ih2[lin[t], 5] <- lab1[t]          for (t,zc) in ch if lsa[t] if lkyn[t] == 2
irw[lin[t], 5] <- lae[t] + 2       for (t,zc) in ch if lsa[t]
ibd[lin[t], 5] <- true             for (t,zc) in ch if lsa[t]
# 6・7: 本文の参照（区間の最初の字の行と、その次の行 —— どちらも字が塊へ移って空いている）
iti[lin[t], 6] <- 42               for (t,zc) in ch if lak0[t] == 1
iti[lin[t], 6] <- 43               for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3
iti[lin[t], 6] <- 44               for (t,zc) in ch if lak0[t] == 4
ih0[lin[t], 6] <- t                for (t,zc) in ch if lsa[t]
ih1[lin[t], 6] <- lal0[t]          for (t,zc) in ch if lak0[t] == 1
inm[lin[t], 6] <- lav0[t]          for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3
irw[lin[t], 6] <- lap[t]           for (t,zc) in ch if lsa[t]
ibd[lin[t], 6] <- true             for (t,zc) in ch if lsa[t]
iti[lin[t], 7] <- 45               for (t,zc) in ch if lsa[t] if lkyn[t] == 1
iti[lin[t], 7] <- 46               for (t,zc) in ch if lak1[t] == 1
iti[lin[t], 7] <- 47               for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3
ih1[lin[t], 7] <- lal1[t]          for (t,zc) in ch if lak1[t] == 1
inm[lin[t], 7] <- lav1[t]          for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3
irw[lin[t], 7] <- lap[t] + 1       for (t,zc) in ch if lsa[t]
ibd[lin[t], 7] <- true             for (t,zc) in ch if lsa[t]

# ── 実例を詰める（字の順 → 番号の鎖）─────────────────────────────────────
field ipm : max bound 262272                # 実例 n の使う枠の数（最大の e + 1）
ipm[n] <- e + 1                    for (n) in 0 .. nnz[0] for (e) in 0 .. 7 if iti[n, e] >= 0
field ibs : max bound 262272                # 実例 n の最初の詰めた番号
ibs[0] <- 0
ibs[n] <- ibs[n-1] + ipm[n-1]      for (n) in 1 .. nnz[0] if ipm[n-1] >= 1
ibs[n] <- ibs[n-1]                 for (n) in 1 .. nnz[0] if not ipm[n-1]
field icid : max bound 262272 8             # 実例 [n, e] の詰めた番号
icid[n, e] <- ibs[n] + e           for (n) in 0 .. nnz[0] for (e) in 0 .. 7 if iti[n, e] >= 0
field ncz : max bound 1                     # 最後の詰めた番号
ncz[z] <- icid[n, e]               for (n) in 0 .. nnz[0] for (e) in 0 .. 7 for (z) in 0 .. 0
      if iti[n, e] >= 0
field cti : max bound 262144                # 詰めた実例 c の型紙
cti[icid[n, e]] <- iti[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field crow : max bound 262144               # 詰めた実例 c の行（本文の字、無ければ末尾の 262144 + c）
crow[icid[n, e]] <- irw[n, e]      for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field ctl : or bound 262144                 # 詰めた実例 c は末尾に置く
ctl[icid[n, e]] <- true            for (n) in 0 .. nnz[0] for (e) in 0 .. 7
      if iti[n, e] >= 0 if not ibd[n, e]
crow[c] <- c + 262144              for (c) in 0 .. ncz[0] if ctl[c]
field ch0 : max bound 262144
ch0[icid[n, e]] <- ih0[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field ch1 : max bound 262144
ch1[icid[n, e]] <- ih1[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field ch2 : max bound 262144
ch2[icid[n, e]] <- ih2[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field ch3 : max bound 262144
ch3[icid[n, e]] <- ih3[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field cnd : max bound 262144
cnd[icid[n, e]] <- ind[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field cnm : max bound 262144
cnm[icid[n, e]] <- inm[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7

# ── 出す ───────────────────────────────────────────────────────────────
field lx : max bound 524288 64              # 行 r の升 s（⊥ は幅 0）
lx[lrw[i], 0] <- c                 for (i,c) in ch if not ldl[i]
lx[crow[c], j + 1] <- tpc[cti[c], j]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tpc[cti[c], j] >= 0
# <<digits>>
# ── 穴の桁と名前の升（work/mklower.py が起こす。手で直さない）──
lx[crow[c], j + 1] <- 48 + ch0[c] % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 0
lx[crow[c], j + 1] <- 48 + ch0[c] / 10 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 1 if ch0[c] >= 10
lx[crow[c], j + 1] <- 48 + ch0[c] / 100 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 2 if ch0[c] >= 100
