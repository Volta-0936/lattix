      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 0
lx[crow[c], j + 1] <- 48 + ch1[c] / 10 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 1 if ch1[c] >= 10
lx[crow[c], j + 1] <- 48 + ch1[c] / 100 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 2 if ch1[c] >= 100
lx[crow[c], j + 1] <- 48 + ch1[c] / 1000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 3 if ch1[c] >= 1000
lx[crow[c], j + 1] <- 48 + ch1[c] / 10000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
