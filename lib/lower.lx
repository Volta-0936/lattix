lx[crow[c], j + 1] <- 48 + ch2[c] / 1000000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 9 if ch2[c] >= 1000000000
lx[crow[c], j + 1] <- 48 + ch3[c] % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
