field gar2 : flat bound 131072                   # 足したまま（幅を見る前）
gv2[n] <- tpv[n, 2]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tlead[n, 2]
gs2[n] <- 1   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tlead[n, 2] if not tneg[n, 2]
gs2[n] <- 0 - 1   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tlead[n, 2] if tneg[n, 2]
gar2[n] <- ga1[n] + gs1[n] * gv1[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tlead[n, 2]
ga2[n] <- gar2[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tlead[n, 2] if gar2[n] >= npw[62] if gar2[n] < pw[62]
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tlead[n, 2] if gar2[n] < npw[62]
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tlead[n, 2] if gar2[n] >= pw[62]
gs2[n] <- gs1[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tmg[n, 2]
ga2[n] <- ga1[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tmg[n, 2]
field lbs2 : max bound 131072
lbs2[n] <- lbg1[n] + lbt[n, 2]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tmul[n, 2]
gv2[n] <- gv1[n] / 4 * tpv[n, 2]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tmul[n, 2] if lbs2[n] <= 64
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tmul[n, 2] if lbs2[n] >= 65
field dv20 : flat bound 131072
dv20[n] <- gv1[n] / 8 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb0[n, 2] == 1
dv20[n] <- gv1[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb0[n, 2] == 0
field dv21 : flat bound 131072
dv21[n] <- dv20[n] / 16 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb1[n, 2] == 1
dv21[n] <- dv20[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb1[n, 2] == 0
field dv22 : flat bound 131072
dv22[n] <- dv21[n] / 64 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb2[n, 2] == 1
dv22[n] <- dv21[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb2[n, 2] == 0
field dv23 : flat bound 131072
dv23[n] <- dv22[n] / 1024 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb3[n, 2] == 1
dv23[n] <- dv22[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb3[n, 2] == 0
field dv24 : flat bound 131072
dv24[n] <- dv23[n] / 262144 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb4[n, 2] == 1
dv24[n] <- dv23[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb4[n, 2] == 0
field dv25 : flat bound 131072
dv25[n] <- dv24[n] / 17179869184 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb5[n, 2] == 1
dv25[n] <- dv24[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] >= 7 if ntk[n, 2] <= 8 if tb5[n, 2] == 0
gv2[n] <- dv25[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] == 7
gv2[n] <- gv1[n] - dv25[n] * tpw[n, 2]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] == 8 if tb[n, 2] <= 60
gv2[n] <- gv1[n] - dv25[n] * tpw[n, 2]   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] == 8 if tb[n, 2] >= 61
      if gv1[n] >= 0
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if ntk[n, 2] == 8 if tb[n, 2] >= 61 if gv1[n] < 0
field lbg2 : max bound 131072
lbg2[n] <- 0   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tmul[n, 3] if gv2[n] == 0
lbg2[n] <- k + 1   for (n) in 0 .. ninz[0] for (k) in 0 .. 62 if ntc[n] >= 4 if tmul[n, 3] if gv2[n] >= pw[k]
lbg2[n] <- k + 1   for (n) in 0 .. ninz[0] for (k) in 0 .. 62 if ntc[n] >= 4 if tmul[n, 3] if gv2[n] <= npw[k]
# ── 項 3
field gv3 : flat bound 131072                    # 群の値の四倍（項 3 までの積）
field gs3 : max bound 131072                     # 群の符号（1 / -1）
field ga3 : flat bound 131072                    # 項 3 の群より前の群の和
field gar3 : flat bound 131072                   # 足したまま（幅を見る前）
gv3[n] <- tpv[n, 3]   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tlead[n, 3]
gs3[n] <- 1   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tlead[n, 3] if not tneg[n, 3]
gs3[n] <- 0 - 1   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tlead[n, 3] if tneg[n, 3]
gar3[n] <- ga2[n] + gs2[n] * gv2[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tlead[n, 3]
ga3[n] <- gar3[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tlead[n, 3] if gar3[n] >= npw[62] if gar3[n] < pw[62]
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tlead[n, 3] if gar3[n] < npw[62]
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tlead[n, 3] if gar3[n] >= pw[62]
gs3[n] <- gs2[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tmg[n, 3]
ga3[n] <- ga2[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tmg[n, 3]
field lbs3 : max bound 131072
lbs3[n] <- lbg2[n] + lbt[n, 3]   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tmul[n, 3]
gv3[n] <- gv2[n] / 4 * tpv[n, 3]   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tmul[n, 3] if lbs3[n] <= 64
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if tmul[n, 3] if lbs3[n] >= 65
field dv30 : flat bound 131072
dv30[n] <- gv2[n] / 8 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if ntk[n, 3] >= 7 if ntk[n, 3] <= 8 if tb0[n, 3] == 1
dv30[n] <- gv2[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if ntk[n, 3] >= 7 if ntk[n, 3] <= 8 if tb0[n, 3] == 0
field dv31 : flat bound 131072
dv31[n] <- dv30[n] / 16 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if ntk[n, 3] >= 7 if ntk[n, 3] <= 8 if tb1[n, 3] == 1
dv31[n] <- dv30[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 4 if ntk[n, 3] >= 7 if ntk[n, 3] <= 8 if tb1[n, 3] == 0
