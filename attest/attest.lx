oun[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 0 if q0un[n, j]
oot[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 0 if q0ot[n, j]
ocl[n, j] <- q0cl[n, j]   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 0
ovl[n, j] <- q0vl[n, j]   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 0
opr[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 1 if q1pr[n, j]
otp[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 1 if q1tp2[n, j]
ocp[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 1 if q1tp[n, j]
oun[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 1 if q1un[n, j]
oot[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 1 if q1ot[n, j]
ocl[n, j] <- q1cl[n, j]   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 1
ovl[n, j] <- q1vl[n, j]   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 1
opr[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 2 if q2pr[n, j]
otp[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 2 if q2tp2[n, j]
ocp[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 2 if q2tp[n, j]
oun[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 2 if q2un[n, j]
oot[n, j] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 2 if q2ot[n, j]
ocl[n, j] <- q2cl[n, j]   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 2
ovl[n, j] <- q2vl[n, j]   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] == 2
# **持たないもの** —— 鎖の四段目より深い出現、座標に ⊤ を読んだ出現。検査したとは言わない
field nuns : or bound 131072                      # 実例 n は attest が持たない形を含む
nuns[n] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if olv[noo[n, j]] >= 3
nuns[n] <- true   for (n) in 0 .. ninz[0] for (j) in 0 .. 15 if j < nrc[n] if ohas[noo[n, j]] if ocp[n, j]
field rbig : or bound 2048                      # 所有者が 16 を超える規則（検査しない）
rbig[r] <- true   for (r) in 0 .. nrlz[0] if rocn[r] >= 17

# ══ ガード ═══════════════════════════════════════════════════════════════
# 規則のガードの行は隣り合う（節に沿った鎖）。規則 r の最初の行と数
field rgf : min bound 2048
rgf[gr[g]] <- g   for (g) in 0 .. nggz[0]
field rgl : max bound 2048
rgl[gr[g]] <- g   for (g) in 0 .. nggz[0]
field rgc : max bound 2048
rgc[r] <- 0   for (r) in 0 .. nrlz[0]
rgc[r] <- rgl[r] - rgf[r] + 1   for (r) in 0 .. nrlz[0] if rgl[r] >= 0
field ngc2 : max bound 131072                     # 実例 n のガードの行の数
ngc2[n] <- rgc[nr[n]]   for (n) in 0 .. ninz[0]
field ngf : max bound 131072
ngf[n] <- rgf[nr[n]]   for (n) in 0 .. ninz[0] if ngc2[n] >= 1
field ngg2 : max bound 131072 16                  # 実例 n の k 番目のガードの行
ngg2[n, k] <- ngf[n] + k   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n]
field ngj : max bound 131072 16                   # その行の読みの出現（規則の中の番号）
ngj[n, k] <- goo[ngg2[n, k]] - nro[n]   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n]
      if gk[ngg2[n, k]] == 9
ngj[n, k] <- goo[ngg2[n, k]] - nro[n]   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n]
      if gk[ngg2[n, k]] == 2
ngj[n, k] <- goo[ngg2[n, k]] - nro[n]   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n]
      if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 0
field gfl : or bound 131072                       # 実例 n のガードのどれかが立たない
field gbig : or bound 2048                      # ガードの行が 16 を超える規則（検査しない）
gbig[r] <- true   for (r) in 0 .. nrlz[0] if rgc[r] >= 17

gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 9 if oun[n, ngj[n, k]]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 9 if oot[n, ngj[n, k]]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 9 if not oun[n, ngj[n, k]] if not oot[n, ngj[n, k]]
      if not opr[n, ngj[n, k]]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 9 if opr[n, ngj[n, k]] if not otp[n, ngj[n, k]]
      if ovl[n, ngj[n, k]] == 0
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 2 if oun[n, ngj[n, k]]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 2 if opr[n, ngj[n, k]] if otp[n, ngj[n, k]]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 2 if opr[n, ngj[n, k]] if not otp[n, ngj[n, k]]
      if ovl[n, ngj[n, k]] != 0
field gsv : flat bound 131072 16                  # 比較の辺の値の四倍
field gsm : or bound 131072 16                    # 比較の辺が無い（読みが ⊥・座標が無い・広さの外）
field gsq : max bound 131072 16                   # 辺が語の表の列なら、その語
gsv[n, k] <- gov[ngg2[n, k]] * 4   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 3
gsv[n, k] <- nk0[n] * 4   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 2 if gc1[ngg2[n, k]] == 0
gsv[n, k] <- nk1[n] * 4   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 2 if gc1[ngg2[n, k]] == 1
gsv[n, k] <- nk2[n] * 4   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 2 if gc1[ngg2[n, k]] == 2
gsv[n, k] <- na0[n] * 4   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 1 if inpw[0] == 1 if gc1[ngg2[n, k]] == 0
gsv[n, k] <- urb[na0[n]] * 4   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 1 if inpw[0] == 1 if gc1[ngg2[n, k]] == 1
gsq[n, k] <- nq0[n] + gc1[ngg2[n, k]]   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 1 if inpw[0] == 8
gsv[n, k] <- uwv[gsq[n, k]]   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 1 if inpw[0] == 8
gsv[n, k] <- ovl[n, ngj[n, k]]   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 0 if opr[n, ngj[n, k]] if not otp[n, ngj[n, k]]
gsm[n, k] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 0 if not opr[n, ngj[n, k]]
gsm[n, k] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 0 if oun[n, ngj[n, k]]
gsm[n, k] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 0 if oot[n, ngj[n, k]]
nuns[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] >= 3 if gk[ngg2[n, k]] <= 4 if gok[ngg2[n, k]] == 0 if otp[n, ngj[n, k]]     # ⊤ を比べる
field gop : max bound 131072 16                  # 比較の演算子（左の行に置く）
gop[n, k] <- ggv[ngg2[n, k] + 1]   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 3
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 3 if gsm[n, k]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 3 if gsm[n, k+1]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 3 if gop[n, k] == 1 if gsv[n, k] != gsv[n, k+1]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 3 if gop[n, k] == 2 if gsv[n, k] == gsv[n, k+1]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 3 if gop[n, k] == 3 if gsv[n, k] < gsv[n, k+1]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 3 if gop[n, k] == 4 if gsv[n, k] > gsv[n, k+1]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 3 if gop[n, k] == 5 if gsv[n, k] <= gsv[n, k+1]
gfl[n] <- true   for (n) in 0 .. ninz[0] for (k) in 0 .. 15 if k < ngc2[n] if gk[ngg2[n, k]] == 3 if gop[n, k] == 6 if gsv[n, k] >= gsv[n, k+1]

# ══ 項（群の和）═══════════════════════════════════════════════════════════
field rtf : min bound 2048
rtf[tr[g]] <- g   for (g) in 0 .. ngtz[0]
field rtl : max bound 2048
rtl[tr[g]] <- g   for (g) in 0 .. ngtz[0]
field rtc : max bound 2048
rtc[r] <- 0   for (r) in 0 .. nrlz[0]
rtc[r] <- rtl[r] - rtf[r] + 1   for (r) in 0 .. nrlz[0] if rtl[r] >= 0
field ntc : max bound 131072                      # 実例 n の項の数
ntc[n] <- rtc[nr[n]]   for (n) in 0 .. ninz[0]
field ntf : max bound 131072
ntf[n] <- rtf[nr[n]]   for (n) in 0 .. ninz[0] if ntc[n] >= 1
field ntt : max bound 131072 8                    # 実例 n の t 番目の項の行
ntt[n, t] <- ntf[n] + t   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n]
field ntk : max bound 131072 8                    # その種
ntk[n, t] <- tk[ntt[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n]
field ntj : max bound 131072 8                    # 読みの項の出現（規則の中の番号）
field tpv : flat bound 131072 8                   # 項の値の四倍
field tab : or bound 131072                       # 実例 n の読みの項のどれかが無い
field ttp : or bound 131072                       # 実例 n の読みの項のどれかが ⊤
field tqw : max bound 131072 8                    # 列の項が語の表なら、その語
# 二のべき（割る・余りの寄せ量）
field pw : max bound 64
pw[0] <- 1
pw[k] <- pw[k-1] * 2   for (k) in 1 .. 62
field tsh : max bound 8192                      # 割る・余りの項の寄せ量
tsh[g] <- k   for (g) in 0 .. ngtz[0] for (k) in 0 .. 62 if tk[g] >= 7 if tk[g] <= 8 if pw[k] == tvl[g]

tpv[n, t] <- tvl[ntt[n, t]] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 1
tpv[n, t] <- tvl[ntt[n, t]] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 5
tpv[n, t] <- tvl[ntt[n, t]] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 6
tpv[n, t] <- nk0[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 4 if tc1[ntt[n, t]] == 0
tpv[n, t] <- nk1[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 4 if tc1[ntt[n, t]] == 1
tpv[n, t] <- nk2[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 4 if tc1[ntt[n, t]] == 2
tpv[n, t] <- nk0[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 13 if tc1[ntt[n, t]] == 0
tpv[n, t] <- nk1[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 13 if tc1[ntt[n, t]] == 1
tpv[n, t] <- nk2[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 13 if tc1[ntt[n, t]] == 2
tpv[n, t] <- nk0[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 14 if tc1[ntt[n, t]] == 0
tpv[n, t] <- nk1[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 14 if tc1[ntt[n, t]] == 1
tpv[n, t] <- nk2[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 14 if tc1[ntt[n, t]] == 2
tpv[n, t] <- na0[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 2 if inpw[0] == 1 if tc1[ntt[n, t]] == 0
tpv[n, t] <- urb[na0[n]] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 2 if inpw[0] == 1 if tc1[ntt[n, t]] == 1
tqw[n, t] <- nq0[n] + tc1[ntt[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 2 if inpw[0] == 8
tpv[n, t] <- uwv[tqw[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 2 if inpw[0] == 8
tpv[n, t] <- na0[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 11 if inpw[0] == 1 if tc1[ntt[n, t]] == 0
tpv[n, t] <- urb[na0[n]] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 11 if inpw[0] == 1 if tc1[ntt[n, t]] == 1
tqw[n, t] <- nq0[n] + tc1[ntt[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 11 if inpw[0] == 8
tpv[n, t] <- uwv[tqw[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 11 if inpw[0] == 8
tpv[n, t] <- na0[n] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 12 if inpw[0] == 1 if tc1[ntt[n, t]] == 0
tpv[n, t] <- urb[na0[n]] * 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 12 if inpw[0] == 1 if tc1[ntt[n, t]] == 1
tqw[n, t] <- nq0[n] + tc1[ntt[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 12 if inpw[0] == 8
tpv[n, t] <- uwv[tqw[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if not gfl[n] if ntk[n, t] == 12 if inpw[0] == 8
ntj[n, t] <- too[ntt[n, t]] - nro[n]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 3
ntj[n, t] <- too[ntt[n, t]] - nro[n]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 9
ntj[n, t] <- too[ntt[n, t]] - nro[n]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 10
tpv[n, t] <- 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 3 if not gfl[n] if opr[n, ntj[n, t]] if nol[n, ntj[n, t]] == 3
tpv[n, t] <- ovl[n, ntj[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 3 if not gfl[n] if opr[n, ntj[n, t]] if not otp[n, ntj[n, t]]
      if nol[n, ntj[n, t]] != 3
tab[n] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 3 if not opr[n, ntj[n, t]]
tab[n] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 3 if oun[n, ntj[n, t]]
tab[n] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 3 if oot[n, ntj[n, t]]
ttp[n] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 3 if otp[n, ntj[n, t]]
tpv[n, t] <- 4   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 9 if ntk[n, t] <= 10 if not gfl[n] if opr[n, ntj[n, t]] if nol[n, ntj[n, t]] == 3
tpv[n, t] <- ovl[n, ntj[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 9 if ntk[n, t] <= 10 if not gfl[n] if opr[n, ntj[n, t]] if not otp[n, ntj[n, t]]
      if nol[n, ntj[n, t]] != 3
tab[n] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 9 if ntk[n, t] <= 10 if not opr[n, ntj[n, t]]
tab[n] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 9 if ntk[n, t] <= 10 if oun[n, ntj[n, t]]
tab[n] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 9 if ntk[n, t] <= 10 if oot[n, ntj[n, t]]
ttp[n] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 9 if ntk[n, t] <= 10 if otp[n, ntj[n, t]]
field tlead : or bound 131072 8                  # 群の先頭（掛ける・割る・余りでない）
tlead[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] <= 5
tlead[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 9
tlead[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 11
tlead[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 13
field tneg : or bound 131072 8                    # 引く項（群の符号）
tneg[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 5
tneg[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 9
tneg[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 11
tneg[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 13
field tmg : or bound 131072 8                     # 掛ける・割る・余りの項（群は前を引き継ぐ）
tmg[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if t >= 1 if not tlead[n, t]
field tmul : or bound 131072 8                    # 掛ける項
tmul[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 6
tmul[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 10
tmul[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 12
tmul[n, t] <- true   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] == 14
field tb : max bound 131072 8                     # 割る・余りの寄せ量
tb[n, t] <- tsh[ntt[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 7 if ntk[n, t] <= 8
field tpw : max bound 131072 8                    # 2^寄せ量
tpw[n, t] <- pw[tb[n, t]]   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 7 if ntk[n, t] <= 8
field tb0 : max bound 131072 8                    # 寄せ量の六つの桁
tb0[n, t] <- tb[n, t] % 2   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 7 if ntk[n, t] <= 8
field tb1 : max bound 131072 8
tb1[n, t] <- tb[n, t] / 2 % 2   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 7 if ntk[n, t] <= 8
field tb2 : max bound 131072 8
tb2[n, t] <- tb[n, t] / 4 % 2   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 7 if ntk[n, t] <= 8
field tb3 : max bound 131072 8
tb3[n, t] <- tb[n, t] / 8 % 2   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 7 if ntk[n, t] <= 8
field tb4 : max bound 131072 8
tb4[n, t] <- tb[n, t] / 16 % 2   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 7 if ntk[n, t] <= 8
field tb5 : max bound 131072 8
tb5[n, t] <- tb[n, t] / 32 % 2   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if ntk[n, t] >= 7 if ntk[n, t] <= 8
field npw : min bound 64                        # -2^k
npw[k] <- 0 - pw[k]   for (k) in 0 .. 62
field vbig : or bound 131072                      # 実例 n の値が attest の幅の外
# 掛ける項の値のビットの長さ（|値| < 2^長さ）
field lbt : max bound 131072 8
lbt[n, t] <- 0   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 if t < ntc[n] if tmul[n, t] if tpv[n, t] == 0
lbt[n, t] <- k + 1   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 for (k) in 0 .. 62 if t < ntc[n] if tmul[n, t]
      if tpv[n, t] >= pw[k]
lbt[n, t] <- k + 1   for (n) in 0 .. ninz[0] for (t) in 0 .. 7 for (k) in 0 .. 62 if t < ntc[n] if tmul[n, t]
      if tpv[n, t] <= npw[k]

# ── 項 0
field gv0 : flat bound 131072                    # 群の値の四倍（項 0 までの積）
field gs0 : max bound 131072                     # 群の符号（1 / -1）
field ga0 : flat bound 131072                    # 項 0 の群より前の群の和
gv0[n] <- tpv[n, 0]   for (n) in 0 .. ninz[0] if ntc[n] >= 1 if not tneg[n, 0]
gv0[n] <- 0 - tpv[n, 0]   for (n) in 0 .. ninz[0] if ntc[n] >= 1 if tneg[n, 0]
gs0[n] <- 1   for (n) in 0 .. ninz[0] if ntc[n] >= 1
ga0[n] <- 0   for (n) in 0 .. ninz[0] if ntc[n] >= 1
field lbg0 : max bound 131072
lbg0[n] <- 0   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tmul[n, 1] if gv0[n] == 0
lbg0[n] <- k + 1   for (n) in 0 .. ninz[0] for (k) in 0 .. 62 if ntc[n] >= 2 if tmul[n, 1] if gv0[n] >= pw[k]
lbg0[n] <- k + 1   for (n) in 0 .. ninz[0] for (k) in 0 .. 62 if ntc[n] >= 2 if tmul[n, 1] if gv0[n] <= npw[k]
# ── 項 1
field gv1 : flat bound 131072                    # 群の値の四倍（項 1 までの積）
field gs1 : max bound 131072                     # 群の符号（1 / -1）
field ga1 : flat bound 131072                    # 項 1 の群より前の群の和
field gar1 : flat bound 131072                   # 足したまま（幅を見る前）
gv1[n] <- tpv[n, 1]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tlead[n, 1]
gs1[n] <- 1   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tlead[n, 1] if not tneg[n, 1]
gs1[n] <- 0 - 1   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tlead[n, 1] if tneg[n, 1]
gar1[n] <- ga0[n] + gs0[n] * gv0[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tlead[n, 1]
ga1[n] <- gar1[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tlead[n, 1] if gar1[n] >= npw[62] if gar1[n] < pw[62]
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tlead[n, 1] if gar1[n] < npw[62]
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tlead[n, 1] if gar1[n] >= pw[62]
gs1[n] <- gs0[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tmg[n, 1]
ga1[n] <- ga0[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tmg[n, 1]
field lbs1 : max bound 131072
lbs1[n] <- lbg0[n] + lbt[n, 1]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tmul[n, 1]
gv1[n] <- gv0[n] / 4 * tpv[n, 1]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tmul[n, 1] if lbs1[n] <= 64
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if tmul[n, 1] if lbs1[n] >= 65
field dv10 : flat bound 131072
dv10[n] <- gv0[n] / 8 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb0[n, 1] == 1
dv10[n] <- gv0[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb0[n, 1] == 0
field dv11 : flat bound 131072
dv11[n] <- dv10[n] / 16 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb1[n, 1] == 1
dv11[n] <- dv10[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb1[n, 1] == 0
field dv12 : flat bound 131072
dv12[n] <- dv11[n] / 64 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb2[n, 1] == 1
dv12[n] <- dv11[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb2[n, 1] == 0
field dv13 : flat bound 131072
dv13[n] <- dv12[n] / 1024 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb3[n, 1] == 1
dv13[n] <- dv12[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb3[n, 1] == 0
field dv14 : flat bound 131072
dv14[n] <- dv13[n] / 262144 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb4[n, 1] == 1
dv14[n] <- dv13[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb4[n, 1] == 0
field dv15 : flat bound 131072
dv15[n] <- dv14[n] / 17179869184 * 4   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb5[n, 1] == 1
dv15[n] <- dv14[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] >= 7 if ntk[n, 1] <= 8 if tb5[n, 1] == 0
gv1[n] <- dv15[n]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] == 7
gv1[n] <- gv0[n] - dv15[n] * tpw[n, 1]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] == 8 if tb[n, 1] <= 60
gv1[n] <- gv0[n] - dv15[n] * tpw[n, 1]   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] == 8 if tb[n, 1] >= 61
      if gv0[n] >= 0
vbig[n] <- true   for (n) in 0 .. ninz[0] if ntc[n] >= 2 if ntk[n, 1] == 8 if tb[n, 1] >= 61 if gv0[n] < 0
field lbg1 : max bound 131072
lbg1[n] <- 0   for (n) in 0 .. ninz[0] if ntc[n] >= 3 if tmul[n, 2] if gv1[n] == 0
lbg1[n] <- k + 1   for (n) in 0 .. ninz[0] for (k) in 0 .. 62 if ntc[n] >= 3 if tmul[n, 2] if gv1[n] >= pw[k]
lbg1[n] <- k + 1   for (n) in 0 .. ninz[0] for (k) in 0 .. 62 if ntc[n] >= 3 if tmul[n, 2] if gv1[n] <= npw[k]
# ── 項 2
field gv2 : flat bound 131072                    # 群の値の四倍（項 2 までの積）
field gs2 : max bound 131072                     # 群の符号（1 / -1）
