# ── print を _o に下ろす機械（下ろした本の末尾に一度だけ置く）──
# 行 r は印字する升の線形の番号。桁は決まった席に置き、⊥ の席は render が飛ばす（幅 0）。
# 席: 名 0..15 / `[` 16 / 座標0 17..40 / `, ` 41,42 / 座標1 43..66 / `] = ` 67..70 /
#     値 71..94 / 改行 95。原子（綴りの順の番号）は `_an[番号, k]` で綴りに戻す（24 バイトまで）
field _o : max bound 65536 96
field _pv : max bound 65536
field _pk1 : max bound 65536
field _pk2 : max bound 65536
field _pp : max bound 65536
field _pab : max bound 65536
field _pq : max bound 65536
field _pbs : max bound 64
field _pen : max bound 64
field _pd2 : or bound 64
field _pd0 : or bound 64
field _pa1 : or bound 64                     # 座標0 は原子
field _pa2 : or bound 64                     # 座標1 は原子
field _pav : or bound 64                     # 値は原子
field _an : max bound 1024 24                # 原子の番号 → 綴り
field _por : or bound 64
field _pn : or bound 64
field _pnm : max bound 64 16
field _Rz : max bound 1
field _Pz : max bound 1
field _bt : max bound 64
_pp[r] <- p   for (r) in 0 .. _Rz[0] for (p) in 0 .. _Pz[0] if r > _pbs[p] if r <= _pen[p] if _pv[r] == _pv[r]
_pn[_pp[r]] <- true   for (r) in 0 .. _Rz[0]
_pk1[r] <- r - _pbs[_pp[r]] - 1   for (r) in 0 .. _Rz[0] if not _pd2[_pp[r]] if not _pd0[_pp[r]]
_o[r, j] <- _pnm[_pp[r], j]   for (r) in 0 .. _Rz[0] for (j) in 0 .. 15
_o[r, 16] <- 91   for (r) in 0 .. _Rz[0] if _pp[r] >= 0
_o[r, j + 17] <- _an[_pk1[r], j]   for (r) in 0 .. _Rz[0] for (j) in 0 .. 23 if _pa1[_pp[r]]
_o[r, 40] <- 48 + _pk1[r] % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]]
_o[r, 39] <- 48 + _pk1[r] / 10 % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]] if _pk1[r] >= 10
_o[r, 38] <- 48 + _pk1[r] / 100 % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]] if _pk1[r] >= 100
_o[r, 37] <- 48 + _pk1[r] / 1000 % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]] if _pk1[r] >= 1000
_o[r, 36] <- 48 + _pk1[r] / 10000 % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]] if _pk1[r] >= 10000
_o[r, 35] <- 48 + _pk1[r] / 100000 % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]] if _pk1[r] >= 100000
_o[r, 34] <- 48 + _pk1[r] / 1000000 % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]] if _pk1[r] >= 1000000
_o[r, 33] <- 48 + _pk1[r] / 10000000 % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]] if _pk1[r] >= 10000000
_o[r, 32] <- 48 + _pk1[r] / 100000000 % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]] if _pk1[r] >= 100000000
_o[r, 31] <- 48 + _pk1[r] / 1000000000 % 10   for (r) in 0 .. _Rz[0] if not _pa1[_pp[r]] if _pk1[r] >= 1000000000
_o[r, 41] <- 44   for (r) in 0 .. _Rz[0] if _pd2[_pp[r]]
_o[r, 42] <- 32   for (r) in 0 .. _Rz[0] if _pd2[_pp[r]]
_o[r, j + 43] <- _an[_pk2[r], j]   for (r) in 0 .. _Rz[0] for (j) in 0 .. 23 if _pa2[_pp[r]]
_o[r, 66] <- 48 + _pk2[r] % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]]
_o[r, 65] <- 48 + _pk2[r] / 10 % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]] if _pk2[r] >= 10
_o[r, 64] <- 48 + _pk2[r] / 100 % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]] if _pk2[r] >= 100
_o[r, 63] <- 48 + _pk2[r] / 1000 % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]] if _pk2[r] >= 1000
_o[r, 62] <- 48 + _pk2[r] / 10000 % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]] if _pk2[r] >= 10000
_o[r, 61] <- 48 + _pk2[r] / 100000 % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]] if _pk2[r] >= 100000
_o[r, 60] <- 48 + _pk2[r] / 1000000 % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]] if _pk2[r] >= 1000000
_o[r, 59] <- 48 + _pk2[r] / 10000000 % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]] if _pk2[r] >= 10000000
_o[r, 58] <- 48 + _pk2[r] / 100000000 % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]] if _pk2[r] >= 100000000
_o[r, 57] <- 48 + _pk2[r] / 1000000000 % 10   for (r) in 0 .. _Rz[0] if not _pa2[_pp[r]] if _pk2[r] >= 1000000000
_o[r, 67] <- 93   for (r) in 0 .. _Rz[0] if _pp[r] >= 0
_o[r, 68] <- 32   for (r) in 0 .. _Rz[0] if _pp[r] >= 0
_o[r, 69] <- 61   for (r) in 0 .. _Rz[0] if _pp[r] >= 0
_o[r, 70] <- 32   for (r) in 0 .. _Rz[0] if _pp[r] >= 0
_o[r, 71] <- 116   for (r) in 0 .. _Rz[0] if _por[_pp[r]]
_o[r, 72] <- 114   for (r) in 0 .. _Rz[0] if _por[_pp[r]]
_o[r, 73] <- 117   for (r) in 0 .. _Rz[0] if _por[_pp[r]]
_o[r, 74] <- 101   for (r) in 0 .. _Rz[0] if _por[_pp[r]]
_o[r, j + 71] <- _an[_pv[r], j]   for (r) in 0 .. _Rz[0] for (j) in 0 .. 23 if _pav[_pp[r]]
_o[r, 71] <- 45   for (r) in 0 .. _Rz[0] if _pv[r] < 0 if not _por[_pp[r]] if not _pav[_pp[r]]
_pab[r] <- _pv[r]   for (r) in 0 .. _Rz[0] if _pv[r] >= 0 if not _por[_pp[r]] if not _pav[_pp[r]]
_pab[r] <- 0 - _pv[r]   for (r) in 0 .. _Rz[0] if _pv[r] < 0 if not _por[_pp[r]] if not _pav[_pp[r]]
# 十九桁は一つの割り算で出せない（10^18 の上は 64 ビットの積が溢れる）ので、下九桁と上に分ける
_pq[r] <- _pab[r] / 1000000000   for (r) in 0 .. _Rz[0]
_o[r, 94] <- 48 + _pab[r] % 10   for (r) in 0 .. _Rz[0]
_o[r, 93] <- 48 + _pab[r] / 10 % 10   for (r) in 0 .. _Rz[0] if _pab[r] >= 10
_o[r, 92] <- 48 + _pab[r] / 100 % 10   for (r) in 0 .. _Rz[0] if _pab[r] >= 100
_o[r, 91] <- 48 + _pab[r] / 1000 % 10   for (r) in 0 .. _Rz[0] if _pab[r] >= 1000
_o[r, 90] <- 48 + _pab[r] / 10000 % 10   for (r) in 0 .. _Rz[0] if _pab[r] >= 10000
_o[r, 89] <- 48 + _pab[r] / 100000 % 10   for (r) in 0 .. _Rz[0] if _pab[r] >= 100000
_o[r, 88] <- 48 + _pab[r] / 1000000 % 10   for (r) in 0 .. _Rz[0] if _pab[r] >= 1000000
_o[r, 87] <- 48 + _pab[r] / 10000000 % 10   for (r) in 0 .. _Rz[0] if _pab[r] >= 10000000
_o[r, 86] <- 48 + _pab[r] / 100000000 % 10   for (r) in 0 .. _Rz[0] if _pab[r] >= 100000000
_o[r, 85] <- 48 + _pq[r] % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 1
_o[r, 84] <- 48 + _pq[r] / 10 % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 10
_o[r, 83] <- 48 + _pq[r] / 100 % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 100
_o[r, 82] <- 48 + _pq[r] / 1000 % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 1000
_o[r, 81] <- 48 + _pq[r] / 10000 % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 10000
_o[r, 80] <- 48 + _pq[r] / 100000 % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 100000
_o[r, 79] <- 48 + _pq[r] / 1000000 % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 1000000
_o[r, 78] <- 48 + _pq[r] / 10000000 % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 10000000
_o[r, 77] <- 48 + _pq[r] / 100000000 % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 100000000
_o[r, 76] <- 48 + _pq[r] / 1000000000 % 10   for (r) in 0 .. _Rz[0] if _pq[r] >= 1000000000
_o[r, 95] <- 10   for (r) in 0 .. _Rz[0] if _pp[r] >= 0
_o[_pbs[p], j] <- _pnm[p, j]   for (p) in 0 .. _Pz[0] for (j) in 0 .. 15 if not _pn[p]
_o[_pbs[p], j + 16] <- _bt[j]   for (p) in 0 .. _Pz[0] for (j) in 0 .. 60 if not _pn[p]
render _o
