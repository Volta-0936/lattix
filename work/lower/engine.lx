_W[g, d] <- _O2[g, d] + _aw2[g, d] + 1   for (g) in 0 .. _Sz[0] for (d) in 0 .. 8 if _sn[g] == 3
_Wm[g, d] <- _W[g, d] - 1   for (g) in 0 .. _Sz[0] for (d) in 0 .. 8
# **桁は場所ごとの鎖**（行ごとに十九の規則を並べない）: 場所 g の引数 i の大きさを `_dq[4g+i, e]` に
# 10^e で割ったものとして置き、項の字の数の枠は、その番号の桁を右寄せで写すだけ
field _q4 : max bound 16384 4
_q4[g, i] <- g * 4 + i   for (g) in 0 .. _Sz[0] for (i) in 0 .. 3
field _Sq : max bound 1
_Sq[z] <- _Sz[0] * 4 + 3   for (z) in 0 .. 0
field _dq : max bound 65536 20
_dq[_q4[g, i], 0] <- _sv[g, i]   for (g) in 0 .. _Sz[0] for (i) in 0 .. 3 if _sv[g, i] >= 0
_dq[_q4[g, i], 0] <- 0 - _sv[g, i]   for (g) in 0 .. _Sz[0] for (i) in 0 .. 3 if _sv[g, i] < 0
