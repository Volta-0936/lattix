_O0[g, d] <- 17   for (g) in 0 .. _Sz[0] for (d) in 0 .. 8 if _sn[g] >= 1
_O1[g, d] <- _O0[g, d] + _aw0[g, d] + 2   for (g) in 0 .. _Sz[0] for (d) in 0 .. 8 if _sn[g] > 1
_O2[g, d] <- _O1[g, d] + _aw1[g, d] + 2   for (g) in 0 .. _Sz[0] for (d) in 0 .. 8 if _sn[g] > 2
_Oe0[g, d] <- _O0[g, d] + 19   for (g) in 0 .. _Sz[0] for (d) in 0 .. 8
_Oe1[g, d] <- _O1[g, d] + 19   for (g) in 0 .. _Sz[0] for (d) in 0 .. 8
_Oe2[g, d] <- _O2[g, d] + 19   for (g) in 0 .. _Sz[0] for (d) in 0 .. 8
