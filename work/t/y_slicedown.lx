# 輪の場を、輪の外の場が同じ切り口で非単調に読む —— 定義は受け取る。焼き手は回し直す途中の値を読むので断る（言う）
field a : max bound 8 4
field b : max bound 8 4
field z : max bound 8 4
a[0, j] <- 1   for (j) in 0 .. 3
b[0, j] <- 1   for (j) in 0 .. 3
z[0, j] <- 0   for (j) in 0 .. 3
a[n, j] <- b[n, j - 1] + 1   for (n) in 1 .. 7 for (j) in 1 .. 3 if a[n - 1, j] != 5
b[n, j] <- a[n, j]   for (n) in 1 .. 7 for (j) in 0 .. 3
z[n, j] <- 1   for (n) in 1 .. 7 for (j) in 0 .. 3 if a[n, j] == 3 if z[n - 1, j] != 7
print a
print z
