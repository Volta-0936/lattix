# ユークリッドの互除法（段ごとに割る数と余りが入れ替わる）
table p = (0,48,18),(1,1071,462),(2,17,5),(3,100,75)
field a : flat bound 4 20
field b : flat bound 4 20
a[i, 0] <- x   for (i,x,y) in p
b[i, 0] <- y   for (i,x,y) in p
a[i, k+1] <- b[i, k]   for (i) in 0 .. 3 for (k) in 0 .. 18 if b[i, k] > 0
b[i, k+1] <- a[i, k] % b[i, k]   for (i) in 0 .. 3 for (k) in 0 .. 18 if b[i, k] > 0
field g : max bound 4
g[i] <- a[i, k]   for (i) in 0 .. 3 for (k) in 0 .. 19 if b[i, k] == 0
print g
