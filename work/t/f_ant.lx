# ラングトンの蟻（時間の軸。蟻の居場所という値を座標にして盤を読む）
field x : flat bound 12
field y : flat bound 12
field dir : flat bound 12
field black : or bound 12 9 9
x[0] <- 4
y[0] <- 4
dir[0] <- 0
field col : flat bound 12
col[t] <- 1   for (t) in 0 .. 11 if black[t, x[t], y[t]]
col[t] <- 0   for (t) in 0 .. 11 if not black[t, x[t], y[t]]
dir[t] <- (dir[t - 1] + 1) % 4   for (t) in 1 .. 11 if col[t - 1] == 0
dir[t] <- (dir[t - 1] + 3) % 4   for (t) in 1 .. 11 if col[t - 1] == 1
x[t] <- x[t - 1] + 1   for (t) in 1 .. 11 if dir[t] == 0
x[t] <- x[t - 1]   for (t) in 1 .. 11 if dir[t] == 1
x[t] <- x[t - 1] - 1   for (t) in 1 .. 11 if dir[t] == 2
x[t] <- x[t - 1]   for (t) in 1 .. 11 if dir[t] == 3
y[t] <- y[t - 1]   for (t) in 1 .. 11 if dir[t] == 0
y[t] <- y[t - 1] + 1   for (t) in 1 .. 11 if dir[t] == 1
y[t] <- y[t - 1]   for (t) in 1 .. 11 if dir[t] == 2
y[t] <- y[t - 1] - 1   for (t) in 1 .. 11 if dir[t] == 3
black[t, i, j] <- true   for (t) in 1 .. 11 for (i) in 0 .. 8 for (j) in 0 .. 8 if black[t - 1, i, j] if i != x[t - 1]
black[t, i, j] <- true   for (t) in 1 .. 11 for (i) in 0 .. 8 for (j) in 0 .. 8 if black[t - 1, i, j] if j != y[t - 1]
black[t, i, j] <- true   for (t) in 1 .. 11 for (i) in 0 .. 8 for (j) in 0 .. 8 if i == x[t - 1] if j == y[t - 1] if col[t - 1] == 0
print x
print y
