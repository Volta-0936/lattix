# 累積和と区間和
table v = (0,3),(1,-1),(2,4),(3,1),(4,-5),(5,9)
field pre : max bound 7
pre[0] <- 0
pre[i+1] <- pre[i] + x   for (i,x) in v
field rs : max bound 7 7
rs[a, b] <- pre[b] - pre[a]   for (a) in 0 .. 6 for (b) in 0 .. 6 if a < b
field best : max bound 1
best[0] <- rs[a, b]   for (a) in 0 .. 6 for (b) in 0 .. 6
print pre
print best
