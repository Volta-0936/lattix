# 最長共通部分列の長さ（二次元の DP）
table a = (0,65),(1,66),(2,67),(3,66),(4,68),(5,65),(6,66)
table b = (0,66),(1,68),(2,67),(3,65),(4,66),(5,65)
field L : max bound 8 7
L[i, j] <- 0   for (i) in 0 .. 7 for (j) in 0 .. 0
L[i, j] <- 0   for (i) in 0 .. 0 for (j) in 0 .. 6
L[i+1, j+1] <- L[i, j] + 1   for (i,x) in a for (j,y) in b if x == y
L[i+1, j+1] <- L[i, j+1]   for (i,x) in a for (j,y) in b
L[i+1, j+1] <- L[i+1, j]   for (i,x) in a for (j,y) in b
print L
