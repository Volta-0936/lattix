# 丸括弧いろいろ: 二重・一語・ガードの両辺・表のループ・二次元のガードの辺の外に算術
table ch = (0,32)
field a : max bound 16
a[i] <- ((i + 1)) * (3) + (((2)))   for (i) in 0 .. 9
field b : max bound 16
b[i] <- i   for (i) in 0 .. 9 if (a[i] % 3) == (i % 3)
field c : min bound 16
c[i] <- (c1 + 1) * 2   for (i,c1) in ch if (c1 % 5) != 0
field d : max bound 16 16
d[i, j] <- (i * j) % (j + 1)   for (i) in 0 .. 5 for (j) in 0 .. 5 if (i + j) % 2 == 0
print a
print b
print c
print d
