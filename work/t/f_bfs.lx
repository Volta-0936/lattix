# 格子の幅優先（壁を避けて最短の歩数）
table wall = (0,1,1),(1,1,2),(2,1,3),(3,3,1),(4,3,2),(5,3,3)
field w : or bound 5 5
w[x, y] <- true   for (i,x,y) in wall
field d : min bound 5 5
d[0, 0] <- 0
d[x+1, y] <- d[x, y] + 1   for (x) in 0 .. 3 for (y) in 0 .. 4 if not w[x+1, y]
d[x, y+1] <- d[x, y] + 1   for (x) in 0 .. 4 for (y) in 0 .. 3 if not w[x, y+1]
d[x-1, y] <- d[x, y] + 1   for (x) in 1 .. 4 for (y) in 0 .. 4 if not w[x-1, y]
d[x, y-1] <- d[x, y] + 1   for (x) in 0 .. 4 for (y) in 1 .. 4 if not w[x, y-1]
field goal : min bound 1
goal[0] <- d[4, 4]
print goal
