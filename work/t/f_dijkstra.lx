# 重み付きグラフの最短路（自由に書いた形）
table edges = (0,1,7), (0,2,9), (0,5,14), (1,2,10), (1,3,15), (2,3,11), (2,5,2), (3,4,6), (4,5,9), (5,4,9)
field dist : min
dist[0] <- 0
dist[j] <- dist[i] + w   for (i,j,w) in edges
dist[i] <- dist[j] + w   for (i,j,w) in edges
field far : max
far[0] <- dist[v]   for (v) in 0 .. 5
field hops : min
hops[0] <- 0
hops[j] <- hops[i] + 1   for (i,j,w) in edges
print dist
print far
print hops
