# 小さな機械（命令の表を時間の軸で回す）: 0 加算 / 1 減算 / 2 ゼロなら飛ぶ / 3 飛ぶ / 4 止まる
table prog = (0,0,0,5),(1,2,1,4),(2,1,1,1),(3,3,0,1),(4,4,0,0)
field op : flat bound 5
field ra : flat bound 5
field im : flat bound 5
op[p] <- o   for (p,o,r,i) in prog
ra[p] <- r   for (p,o,r,i) in prog
im[p] <- i   for (p,o,r,i) in prog
field pc : flat bound 40
field r0 : flat bound 40
field r1 : flat bound 40
field halt : or bound 40
pc[0] <- 0
r0[0] <- 0
r1[0] <- 3
field cop : flat bound 40
cop[t] <- op[pc[t]]   for (t) in 0 .. 39
halt[t] <- true   for (t) in 0 .. 39 if cop[t] == 4
pc[t] <- pc[t - 1] + 1   for (t) in 1 .. 39 if cop[t - 1] <= 1
pc[t] <- im[pc[t - 1]]   for (t) in 1 .. 39 if cop[t - 1] == 3
pc[t] <- im[pc[t - 1]]   for (t) in 1 .. 39 if cop[t - 1] == 2 if r1[t - 1] == 0
pc[t] <- pc[t - 1] + 1   for (t) in 1 .. 39 if cop[t - 1] == 2 if r1[t - 1] != 0
pc[t] <- pc[t - 1]   for (t) in 1 .. 39 if cop[t - 1] == 4
r0[t] <- r0[t - 1] + im[pc[t - 1]]   for (t) in 1 .. 39 if cop[t - 1] == 0
r0[t] <- r0[t - 1]   for (t) in 1 .. 39 if cop[t - 1] >= 1
r1[t] <- r1[t - 1] - im[pc[t - 1]]   for (t) in 1 .. 39 if cop[t - 1] == 1
r1[t] <- r1[t - 1]   for (t) in 1 .. 39 if cop[t - 1] != 1
field fin : max bound 1
fin[0] <- r0[t]   for (t) in 0 .. 39 if halt[t]
print fin
