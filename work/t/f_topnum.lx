# ⊤ を min / max の場へ運ぶ（14v）。定義は flat の ⊤ を読んだ値を数の場へも ⊤ として運び、join は ⊤ を
# 吸収する（max の 2 も min の 9 も ⊤ に負ける）。比較は ⊤ で立つ。print は `⊤ CONFLICT` と書く
table e = (1,3), (1,4), (2,5), (3,6)
field a : flat bound 4
field m : max bound 4
field n : min bound 4 4
field c : or bound 4
field k : max bound 4
a[i] <- v   for (i, v) in e
m[i] <- a[i] + 1   for (i) in 0 .. 3
m[i] <- 2          for (i) in 0 .. 3
n[i, j] <- 0 - a[i] * j   for (i) in 0 .. 3 for (j) in 0 .. 3
n[i, j] <- 9              for (i) in 0 .. 3 for (j) in 1 .. 2
c[i] <- true   for (i) in 0 .. 3 if m[i] > 100
k[i] <- m[i] - n[i, 1]   for (i) in 0 .. 3
print a
print m
print n
print c
print k
