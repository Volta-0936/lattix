# 撒いた軸の本（sp/axgen.py 種 1）
field a : sum bound 9
field b : min bound 9 5
field c : max bound 9
a[0] <- 3
b[0, j] <- 3   for (j) in 0 .. 3 if j >= 0
b[1, j] <- 2   for (j) in 0 .. 3
c[0] <- 2
b[n, j] <- 4   for (n) in 2 .. 8 for (j) in 1 .. 3 if a[n - 1] == 4
c[n] <- a[n - 1] + 0   for (n) in 2 .. 8 if a[n - 1] < 4 if c[n - 1] < 1
c[n] <- a[n - 1] + 0   for (n) in 3 .. 8 
a[n] <- 4   for (n) in 3 .. 8 if a[n - 1] < 2
c[n] <- a[n - 1] + 2   for (n) in 3 .. 8 
b[n, j] <- b[n - 1, j + 1] + 0   for (n) in 3 .. 8 for (j) in 1 .. 3 if c[n - 1] < 0
a[n] <- 4   for (n) in 2 .. 8 if a[n - 1] < 3 if c[n - 1] == 1
print a
print b
print c
