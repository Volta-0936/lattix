# ⊤ を sum の場へ運ぶ（14v）。寄与の一つが ⊤ なら和は ⊤ —— 焼いた join は升の ⊤ を見て足さない
table e = (1,3), (1,4), (2,5)
field a : flat bound 4
field s : sum bound 4
field t : sum bound 1
field u : max bound 4
a[i] <- v   for (i, v) in e
s[i] <- 10         for (i) in 0 .. 3
s[i] <- a[i] + 1   for (i) in 0 .. 3
s[i] <- i          for (i) in 0 .. 3
t[0] <- a[i]       for (i) in 0 .. 3
u[i] <- s[i] * 2   for (i) in 0 .. 3
print s
print t
print u
