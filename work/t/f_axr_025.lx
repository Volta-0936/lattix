# 撒いた軸の本（sp/axgen.py 種 1）
field a : count bound 13 5
field b : count bound 13 5
field c : min bound 13 5
a[0, j] <- 2   for (j) in 0 .. 3
b[0, j] <- 3   for (j) in 0 .. 3 if j >= 0
c[0, j] <- 2   for (j) in 0 .. 3
c[1, j] <- 1   for (j) in 0 .. 3
c[n, j] <- 3   for (n) in 3 .. 12 for (j) in 1 .. 3 if c[n - 2, j + 1] < 4 if c[n - 2, j + 1] < 3
a[n, j] <- n   for (n) in 2 .. 12 for (j) in 1 .. 3 if c[n - 1, 0] < 4 if c[n - 2, j + 1] != 2
a[n, j] <- n   for (n) in 1 .. 12 for (j) in 1 .. 3 if b[n - 1, j] == 0 if a[n - 1, j - 1] == 4
c[n, j] <- 2   for (n) in 1 .. 12 for (j) in 1 .. 3 if b[n - 1, j + 1] >= 2
c[n, j] <- c[n - 1, j] + 2   for (n) in 3 .. 12 for (j) in 1 .. 3 if c[n - 1, 0] != 0
a[n, j] <- n   for (n) in 2 .. 12 for (j) in 1 .. 3 if b[n - 1, j] != 1 if a[n - 1, 0] == 2
b[n, j] <- n   for (n) in 1 .. 12 for (j) in 1 .. 3 if b[n - 1, j + 1] >= 4 if c[n, j - 1] < 0
print a
print b
print c
