# 入れ子の深い項（`cons` を十一重ね・十五重ね）—— 候補の深さは括弧の深さ + 2 まで積める
constructor cons(head, tail) bound 64
field W : flat bound 4
W[0] <- cons(99,cons(111,cons(110,cons(115,cons(116,cons(114,cons(117,cons(99,cons(116,cons(111,cons(114,0)))))))))))
W[1] <- cons(1,cons(2,cons(3,cons(4,cons(5,cons(6,cons(7,cons(8,cons(9,cons(10,cons(11,cons(12,cons(13,cons(14,cons(15,0)))))))))))))))
W[2] <- cons(7, 0)
print W
