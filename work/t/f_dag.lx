# 有向非巡回グラフの最長路と段
table job = (0,3), (1,2), (2,4), (3,1), (4,2)
table dep = (0,1), (0,2), (1,3), (2,3), (3,4)
field finish : max bound 8
finish[j] <- t   for (j,t) in job
finish[b] <- finish[a] + t   for (a,b) in dep for (j,t) in job if j == b
field level : max bound 8
level[j] <- 0   for (j,t) in job
level[b] <- level[a] + 1   for (a,b) in dep
print finish
print level
