# 引き算ゲーム（1・3・4 個取れる）: 相手を負けの山に送れる山は勝ち（軸に沿った成層・not）
field win : or bound 31
win[n] <- true   for (n) in 1 .. 30 if not win[n - 1]
win[n] <- true   for (n) in 3 .. 30 if not win[n - 3]
win[n] <- true   for (n) in 4 .. 30 if not win[n - 4]
field lose : count bound 1
lose[0] <- n   for (n) in 0 .. 30 if not win[n]
print win
print lose
