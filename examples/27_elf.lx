# **C を使わずに実行形式を書く。** —— 到達点の一歩目。
#
# `render` は場を座標順のバイト列として書き出す。つまり Lattix は
# **ファイルの中身を計算できる**。中身が実行形式なら、Lattix は実行形式を書ける。
#
# ここでは最小の静的 x86-64 ELF を組み立てる。前置き（ELF ヘッダと
# プログラムヘッダ）は定数のバイト列だが、**終了コードは計算される** ——
# 下のグラフの最短経路長がそのまま `exit(n)` の n になる。
# だから出来上がる実行ファイルは「焼き込んだ塊」ではなく **答えの実体化** である。
#
#   python3 lattix.py examples/27_elf.lx > a.out ; chmod +x a.out ; ./a.out ; echo $?
#
# gcc は一度も呼ばれていない。

table edges = (0,1,4), (0,2,1), (2,1,2), (1,3,5), (2,3,8),
              (3,4,3), (1,4,11), (4,5,2), (2,5,20), (5,3,1)

field dist : min
dist[0] <- 0
dist[j] <- dist[i] + w   for (i,j,w) in edges

# ── 実行形式の骨 ────────────────────────────────────────────────
# 126 バイト目が `mov edi, imm32` の即値。そこに答えを置く。
table elfimg = (0,127), (1,69), (2,76), (3,70), (4,2), (5,1), (6,1), (7,0),
             (8,0), (9,0), (10,0), (11,0), (12,0), (13,0), (14,0), (15,0),
             (16,2), (17,0), (18,62), (19,0), (20,1), (21,0), (22,0), (23,0),
             (24,120), (25,0), (26,64), (27,0), (28,0), (29,0), (30,0), (31,0),
             (32,64), (33,0), (34,0), (35,0), (36,0), (37,0), (38,0), (39,0),
             (40,0), (41,0), (42,0), (43,0), (44,0), (45,0), (46,0), (47,0),
             (48,0), (49,0), (50,0), (51,0), (52,64), (53,0), (54,56), (55,0),
             (56,1), (57,0), (58,64), (59,0), (60,0), (61,0), (62,0), (63,0),
             (64,1), (65,0), (66,0), (67,0), (68,5), (69,0), (70,0), (71,0),
             (72,0), (73,0), (74,0), (75,0), (76,0), (77,0), (78,0), (79,0),
             (80,0), (81,0), (82,64), (83,0), (84,0), (85,0), (86,0), (87,0),
             (88,0), (89,0), (90,64), (91,0), (92,0), (93,0), (94,0), (95,0),
             (96,132), (97,0), (98,0), (99,0), (100,0), (101,0), (102,0), (103,0),
             (104,132), (105,0), (106,0), (107,0), (108,0), (109,0), (110,0), (111,0),
             (112,0), (113,16), (114,0), (115,0), (116,0), (117,0), (118,0), (119,0),
             (120,184), (121,60), (122,0), (123,0), (124,0), (125,191), (126,0), (127,0),
             (128,0), (129,0), (130,15), (131,5)

field out : max
out[i] <- b        for (i,b) in elfimg
out[126] <- dist[5]

render out
