# **アセンブラを Lattix で書く。** —— C を切る道の二歩目。
#
# 27_elf は機械語が定数だった。ここでは違う。命令の並びは **データから決まり**、
# 各命令の番地は **前置きの鎖**（offset[i] = offset[i-1] + len[i-1]）で決まり、
# ELF の大きさは出来上がった機械語の長さから計算される。
#
# 番地割り当ては時間の中の手続きに見えるが、**命令番号という座標に沿った鎖**である。
# だから逐次実行は要らない —— 座標順に一度なめれば決まる（処理系がそう選ぶ）。
#
# 出来上がった実行ファイルは `nums` の総和を **自分で足して** 終了コードにする。
# 足すのは Lattix ではない。Lattix が書いた機械語である。
#
#   python3 lattix.py examples/28_asm.lx > a.out ; chmod +x a.out ; ./a.out ; echo $?
#   => 125   (7 + 13 + 5 + 100)

table nums = (0,7), (1,13), (2,5), (3,100)

table elfhdr = (0,127), (1,69), (2,76), (3,70), (4,2), (5,1), (6,1), (7,0),
               (8,0), (9,0), (10,0), (11,0), (12,0), (13,0), (14,0), (15,0),
               (16,2), (17,0), (18,62), (19,0), (20,1), (21,0), (22,0), (23,0),
               (24,120), (25,0), (26,64), (27,0), (28,0), (29,0), (30,0), (31,0),
               (32,64), (33,0), (34,0), (35,0), (36,0), (37,0), (38,0), (39,0),
               (40,0), (41,0), (42,0), (43,0), (44,0), (45,0), (46,0), (47,0),
               (48,0), (49,0), (50,0), (51,0), (52,64), (53,0), (54,56), (55,0),
               (56,1), (57,0), (58,64), (59,0), (60,0), (61,0), (62,0), (63,0),
               (64,1), (65,0), (66,0), (67,0), (68,5), (69,0), (70,0), (71,0),
               (72,0), (73,0), (74,0), (75,0), (76,0), (77,0), (78,0), (79,0),
               (80,0), (81,0), (82,64), (83,0), (84,0), (85,0), (86,0), (87,0),
               (88,0), (89,0), (90,64), (91,0), (92,0), (93,0), (94,0), (95,0),
               (96,0), (97,0), (98,0), (99,0), (100,0), (101,0), (102,0), (103,0),
               (104,0), (105,0), (106,0), (107,0), (108,0), (109,0), (110,0), (111,0),
               (112,0), (113,16), (114,0), (115,0), (116,0), (117,0), (118,0), (119,0)

# ── 命令列（データが長さを決める）────────────────────────────────
#   形 1 : オペコード1バイト + imm32   （5バイト）
#   形 2 : 2バイト命令                 （op, imm の二つをそのまま並べる）
field icount : max
icount[] <- i + 1        for (i,v) in nums

field form : max
field op : max
field imm : max

op[0] <- 184                              # mov eax, 0
form[0] <- 1
imm[0] <- 0

op[i+1] <- 5             for (i,v) in nums     # add eax, v
form[i+1] <- 1           for (i,v) in nums
imm[i+1] <- v            for (i,v) in nums

op[icount[] + 1] <- 137                   # mov edi, eax   (89 c7)
form[icount[] + 1] <- 2
imm[icount[] + 1] <- 199

op[icount[] + 2] <- 184                   # mov eax, 60
form[icount[] + 2] <- 1
imm[icount[] + 2] <- 60

op[icount[] + 3] <- 15                    # syscall        (0f 05)
form[icount[] + 3] <- 2
imm[icount[] + 3] <- 5

field nins : max
nins[] <- icount[] + 3

# ── 番地割り当て —— 命令番号に沿った鎖 ──────────────────────────
field len : max
len[i] <- 5              for (i) in 0 .. nins[] if form[i] == 1
len[i] <- 2              for (i) in 0 .. nins[] if form[i] == 2

field off : max
off[0] <- 0
off[i] <- off[i-1] + len[i-1]   for (i) in 0 .. nins[]

field codelen : max
codelen[] <- off[i] + len[i]    for (i) in 0 .. nins[]

# ── 実体化 ──────────────────────────────────────────────────────
field out : max
out[i] <- b              for (i,b) in elfhdr

# 大きさは出来上がってから決まる（p_filesz と p_memsz）
out[96]  <- (120 + codelen[]) % 256
out[97]  <- (120 + codelen[]) / 256 % 256
out[104] <- (120 + codelen[]) % 256
out[105] <- (120 + codelen[]) / 256 % 256

out[120 + off[i]]     <- op[i]                    for (i) in 0 .. nins[]
out[120 + off[i] + 1] <- imm[i] % 256             for (i) in 0 .. nins[] if form[i] == 1
out[120 + off[i] + 2] <- imm[i] / 256 % 256       for (i) in 0 .. nins[] if form[i] == 1
out[120 + off[i] + 3] <- imm[i] / 65536 % 256     for (i) in 0 .. nins[] if form[i] == 1
out[120 + off[i] + 4] <- imm[i] / 16777216 % 256  for (i) in 0 .. nins[] if form[i] == 1
out[120 + off[i] + 1] <- imm[i]                   for (i) in 0 .. nins[] if form[i] == 2

render out
