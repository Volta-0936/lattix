# **区間の集約の印はビットの並び**（14）: 計数器 - 下端 を番号にして、場の下の升に一ビットずつ立てる。
encb[225,0] <- 72                    # 48 8D B1 d32  lea rsi, [rcx+d32]     （計数器 - 下端）
encb[225,1] <- 141
encb[225,2] <- 177
shp[225] <- 28868
encb[226,0] <- 72                    # 48 0F AB B3 d32  bts [rbx+d32], rsi  （印を立てる。立っていれば CF）
encb[226,1] <- 15
encb[226,2] <- 171
encb[226,3] <- 179
shp[226] <- 33028
# **置き場は二枚の面がそれぞれ 2 GB まで**（14）: 階数の面の頭は rbx から引き（lea）、証人の長さは
# 零拡張の mov で渡す（値 + 階数は 4 GB まで）。
encb[227,0] <- 186                   # BA imm32  mov edx, imm32（上位を 0 に —— 2 GB を越える長さ）
shp[227] <- 20548
encb[228,0] <- 76                    # 4C 8D 93 d32  lea r10, [rbx+d32]（階数の面の頭）
encb[228,1] <- 141
encb[228,2] <- 147
shp[228] <- 28868
encb[229,0] <- 72                    # 48 2B B3 d32  sub rsi, [rbx+d32]（計数器 - 下端の升。下端が場の区間の印）
encb[229,1] <- 43
encb[229,2] <- 179
shp[229] <- 28868
# 場で割る・余りを取る（種15 / 16。14f）: 割る数は rsi（場の読み）。**床**に寄せ、余りは割る数の符号に合わせる
# （解釈実行の `//` と `%`）。jz / jns の相対の飛びは **次の形の長さ**を跨ぐ —— 二つの形は必ず隣り合う
encb[230,0] <- 72                    # 48 85 F6  test rsi, rsi（割る数が 0 なら ⊥）
encb[230,1] <- 133
encb[230,2] <- 246
shp[230] <- 12288
encb[231,0] <- 72                    # cqo ; idiv rsi ; test rdx,rdx ; jz +10（割り切れたら寄せない）
encb[231,1] <- 153
encb[231,2] <- 72
encb[231,3] <- 247
encb[231,4] <- 254
encb[231,5] <- 72
encb[231,6] <- 133
encb[231,7] <- 210
encb[231,8] <- 116
encb[231,9] <- 10
shp[231] <- 40960
encb[232,0] <- 72                    # xor rdx,rsi ; sar rdx,63 ; add rax,rdx（符号が違えば 1 引く —— 床）
encb[232,1] <- 49
encb[232,2] <- 242
encb[232,3] <- 72
encb[232,4] <- 193
encb[232,5] <- 250
encb[232,6] <- 63
encb[232,7] <- 72
encb[232,8] <- 1
encb[232,9] <- 208
shp[232] <- 40960
encb[233,0] <- 72                    # cqo ; idiv rsi ; mov rax,rdx（余り）
encb[233,1] <- 153
encb[233,2] <- 72
encb[233,3] <- 247
encb[233,4] <- 254
encb[233,5] <- 72
encb[233,6] <- 137
encb[233,7] <- 208
shp[233] <- 32768
encb[234,0] <- 72                    # test rax,rax ; jz +8（余り 0 はそのまま）
encb[234,1] <- 133
encb[234,2] <- 192
encb[234,3] <- 116
encb[234,4] <- 8
shp[234] <- 20480
encb[235,0] <- 72                    # xor rdx,rsi ; jns +3 ; add rax,rsi（符号が違えば割る数を足す）
encb[235,1] <- 49
encb[235,2] <- 242
encb[235,3] <- 121
encb[235,4] <- 3
encb[235,5] <- 72
encb[235,6] <- 1
encb[235,7] <- 240
shp[235] <- 32768
# 変数で割る数を rsi へ（種17〜20。14j）: 列は行の升、計数器は番号 0 / 1 / 2 の register（3 からは升 —— 形213）
encb[236,0] <- 72                    # 48 8B 71 d8  mov rsi, [rcx+d8]（列）
encb[236,1] <- 139
encb[236,2] <- 113
shp[236] <- 16577                    # 長さ4・穴3・imm8
encb[237,0] <- 72                    # 48 89 CE  mov rsi, rcx（計数器 0）
encb[237,1] <- 137
encb[237,2] <- 206
shp[237] <- 12288
encb[238,0] <- 76                    # 4C 89 EE  mov rsi, r13（計数器 1）
encb[238,1] <- 137
encb[238,2] <- 238
shp[238] <- 12288
encb[239,0] <- 76                    # 4C 89 F6  mov rsi, r14（計数器 2）
encb[239,1] <- 137
encb[239,2] <- 246
shp[239] <- 12288
# **-1 で割る**（14j）。idiv は INT64_MIN / -1 で落ちる（#DE —— SIGFPE。答えも断りも出ない）。割る数が
# -1 なら割らない: 商は符号を裏返す（`neg` —— INT64_MIN なら溢れの踏み台へ。解釈実行は 2^63 を持つ）、
# 余りは 0。種15 / 16（14f）から在った穴で、変数で割るようになって値の源が増えたので塞いだ。
# 相対の飛びは **隣の形の長さ**を跨ぐ（jo 6・jmp 2 / 割る 10 + 10 / 余り 8 + 5 + 8）
encb[240,0] <- 72
encb[240,1] <- 131
encb[240,2] <- 254
encb[240,3] <- 255
encb[240,4] <- 117
encb[240,5] <- 11
encb[240,6] <- 72
encb[240,7] <- 247
encb[240,8] <- 216
shp[240] <- 36864                    # cmp rsi,-1 ; jne +11 ; neg rax（長さ9・穴なし）
encb[242,0] <- 235                   # EB 14  jmp +20（-1 で割った商は割る二つを跨ぐ）
encb[242,1] <- 20
shp[242] <- 8192
encb[243,0] <- 72
encb[243,1] <- 131
encb[243,2] <- 254
encb[243,3] <- 255
encb[243,4] <- 117
encb[243,5] <- 4
encb[243,6] <- 49
encb[243,7] <- 192
encb[243,8] <- 235
encb[243,9] <- 21
shp[243] <- 40960                    # cmp rsi,-1 ; jne +4 ; xor eax,eax ; jmp +21（-1 の余りは 0）

# **形の数は一箇所で言う。** 168 を三箇所に書いていたので、形を五つ足した日に
# 長さも穴も ⊥ のままになり、**命令の並びがそこで途切れた**（黙って零が出る）。
# 上限を数字で書くのは、上限を数えないことの言い換えである（気づき33 の再来）。
field nfm : max bound 1              # 形の番号の上限
# **表から導く。** 前は 198 と書いてあった —— 形を足した日（199・200）、足した形の長さが
# 無いまま命令の位置の鎖が途切れ、そこから後ろの符号が **全部 0 のまま**の実行ファイルを
# 黙って出した（走らせると segfault）。形の番号の上限は、形の表が言う。
nfm[z] <- f   for (f) in 0 .. 255 for (z) in 0 .. 0 if encb[f, 0] >= 0
field shln : max bound 256           # 命令の長さ
shln[f] <- shp[f] / 4096            for (f) in 0 .. nfm[0]
field shho : max bound 256           # 穴の位置
shho[f] <- shp[f] / 64 % 64         for (f) in 0 .. nfm[0]
field shhk : max bound 256           # 穴の種（0 無し / 1 imm8 / 4 imm32 / 5 rel32）
shhk[f] <- shp[f] % 64              for (f) in 0 .. nfm[0]

# ── **倍率も穴である** ───────────────────────────────────────────
# 形の表は長いあいだ「命令 × 升の幅」の組を一行ずつ持っていた ——
# `mov rax,[rbx+rdx*8+d32]` と `mov rax,[rbx+rdx*4+d32]` は別の形で、
# 幅を一つ足すたびに表が倍になる。だがこれは **現象**であって基ではない:
# x86 の SIB バイトは上二ビットに倍率を持っており、**倍率は最初から
# 命令の中の穴**だった。表がそれを定数で埋めていただけである。
#
# 番地の d32 を穴にしたのと同じことを倍率にもする。すると形は一つで
# 四つの幅（×1/×2/×4/×8）を差せるようになり、**幅を足しても表は増えない**。
#
# SIB を持つかは表が言う —— modrm の下三ビットが 4 なら次のバイトが SIB
# である（x86 の決まり）。位置は必ず穴の一つ手前。数えたら 17 形あった。
field mrm : max bound 256            # 形 f の modrm（穴の二つ手前）
mrm[f] <- encb[f, shho[f] - 2]      for (f) in 0 .. nfm[0] if shhk[f] == 4 if shho[f] >= 2
field mrmr : max bound 256           # modrm の rm（下三ビット）
mrmr[f] <- mrm[f] % 8               for (f) in 0 .. nfm[0]
field mrmm : max bound 256           # modrm の mod（上二ビット）
mrmm[f] <- mrm[f] / 64              for (f) in 0 .. nfm[0]
field hassib : or bound 256          # 形 f は SIB を持つ
# rm が 4 なら SIB が続く —— ただし mod が 00 のときは [SIB] の絶対番地で
# 穴の一つ手前とは限らない。ずれ付き（mod 01/10）だけを見る。
hassib[f] <- true                   for (f) in 0 .. nfm[0] if mrmr[f] == 4
      if mrmm[f] >= 1 if mrmm[f] <= 2
field shsb : min bound 256           # SIB のバイト位置（63 = 持たない）
shsb[f] <- 63                       for (f) in 0 .. nfm[0]
shsb[f] <- shho[f] - 1              for (f) in 0 .. nfm[0] if hassib[f]
# **表は書き換えない。** 倍率を抜いた SIB も、いまの倍率も、表から出る。
field sibb : max bound 256           # 倍率を抜いた SIB（index と base だけ）
sibb[f] <- encb[f, shsb[f]] % 64    for (f) in 0 .. nfm[0] if hassib[f]
field fmsc : max bound 256           # 形がいま持っている倍率ビット（既定）
fmsc[f] <- encb[f, shsb[f]] - sibb[f]   for (f) in 0 .. nfm[0] if hassib[f]
# 長さと、穴の位置・幅。kind 4 = imm32/d32 / 1 = imm8 / 5 = rel32
# ── 配置 ─────────────────────────────────────────────────────────
#   像（total）→ 地上 dbase（表・dgap）→ 表の印（ft2）→ 生（rcap）→ 詰め直し（pbsz）→ 区間の印（mtz）
#   → 日程の二枚と升（gpz）→ 場 F（fbase、頁の頭）→ 階数 K（fbase + ftot）。F の手前までは即値の番地、
#   F は rbx から・K は r10 から引く（14）
# 地上データの頭は **像の後ろ**（4194304 + total）。踏むと黙って壊れる。
field dbase : max bound 1
# **像の後ろ**は像の大きさが決める。4718592 と書いてあったのは
# 4194304 + 524288 —— `total` の生き写しである。`total` を上げた日、
# 地上データの頭は像の**中**を指し、プログラムは自分の命令を上書きする。
dbase[z] <- total[0] + 4194304   for (z) in 0 .. 0
field fbase : max bound 1
# **宣言した上限は、そこまで本当に入らなければ嘘である。** 源 262,144 バイトを
# (位置, 文字) の表に開くと 16 バイト × 262,144 = 4MB 要る。場の置き場が
# 8MB のときは地上に 3.6MB しか無く、**228KB を超える源が黙って壊れていた**
# （出力 23 バイト、終了コード 0）。置き場を上げれば宣言が本当になる。
# 場の頭は **地上が要るだけ後ろ**（下の `dgap`。読み口から導く）。
field dcap : max bound 1                    # 地上データの置き場（バイト）
# **日程のための二枚**は場の下（rbx から負の変位）に住む ——
#   EP[f]   場 f が最後に動いた周回（場の数 + 1 枡。最後の枡は「表」の枠）
#   LAST[r] 規則 r が最後に回った周回
# どちらも 0 で始まるので、初回は必ず通る（0 >= 0）。
field epsz : max bound 1                    # EP の大きさ（バイト）
epsz[0] <- nfl[0] * 8 + 8   for (z) in 0 .. 0
field gap : max bound 1                     # 場の下に空ける幅
gap[0] <- nrl[0] * 8 + epsz[0] + 512   for (z) in 0 .. 0
# **育っていく場を引き算に使ってはいけない**（気づき38 の裏面）。`gap` は
# 下から育つので `- gap[0]` を `max` の場に入れると **途中のいちばん小さい
# gap** が残る —— 答えが実行順に依存する。比較のガードを一つ置けば、
# 断片の成層は比較を非単調と見るので **gap が閉じてから**この規則が回る。
# 引く前に閉じる。それだけで写像は単調に戻る。
field gpz : max bound 1                     # 閉じた gap（引き算に使えるのはこちら）
gpz[0] <- gap[0]   for (z) in 0 .. 0 if gap[0] >= 1
dcap[0] <- dgap[0]   for (z) in 0 .. 0

# ── 入力の口。**8 なら語の列、1 なら生バイト**（源を読むのはこちら）──────
# バイトのときは生を後ろに読み、(位置, 文字) の二列の表に展開する ——
# 位置は列である。**バイト列を表にするのは、座標を一本足すだけ**である。
field ibyte : or bound 1
ibyte[z] <- true                     for (z) in 0 .. 0 for (z) in 0 .. 0 if inpw[0] == 1
field iword : or bound 1
iword[z] <- true                     for (z) in 0 .. 0 for (z) in 0 .. 0 if inpw[0] == 8
# 生バイトの置き場。**詰め直しの置き場も同じ広さで足りていなければならない**
# —— `out` の升数が rcap + 65536 を超えると、詰め直しが地図の外へ出る。
field rcap : max bound 1                    # 生バイトの置き場
rcap[0] <- 983040
field rcap2 : max bound 1
rcap2[0] <- rcap[0] * 2   for (z) in 0 .. 0
# ── 地上（表）の広さは **読み口から出る**。ここは長く定数だった ——
# 12582912 と書いてあり、それは「地上 7.5 MB」を意味していた。源を
# (位置, 文字) に開くと **一文字 16 バイト**要るので、7.5 MB は
# 491,520 文字ぶんしかない。読み口は 524,288 バイトあるので、
# **491,520 を超えた源は地上からはみ出して場を踏む** —— しかも
# はみ出しの見張りは場への書きしか見ていないので、**segfault で黙って死ぬ**。
# 二つの数（読める量と、置ける量）は一つの判断である。導く。
field dneed : max bound 1                   # 表に要るバイト（一文字 16）
dneed[z] <- rcap[0] * 16   for (z) in 0 .. 0
field dgap : max bound 1                    # 地上ぜんぶ（表 + 余白 1 MB）
dgap[z] <- dneed[0] + 1048576   for (z) in 0 .. 0
# **場の頭は小さい置き場ぜんぶの後ろ**（14）。前は [地上][F][K][印][生][詰め直し] の順で、
# 番地を符号つき 32 ビットの即値で焼くので **全部で** 2 GB の手前までだった。だが F は rbx から、
# K は r10 から引く —— 変位が 32 ビットなのは **面ごと**である。小さい置き場を F の前に寄せれば
# （[地上][表の印][生][詰め直し][区間の印][日程の二枚][F][K]）、即値の番地はどれも F の頭より下に
# 収まり、F と K はそれぞれ 2 GB まで持てる。下ろしが 2 GB の手前（2,039 MB）に来ていた。
field fbq : max bound 1                     # 場の頭の手前（小さい置き場の終わり + 区間の印 + 日程）
fbq[z] <- pbuf[0] + pbsz[0] + mtz[0] + gpz[0] + 4095   for (z) in 0 .. 0
fbase[z] <- fbq[0] / 4096 * 4096   for (z) in 0 .. 0
field pb : max bound 1                      # 前置きの長さ（⊥ 埋めが始まる所）
pb[0] <- 50
pb[z] <- 55                          for (z) in 0 .. 0 for (z) in 0 .. 0 if inpw[0] == 1

# ── 座標の広さは **場ごと・次元ごと** である（一律 64 ではない）──────
# fdim (場, 次元, 広さ)。次元は 0 / 1 / 2。多次元の畳みは掛けて足す鎖になる ——
# 64 升に揃えていたのは私の都合で、座標の性質ではなかった。
field fw2 : max bound 2048                    # 二つ目の次元の広さ（畳みの掛け数）
fw2[f] <- fw[f, 1]                  for (f) in 0 .. nflz[0]

field fsz : max bound 2048                    # 場 f の升目の数
fsz[f] <- fw[f, 0]                  for (f) in 0 .. nflz[0] if fdar[f] == 1
fsz[f] <- fw[f, 0] * fw[f, 1]       for (f) in 0 .. nflz[0] if fdar[f] == 2
fsz[f] <- fw[f, 0] * fw[f, 1] * fw[f, 2]   for (f) in 0 .. nflz[0] if fdar[f] == 3

# **項の列は左からの畳み込みである。** `a + K * b` は括弧と同じで、
# 名前を付けていない中間値でしかない —— 付ければただの項の列になる。
# ── **升の幅は束が言う。** ─────────────────────────────────────────
# 幅 8 は「値と同じにしておけば座標の作り方が一つで済む」都合であって、
# 束の性質ではない。`or` の升は 0 か 1 しか取らない —— 8 バイトは
# 8 ビットでも多い。束ごとに幅を出し、番地も倍率もそこから出す。
# （まずは全部 8 のまま配管を通し、生む機械語がバイト一致することを見る。）
field wbits : max bound 16                    # 升の幅 → SIB の倍率ビット
wbits[1] <- 0
wbits[2] <- 64
wbits[4] <- 128
wbits[8] <- 192
field fwb : max bound 2048                    # 場 f の升の幅（バイト）——**束が言う**
fwb[f] <- 8                         for (f) in 0 .. nflz[0] if fdlat[f] == 1
fwb[f] <- 8                         for (f) in 0 .. nflz[0] if fdlat[f] == 2
fwb[f] <- 1                         for (f) in 0 .. nflz[0] if fdlat[f] == 3
fwb[f] <- 8                         for (f) in 0 .. nflz[0] if fdlat[f] == 6
fwb[f] <- 8                         for (f) in 0 .. nflz[0] if fdlat[f] == 8
fwb[f] <- 8                         for (f) in 0 .. nflz[0] if fdlat[f] == 9
# **狭めないのではなく、断る。** 幅を使用地点で上書きすると、答えの
# 形（場の吐き出し）が生成器の内部都合で変わり、読む側が `wide8` を
# 知らないと解けない —— **同じ判断が二箇所**になる。幅は束だけが言う。
# 束と合わない使われ方は、黙って広げずに **理由8 で断る**。
badk[z] <- rlin[lpr[gl]] * 16 + 8   for (gl) in 0 .. nglz[0] for (z) in 0 .. 0
      if lpk[gl] >= 2 if fdlat[lpbf[gl]] == 3
badk[z] <- rlin[lpr[gl]] * 16 + 8   for (gl) in 0 .. nglz[0] for (z) in 0 .. 0
      if lplk[gl] >= 1 if lplk[gl] <= 2 if fdlat[lplf[gl]] == 3
badk[z] <- rlin[cdr[gc]] * 16 + 8   for (gc) in 0 .. ngcz[0] for (z) in 0 .. 0
      if cdsr[gc] == 5 if fdlat[cdcf[gc]] == 3
badk[z] <- rlin[cdr[gc]] * 16 + 8   for (gc) in 0 .. ngcz[0] for (z) in 0 .. 0
      if cdsr[gc] >= 2 if cdsr[gc] <= 3 if fdlat[cdcf[gc]] == 3
# **育っていく場を座標に使ってはいけない**（気づき24 / 気づき38）。
# 比較のガードを一枚置いて閉じてから引く。
field fwbz : max bound 2048                   # 閉じた幅（座標に使えるのはこちら）
fwbz[f] <- fwb[f]                   for (f) in 0 .. nflz[0] if fwb[f] >= 1
field fscb : max bound 2048                   # 場 f を差すときの倍率ビット
fscb[f] <- wbits[fwbz[f]]           for (f) in 0 .. nflz[0]
field fsz8 : max bound 2048                   # 升目の数（バイト）
fsz8[f] <- fsz[f] * fwbz[f]         for (f) in 0 .. nflz[0]

# ── 幅 → 形。**場所は「この場の升を読め」としか言わない。** ────────
field fmrd : max bound 16                     # 幅 → rax に読む
fmrd[1] <- 175
fmrd[8] <- 40
field fmrs : max bound 16                     # 幅 → rsi に読む
fmrs[1] <- 176
fmrs[8] <- 81
field fmc1 : max bound 16                     # 幅 → 升は 1 か
fmc1[1] <- 177
fmc1[8] <- 43
field fms1 : max bound 16                     # 幅 → 升に 1 を入れる
fms1[1] <- 178
fms1[8] <- 44
field fmsw : max bound 16                     # 幅 → 種の書き込み
fmsw[1] <- 179
fmsw[8] <- 51
field frd : max bound 2048                    # 場 f を rax に読む形
frd[f] <- fmrd[fwbz[f]]             for (f) in 0 .. nflz[0] if not fxr[f]
frd[f] <- 201                       for (f) in 0 .. nflz[0] if fxr[f] if not fxm[f]
frd[f] <- 202                       for (f) in 0 .. nflz[0] if fxm[f]
field frs : max bound 2048                    # 場 f を rsi に読む形
frs[f] <- fmrs[fwbz[f]]             for (f) in 0 .. nflz[0] if not fxr[f]
frs[f] <- 203                       for (f) in 0 .. nflz[0] if fxr[f] if not fxm[f]
frs[f] <- 204                       for (f) in 0 .. nflz[0] if fxm[f]
field fc1 : max bound 2048                    # 場 f の升は 1 か
fc1[f] <- fmc1[fwbz[f]]             for (f) in 0 .. nflz[0]
field fs1 : max bound 2048                    # 場 f の升に 1 を入れる
fs1[f] <- fms1[fwbz[f]]             for (f) in 0 .. nflz[0]
field fsw : max bound 2048                    # 場 f への種の書き込み
fsw[f] <- fmsw[fwbz[f]]             for (f) in 0 .. nflz[0] if not fxr[f]
fsw[f] <- 18                        for (f) in 0 .. nflz[0] if fxr[f] if not fxm[f]
fsw[f] <- 16                        for (f) in 0 .. nflz[0] if fxm[f]
field fcr : max bound 2048                    # 場 f を座標として r9 に読む形
fcr[f] <- 100                       for (f) in 0 .. nflz[0] if not fxr[f]
fcr[f] <- 205                       for (f) in 0 .. nflz[0] if fxr[f] if not fxm[f]
fcr[f] <- 206                       for (f) in 0 .. nflz[0] if fxm[f]
field fjr : max bound 2048                    # 場 f の今の値を rsi に読む形（join。rdx で引く）
fjr[f] <- 65                        for (f) in 0 .. nflz[0] if not fxr[f]
fjr[f] <- 87                        for (f) in 0 .. nflz[0] if fxr[f] if not fxm[f]
fjr[f] <- 11                        for (f) in 0 .. nflz[0] if fxm[f]
field fjw : max bound 2048                    # 場 f へ rax を書く形（join。rdx で引く）
fjw[f] <- 42                        for (f) in 0 .. nflz[0] if not fxr[f]
fjw[f] <- 207                       for (f) in 0 .. nflz[0] if fxr[f] if not fxm[f]
fjw[f] <- 164                       for (f) in 0 .. nflz[0] if fxm[f]
field fer : max bound 2048                    # 場 f を描くために rax に読む形（rcx で引く）
fer[f] <- 125                       for (f) in 0 .. nflz[0] if not fxr[f]
fer[f] <- 30                        for (f) in 0 .. nflz[0] if fxr[f] if not fxm[f]
fer[f] <- 23                        for (f) in 0 .. nflz[0] if fxm[f]
field foff : max bound 2048                   # 場 f の先頭（F の先頭からのずれ）
foff[0] <- 0
foff[f] <- foff[f-1] + fsz8[f-1]    for (f) in 0 .. nflz[0] if f > 0
field ftot : max bound 1                    # 場ぜんぶの大きさ（値の側）
ftot[0] <- 0                         # 場が一つも無ければ 0（⊥ だと後ろの番地がみな ⊥）
ftot[z] <- foff[f] + fsz8[f]         for (f) in 0 .. nflz[0] for (z) in 0 .. 0

# ── **階数の升は 4 バイトである。** 値は 8 バイト要る（⊥ が 2^31、
#    束によっては負も取る）が、階数は **周回の番号**で、層の数より小さい。
#    8 バイト取っていたのは「値と同じにしておけば座標の作り方が一つで済む」
#    からで、**性質ではなく都合**だった。置き場の三分の一がそれで消えていた。
#
#    x86 の SIB は倍率 1/2/4/8 を持っているので、倍率を 8 から 4 にし、
#    REX.W を落として 32 ビットで読み書きするだけでよい ——
#    **命令の長さは一バイトも変わらない**（形の表も番地の鎖も動かない）。
field kwb : max bound 1                     # **階数の升の幅（バイト）——一箇所**
kwb[0] <- 4
# 倍率ビットは輪の外で一度だけ引く。輪の中で `wbits[kwb[0]]` と書くと
# 座標が輪の変数に依らない読みになり、断片は寸法を出せない（理由8）——
# **引いてから配る**。
field kscb : max bound 1                    # 階数を差すときの倍率ビット
kscb[z] <- kscb[0]   for (z) in 0 .. 0
# ずれは `foff / 2` と書いていた。これは **値も階数も幅が一律**だから
# 成り立っていた式で、束ごとに幅が変われば成り立たない。階数は階数の
# 鎖を持つ —— 幅は `kwb` の一箇所から出る。
field ksz : max bound 2048                  # 場 f の階数の大きさ（バイト）
ksz[f] <- fsz[f] * kwb[0]           for (f) in 0 .. nflz[0]
field koff : max bound 2048                 # 場 f の階数の先頭（K の先頭からのずれ）
koff[0] <- 0
koff[f] <- koff[f-1] + ksz[f-1]     for (f) in 0 .. nflz[0] if f > 0
field ktot : max bound 1                    # 階数ぜんぶの大きさ
ktot[0] <- 0
ktot[z] <- koff[f] + ksz[f]         for (f) in 0 .. nflz[0] for (z) in 0 .. 0
field ftot2 : max bound 1                   # 場の置き場（値 F と 階数 K）
ftot2[0] <- ftot[0] + ktot[0]   for (z) in 0 .. 0
field kbase : max bound 1
kbase[0] <- fbase[0] + ftot[0]   for (z) in 0 .. 0
field rbuf : max bound 1                    # 生バイトの置き場（地上と表の印の後ろ）
rbuf[0] <- dbase[0] + dgap[0] + ft2[0]   for (z) in 0 .. 0

# 集約の「一度だけ撃つ印」。規則ごとに表と同じ広さ。**規則番号に沿った鎖。**
field fsz2 : max bound 16384                    # この規則の印の場の大きさ
fsz2[r] <- 0                        for (r) in 0 .. nrlz[0]
fsz2[r] <- dcap[0]                   for (r) in 0 .. nrlz[0] if atab[r]
field foff2 : max bound 16384
foff2[0] <- 0
foff2[r] <- foff2[r-1] + fsz2[r-1]  for (r) in 0 .. nrlz[0] if r > 0
field ft2 : max bound 1
ft2[z] <- foff2[r] + fsz2[r]         for (r) in 0 .. nrlz[0] for (z) in 0 .. 0
ft2[0] <- 0
# 表の印の rcx からの変位（rcx は地上の行を指す。印は地上のすぐ後ろ）
field fdsp : max bound 16384
fdsp[r] <- dgap[0] + foff2[r]   for (r) in 0 .. nrlz[0]


# **即値は 2^32 だけ持ち上げて持つ。** 焼いた機械語は「無い」を値で見分ける
# ので、⊥ そのもの（max なら -2147483647）を値として置くと ⊥ と区別できない
# —— 自分を焼くときだけ起きる（生成器の値は ⊥ の定数そのものだから）。
# 2^32 を足しても **バイトは一つも変わらない**（256 で割った余りも、
# 256 で割った商の余りも、2^32 は素通りする）ので、戻す必要が無い。
# 下げてはいけない: max の場は自分の ⊥ より小さい値を持てない（join が撥ねる）。
field bias : max bound 1                    # 2^32（32bit の即値には収まらないので二度足す）
bias[z] <- 2147483647 + 2147483647 + 2      for (z) in 0 .. 0
# ── 束ごとの ⊥ ──────────────────────────────────────────────────
field fbot : max bound 2048
fbot[f] <- 2147483647 + bias[0]     for (f) in 0 .. nflz[0] if fdlat[f] == 1
fbot[f] <- 0 - 2147483647 + bias[0] for (f) in 0 .. nflz[0] if fdlat[f] == 2
fbot[f] <- bias[0]                  for (f) in 0 .. nflz[0] if fdlat[f] == 3
fbot[f] <- 2147483647 + bias[0]     for (f) in 0 .. nflz[0] if fdlat[f] == 6   # flat
fbot[f] <- bias[0]                  for (f) in 0 .. nflz[0] if fdlat[f] == 8   # sum
fbot[f] <- bias[0]                  for (f) in 0 .. nflz[0] if fdlat[f] == 9   # count
# flat の ⊤。⊥ の一つ下の番地に住まわせる（値の帯とぶつからない約束は試験が守る）
field ftop : max bound 1
ftop[z] <- 2147483646 + bias[0]   for (z) in 0 .. 0
# **数の場の ⊤ は、束の順の端に置く**（14v）。min / max の束の順は数の順そのものなので、⊤（どの値より上）
# は max では数の上の端、min では下の端である —— 端に置けば join（大きい方 / 小さい方を取る）が **そのまま
# ⊤ を吸収する**（join の命令は一つも変わらない）。端は機械の整数の端（0x7fff…ffff と 0x8000…0000）に取る:
# 32 ビットの即値に置ける所（flat の印の 2147483646）に置くと、印より向こうの値を全部失う（焼き手自身が
# 2^32 を越える値を max の場に持つ）。64 ビットの印は即値に入らないので、場の下の二升に置いて升と比べる
# （[rbx-200] に max の ⊤、[rbx-208] に min の ⊤。起動のとき五命令で置く —— ⊤ を運ぶ数の場がある本だけ）。
# count は ⊤ を持たない（定義は ⊤ の寄与も一つと数える —— 値を見ない束）。
field ftpf : max bound 2048                  # 場 f の ⊤ の印（flat は即値、min / max は升の変位）
ftpf[f] <- 2147483646 + bias[0]     for (f) in 0 .. nflz[0] if fdlat[f] == 6
ftpf[f] <- bias[0] - 200            for (f) in 0 .. nflz[0] if fdlat[f] == 2
ftpf[f] <- bias[0] - 208            for (f) in 0 .. nflz[0] if fdlat[f] == 1
ftpf[f] <- 1 + bias[0]              for (f) in 0 .. nflz[0] if fdlat[f] == 9
ftpf[f] <- bias[0] - 208            for (f) in 0 .. nflz[0] if fdlat[f] == 8   # sum の ⊤ も 0x8000…0000（join が吸収を見る）
field ftcs : max bound 2048                  # rsi を場 f の ⊤ の印と比べる形
ftcs[f] <- 66                       for (f) in 0 .. nflz[0] if fdlat[f] == 6   # cmp rsi, imm32
ftcs[f] <- 245                      for (f) in 0 .. nflz[0] if fdlat[f] == 1   # cmp rsi, [rbx+d32]
ftcs[f] <- 245                      for (f) in 0 .. nflz[0] if fdlat[f] == 2
ftcs[f] <- 245                      for (f) in 0 .. nflz[0] if fdlat[f] == 8
field ftca : max bound 2048                  # rax を場 f の ⊤ の印と比べる形
ftca[f] <- 12                       for (f) in 0 .. nflz[0] if fdlat[f] == 6   # cmp rax, imm32
ftca[f] <- 214                      for (f) in 0 .. nflz[0] if fdlat[f] == 1   # cmp rax, [rbx+d32]
ftca[f] <- 214                      for (f) in 0 .. nflz[0] if fdlat[f] == 2
ftca[f] <- 214                      for (f) in 0 .. nflz[0] if fdlat[f] == 8
field ftlm : max bound 2048                  # rax に場 f の ⊤ の印を置く形
ftlm[f] <- 2                        for (f) in 0 .. nflz[0] if fdlat[f] == 6   # mov rax, imm32
ftlm[f] <- 159                      for (f) in 0 .. nflz[0] if fdlat[f] == 1   # mov rax, [rbx+d32]
ftlm[f] <- 159                      for (f) in 0 .. nflz[0] if fdlat[f] == 2
ftlm[f] <- 2                        for (f) in 0 .. nflz[0] if fdlat[f] == 9
ftlm[f] <- 159                      for (f) in 0 .. nflz[0] if fdlat[f] == 8

# 規則が読む場の ⊥（読み場と書き場は同じ束の族とする）
      for (r) in 0 .. nrlz[0]

# ── 入力の寸法 ──────────────────────────────────────────────────
field nfld : max bound 1
nfld[z] <- f + 1                     for (f) in 0 .. nflz[0] for (z) in 0 .. 0
# **⊥ が 0 の束は、埋めなくてよい。** `or` も `sum` も `count` も ⊥ は 0 で、
# 記憶は最初から 0 である（BSS）。埋めていたのは「束が何を ⊥ と呼ぶか」を
# 見ていなかったからで、6400万升のうち **44% は書く前から正しかった** ——
# 227MB を触らずに済む（触らなければ頁も要らない）。**表現は束が決める。**
field nofill : or bound 2048                # ⊥ が 0 の束（or / sum / count）
nofill[f] <- true                   for (f) in 0 .. nflz[0] if fdlat[f] == 3
nofill[f] <- true                   for (f) in 0 .. nflz[0] if fdlat[f] == 8
nofill[f] <- true                   for (f) in 0 .. nflz[0] if fdlat[f] == 9
# **升の無い場（`bound 0`）は埋めない。** 埋める六命令は「書いてから比べる」輪なので、升が 0 でも
# 一升書く —— 場が置き場の最後にあると、その一升は地図の外で SIGSEGV（mutate が撒いて見つけた。
# 09-23 以前から在った穴）。書き込みは広さの見張りが止める（終了コード 6）ので、升が無くても答えは言える。
nofill[f] <- true                   for (f) in 0 .. nflz[0] if fsz[f] == 0
# **大きい min / max / flat の場は ⊥ を 0 に置く**（升に v xor ⊥）。⊥ が 0 でない束は、
# 使うかもしれない升を全部先に塗っていた —— 入力に依らない仕事で、焼き手自身が 6 行の本を
# 焼くだけで 722 MB を触っていた。xor なら記憶の 0 がそのまま ⊥ になり、塗る仕事が
# 「触った頁だけ」に縮む。**小さい場は塗る方が符号が短い**ので閾で分ける。
# 区間の上端に読まれる場は升と直に比べる（`cmp rcx,[上端]`）ので、置き方を替えない。
field zxlb : or bound 2048                  # 区間の上端に読まれる場
zxlb[lpbf[gl]] <- true   for (gl) in 0 .. nglz[0] if lpk[gl] == 2
zxlb[lplf[gl]] <- true   for (gl) in 0 .. nglz[0] if lplk[gl] == 1    # 下端の升も直に読む（13i）
field fxr : or bound 2048                   # 場 f は ⊥ を 0 に置く
fxr[f] <- true   for (f) in 0 .. nflz[0] if fdlat[f] == 1 if fsz[f] >= 16384 if not zxlb[f]
fxr[f] <- true   for (f) in 0 .. nflz[0] if fdlat[f] == 6 if fsz[f] >= 16384 if not zxlb[f]
field fxm : or bound 2048                   # そのうち max（鍵は [rbx-56]）
fxm[f] <- true   for (f) in 0 .. nflz[0] if fdlat[f] == 2 if fsz[f] >= 16384 if not zxlb[f]
fxr[f] <- true   for (f) in 0 .. nflz[0] if fxm[f]
nofill[f] <- true                   for (f) in 0 .. nflz[0] if fxr[f]
field nfld6 : max bound 1                   # ⊥ 埋めの命令数（埋める場だけ）
nfld6[0] <- 0
# 種が一つも無いプログラムは番兵を置く（表の字句が空を書けないため）。
# **番兵の場番号は「場の数」である** —— 63 と決め打っていたら、場が 63 を
# 超えたプログラムで **本物の種が黙って落ちた**（neg が 0 升になった）。
# 上限は数えて言う: `fd < nfld[]` は源が宣言した場の数がそのまま言う。
field nseed : max bound 1
nseed[0] <- 0
nseed[z] <- s + 1                    for (s) in 0 .. nsdz[0] for (z) in 0 .. 0 if sdf[s] < nfld[0]
field nsee3 : max bound 1                   # 種の命令数
nsee3[0] <- nseed[0] * 3   for (z) in 0 .. 0
field nrule : max bound 1
nrule[z] <- r + 1
      for (r) in 0 .. nrlz[0] for (z) in 0 .. 0

# ── 命令の割り当て ────────────────────────────────────────────────
#   0..14               argv[1] を開く（開けなければ終了コード 8）
#   15..16              rbx = F、r10 = K
#   17..40              標準入力を読む（読めなければ 8、置き場より大きければ 6。
#                       終わりを [rbx-8] に置く）
#   41..48 / 41..53     語の列なら行の途中で切れていないか（切れていれば 8）/
#                       生バイトなら (位置, 文字) の表に開く
#   pb-1                r15 = 1（周回番号）
#   pb+6f ..            場 f を ⊥ で埋める（6 命令。⊥ は束が決める）
#   sb0 + 3s ..         種（値と、階数 1）
#   層 st ごとに:  頭 xor r8,r8 → 本体たち → test r8,r8 / jne → 頭
#   E ..                場と階数を書き出して終わる
field sb0 : max bound 1
sb0[0] <- pb[0] + nfld6[0]   for (z) in 0 .. 0
field sbase : max bound 1
sbase[0] <- sb0[0] + nsee3[0]   for (z) in 0 .. 0

# ── ガードは表である。**列ではなく行**（種を足すのに列は要らない）────
#   種1 数値 `if 列 == 値`          3 命令
#   種2 否定 `if not f[C]`          4 + 2*次数   （前の層が閉じている＝健全）
#   種3 比較の左辺 `f[A]`           4 + 2*次数   （値 1 が ==、2 が !=）
#   種4 比較の右辺 `g[B]` と比較     6 + 2*次数
# 一つの規則にいくつでも並ぶ。長さも位置も **ガード番号に沿った前置きの鎖**
# —— 命令番号・番地・場の置き場・印の置き場に続いて、これで六度目である。
# **知らない種は 15 である。** 源（33_self）は「辺が式」を 15 と印して
# 「焼けない」と言わせるつもりだった。だが下の振り分けが `>= 10` と
# `>= 7` で開いていたので、**番兵の方が大きいせいで番兵が拾われた** ——
# 焼けないはずの形が、場の番号 ⊥（= 0）を読む命令になって segfault した。
# 上限は **超えたときを試すまで上限ではない**（気づき44）。
# だから振り分けは閉じる。閉じる数は **一枚の場に一度だけ**書く（気づき34）。
field gknown : or bound 16384                   # この種は生成器が出せる
gknown[gg] <- true               for (gg) in 0 .. nggz[0] if gdk[gg] >= 1 if gdk[gg] <= 11

field glen : max bound 16384
glen[gg] <- 3                    for (gg) in 0 .. nggz[0] if gdk[gg] == 1
glen[gg] <- 3                    for (gg) in 0 .. nggz[0] if gdk[gg] == 5
glen[gg] <- 3                    for (gg) in 0 .. nggz[0] if gdk[gg] == 6
glen[gg] <- ctot[gdoo[gg]] + 5      for (gg) in 0 .. nggz[0] if gdk[gg] == 7
glen[gg] <- ctot[gdoo[gg]] + 5      for (gg) in 0 .. nggz[0] if gdk[gg] == 8
glen[gg] <- ctot[gdoo[gg]] + 7      for (gg) in 0 .. nggz[0] if gdk[gg] == 9
glen[gg] <- ctot[gdoo[gg]] + 5      for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
glen[gg] <- ctot[gdoo[gg]] + 5      for (gg) in 0 .. nggz[0] if gdk[gg] == 2
glen[gg] <- ctot[gdoo[gg]] + 5 + gxl[gg]   for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
glen[gg] <- ctot[gdoo[gg]] + 7 + gxr[gg] + gxp[gg]   for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
glen[gg] <- 1                    for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] >= 1
glen[gg] <- 3 + gxp[gg]          for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] >= 1
# **比較は ⊤ で立つ**（13e）。左辺が ⊤ になりうる場の読みなら、⊥ の検査のあとで「⊤ か」を旗に
# 置く（sete —— 立てるのも下ろすのも一命令）。右辺がそうなら ⊤ で立つ方へ飛ぶ。印は読む場の印
# （flat は即値、数の場は升の端の印 —— 14v）。
# 右辺は左辺の旗も見る（左辺が ⊤ でも右辺の ⊥ は見てから —— ⊥ は比べられない）。
# 比較の二行は隣り合う（左辺が gg - 1、右辺が gg。fold.lx の `gbt[t]` と `gbt[t] + 1`）。
field gtl : or bound 16384                      # 比較の左辺は ⊤ になりうる場の読み
gtl[gg] <- true   for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0 if ftc[gdf[gg]]
field gtr : or bound 16384                      # 比較の右辺は ⊤ になりうる場の読み
gtr[gg] <- true   for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0 if ftc[gdf[gg]]
field gtp : or bound 16384                      # 比較の右辺で、左辺が flat の場の読み
gtp[gg] <- true   for (gg) in 1 .. nggz[0] if gdk[gg] == 4 if gtl[gg-1]
field gxl : max bound 16384
gxl[gg] <- 0      for (gg) in 0 .. nggz[0] if not gtl[gg]
gxl[gg] <- 2      for (gg) in 0 .. nggz[0] if gtl[gg]
field gxr : max bound 16384
gxr[gg] <- 0      for (gg) in 0 .. nggz[0] if not gtr[gg]
gxr[gg] <- 2      for (gg) in 0 .. nggz[0] if gtr[gg]
field gxp : max bound 16384
gxp[gg] <- 0      for (gg) in 0 .. nggz[0] if not gtp[gg]
gxp[gg] <- 2      for (gg) in 0 .. nggz[0] if gtp[gg]

field goff : max bound 16384                    # 規則 r の中でのガード g の始まり
goff[gg] <- 0            for (gg) in 0 .. nggz[0]
goff[gg] <- goff[gg-1] + glen[gg-1]   for (gg) in 0 .. nggz[0] if gdi[gg] > 0

field gpos : max bound 16384                    # ガード gg の命令の位置（**一次元**）
gpos[gg] <- bb[gdr[gg]] + goff[gg] for (gg) in 0 .. nggz[0]
field gof : max bound 16384                     # 前置き全体（ガードが無ければ 0）
gof[r] <- 0               for (r) in 0 .. nrlz[0]
gof[gdr[gg]] <- goff[gg] + glen[gg]   for (gg) in 0 .. nggz[0]

field wof : max bound 16384
wof[r] <- ctot[rroo[r]] + 2   for (r) in 0 .. nrlz[0]

# ── ループも表である。**入れ子も行になる** ────────────────────────────
# lop (規則, 番号, 種, 下端, 上端, 表の次数)  種 0 = 表の行 / 1 = 区間
#   番号 0 が外側（rcx）、1 が内側（r13）。対を並べるのに要る ——
#   Lattix の記号表は「引く」のではなく「比べる」から、対を数える手段が要った。
field gnl : max bound 16384                      # 規則のループの数
gnl[lpr[gl]] <- lpi[gl] + 1                      for (gl) in 0 .. nglz[0]
# ══ 融合 —— **同じ反復空間の規則は一つのループで回す** ═══════════════
# 分かれた鎖が遅かった。`cnum[t] <- cnum[t-1]` は三本の規則に割れていて、
# 一本ずつ表を丸ごと走るので **一周につき一区間しか進まない**（16,000周）。
# 一つのループの中に本体を並べれば、行 t で t-1 が既に確定しているので
# **一周で終わる**。合法性の証明は要らない —— 答えは最小不動点であって
# 順序に依らない。C はこれを「融合してよいか」から証明しなければならない。
#
#   群 = 隣り合う / 同じ層 / 一重の表ループ / 同じ列数
#   [検査（群ぜんぶの読み）][ループの頭][本体1][本体2]…[本体k][進め]
#
field l0k : max bound 16384                     # 段0 のループの種
l0k[lpr[gl]] <- lpk[gl]             for (gl) in 0 .. nglz[0] if lpi[gl] == 0
field l0a : max bound 16384                     # 段0 の列数（表なら行の幅）
l0a[lpr[gl]] <- lpar[gl]            for (gl) in 0 .. nglz[0] if lpi[gl] == 0
field l0lo : max bound 16384                    # 段0 の下端（区間）
l0lo[lpr[gl]] <- lplo[gl]           for (gl) in 0 .. nglz[0] if lpi[gl] == 0
field l0hi : max bound 16384                    # 段0 の上端（定数のとき）
l0hi[lpr[gl]] <- lphi[gl]           for (gl) in 0 .. nglz[0] if lpi[gl] == 0
field l0bf : max bound 16384                    # 段0 の上端の場（種2 のとき）
l0bf[lpr[gl]] <- lpbf[gl]           for (gl) in 0 .. nglz[0] if lpi[gl] == 0
field l0bc : max bound 16384                    # その座標
l0bc[lpr[gl]] <- lpbc[gl]           for (gl) in 0 .. nglz[0] if lpi[gl] == 0
field l0lk : max bound 16384                    # 段0 の下端の種（13i。下端が場の区間は、同じ升を読むときだけ同じ空間）
l0lk[lpr[gl]] <- lplk[gl]           for (gl) in 0 .. nglz[0] if lpi[gl] == 0
field l0lf : max bound 16384                    # その場
l0lf[lpr[gl]] <- lplf[gl]           for (gl) in 0 .. nglz[0] if lpi[gl] == 0
field l0lc : max bound 16384                    # その座標
l0lc[lpr[gl]] <- lplc[gl]           for (gl) in 0 .. nglz[0] if lpi[gl] == 0
# **同じ反復空間か** —— 種・列数・下端・上端・上端の場と座標・下端の種と場と座標が全部同じなら、
# 二つの規則は同じ行を同じ順に歩く。表でも区間でも同じ判定でよい。
field nofus : or bound 16384                    # 規則 r は群の先頭（前と融合しない）
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r == 0
nofus[r+1] <- true                  for (r) in 0 .. nrlz[0] if r == nrlz[0]
# **多重のループは、軸の群の中でだけ段0 を融合する**（14n）。群の頭が段0 の頭を、群の尻尾が段0 の進めを
# 持ち、規則ごとの内側の段は自分の頭と進めを持つ: [段0 の頭][内の頭 本体1 内の進め][内の頭 本体2 内の進め]…[段0 の進め]。
# 切り口 n の中は規則の順に全部回る —— 軸の群は n を昇りながら、各 n で群の規則を一つずつ最後まで回す
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if gnl[r] != 1 if not rax[r]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if gnl[r-1] != 1 if not rax[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if gnl[r] != 1 if not rax[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if gnl[r-1] != 1 if not rax[r]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if gnl[r] != 1 if raxf[r] != raxf[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if gnl[r-1] != 1 if raxf[r] != raxf[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if rrst[r] != rrst[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if l0k[r] != l0k[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if l0a[r] != l0a[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if l0lo[r] != l0lo[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if l0hi[r] != l0hi[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if l0bf[r] != l0bf[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if l0bc[r] != l0bc[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if l0lk[r] != l0lk[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if l0lf[r] != l0lf[r-1]
nofus[r] <- true                    for (r) in 0 .. nrlz[0] if r > 0 if l0lc[r] != l0lc[r-1]
# **軸に沿って成層した規則は、必ず融合する**（14l）。前段は「融合が必ず起きる形」だけに輪を許した
# （33_self の「軸に沿った成層」）が、融合の条件はここにある —— 同じ場の軸の規則が隣り合いながら
# 融合しなかったら、非単調な読みが途中の値を読む。黙って間違える代わりに断る（理由 7）
badk[z] <- rlin[r] * 16 + 7   for (r) in 1 .. nrlz[0] for (z) in 0 .. 0 if rax[r] if rax[r-1]
      if raxf[r] == raxf[r-1] if nofus[r]

# **空の区間は一度も回らない。** 焼いた側のループは do-while だったので、
# `for (k) in 1 .. 0` が本体を一度実行していた（解釈実行は実行しない）。
# 頭で一度比べれば済む —— ループごとに二命令、入口で一度だけ。
# 上端が ⊥ の場でも正しく回らなくなる（⊥ は下端より小さい）。
field gnlh : max bound 16384                    # ループの頭（一段につき八命令、段 3 からは九命令）
# **段 3 からの計数器は升に住む**ので、頭が一命令（升に置く）、進めが一命令（升から読む）長い。
# 伸びた分は `max(0, 段数 - 3)`。**join の max で書いてはいけない** —— 0 と「段数 - 3」を
# 二本で書くと途中の値が残り、下の引き算（`rend - gnl3`）が途中の値を拾う（気づき38）。
# 比べて二つに分ければ、場は一度しか書かれない。
field gnlx : max bound 16384                    # 升に住む計数器の数
gnlx[r] <- 0                        for (r) in 0 .. nrlz[0] if gnl[r] <= 3
gnlx[r] <- gnl[r] - 3               for (r) in 0 .. nrlz[0] if gnl[r] >= 4
gnlh[r] <- 0                        for (r) in 0 .. nrlz[0]
gnlh[lpr[gl]] <- lpi8[gl] + lph[gl]   for (gl) in 0 .. nglz[0]     # 最後のループの頭の終わり
field gnl4 : max bound 16384                    # ループの前置き（頭は群の先頭 / 進めは群の末尾）
# 頭（一段八命令）は群の先頭に、進め（一段三命令）は群の末尾に在る。前は頭と進めが同じ
# 三命令だったので `gnlh * 2` と書けた —— 頭が伸びた日に、それは「たまたま同じ」だった。
gnl4[r] <- 0                        for (r) in 0 .. nrlz[0]
gnl4[r] <- gnlh[r] + gnl3[r] + cpre[r]   for (r) in 0 .. nrlz[0] if nofus[r]
# **切り口を動かなくなるまで回す**（14q。33_self の sxcy）。群の頭の段0 の頭のすぐ後ろに前置き六命令、群の尻尾の
# 段0 の進めのすぐ前に後置き九命令を置く:
#   前置き  mov rax, 0 / test r8, r8 / je +1 / mov rax, 1 / mov [升], rax     （外の「動いた」を升に写す）
#   again:  xor r8, r8                                                          （この切り口の一周）
#   …群の規則（内の段ごと）…
#   後置き  test r8, r8 / je done / mov rax, 1 / mov [升], rax / jmp again      （動いたらもう一周）
#   done:   mov rax, [升] / test rax, rax / je +1 / mov r8d, 1                   （外へ「動いた」を返す）
# 升は場の下の余白の `[rbx-192]`（-184 は下端の升）。r8 は周回の「動いた」旗なので、切り口の中で借りたら返す
field cpre : max bound 16384                    # 群の頭の前置き（六命令）
cpre[r] <- 0                        for (r) in 0 .. nrlz[0]
cpre[r] <- 6                        for (r) in 0 .. nrlz[0] if nofus[r] if raxc[r]
field csuf : max bound 16384                    # 群の尻尾の後置き（九命令）
csuf[r] <- 0                        for (r) in 0 .. nrlz[0]
csuf[r] <- 9                        for (r) in 0 .. nrlz[0] if nofus[r+1] if raxc[r]
field cslt : max bound 1                        # その升の即値（bias 込み）
cslt[z] <- bias[0] - 192            for (z) in 0 .. 0
gnl4[r] <- gnl3[r]                  for (r) in 0 .. nrlz[0] if not nofus[r]
gnl4[r] <- gnlh[r] - lph0[r] + gnl3[r]   for (r) in 0 .. nrlz[0] if not nofus[r] if gnl[r] >= 2   # 内の頭だけ（14n）
field lph0 : max bound 16384                    # 段0 の頭の命令数（群の中の規則は段0 の頭を持たない —— 14n）
lph0[lpr[gl]] <- lph[gl]            for (gl) in 0 .. nglz[0] if lpi[gl] == 0
field gnl3 : max bound 16384                    # 進めの分だけ（群の末尾にだけ在る）
gnl3[r] <- 0                        for (r) in 0 .. nrlz[0]
gnl3[r] <- gnl[r] * 3 + gnlx[r] + csuf[r]   for (r) in 0 .. nrlz[0] if nofus[r+1]
gnl3[r] <- gnl[r] * 3 - 3 + gnlx[r]   for (r) in 0 .. nrlz[0] if not nofus[r+1] if gnl[r] >= 2   # 内の進めだけ（14n）
field lrng : or bound 16384                     # 番号 l のループは区間か
lrng[gl] <- true                   for (gl) in 0 .. nglz[0] if lpk[gl] == 1
lrng[gl] <- true                   for (gl) in 0 .. nglz[0] if lpk[gl] >= 2
field lrows : or bound 16384
lrows[gl] <- true                  for (gl) in 0 .. nglz[0] if lpk[gl] == 0

# ── 座標も表である。**次元が行になる** —— 2次元の上限も消えた ────────
# crd (所有者種, 規則, 番号, 次元, 源, 場, 列, ずれ有無, ずれ)
#   所有者種 0 = 項 / 1 = ガード / 2 = 書き先
#   源 0 = 表の列 / 1 = 区間の計数器 / 2 = **場の値**（`f[g[i]]` が書ける）
# 次元 0 を r9 に載せ、次元 1 以降は r12 に畳んでいく（掛けて足す）。
# 源2 は座標が場の値であること —— 名前が座標である、をそのまま機械語にしたもの。
field oflg : max bound 32768                    # スロット gc の所有者が引く場（三段を割る）
oflg[gc] <- ofld[cso[gc]]           for (gc) in 0 .. ngcz[0]
field cdpos : max bound 32768                    # スロット gc の命令の位置（**一次元**）
cdpos[gc] <- cb[cso[gc]] + coff[gc]  for (gc) in 0 .. ngcz[0]

# ── **座標は入れ子になれる**（所有者が所有者を持つ）───────────────────
#  `v[s, rz[s,t]]` の `rz[s,t]` は**二次元の読み**である。源2/3 は内側の
#  次元を一本しか持てなかったので、内側の次元1 が黙って落ち、別の升を読んで
#  いた（`o[p[i,j]]` が o[0]/o[1] にしか書かない）。
#  直し: **内側の読みを一つの所有者にする**。源5 の行は「内側の座標は
#  所有者 <列> が作る」と言い、その所有者の行は普通の crd 行（源 0/1/4）である。
#  入れ子の深さにも次数にも上限が要らない —— 気づき23 の「形を足すのに列を
#  足すな」の三度目。
field isin : or bound 32768                     # 所有者は内側（r9 だけで畳む）
isin[cdcc[gc]] <- true   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
field clen : max bound 32768                    # 次元 d の命令数
# ずれは 0 無し / 1 後置（読んだ値に足す） / 2 前置（読む前に添字を動かす）。
# **前置も後置も三命令**なので、長さは同じ —— 違うのは置く場所だけである。
clen[gc] <- 1   for (gc) in 0 .. ngcz[0] if cdsr[gc] < 2  if cdhf[gc] == 0
clen[gc] <- 4   for (gc) in 0 .. ngcz[0] if cdsr[gc] < 2  if cdhf[gc] >= 1
clen[gc] <- 1   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 4 if cdhf[gc] == 0
clen[gc] <- 4   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 4 if cdhf[gc] >= 1
# 源2/3 は **座標を二つ持つ**（内側の添字と、読んだ値）—— どちらも濾す。下の形を見よ。
# **座標の読みも階数を継ぐ**（二命令: cmp / cmovb）。flat の場は座標に読んでも単調なので、
# 同じ層に居られる —— そのとき証明書は「読んだ升より階数が大きい」を要る（不変条件6）。
clen[gc] <- 9   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3 if cdhf[gc] == 0
clen[gc] <- 12  for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3 if cdhf[gc] == 1
clen[gc] <- 9   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3 if cdhf[gc] == 2
# 源5: 内側の所有者の長さ + 階数二命令 + 読み三命令（読む・⊥ と比べる・⊥ なら抜ける）
clen[gc] <- ctot[cdcc[gc]] + 5   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
# 内側のスロット: 次元0 は載せるだけ、次元1 以降は **畳んで足す**（二命令）。
# 畳んで足す形があるのは源 0 / 1 / 4（列・計数器・定数）だけである。源を問わずに
# 長さを与えていたので、源の無い行（`k[0]` のような定数で引いた読みは源にならない）
# にも長さが付いて「導けた」ことになり、足す命令の抜けた穴を走って落ちていた
# （`h[g[i, k[0]]]`）。源が無ければ長さも無い —— 焼かずに理由 8 と言う。
field inr1 : or bound 32768                     # 内側の所有者の次元1 以降（源 0 / 1 / 4）
inr1[gc] <- true  for (gc) in 0 .. ngcz[0] if isin[cso[gc]] if csd[gc] >= 1 if cdsr[gc] < 2
inr1[gc] <- true  for (gc) in 0 .. ngcz[0] if isin[cso[gc]] if csd[gc] >= 1 if cdsr[gc] == 4
# **畳む前に、その次元だけを広さで濾す。** 前は `imul r9, 広さ / add r9, 源` の二命令で、
# 次元1 を濾していなかった —— `h[g[i, j]]` で j が g の広さを超えると **次の行の升**を
# 読んだ（解釈実行は ⊥）。ずれ（`g[i, j+1]`）も落ちていた。r9 は畳みかけを持っているので
# 升（`cscr`）に逃がし、次元を r9 に作って濾し、xchg で戻して畳む:
#   mov [升], r9 / 源を r9 に / (add r9, ずれ) / cmp r9, 広さ / jae 次の行 /
#   xchg r9, [升] / imul r9, 広さ / add r9, [升]
clen[gc] <- 7   for (gc) in 0 .. ngcz[0] if inr1[gc] if cdhf[gc] == 0
clen[gc] <- 8   for (gc) in 0 .. ngcz[0] if inr1[gc] if cdhf[gc] == 1

# ══ 座標の濾し ════════════════════════════════════════════════════
# **座標は読むまえに広さで濾す。** この検査は長いあいだ `cdhf == 1`
# （ずれがあるとき）にしか出なかった —— 検査が「座標」という **概念**では
# なく「ずれ」という **機能**に紐づいていたからである（気づき34 の裏面:
# 一つの判断を機能の側に置くと、その機能を通らない道から漏れる）。漏れは
# 全部の源にあり、`a[big[i]]` で big が広さを超えると **隣の場の升を読んで
# その数を答えにしていた**（解釈実行は ⊥）。鎖にすると読んだごみが次の
# 座標になって segfault する。`test/meta.py` が見つけた。
#
# 濾すのは **座標を作り終えたスロット**だけ —— 内側の所有者の次元1 以降は
# 桁を上げて足す途中なので出さない。内側でも **次元0 は完成している**ので
# 出す（そこを外すと `f0[f1[f1[i]]]` の真ん中の輪が素通りする）。
field cchk : or bound 32768                     # このスロットは濾しを出す
cchk[gc] <- true  for (gc) in 0 .. ngcz[0] if csd[gc] == 0
cchk[gc] <- true  for (gc) in 0 .. ngcz[0] if not isin[cso[gc]]
cchk[gc] <- true  for (gc) in 0 .. ngcz[0] if cdhf[gc] == 1 if not inr1[gc]
# **長さは足すだけ。引かない。** 上の値を書き換えると、内側の次元1 のように
# 「源の長さ 1・畳みの長さ 2」で max が要る所が壊れる —— 源の側を 3 に
# 上げたら max が 3 を選び、**一命令の穴**が空いて番地の鎖が切れた（segfault）。
# `cdhf == 1` の 4 と 7 には濾しが既に入っているので足さない。
clen[gc] <- 3   for (gc) in 0 .. ngcz[0] if cdsr[gc] < 2  if cdhf[gc] == 0 if cchk[gc]
clen[gc] <- 3   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 4 if cdhf[gc] == 0 if cchk[gc]
clen[gc] <- 11  for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3 if cdhf[gc] == 0
      if cchk[gc]
clen[gc] <- 11  for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3 if cdhf[gc] == 2
      if cchk[gc]
clen[gc] <- ctot[cdcc[gc]] + 7   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5 if cchk[gc]
# 源5 に後置のずれ（`f[g[i, j] + 1]`）があれば、ずれの add がもう一つ要る —— 前は長さが
# 足りず、add が ⊥ の je と同じ位置に重なって（form は max）je が消えていた
clen[gc] <- ctot[cdcc[gc]] + 8   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5 if cdhf[gc] == 1
field coff : max bound 32768                    # 所有者の中での次元 d の始まり
coff[gc] <- 0                 for (gc) in 0 .. ngcz[0]
coff[gc] <- coff[gc-1] + clen[gc-1] + 2   for (gc) in 0 .. ngcz[0] if csd[gc] > 0
      if not isin[cso[gc]]
coff[gc] <- coff[gc-1] + clen[gc-1]       for (gc) in 0 .. ngcz[0] if csd[gc] > 0
      if isin[cso[gc]]
field ctot : max bound 32768                    # 座標ぜんぶ（畳みの命令を含む）
ctot[cso[gc]] <- 0                   for (gc) in 0 .. ngcz[0]
ctot[cso[gc]] <- coff[gc] + clen[gc]   for (gc) in 0 .. ngcz[0] if csd[gc] == 0
ctot[cso[gc]] <- coff[gc] + clen[gc] + 2   for (gc) in 0 .. ngcz[0] if csd[gc] > 0
      if not isin[cso[gc]]
ctot[cso[gc]] <- coff[gc] + clen[gc]       for (gc) in 0 .. ngcz[0] if csd[gc] > 0
      if isin[cso[gc]]

# ── 項も表である。長さも位置も **項番号に沿った前置きの鎖**（七度目）────
# ── 項は **群** に分かれる。掛け算は群の中に閉じる ────────────────
# 焼いた符号は長いあいだ `rax` を累算器にした **左からの畳み**だった ——
# `a + b * c` が `(a+b)*c` になり、解釈実行（`a+(b*c)`）と食い違うので、
# 生成器は「足してから掛ける」形を **断って**いた。断るのは正しかったが、
# 断られる形は `run.lx` の評価器の芯そのものだった（`mu * pa[…] + mo * pa[…]`）。
#
# 群（積の連なり）の **中**では左畳みは正しい。直すのは群の境目だけである:
#
#   群0 を rax に作る  →  `mov [和], rax`
#   群k を rax に作る  →  `add [和], rax`（群の符号が `-` なら `sub`）
#   最後に            →  `mov rax, [和]`
#
# だから「最初の項か」で mov / add を選んでいた所は **「群の先頭か」** になる。
# 引く項（種5/9/11/13）は「引く命令」ではなく **群の符号** になった。
field tmldr : or bound 16384                    # 群の先頭（掛ける項でない）
tmldr[gt] <- true               for (gt) in 0 .. ngtz[0] if not tmul[gt]
field tmgn : max bound 16384                    # 群の番号（規則の中。鎖）
tmgn[gt] <- 0                   for (gt) in 0 .. ngtz[0] if tmi[gt] == 0
tmgn[gt] <- tmgn[gt-1]          for (gt) in 0 .. ngtz[0] if tmi[gt] > 0 if tmul[gt]
tmgn[gt] <- tmgn[gt-1] + 1      for (gt) in 0 .. ngtz[0] if tmi[gt] > 0 if not tmul[gt]
field tmng : max bound 16384                    # 規則の群の数 - 1
tmng[tmr[gt]] <- tmgn[gt]       for (gt) in 0 .. ngtz[0]
field tmend : or bound 16384                    # 群の終わり（次が先頭か、規則の最後）
tmend[gt] <- true               for (gt) in 0 .. ngtz[0] if tmi[gt+1] == 0
tmend[gt] <- true               for (gt) in 0 .. ngtz[0] if not tmul[gt+1]
field tgneg : or bound 16384                    # この群は引く（先頭から鎖で運ぶ）
tgneg[gt] <- true               for (gt) in 0 .. ngtz[0] if tmldr[gt] if tmk[gt] == 5
tgneg[gt] <- true               for (gt) in 0 .. ngtz[0] if tmldr[gt] if tmk[gt] == 9
tgneg[gt] <- true               for (gt) in 0 .. ngtz[0] if tmldr[gt] if tmk[gt] == 11
tgneg[gt] <- true               for (gt) in 0 .. ngtz[0] if tmldr[gt] if tmk[gt] == 13
tgneg[gt] <- tgneg[gt-1]        for (gt) in 0 .. ngtz[0] if tmi[gt] > 0 if tmul[gt]
# 群が一つなら升は要らない（いままでと同じ符号が出る）
field tmx : max bound 16384                     # 項のあとに足す命令の数
tmx[gt] <- 0                    for (gt) in 0 .. ngtz[0]
tmx[gt] <- 1                    for (gt) in 0 .. ngtz[0] if tmend[gt] if tmng[tmr[gt]] >= 1
tmx[gt] <- 2                    for (gt) in 0 .. ngtz[0] if tmend[gt] if tmng[tmr[gt]] >= 1
      if tmgn[gt] >= 1                                     # add/sub [和], rax + jo
tmx[gt] <- 3                    for (gt) in 0 .. ngtz[0] if tmend[gt] if tmng[tmr[gt]] >= 1
      if tmgn[gt] == tmng[tmr[gt]]                         # + mov rax, [和]

# **群0 の符号は置き場が無かった。** 群k（k ≥ 1）の符号は `sub [和], rax` が持つが、群0 は
# `mov [和], rax`（群が一つなら何も無し）なので、引く群が先頭に来ると符号が消えた ——
# `-5` が 5、`-b[0] + 10` が 13、`-2 * b[0]` が 6（解釈実行は -5 / 7 / -6）。種5 の所には
# 「最初の項が引き算になることは無い」と書いてあった。**書いてあっただけで、測っていなかった。**
# 先頭の `-` は **最初の項に掛かる**（解釈実行の単項の `-` は `*` `/` `%` より強い ——
# `-i % 4` は (-i) % 4、`-i / 2` は (-i) / 2。群全体に掛けると `- 1 % 4` が -1 になる）。
# 最初の項が引く項なら、その項の直後に `imul rax, -1` と jo を置く（-2^63 だけが溢れる）。
field tneg0 : or bound 16384                    # 最初の項で、引く項
tneg0[gt] <- true              for (gt) in 0 .. ngtz[0] if tmi[gt] == 0 if tgneg[gt]
field tmn : max bound 16384                     # 群0 の符号の命令数（imul rax,-1 + jo）
tmn[gt] <- 0                   for (gt) in 0 .. ngtz[0]
tmn[gt] <- 2                   for (gt) in 0 .. ngtz[0] if tneg0[gt]
field tml0 : max bound 16384                    # 項そのものの長さ
tml0[gt] <- 1                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 1
tml0[gt] <- 1                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 2
tml0[gt] <- 1                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 4
tml0[gt] <- 1                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 5
tml0[gt] <- 2                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 6    # imul + jo
tml0[gt] <- 1                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 7 if ispw[gt]
tml0[gt] <- 2                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 7 if not ispw[gt]   # mov rsi,d + 割る
tml0[gt] <- 3                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if not ispw[gt]   # mov rsi,d + 余り二つ
tml0[gt] <- 1                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if shf[gt] <= 31
tml0[gt] <- 2                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if shf[gt] >= 32  # shl + shr
tml0[gt] <- 1                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 11
tml0[gt] <- 2                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 12   # imul + jo
tml0[gt] <- 1                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 13
tml0[gt] <- 2                  for (gt) in 0 .. ngtz[0] if tmk[gt] == 14   # imul + jo
tml0[gt] <- ctot[tmoo[gt]] + 6 + tvk[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 3
tml0[gt] <- ctot[tmoo[gt]] + 6 + tvk[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 9
tml0[gt] <- ctot[tmoo[gt]] + 7 + tvk[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 10   # imul + jo
# 種15 / 16: 読み三つ・見張り・割る数の 0 の検査（tzl）・割る二つ / 余り三つ・階数二つ
tml0[gt] <- ctot[tmoo[gt]] + 10 + tvk[gt] + tzl[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 15   # -1 の三つ（14j）
tml0[gt] <- ctot[tmoo[gt]] + 9 + tvk[gt] + tzl[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 16    # -1 の一つ（14j）
# 種17〜20: 割る数を rsi へ一つ・0 の検査（tzl）・-1 の検査（商 3 / 余り 1）・割る二つ / 余り三つ（読みではないので階数は無い）
tml0[gt] <- 6 + tzl[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 17
tml0[gt] <- 5 + tzl[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 18
tml0[gt] <- 6 + tzl[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 19
tml0[gt] <- 5 + tzl[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 20
field tmlen : max bound 16384                   # 項ぜんぶ（升の出し入れを含む）
tmlen[gt] <- tml0[gt] + tmn[gt] + tmx[gt]   for (gt) in 0 .. ngtz[0]
field toff : max bound 16384
toff[gt] <- 0                  for (gt) in 0 .. ngtz[0]
toff[gt] <- toff[gt-1] + tmlen[gt-1]   for (gt) in 0 .. ngtz[0] if tmi[gt] > 0
field tof : max bound 16384                     # 項ぜんぶ（＋階数の初期化 1 命令）
tof[r] <- 1                     for (r) in 0 .. nrlz[0]
tof[tmr[gt]] <- toff[gt] + tmlen[gt] + 1 + trs[tmr[gt]]   for (gt) in 0 .. ngtz[0]
field tmc18 : max bound 16384                   # 列のずれ（バイト）
tmc18[gt] <- tmc1[gt] * 8       for (gt) in 0 .. ngtz[0]
field tpos : max bound 16384                    # 項 gt の命令の位置（**一次元**）——
# `form[tb[r] + toff[r,t]]` は「場の読み二つの和」で、座標にはできない。
# 名前を一つ付ければ `form[tpos[gt] + k]` になり、**二段の読み＋定数のずれ**
# になる（自分を焼くには、自分が焼ける形で書く）。
tpos[gt] <- tb[tmr[gt]] + toff[gt]  for (gt) in 0 .. ngtz[0]
field tb : max bound 16384                      # 最初の項の位置
tb[r] <- bb[r] + 1 + gof[r] + trs[r]   for (r) in 0 .. nrlz[0]

# 書き座標の位置。**束の族で分かれない** —— 項が値の差を吸収した
field wpos : max bound 16384
wpos[r] <- bb[r] + gof[r] + tof[r]   for (r) in 0 .. nrlz[0]
field jlen : max bound 16384                    # join の長さ（束が決める唯一の数）
# **値が印と重なったら止まる**（終了コード 4）。焼いた符号は「無い」を値で見分ける ——
# min と flat の ⊥ は 2147483647、max の ⊥ は -2147483647、flat の ⊤ は 2147483646。その値
# そのものを join すると、升は ⊥（や ⊤）に見える。「INT_MAX を無限大に使う」書き方で踏む
# （解釈実行は数として持つ）。join の手前で値と印を比べ、重なれば場の番号を言って止まる。
# **印に届かないと示せた値だけ見張らない。** 印は算術か、よその束の値か、印そのものの
# 定数からしか来ない —— 印でない定数一つ、同じ束の場の素の写し一つ（写し元の升も
# 同じ見張りを通っているので印を持たない。⊥ の読みは手前で抜ける。flat の ⊤ は ⊤
# として運ぶ）なら届かない。min ← max の写しは届く（max は 2147483647 を持てる）。
field rbot : max bound 16384                 # 規則 r の書き先の ⊥ の印（持ち上げた形）
rbot[r] <- fbot[rrwf[r]]   for (r) in 0 .. nrlz[0]
field tmvb : max bound 16384                 # 定数の項の持ち上げた値
tmvb[gt] <- tmv[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 1
field vsafe : or bound 16384                 # 規則 r の値は印に届かない
vsafe[tmr[gt]] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 1 if not tmany[tmr[gt]]
      if tmlt[gt] < 3 if tmvb[gt] != rbot[tmr[gt]]
vsafe[tmr[gt]] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 1 if not tmany[tmr[gt]]
      if tmlt[gt] == 6 if tmvb[gt] != rbot[tmr[gt]] if tmvb[gt] != ftop[0]
vsafe[tmr[gt]] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 3 if not tmany[tmr[gt]]
      if tmfl[gt] == tmlt[gt]
field vchk : max bound 16384                 # 規則 r の値の見張りの命令数
vchk[r] <- 0           for (r) in 0 .. nrlz[0]
vchk[r] <- 2           for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if not vsafe[r]
vchk[r] <- 4           for (r) in 0 .. nrlz[0] if rrlt[r] == 6 if not vsafe[r]
# ⊤ を持つ min / max の場は ⊤ の印（機械の整数の端）とも比べる —— 定数でも写しでも見張る（二命令）
vchk[r] <- 4           for (r) in 0 .. nrlz[0] if rrlt[r] == 1 if ftc[rrwf[r]]
vchk[r] <- 4           for (r) in 0 .. nrlz[0] if rrlt[r] == 2 if ftc[rrwf[r]]
field rxw : or bound 16384                   # 規則 r の書き先は ⊥ を 0 に置く場
rxw[r] <- true    for (r) in 0 .. nrlz[0] if fxr[rrwf[r]]
jlen[r] <- 5 + vchk[r] for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if not rxw[r]
# 置き方を替えた場は升と直に比べられない —— 今の値を rsi に解いてから比べる（一命令増える）
jlen[r] <- 6 + vchk[r] for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if rxw[r]
jlen[r] <- 5    for (r) in 0 .. nrlz[0] if rrlt[r] == 3
jlen[r] <- 11 + vchk[r]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
jlen[r] <- 6 + amx[r] + sxp[r] + sxq[r]   for (r) in 0 .. nrlz[0] if rrlt[r] == 8   # 足す + jo（溢れ）+ ⊤（14v）
jlen[r] <- 6 + amx[r]    for (r) in 0 .. nrlz[0] if rrlt[r] == 9
field jb : max bound 16384                      # join の位置
jb[r] <- wpos[r] + 1 + wof[r] + tvx[r] + vchk[r]   for (r) in 0 .. nrlz[0]

field blen : max bound 16384
blen[r] <- 3 + gnl4[r] + gof[r] + tof[r] + wof[r] + tvx[r] + jlen[r]   for (r) in 0 .. nrlz[0]

# ── 層。**規則の並びが層の昇順である**ことは呼ぶ側の契約 ─────────────
field stf : max bound 16384
stf[r] <- rrst[r]         for (r) in 0 .. nrlz[0]
field fst : max bound 16384                     # この規則が層の先頭か
fst[r] <- 0          for (r) in 0 .. nrlz[0]
fst[r] <- 1          for (r) in 0 .. nrlz[0] if r == 0
fst[r] <- 1          for (r) in 0 .. nrlz[0] if r > 0 if stf[r-1] < rrst[r]
field lst : max bound 16384                     # この規則が層の末尾か
lst[r] <- 0          for (r) in 0 .. nrlz[0]
field lst2 : max bound 16384                    # 層の切れ目（尻尾で五命令）
lst2[r] <- lst[r] * 5               for (r) in 0 .. nrlz[0]
# **ガードの辺は「計数器」か「場の読み」か「定数」である。** `r + 1` は
# そのどれでもない —— 足し算は辺ではない（焼くと `r` だけを見て黙って外れる）。
# 一つ手前の場（nrlz = 規則数 - 1）で言い換えれば、ただの計数器と場になる。
lst[r] <- 1          for (r) in 0 .. nrlz[0] if r == nrlz[0]
lst[r] <- 1          for (r) in 0 .. nrlz[0] if r < nrlz[0] if stf[r+1] > rrst[r]

# 本体の位置。層の頭（1 命令）と尻尾（2 命令）が挟まる
field bp : max bound 16384                      # 規則 r の持ち場の頭
bp[0] <- sbase[0] + 1   for (z) in 0 .. 0
bp[r] <- bp[r-1] + ckl[r-1] + blen[r-1] + lst2[r-1] + fst[r]   for (r) in 0 .. nrlz[0] if r > 0
field ckp : max bound 16384                     # **群の**検査の枠の頭（中の規則も同じ所を指す）
ckp[r] <- bp[r]                     for (r) in 0 .. nrlz[0] if nofus[r]
ckp[r] <- ckp[r-1]                  for (r) in 0 .. nrlz[0] if r > 0 if not nofus[r]
field ckl : max bound 16384                     # 検査の枠の長さ（群の先頭だけが持つ）
field rb : max bound 16384
rb[r] <- bp[r] + ckl[r]   for (r) in 0 .. nrlz[0]
field lhead : max bound 16384                   # 群の先頭のループの頭（飛び戻り先）
lhead[r] <- rb[r]                   for (r) in 0 .. nrlz[0] if nofus[r]
lhead[r] <- lhead[r-1]              for (r) in 0 .. nrlz[0] if r > 0 if not nofus[r]

field hd : max bound 16384                      # この規則の層の頭（xor の位置）
hd[r] <- bp[r] - 1   for (r) in 0 .. nrlz[0] if fst[r] == 1
hd[r] <- hd[r-1]     for (r) in 0 .. nrlz[0] if fst[r] == 0

field av : max bound 16384                      # 「次の行へ」の位置

# 規則の本体の終わり
field rend : max bound 16384
rend[r] <- rb[r] + blen[r]         for (r) in 0 .. nrlz[0]
av[r] <- rend[r] - gnl3[r]   for (r) in 0 .. nrlz[0]
field bb : max bound 16384                      # 本体の始まり（ループの頭のあと）
bb[r] <- rb[r] + gnlh[r] + cpre[r]   for (r) in 0 .. nrlz[0] if nofus[r]
bb[r] <- rb[r]                       for (r) in 0 .. nrlz[0] if not nofus[r]
bb[r] <- rb[r] + gnlh[r] - lph0[r]   for (r) in 0 .. nrlz[0] if not nofus[r] if gnl[r] >= 2
field gend : max bound 16384                    # 群の終わり（飛ばすときの行き先）
gend[r] <- rend[r]                   for (r) in 0 .. nrlz[0] if nofus[r+1]
gend[r] <- gend[r+1]                 for (r) in 0 .. nrlz[0] if not nofus[r+1]

field ebase : max bound 1
ebase[0] <- sbase[0]   for (z) in 0 .. 0
field ebz : max bound 1                     # ebase を計数器で引ける形に
ebz[z] <- ebase[0]                   for (z) in 0 .. 0
ebase[z] <- rend[r] + 5      for (r) in 0 .. nrlz[0] for (z) in 0 .. 0 if lst[r] == 1
field nins : max bound 1
# 何も導けなくても **三命令ぶんは要る**（出口の三命令が入る場所）
# 知らせの八命令が 0..7 に入るので、**八命令ぶんは要る**
nins[z] <- 8                          for (z) in 0 .. 0
field nfl2 : max bound 1                      # 踏み台のぶん（場 × 2。はみ出し・値・溢れで三組）
nfl2[z] <- nfl[0] * 2   for (z) in 0 .. 0
# 127（書き出しと出口）+ 10（入力と書きの踏み台）+ 14（周回の出口）= 151。項は八つまで（理由 3）
nins[0] <- ebase[0] + pklen[0] + dclen[0] + 151 + nfl2[0] + nfl2[0] + nfl2[0] + nfl2[0]   for (z) in 0 .. 0
field ninz : max bound 1                      # nins の一つ手前（区間の上端に書ける形）
ninz[0] <- nins[0] - 1   for (z) in 0 .. 0

field form : max bound 262144
field imm : max bound 262144
field jt : max bound 262144                      # 飛び先（命令番号）。rel は番地から出す

# ── argv[1] を開く（無ければ stdin）──────────────────────────────
# **前置きの命令 0..7 は知らせが上書きする**（`form` は max）。だから
# ここに置く形は全部 156 未満で、bad なら知らせが勝つ。即値を持つのは
# 5（`mov eax,2`）だけで、そこに来る知らせは穴なしの形である。
form[0] <- 53                        # xor ebp,ebp        （fd = 0 = stdin）
form[1] <- 54                        # mov rax,[rsp]      （argc）
form[2] <- 55                        # cmp rax,2
form[3] <- 7                         # jb -> 15           （引数なし）
jt[3]   <- 15
form[4] <- 56                        # mov rdi,[rsp+16]   （argv[1]）
form[5] <- 24                        # mov eax, 2         （sys_open）
imm[5]  <- 2 + bias[0]   for (z) in 0 .. 0
form[6] <- 57                        # xor esi,esi        （O_RDONLY）
form[7] <- 58                        # xor edx,edx        （mode）
form[8] <- 25                        # syscall
form[9] <- 26                        # test rax,rax
form[10] <- 75                       # jg -> 14           （開けた）
jt[10]  <- 14
form[11] <- 156                      # mov eax, 60        （開けなかった）
form[12] <- 38                       # mov edi, 8
imm[12]  <- 8 + bias[0]   for (z) in 0 .. 0
form[13] <- 25                       # syscall            （終了コード 8）
form[14] <- 59                       # mov rbp, rax       （fd を持つ）

# ── 前置き ──────────────────────────────────────────────────────
form[15] <- 1                        # mov rbx, FBASE
imm[15]  <- fbase[0] + bias[0]   for (z) in 0 .. 0
form[16] <- 228                      # lea r10, [rbx + ftot]（K の頭。2 GB を越えうるので即値にしない）
imm[16]  <- ftot[0] + bias[0]   for (z) in 0 .. 0

# 標準入力 → 表。部分読みに耐えるまで回す（パイプは一度で全部くれない）
# **読めないこと・置き場より大きいことを黙らない。** 前は「残り 0 で read を呼ぶ」と
# 0 が返り、それを終わりと読んでいた —— 置き場（生バイトなら rcap）を超える入力は
# **黙って切られ**、数えた答えが 983040 で止まった。read の負（ディレクトリを渡した
# など）も終わりと読み、空の入力として答えていた。
form[17] <- 36                       # mov rsi, 読みの先端
imm[17]  <- dbase[0] + bias[0]                  for (z) in 0 .. 0 if inpw[0] == 8
imm[17]  <- rbuf[0] + bias[0]                   for (z) in 0 .. 0 if inpw[0] == 1
form[18] <- 24                       # mov eax, 0   (sys_read)
# **表を回さない本は読まない。** 表の行を回すループ（lpk 0）が一つも無ければ、読みを飛ばして
# 表の終わり（40）へ —— rsi は読みの先端のままなので、表は空。前は端末で起こすと入力を待って
# 止まった（配る本は、表を使わなくても `table ch = (0,32)` を一つ持つ —— 焼ける形がそれだけなので）。
field tabrd : or bound 1                     # どこかのループが表の行を回す
tabrd[z] <- true   for (gl) in 0 .. nglz[0] for (z) in 0 .. 0 if lpk[gl] == 0
form[18] <- 78   for (z) in 0 .. 0 if not tabrd[z]   # jmp -> 表の終わり
jt[18]   <- 40   for (z) in 0 .. 0 if not tabrd[z]
imm[18]  <- 0 + bias[0]   for (z) in 0 .. 0
form[19] <- 49                       # mov rdi, rbp （引数で開いた口／無ければ 0）
form[20] <- 37                       # mov rdx, 置き場の終わり
imm[20]  <- dbase[0] + dcap[0] + bias[0]         for (z) in 0 .. 0 if inpw[0] == 8
imm[20]  <- rbuf[0] + rcap[0] + bias[0]          for (z) in 0 .. 0 if inpw[0] == 1
form[21] <- 80                       # sub rdx, rsi  （残り）
form[22] <- 13                       # je -> 満ちた（残り 0 で read を呼ばない）
jt[22]   <- 30
form[23] <- 25                       # syscall
form[24] <- 26                       # test rax, rax
form[25] <- 75                       # jg -> 足す
jt[25]   <- 28
form[26] <- 13                       # je -> 読み終わり（0 は終わり）
jt[26]   <- 40
form[27] <- 78                       # jmp -> 開けなかった所（負は読めない。終了コード 8）
jt[27]   <- 11
form[28] <- 76                      # add rsi, rax
form[29] <- 78                      # jmp -> 読みの頭
jt[29]  <- 18
# 満ちた: **もう一バイト読めるなら、置き場より大きい入力である**（終了コード 6）
form[30] <- 24                       # mov eax, 0   (sys_read)
imm[30]  <- 0 + bias[0]   for (z) in 0 .. 0
form[31] <- 49                       # mov rdi, rbp
form[32] <- 36                       # mov rsi, 覗きの升（場の下の余白）
imm[32]  <- fbase[0] - 40 + bias[0]   for (z) in 0 .. 0
form[33] <- 37                       # mov rdx, 1
imm[33]  <- 1 + bias[0]   for (z) in 0 .. 0
form[34] <- 25                       # syscall
form[35] <- 26                       # test rax, rax
form[36] <- 75                       # jg -> 入力の踏み台（大きすぎる）
jt[36]   <- ist[0]   for (z) in 0 .. 0
form[37] <- 13                       # je -> 先端を戻す（ちょうど満ちて終わった）
jt[37]   <- 39
form[38] <- 78                       # jmp -> 開けなかった所（読めない）
jt[38]   <- 11
form[39] <- 36                       # mov rsi, 置き場の終わり
imm[39]  <- dbase[0] + dcap[0] + bias[0]         for (z) in 0 .. 0 if inpw[0] == 8
imm[39]  <- rbuf[0] + rcap[0] + bias[0]          for (z) in 0 .. 0 if inpw[0] == 1
form[40] <- 77                      # mov [rbx-8], rsi   （表の終わり）
form[40] <- 123                     for (z) in 0 .. 0 if inpw[0] == 1   # mov [rbx-16], rsi

# ── 語の列は **行の途中で切れていてはいけない**。前は切れた行を 0 で埋めた一行として
# 読み、`count` が一つ多く、`sum` がごみを足した（行の幅で割り切れるまで引いて見る）
field tbar : max bound 1                    # 表の列数（表を回すループの幅）
tbar[z] <- lpar[gl]                  for (gl) in 0 .. nglz[0] for (z) in 0 .. 0 if lpk[gl] == 0
field rwsz : max bound 1                    # 行の幅（バイト）。表を回さないなら 1（切れても読まない）
rwsz[0] <- 1
rwsz[z] <- tbar[0] * 8               for (z) in 0 .. 0 if tbar[0] >= 1
form[41] <- 85   for (z) in 0 .. 0 if inpw[0] == 8     # mov rax, rsi
form[42] <- 84   for (z) in 0 .. 0 if inpw[0] == 8     # add rax, -DBASE（読んだバイト数）
imm[42]  <- bias[0] - dbase[0]  for (z) in 0 .. 0 if inpw[0] == 8
form[43] <- 26   for (z) in 0 .. 0 if inpw[0] == 8     # test rax, rax
form[44] <- 13   for (z) in 0 .. 0 if inpw[0] == 8     # je -> 通る（空の入力）
jt[44]   <- 49   for (z) in 0 .. 0 if inpw[0] == 8
form[45] <- 84   for (z) in 0 .. 0 if inpw[0] == 8     # add rax, -行の幅
imm[45]  <- bias[0] - rwsz[0]   for (z) in 0 .. 0 if inpw[0] == 8
form[46] <- 75   for (z) in 0 .. 0 if inpw[0] == 8     # jg -> 引く
jt[46]   <- 45   for (z) in 0 .. 0 if inpw[0] == 8
form[47] <- 13   for (z) in 0 .. 0 if inpw[0] == 8     # je -> 通る（割り切れた）
jt[47]   <- 49   for (z) in 0 .. 0 if inpw[0] == 8
form[48] <- 78   for (z) in 0 .. 0 if inpw[0] == 8     # jmp -> 開けなかった所（切れている。終了コード 8）
jt[48]   <- 11   for (z) in 0 .. 0 if inpw[0] == 8

# ── 生バイト → 表（位置, 文字）。**バイト列も座標を持つ** ────────────
form[41] <- 3    for (z) in 0 .. 0 if inpw[0] == 1     # mov rcx, RBUF（読む方）
imm[41]  <- rbuf[0] + bias[0]   for (z) in 0 .. 0 if inpw[0] == 1
form[42] <- 37   for (z) in 0 .. 0 if inpw[0] == 1     # mov rdx, DBASE（書く方）
imm[42]  <- dbase[0] + bias[0]  for (z) in 0 .. 0 if inpw[0] == 1
form[43] <- 117  for (z) in 0 .. 0 if inpw[0] == 1     # xor r9,r9（位置）
form[44] <- 118  for (z) in 0 .. 0 if inpw[0] == 1     # cmp rcx, 生の終わり
form[45] <- 73   for (z) in 0 .. 0 if inpw[0] == 1     # jae -> 展開の終わり
jt[45]   <- 53   for (z) in 0 .. 0 if inpw[0] == 1
form[46] <- 119  for (z) in 0 .. 0 if inpw[0] == 1     # mov [rdx], r9      列0 = 位置
form[47] <- 120  for (z) in 0 .. 0 if inpw[0] == 1     # movzx rax, byte [rcx]
form[48] <- 121  for (z) in 0 .. 0 if inpw[0] == 1     # mov [rdx+8], rax   列1 = 文字
form[49] <- 32   for (z) in 0 .. 0 if inpw[0] == 1     # add r9, 1
form[50] <- 5    for (z) in 0 .. 0 if inpw[0] == 1     # add rcx, 1
imm[50]  <- 1 + bias[0]    for (z) in 0 .. 0 if inpw[0] == 1
form[51] <- 122  for (z) in 0 .. 0 if inpw[0] == 1     # add rdx, 16
form[52] <- 78   for (z) in 0 .. 0 if inpw[0] == 1     # jmp -> 展開の頭
jt[52]   <- 44   for (z) in 0 .. 0 if inpw[0] == 1
form[53] <- 124  for (z) in 0 .. 0 if inpw[0] == 1     # mov [rbx-8], rdx（表の終わり）

# 場 f を ⊥ で埋める（K は BSS が 0 で埋めてくれる）

# 場 f を ⊥ で埋める六命令の頭（**読みと計数器の和は座標にできない**）
field fzp : max bound 2048
field f6 : max bound 2048                   # 埋める場だけを数えた鎖
f6[0] <- 0
f6[f] <- f6[f-1] + 6                for (f) in 0 .. nflz[0] if f > 0 if not nofill[f-1]
f6[f] <- f6[f-1]                    for (f) in 0 .. nflz[0] if f > 0 if nofill[f-1]
# 鍵を二升に置く四命令（⊥ を 0 に置く場があるときだけ。無い本の符号は前と同じバイト）
field nxr : max bound 1                     # 鍵の命令数
nxr[0] <- 0
nxr[z] <- 4                          for (f) in 0 .. nflz[0] for (z) in 0 .. 0 if fxr[f]
form[pb[z]]     <- 2    for (z) in 0 .. 0 if nxr[z] == 4    # mov rax, 2147483647（min と flat の ⊥）
imm[pb[z]]      <- 2147483647 + bias[0]   for (z) in 0 .. 0 if nxr[z] == 4
form[pb[z] + 1] <- 51   for (z) in 0 .. 0 if nxr[z] == 4    # mov [rbx-48], rax
imm[pb[z] + 1]  <- 0 - 48 + bias[0]       for (z) in 0 .. 0 if nxr[z] == 4
form[pb[z] + 2] <- 2    for (z) in 0 .. 0 if nxr[z] == 4    # mov rax, -2147483647（max の ⊥）
imm[pb[z] + 2]  <- 0 - 2147483647 + bias[0]   for (z) in 0 .. 0 if nxr[z] == 4
form[pb[z] + 3] <- 51   for (z) in 0 .. 0 if nxr[z] == 4    # mov [rbx-56], rax
imm[pb[z] + 3]  <- 0 - 56 + bias[0]       for (z) in 0 .. 0 if nxr[z] == 4
# 数の場の ⊤ の印を二升に置く五命令（14v。⊤ を運ぶ min / max の場があるときだけ）:
#   mov rax, -1 / shr rax, 1（0x7fff…ffff）/ mov [rbx-200], rax / add rax, 1（0x8000…0000）/ mov [rbx-208], rax
field ntx : max bound 1                     # ⊤ の印の命令数
ntx[0] <- 0
ntx[z] <- 5                          for (f) in 0 .. nflz[0] for (z) in 0 .. 0 if ftc[f] if fdlat[f] == 1
ntx[z] <- 5                          for (f) in 0 .. nflz[0] for (z) in 0 .. 0 if ftc[f] if fdlat[f] == 2
ntx[z] <- 5                          for (f) in 0 .. nflz[0] for (z) in 0 .. 0 if ftc[f] if fdlat[f] == 8
field txp : max bound 1                     # その頭
txp[z] <- pb[0] + nxr[0]             for (z) in 0 .. 0
form[txp[z]]     <- 2    for (z) in 0 .. 0 if ntx[z] == 5    # mov rax, -1
imm[txp[z]]      <- bias[0] - 1           for (z) in 0 .. 0 if ntx[z] == 5
form[txp[z] + 1] <- 198  for (z) in 0 .. 0 if ntx[z] == 5    # shr rax, 1
imm[txp[z] + 1]  <- 1 + bias[0]           for (z) in 0 .. 0 if ntx[z] == 5
form[txp[z] + 2] <- 51   for (z) in 0 .. 0 if ntx[z] == 5    # mov [rbx-200], rax（max の ⊤）
imm[txp[z] + 2]  <- bias[0] - 200         for (z) in 0 .. 0 if ntx[z] == 5
form[txp[z] + 3] <- 84   for (z) in 0 .. 0 if ntx[z] == 5    # add rax, 1
imm[txp[z] + 3]  <- 1 + bias[0]           for (z) in 0 .. 0 if ntx[z] == 5
form[txp[z] + 4] <- 51   for (z) in 0 .. 0 if ntx[z] == 5    # mov [rbx-208], rax（min の ⊤）
imm[txp[z] + 4]  <- bias[0] - 208         for (z) in 0 .. 0 if ntx[z] == 5
fzp[f] <- pb[0] + nxr[0] + ntx[0] + f6[f]     for (f) in 0 .. nflz[0]
nfld6[z] <- nxr[0] + ntx[0]          for (z) in 0 .. 0
nfld6[z] <- f6[f] + 6 + nxr[0] + ntx[0]       for (f) in 0 .. nflz[0] for (z) in 0 .. 0 if not nofill[f]
form[fzp[f]] <- 2                  for (f) in 0 .. nflz[0] if not nofill[f]   # mov rax, ⊥(束)
imm[fzp[f]]  <- fbot[f]            for (f) in 0 .. nflz[0] if not nofill[f]
form[fzp[f] + 1] <- 3                  for (f) in 0 .. nflz[0] if not nofill[f]   # mov rcx, 0
imm[fzp[f] + 1]  <- 0 + bias[0]                  for (f) in 0 .. nflz[0] if not nofill[f]
form[fzp[f] + 2] <- 47                 for (f) in 0 .. nflz[0] if not nofill[f]   # mov [rbx+rcx*8+foff],rax
imm[fzp[f] + 2]  <- foff[f] + bias[0]            for (f) in 0 .. nflz[0] if not nofill[f]
scb[fzp[f] + 2]  <- fscb[f] for (f) in 0 .. nflz[0] if not nofill[f]
form[fzp[f] + 3] <- 5                  for (f) in 0 .. nflz[0] if not nofill[f]   # add rcx, 1
imm[fzp[f] + 3]  <- 1 + bias[0]                  for (f) in 0 .. nflz[0] if not nofill[f]
form[fzp[f] + 4] <- 20                 for (f) in 0 .. nflz[0] if not nofill[f]   # cmp rcx, 升目の数
imm[fzp[f] + 4]  <- fsz[f] + bias[0]             for (f) in 0 .. nflz[0] if not nofill[f]
form[fzp[f] + 5] <- 7                  for (f) in 0 .. nflz[0] if not nofill[f]   # jb -> 埋めの頭
jt[fzp[f] + 5]   <- fzp[f] + 2            for (f) in 0 .. nflz[0] if not nofill[f]

# 種: 値と、**階数 1**。種は自分より小さい証人を持たない。

# 種 s の三命令の頭
field sdp : max bound 16384
field s3 : max bound 16384
s3[s] <- s * 3                      for (s) in 0 .. nsdz[0]
field sdwb : max bound 16384                 # 種 s が書く場の升の幅
sdwb[s] <- fwbz[sdf[s]]             for (s) in 0 .. nsdz[0] if sdf[s] < nfld[0]
field sdc8 : max bound 16384
sdc8[s] <- sdc[s] * sdwb[s]         for (s) in 0 .. nsdz[0]
field sdc4 : max bound 16384                 # 階数の側は升 4 バイト
sdc4[s] <- sdc[s] * 4               for (s) in 0 .. nsdz[0]
sdp[s] <- sb0[0] + s3[s]            for (s) in 0 .. nsdz[0]
# **同じ升の種は join する。** 種は升に値を直に置くので、`m[1] <- 7` と `m[1] <- 9`（min）
# は後の種が上書きして 9 になっていた（解釈実行は 7）。flat は ⊤ のはずが後の値、count は
# 二つ数えるはずが一つ、sum は足すはずが後の値。種は順に置かれるので、**各種がそれまでの
# 同じ升の種と join した値を置けば、最後の種が群の join を置く**（前の種の値は上書きされる）。
# （min の種だけを min の場に集める。max の種の 2147483647 は正しい値だが、焼き手自身の
#   min の場に入れると **焼き手の ⊥ の印に届いて、焼き手が終了コード 4 で止まった**。
#   印に届く min の種は理由 D で断るので、ここへは来させない。）
field sjmn : min bound 16384                 # 種 s までの同じ升の種の min
sjmn[s2] <- sdv[s]   for (s) in 0 .. nsdz[0] for (s2) in 0 .. nsdz[0] if s <= s2
      if sdf[s] == sdf[s2] if sdc[s] == sdc[s2] if fdlat[sdf[s]] == 1 if sdv[s] < 2147483647
field sjmx : max bound 16384                 # 同じく max
sjmx[s2] <- sdv[s]   for (s) in 0 .. nsdz[0] for (s2) in 0 .. nsdz[0] if s <= s2
      if sdf[s] == sdf[s2] if sdc[s] == sdc[s2] if fdlat[sdf[s]] == 2
# 和と数は **鎖**で数える（集約の規則はループ一つまでなので、二重ループの sum / count は
# 書けない）。同じ升の直前の種を指し（`sprv`）、そこまでの和・数に自分を足す。
field sprv : max bound 16384                 # 同じ升の直前の種
sprv[s2] <- s        for (s) in 0 .. nsdz[0] for (s2) in 0 .. nsdz[0] if s < s2
      if sdf[s] == sdf[s2] if sdc[s] == sdc[s2]
# **種は負になれる**（`f[1] <- -3`。14h）。前は「種の値は負でないので max で積める」と、鎖の頭
# （`sjsm[s] <- sdv[s]`）を全部の種に置いていた —— 負の和では頭の方が大きく、max が頭を選んで
# 前の種を落とす。頭は **前の種が無い種にだけ**置く（前があるかは下の層の or なので `not` で読める）。
field shpv : or bound 16384                  # 同じ升の前の種がある
shpv[s] <- true      for (s) in 0 .. nsdz[0] if sprv[s] >= 0
field sjsm : max bound 16384                 # 同じ升の種の和（鎖は一本なので max は一つの値しか見ない）
sjsm[s] <- sdv[s]                      for (s) in 0 .. nsdz[0] if not shpv[s]
sjsm[s] <- sjsm[sprv[s]] + sdv[s]      for (s) in 0 .. nsdz[0] if sprv[s] >= 0
field sjct : max bound 16384                 # 同じ升の種の数（count の種は一つが一）
sjct[s] <- 1                           for (s) in 0 .. nsdz[0]
sjct[s] <- sjct[sprv[s]] + 1           for (s) in 0 .. nsdz[0] if sprv[s] >= 0
field sjfl : or bound 16384                  # 同じ升の前の種と値が違う（flat なら ⊤）
sjfl[s2] <- true     for (s) in 0 .. nsdz[0] for (s2) in 0 .. nsdz[0] if s < s2
      if sdf[s] == sdf[s2] if sdc[s] == sdc[s2] if sdv[s] != sdv[s2]
field svf : max bound 16384                  # 種 s が置く値
svf[s] <- sjmn[s]    for (s) in 0 .. nsdz[0] if fdlat[sdf[s]] == 1
svf[s] <- sjmx[s]    for (s) in 0 .. nsdz[0] if fdlat[sdf[s]] == 2
svf[s] <- sdv[s]     for (s) in 0 .. nsdz[0] if fdlat[sdf[s]] == 3
svf[s] <- sdv[s]     for (s) in 0 .. nsdz[0] if fdlat[sdf[s]] == 6
svf[s] <- 2147483646 for (s) in 0 .. nsdz[0] if fdlat[sdf[s]] == 6 if sjfl[s]   # ⊤ の印
# （sum の `svf <- 0` は消した —— sjsm は種ごとに必ずあり、0 を並べると負の和が 0 に負ける）
svf[s] <- sjsm[s]    for (s) in 0 .. nsdz[0] if fdlat[sdf[s]] == 8
svf[s] <- sjct[s]    for (s) in 0 .. nsdz[0] if fdlat[sdf[s]] == 9
# 和は即値（符号つき 32 ビット）に収まらねばならない（理由 C。種ひとつずつは既に収まる）
badk[z] <- 12   for (s) in 0 .. nsdz[0] for (z) in 0 .. 0 if svf[s] > 2147483647
field i32lo : min bound 1                    # 即値の下端（min の場 —— max の場では ⊥ の印より下で見張りが止める。
                                             # 2147483648 は数の語に書けない（理由 C）ので `- 1` で作る）
i32lo[z] <- 0 - 2147483647 - 1   for (z) in 0 .. 0
badk[z] <- 12   for (s) in 0 .. nsdz[0] for (z) in 0 .. 0 if svf[s] < i32lo[0]
# flat の種が ⊤ になり、その ⊤ がどこかで数として誤読される場なら、置く代わりに ⊤ の
# 出口へ（終了コード 5。規則の join で ⊤ を作ったときと同じ）
field sdtp : or bound 16384
sdtp[s] <- true      for (s) in 0 .. nsdz[0] if fdlat[sdf[s]] == 6 if sjfl[s] if tdang[sdf[s]]
form[sdp[s]]     <- 2          for (s) in 0 .. nsdz[0] if sdf[s] < nfld[0] if not sdtp[s]
imm[sdp[s]]      <- svf[s] + bias[0]          for (s) in 0 .. nsdz[0] if sdf[s] < nfld[0] if not sdtp[s]
form[sdp[s]]     <- 162        for (s) in 0 .. nsdz[0] if sdtp[s]     # mov r15d, 場番号
imm[sdp[s]]      <- sdf[s] + bias[0]          for (s) in 0 .. nsdz[0] if sdtp[s]
form[sdp[s] + 1] <- 78         for (s) in 0 .. nsdz[0] if sdtp[s]     # jmp -> ⊤ の出口
jt[sdp[s] + 1]   <- tpx[0]     for (s) in 0 .. nsdz[0] if sdtp[s]
form[sdp[s] + 1] <- fsw[sdf[s]]   for (s) in 0 .. nsdz[0] if sdf[s] < nfld[0] if not sdtp[s]
imm[sdp[s] + 1]  <- foff[sdf[s]] + sdc8[s] + bias[0]   for (s) in 0 .. nsdz[0] if sdf[s] < nfld[0] if not sdtp[s]
form[sdp[s] + 2] <- 52         for (s) in 0 .. nsdz[0] if sdf[s] < nfld[0]
imm[sdp[s] + 2]  <- koff[sdf[s]] + sdc4[s] + bias[0]   for (s) in 0 .. nsdz[0] if sdf[s] < nfld[0]
scb[sdp[s] + 2]  <- kscb[0]   for (s) in 0 .. nsdz[0] if sdf[s] < nfld[0]

# ── 層の頭と尻尾 ─────────────────────────────────────────────────
form[hd[r]] <- 9                    for (r) in 0 .. nrlz[0] if fst[r] == 1     # xor r8,r8
# **周回に上限を置く**（RUN_CAP = 16,777,216）。昇鎖の終わらない本（`f[i] <- f[i] + 1`）は
# 最小不動点を持たない。解釈実行は変化の回数の見張り（400 万回）で断るが、焼いた符号は
# 見張りを持たず回り続けた —— 嘘ではない（答えを出さない）が、**断りもしない**。周回ごとに
# 少なくとも一升は動くので、周回が上限を越える本は変化が 400 万回を越え、解釈実行も断る
# （焼いた側が断るのは、解釈実行も断る本だけ）。越えたら止まって言う（終了コード 11）。
form[rend[r]]     <- 163    for (r) in 0 .. nrlz[0] if lst[r] == 1     # add r15,1
form[rend[r] + 1] <- 199    for (r) in 0 .. nrlz[0] if lst[r] == 1     # cmp r15, RUN_CAP
imm[rend[r] + 1]  <- 16777216 + bias[0]   for (r) in 0 .. nrlz[0] if lst[r] == 1
form[rend[r] + 2] <- 194    for (r) in 0 .. nrlz[0] if lst[r] == 1     # ja -> 周回の出口
jt[rend[r] + 2]   <- cpx[0] for (r) in 0 .. nrlz[0] if lst[r] == 1
form[rend[r] + 3] <- 21     for (r) in 0 .. nrlz[0] if lst[r] == 1     # test r8,r8
form[rend[r] + 4] <- 22     for (r) in 0 .. nrlz[0] if lst[r] == 1     # jne -> 層の頭
jt[rend[r] + 4]   <- hd[r]  for (r) in 0 .. nrlz[0] if lst[r] == 1

# ── ループの頭。**番号 0 が rcx、1 が r13、2 が r14、3 からは升**（入れ子は行が言う）───────

# ループの頭の位置（**読み二つの和は座標にできない**ので名前を付ける）
field lhp : max bound 16384
field lpi8 : max bound 16384                    # 頭の位置（同じ規則の前のループの頭の長さの和 —— 鎖）
# 頭と進めの長さ（段 3 から一命令ずつ長い。上端が外の変数で引く場の区間は、頭がさらに四命令長い）
field lux : max bound 16384                     # 上端の前置きの伸び（種3 は四命令）
lux[gl] <- 0                        for (gl) in 0 .. nglz[0] if lpk[gl] <= 2
lux[gl] <- 4                        for (gl) in 0 .. nglz[0] if lpk[gl] == 3
field lly : max bound 16384                     # 下端の前置きの長さ（13i。数なら 0）
lly[gl] <- 0                        for (gl) in 0 .. nglz[0] if lplk[gl] == 0
lly[gl] <- 7                        for (gl) in 0 .. nglz[0] if lplk[gl] == 1
lly[gl] <- 10                       for (gl) in 0 .. nglz[0] if lplk[gl] == 2
lly[gl] <- 5                        for (gl) in 0 .. nglz[0] if lplk[gl] == 3
field lhx : max bound 16384                     # 頭の前置きの伸び
lhx[gl] <- lux[gl] + lly[gl]        for (gl) in 0 .. nglz[0]
field lph : max bound 16384                     # 頭の命令数
lph[gl] <- 8 + lhx[gl]              for (gl) in 0 .. nglz[0] if lpi[gl] <= 2
lph[gl] <- 9 + lhx[gl]              for (gl) in 0 .. nglz[0] if lpi[gl] >= 3
lpi8[gl] <- 0                       for (gl) in 0 .. nglz[0] if lpi[gl] == 0
lpi8[gl] <- lpi8[gl-1] + lph[gl-1]  for (gl) in 1 .. nglz[0] if lpi[gl] >= 1
field lpa : max bound 16384                     # 進めの命令数
lpa[gl] <- 3                        for (gl) in 0 .. nglz[0] if lpi[gl] <= 2
lpa[gl] <- 4                        for (gl) in 0 .. nglz[0] if lpi[gl] >= 3
# 段 l の計数器の升（場の下、`gap` の余白。-8〜-56 は別の升が使っている）。
# 段は 0..7（前段が八つまで持つ）。**数えて置く** —— 段 3 が -64、段 7 が -96。
field lcm : max bound 8
lcm[l] <- l * 8 + 40                for (l) in 3 .. 7
field lce : max bound 8                         # その升の即値（bias 込み）
lce[l] <- bias[0] - lcm[l]          for (l) in 3 .. 7
lhp[gl] <- lhead[lpr[gl]] + lpi8[gl] + cpre[lpr[gl]]   for (gl) in 0 .. nglz[0] if nofus[lpr[gl]] if lpi[gl] >= 1
lhp[gl] <- lhead[lpr[gl]] + lpi8[gl]   for (gl) in 0 .. nglz[0] if lpi[gl] == 0
# 群の中の規則の内側の段は、自分の持ち場に頭を持つ（段0 の頭のぶんを引く —— 14n）
lhp[gl] <- rb[lpr[gl]] + lpi8[gl] - lph0[lpr[gl]]   for (gl) in 0 .. nglz[0] if not nofus[lpr[gl]] if lpi[gl] >= 1
# 区間が空のときの行き先: その段の進めの後ろ。段0 と群の尻尾は群の終わりから数え、群の中の規則の内側の段は
# 自分の終わりから数える（段0 の進め三命令が無いぶん後ろへ —— 14n）
field lskp : max bound 16384
lskp[gl] <- gend[lpr[gl]] - lpi3[gl] + lpa[gl]   for (gl) in 0 .. nglz[0] if lpi[gl] == 0
lskp[gl] <- gend[lpr[gl]] - lpi3[gl] + lpa[gl] - csuf[lpr[gl]]   for (gl) in 0 .. nglz[0] if nofus[lpr[gl] + 1]
      if lpi[gl] >= 1
lskp[gl] <- rend[lpr[gl]] - lpi3[gl] + lpa[gl] + 3   for (gl) in 0 .. nglz[0] if lpi[gl] >= 1
      if not nofus[lpr[gl] + 1]
field lht : max bound 16384                     # 頭の尻尾（初期化と比べ）の基（種3 は前置きが四命令長い）
lht[gl] <- lhp[gl] + lhx[gl]        for (gl) in 0 .. nglz[0]
# 上端を比べる相手の番地（種2 は場の升、種3 は頭が上端を置いた升）
field lbad : max bound 16384
lbad[gl] <- foff[lpbf[gl]] + lpbc8[gl] + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 2
lbad[gl] <- bce[lpi[gl]]            for (gl) in 0 .. nglz[0] if lpk[gl] == 3
# ── 種3: **上端が外の変数で引いた場**（`for (j) in 0 .. len[i]`）——————————
# 多面体でいえば箱ではなく半空間で切られた反復空間。頭で i の升を読み（外のループが i を
# 決めてから入るので、入るたびに読み直す）、⊥ なら回らず、広さの上限を見て、**段ごとの升**
# に置く。尻尾と進めは種2 と同じ形で、比べる相手が場の升からこの升に替わるだけ。
# 升は場の下の余白（段 l が -120 - 8l。-64〜-112 は升の計数器と ⊤ の旗が使う）。
field bcm : max bound 8
bcm[l] <- l * 8 + 120               for (l) in 0 .. 7
field bce : max bound 8                         # その升の即値（bias 込み）
bce[l] <- bias[0] - bcm[l]          for (l) in 0 .. 7
form[lhp[gl]] <- 82       for (gl) in 0 .. nglz[0] if lpk[gl] == 3 if lpbc[gl] == 0   # mov r9, 外の計数器
form[lhp[gl]] <- 104      for (gl) in 0 .. nglz[0] if lpk[gl] == 3 if lpbc[gl] == 1
form[lhp[gl]] <- 108      for (gl) in 0 .. nglz[0] if lpk[gl] == 3 if lpbc[gl] == 2
form[lhp[gl]] <- 211      for (gl) in 0 .. nglz[0] if lpk[gl] == 3 if lpbc[gl] >= 3
imm[lhp[gl]]  <- lce[lpbc[gl]]      for (gl) in 0 .. nglz[0] if lpk[gl] == 3 if lpbc[gl] >= 3
form[lhp[gl] + 1] <- 50   for (gl) in 0 .. nglz[0] if lpk[gl] == 3                    # cmp r9, 広さ
imm[lhp[gl] + 1]  <- fw[lpbf[gl], 0] + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 3
form[lhp[gl] + 2] <- 73   for (gl) in 0 .. nglz[0] if lpk[gl] == 3                    # jae → 出る（⊥）
jt[lhp[gl] + 2]   <- lskp[gl]   for (gl) in 0 .. nglz[0] if lpk[gl] == 3
form[lhp[gl] + 3] <- frd[lpbf[gl]]  for (gl) in 0 .. nglz[0] if lpk[gl] == 3          # rax ← 上端の升
imm[lhp[gl] + 3]  <- foff[lpbf[gl]] + bias[0]    for (gl) in 0 .. nglz[0] if lpk[gl] == 3
scb[lhp[gl] + 3]  <- fscb[lpbf[gl]] for (gl) in 0 .. nglz[0] if lpk[gl] == 3
form[lhp[gl] + 4] <- 12   for (gl) in 0 .. nglz[0] if lpk[gl] == 3                    # cmp rax, ⊥
imm[lhp[gl] + 4]  <- fbot[lpbf[gl]] for (gl) in 0 .. nglz[0] if lpk[gl] == 3
form[lhp[gl] + 5] <- 13   for (gl) in 0 .. nglz[0] if lpk[gl] == 3                    # je → 出る
jt[lhp[gl] + 5]   <- lskp[gl]   for (gl) in 0 .. nglz[0] if lpk[gl] == 3
form[lhp[gl] + 6] <- 12   for (gl) in 0 .. nglz[0] if lpk[gl] == 3                    # cmp rax, 下端 + 上限
imm[lhp[gl] + 6]  <- lplo[gl] + 4194304 + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 3
form[lhp[gl] + 7] <- 116  for (gl) in 0 .. nglz[0] if lpk[gl] == 3                    # jg → 区間の踏み台
jt[lhp[gl] + 7]   <- rsf[lpbf[gl]]  for (gl) in 0 .. nglz[0] if lpk[gl] == 3
form[lhp[gl] + 8] <- 51   for (gl) in 0 .. nglz[0] if lpk[gl] == 3                    # mov [升], rax
imm[lhp[gl] + 8]  <- bce[lpi[gl]]   for (gl) in 0 .. nglz[0] if lpk[gl] == 3
# **上端が場の区間は、入るたびに二つ比べる**（頭の最初の五命令。要らないループは nop）。
#   ⊥ なら空 —— 解釈実行は上端が ⊥ の区間を回さない。前は min / flat の ⊥（2147483647）
#     を数として読んで二十億回まわり segfault し、sum / count の ⊥（0）では `0 .. 0` を
#     一度回して答えを一つ多くしていた。
#   **広さは言語の上限（RANGE_CAP = 4,194,304）まで** —— 解釈実行は超えた区間を「座標は
#     有限の資源」と言って断るのに、焼いた符号は回し切って答えていた（定義が断るものに
#     答えていた）。上端が場なら止まって言う（終了コード 10）、数なら焼くときに言う（理由 F）。
form[lhp[gl]]     <- 185  for (gl) in 0 .. nglz[0] if lpk[gl] == 2    # mov rax, [上端の場]
imm[lhp[gl]]      <- foff[lpbf[gl]] + lpbc8[gl] + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 2
form[lhp[gl] + 1] <- 12   for (gl) in 0 .. nglz[0] if lpk[gl] == 2    # cmp rax, ⊥
imm[lhp[gl] + 1]  <- fbot[lpbf[gl]]   for (gl) in 0 .. nglz[0] if lpk[gl] == 2
form[lhp[gl] + 2] <- 13   for (gl) in 0 .. nglz[0] if lpk[gl] == 2    # je -> 出る（空）
jt[lhp[gl] + 2]   <- lskp[gl]   for (gl) in 0 .. nglz[0] if lpk[gl] == 2
form[lhp[gl] + 3] <- 12   for (gl) in 0 .. nglz[0] if lpk[gl] == 2    # cmp rax, 下端 + 上限
imm[lhp[gl] + 3]  <- lplo[gl] + 4194304 + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 2
form[lhp[gl] + 4] <- 116  for (gl) in 0 .. nglz[0] if lpk[gl] == 2    # jg -> 区間の踏み台
jt[lhp[gl] + 4]   <- rsf[lpbf[gl]]   for (gl) in 0 .. nglz[0] if lpk[gl] == 2
form[lhp[gl]]     <- 195  for (gl) in 0 .. nglz[0] if lpk[gl] <= 1    # nop
form[lhp[gl] + 1] <- 195  for (gl) in 0 .. nglz[0] if lpk[gl] <= 1
form[lhp[gl] + 2] <- 195  for (gl) in 0 .. nglz[0] if lpk[gl] <= 1
form[lhp[gl] + 3] <- 195  for (gl) in 0 .. nglz[0] if lpk[gl] <= 1
form[lhp[gl] + 4] <- 195  for (gl) in 0 .. nglz[0] if lpk[gl] <= 1
# ── **下端が場の区間**（13i。`for (j) in s[i] .. e[i]` / `for (j) in lo[0] .. 9`）————————
# 下端も上端と同じく「それまでに束縛された変数の下で評価する」（解釈実行の bindings）。
# 評価の順は **下端 → 上端 → 広さ**: どちらかが ⊥ なら空、両方あって広さが上限を越えたら断る。
# 焼いた頭は上端の前置き（種2/3）の後ろに下端の前置きを置き、上端の前置きの広さの検査を
# nop にして（form は max。nop 195 は比べる形 12 / 飛ぶ形 116 に勝つ）、下端の前置きの
# 最後で広さを見る。上端は前置きの時点で ⊥ でないと分かっているので、順は解釈実行と同じになる。
#   種1（`f[数]`）: rax ← [升] / cmp ⊥ / je 出る / mov [下端の升], rax
#   種2（`f[外の変数]`）: r9 ← 外の計数器 / cmp r9, 広さ / jae 出る / rax ← f[r9] / cmp ⊥ / je 出る /
#                        mov [下端の升], rax
#   種3（裸の外の変数 `i ..`）: rax ← 外の計数器 / mov [下端の升], rax（⊥ は無い —— 計数器は居る場所）
#   広さ（三命令）: 上端が数なら nop / cmp rax, 上端 - 上限 / jl 踏み台
#                 上端が場なら sub rax, [上端] / cmp rax, -上限 / jl 踏み台
# 下端の升は一つでよい —— 頭の中で置いて、同じ頭の尻尾がすぐ読む（進めは読まない）。
field llcl : max bound 1                        # 下端の升の即値（`[rbx-184]`。bias 込み）
llcl[z] <- bias[0] - 184   for (z) in 0 .. 0
field llp : max bound 16384                     # 下端の前置きの位置
llp[gl] <- lhp[gl] + 5 + lux[gl]    for (gl) in 0 .. nglz[0] if lplk[gl] >= 1
field llq : max bound 16384                     # 広さの検査の位置
llq[gl] <- llp[gl] + lly[gl] - 3    for (gl) in 0 .. nglz[0] if lplk[gl] >= 1
field llx : max bound 16384                     # 空の飛び先（一つ外の進め —— 上端の ⊥ と同じ）
llx[gl] <- lskp[gl]   for (gl) in 0 .. nglz[0] if lplk[gl] >= 1
field llsf : max bound 16384                    # 広さを越えたときの踏み台（上端が場ならその場）
llsf[gl] <- rsf[lplf[gl]]           for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lpk[gl] <= 1
llsf[gl] <- rsf[lpbf[gl]]           for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lpk[gl] >= 2
form[lhp[gl] + 3] <- 195  for (gl) in 0 .. nglz[0] if lpk[gl] == 2 if lplk[gl] >= 1   # 上端の広さの検査を外す
form[lhp[gl] + 4] <- 195  for (gl) in 0 .. nglz[0] if lpk[gl] == 2 if lplk[gl] >= 1
form[lhp[gl] + 6] <- 195  for (gl) in 0 .. nglz[0] if lpk[gl] == 3 if lplk[gl] >= 1
form[lhp[gl] + 7] <- 195  for (gl) in 0 .. nglz[0] if lpk[gl] == 3 if lplk[gl] >= 1
# 種1
form[llp[gl]]     <- 185  for (gl) in 0 .. nglz[0] if lplk[gl] == 1                  # mov rax, [下端の場]
imm[llp[gl]]      <- foff[lplf[gl]] + lplc[gl] * 8 + bias[0]   for (gl) in 0 .. nglz[0] if lplk[gl] == 1
form[llp[gl] + 1] <- 12   for (gl) in 0 .. nglz[0] if lplk[gl] == 1                  # cmp rax, ⊥
imm[llp[gl] + 1]  <- fbot[lplf[gl]] for (gl) in 0 .. nglz[0] if lplk[gl] == 1
form[llp[gl] + 2] <- 13   for (gl) in 0 .. nglz[0] if lplk[gl] == 1                  # je → 出る（空）
jt[llp[gl] + 2]   <- llx[gl]        for (gl) in 0 .. nglz[0] if lplk[gl] == 1
form[llp[gl] + 3] <- 51   for (gl) in 0 .. nglz[0] if lplk[gl] == 1                  # mov [下端の升], rax
imm[llp[gl] + 3]  <- llcl[0]        for (gl) in 0 .. nglz[0] if lplk[gl] == 1
# 種2
form[llp[gl]] <- 82       for (gl) in 0 .. nglz[0] if lplk[gl] == 2 if lplc[gl] == 0  # mov r9, 外の計数器
form[llp[gl]] <- 104      for (gl) in 0 .. nglz[0] if lplk[gl] == 2 if lplc[gl] == 1
form[llp[gl]] <- 108      for (gl) in 0 .. nglz[0] if lplk[gl] == 2 if lplc[gl] == 2
form[llp[gl]] <- 211      for (gl) in 0 .. nglz[0] if lplk[gl] == 2 if lplc[gl] >= 3
imm[llp[gl]]  <- lce[lplc[gl]]      for (gl) in 0 .. nglz[0] if lplk[gl] == 2 if lplc[gl] >= 3
form[llp[gl] + 1] <- 50   for (gl) in 0 .. nglz[0] if lplk[gl] == 2                  # cmp r9, 広さ
imm[llp[gl] + 1]  <- fw[lplf[gl], 0] + bias[0]   for (gl) in 0 .. nglz[0] if lplk[gl] == 2
form[llp[gl] + 2] <- 73   for (gl) in 0 .. nglz[0] if lplk[gl] == 2                  # jae → 出る（⊥）
jt[llp[gl] + 2]   <- llx[gl]        for (gl) in 0 .. nglz[0] if lplk[gl] == 2
form[llp[gl] + 3] <- frd[lplf[gl]]  for (gl) in 0 .. nglz[0] if lplk[gl] == 2          # rax ← 下端の升
imm[llp[gl] + 3]  <- foff[lplf[gl]] + bias[0]    for (gl) in 0 .. nglz[0] if lplk[gl] == 2
scb[llp[gl] + 3]  <- fscb[lplf[gl]] for (gl) in 0 .. nglz[0] if lplk[gl] == 2
form[llp[gl] + 4] <- 12   for (gl) in 0 .. nglz[0] if lplk[gl] == 2                  # cmp rax, ⊥
imm[llp[gl] + 4]  <- fbot[lplf[gl]] for (gl) in 0 .. nglz[0] if lplk[gl] == 2
form[llp[gl] + 5] <- 13   for (gl) in 0 .. nglz[0] if lplk[gl] == 2                  # je → 出る
jt[llp[gl] + 5]   <- llx[gl]        for (gl) in 0 .. nglz[0] if lplk[gl] == 2
form[llp[gl] + 6] <- 51   for (gl) in 0 .. nglz[0] if lplk[gl] == 2                  # mov [下端の升], rax
imm[llp[gl] + 6]  <- llcl[0]        for (gl) in 0 .. nglz[0] if lplk[gl] == 2
# 種3
form[llp[gl]] <- 109      for (gl) in 0 .. nglz[0] if lplk[gl] == 3 if lplc[gl] == 0  # mov rax, 外の計数器
form[llp[gl]] <- 111      for (gl) in 0 .. nglz[0] if lplk[gl] == 3 if lplc[gl] == 1
form[llp[gl]] <- 113      for (gl) in 0 .. nglz[0] if lplk[gl] == 3 if lplc[gl] == 2
form[llp[gl]] <- 185      for (gl) in 0 .. nglz[0] if lplk[gl] == 3 if lplc[gl] >= 3
imm[llp[gl]]  <- lce[lplc[gl]]      for (gl) in 0 .. nglz[0] if lplk[gl] == 3 if lplc[gl] >= 3
form[llp[gl] + 1] <- 51   for (gl) in 0 .. nglz[0] if lplk[gl] == 3                  # mov [下端の升], rax
imm[llp[gl] + 1]  <- llcl[0]        for (gl) in 0 .. nglz[0] if lplk[gl] == 3
# 広さ
form[llq[gl]]     <- 195  for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lpk[gl] <= 1  # nop
form[llq[gl] + 1] <- 12   for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lpk[gl] <= 1  # cmp rax, 上端 - 上限
imm[llq[gl] + 1]  <- lphi[gl] - 4194304 + bias[0]   for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lpk[gl] <= 1
form[llq[gl]]     <- 224  for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lpk[gl] >= 2  # sub rax, [上端]
imm[llq[gl]]      <- lbad[gl]       for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lpk[gl] >= 2
form[llq[gl] + 1] <- 12   for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lpk[gl] >= 2  # cmp rax, -上限
imm[llq[gl] + 1]  <- bias[0] - 4194304   for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lpk[gl] >= 2
form[llq[gl] + 2] <- 115  for (gl) in 0 .. nglz[0] if lplk[gl] >= 1                  # jl → 区間の踏み台
jt[llq[gl] + 2]   <- llsf[gl]       for (gl) in 0 .. nglz[0] if lplk[gl] >= 1
field lpw : max bound 16384                     # 数の区間の広さ（上端 - 下端）
lpw[gl] <- lphi[gl] - lplo[gl]      for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lplk[gl] == 0
badk[z] <- rlin[lpr[gl]] * 16 + 15   for (gl) in 0 .. nglz[0] for (z) in 0 .. 0
      if lpk[gl] == 1 if lpw[gl] > 4194304
# 頭の検査（空なら一度も回らない）。飛び先は **一つ外のループの進め**、
# いちばん外なら群の終わり —— どちらも `群の終わり - (ここまでの進め) + (この段の進め)` で出る
# （進めは内側から並ぶので、一つ外の進めは自分の進めのすぐ後ろ）。
form[lht[gl] + 6] <- 79   for (gl) in 0 .. nglz[0] if lpk[gl] == 0        # cmp rcx, 表の終わり
form[lht[gl] + 6] <- 20   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] == 0
# **降りる軸**（14p）: 群の段0 を上から回す。頭は `mov rcx, 上端 / cmp rcx, 下端 / jl 出る`、
# 進めは `add rcx, -1 / cmp rcx, 下端 / jge 頭`。数の区間（前段が軸の形に要る）だけ
field ldn : or bound 16384                      # 段 l は降りる軸の段0
ldn[gl] <- true                     for (gl) in 0 .. nglz[0] if lpi[gl] == 0 if raxd[lpr[gl]]
badk[z] <- rlin[lpr[gl]] * 16 + 8   for (gl) in 0 .. nglz[0] for (z) in 0 .. 0 if ldn[gl] if lpk[gl] != 1
badk[z] <- rlin[lpr[gl]] * 16 + 8   for (gl) in 0 .. nglz[0] for (z) in 0 .. 0 if ldn[gl] if lplk[gl] != 0
form[lht[gl] + 6] <- 103  for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] == 1
form[lht[gl] + 6] <- 107  for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] == 2
imm[lht[gl] + 6]  <- lphi[gl] + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] <= 2 if not ldn[gl]
imm[lht[gl] + 6]  <- lplo[gl] + bias[0]   for (gl) in 0 .. nglz[0] if ldn[gl]
form[lht[gl] + 6] <- 142  for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] == 0
form[lht[gl] + 6] <- 143  for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] == 1
form[lht[gl] + 6] <- 144  for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] == 2
imm[lht[gl] + 6]  <- lbad[gl]       for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] <= 2
form[lht[gl] + 7] <- 73   for (gl) in 0 .. nglz[0] if lpk[gl] == 0 if lpi[gl] <= 2    # jae -> 出る
form[lht[gl] + 7] <- 116  for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] <= 2 if not ldn[gl]   # jg（符号付き）
form[lht[gl] + 7] <- 115  for (gl) in 0 .. nglz[0] if ldn[gl]                         # jl（降りる軸）
jt[lht[gl] + 7]   <- lskp[gl]   for (gl) in 0 .. nglz[0] if lpi[gl] <= 2
# **段 3 から（升の計数器）**: 下端を rax に作って升に置き、rax で上端と比べる（九命令）。
# 表のループは段 0 にしか居ない（前段が一番外へ回す）ので、ここは区間だけである。
form[lht[gl] + 5] <- 2    for (gl) in 0 .. nglz[0] if lpi[gl] >= 3 if lplk[gl] == 0   # mov rax, 下端
imm[lht[gl] + 5]  <- lplo[gl] + bias[0]   for (gl) in 0 .. nglz[0] if lpi[gl] >= 3 if lplk[gl] == 0
form[lht[gl] + 5] <- 185  for (gl) in 0 .. nglz[0] if lpi[gl] >= 3 if lplk[gl] >= 1   # mov rax, [下端の升]
imm[lht[gl] + 5]  <- llcl[0]      for (gl) in 0 .. nglz[0] if lpi[gl] >= 3 if lplk[gl] >= 1
form[lht[gl] + 6] <- 51   for (gl) in 0 .. nglz[0] if lpi[gl] >= 3            # mov [升], rax
imm[lht[gl] + 6]  <- lce[lpi[gl]]   for (gl) in 0 .. nglz[0] if lpi[gl] >= 3
form[lht[gl] + 7] <- 12   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] >= 3   # cmp rax, 上端
imm[lht[gl] + 7]  <- lphi[gl] + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] >= 3
form[lht[gl] + 7] <- 214  for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] >= 3   # cmp rax, [上端]
imm[lht[gl] + 7]  <- lbad[gl]       for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] >= 3
form[lht[gl] + 8] <- 116  for (gl) in 0 .. nglz[0] if lpi[gl] >= 3                   # jg（符号付き）
jt[lht[gl] + 8]   <- lskp[gl]   for (gl) in 0 .. nglz[0] if lpi[gl] >= 3
form[lht[gl] + 5] <- 3      for (gl) in 0 .. nglz[0] if lpk[gl] == 0            # mov rcx, データの先頭
imm[lht[gl] + 5]  <- dbase[0] + bias[0]  for (gl) in 0 .. nglz[0] if lpk[gl] == 0
form[lht[gl] + 5] <- 3      for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 0 if lplk[gl] == 0  # mov rcx, 下端
imm[lht[gl] + 5]  <- lplo[gl] + bias[0]     for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 0 if lplk[gl] == 0
      if not ldn[gl]
imm[lht[gl] + 5]  <- lphi[gl] + bias[0]     for (gl) in 0 .. nglz[0] if ldn[gl]      # mov rcx, 上端（降りる軸）
form[lht[gl] + 5] <- 101    for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 1 if lplk[gl] == 0  # mov r13, 下端
imm[lht[gl] + 5]  <- lplo[gl] + bias[0]     for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 1 if lplk[gl] == 0
form[lht[gl] + 5] <- 105    for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 2 if lplk[gl] == 0  # mov r14, 下端
imm[lht[gl] + 5]  <- lplo[gl] + bias[0]     for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 2 if lplk[gl] == 0
# 下端が場なら、頭が置いた升から作る（13i）
form[lht[gl] + 5] <- 221    for (gl) in 0 .. nglz[0] if lpi[gl] == 0 if lplk[gl] >= 1  # mov rcx, [下端の升]
form[lht[gl] + 5] <- 222    for (gl) in 0 .. nglz[0] if lpi[gl] == 1 if lplk[gl] >= 1  # mov r13, [下端の升]
form[lht[gl] + 5] <- 223    for (gl) in 0 .. nglz[0] if lpi[gl] == 2 if lplk[gl] >= 1  # mov r14, [下端の升]
imm[lht[gl] + 5]  <- llcl[0]      for (gl) in 0 .. nglz[0] if lpi[gl] <= 2 if lplk[gl] >= 1

# ── ガードの発行。**行ごとに**。座標は crd が出す ────────────────────
field gc : max bound 16384                      # ガード g の中身の位置（座標のあと）
gc[gg] <- gpos[gg] + 1 + ctot[gdoo[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] >= 2 if gdok[gg] == 0
gc[gg] <- gpos[gg] + 1                 for (gg) in 0 .. nggz[0] if gdk[gg] >= 2 if gdok[gg] >= 1

# 種1: `if 列 == 値`。表の列をそのまま見る（場ではない）
form[gpos[gg] + 1] <- 29   for (gg) in 0 .. nggz[0] if gdk[gg] == 1
imm[gpos[gg] + 1]  <- gdc1[gg] * 8 + bias[0]   for (gg) in 0 .. nggz[0] if gdk[gg] == 1
form[gpos[gg] + 2] <- 50   for (gg) in 0 .. nggz[0] if gdk[gg] == 1
imm[gpos[gg] + 2]  <- gdgv[gg] + bias[0]   for (gg) in 0 .. nggz[0] if gdk[gg] == 1
form[gpos[gg] + 3] <- 22   for (gg) in 0 .. nggz[0] if gdk[gg] == 1
jt[gpos[gg] + 3]   <- av[gdr[gg]]    for (gg) in 0 .. nggz[0] if gdk[gg] == 1

# 種5/6: `if 列 >= 値` / `if 列 <= 値`。**範囲は上集合・下集合の帰属である**
form[gpos[gg] + 1] <- 29   for (gg) in 0 .. nggz[0] if gdk[gg] >= 5 if gdk[gg] <= 6
imm[gpos[gg] + 1]  <- gdc1[gg] * 8 + bias[0]   for (gg) in 0 .. nggz[0] if gdk[gg] >= 5 if gdk[gg] <= 6
form[gpos[gg] + 2] <- 50   for (gg) in 0 .. nggz[0] if gdk[gg] >= 5 if gdk[gg] <= 6
imm[gpos[gg] + 2]  <- gdgv[gg] + bias[0]   for (gg) in 0 .. nggz[0] if gdk[gg] >= 5 if gdk[gg] <= 6
form[gpos[gg] + 3] <- 115  for (gg) in 0 .. nggz[0] if gdk[gg] == 5      # jl -> 次の行へ
jt[gpos[gg] + 3]   <- av[gdr[gg]]    for (gg) in 0 .. nggz[0] if gdk[gg] == 5
form[gpos[gg] + 3] <- 116  for (gg) in 0 .. nggz[0] if gdk[gg] == 6      # jg -> 次の行へ
jt[gpos[gg] + 3]   <- av[gdr[gg]]    for (gg) in 0 .. nggz[0] if gdk[gg] == 6

# 種7/8: `if f[C] >= 値` / `if f[C] <= 値`（⊥ なら次の行へ）
form[gc[gg]] <- frd[gdf[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
imm[gc[gg]]  <- foff[gdf[gg]] + bias[0] for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
scb[gc[gg]]  <- fscb[gdf[gg]] for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
form[gc[gg] + 1] <- 12  for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
imm[gc[gg] + 1]  <- fbot[gdf[gg]]  for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
form[gc[gg] + 2] <- 13  for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
jt[gc[gg] + 2]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
form[gc[gg] + 3] <- 12  for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
imm[gc[gg] + 3]  <- gdgv[gg] + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
form[gc[gg] + 4] <- 115 for (gg) in 0 .. nggz[0] if gdk[gg] == 7
jt[gc[gg] + 4]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 7
form[gc[gg] + 4] <- 116 for (gg) in 0 .. nggz[0] if gdk[gg] == 8
jt[gc[gg] + 4]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 8

# 種10/11: `if f[C] == 値` / `!= 値`（場と **定数** の比較。場同士ではない）
form[gc[gg]] <- frd[gdf[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
imm[gc[gg]]  <- foff[gdf[gg]] + bias[0] for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
scb[gc[gg]]  <- fscb[gdf[gg]] for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
form[gc[gg] + 1] <- 12  for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
imm[gc[gg] + 1]  <- fbot[gdf[gg]]  for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
form[gc[gg] + 2] <- 13  for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
jt[gc[gg] + 2]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
form[gc[gg] + 3] <- 12  for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
imm[gc[gg] + 3]  <- gdgv[gg] + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] >= 10 if gknown[gg]
form[gc[gg] + 4] <- 22  for (gg) in 0 .. nggz[0] if gdk[gg] == 10      # == を要求: 違えば飛ぶ
jt[gc[gg] + 4]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 10
form[gc[gg] + 4] <- 13  for (gg) in 0 .. nggz[0] if gdk[gg] == 11      # != を要求: 同じなら飛ぶ
jt[gc[gg] + 4]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 11

# 種9: `if f[C]`（肯定の読みをガードとして使う）。**階数もここで継ぐ** ——
# 値の式の中の読みは項、if 節の中の読みはガードである（or では値が消えるので
# 長いあいだ同じに見えていた。max で初めて分かれた）
form[gc[gg]] <- frd[gdf[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 9
imm[gc[gg]]  <- foff[gdf[gg]] + bias[0] for (gg) in 0 .. nggz[0] if gdk[gg] == 9
scb[gc[gg]]  <- fscb[gdf[gg]] for (gg) in 0 .. nggz[0] if gdk[gg] == 9
form[gc[gg] + 1] <- 12  for (gg) in 0 .. nggz[0] if gdk[gg] == 9
imm[gc[gg] + 1]  <- fbot[gdf[gg]]  for (gg) in 0 .. nggz[0] if gdk[gg] == 9
form[gc[gg] + 2] <- 13  for (gg) in 0 .. nggz[0] if gdk[gg] == 9
jt[gc[gg] + 2]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 9
form[gc[gg] + 3] <- 26  for (gg) in 0 .. nggz[0] if gdk[gg] == 9      # test rax,rax
form[gc[gg] + 4] <- 13  for (gg) in 0 .. nggz[0] if gdk[gg] == 9
jt[gc[gg] + 4]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 9
form[gc[gg] + 5] <- 88  for (gg) in 0 .. nggz[0] if gdk[gg] == 9      # cmp r11d,[K]
imm[gc[gg] + 5]  <- koff[gdf[gg]] + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 9
scb[gc[gg] + 5]  <- kscb[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 9
form[gc[gg] + 6] <- 89  for (gg) in 0 .. nggz[0] if gdk[gg] == 9      # cmovb r11d,[K]
imm[gc[gg] + 6]  <- koff[gdf[gg]] + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 9
scb[gc[gg] + 6]  <- kscb[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 9

# 種2: `if not f[C]`。**真なら飛ぶ**（成層が健全性を持つ）
form[gc[gg]] <- frd[gdf[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 2
imm[gc[gg]]  <- foff[gdf[gg]] + bias[0] for (gg) in 0 .. nggz[0] if gdk[gg] == 2
scb[gc[gg]]  <- fscb[gdf[gg]] for (gg) in 0 .. nggz[0] if gdk[gg] == 2
# **`not f[…]` は ⊥ でも 0 でも立つ**（解釈実行は `not _truthy(v)` —— ⊥ は偽、0 も偽）。
# ここは長いあいだ `test rax,rax / jnz 次の行へ` の二命令だった —— 立つのは升が 0 の
# ときだけで、それは **`or` の ⊥ が 0 だから**正しかった。max の ⊥（-2147483647）も
# flat の ⊥（2147483647）も 0 ではないので、読まれていない升で `not` が立たなかった
# （`if not seen[i]` で seen が flat / max のとき。`test/mutate.py` が束を替えて出した）。
# ⊥ と比べて立ち、そうでなければ 0 かを見る。
form[gc[gg] + 1] <- 12  for (gg) in 0 .. nggz[0] if gdk[gg] == 2      # cmp rax, ⊥
imm[gc[gg] + 1]  <- fbot[gdf[gg]]  for (gg) in 0 .. nggz[0] if gdk[gg] == 2
form[gc[gg] + 2] <- 13  for (gg) in 0 .. nggz[0] if gdk[gg] == 2      # je → ガードの後ろ（立つ）
jt[gc[gg] + 2]   <- gpos[gg] + glen[gg] + 1   for (gg) in 0 .. nggz[0] if gdk[gg] == 2
form[gc[gg] + 3] <- 26  for (gg) in 0 .. nggz[0] if gdk[gg] == 2      # test rax,rax
form[gc[gg] + 4] <- 22  for (gg) in 0 .. nggz[0] if gdk[gg] == 2      # jnz → 次の行へ
jt[gc[gg] + 4]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 2

# 種3: 比較の左辺 → rsi。**辺は場の読みとは限らない**（ok が種を言う）——
#   ok 0 場の読み / 1 表の列 / 2 区間の計数器 / 3 定数
# 以前は両辺とも場の読みしか書けず、`if k > arrow[snum[k]]` が **黙って落ちた**。
form[gc[gg]] <- frs[gdf[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
imm[gc[gg]]  <- foff[gdf[gg]] + bias[0] for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
scb[gc[gg]]  <- fscb[gdf[gg]] for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
form[gc[gg] + 1] <- 66  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
imm[gc[gg] + 1]  <- fbot[gdf[gg]]  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
form[gc[gg] + 2] <- 13  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
jt[gc[gg] + 2]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
# **比較の辺も読みである。** 階数を継がないと証明書が通らない（不変条件6）
form[gc[gg] + 3] <- 88  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
imm[gc[gg] + 3]  <- koff[gdf[gg]] + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
scb[gc[gg] + 3]  <- kscb[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
form[gc[gg] + 4] <- 89  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
imm[gc[gg] + 4]  <- koff[gdf[gg]] + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
scb[gc[gg] + 4]  <- kscb[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
form[gc[gg]] <- 133     for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 1
imm[gc[gg]]  <- gdc1[gg] * 8 + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 1
form[gc[gg]] <- 134     for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 2 if gdc1[gg] == 0
form[gc[gg]] <- 135     for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 2 if gdc1[gg] == 1
form[gc[gg]] <- 136     for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 2 if gdc1[gg] == 2
form[gc[gg]] <- 213     for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 2 if gdc1[gg] >= 3   # mov rsi,[升]
imm[gc[gg]]  <- lce[gdc1[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 2 if gdc1[gg] >= 3
form[gc[gg]] <- 132     for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 3
imm[gc[gg]]  <- gdov[gg] + bias[0]      for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 3

# 種4: 比較の右辺 → rax、そして比べ。`cmp rax,rsi` は **右 - 左** である。
#   値 1 が == / 2 が != / 3 が >= / 4 が <= / 5 が > / 6 が <
#   `cmp rsi,rax` は **左 - 右**（形67 は 48 39 C6 = cmp rsi,rax）。
#   飛ぶのは「成り立たないとき」なので条件は裏返る —— >= なら jl で飛ぶ。
#   ここを一度取り違えて、答えが綺麗に反転した（`c >= 97` が小さい方を拾った）。
form[gc[gg]] <- frd[gdf[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
imm[gc[gg]]  <- foff[gdf[gg]] + bias[0] for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
scb[gc[gg]]  <- fscb[gdf[gg]] for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
form[gc[gg] + 1] <- 12  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
imm[gc[gg] + 1]  <- fbot[gdf[gg]]  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
form[gc[gg] + 2] <- 13  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
jt[gc[gg] + 2]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
form[gc[gg] + 3] <- 88  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
imm[gc[gg] + 3]  <- koff[gdf[gg]] + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
scb[gc[gg] + 3]  <- kscb[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
form[gc[gg] + 4] <- 89  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
imm[gc[gg] + 4]  <- koff[gdf[gg]] + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
scb[gc[gg] + 4]  <- kscb[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
form[gc[gg]] <- 10      for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 1
imm[gc[gg]]  <- gdc1[gg] * 8 + bias[0]  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 1
form[gc[gg]] <- 109     for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 2 if gdc1[gg] == 0
form[gc[gg]] <- 111     for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 2 if gdc1[gg] == 1
form[gc[gg]] <- 113     for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 2 if gdc1[gg] == 2
form[gc[gg]] <- 185     for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 2 if gdc1[gg] >= 3   # mov rax,[升]
imm[gc[gg]]  <- lce[gdc1[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 2 if gdc1[gg] >= 3
form[gc[gg]] <- 2       for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 3
imm[gc[gg]]  <- gdov[gg] + bias[0]      for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 3

field gcm : max bound 16384                     # `cmp rax,rsi` の居る命令
gcm[gg] <- gc[gg] + 5 + gxr[gg] + gxp[gg]  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
gcm[gg] <- gc[gg] + 1 + gxp[gg]  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] >= 1
form[gc[gg] + 5] <- ftcs[gdf[gg]]   for (gg) in 0 .. nggz[0] if gtl[gg]   # cmp rsi, ⊤ の印（場ごと）
imm[gc[gg] + 5]  <- ftpf[gdf[gg]]   for (gg) in 0 .. nggz[0] if gtl[gg]
form[gc[gg] + 6] <- 216  for (gg) in 0 .. nggz[0] if gtl[gg]           # sete byte [旗]
form[gc[gg] + 5] <- ftca[gdf[gg]]   for (gg) in 0 .. nggz[0] if gtr[gg]   # cmp rax, ⊤ の印（場ごと）
imm[gc[gg] + 5]  <- ftpf[gdf[gg]]   for (gg) in 0 .. nggz[0] if gtr[gg]
form[gc[gg] + 6] <- 13   for (gg) in 0 .. nggz[0] if gtr[gg]           # je → 立つ
jt[gc[gg] + 6]   <- gcm[gg] + 2   for (gg) in 0 .. nggz[0] if gtr[gg]
form[gcm[gg] - 2] <- 217 for (gg) in 0 .. nggz[0] if gtp[gg]           # cmp byte [旗], 0
form[gcm[gg] - 1] <- 22  for (gg) in 0 .. nggz[0] if gtp[gg]           # jne → 立つ
jt[gcm[gg] - 1]   <- gcm[gg] + 2   for (gg) in 0 .. nggz[0] if gtp[gg]
form[gcm[gg]] <- 67     for (gg) in 0 .. nggz[0] if gdk[gg] == 4
form[gcm[gg] + 1] <- 22   for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdgv[gg] == 1
form[gcm[gg] + 1] <- 13   for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdgv[gg] == 2
form[gcm[gg] + 1] <- 115  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdgv[gg] == 3
form[gcm[gg] + 1] <- 116  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdgv[gg] == 4
form[gcm[gg] + 1] <- 131  for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdgv[gg] == 5
form[gcm[gg] + 1] <- 17   for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdgv[gg] == 6
jt[gcm[gg] + 1]   <- av[gdr[gg]]   for (gg) in 0 .. nggz[0] if gdk[gg] == 4

# ── 座標の発行。**所有者が誰でも同じ形**（項・ガード・書き先）─────────
field cb : max bound 32768                      # 座標ブロックの開始（所有者種ごと）
cb[tmoo[gt]] <- tpos[gt]      for (gt) in 0 .. ngtz[0] if tmk[gt] == 3
cb[tmoo[gt]] <- tpos[gt]      for (gt) in 0 .. ngtz[0] if tmk[gt] == 9
cb[tmoo[gt]] <- tpos[gt]      for (gt) in 0 .. ngtz[0] if tmk[gt] == 10
cb[tmoo[gt]] <- tpos[gt]      for (gt) in 0 .. ngtz[0] if tmk[gt] == 15
cb[tmoo[gt]] <- tpos[gt]      for (gt) in 0 .. ngtz[0] if tmk[gt] == 16
cb[gdoo[gg]] <- gpos[gg] + 1  for (gg) in 0 .. nggz[0] if gdk[gg] >= 2
cb[rroo[r]] <- wpos[r]                for (r) in 0 .. nrlz[0]
# 内側の所有者は、外側のスロットの位置から始まる（入れ子はそこに開く）
cb[cdcc[gc]] <- cdpos[gc]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5

field ofld : max bound 32768                    # 所有者が指している場
ofld[tmoo[gt]] <- tmf[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 3
ofld[tmoo[gt]] <- tmf[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 9
ofld[tmoo[gt]] <- tmf[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 10
ofld[tmoo[gt]] <- tmf[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 15
ofld[tmoo[gt]] <- tmf[gt]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 16
ofld[gdoo[gg]] <- gdf[gg]   for (gg) in 0 .. nggz[0] if gdk[gg] >= 2
ofld[rroo[r]] <- rrwf[r]  for (r) in 0 .. nrlz[0]
# 内側の所有者が指す場は、外側の源5 の行が言う（畳みの広さはそこから引く）
ofld[cdcc[gc]] <- cdcf[gc]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5

# 次元 d の載せ方。源は四つ ——
#   0 列 / 1 区間の計数器 / 2 列で引いた場の値 / 3 計数器で引いた場の値
# 源2・源3 が `f[g[i]]` である。**名前が座標である**をそのまま機械語にしたもの。
form[cdpos[gc]] <- 29   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 0 if not inr1[gc]
imm[cdpos[gc]]  <- cdcc[gc] * 8 + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 0 if not inr1[gc]
form[cdpos[gc]] <- 82   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 1 if cdcc[gc] == 0 if not inr1[gc]
form[cdpos[gc]] <- 104  for (gc) in 0 .. ngcz[0] if cdsr[gc] == 1 if cdcc[gc] == 1 if not inr1[gc]
form[cdpos[gc]] <- 108  for (gc) in 0 .. ngcz[0] if cdsr[gc] == 1 if cdcc[gc] == 2 if not inr1[gc]
# 段 3 からの計数器は升から載せる（長さは同じ一命令）
form[cdpos[gc]] <- 211  for (gc) in 0 .. ngcz[0] if cdsr[gc] == 1 if cdcc[gc] >= 3 if not inr1[gc]
imm[cdpos[gc]]  <- lce[cdcc[gc]]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 1 if cdcc[gc] >= 3 if not inr1[gc]
# 源4: **定数**。`tch[t,0]` の 0 が座標にならず、次元1 が黙って落ちていた ——
# 座標の源は「列・計数器・場の値」の三つだと思い込んでいた。定数も座標である。
form[cdpos[gc]] <- 138  for (gc) in 0 .. ngcz[0] if cdsr[gc] == 4 if not inr1[gc]
imm[cdpos[gc]]  <- cdcc[gc] + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 4 if not inr1[gc]

# ── 内側の次元1 以降。**逃がして・作って・濾して・戻して畳む**（r9 と升一つ）───
#  上の四つは次元0 を r9 に「載せる」。内側の次元1 以降は r9 に畳みかけがあるので、
#  まず升へ逃がし、次元0 と同じ形で r9 に作って（ずれも足して）その次元の広さで濾し、
#  xchg で畳みかけを戻して桁を上げ、作った次元を足す。濾しに落ちたら次の行（⊥）。
field cscr : max bound 1                        # 畳みの升（場の下、`gap` の余白）
cscr[z] <- bias[0] - 24   for (z) in 0 .. 0
form[cdpos[gc]] <- 188      for (gc) in 0 .. ngcz[0] if inr1[gc]   # mov [升], r9
imm[cdpos[gc]]  <- cscr[0]  for (gc) in 0 .. ngcz[0] if inr1[gc]
form[cdpos[gc] + 1] <- 29   for (gc) in 0 .. ngcz[0] if inr1[gc] if cdsr[gc] == 0
imm[cdpos[gc] + 1]  <- cdcc[gc] * 8 + bias[0]   for (gc) in 0 .. ngcz[0] if inr1[gc] if cdsr[gc] == 0
form[cdpos[gc] + 1] <- 82   for (gc) in 0 .. ngcz[0] if inr1[gc] if cdsr[gc] == 1 if cdcc[gc] == 0
form[cdpos[gc] + 1] <- 104  for (gc) in 0 .. ngcz[0] if inr1[gc] if cdsr[gc] == 1 if cdcc[gc] == 1
form[cdpos[gc] + 1] <- 108  for (gc) in 0 .. ngcz[0] if inr1[gc] if cdsr[gc] == 1 if cdcc[gc] == 2
form[cdpos[gc] + 1] <- 211  for (gc) in 0 .. ngcz[0] if inr1[gc] if cdsr[gc] == 1 if cdcc[gc] >= 3
imm[cdpos[gc] + 1]  <- lce[cdcc[gc]]   for (gc) in 0 .. ngcz[0] if inr1[gc] if cdsr[gc] == 1 if cdcc[gc] >= 3
form[cdpos[gc] + 1] <- 138  for (gc) in 0 .. ngcz[0] if inr1[gc] if cdsr[gc] == 4
imm[cdpos[gc] + 1]  <- cdcc[gc] + bias[0]   for (gc) in 0 .. ngcz[0] if inr1[gc] if cdsr[gc] == 4
form[cdpos[gc] + 2] <- 71   for (gc) in 0 .. ngcz[0] if inr1[gc] if cdhf[gc] == 1   # add r9, ずれ
imm[cdpos[gc] + 2]  <- cdof[gc] + bias[0]   for (gc) in 0 .. ngcz[0] if inr1[gc] if cdhf[gc] == 1
form[cend[gc] - 5] <- 50    for (gc) in 0 .. ngcz[0] if inr1[gc]   # cmp r9, その次元の広さ
imm[cend[gc] - 5]  <- fw[oflg[gc], csd[gc]] + bias[0]   for (gc) in 0 .. ngcz[0] if inr1[gc]
form[cend[gc] - 4] <- 73    for (gc) in 0 .. ngcz[0] if inr1[gc]   # jae 次の行
jt[cend[gc] - 4]   <- av[cdr[gc]]   for (gc) in 0 .. ngcz[0] if inr1[gc]
form[cend[gc] - 3] <- 189   for (gc) in 0 .. ngcz[0] if inr1[gc]   # xchg r9, [升]
imm[cend[gc] - 3]  <- cscr[0]   for (gc) in 0 .. ngcz[0] if inr1[gc]
form[cend[gc] - 2] <- 169   for (gc) in 0 .. ngcz[0] if inr1[gc]   # imul r9, 広さ
imm[cend[gc] - 2]  <- fw[oflg[gc], csd[gc]] + bias[0]   for (gc) in 0 .. ngcz[0] if inr1[gc]
form[cend[gc] - 1] <- 190   for (gc) in 0 .. ngcz[0] if inr1[gc]   # add r9, [升]
imm[cend[gc] - 1]  <- cscr[0]   for (gc) in 0 .. ngcz[0] if inr1[gc]

# ── 否定のガードの下の ⊥ ──────────────────────────────────────────
# `if not g[f[i]]` で `f[i]` が ⊥ のとき、g の **どの升も読まれていない** ——
# 撃たない（座標の ⊥ 検査は「次の行へ」のままでよい）。以前ここに「撃つ」と
# 書いてあったのは解釈実行の誤りに合わせた読みで、直すべきは解釈実行だった
# （d475c0a）。**座標が値を持って広さの外にある**ときは別で、そこは升が ⊥ なので
# `not` は立つ —— 下の濾しの飛び先 `gpas` がそれである。

# ── 源5: 内側の所有者が座標を作り終えた所で読む ──────────────────
field inrd : max bound 32768                    # 読みの命令の位置
inrd[gc] <- cdpos[gc] + ctot[cdcc[gc]]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
form[inrd[gc]] <- 88   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5     # cmp r11d,[K_cf]（階数を継ぐ）
imm[inrd[gc]]  <- koff[cdcf[gc]] + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
scb[inrd[gc]]  <- kscb[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
form[inrd[gc] + 1] <- 89   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5 # cmovb r11d,[K_cf]
imm[inrd[gc] + 1]  <- koff[cdcf[gc]] + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
scb[inrd[gc] + 1]  <- kscb[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
form[inrd[gc] + 2] <- fcr[cdcf[gc]]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
imm[inrd[gc] + 2]  <- foff[cdcf[gc]] + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
scb[inrd[gc] + 2]  <- fscb[cdcf[gc]] for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
form[inrd[gc] + 3] <- 50   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
imm[inrd[gc] + 3]  <- fbot[cdcf[gc]]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
form[inrd[gc] + 4] <- 13   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
jt[inrd[gc] + 4]   <- av[cdr[gc]]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
form[cdpos[gc]] <- 29   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 2
imm[cdpos[gc]]  <- cdcc[gc] * 8 + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 2
form[cdpos[gc]] <- 82   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 3 if cdcc[gc] == 0
form[cdpos[gc]] <- 104  for (gc) in 0 .. ngcz[0] if cdsr[gc] == 3 if cdcc[gc] == 1
form[cdpos[gc]] <- 108  for (gc) in 0 .. ngcz[0] if cdsr[gc] == 3 if cdcc[gc] == 2
form[cdpos[gc]] <- 211  for (gc) in 0 .. ngcz[0] if cdsr[gc] == 3 if cdcc[gc] >= 3
imm[cdpos[gc]]  <- lce[cdcc[gc]]   for (gc) in 0 .. ngcz[0] if cdsr[gc] == 3 if cdcc[gc] >= 3
# **源2/3 は座標を二つ持つ** —— 内側の添字（`g[i]` の i）と、読んだ値（外の座標）。
# 読んだ値は下の濾しが見るが、**内側の添字を濾していたのは前置のずれ（`g[i+2]`）の
# ときだけ**だった。ずれの無い `f[g[i]]` で i が g の広さを超えると、g の後ろの升
# （隣の場や階数）を読んで、その数を外の座標にしていた —— 解釈実行は ⊥ なのに
# `x[i] <- f[g[i]]` が 7 を答えた（撒いて出した。座標の濾しと同じ穴の、内側の半分）。
# 形は一つにする: 載せる → 前置のずれ（無ければ 0）→ 内側の広さで濾す → 読む → ⊥ で抜ける。
form[cdpos[gc] + 1] <- 71   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3  # add r9, 前置のずれ
imm[cdpos[gc] + 1]  <- cdof[gc] + bias[0]  for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3 if cdhf[gc] == 2
imm[cdpos[gc] + 1]  <- bias[0]  for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3 if cdhf[gc] <= 1
form[cdpos[gc] + 2] <- 50   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3  # cmp r9, 内側の広さ
imm[cdpos[gc] + 2]  <- fw[cdcf[gc],0] + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
form[cdpos[gc] + 3] <- 73   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
jt[cdpos[gc] + 3]   <- av[cdr[gc]]   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
# 階数（項の読みと同じ二命令。r9 はまだ内側の升の番号を持っている —— 読む前に継ぐ）
form[cdpos[gc] + 4] <- 88   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3  # cmp r11d,[K_cf]
imm[cdpos[gc] + 4]  <- koff[cdcf[gc]] + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
scb[cdpos[gc] + 4]  <- kscb[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
form[cdpos[gc] + 5] <- 89   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3  # cmovb r11d,[K_cf]
imm[cdpos[gc] + 5]  <- koff[cdcf[gc]] + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
scb[cdpos[gc] + 5]  <- kscb[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
form[cdpos[gc] + 6] <- fcr[cdcf[gc]]  for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3  # mov r9,[F_cf]
imm[cdpos[gc] + 6]  <- foff[cdcf[gc]] + bias[0]   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
scb[cdpos[gc] + 6]  <- fscb[cdcf[gc]] for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
form[cdpos[gc] + 7] <- 50   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3  # cmp r9, ⊥
imm[cdpos[gc] + 7]  <- fbot[cdcf[gc]]   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
form[cdpos[gc] + 8] <- 13   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
jt[cdpos[gc] + 8]   <- av[cdr[gc]]   for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3

# 座標のずれ（鎖）。範囲の外は ⊥ —— unsigned 比較が負も上も捕まえる

# スロットの終わり
field cend : max bound 32768
cend[gc] <- cdpos[gc] + clen[gc]   for (gc) in 0 .. ngcz[0]
form[cend[gc] - 3] <- 71   for (gc) in 0 .. ngcz[0] if cdhf[gc] == 1 if not inr1[gc]
imm[cend[gc] - 3]  <- cdof[gc] + bias[0]  for (gc) in 0 .. ngcz[0] if cdhf[gc] == 1 if not inr1[gc]
form[cend[gc] - 2] <- 50   for (gc) in 0 .. ngcz[0] if cchk[gc]
imm[cend[gc] - 2]  <- fw[oflg[gc], csd[gc]] + bias[0]  for (gc) in 0 .. ngcz[0] if cchk[gc]
form[cend[gc] - 1] <- 73   for (gc) in 0 .. ngcz[0] if cchk[gc]
# **はみ出したときにどこへ飛ぶかは、座標が読みか書きかで違う。**
#   読みの座標 … そこに値は無い（⊥）。次の行へ。解釈実行と同じである。
#   書きの座標 … **宣言が嘘だった**。場の番号を言って止まる（`stub` が
#                 r15 に場を入れて出口へ飛ぶ。終了コード 6）。
# 解釈実行は宣言の広さを見ずに書くので、書きの側で黙るのが一番悪い。
field iswro : or bound 32768                    # 書き先の座標を持つ所有者
iswro[rroo[r]] <- true   for (r) in 0 .. nrlz[0] if rroo[r] >= 0
#   否定のガードの座標 … そこに値は無い（⊥）のだから `not` は **立つ**。ガードの後ろへ。
#                 座標そのものが ⊥ なのとは違う —— そちらは升を一つも読んでいない
#                 ので立たない（⊥ の検査が次の行へ飛ばす）。内側の読みの座標が
#                 はみ出せば内側が ⊥ になり、外の座標が ⊥ になる —— 内側の所有者は
#                 否定のガードではないので、ここには来ない。
#                 （`if i >= 0 … if not isw[i-1]` の i = 0 で、解釈実行は立ち、焼いた側は
#                 次の行へ飛んでいた。`test/mutate.py` が撒いて出した。）
field isngo : or bound 32768                    # 否定のガードの所有者
isngo[gdoo[gg]] <- true  for (gg) in 0 .. nggz[0] if gdk[gg] == 2
field gpas : max bound 32768                    # そのガードの後ろ（立ったときの行き先）
gpas[gdoo[gg]] <- gpos[gg] + glen[gg] + 1   for (gg) in 0 .. nggz[0] if gdk[gg] == 2
jt[cend[gc] - 1]   <- av[cdr[gc]]    for (gc) in 0 .. ngcz[0] if cchk[gc]
      if not iswro[cso[gc]] if not isngo[cso[gc]]
jt[cend[gc] - 1]   <- gpas[cso[gc]]  for (gc) in 0 .. ngcz[0] if cchk[gc]
      if isngo[cso[gc]]
jt[cend[gc] - 1]   <- ovs[rrwf[cdr[gc]]]  for (gc) in 0 .. ngcz[0] if cchk[gc]
      if iswro[cso[gc]]

# 次元をまたぐ畳み: r12 に溜めて、掛けて足す（次元は何本でも並ぶ）。
# **内側の所有者はここを通らない** —— 内側は外側の畳みの最中に評価されるので、
# r12 に触れば外側の桁が消える（`o[p[i,j]]` が segfault した）。内側は r9 だけ。
form[cdpos[gc] - 2] <- 96   for (gc) in 0 .. ngcz[0] if csd[gc] == 1    # mov r12,r9（d==1 のとき）
      if not isin[cso[gc]]
form[cdpos[gc] - 1] <- 97   for (gc) in 0 .. ngcz[0] if csd[gc] > 0    # imul r12, 次元の広さ
      if not isin[cso[gc]]
imm[cdpos[gc] - 1]  <- fw[oflg[gc], csd[gc]] + bias[0]   for (gc) in 0 .. ngcz[0] if csd[gc] > 0
      if not isin[cso[gc]]
form[cend[gc]] <- 98   for (gc) in 0 .. ngcz[0] if csd[gc] > 0   # add r12,r9
      if not isin[cso[gc]]

# 所有者の座標のあと
field ccp : max bound 32768
ccp[gc] <- cb[cso[gc]] + ctot[cso[gc]]  for (gc) in 0 .. ngcz[0]
form[ccp[gc] - 1] <- 99   for (gc) in 0 .. ngcz[0] if csd[gc] > 0      # mov r9,r12
      if not isin[cso[gc]]

# ── 項の発行。**値も式である** —— 定数・列・場の読みが行として並ぶ ─────
# 一つの規則にいくつでも並ぶ。最初の項が置き、あとの項が足す。
# 場の読みは ⊥ で次の行へ飛び、階数の最大を r11 に溜める（cmovb —— 符号なしで比べる。分岐しない）。
form[bb[r]] <- 90   for (r) in 0 .. nrlz[0]      # xor r11,r11（階数の最大。**ガードより前**）

# 種1: 定数
form[tpos[gt]] <- 2   for (gt) in 0 .. ngtz[0] if tmk[gt] == 1
imm[tpos[gt]]  <- tmv[gt] + bias[0]  for (gt) in 0 .. ngtz[0] if tmk[gt] == 1

# 種2: 表の列
form[tpos[gt]] <- 10  for (gt) in 0 .. ngtz[0] if tmk[gt] == 2
imm[tpos[gt]]  <- tmc1[gt] * 8 + bias[0]  for (gt) in 0 .. ngtz[0] if tmk[gt] == 2

# 種5: 定数を **引く**（`pre[i-1] - 1`）。最初の項が引き算になることは**ある**（`-5`）——
# その符号は群0 の終わりの `imul rax, -1` が持つ（`tneg0`）
form[tpos[gt]] <- 2    for (gt) in 0 .. ngtz[0] if tmk[gt] == 5      # mov rax, 定数（引くのは群の符号）
imm[tpos[gt]]  <- tmv[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 5
# 種6: 掛ける定数。**数を読むのに要る** —— `n[i-1] * 10 + d` が桁を積む形である
form[tpos[gt]] <- 137  for (gt) in 0 .. ngtz[0] if tmk[gt] == 6      # imul rax, 定数
imm[tpos[gt]]  <- tmv[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 6
# **掛けたら溢れを見る。** 解釈実行は多倍長で持つ。焼いた符号は 64 ビットで折り返し、
# `f[i] <- f[i-1] * 3` の四十段目から **もっともらしい違う数**を出していた。
# imul は符号つきで収まらないと OF を立てる —— jo で場ごとの踏み台へ（終了コード 3）。
# 足し引き（群の境目の add/sub [和]）と sum の join も同じ。右シフトと and は溢れない。
field ismul : or bound 16384                    # 掛ける項（jo を連れる。種10 は別の位置）
ismul[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 6
ismul[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 12
ismul[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 14
form[tpos[gt] + 1] <- 191  for (gt) in 0 .. ngtz[0] if ismul[gt]     # jo → 溢れの踏み台
jt[tpos[gt] + 1]   <- osf[rrwf[tmr[gt]]]   for (gt) in 0 .. ngtz[0] if ismul[gt]

# 種7/8: **二のべきで割る / 余りを取る**（`imm[n] / 256 % 256`）——
# バイトを取り出すのに要る。割り算は算術右シフト（負でも床に落ちる。Python の
# `//` と同じ）、余りは and（二のべきの余りは下位ビットそのもの）。
# 何ビット寄せるかは定数そのものではなく **その対数**なので、二のべきの鎖で引く。
field pw : max bound 63                      # 2 のべき（鎖）。**2^62 まで** —— 前は 2^36 で止まり、
                                             # 2^40 で割る源を「二のべきでない除数」と言っていた（嘘の理由）
pw[0] <- 1
pw[k] <- pw[k-1] * 2                for (k) in 1 .. 62
field shf : max bound 16384                     # 項 t の右シフト量
shf[gt] <- k  for (gt) in 0 .. ngtz[0] for (k) in 0 .. 62
      if tmk[gt] == 7 if pw[k] == tmv[gt]
shf[gt] <- k  for (gt) in 0 .. ngtz[0] for (k) in 0 .. 62
      if tmk[gt] == 8 if pw[k] == tmv[gt]
form[tpos[gt]] <- 139  for (gt) in 0 .. ngtz[0] if tmk[gt] == 7 if ispw[gt]      # sar rax, k
imm[tpos[gt]]  <- shf[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 7
form[tpos[gt]] <- 140  for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if shf[gt] <= 31   # and rax, 2^k - 1
imm[tpos[gt]]  <- tmv[gt] - 1 + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if shf[gt] <= 31
form[tpos[gt]] <- 197  for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if shf[gt] >= 32   # shl rax, 64 - k
imm[tpos[gt]]  <- 64 - shf[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if shf[gt] >= 32
form[tpos[gt] + 1] <- 198  for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if shf[gt] >= 32   # shr rax, 64 - k
imm[tpos[gt] + 1]  <- 64 - shf[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if shf[gt] >= 32
# 二のべきでない正の除数は idiv で割る（上の形 208–210）。
form[tpos[gt]] <- 36   for (gt) in 0 .. ngtz[0] if tmk[gt] == 7 if not ispw[gt] if not dvbad[gt]   # mov rsi, d
imm[tpos[gt]]  <- tmv[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 7 if not ispw[gt] if not dvbad[gt]
form[tpos[gt] + 1] <- 208  for (gt) in 0 .. ngtz[0] if tmk[gt] == 7 if not ispw[gt] if not dvbad[gt]
form[tpos[gt]] <- 36   for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if not ispw[gt] if not dvbad[gt]   # mov rsi, d
imm[tpos[gt]]  <- tmv[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if not ispw[gt] if not dvbad[gt]
form[tpos[gt] + 1] <- 209  for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if not ispw[gt] if not dvbad[gt]
form[tpos[gt] + 2] <- 210  for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if not ispw[gt] if not dvbad[gt]
# **焼けないのは 0 と負と、即値に入らない除数だけ**（理由 5）。前は二のべきでない除数を
# 全部断っていた —— 右シフトと and に落とせないので、
# `c / 3` は寄せ量が ⊥ になって **割り算そのものが消えていた**（97 が 97 のまま）、
# `c % 3` は `and rax,2` になって別の答えを出していた。黙って間違えるより言う。
field ispw : or bound 16384                     # その定数は二のべきか
ispw[gt] <- true  for (gt) in 0 .. ngtz[0] for (k) in 0 .. 62 if pw[k] == tmv[gt]

# 種4: 計数器そのものが値（`aid[j] <- i`）—— 座標が値になる
form[tpos[gt]] <- 109  for (gt) in 0 .. ngtz[0] if tmk[gt] == 4 if tmc1[gt] == 0
form[tpos[gt]] <- 111  for (gt) in 0 .. ngtz[0] if tmk[gt] == 4 if tmc1[gt] == 1
form[tpos[gt]] <- 113  for (gt) in 0 .. ngtz[0] if tmk[gt] == 4 if tmc1[gt] == 2
form[tpos[gt]] <- 185  for (gt) in 0 .. ngtz[0] if tmk[gt] == 4 if tmc1[gt] >= 3     # mov rax,[升]
imm[tpos[gt]]  <- lce[tmc1[gt]]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 4 if tmc1[gt] >= 3

# 種11/12: 表の列を **引く / 掛ける**（行は rcx。ずれは 8*列）
form[tpos[gt]] <- 10   for (gt) in 0 .. ngtz[0] if tmk[gt] == 11    # mov rax,[列]（引くのは群の符号）
imm[tpos[gt]]  <- tmc18[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 11
form[tpos[gt]] <- 148  for (gt) in 0 .. ngtz[0] if tmk[gt] == 12
imm[tpos[gt]]  <- tmc18[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 12
# 種13/14: 区間の計数器を **引く / 掛ける**（0番=rcx / 1番=r13 / 2番=r14）
form[tpos[gt]] <- 109  for (gt) in 0 .. ngtz[0] if tmk[gt] == 13 if tmc1[gt] == 0
form[tpos[gt]] <- 111  for (gt) in 0 .. ngtz[0] if tmk[gt] == 13 if tmc1[gt] == 1
form[tpos[gt]] <- 113  for (gt) in 0 .. ngtz[0] if tmk[gt] == 13 if tmc1[gt] == 2
form[tpos[gt]] <- 185  for (gt) in 0 .. ngtz[0] if tmk[gt] == 13 if tmc1[gt] >= 3
imm[tpos[gt]]  <- lce[tmc1[gt]]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 13 if tmc1[gt] >= 3
form[tpos[gt]] <- 150  for (gt) in 0 .. ngtz[0] if tmk[gt] == 14 if tmc1[gt] == 0
form[tpos[gt]] <- 152  for (gt) in 0 .. ngtz[0] if tmk[gt] == 14 if tmc1[gt] == 1
form[tpos[gt]] <- 154  for (gt) in 0 .. ngtz[0] if tmk[gt] == 14 if tmc1[gt] == 2
form[tpos[gt]] <- 212  for (gt) in 0 .. ngtz[0] if tmk[gt] == 14 if tmc1[gt] >= 3     # imul rax,[升]
imm[tpos[gt]]  <- lce[tmc1[gt]]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 14 if tmc1[gt] >= 3

# 種3 / 種9: 場の読み。座標は crd が出す。値 → ⊥検査 → **足すか引くか** → 階数
# 引く方（種9）が要ったのは `rel[n] <- off[jt[n]] - off[n] - ilen[n]` である ——
# 足せるのに引けないのは分類の穴で、命令は一つ（sub rax,rsi）しか違わない。
field isrd : or bound 16384                     # 場を読む項（足す・引くの両方）
isrd[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 3
isrd[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 9
isrd[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 10
isrd[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 15
isrd[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 16
field tc : max bound 16384                      # 項 t の中身の位置（座標のあと）
tc[gt] <- tpos[gt] + ctot[tmoo[gt]]   for (gt) in 0 .. ngtz[0] if isrd[gt]

form[tc[gt]] <- frs[tmf[gt]]   for (gt) in 0 .. ngtz[0] if isrd[gt]
imm[tc[gt]]  <- foff[tmf[gt]] + bias[0] for (gt) in 0 .. ngtz[0] if isrd[gt]
scb[tc[gt]]  <- fscb[tmf[gt]] for (gt) in 0 .. ngtz[0] if isrd[gt]
form[tc[gt] + 1] <- 66  for (gt) in 0 .. ngtz[0] if isrd[gt]
imm[tc[gt] + 1]  <- fbot[tmf[gt]]  for (gt) in 0 .. ngtz[0] if isrd[gt]
form[tc[gt] + 2] <- 13  for (gt) in 0 .. ngtz[0] if isrd[gt]
jt[tc[gt] + 2]   <- av[tmr[gt]]   for (gt) in 0 .. ngtz[0] if isrd[gt]
form[tcv[gt] + 3] <- 85  for (gt) in 0 .. ngtz[0] if tmk[gt] == 3
form[tcv[gt] + 3] <- 85  for (gt) in 0 .. ngtz[0] if tmk[gt] == 9   # mov rax,rsi（引くのは群の符号）
# **掛けられるのに掛けられないのは分類の穴だった。** 場と場の積は
# 二次元の畳みの掛け数（`fw[f,0] * fw[f,1]`）に要る —— 命令は一つ。
form[tcv[gt] + 3] <- 146 for (gt) in 0 .. ngtz[0] if tmk[gt] == 10  # imul rax, rsi
# 種10 は imul の直後に jo を置く（階数の cmp が旗を潰すので、その前）。階数の二命令は一つ後ろへ
form[tcv[gt] + 4] <- 191  for (gt) in 0 .. ngtz[0] if tmk[gt] == 10      # jo → 溢れの踏み台
jt[tcv[gt] + 4]   <- osf[rrwf[tmr[gt]]]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 10
field trk : max bound 16384                     # 項 gt の階数の二命令の位置
trk[gt] <- tcv[gt] + 4   for (gt) in 0 .. ngtz[0] if isrd[gt]
trk[gt] <- tcv[gt] + 5   for (gt) in 0 .. ngtz[0] if tmk[gt] == 10
# **種15 / 16: 場で割る・余りを取る**（14f）。割る数（rsi）が 0 なら ⊥ —— 実例は撃たない（解釈実行の
# 「零除算は誤りではなく未定」）。ただし **⊤ は ⊥ より強い**（解釈実行は ⊤ を先に見る: `⊤ / 0` は ⊤）ので、
# 書き先が flat で項の旗（⊤ を読んだ）が立っていれば、割る数を 1 にして続ける（値は最後に ⊤ に替わる）。
# ⊤ の見張りは ⊤ の割る数を 0 にする（xor esi, esi）ので、⊤ の割る数もこの道を通る。
field tdiv : or bound 16384                     # 場で割る・余りを取る項
tdiv[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 15
tdiv[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 16
# **種17〜20: 変数（列・計数器）で割る**（14j）。0 の検査から後ろは種15 / 16 と同じ形 —— 違うのは
# 割る数を rsi へ置く一命令だけで、場の読み（座標・⊥・⊤ の見張り・階数）が無い。
tdiv[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 17
tdiv[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 18
tdiv[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 19
tdiv[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 20
field tvdv : or bound 16384                     # 変数で割る項
tvdv[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] >= 17 if tmk[gt] <= 20
tcv[gt] <- tpos[gt] - 2   for (gt) in 0 .. ngtz[0] if tvdv[gt]     # 0 の検査を tpos + 1 に置く
form[tpos[gt]] <- 236   for (gt) in 0 .. ngtz[0] if tmk[gt] == 17        # mov rsi, [rcx+列]
imm[tpos[gt]]  <- tmc18[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 17
form[tpos[gt]] <- 236   for (gt) in 0 .. ngtz[0] if tmk[gt] == 18
imm[tpos[gt]]  <- tmc18[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if tmk[gt] == 18
form[tpos[gt]] <- 237   for (gt) in 0 .. ngtz[0] if tmk[gt] >= 19 if tmk[gt] <= 20 if tmc1[gt] == 0
form[tpos[gt]] <- 238   for (gt) in 0 .. ngtz[0] if tmk[gt] >= 19 if tmk[gt] <= 20 if tmc1[gt] == 1
form[tpos[gt]] <- 239   for (gt) in 0 .. ngtz[0] if tmk[gt] >= 19 if tmk[gt] <= 20 if tmc1[gt] == 2
form[tpos[gt]] <- 213   for (gt) in 0 .. ngtz[0] if tmk[gt] >= 19 if tmk[gt] <= 20 if tmc1[gt] >= 3   # mov rsi, [升]
imm[tpos[gt]]  <- lce[tmc1[gt]]   for (gt) in 0 .. ngtz[0] if tmk[gt] >= 19 if tmk[gt] <= 20 if tmc1[gt] >= 3
field tzl : max bound 16384                     # 割る数の 0 の検査の命令数
tzl[gt] <- 2   for (gt) in 0 .. ngtz[0] if tdiv[gt] if not rtv[tmr[gt]]
tzl[gt] <- 5   for (gt) in 0 .. ngtz[0] if tdiv[gt] if rtv[tmr[gt]]
field tdv : max bound 16384                     # 割る形の位置
tdv[gt] <- tcv[gt] + 3 + tzl[gt]   for (gt) in 0 .. ngtz[0] if tdiv[gt]
form[tcv[gt] + 3] <- 230   for (gt) in 0 .. ngtz[0] if tdiv[gt]                         # test rsi, rsi
form[tcv[gt] + 4] <- 13    for (gt) in 0 .. ngtz[0] if tdiv[gt] if not rtv[tmr[gt]]    # je → 次の実例（⊥）
jt[tcv[gt] + 4]   <- av[tmr[gt]]   for (gt) in 0 .. ngtz[0] if tdiv[gt] if not rtv[tmr[gt]]
form[tcv[gt] + 4] <- 22    for (gt) in 0 .. ngtz[0] if tdiv[gt] if rtv[tmr[gt]]        # jne → 割る
jt[tcv[gt] + 4]   <- tdv[gt]   for (gt) in 0 .. ngtz[0] if tdiv[gt] if rtv[tmr[gt]]
form[tcv[gt] + 5] <- 220   for (gt) in 0 .. ngtz[0] if tdiv[gt] if rtv[tmr[gt]]        # cmp byte [旗], 0
form[tcv[gt] + 6] <- 13    for (gt) in 0 .. ngtz[0] if tdiv[gt] if rtv[tmr[gt]]        # je → 次の実例（⊥）
jt[tcv[gt] + 6]   <- av[tmr[gt]]   for (gt) in 0 .. ngtz[0] if tdiv[gt] if rtv[tmr[gt]]
form[tcv[gt] + 7] <- 36    for (gt) in 0 .. ngtz[0] if tdiv[gt] if rtv[tmr[gt]]        # mov rsi, 1（⊤ は続ける）
imm[tcv[gt] + 7]  <- 1 + bias[0]   for (gt) in 0 .. ngtz[0] if tdiv[gt] if rtv[tmr[gt]]
# 割る形の頭に -1 の検査（14j）: 商は 240 / jo / 242 の三つ、余りは 243 の一つ
field tdq : or bound 16384                      # 商（種15 / 17 / 19）
tdq[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 15
tdq[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 17
tdq[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 19
field tdr : or bound 16384                      # 余り（種16 / 18 / 20）
tdr[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 16
tdr[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 18
tdr[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 20
form[tdv[gt]] <- 240       for (gt) in 0 .. ngtz[0] if tdq[gt]    # cmp rsi,-1 ; jne ; neg rax
form[tdv[gt] + 1] <- 191   for (gt) in 0 .. ngtz[0] if tdq[gt]    # jo → 溢れの踏み台（INT64_MIN）
jt[tdv[gt] + 1]   <- osf[rrwf[tmr[gt]]]   for (gt) in 0 .. ngtz[0] if tdq[gt]
form[tdv[gt] + 2] <- 242   for (gt) in 0 .. ngtz[0] if tdq[gt]    # jmp → 割る二つの後ろ
form[tdv[gt] + 3] <- 231   for (gt) in 0 .. ngtz[0] if tdq[gt]    # cqo ; idiv ; 割り切れたら飛ぶ
form[tdv[gt] + 4] <- 232   for (gt) in 0 .. ngtz[0] if tdq[gt]    # 床へ寄せる
form[tdv[gt]] <- 243       for (gt) in 0 .. ngtz[0] if tdr[gt]    # cmp rsi,-1 ; jne ; xor eax,eax ; jmp
form[tdv[gt] + 1] <- 233   for (gt) in 0 .. ngtz[0] if tdr[gt]    # cqo ; idiv ; 余りを rax へ
form[tdv[gt] + 2] <- 234   for (gt) in 0 .. ngtz[0] if tdr[gt]    # 余り 0 なら飛ぶ
form[tdv[gt] + 3] <- 235   for (gt) in 0 .. ngtz[0] if tdr[gt]    # 符号を割る数に合わせる
trk[gt] <- tdv[gt] + 5     for (gt) in 0 .. ngtz[0] if tmk[gt] == 15
trk[gt] <- tdv[gt] + 4     for (gt) in 0 .. ngtz[0] if tmk[gt] == 16
form[trk[gt]] <- 88  for (gt) in 0 .. ngtz[0] if isrd[gt]
imm[trk[gt]]  <- koff[tmf[gt]] + bias[0]  for (gt) in 0 .. ngtz[0] if isrd[gt]
scb[trk[gt]]  <- kscb[0]  for (gt) in 0 .. ngtz[0] if isrd[gt]
form[trk[gt] + 1] <- 89  for (gt) in 0 .. ngtz[0] if isrd[gt]
imm[trk[gt] + 1]  <- koff[tmf[gt]] + bias[0]  for (gt) in 0 .. ngtz[0] if isrd[gt]
scb[trk[gt] + 1]  <- kscb[0]  for (gt) in 0 .. ngtz[0] if isrd[gt]

# ══ ⊤ の規律（13e）══════════════════════════════════════════════════
# 焼いた符号は ⊤ の印（0x7ffffffe）を **ただの数**として読んでいたので、印が比較・算術で
# 読まれる場は「⊤ に達したら止まる」ことで守っていた（終了コード 5）。答えの定義は違う ——
# **算術は ⊤ 厳密**（読みの一つが ⊤ なら値は ⊤。ただし他の読みが ⊥ なら撃たない）、
# **比較は ⊤ で立つ**（⊤ は「少なくとも真」。そうでなければ述語は単調でない）。
# 定数伝播は「経路が食い違えば ⊤」をこの二つで運ぶ（29_dataflow）。
#
# 項: flat の場を数として読む項（素の写しでない）は、⊥ の検査のあとで ⊤ も見る（四命令）。
#   書き先が flat → 旗を立て、rsi を 0 にして続ける（溢れも割り算も起こさない）。
#     全部の読みが済んだら（⊥ ならその前に抜けている）、旗が立っていれば値を ⊤ にして join へ。
#     旗は実例ごとに項の前で下ろす —— 抜けた実例の旗が次の実例に残らない。
#   書き先が min / max / sum / count（14v）→ flat と同じく旗で運ぶ。値は書き先の ⊤ の印（下の tcar）。
#   書き先が ⊤ を運べない（座標などで誤読される数の場・or）→ **読む前に止まって言う**（前は join で
#     止まっていた。読む時に止めれば、`if not` で ⊤ の升を避けた読みは止まらない —— print がそれを使う）。
# **⊤ になりうる場だけを見張る。** flat の場でも、規則が書かず種が衝突しない場（下ろした表の列
# `_t<k>c<j>` がそれ —— 升ごとに種が一つ）は ⊤ にならない。見張れば四命令ずつ膨らむだけである。
field fwr : or bound 2048                       # 場 f は規則が書く
fwr[rrwf[r]] <- true   for (r) in 0 .. nrlz[0]
field fsjt : or bound 2048                      # 場 f の種が衝突する（flat なら ⊤）
fsjt[sdf[s]] <- true   for (s) in 0 .. nsdz[0] if sjfl[s]
field ftc : or bound 2048                       # 場 f は ⊤ になりうる
ftc[f] <- true   for (f) in 0 .. nflz[0] if fdlat[f] == 6 if fwr[f]
ftc[f] <- true   for (f) in 0 .. nflz[0] if fdlat[f] == 6 if fsjt[f]
# **数の場も ⊤ になる**（14v）: ⊤ を読んだ値を運ぶ規則が書く min / max の場（答えの定義は ⊤ をどの束へも
# 運ぶ —— ⊤ は「どの束でもいちばん上」なので吸収する）。読む場が ⊤ になりうるかが、書く場へ移る（輪で閉じる）
ftc[rrwf[r]] <- true   for (r) in 0 .. nrlz[0] if rtv[r] if rrlt[r] == 1
ftc[rrwf[r]] <- true   for (r) in 0 .. nrlz[0] if rtv[r] if rrlt[r] == 2
ftc[rrwf[r]] <- true   for (r) in 0 .. nrlz[0] if rtv[r] if rrlt[r] == 8
field ttop : or bound 16384                     # 項 gt は ⊤ になりうる場を数として読む
ttop[gt] <- true   for (gt) in 0 .. ngtz[0] if isrd[gt] if ftc[tmf[gt]] if not tcopy[gt]
field tvk : max bound 16384                     # その見張りの命令数
tvk[gt] <- 0       for (gt) in 0 .. ngtz[0] if not ttop[gt]
tvk[gt] <- 4       for (gt) in 0 .. ngtz[0] if ttop[gt]
field tcv : max bound 16384                     # 見張りのあとの位置（前の `tc + 3` の手前）
tcv[gt] <- tc[gt] + tvk[gt]   for (gt) in 0 .. ngtz[0] if isrd[gt]
# **⊤ を運べる書き先**（14v）: flat と、min / max（印は束の順の端）と、count（値を見ない —— ⊤ も一つと数える）。
# 書き先の ⊤ が座標・区間の上端・描画で誤読される場（tdang）なら、数の場は運ばずに読む前に止まって言う
# （flat は join で ⊤ を作ったときに止まる —— frdr）。sum は足すので端では吸収しない —— join が升の ⊤ を見て
# 足さずに抜け、⊤ の寄与（旗が立っている）は ⊤ の印を置く（下の「sum の ⊤」）
field tcar : or bound 16384                     # 規則 r は ⊤ を値として書き先へ運べる
tcar[r] <- true   for (r) in 0 .. nrlz[0] if rrlt[r] == 6
tcar[r] <- true   for (r) in 0 .. nrlz[0] if rrlt[r] == 1 if not tdang[rrwf[r]]
tcar[r] <- true   for (r) in 0 .. nrlz[0] if rrlt[r] == 2 if not tdang[rrwf[r]]
tcar[r] <- true   for (r) in 0 .. nrlz[0] if rrlt[r] == 9
tcar[r] <- true   for (r) in 0 .. nrlz[0] if rrlt[r] == 8 if not tdang[rrwf[r]]
field rtv : or bound 16384                      # 規則 r は ⊤ を値として運ぶ
rtv[tmr[gt]] <- true   for (gt) in 0 .. ngtz[0] if ttop[gt] if tcar[tmr[gt]]
field trs : max bound 16384                     # 項の前で旗を下ろす一命令
trs[r] <- 0        for (r) in 0 .. nrlz[0] if not rtv[r]
trs[r] <- 1        for (r) in 0 .. nrlz[0] if rtv[r]
field tvx : max bound 16384                     # join の前で旗を見る四命令
tvx[r] <- 0        for (r) in 0 .. nrlz[0] if not rtv[r]
tvx[r] <- 4        for (r) in 0 .. nrlz[0] if rtv[r]
form[tc[gt] + 3] <- ftcs[tmf[gt]]   for (gt) in 0 .. ngtz[0] if ttop[gt]   # cmp rsi, ⊤ の印（読む場の印）
imm[tc[gt] + 3]  <- ftpf[tmf[gt]]   for (gt) in 0 .. ngtz[0] if ttop[gt]
form[tc[gt] + 4] <- 22   for (gt) in 0 .. ngtz[0] if ttop[gt]          # jne → 見張りの後ろ
jt[tc[gt] + 4]   <- tcv[gt] + 3   for (gt) in 0 .. ngtz[0] if ttop[gt]
form[tc[gt] + 5] <- 218  for (gt) in 0 .. ngtz[0] if ttop[gt] if tcar[tmr[gt]]       # 旗を立てる
form[tc[gt] + 6] <- 57   for (gt) in 0 .. ngtz[0] if ttop[gt] if tcar[tmr[gt]]       # xor esi, esi
form[tc[gt] + 5] <- 162  for (gt) in 0 .. ngtz[0] if ttop[gt] if not tcar[tmr[gt]]   # mov r15d, 場番号
imm[tc[gt] + 5]  <- tmf[gt] + bias[0]   for (gt) in 0 .. ngtz[0] if ttop[gt] if not tcar[tmr[gt]]
form[tc[gt] + 6] <- 78   for (gt) in 0 .. ngtz[0] if ttop[gt] if not tcar[tmr[gt]]   # jmp → ⊤ の出口
jt[tc[gt] + 6]   <- tpx[0]   for (gt) in 0 .. ngtz[0] if ttop[gt] if not tcar[tmr[gt]]
form[tb[r] - 1] <- 219   for (r) in 0 .. nrlz[0] if rtv[r]              # 旗を下ろす
field tvp : max bound 16384                     # join の前の四命令の位置（書き座標のあと）
tvp[r] <- wpos[r] + 1 + wof[r]   for (r) in 0 .. nrlz[0] if rtv[r]
form[tvp[r]]     <- 220  for (r) in 0 .. nrlz[0] if rtv[r]              # cmp byte [旗], 0
form[tvp[r] + 1] <- 13   for (r) in 0 .. nrlz[0] if rtv[r]              # je → 値の見張り
jt[tvp[r] + 1]   <- tvp[r] + 4   for (r) in 0 .. nrlz[0] if rtv[r]
form[tvp[r] + 2] <- ftlm[rrwf[r]]   for (r) in 0 .. nrlz[0] if rtv[r]   # mov rax, ⊤ の印（書き先の印）
imm[tvp[r] + 2]  <- ftpf[rrwf[r]]   for (r) in 0 .. nrlz[0] if rtv[r]
form[tvp[r] + 3] <- 78   for (r) in 0 .. nrlz[0] if rtv[r]              # jmp → join（見張りを飛ばす）
jt[tvp[r] + 3]   <- jb[r]   for (r) in 0 .. nrlz[0] if rtv[r]

# ── 群の境目。**和は升に置く**（register は一つも空いていない）──────
# 群0 は升に置き、以降は升に足す（引く）。最後に升から rax へ戻す。
# 位置は項そのものの終わり `tpos + tml0` である。
field tmxp : max bound 16384                    # 升の出し入れの位置
tmxp[gt] <- tpos[gt] + tml0[gt] + tmn[gt]   for (gt) in 0 .. ngtz[0] if tmx[gt] >= 1
# 群0 の符号（升の出し入れより前。群が一つならここが項の最後）
field tnp : max bound 16384
tnp[gt] <- tpos[gt] + tml0[gt]   for (gt) in 0 .. ngtz[0] if tneg0[gt]
form[tnp[gt]] <- 137   for (gt) in 0 .. ngtz[0] if tneg0[gt]        # imul rax, -1
imm[tnp[gt]]  <- bias[0] - 1   for (gt) in 0 .. ngtz[0] if tneg0[gt]
form[tnp[gt] + 1] <- 191   for (gt) in 0 .. ngtz[0] if tneg0[gt]    # jo → 溢れの踏み台
jt[tnp[gt] + 1]   <- osf[rrwf[tmr[gt]]]   for (gt) in 0 .. ngtz[0] if tneg0[gt]
field sump : max bound 1                       # 和の升（場の下、`gap` の余白）
sump[z] <- bias[0] - 16   for (z) in 0 .. 0
form[tmxp[gt]] <- 51   for (gt) in 0 .. ngtz[0] if tmx[gt] >= 1 if tmgn[gt] == 0
imm[tmxp[gt]]  <- sump[0]   for (gt) in 0 .. ngtz[0] if tmx[gt] >= 1 if tmgn[gt] == 0
form[tmxp[gt]] <- 183  for (gt) in 0 .. ngtz[0] if tmx[gt] >= 1 if tmgn[gt] >= 1
      if not tgneg[gt]
form[tmxp[gt]] <- 184  for (gt) in 0 .. ngtz[0] if tmx[gt] >= 1 if tmgn[gt] >= 1
      if tgneg[gt]
imm[tmxp[gt]]  <- sump[0]   for (gt) in 0 .. ngtz[0] if tmx[gt] >= 1 if tmgn[gt] >= 1
form[tmxp[gt] + 1] <- 191  for (gt) in 0 .. ngtz[0] if tmx[gt] >= 2     # jo → 溢れの踏み台
jt[tmxp[gt] + 1]   <- osf[rrwf[tmr[gt]]]   for (gt) in 0 .. ngtz[0] if tmx[gt] >= 2
form[tmxp[gt] + 2] <- 185  for (gt) in 0 .. ngtz[0] if tmx[gt] == 3
imm[tmxp[gt] + 2]  <- sump[0]   for (gt) in 0 .. ngtz[0] if tmx[gt] == 3

# ── 値の見張り（join の手前）。重なれば規則ごとの踏み台 `vst` へ ──────────
form[jb[r] - 2] <- 12  for (r) in 0 .. nrlz[0] if vchk[r] >= 2     # cmp rax, ⊥ の印
imm[jb[r] - 2]  <- fbot[rrwf[r]]  for (r) in 0 .. nrlz[0] if vchk[r] >= 2
# min と max は **印を越えた値も持てない**。min の join は「⊥ 以上なら飛ばす」、max は
# 「⊥ 以下なら飛ばす」なので、`2147483647 + 1` を min に、`0 - 2147483647 - 1` を max に
# 書くと、印と等しくなくても **黙って消えた**（解釈実行は数として持つ）。等しいかでは
# なく、min は jge・max は jle で比べる。flat の印は二つの点なので je のまま。
form[jb[r] - 1] <- 13  for (r) in 0 .. nrlz[0] if vchk[r] >= 2 if rrlt[r] == 6   # je → 踏み台
form[jb[r] - 1] <- 17  for (r) in 0 .. nrlz[0] if vchk[r] >= 2 if rrlt[r] == 1   # jge → 踏み台
form[jb[r] - 1] <- 48  for (r) in 0 .. nrlz[0] if vchk[r] >= 2 if rrlt[r] == 2   # jle → 踏み台
jt[jb[r] - 1]   <- vsf[rrwf[r]]  for (r) in 0 .. nrlz[0] if vchk[r] >= 2
form[jb[r] - 4] <- ftca[rrwf[r]]  for (r) in 0 .. nrlz[0] if vchk[r] == 4   # cmp rax, ⊤ の印（場ごと）
imm[jb[r] - 4]  <- ftpf[rrwf[r]]  for (r) in 0 .. nrlz[0] if vchk[r] == 4
form[jb[r] - 3] <- 13  for (r) in 0 .. nrlz[0] if vchk[r] == 4
jt[jb[r] - 3]   <- vsf[rrwf[r]]  for (r) in 0 .. nrlz[0] if vchk[r] == 4

# ── join。**束が替えるのはここだけ**（項も座標も束によらない）──────────
# min / max: 違いは飛びの向きだけ（jge / jle）
form[jb[r]] <- 41      for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if not rxw[r]
imm[jb[r]]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] < 3
scb[jb[r]]  <- fscb[rrwf[r]] for (r) in 0 .. nrlz[0] if rrlt[r] < 3
form[jb[r] + 1] <- 17  for (r) in 0 .. nrlz[0] if rrlt[r] == 1 if not rxw[r]
form[jb[r] + 1] <- 48  for (r) in 0 .. nrlz[0] if rrlt[r] == 2 if not rxw[r]
jt[jb[r] + 1]   <- av[r]  for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if not rxw[r]
form[jb[r] + 2] <- 42  for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if not rxw[r]
imm[jb[r] + 2]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if not rxw[r]
scb[jb[r] + 2]  <- fscb[rrwf[r]] for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if not rxw[r]
# ⊥ を 0 に置いた場: 今の値を rsi に解く → cmp rsi,rax → 飛ぶ → 置き直して書く。
# `cmp rsi,rax` は向きが逆なので、飛びも裏返す（min は jle、max は jge）。
form[jb[r]] <- fjr[rrwf[r]]  for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if rxw[r]
form[jb[r] + 1] <- 67  for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if rxw[r]     # cmp rsi,rax
form[jb[r] + 2] <- 48  for (r) in 0 .. nrlz[0] if rrlt[r] == 1 if rxw[r]
form[jb[r] + 2] <- 17  for (r) in 0 .. nrlz[0] if rrlt[r] == 2 if rxw[r]
jt[jb[r] + 2]   <- av[r]  for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if rxw[r]
form[jb[r] + 3] <- fjw[rrwf[r]]  for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if rxw[r]
imm[jb[r] + 3]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if rxw[r]
scb[jb[r] + 3]  <- fscb[rrwf[r]] for (r) in 0 .. nrlz[0] if rrlt[r] < 3 if rxw[r]

# or: 既に真なら次へ
form[jb[r]] <- fc1[rrwf[r]]   for (r) in 0 .. nrlz[0] if rrlt[r] == 3
imm[jb[r]]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] == 3
scb[jb[r]]  <- fscb[rrwf[r]] for (r) in 0 .. nrlz[0] if rrlt[r] == 3
form[jb[r] + 1] <- 13  for (r) in 0 .. nrlz[0] if rrlt[r] == 3
jt[jb[r] + 1]   <- av[r]  for (r) in 0 .. nrlz[0] if rrlt[r] == 3
form[jb[r] + 2] <- fs1[rrwf[r]]   for (r) in 0 .. nrlz[0] if rrlt[r] == 3
imm[jb[r] + 2]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] == 3
scb[jb[r] + 2]  <- fscb[rrwf[r]] for (r) in 0 .. nrlz[0] if rrlt[r] == 3

# flat: ⊥→入れる / 同じ→何もしない / ⊤→何もしない / 違う→⊤ —— ただし、その ⊤ が
# **数として誤読される場なら、⊤ に達したと言って止まる**（終了コード 5・場の番号つき）。
# 焼いた符号は ⊤ の規律を持たない（SPEC: ⊤ は「少なくとも真」で比較に立ち、座標には
# なれず、算術は ⊤ 厳密）。⊤ の印 0x7ffffffe を比較・算術・座標・区間の上端・描画で
# 読むと **ただの数**として読み、⊤ でない升まで黙って違う答えになった（`if g[0] < 5` で
# 解釈実行は立ち、焼いた側は立たない）。
# **誤読されない読みもある**: 素のガード（印は 0 でないので `if` は立ち `if not` は
# 立たない —— 答えの定義と同じ）と、flat の場への素の写し（`cv[j] <- cv[i]`。印を
# そのまま写せば ⊤ が ⊤ として伝わる —— 定数伝播はこれで回る）。写し先がまた誤読
# されるなら、写し元も誤読される（鎖で閉じる）。成層が正しいので、ここに来るのは
# 答えが本当に ⊤ を含むときだけである（途中の値は来ない）。
field tmany : or bound 16384                 # 規則 r の値に項が二つ以上ある
tmany[tmr[gt]] <- true   for (gt) in 0 .. ngtz[0] if tmi[gt] >= 1
field tcopy : or bound 16384                 # 項 gt は flat の場への素の写し
tcopy[gt] <- true        for (gt) in 0 .. ngtz[0] if tmk[gt] == 3 if not tmany[tmr[gt]]
      if rrlt[tmr[gt]] == 6
field tdang : or bound 2048                 # 場 f の ⊤ は、どこかで数として誤読される
# （13e）算術の読みは ⊤ 厳密に、比較は ⊤ で立つようにした —— どちらも誤読ではなくなったので
# ここから外した。残るのは座標・区間の上端・描画と、そこへ素に写される場である。
tdang[tmf[gt]] <- true   for (gt) in 0 .. ngtz[0] if tcopy[gt] if tdang[rrwf[tmr[gt]]]
tdang[cdcf[gc]] <- true  for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
tdang[cdcf[gc]] <- true  for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
tdang[lpbf[gl]] <- true  for (gl) in 0 .. nglz[0] if lpk[gl] >= 2
tdang[lplf[gl]] <- true  for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lplk[gl] <= 2
field nrfz : max bound 1                    # 描く場の数の一つ手前（区間の上端に書ける形）
nrfz[0] <- nrf[0] - 1   for (z) in 0 .. 0
field orz : max bound 8                     # k 番目に描く場（計数器で引ける形）
orz[k] <- orf[k]        for (k) in 0 .. nrfz[0]
tdang[orz[k]] <- true   for (k) in 0 .. nrfz[0] if outw[0] == 1
field frdr : or bound 16384                  # 規則 r の書き先の ⊤ は誤読される
frdr[r] <- true        for (r) in 0 .. nrlz[0] if tdang[rrwf[r]]
form[jb[r]] <- fjr[rrwf[r]]      for (r) in 0 .. nrlz[0] if rrlt[r] == 6
imm[jb[r]]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
scb[jb[r]]  <- fscb[rrwf[r]] for (r) in 0 .. nrlz[0] if rrlt[r] == 6
form[jb[r] + 1] <- 66  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
imm[jb[r] + 1]  <- fbot[rrwf[r]]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
form[jb[r] + 2] <- 13  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
jt[jb[r] + 2]   <- jb[r] + 8  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
form[jb[r] + 3] <- 67  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
form[jb[r] + 4] <- 13  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
jt[jb[r] + 4]   <- av[r]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
form[jb[r] + 5] <- 66  for (r) in 0 .. nrlz[0] if rrlt[r] == 6 if not frdr[r]
imm[jb[r] + 5]  <- ftop[0]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6 if not frdr[r]
form[jb[r] + 6] <- 13  for (r) in 0 .. nrlz[0] if rrlt[r] == 6 if not frdr[r]
jt[jb[r] + 6]   <- av[r]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6 if not frdr[r]
form[jb[r] + 5] <- 162 for (r) in 0 .. nrlz[0] if rrlt[r] == 6 if frdr[r]   # mov r15d, 場番号
imm[jb[r] + 5]  <- rrwf[r] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6 if frdr[r]
form[jb[r] + 6] <- 78  for (r) in 0 .. nrlz[0] if rrlt[r] == 6 if frdr[r]    # jmp -> ⊤ の出口
jt[jb[r] + 6]   <- tpx[0]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6 if frdr[r]
form[jb[r] + 7] <- 2   for (r) in 0 .. nrlz[0] if rrlt[r] == 6
imm[jb[r] + 7]  <- ftop[0]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
form[jb[r] + 8] <- fjw[rrwf[r]]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
imm[jb[r] + 8]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] == 6
scb[jb[r] + 8]  <- fscb[rrwf[r]] for (r) in 0 .. nrlz[0] if rrlt[r] == 6

# sum / count: 印が冪等を持つ（行は一度しか数えない）。count は値を 1 に直す
form[jb[r]] <- 68      for (r) in 0 .. nrlz[0] if atab[r]
imm[jb[r]]  <- fdsp[r] + bias[0]   for (r) in 0 .. nrlz[0] if atab[r]
form[jb[r] + 1] <- 22  for (r) in 0 .. nrlz[0] if atab[r]
jt[jb[r] + 1]   <- av[r]  for (r) in 0 .. nrlz[0] if atab[r]
form[jb[r] + 2] <- 69  for (r) in 0 .. nrlz[0] if atab[r]
imm[jb[r] + 2]  <- fdsp[r] + bias[0]   for (r) in 0 .. nrlz[0] if atab[r]
# **区間の集約の印**（14）。印の番地 `[rcx + fdsp]` は表の行（rcx が地上の行を指す）の形で、区間では
# rcx が **計数器の値**なので、番地は `fdsp + i` —— どこでもない所だった。小さい本では地上の空きに
# 落ちてたまたま動き、場が 4〜12 MB の本では **場の升を印と読んだ**（`big` が 7 で埋まっていると
# 「もう数えた」と読み、`c[0] <- i for (i) in 0 .. 9` の count が 10 でなく 0 —— 黙って違う答え）。
# 下ろした本は表を区間に書き換えるので、集約はほとんどこちらを通る。印を **計数器 - 下端** の
# ビットにして、場の下（日程の二枚のさらに下）の升に規則ごとに並べる。三命令のまま:
#   lea rsi, [rcx - 下端] / bts [rbx + 印], rsi / jc → 次の行（もう数えた）
field atab : or bound 16384                     # 集約の規則で、ループが一つの表（印は行で引く）
atab[r] <- true   for (r) in 0 .. nrlz[0] if rrlt[r] >= 8 if not amul[r] if l0k[r] == 0
field arng : or bound 16384                     # 集約の規則で、ループが一つの区間（印は計数器のビット）
arng[r] <- true   for (r) in 0 .. nrlz[0] if rrlt[r] >= 8 if not amul[r] if l0k[r] >= 1
# 下端が場の区間は、頭が下端を升に置いている（13i）ので **計数器 - その升** を番号にする（一命令長い）。
# 下端の場が同じ層（か上）で書かれるなら、下端が動いて番号がずれる —— 焼かない（理由 8）
field alsa : or bound 16384                     # 規則 r の段0 の下端は、同じ層（か上）で書かれる場
alsa[lpr[gl]] <- true   for (gl) in 0 .. nglz[0] if lpi[gl] == 0 if lplk[gl] >= 1 if lplk[gl] <= 2
      if fwr[lplf[gl]] if fwst[lplf[gl]] >= rrst[lpr[gl]]
badk[z] <- rlin[r] * 16 + 8   for (r) in 0 .. nrlz[0] for (z) in 0 .. 0 if arng[r] if alsa[r]
field amx : max bound 16384                     # 印の命令の伸び（下端が場の区間は一命令）
amx[r] <- 0                         for (r) in 0 .. nrlz[0]
amx[r] <- 1                         for (r) in 0 .. nrlz[0] if arng[r] if l0lk[r] >= 1
field amz : max bound 16384                     # 印のビットの並びの大きさ（バイト、八の倍数）
amz[r] <- 0                         for (r) in 0 .. nrlz[0]
field adif : max bound 16384                    # 上端 - 下端（丸括弧は焼けないので名前を置く）
adif[r] <- l0hi[r] - l0lo[r]        for (r) in 0 .. nrlz[0] if arng[r] if l0k[r] == 1 if l0hi[r] >= l0lo[r]
amz[r] <- adif[r] / 64 * 8 + 8      for (r) in 0 .. nrlz[0] if arng[r] if l0k[r] == 1 if l0hi[r] >= l0lo[r]
      if l0lk[r] == 0
amz[r] <- 8                         for (r) in 0 .. nrlz[0] if arng[r] if l0k[r] == 1 if l0hi[r] < l0lo[r]
      if l0lk[r] == 0
#   上端が場なら広さは言語の上限まで（上端 - 下端 ≤ 4,194,304 は頭が見る）
amz[r] <- 524296                    for (r) in 0 .. nrlz[0] if arng[r] if l0k[r] >= 2
amz[r] <- 524296                    for (r) in 0 .. nrlz[0] if arng[r] if l0lk[r] >= 1
field moff : max bound 16384                    # 規則 r の印の頭（印の置き場の頭から。前置きの鎖）
moff[0] <- 0
moff[r] <- moff[r-1] + amz[r-1]     for (r) in 1 .. nrlz[0]
field mtot : max bound 1                        # 印の置き場ぜんぶ
mtot[0] <- 0
mtot[z] <- moff[r] + amz[r]         for (r) in 0 .. nrlz[0] for (z) in 0 .. 0
field mtz : max bound 1                         # 閉じた mtot（引き算に使えるのはこちら。気づき38）
mtz[0] <- mtot[0]   for (z) in 0 .. 0 if mtot[0] >= 0
form[jb[r]] <- 225     for (r) in 0 .. nrlz[0] if arng[r]                 # lea rsi, [rcx - 下端]
imm[jb[r]]  <- bias[0] - l0lo[r]    for (r) in 0 .. nrlz[0] if arng[r] if l0lk[r] == 0
imm[jb[r]]  <- bias[0]              for (r) in 0 .. nrlz[0] if arng[r] if l0lk[r] >= 1   # （rsi ← rcx）
form[jb[r] + 1] <- 229 for (r) in 0 .. nrlz[0] if arng[r] if l0lk[r] >= 1 # sub rsi, [下端の升]
imm[jb[r] + 1]  <- llcl[0]          for (r) in 0 .. nrlz[0] if arng[r] if l0lk[r] >= 1
field ajb : max bound 16384                     # bts の位置
ajb[r] <- jb[r] + 1 + amx[r]        for (r) in 0 .. nrlz[0] if arng[r]
form[ajb[r]] <- 226    for (r) in 0 .. nrlz[0] if arng[r]                 # bts [rbx + 印], rsi
imm[ajb[r]]  <- moff[r] + bias[0] - mtz[0] - gpz[0]   for (r) in 0 .. nrlz[0] if arng[r]
form[ajb[r] + 1] <- 7  for (r) in 0 .. nrlz[0] if arng[r]                 # jc → 次の行
jt[ajb[r] + 1]   <- av[r]  for (r) in 0 .. nrlz[0] if arng[r]
# **二重以上のループの集約は、印を持たずに一度だけ回す**（13f）。印は外側の行（rcx）でしか
# 引いていないので、内側の実例は同じ印を踏んで数え落ちる（`for (i,c) in ch for (k) in 0 .. 2`
# の count が 12 でなく 4）—— だから前段が断っていた。だが印が要るのは **規則がもう一度回る**
# ときだけである。読む場がすべて下の層で閉じていれば、日程の入口（EP と LAST）が二周目を
# 通さない —— 最初の周回で一度回ったら、読んだ場はもう動かない。**冪等は印ではなく日程が持つ。**
# 同じ層（か上）で書かれる場を読む集約は、二周目があるので断る（理由 8、前と同じ）。
form[jb[r]] <- 195     for (r) in 0 .. nrlz[0] if amul[r]             # nop（印の三命令の席）
form[jb[r] + 1] <- 195 for (r) in 0 .. nrlz[0] if amul[r]
form[jb[r] + 2] <- 195 for (r) in 0 .. nrlz[0] if amul[r]
field amul : or bound 16384                     # 集約の規則で、ループが二つ以上
amul[r] <- true   for (r) in 0 .. nrlz[0] if rrlt[r] >= 8 if gnl[r] >= 2
field fwst : max bound 2048                     # 場 f を書く規則の層（いちばん上）
fwst[rrwf[r]] <- rrst[r]   for (r) in 0 .. nrlz[0]
field sagr : or bound 16384                     # 規則 r は同じ層（か上）で書かれる場を読む
sagr[tmr[gt]] <- true   for (gt) in 0 .. ngtz[0] if isrd[gt] if fwr[tmf[gt]] if fwst[tmf[gt]] >= rrst[tmr[gt]]
sagr[gdr[gg]] <- true   for (gg) in 0 .. nggz[0] if gisr[gg] if fwr[gdf[gg]] if fwst[gdf[gg]] >= rrst[gdr[gg]]
sagr[cdr[gc]] <- true   for (gc) in 0 .. ngcz[0] if cdrd[gc] if fwr[cdcf[gc]] if fwst[cdcf[gc]] >= rrst[cdr[gc]]
sagr[lpr[gl]] <- true   for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if fwr[lpbf[gl]] if fwst[lpbf[gl]] >= rrst[lpr[gl]]
sagr[lpr[gl]] <- true   for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lplk[gl] <= 2 if fwr[lplf[gl]] if fwst[lplf[gl]] >= rrst[lpr[gl]]
# 軸の群の集約は、群が一度だけ回る（14o）ので二周目が無い —— 群の場を読んでも断らない
badk[z] <- rlin[r] * 16 + 8   for (r) in 0 .. nrlz[0] for (z) in 0 .. 0 if amul[r] if sagr[r] if not rax[r]
# 切り口を回し直す群（14q）では、印を持たない二重ループの集約は同じ切り口で二度数える —— 断る
badk[z] <- rlin[r] * 16 + 8   for (r) in 0 .. nrlz[0] for (z) in 0 .. 0 if amul[r] if raxc[r]
field ajc : max bound 16384                     # count の mov rax,1 の位置（印の後ろ）
ajc[r] <- jb[r] + 3 + amx[r]        for (r) in 0 .. nrlz[0] if rrlt[r] == 9
form[ajc[r]] <- 2   for (r) in 0 .. nrlz[0] if rrlt[r] == 9
imm[ajc[r]]  <- 1 + bias[0]   for (r) in 0 .. nrlz[0] if rrlt[r] == 9

# 集約の束ごとの位置
field jlp : max bound 16384
jlp[r] <- jb[r] + rrlt[r] - 5 + amx[r] + sxp[r]   for (r) in 0 .. nrlz[0]
form[jlp[r]] <- 70  for (r) in 0 .. nrlz[0] if rrlt[r] >= 8
imm[jlp[r]]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] >= 8
scb[jlp[r]]  <- fscb[rrwf[r]] for (r) in 0 .. nrlz[0] if rrlt[r] >= 8
form[jlp[r] + 1] <- 191  for (r) in 0 .. nrlz[0] if rrlt[r] == 8     # jo → 溢れの踏み台
jt[jlp[r] + 1]   <- osf[rrwf[r]]   for (r) in 0 .. nrlz[0] if rrlt[r] == 8

# ── **sum の ⊤**（14v）。定義の sum は寄与の袋で、寄与の一つが ⊤ なら和は ⊤（⊤ は吸収する）。足す束は
# 数の順の端で吸収しない（端に足せば端から動く）ので、join が升を見る:
#   印の後ろ: mov rsi,[升] / cmp rsi,⊤ / je → 次の行（升が ⊤ なら足さない）
#             （⊤ の寄与を運ぶ規則だけ）cmp byte [旗],0 / je → 足す / mov [升],rax（rax は ⊤ の印）/ jmp → 階数
#   足したあと: mov rsi,[升] / cmp rsi,⊤ / je → 値の踏み台（正しい和が ⊤ の印に届いた —— 言う）
# ⊤ の寄与か正しい値かは旗で分ける（rax は正しい値でも 0x8000…0000 になりうる。旗は実例ごとに下ろしてある）
field stc : or bound 16384                     # 規則 r は ⊤ を持つ sum の場へ書く
stc[r] <- true   for (r) in 0 .. nrlz[0] if rrlt[r] == 8 if ftc[rrwf[r]]
field sxp : max bound 16384                    # 足す前の命令数
sxp[r] <- 0      for (r) in 0 .. nrlz[0]
sxp[r] <- 3      for (r) in 0 .. nrlz[0] if stc[r]
sxp[r] <- 7      for (r) in 0 .. nrlz[0] if stc[r] if rtv[r]
field sxq : max bound 16384                    # 足したあとの命令数
sxq[r] <- 0      for (r) in 0 .. nrlz[0]
sxq[r] <- 3      for (r) in 0 .. nrlz[0] if stc[r]
field sxb : max bound 16384                    # 足す前の頭（印の後ろ）
sxb[r] <- jb[r] + 3 + amx[r]   for (r) in 0 .. nrlz[0] if stc[r]
form[sxb[r]] <- fjr[rrwf[r]]   for (r) in 0 .. nrlz[0] if stc[r]                # mov rsi, [升]
imm[sxb[r]]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if stc[r]
scb[sxb[r]]  <- fscb[rrwf[r]]  for (r) in 0 .. nrlz[0] if stc[r]
form[sxb[r] + 1] <- ftcs[rrwf[r]]   for (r) in 0 .. nrlz[0] if stc[r]           # cmp rsi, ⊤ の印
imm[sxb[r] + 1]  <- ftpf[rrwf[r]]   for (r) in 0 .. nrlz[0] if stc[r]
form[sxb[r] + 2] <- 13         for (r) in 0 .. nrlz[0] if stc[r]                # je → 次の行
jt[sxb[r] + 2]   <- av[r]      for (r) in 0 .. nrlz[0] if stc[r]
form[sxb[r] + 3] <- 220        for (r) in 0 .. nrlz[0] if stc[r] if rtv[r]      # cmp byte [旗], 0
form[sxb[r] + 4] <- 13         for (r) in 0 .. nrlz[0] if stc[r] if rtv[r]      # je → 足す
jt[sxb[r] + 4]   <- jlp[r]     for (r) in 0 .. nrlz[0] if stc[r] if rtv[r]
form[sxb[r] + 5] <- fjw[rrwf[r]]   for (r) in 0 .. nrlz[0] if stc[r] if rtv[r]  # mov [升], rax（⊤ を置く）
imm[sxb[r] + 5]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if stc[r] if rtv[r]
scb[sxb[r] + 5]  <- fscb[rrwf[r]]  for (r) in 0 .. nrlz[0] if stc[r] if rtv[r]
form[sxb[r] + 6] <- 78         for (r) in 0 .. nrlz[0] if stc[r] if rtv[r]      # jmp → 階数
jt[sxb[r] + 6]   <- jpos[r] - 1   for (r) in 0 .. nrlz[0] if stc[r] if rtv[r]
form[jlp[r] + 2] <- fjr[rrwf[r]]   for (r) in 0 .. nrlz[0] if stc[r]            # mov rsi, [升]
imm[jlp[r] + 2]  <- foff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if stc[r]
scb[jlp[r] + 2]  <- fscb[rrwf[r]]  for (r) in 0 .. nrlz[0] if stc[r]
form[jlp[r] + 3] <- ftcs[rrwf[r]]  for (r) in 0 .. nrlz[0] if stc[r]            # cmp rsi, ⊤ の印
imm[jlp[r] + 3]  <- ftpf[rrwf[r]]  for (r) in 0 .. nrlz[0] if stc[r]
form[jlp[r] + 4] <- 13         for (r) in 0 .. nrlz[0] if stc[r]                # je → 値の踏み台
jt[jlp[r] + 4]   <- vsf[rrwf[r]]   for (r) in 0 .. nrlz[0] if stc[r]

# ── 階数。読みの階数の最大 + 1（集約は 1。印が数えるので深さを持たない）───
# 階数は **符号なしの 32 ビット**。最大は符号なしで取り（cmovb）、+1 は 32 ビットで足す。
# 0xFFFFFFFF の次は 0 に戻る —— 在る升の階数 0 は「導出を与えていない」で、検査器は
# 示せない（REJECTED、(B)）と言う。前は符号つき（cmovl と 64 ビットの add）で、
# 2^31 を越えた階数を読む側が負と見て小さい階数を書き、証人の順序が **黙って** 壊れた。

# 階数を書く所（飛びの後ろ）
field jpos : max bound 16384
# 見張りの命令は join の手前（`jb` の前）に入るので、終わりは jb から見ると vchk だけ手前
jpos[r] <- jb[r] + jlen[r] - vchk[r]   for (r) in 0 .. nrlz[0]
form[jpos[r] - 2] <- 91  for (r) in 0 .. nrlz[0] if rrlt[r] < 8      # add r11d,1
form[jpos[r] - 1] <- 92  for (r) in 0 .. nrlz[0] if rrlt[r] < 8      # mov [K+rdx*4],r11d
imm[jpos[r] - 1]  <- koff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] < 8
scb[jpos[r] - 1]  <- kscb[0]  for (r) in 0 .. nrlz[0] if rrlt[r] < 8
form[jpos[r] - 1] <- 64  for (r) in 0 .. nrlz[0] if rrlt[r] >= 8
imm[jpos[r] - 1]  <- koff[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0] if rrlt[r] >= 8
scb[jpos[r] - 1]  <- kscb[0]  for (r) in 0 .. nrlz[0] if rrlt[r] >= 8

# ── 書き座標。crd が r9 に作り、rdx へ移す（束によらない）───────────
# そして **宣言した広さを超えたら言う**（黙って他人の場を踏まない）——
# 有限の資源は宣言し、超えたら止まる。終了コード 6。

# 書き座標のあと
field wcp : max bound 16384
wcp[r] <- wpos[r] + ctot[rroo[r]]  for (r) in 0 .. nrlz[0]
form[wcp[r]] <- 95   for (r) in 0 .. nrlz[0]      # mov rdx,r9
form[wcp[r] + 1] <- 74   for (r) in 0 .. nrlz[0]  # cmp rdx, 升数
imm[wcp[r] + 1]  <- fsz[rrwf[r]] + bias[0]  for (r) in 0 .. nrlz[0]
form[wcp[r] + 2] <- 73   for (r) in 0 .. nrlz[0]  # jae -> はみ出した
jt[wcp[r] + 2]   <- ovs[rrwf[r]]    for (r) in 0 .. nrlz[0]

# 動いた印（av の直前。**束によらない** —— 六部のうち五部が束を問わなくなった）
form[av[r] - 2] <- 19    for (r) in 0 .. nrlz[0]
# そして **どの周回で動いたか**を場ごとに記す（EP[f] <- r15）。
# これが次の周回の入口になる —— 誰が誰を読むかは宣言が言っている。
form[av[r] - 1] <- 161   for (r) in 0 .. nrlz[0]
imm[av[r] - 1]  <- rrwf[r] * 8 + bias[0] - gpz[0]   for (r) in 0 .. nrlz[0]

# ── 進める。**内側から外側へ**。前進もループ番号に沿った鎖である ────
field ap : max bound 16384                      # ループ l の前進の位置
field lpi3 : max bound 16384                    # 内側からの進めの位置
# 段 l までの進めの命令数 = 3(l+1) + max(0, l-2)（段 3 から一命令ずつ長い）。gnlx と同じく
# 比べて二つに分ける（引き算の右に置くので、途中の値を持たせない —— 気づき38）
field lpx2 : max bound 16384
lpx2[gl] <- 0                       for (gl) in 0 .. nglz[0] if lpi[gl] <= 2
lpx2[gl] <- lpi[gl] - 2             for (gl) in 0 .. nglz[0] if lpi[gl] >= 3
lpi3[gl] <- lpi[gl] * 3 + 3 + lpx2[gl]   for (gl) in 0 .. nglz[0]
ap[gl] <- rend[lpr[gl]] - lpi3[gl]  for (gl) in 0 .. nglz[0] if nofus[lpr[gl] + 1] if lpi[gl] == 0
ap[gl] <- rend[lpr[gl]] - lpi3[gl] - csuf[lpr[gl]]  for (gl) in 0 .. nglz[0] if nofus[lpr[gl] + 1] if lpi[gl] >= 1
# 切り口の回し直し（14q）: 前置きは群の頭の段0 の頭の後ろ、後置きは群の尻尾の段0 の進めの前
field cpp : max bound 16384                     # 前置きの位置
cpp[r] <- lhead[r] + lph0[r]        for (r) in 0 .. nrlz[0] if nofus[r] if raxc[r]
field csp : max bound 16384                     # 後置きの位置
csp[r] <- rend[r] - 3 - 9           for (r) in 0 .. nrlz[0] if nofus[r+1] if raxc[r]
field cag : max bound 16384                     # again（前置きの xor の位置）
cag[r] <- lhead[r] + lph0[r] + 5    for (r) in 0 .. nrlz[0] if nofus[r+1] if raxc[r]
form[cpp[r]]     <- 2    for (r) in 0 .. nrlz[0] if cpp[r] >= 0      # mov rax, 0
imm[cpp[r]]      <- bias[0]         for (r) in 0 .. nrlz[0] if cpp[r] >= 0
form[cpp[r] + 1] <- 21   for (r) in 0 .. nrlz[0] if cpp[r] >= 0      # test r8, r8
form[cpp[r] + 2] <- 13   for (r) in 0 .. nrlz[0] if cpp[r] >= 0      # je → mov [升], rax
jt[cpp[r] + 2]   <- cpp[r] + 4      for (r) in 0 .. nrlz[0] if cpp[r] >= 0
form[cpp[r] + 3] <- 2    for (r) in 0 .. nrlz[0] if cpp[r] >= 0      # mov rax, 1
imm[cpp[r] + 3]  <- 1 + bias[0]     for (r) in 0 .. nrlz[0] if cpp[r] >= 0
form[cpp[r] + 4] <- 51   for (r) in 0 .. nrlz[0] if cpp[r] >= 0      # mov [升], rax
imm[cpp[r] + 4]  <- cslt[0]         for (r) in 0 .. nrlz[0] if cpp[r] >= 0
form[cpp[r] + 5] <- 9    for (r) in 0 .. nrlz[0] if cpp[r] >= 0      # again: xor r8, r8
form[csp[r]]     <- 21   for (r) in 0 .. nrlz[0] if csp[r] >= 0      # test r8, r8
form[csp[r] + 1] <- 13   for (r) in 0 .. nrlz[0] if csp[r] >= 0      # je → done
jt[csp[r] + 1]   <- csp[r] + 5      for (r) in 0 .. nrlz[0] if csp[r] >= 0
form[csp[r] + 2] <- 2    for (r) in 0 .. nrlz[0] if csp[r] >= 0      # mov rax, 1
imm[csp[r] + 2]  <- 1 + bias[0]     for (r) in 0 .. nrlz[0] if csp[r] >= 0
form[csp[r] + 3] <- 51   for (r) in 0 .. nrlz[0] if csp[r] >= 0      # mov [升], rax
imm[csp[r] + 3]  <- cslt[0]         for (r) in 0 .. nrlz[0] if csp[r] >= 0
form[csp[r] + 4] <- 78   for (r) in 0 .. nrlz[0] if csp[r] >= 0      # jmp → again
jt[csp[r] + 4]   <- cag[r]          for (r) in 0 .. nrlz[0] if csp[r] >= 0
form[csp[r] + 5] <- 185  for (r) in 0 .. nrlz[0] if csp[r] >= 0      # done: mov rax, [升]
imm[csp[r] + 5]  <- cslt[0]         for (r) in 0 .. nrlz[0] if csp[r] >= 0
form[csp[r] + 6] <- 26   for (r) in 0 .. nrlz[0] if csp[r] >= 0      # test rax, rax
form[csp[r] + 7] <- 13   for (r) in 0 .. nrlz[0] if csp[r] >= 0      # je → 段0 の進め
jt[csp[r] + 7]   <- csp[r] + 9      for (r) in 0 .. nrlz[0] if csp[r] >= 0
form[csp[r] + 8] <- 19   for (r) in 0 .. nrlz[0] if csp[r] >= 0      # mov r8d, 1
ap[gl] <- rend[lpr[gl]] - lpi3[gl] + 3   for (gl) in 0 .. nglz[0] if lpi[gl] >= 1 if not nofus[lpr[gl] + 1]   # 14n
form[ap[gl]] <- 5        for (gl) in 0 .. nglz[0] if lpk[gl] == 0            # add rcx, 8*次数
imm[ap[gl]]  <- lpar[gl] * 8 + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 0
form[ap[gl] + 1] <- 79   for (gl) in 0 .. nglz[0] if lpk[gl] == 0            # cmp rcx, 表の終わり
form[ap[gl]] <- 5        for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 0  # add rcx, 1
imm[ap[gl]]  <- 1 + bias[0]        for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 0 if not ldn[gl]
imm[ap[gl]]  <- 255 + bias[0]      for (gl) in 0 .. nglz[0] if ldn[gl]      # add rcx, -1（imm8 は mod 256）
form[ap[gl] + 1] <- 20   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] == 0  # cmp rcx, 上端+1
imm[ap[gl] + 1]  <- lphi[gl] + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] == 0 if not ldn[gl]
imm[ap[gl] + 1]  <- lplo[gl] + bias[0]   for (gl) in 0 .. nglz[0] if ldn[gl]
form[ap[gl]] <- 102      for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 1  # add r13, 1
imm[ap[gl]]  <- 1 + bias[0]        for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 1
form[ap[gl] + 1] <- 103  for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] == 1  # cmp r13, 上端+1
imm[ap[gl] + 1]  <- lphi[gl] + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] == 1
form[ap[gl]] <- 106      for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 2  # add r14, 1
imm[ap[gl]]  <- 1 + bias[0]        for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] == 2
form[ap[gl] + 1] <- 107  for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] == 2  # cmp r14, 上端+1
imm[ap[gl] + 1]  <- lphi[gl] + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] == 2
# 種2: 上端は **場の値**である（`for (n) in 0 .. nins[0]`）。
# 区間の端は「それまでに束縛された変数の下で評価する」と言語が言っている ——
# 生成器がそれを焼けないのは分類の穴だった。比べる相手を記憶から取るだけで、
# 命令は一つ（cmp reg,[rbx+ずれ]）しか増えない。閉区間なので jbe で回る。
form[ap[gl] + 1] <- 142  for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] == 0
form[ap[gl] + 1] <- 143  for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] == 1
form[ap[gl] + 1] <- 144  for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] == 2
imm[ap[gl] + 1]  <- lbad[gl]   for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] <= 2
form[ap[gl] + 2] <- 7    for (gl) in 0 .. nglz[0] if lpk[gl] == 0 if lpi[gl] <= 2   # jb -> 一つ内側の頭
form[ap[gl] + 2] <- 145  for (gl) in 0 .. nglz[0] if lpk[gl] >= 1 if lpi[gl] <= 2 if not ldn[gl]   # jle（符号付き）
form[ap[gl] + 2] <- 17   for (gl) in 0 .. nglz[0] if ldn[gl]                   # jge（降りる軸）
jt[ap[gl] + 2]   <- lhp[gl] + lph[gl]   for (gl) in 0 .. nglz[0] if lpi[gl] <= 2
# **段 3 から（升の計数器）**: 升を一つ進め、rax に読んで上端と比べる（四命令）。
form[ap[gl]] <- 215      for (gl) in 0 .. nglz[0] if lpi[gl] >= 3            # inc [升]
imm[ap[gl]]  <- lce[lpi[gl]]   for (gl) in 0 .. nglz[0] if lpi[gl] >= 3
form[ap[gl] + 1] <- 185  for (gl) in 0 .. nglz[0] if lpi[gl] >= 3            # mov rax, [升]
imm[ap[gl] + 1]  <- lce[lpi[gl]]   for (gl) in 0 .. nglz[0] if lpi[gl] >= 3
form[ap[gl] + 2] <- 12   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] >= 3   # cmp rax, 上端
imm[ap[gl] + 2]  <- lphi[gl] + bias[0]   for (gl) in 0 .. nglz[0] if lpk[gl] == 1 if lpi[gl] >= 3
form[ap[gl] + 2] <- 214  for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] >= 3   # cmp rax, [上端]
imm[ap[gl] + 2]  <- lbad[gl]   for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if lpi[gl] >= 3
form[ap[gl] + 3] <- 145  for (gl) in 0 .. nglz[0] if lpi[gl] >= 3                   # jle（符号付き）
jt[ap[gl] + 3]   <- lhp[gl] + lph[gl]   for (gl) in 0 .. nglz[0] if lpi[gl] >= 3

# ══ 日程は自由である ═══════════════════════════════════════════════
# **同じ規則を五十八周まわしていたのは、入口が変わっていないことを
# 知らなかったからである。** Lattix は「どの規則がどの場を読むか」を
# 宣言として持っている —— C の最適化器がすべての解析を費やして
# 再発見しようとしているものを、この言語は最初から持っている。
# だから要るのは二枚の数だけである:
#   EP[f]   場 f が最後に動いた周回
#   LAST[r] 規則 r が最後に回った周回
# 規則 r は「自分が読む場のどれかが、自分が回ってから動いた」ときだけ回る。
# 単調だから、飛ばしても答えは変わらない —— 動いていないなら導けるものも
# 増えていない。層の輪は「何も動かなかった」で閉じるので、健全である。
#
#   ckp+0                 mov rax,[LAST[r]]
#   ckp+1+2j / +2+2j      cmp [EP[f]],rax ; jae -> ckr   （読む場ごとに一組）
#   ckj = ckp+1+2n        jmp -> 本体の終わり            （どれも動いていない）
#   ckr = ckj+1           mov [LAST[r]],r15
#   rb  = ckj+2           ループの頭 ...

# ── 読む場を数える。**四つの口**（項・ガード・座標・ループの上端）──────
# **鎖は二つ刻みで、規則の変わり目で 0 に戻す。** 一組が二命令だから二つ刻み。
# 戻すのは、規則ごとの「何番目の読みか」がそのまま位置になるからである ——
# 大域の通し番号から規則の先頭を引くには **最小値の場**が要るが、
# `min` の場を `max` の場から作ってはいけない（気づき36）:
# 育っていく値の最小を取ると、**途中の値を拾ってしまう** —— 単調でなくなり、
# 答えが実行順に依存する。この言語が禁じている唯一のことである。
# 変わり目は場と場の比較（`tmr[gt-1] == tmr[gt]`）で言える。それで足りる。

# **軸の群は一度だけ回る**（14o）。群が読む群の外の場は下の層で閉じていて（33_self の oxin）、群の中の
# 読みは融合した一周の中で閉じる —— だから群の中の読みは周回の入口で見ない。見ると、群が自分で書いた
# 升を「動いた」と読んで二周目に回り、印を持たない二重ループの集約（ライフゲームの近傍の数 `nb[t, x, y]
# <- 1`）が二度数える。見なければ、群は入口（群の外）が動いたときだけ —— 一度だけ —— 回る
field fxax : or bound 2048                      # 場 f は軸の群の場
fxax[f] <- true                     for (f) in 0 .. nflz[0] if raxb[f] >= 0
field ckt : or bound 16384                      # 項 gt の読みを周回の入口で見る
ckt[gt] <- true                     for (gt) in 0 .. ngtz[0] if isrd[gt] if not rax[tmr[gt]]
ckt[gt] <- true                     for (gt) in 0 .. ngtz[0] if isrd[gt] if not fxax[tmf[gt]]
ckt[gt] <- true                     for (gt) in 0 .. ngtz[0] if isrd[gt] if raxb[tmf[gt]] != raxf[tmr[gt]]
# 項の読み（種 3 / 9 / 10）
field tcn : max bound 16384                     # 規則の中で何番目の読みか（二つ刻み）
tcn[gt] <- 0                        for (gt) in 0 .. ngtz[0]
tcn[gt] <- tcn[gt-1]                for (gt) in 0 .. ngtz[0] if gt > 0 if tmr[gt-1] == tmr[gt]
tcn[gt] <- tcn[gt-1] + 2            for (gt) in 0 .. ngtz[0] if gt > 0 if tmr[gt-1] == tmr[gt] if ckt[gt-1]
field ntm : max bound 16384                     # 規則 r が項で読む場の数（二倍）
ntm[r] <- 0                         for (r) in 0 .. nrlz[0]
ntm[tmr[gt]] <- tcn[gt] + 2         for (gt) in 0 .. ngtz[0] if ckt[gt]

# ガードの読み（種 2 / 3 / 4 / 7 以上）。**辺が場かどうかは ok が言う**
field gisr : or bound 16384                     # このガードは場を読む
gisr[gg] <- true                    for (gg) in 0 .. nggz[0] if gdk[gg] >= 7 if gknown[gg]
gisr[gg] <- true                    for (gg) in 0 .. nggz[0] if gdk[gg] == 2
gisr[gg] <- true                    for (gg) in 0 .. nggz[0] if gdk[gg] == 3 if gdok[gg] == 0
gisr[gg] <- true                    for (gg) in 0 .. nggz[0] if gdk[gg] == 4 if gdok[gg] == 0
field ckg : or bound 16384                      # ガード gg の読みを周回の入口で見る（14o）
ckg[gg] <- true                     for (gg) in 0 .. nggz[0] if gisr[gg] if not rax[gdr[gg]]
ckg[gg] <- true                     for (gg) in 0 .. nggz[0] if gisr[gg] if not fxax[gdf[gg]]
ckg[gg] <- true                     for (gg) in 0 .. nggz[0] if gisr[gg] if raxb[gdf[gg]] != raxf[gdr[gg]]
field ggn : max bound 16384
ggn[gg] <- 0                        for (gg) in 0 .. nggz[0]
ggn[gg] <- ggn[gg-1]                for (gg) in 0 .. nggz[0] if gg > 0 if gdr[gg-1] == gdr[gg]
ggn[gg] <- ggn[gg-1] + 2            for (gg) in 0 .. nggz[0] if gg > 0 if gdr[gg-1] == gdr[gg] if ckg[gg-1]
field ngd : max bound 16384
ngd[r] <- 0                         for (r) in 0 .. nrlz[0]
ngd[gdr[gg]] <- ggn[gg] + 2         for (gg) in 0 .. nggz[0] if ckg[gg]

# 座標の読み（`f[g[i]]` の g）。源 2 / 3 が場を引き、源 5（内側の所有者 `o[p[i, j]]` の p）も引く。
# 前は源 5 を数えていなかった —— 座標の読みはいつも下の層だったので、周回の入口で見なくても
# 同じだった。flat の座標の読みが同じ層に居られるようになったので、数えないと **動いたのに回らない**
field cdrd : or bound 32768                     # 座標のスロット gc は場を読む
cdrd[gc] <- true                    for (gc) in 0 .. ngcz[0] if cdsr[gc] >= 2 if cdsr[gc] <= 3
cdrd[gc] <- true                    for (gc) in 0 .. ngcz[0] if cdsr[gc] == 5
field ckc : or bound 32768                      # 座標のスロット gc の読みを周回の入口で見る（14o）
ckc[gc] <- true                     for (gc) in 0 .. ngcz[0] if cdrd[gc] if not rax[cdr[gc]]
ckc[gc] <- true                     for (gc) in 0 .. ngcz[0] if cdrd[gc] if not fxax[cdcf[gc]]
ckc[gc] <- true                     for (gc) in 0 .. ngcz[0] if cdrd[gc] if raxb[cdcf[gc]] != raxf[cdr[gc]]
field ccn : max bound 32768
ccn[gc] <- 0                        for (gc) in 0 .. ngcz[0]
ccn[gc] <- ccn[gc-1]                for (gc) in 0 .. ngcz[0] if gc > 0 if cdr[gc-1] == cdr[gc]
ccn[gc] <- ccn[gc-1] + 2            for (gc) in 0 .. ngcz[0] if gc > 0 if cdr[gc-1] == cdr[gc] if ckc[gc-1]
field ncd : max bound 16384
ncd[r] <- 0                         for (r) in 0 .. nrlz[0]
ncd[cdr[gc]] <- ccn[gc] + 2         for (gc) in 0 .. ngcz[0] if ckc[gc]

# ループの端の読み（上端が場 = 種 2/3、下端が場 = 13i）。**回る回数は宣言ではなく実測**。
# 一つのループが二つ読むことがある（`for (j) in s[i] .. e[i]`）ので、ループごとの数を鎖に足す。
field lcu : max bound 16384                     # 上端の読み（二つ刻み）
lcu[gl] <- 0                        for (gl) in 0 .. nglz[0]
lcu[gl] <- 2                        for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if not rax[lpr[gl]]
lcu[gl] <- 2                        for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if not fxax[lpbf[gl]]
lcu[gl] <- 2                        for (gl) in 0 .. nglz[0] if lpk[gl] >= 2 if raxb[lpbf[gl]] != raxf[lpr[gl]]
field lcl : max bound 16384                     # 下端の読み
lcl[gl] <- 0                        for (gl) in 0 .. nglz[0]
lcl[gl] <- 2                        for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lplk[gl] <= 2 if not rax[lpr[gl]]
lcl[gl] <- 2                        for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lplk[gl] <= 2 if not fxax[lplf[gl]]
lcl[gl] <- 2                        for (gl) in 0 .. nglz[0] if lplk[gl] >= 1 if lplk[gl] <= 2 if raxb[lplf[gl]] != raxf[lpr[gl]]
field lrd : max bound 16384
lrd[gl] <- lcu[gl] + lcl[gl]        for (gl) in 0 .. nglz[0]
field lcn : max bound 16384
lcn[gl] <- 0                        for (gl) in 0 .. nglz[0]
lcn[gl] <- lcn[gl-1] + lrd[gl-1]    for (gl) in 0 .. nglz[0] if gl > 0 if lpr[gl-1] == lpr[gl]
field nlp : max bound 16384
nlp[r] <- 0                         for (r) in 0 .. nrlz[0]
nlp[lpr[gl]] <- lcn[gl] + lrd[gl]   for (gl) in 0 .. nglz[0]

# ── 枠の大きさと位置 ─────────────────────────────────────────────
# 群ぜんぶの読みの数（後ろ向きの鎖。群は短いので数周で閉じる）
field gcnt : max bound 16384
gcnt[r] <- ntm[r] + ngd[r] + ncd[r] + nlp[r]   for (r) in 0 .. nrlz[0]
gcnt[r] <- ntm[r] + ngd[r] + ncd[r] + nlp[r] + gcnt[r+1]   for (r) in 0 .. nrlz[0] if not nofus[r+1]
# 群の中での規則 r の検査の始まり（前向きの鎖）
field roff : max bound 16384
roff[r] <- 0                        for (r) in 0 .. nrlz[0]
roff[r] <- roff[r-1] + ntm[r-1] + ngd[r-1] + ncd[r-1] + nlp[r-1]   for (r) in 0 .. nrlz[0] if r > 0 if not nofus[r]
# 一つも読まない群は「表」の枠（EP は 0 のまま）を一つ見る —— 初回だけ通る
ckl[r] <- 0                         for (r) in 0 .. nrlz[0]
ckl[r] <- gcnt[r] + 3               for (r) in 0 .. nrlz[0] if nofus[r]
ckl[r] <- 5                         for (r) in 0 .. nrlz[0] if nofus[r] if gcnt[r] == 0
field ckj : max bound 16384                     # 飛ばす jmp の位置（群の先頭が持つ）
ckj[r] <- gcnt[r] + ckp[r] + 1      for (r) in 0 .. nrlz[0] if nofus[r]
ckj[r] <- ckp[r] + 3                for (r) in 0 .. nrlz[0] if nofus[r] if gcnt[r] == 0
ckj[r] <- ckj[r-1]                  for (r) in 0 .. nrlz[0] if r > 0 if not nofus[r]

# ── 検査の骨 ────────────────────────────────────────────────────
form[ckp[r]] <- 159                  for (r) in 0 .. nrlz[0] if nofus[r]   # mov rax,[LAST]
imm[ckp[r]]  <- r * 8 + epsz[0] + bias[0] - gpz[0]   for (r) in 0 .. nrlz[0] if nofus[r]
form[ckj[r]] <- 78                   for (r) in 0 .. nrlz[0] if nofus[r]   # jmp -> 群の終わり
jt[ckj[r]]   <- gend[r]              for (r) in 0 .. nrlz[0] if nofus[r]
form[ckj[r] + 1] <- 161              for (r) in 0 .. nrlz[0] if nofus[r]   # mov [LAST],r15
imm[ckj[r] + 1]  <- r * 8 + epsz[0] + bias[0] - gpz[0]   for (r) in 0 .. nrlz[0] if nofus[r]
# 一つも読まない規則の枠（「表」の枠を見る）
form[ckp[r] + 1] <- 160              for (r) in 0 .. nrlz[0] if nofus[r] if gcnt[r] == 0
imm[ckp[r] + 1]  <- epsz[0] + bias[0] - gpz[0] - 8   for (r) in 0 .. nrlz[0] if nofus[r] if gcnt[r] == 0
form[ckp[r] + 2] <- 73               for (r) in 0 .. nrlz[0] if nofus[r] if gcnt[r] == 0
jt[ckp[r] + 2]   <- ckj[r] + 1       for (r) in 0 .. nrlz[0] if nofus[r] if gcnt[r] == 0

# 項の読み
field tck : max bound 16384
tck[gt] <- tcn[gt] + ckp[tmr[gt]] + roff[tmr[gt]] + 1   for (gt) in 0 .. ngtz[0] if ckt[gt]
form[tck[gt]] <- 160                 for (gt) in 0 .. ngtz[0] if ckt[gt]
imm[tck[gt]]  <- tmf[gt] * 8 + bias[0] - gpz[0]   for (gt) in 0 .. ngtz[0] if ckt[gt]
form[tck[gt] + 1] <- 73              for (gt) in 0 .. ngtz[0] if ckt[gt]
jt[tck[gt] + 1]   <- ckj[tmr[gt]] + 1   for (gt) in 0 .. ngtz[0] if ckt[gt]

# ガードの読み
field gck : max bound 16384
gck[gg] <- ggn[gg] + ntm[gdr[gg]] + ckp[gdr[gg]] + roff[gdr[gg]] + 1   for (gg) in 0 .. nggz[0] if ckg[gg]
form[gck[gg]] <- 160                 for (gg) in 0 .. nggz[0] if ckg[gg]
imm[gck[gg]]  <- gdf[gg] * 8 + bias[0] - gpz[0]   for (gg) in 0 .. nggz[0] if ckg[gg]
form[gck[gg] + 1] <- 73              for (gg) in 0 .. nggz[0] if ckg[gg]
jt[gck[gg] + 1]   <- ckj[gdr[gg]] + 1   for (gg) in 0 .. nggz[0] if ckg[gg]

# 座標の読み
field cck : max bound 32768
cck[gc] <- ccn[gc] + ntm[cdr[gc]] + ngd[cdr[gc]] + ckp[cdr[gc]] + roff[cdr[gc]] + 1   for (gc) in 0 .. ngcz[0] if ckc[gc]
form[cck[gc]] <- 160                 for (gc) in 0 .. ngcz[0] if ckc[gc]
imm[cck[gc]]  <- cdcf[gc] * 8 + bias[0] - gpz[0]   for (gc) in 0 .. ngcz[0] if ckc[gc]
form[cck[gc] + 1] <- 73              for (gc) in 0 .. ngcz[0] if ckc[gc]
jt[cck[gc] + 1]   <- ckj[cdr[gc]] + 1   for (gc) in 0 .. ngcz[0] if ckc[gc]

# ループの端の読み（上端が先、下端が後）
field lck : max bound 16384
lck[gl] <- lcn[gl] + ntm[lpr[gl]] + ngd[lpr[gl]] + ncd[lpr[gl]] + ckp[lpr[gl]] + roff[lpr[gl]] + 1   for (gl) in 0 .. nglz[0]
form[lck[gl]] <- 160                 for (gl) in 0 .. nglz[0] if lcu[gl] == 2
imm[lck[gl]]  <- lpbf[gl] * 8 + bias[0] - gpz[0]   for (gl) in 0 .. nglz[0] if lcu[gl] == 2
form[lck[gl] + 1] <- 73              for (gl) in 0 .. nglz[0] if lcu[gl] == 2
jt[lck[gl] + 1]   <- ckj[lpr[gl]] + 1   for (gl) in 0 .. nglz[0] if lcu[gl] == 2
field lckl : max bound 16384
lckl[gl] <- lck[gl] + lcu[gl]       for (gl) in 0 .. nglz[0] if lcl[gl] == 2
form[lckl[gl]] <- 160                for (gl) in 0 .. nglz[0] if lcl[gl] == 2
imm[lckl[gl]]  <- lplf[gl] * 8 + bias[0] - gpz[0]   for (gl) in 0 .. nglz[0] if lcl[gl] == 2
form[lckl[gl] + 1] <- 73             for (gl) in 0 .. nglz[0] if lcl[gl] == 2
jt[lckl[gl] + 1]   <- ckj[lpr[gl]] + 1   for (gl) in 0 .. nglz[0] if lcl[gl] == 2

# ── 周回番号 r15 は前置きで 1 から始める（EP も LAST も 0 なので初回は通る）
field pbm : max bound 1
pbm[z] <- pb[0] - 1                  for (z) in 0 .. 0
form[pbm[z]] <- 162                  for (z) in 0 .. 0
imm[pbm[z]]  <- 1 + bias[0]          for (z) in 0 .. 0

# ── 後始末。**答えは stdout、証人は stderr** ─────────────────────────
# 場をバイトで書く口があるとき（emit の幅が 1）、8バイトの升から下位バイトだけを
# 詰め直してから書く。ELF を吐くのはこの口である —— 記述が機械を構成する。
# 階数は必ず出す（不変条件6）。ただし別の口へ: 答えと証人は混ざってはいけない。
# **場を定数で引いた場は座標にならない。** `foff[outf[0]]` の添字は
# 「定数で引いた場」で、焼ける五つの源（列・計数器・列で引いた場・
# 計数器で引いた場・定数）のどれでもない —— 名前を一つ置けば計数器で引く形になる。
field ofz : max bound 1                     # 出す場（計数器で引ける形）
ofz[z] <- outf[0]                    for (z) in 0 .. 0
field ebyte : or bound 1                    # バイトで書く場があるか
ebyte[z] <- true                     for (z) in 0 .. 0 for (z) in 0 .. 0 if outw[0] == 1
field pklen : max bound 1                   # 詰め直しの長さ
pklen[0] <- 0
pklen[z] <- nrf[0] * 12 + 1          for (z) in 0 .. 0 if outw[0] == 1   # 頭一つ + 描く場ごとに十二
field pbuf : max bound 1                    # 詰め直しの置き場（生の後ろ）
pbuf[0] <- rbuf[0] + rcap[0]   for (z) in 0 .. 0

# 詰め直し（バイトの口があるときだけ）
# **⊥ の升は飛ばす**（解釈実行の render と同じ —— 座標が並びを決め、
# 「無い」升は文字を持たない）。だから長さは走ってみないと分からない ——
# 詰め終わった位置から置き場を引けば、それがそのまま長さである。
# **描く場は書いた順に並べる**（解釈実行の render と同じ）。rdx は場をまたいで進むので
# 頭で一度だけ置く。描く場ごとに十二命令: 場の番号を r15 に置いておく（周回はもう終わって
# いるので r15 は空いている）—— バイトでない値の出口がどの場かを言えるように。
form[ebz[z]] <- 37   for (z) in 0 .. 0 if outw[0] == 1   # mov rdx, PBUF
imm[ebz[z]]  <- pbuf[0] + bias[0]   for (z) in 0 .. 0 if outw[0] == 1
field epk : max bound 8                     # k 番目の描く場の十二命令の頭
epk[k] <- ebase[0] + k * 12 + 1   for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k]] <- 3        for (k) in 0 .. nrfz[0] if outw[0] == 1   # mov rcx, 0
imm[epk[k]]  <- 0 + bias[0]        for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k] + 1] <- 162  for (k) in 0 .. nrfz[0] if outw[0] == 1   # mov r15d, 描く場
imm[epk[k] + 1]  <- orz[k] + bias[0]    for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k] + 2] <- fer[orz[k]]  for (k) in 0 .. nrfz[0] if outw[0] == 1   # mov rax,[rbx+rcx*8+foff]
imm[epk[k] + 2]  <- foff[orz[k]] + bias[0] for (k) in 0 .. nrfz[0] if outw[0] == 1
scb[epk[k] + 2]  <- fscb[orz[k]] for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k] + 3] <- 12   for (k) in 0 .. nrfz[0] if outw[0] == 1   # cmp rax, ⊥
imm[epk[k] + 3]  <- fbot[orz[k]]   for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k] + 4] <- 13   for (k) in 0 .. nrfz[0] if outw[0] == 1   # je -> 次の升へ
jt[epk[k] + 4]   <- epk[k] + 9     for (k) in 0 .. nrfz[0] if outw[0] == 1
# **バイトでない値は描けない。** 前は下位の八ビットだけを書いた —— 300 が 44 に、
# -1 が 255 になった（解釈実行は 300 を文字として持ち、負は飛ばす）。0..255 の外で止まる
# （終了コード 2）。符号なしの ja なので負も捕まる。出口の一命令目（場の番号）は飛ばす。
form[epk[k] + 5] <- 12   for (k) in 0 .. nrfz[0] if outw[0] == 1   # cmp rax, 255
imm[epk[k] + 5]  <- 255 + bias[0]  for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k] + 6] <- 194  for (k) in 0 .. nrfz[0] if outw[0] == 1   # ja -> 描画の出口（二命令目）
jt[epk[k] + 6]   <- rpx[0] + 1     for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k] + 7] <- 126  for (k) in 0 .. nrfz[0] if outw[0] == 1   # mov [rdx], al
form[epk[k] + 8] <- 127  for (k) in 0 .. nrfz[0] if outw[0] == 1   # add rdx, 1
imm[epk[k] + 8]  <- 1 + bias[0]    for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k] + 9] <- 5    for (k) in 0 .. nrfz[0] if outw[0] == 1   # add rcx, 1
imm[epk[k] + 9]  <- 1 + bias[0]    for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k] + 10] <- 20   for (k) in 0 .. nrfz[0] if outw[0] == 1   # cmp rcx, 升数
imm[epk[k] + 10]  <- fsz[orz[k]] + bias[0]  for (k) in 0 .. nrfz[0] if outw[0] == 1
form[epk[k] + 11] <- 7    for (k) in 0 .. nrfz[0] if outw[0] == 1   # jb -> 詰め直しの頭
jt[epk[k] + 11]   <- epk[k] + 2  for (k) in 0 .. nrfz[0] if outw[0] == 1

# ── 書き出し。**部分書き込みに耐える**（パイプは一度で全部受け取らない）
# 読みが回るなら書きも回る —— 同じ形を二度書かない理由は無い。
field wb : max bound 1
# ── **⊥ を 0 に置いた場を解く**（場の面を書き出すときだけ）─────────────────
# 場の面は境界面である（試験も attest も値そのものを読む）。置き方は焼いた符号の内側の
# 事情なので、外へ出す前に xor で戻す。**描く本は証人（fd 3）を頼まれたときだけ**解く ——
# 頼まれていないのに解けば、塗るのをやめた頁を出口で全部触ることになる。頼まれたかは
# 零バイトの write(3) で聞く（閉じていれば EBADF）。描く本の rdx（詰め終わった位置）は守る。
field dbz : max bound 1                     # 解く所の頭
dbz[0] <- ebase[0] + pklen[0]   for (z) in 0 .. 0
field dhd : max bound 1                     # 頭の命令数（描く本は証人を聞く八命令）
dhd[0] <- 0
dhd[z] <- 8                          for (z) in 0 .. 0 if outw[z] == 1
field zd6 : max bound 2048                  # 解く場だけを数えた鎖
zd6[0] <- 0
zd6[f] <- zd6[f-1] + 6               for (f) in 0 .. nflz[0] if f > 0 if fxr[f-1]
zd6[f] <- zd6[f-1]                   for (f) in 0 .. nflz[0] if f > 0 if not fxr[f-1]
field ndc : max bound 1                     # 解く輪の命令数
ndc[0] <- 0
ndc[z] <- zd6[f] + 6                 for (f) in 0 .. nflz[0] for (z) in 0 .. 0 if fxr[f]
field dclen : max bound 1                   # 解く所の長さ（解く場が無ければ 0）
dclen[0] <- 0
dclen[z] <- ndc[0]                   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 8
dclen[z] <- ndc[0] + 9               for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1
field dcp : max bound 2048                  # 場 f を解く六命令の頭
dcp[f] <- dbz[0] + dhd[0] + zd6[f]   for (f) in 0 .. nflz[0] if fxr[f]
field dcz : max bound 1                     # dbz を計数器で引ける形に
dcz[z] <- dbz[0]                     for (z) in 0 .. 0
field dce : max bound 1                     # 解き終わり（描く本の pop rdx）
dce[z] <- dbz[0] + dclen[0] - 1      for (z) in 0 .. 0
form[dcz[z]]     <- 33   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1   # push rdx
form[dcz[z] + 1] <- 24   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1   # mov eax, 1 (sys_write)
imm[dcz[z] + 1]  <- 1 + bias[0]     for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1
form[dcz[z] + 2] <- 38   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1   # mov rdi, 3
imm[dcz[z] + 2]  <- 3 + bias[0]     for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1
form[dcz[z] + 3] <- 36   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1   # mov rsi, 詰め直しの置き場
imm[dcz[z] + 3]  <- pbuf[0] + bias[0]   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1
form[dcz[z] + 4] <- 37   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1   # mov rdx, 0
imm[dcz[z] + 4]  <- 0 + bias[0]     for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1
form[dcz[z] + 5] <- 25   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1   # syscall
form[dcz[z] + 6] <- 26   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1   # test rax,rax
form[dcz[z] + 7] <- 22   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1   # jne -> 解き終わり
jt[dcz[z] + 7]   <- dce[z]          for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1
form[dce[z]]     <- 35   for (z) in 0 .. 0 if nxr[z] == 4 if outw[z] == 1   # pop rdx
form[dcp[f]] <- 2                  for (f) in 0 .. nflz[0] if fxr[f] if not fxm[f]   # mov rax, 鍵
imm[dcp[f]]  <- 2147483647 + bias[0]          for (f) in 0 .. nflz[0] if fxr[f] if not fxm[f]
form[dcp[f]] <- 2                  for (f) in 0 .. nflz[0] if fxm[f]
imm[dcp[f]]  <- 0 - 2147483647 + bias[0]      for (f) in 0 .. nflz[0] if fxm[f]
form[dcp[f] + 1] <- 3              for (f) in 0 .. nflz[0] if fxr[f]   # mov rcx, 0
imm[dcp[f] + 1]  <- 0 + bias[0]    for (f) in 0 .. nflz[0] if fxr[f]
form[dcp[f] + 2] <- 39             for (f) in 0 .. nflz[0] if fxr[f]   # xor [rbx+rcx*8+foff],rax
imm[dcp[f] + 2]  <- foff[f] + bias[0]   for (f) in 0 .. nflz[0] if fxr[f]
scb[dcp[f] + 2]  <- fscb[f]        for (f) in 0 .. nflz[0] if fxr[f]
form[dcp[f] + 3] <- 5              for (f) in 0 .. nflz[0] if fxr[f]   # add rcx, 1
imm[dcp[f] + 3]  <- 1 + bias[0]    for (f) in 0 .. nflz[0] if fxr[f]
form[dcp[f] + 4] <- 20             for (f) in 0 .. nflz[0] if fxr[f]   # cmp rcx, 升目の数
imm[dcp[f] + 4]  <- fsz[f] + bias[0]    for (f) in 0 .. nflz[0] if fxr[f]
form[dcp[f] + 5] <- 7              for (f) in 0 .. nflz[0] if fxr[f]   # jb -> 解く輪の頭
jt[dcp[f] + 5]   <- dcp[f] + 2     for (f) in 0 .. nflz[0] if fxr[f]
wb[0] <- ebase[0] + pklen[0] + dclen[0]   for (z) in 0 .. 0
field wbz : max bound 1                     # wb を計数器で引ける形に
wbz[z] <- wb[0]                      for (z) in 0 .. 0
# ── 出す先を決める（argv[2]。無ければ stdout）────────────────────
form[wbz[z]]     <- 27   for (z) in 0 .. 0# mov rbp, 1     （既定は stdout）
imm[wbz[z]]      <- 1 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 1] <- 54   for (z) in 0 .. 0# mov rax,[rsp]  （argc。**push の前に読む**）
form[wbz[z] + 2] <- 28   for (z) in 0 .. 0# cmp rax, 3
form[wbz[z] + 3] <- 7    for (z) in 0 .. 0# jb -> 17       （引数が二つ未満 → stdout）
jt[wbz[z] + 3]   <- wb[0] + 17   for (z) in 0 .. 0
form[wbz[z] + 4] <- 33   for (z) in 0 .. 0# push rdx       （詰め直しの終端を守る）
form[wbz[z] + 5] <- 31   for (z) in 0 .. 0# mov rdi,[rsp+32]（argv[2]。push のぶん +8）
form[wbz[z] + 6] <- 24   for (z) in 0 .. 0# mov eax, 2     (sys_open)
imm[wbz[z] + 6]  <- 2 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 7] <- 36   for (z) in 0 .. 0# mov rsi, 577   (O_WRONLY|O_CREAT|O_TRUNC)
imm[wbz[z] + 7]  <- 577 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 8] <- 37   for (z) in 0 .. 0# mov rdx, 493   (0755)
imm[wbz[z] + 8]  <- 493 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 9] <- 25   for (z) in 0 .. 0# syscall
form[wbz[z] + 10] <- 26   for (z) in 0 .. 0# test rax,rax
form[wbz[z] + 11] <- 75   for (z) in 0 .. 0# jg -> 15       （開けた）
jt[wbz[z] + 11]   <- wb[0] + 15   for (z) in 0 .. 0
form[wbz[z] + 12] <- 24   for (z) in 0 .. 0# mov eax, 60
imm[wbz[z] + 12]  <- 60 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 13] <- 38   for (z) in 0 .. 0# mov rdi, 9    （出す先が開けない）
imm[wbz[z] + 13]  <- 9 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 14] <- 25   for (z) in 0 .. 0# syscall       （終了コード 9）
form[wbz[z] + 15] <- 59   for (z) in 0 .. 0# mov rbp, rax  （口を持つ）
form[wbz[z] + 16] <- 35   for (z) in 0 .. 0# pop rdx       （終端を戻す）

form[wbz[z] + 17]     <- 36   for (z) in 0 .. 0# mov rsi, 出す所
imm[wbz[z] + 17]      <- fbase[0] + bias[0]   for (z) in 0 .. 0 if outw[0] == 8
imm[wbz[z] + 17]      <- pbuf[0] + bias[0]            for (z) in 0 .. 0 if outw[0] == 1
form[wbz[z] + 18] <- 37   for (z) in 0 .. 0 if outw[0] == 8# mov rdx, 残りの大きさ
imm[wbz[z] + 18]  <- ftot[0] + bias[0]   for (z) in 0 .. 0 if outw[0] == 8
form[wbz[z] + 18] <- 155                            for (z) in 0 .. 0 if outw[0] == 1
imm[wbz[z] + 18]  <- pbuf[0] + bias[0]              for (z) in 0 .. 0 if outw[0] == 1
form[wbz[z] + 19] <- 24   for (z) in 0 .. 0# mov eax, 1   (sys_write)
imm[wbz[z] + 19]  <- 1 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 20] <- 49   for (z) in 0 .. 0# mov rdi, rbp （argv[2] か stdout）
form[wbz[z] + 21] <- 25   for (z) in 0 .. 0# syscall
form[wbz[z] + 22] <- 26   for (z) in 0 .. 0# test rax,rax
form[wbz[z] + 23] <- 48   for (z) in 0 .. 0# jle -> 書きの踏み台（残りが無ければ次へ、あれば終了コード 9）
jt[wbz[z] + 23]   <- wst[0]   for (z) in 0 .. 0
form[wbz[z] + 24] <- 76   for (z) in 0 .. 0# add rsi, rax
form[wbz[z] + 25] <- 129   for (z) in 0 .. 0# sub rdx, rax
form[wbz[z] + 26] <- 130   for (z) in 0 .. 0# test rdx,rdx
form[wbz[z] + 27] <- 116   for (z) in 0 .. 0# jg -> 書きの頭
jt[wbz[z] + 27]  <- wb[0] + 19   for (z) in 0 .. 0

# 証人は **別の口**（fd 3）。答えと混ざらない。ここも回す。
# **証人は値の面と階数の面を続けて出す**（二つは置き場で隣り合っている: kbase = fbase + ftot）。
# 前は階数の面だけだった —— 答えを描く本（render）は答えが fd 1 に描かれて場の面が出ないので、
# 答えを確かめる手が無かった。証人だけで [値][階数] が揃い、描いた答えはその値から確かめられる。
form[wbz[z] + 28] <- 36   for (z) in 0 .. 0
imm[wbz[z] + 28]  <- fbase[0] + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 29] <- 227   for (z) in 0 .. 0   # mov edx, 値 + 階数（零拡張。4 GB まで）
imm[wbz[z] + 29]  <- ftot2[0] + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 30] <- 24   for (z) in 0 .. 0
imm[wbz[z] + 30]  <- 1 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 31] <- 38   for (z) in 0 .. 0# mov rdi, 3   （証人は fd 3。開いていなければ EBADF）
imm[wbz[z] + 31]  <- 3 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 32] <- 25   for (z) in 0 .. 0
form[wbz[z] + 33] <- 26   for (z) in 0 .. 0
form[wbz[z] + 34] <- 48   for (z) in 0 .. 0# jle -> 証人の踏み台（fd 3 が閉じていれば諦める、ほかは 9）
jt[wbz[z] + 34]   <- wst[0] + 3   for (z) in 0 .. 0
form[wbz[z] + 35] <- 76   for (z) in 0 .. 0
form[wbz[z] + 36] <- 129   for (z) in 0 .. 0
form[wbz[z] + 37] <- 130   for (z) in 0 .. 0
form[wbz[z] + 38] <- 116   for (z) in 0 .. 0
jt[wbz[z] + 38]   <- wb[0] + 30   for (z) in 0 .. 0

field ovf : max bound 1                     # はみ出したときの出口
ovf[0] <- wb[0] + 42   for (z) in 0 .. 0
field ovz : max bound 1                     # ovf を計数器で引ける形に
ovz[z] <- ovf[0]                     for (z) in 0 .. 0
# **黙って 6 で終わるのをやめる。** ここは長いあいだ三命令だった ——
# `mov eax,60 / mov rdi,6 / syscall`。数字の 6 だけが残り、何が狭かったのか、
# 何を直せばいいのかは誰にも分からない。焼けなかったとき（終了コード 7）は
# 一行出すのに、走って落ちたときは出さない —— **同じ判断が二箇所にあって、
# 片方だけ実装されていた**（気づき34）。知らせの八命令は即値を持たない形
# だけで書けるので、前置きの即値とは混ざらない（上の `bad` と同じ手）。
# **どの場を踏んだかを言う。** 一行出るようにはなったが、言っているのは
# 「どこかの場」だけだった —— 見張りは、踏んだ場所を言えなければ半分しか
# 立っていない。規則ごとの踏み台が r15 に場番号を入れてここへ飛ぶので、
# 枠に落として四バイト小端で吐く（知らせの一行のあとに続く）。
form[ovz[z]]     <- 180   for (z) in 0 .. 0# mov [枠], r15（場番号）
form[ovz[z] + 1] <- 165   for (z) in 0 .. 0# mov eax, 1  (sys_write)
form[ovz[z] + 2] <- 166   for (z) in 0 .. 0# mov edi, 2  (stderr)
form[ovz[z] + 3] <- 174   for (z) in 0 .. 0# mov rsi, はみ出しの知らせ
form[ovz[z] + 4] <- 168   for (z) in 0 .. 0# mov rdx, 61
form[ovz[z] + 5] <- 158   for (z) in 0 .. 0# syscall
form[ovz[z] + 6] <- 165   for (z) in 0 .. 0# mov eax, 1
form[ovz[z] + 7] <- 166   for (z) in 0 .. 0# mov edi, 2
form[ovz[z] + 8] <- 181   for (z) in 0 .. 0# mov rsi, 枠
form[ovz[z] + 9] <- 182   for (z) in 0 .. 0# mov rdx, 4
form[ovz[z] + 10] <- 158   for (z) in 0 .. 0# syscall
form[ovz[z] + 11] <- 24   for (z) in 0 .. 0# mov eax, 60
imm[ovz[z] + 11]  <- 60 + bias[0]   for (z) in 0 .. 0
form[ovz[z] + 12] <- 38   for (z) in 0 .. 0# mov rdi, 6（**宣言した広さを超えた**）
imm[ovz[z] + 12]  <- 6 + bias[0]   for (z) in 0 .. 0
form[ovz[z] + 13] <- 25   for (z) in 0 .. 0

# ── ⊤ に達したときの出口（十四命令。はみ出しの出口と同じ形、終了コード 5）──
field tpx : max bound 1                     # ⊤ の出口
tpx[0] <- wb[0] + 56   for (z) in 0 .. 0
field tpz : max bound 1                     # tpx を計数器で引ける形に
tpz[z] <- tpx[0]                     for (z) in 0 .. 0
form[tpz[z]]      <- 180   for (z) in 0 .. 0# mov [枠], r15（場番号）
form[tpz[z] + 1]  <- 165   for (z) in 0 .. 0# mov eax, 1  (sys_write)
form[tpz[z] + 2]  <- 166   for (z) in 0 .. 0# mov edi, 2  (stderr)
form[tpz[z] + 3]  <- 186   for (z) in 0 .. 0# mov rsi, ⊤ の知らせ
form[tpz[z] + 4]  <- 168   for (z) in 0 .. 0# mov rdx, 61
form[tpz[z] + 5]  <- 158   for (z) in 0 .. 0# syscall
form[tpz[z] + 6]  <- 165   for (z) in 0 .. 0# mov eax, 1
form[tpz[z] + 7]  <- 166   for (z) in 0 .. 0# mov edi, 2
form[tpz[z] + 8]  <- 181   for (z) in 0 .. 0# mov rsi, 枠
form[tpz[z] + 9]  <- 182   for (z) in 0 .. 0# mov rdx, 4
form[tpz[z] + 10] <- 158   for (z) in 0 .. 0# syscall
form[tpz[z] + 11] <- 24   for (z) in 0 .. 0# mov eax, 60
imm[tpz[z] + 11]  <- 60 + bias[0]   for (z) in 0 .. 0
form[tpz[z] + 12] <- 38   for (z) in 0 .. 0# mov rdi, 5（**⊤ に達した**）
imm[tpz[z] + 12]  <- 5 + bias[0]   for (z) in 0 .. 0
form[tpz[z] + 13] <- 25   for (z) in 0 .. 0

# ── 値が印と重なったときの出口（十四命令、終了コード 4）──────────────────
field vpx : max bound 1                     # 値の出口
vpx[0] <- wb[0] + 70   for (z) in 0 .. 0
field vpz : max bound 1
vpz[z] <- vpx[0]                     for (z) in 0 .. 0
form[vpz[z]]      <- 180   for (z) in 0 .. 0# mov [枠], r15（場番号）
form[vpz[z] + 1]  <- 165   for (z) in 0 .. 0# mov eax, 1  (sys_write)
form[vpz[z] + 2]  <- 166   for (z) in 0 .. 0# mov edi, 2  (stderr)
form[vpz[z] + 3]  <- 187   for (z) in 0 .. 0# mov rsi, 値の知らせ
form[vpz[z] + 4]  <- 168   for (z) in 0 .. 0# mov rdx, 61
form[vpz[z] + 5]  <- 158   for (z) in 0 .. 0# syscall
form[vpz[z] + 6]  <- 165   for (z) in 0 .. 0# mov eax, 1
form[vpz[z] + 7]  <- 166   for (z) in 0 .. 0# mov edi, 2
form[vpz[z] + 8]  <- 181   for (z) in 0 .. 0# mov rsi, 枠
form[vpz[z] + 9]  <- 182   for (z) in 0 .. 0# mov rdx, 4
form[vpz[z] + 10] <- 158   for (z) in 0 .. 0# syscall
form[vpz[z] + 11] <- 24   for (z) in 0 .. 0# mov eax, 60
imm[vpz[z] + 11]  <- 60 + bias[0]   for (z) in 0 .. 0
form[vpz[z] + 12] <- 38   for (z) in 0 .. 0# mov rdi, 4（**値が印と重なった**）
imm[vpz[z] + 12]  <- 4 + bias[0]   for (z) in 0 .. 0
form[vpz[z] + 13] <- 25   for (z) in 0 .. 0

# ── 値が 64 ビットに収まらないときの出口（十四命令、終了コード 3）───────────
field opx : max bound 1                     # 溢れの出口
opx[0] <- wb[0] + 84   for (z) in 0 .. 0
field opz : max bound 1
opz[z] <- opx[0]                     for (z) in 0 .. 0
form[opz[z]]      <- 180   for (z) in 0 .. 0# mov [枠], r15（場番号）
form[opz[z] + 1]  <- 165   for (z) in 0 .. 0# mov eax, 1  (sys_write)
form[opz[z] + 2]  <- 166   for (z) in 0 .. 0# mov edi, 2  (stderr)
form[opz[z] + 3]  <- 192   for (z) in 0 .. 0# mov rsi, 溢れの知らせ
form[opz[z] + 4]  <- 168   for (z) in 0 .. 0# mov rdx, 61
form[opz[z] + 5]  <- 158   for (z) in 0 .. 0# syscall
form[opz[z] + 6]  <- 165   for (z) in 0 .. 0# mov eax, 1
form[opz[z] + 7]  <- 166   for (z) in 0 .. 0# mov edi, 2
form[opz[z] + 8]  <- 181   for (z) in 0 .. 0# mov rsi, 枠
form[opz[z] + 9]  <- 182   for (z) in 0 .. 0# mov rdx, 4
form[opz[z] + 10] <- 158   for (z) in 0 .. 0# syscall
form[opz[z] + 11] <- 24   for (z) in 0 .. 0# mov eax, 60
imm[opz[z] + 11]  <- 60 + bias[0]   for (z) in 0 .. 0
form[opz[z] + 12] <- 38   for (z) in 0 .. 0# mov rdi, 3（**値が 64 ビットに収まらない**）
imm[opz[z] + 12]  <- 3 + bias[0]   for (z) in 0 .. 0
form[opz[z] + 13] <- 25   for (z) in 0 .. 0

# ── 描く値がバイトでないときの出口（十五命令、終了コード 2）───────────────
#   描く場の番号は詰め直しが r15 に置いてあるので、詰め直しからは二命令目へ飛ぶ
#   （一命令目は描く本でない道の番兵のまま）
field rpx : max bound 1                     # 描画の出口
rpx[0] <- wb[0] + 98   for (z) in 0 .. 0
field rpz : max bound 1
rpz[z] <- rpx[0]                     for (z) in 0 .. 0
form[rpz[z]]      <- 162   for (z) in 0 .. 0# mov r15d, 描く場
imm[rpz[z]]       <- ofz[0] + bias[0]   for (z) in 0 .. 0 if outw[0] == 1
imm[rpz[z]]       <- bias[0]   for (z) in 0 .. 0
form[rpz[z] + 1]  <- 180   for (z) in 0 .. 0# mov [枠], r15（場番号）
form[rpz[z] + 2]  <- 165   for (z) in 0 .. 0# mov eax, 1  (sys_write)
form[rpz[z] + 3]  <- 166   for (z) in 0 .. 0# mov edi, 2  (stderr)
form[rpz[z] + 4]  <- 193   for (z) in 0 .. 0# mov rsi, 描画の知らせ
form[rpz[z] + 5]  <- 168   for (z) in 0 .. 0# mov rdx, 61
form[rpz[z] + 6]  <- 158   for (z) in 0 .. 0# syscall
form[rpz[z] + 7]  <- 165   for (z) in 0 .. 0# mov eax, 1
form[rpz[z] + 8]  <- 166   for (z) in 0 .. 0# mov edi, 2
form[rpz[z] + 9]  <- 181   for (z) in 0 .. 0# mov rsi, 枠
form[rpz[z] + 10] <- 182   for (z) in 0 .. 0# mov rdx, 4
form[rpz[z] + 11] <- 158   for (z) in 0 .. 0# syscall
form[rpz[z] + 12] <- 24   for (z) in 0 .. 0# mov eax, 60
imm[rpz[z] + 12]  <- 60 + bias[0]   for (z) in 0 .. 0
form[rpz[z] + 13] <- 38   for (z) in 0 .. 0# mov rdi, 2（**描く値がバイトでない**）
imm[rpz[z] + 13]  <- 2 + bias[0]   for (z) in 0 .. 0
form[rpz[z] + 14] <- 25   for (z) in 0 .. 0

# ── 区間が言語の上限より広いときの出口（十四命令、終了コード 10）───────────
field gpx : max bound 1                     # 区間の出口
gpx[0] <- wb[0] + 113   for (z) in 0 .. 0
field gxz : max bound 1
gxz[z] <- gpx[0]                     for (z) in 0 .. 0
form[gxz[z]]      <- 180   for (z) in 0 .. 0# mov [枠], r15（上端の場の番号）
form[gxz[z] + 1]  <- 165   for (z) in 0 .. 0# mov eax, 1  (sys_write)
form[gxz[z] + 2]  <- 166   for (z) in 0 .. 0# mov edi, 2  (stderr)
form[gxz[z] + 3]  <- 196   for (z) in 0 .. 0# mov rsi, 区間の知らせ
form[gxz[z] + 4]  <- 168   for (z) in 0 .. 0# mov rdx, 61
form[gxz[z] + 5]  <- 158   for (z) in 0 .. 0# syscall
form[gxz[z] + 6]  <- 165   for (z) in 0 .. 0# mov eax, 1
form[gxz[z] + 7]  <- 166   for (z) in 0 .. 0# mov edi, 2
form[gxz[z] + 8]  <- 181   for (z) in 0 .. 0# mov rsi, 枠
form[gxz[z] + 9]  <- 182   for (z) in 0 .. 0# mov rdx, 4
form[gxz[z] + 10] <- 158   for (z) in 0 .. 0# syscall
form[gxz[z] + 11] <- 24   for (z) in 0 .. 0# mov eax, 60
imm[gxz[z] + 11]  <- 60 + bias[0]   for (z) in 0 .. 0
form[gxz[z] + 12] <- 38   for (z) in 0 .. 0# mov rdi, 10（**区間が言語の上限より広い**）
imm[gxz[z] + 12]  <- 10 + bias[0]   for (z) in 0 .. 0
form[gxz[z] + 13] <- 25   for (z) in 0 .. 0

# ── 場ごとの踏み台（二命令）────────────────────────────────────
# 出口は全規則で共有しているので、飛ぶ前に場番号を渡せない。場ごとに二命令だけ
# 置き、そこを経由させる。使われるのは落ちるときだけで、一本の書き込みも重くならない。
# 前は **規則ごとに**置いていた（1,777 規則 × 11 バイト）。知らせるのは場の番号
# だけなので、場ごと（666 場）で足りる —— 同じ場を書く規則は同じ踏み台へ飛ぶ。
field stbz : max bound 1                    # 踏み台の頭
stbz[z] <- wb[0] + 127               for (z) in 0 .. 0
field f2 : max bound 2048                   # 場 f の踏み台のずれ
f2[f] <- f * 2                      for (f) in 0 .. nflz[0]
field ovs : max bound 2048                  # 場 f のはみ出しの踏み台
ovs[f] <- stbz[0] + f2[f]           for (f) in 0 .. nflz[0]
form[ovs[f]] <- 162                 for (f) in 0 .. nflz[0]   # mov r15d, 場番号
imm[ovs[f]]  <- f + bias[0]         for (f) in 0 .. nflz[0]
form[ovs[f] + 1] <- 78              for (f) in 0 .. nflz[0]   # jmp -> はみ出しの出口
jt[ovs[f] + 1]   <- ovf[0]          for (f) in 0 .. nflz[0]
# 値の踏み台（二命令）—— はみ出しの踏み台の後ろに並べる
field vsf : max bound 2048                  # 場 f の値の踏み台
vsf[f] <- stbz[0] + nfl2[0] + f2[f]   for (f) in 0 .. nflz[0]
form[vsf[f]] <- 162                 for (f) in 0 .. nflz[0]   # mov r15d, 場番号
imm[vsf[f]]  <- f + bias[0]         for (f) in 0 .. nflz[0]
form[vsf[f] + 1] <- 78              for (f) in 0 .. nflz[0]   # jmp -> 値の出口
jt[vsf[f] + 1]   <- vpx[0]          for (f) in 0 .. nflz[0]
# 溢れの踏み台（二命令）—— 値の踏み台の後ろに並べる
field osf : max bound 2048                  # 場 f の溢れの踏み台
osf[f] <- stbz[0] + nfl2[0] + nfl2[0] + f2[f]   for (f) in 0 .. nflz[0]
form[osf[f]] <- 162                 for (f) in 0 .. nflz[0]   # mov r15d, 場番号
imm[osf[f]]  <- f + bias[0]         for (f) in 0 .. nflz[0]
form[osf[f] + 1] <- 78              for (f) in 0 .. nflz[0]   # jmp -> 溢れの出口
jt[osf[f] + 1]   <- opx[0]          for (f) in 0 .. nflz[0]
# 入力の踏み台（二命令）—— 置き場より大きい入力。場の番号の代わりに -1（表）を言う
field ist : max bound 1
ist[z] <- stbz[0] + nfl2[0] + nfl2[0] + nfl2[0]   for (z) in 0 .. 0
field isz : max bound 1
isz[z] <- ist[0]                     for (z) in 0 .. 0
form[isz[z]] <- 162                  for (z) in 0 .. 0   # mov r15d, -1（表）
imm[isz[z]]  <- bias[0] - 1          for (z) in 0 .. 0
form[isz[z] + 1] <- 78               for (z) in 0 .. 0   # jmp -> はみ出しの出口（終了コード 6）
jt[isz[z] + 1]   <- ovf[0]           for (z) in 0 .. 0
# **書けなかったことを黙らない。** 答えの書きは「書けないなら諦める」で、`> /dev/full`
# でも読み手が先に閉じても終了コード 0 だった —— 答えが出ていないのに「出た」と言った。
# 書きが 0 以下を返したら: 残りが無ければ（大きさ 0 の答え）次へ、あれば終了コード 9
# （出す先に書けない）。証人（fd 3）は頼まれなければ閉じているので、EBADF だけは諦める。
field wst : max bound 1                     # 書きの踏み台（答え三命令・証人五命令）
wst[z] <- ist[0] + 2                 for (z) in 0 .. 0
field wsz : max bound 1
wsz[z] <- wst[0]                     for (z) in 0 .. 0
form[wsz[z]]     <- 130              for (z) in 0 .. 0   # test rdx, rdx
form[wsz[z] + 1] <- 13               for (z) in 0 .. 0   # je -> 証人へ（答えは書き終えていた）
jt[wsz[z] + 1]   <- wb[0] + 28       for (z) in 0 .. 0
form[wsz[z] + 2] <- 78               for (z) in 0 .. 0   # jmp -> 終了コード 9
jt[wsz[z] + 2]   <- wb[0] + 12       for (z) in 0 .. 0
form[wsz[z] + 3] <- 130              for (z) in 0 .. 0   # test rdx, rdx
form[wsz[z] + 4] <- 13               for (z) in 0 .. 0   # je -> 終わり
jt[wsz[z] + 4]   <- wb[0] + 39       for (z) in 0 .. 0
form[wsz[z] + 5] <- 12               for (z) in 0 .. 0   # cmp rax, -9（EBADF: 証人は頼まれていない）
imm[wsz[z] + 5]  <- bias[0] - 9      for (z) in 0 .. 0
form[wsz[z] + 6] <- 13               for (z) in 0 .. 0   # je -> 終わり
jt[wsz[z] + 6]   <- wb[0] + 39       for (z) in 0 .. 0
form[wsz[z] + 7] <- 78               for (z) in 0 .. 0   # jmp -> 終了コード 9
jt[wsz[z] + 7]   <- wb[0] + 12       for (z) in 0 .. 0
# 区間の踏み台（二命令）—— 書きの踏み台の後ろに、場ごとに並べる
field rsf : max bound 2048                  # 場 f を上端に持つ区間の踏み台
rsf[f] <- wst[0] + 8 + f2[f]        for (f) in 0 .. nflz[0]
form[rsf[f]] <- 162                 for (f) in 0 .. nflz[0]   # mov r15d, 場番号
imm[rsf[f]]  <- f + bias[0]         for (f) in 0 .. nflz[0]
form[rsf[f] + 1] <- 78              for (f) in 0 .. nflz[0]   # jmp -> 区間の出口
jt[rsf[f] + 1]   <- gpx[0]          for (f) in 0 .. nflz[0]
# ── 周回が上限を越えたときの出口（十四命令、終了コード 11）—— 区間の踏み台の後ろ ──────────
# 番号の枠には周回の番号（r15）を落とす
field cpx : max bound 1                     # 周回の出口
cpx[z] <- wst[0] + 8 + nfl2[0]       for (z) in 0 .. 0
field cpz : max bound 1
cpz[z] <- cpx[0]                     for (z) in 0 .. 0
form[cpz[z]]      <- 180   for (z) in 0 .. 0# mov [枠], r15（周回の番号）
form[cpz[z] + 1]  <- 165   for (z) in 0 .. 0# mov eax, 1  (sys_write)
form[cpz[z] + 2]  <- 166   for (z) in 0 .. 0# mov edi, 2  (stderr)
form[cpz[z] + 3]  <- 200   for (z) in 0 .. 0# mov rsi, 周回の知らせ
form[cpz[z] + 4]  <- 168   for (z) in 0 .. 0# mov rdx, 61
form[cpz[z] + 5]  <- 158   for (z) in 0 .. 0# syscall
form[cpz[z] + 6]  <- 165   for (z) in 0 .. 0# mov eax, 1
form[cpz[z] + 7]  <- 166   for (z) in 0 .. 0# mov edi, 2
form[cpz[z] + 8]  <- 181   for (z) in 0 .. 0# mov rsi, 枠
form[cpz[z] + 9]  <- 182   for (z) in 0 .. 0# mov rdx, 4
form[cpz[z] + 10] <- 158   for (z) in 0 .. 0# syscall
form[cpz[z] + 11] <- 24   for (z) in 0 .. 0# mov eax, 60
imm[cpz[z] + 11]  <- 60 + bias[0]   for (z) in 0 .. 0
form[cpz[z] + 12] <- 38   for (z) in 0 .. 0# mov rdi, 11（**周回が上限を越えた**）
imm[cpz[z] + 12]  <- 11 + bias[0]   for (z) in 0 .. 0
form[cpz[z] + 13] <- 25   for (z) in 0 .. 0



form[wbz[z] + 39] <- 24   for (z) in 0 .. 0# mov eax, 60
imm[wbz[z] + 39]  <- 60 + bias[0]   for (z) in 0 .. 0
form[wbz[z] + 40] <- 38   for (z) in 0 .. 0# mov rdi, 0
imm[wbz[z] + 40]  <- 0 + bias[0]   for (z) in 0 .. 0
# **終了コードの升**（14t）: `_exit` という場（sum、一升）があれば、答えを書いたあと、その値で終わる（無ければ 0）。
# 下ろしが `budget top <= N` を「⊤ の升が N を越えたら 4」にするのに使う —— 定義は答えを出してから 4 で終わる
form[wbz[z] + 40] <- 244   for (z) in 0 .. 0 if fexz[0] >= 0      # mov rdi,[rbx+d32]（_exit[0]）
field fexo : max bound 1                    # その升のずれ（読みを一段に保つ写し）
fexo[z] <- foff[fexz[z]]   for (z) in 0 .. 0 if fexz[z] >= 0
imm[wbz[z] + 40]  <- fexo[0] + bias[0]   for (z) in 0 .. 0 if fexz[0] >= 0
form[wbz[z] + 41] <- 25   for (z) in 0 .. 0

# ── 番地。**命令番号に沿った鎖**（逐次実行ではない）────────────────
field ilen : max bound 262144
ilen[n] <- shln[form[n]]            for (n) in 0 .. ninz[0]

field off : max bound 262144
off[0] <- 0
off[n] <- off[n-1] + ilen[n-1]      for (n) in 1 .. ninz[0]

field codelen : max bound 1
codelen[z] <- off[n] + ilen[n]       for (n) in 0 .. ninz[0] for (z) in 0 .. 0

# 相対飛びは **番地の差**。次の命令の頭からの差である。
field rel : max bound 262144
rel[n] <- off[jt[n]] - off[n] - ilen[n]   for (n) in 0 .. ninz[0]


# ── 導けたか（**数えて比べる**）────────────────────────────────
# 数え方は集約ではなく **前置きの鎖**（区間の集約は runtime.py がまだ焼けない）。
field okr : or bound 16384                   # 寸法の出た規則
okr[r] <- true                      for (r) in 0 .. nrlz[0] if blen[r] >= 1
field cok : max bound 16384                  # ここまでに寸法の出た規則の数
cok[0] <- 0
cok[z] <- 1                         for (z) in 0 .. 0 if okr[0]
cok[r] <- cok[r-1]                  for (r) in 1 .. nrlz[0] if not okr[r]
cok[r] <- cok[r-1] + 1              for (r) in 1 .. nrlz[0] if okr[r]
field nokr : max bound 1
nokr[z] <- cok[r]                   for (r) in 0 .. nrlz[0] for (z) in 0 .. 0
# **上の `cok`（規則）も下の `okt`（項）も 4096 なのに、種だけ 1024 だった。**
# 同じ段落の、同じ形の、三つ並んだ判断のうち一つだけが古い数のまま残る ——
# 直したときに目に入らなかったからで、目に入らないことこそが理由である。
field oks : or bound 16384                   # 場の出た種
oks[sd] <- true                     for (sd) in 0 .. nsdz[0] if sdf[sd] < nfld[0]
field cos : max bound 16384
cos[0] <- 0
cos[z] <- 1                         for (z) in 0 .. 0 if oks[0]
cos[sd] <- cos[sd-1]                for (sd) in 1 .. nsdz[0] if not oks[sd]
cos[sd] <- cos[sd-1] + 1            for (sd) in 1 .. nsdz[0] if oks[sd]
field noks : max bound 1
noks[z] <- cos[sd]                  for (sd) in 0 .. nsdz[0] for (z) in 0 .. 0
# 項・ガード・ループ・座標も同じ —— **種が出ていなければ焼けない**。
# （既定値と max が「無い」を隠すので、数えるのは *出た数* の方である）
field okt : or bound 16384
okt[gt] <- true                     for (gt) in 0 .. ngtz[0] if tml0[gt] >= 1
# 番兵の行（表を空にできないのでホストが置く空の一行）は数に入れる
okt[gt] <- true                     for (gt) in 0 .. ngtz[0] if tmk[gt] == 0
field cot : max bound 16384
cot[0] <- 0
cot[z] <- 1                         for (z) in 0 .. 0 if okt[0]
cot[gt] <- cot[gt-1]                for (gt) in 1 .. ngtz[0] if not okt[gt]
cot[gt] <- cot[gt-1] + 1            for (gt) in 1 .. ngtz[0] if okt[gt]
field nokt : max bound 1
nokt[z] <- cot[gt]                  for (gt) in 0 .. ngtz[0] for (z) in 0 .. 0
field okg : or bound 16384
okg[gg] <- true                     for (gg) in 0 .. nggz[0] if glen[gg] >= 1
okg[gg] <- true                     for (gg) in 0 .. nggz[0] if gdk[gg] == 0
field cog : max bound 16384
cog[0] <- 0
cog[z] <- 1                         for (z) in 0 .. 0 if okg[0]
cog[gg] <- cog[gg-1]                for (gg) in 1 .. nggz[0] if not okg[gg]
cog[gg] <- cog[gg-1] + 1            for (gg) in 1 .. nggz[0] if okg[gg]
field nokg : max bound 1
nokg[z] <- cog[gg]                  for (gg) in 0 .. nggz[0] for (z) in 0 .. 0
field okc : or bound 32768
okc[gc] <- true                     for (gc) in 0 .. ngcz[0] if clen[gc] >= 1
field coc : max bound 32768
coc[0] <- 0
coc[z] <- 1                         for (z) in 0 .. 0 if okc[0]
coc[gc] <- coc[gc-1]                for (gc) in 1 .. ngcz[0] if not okc[gc]
coc[gc] <- coc[gc-1] + 1            for (gc) in 1 .. ngcz[0] if okc[gc]
field nokc : max bound 1
nokc[z] <- coc[gc]                  for (gc) in 0 .. ngcz[0] for (z) in 0 .. 0
field okl : or bound 16384
okl[gl] <- true                     for (gl) in 0 .. nglz[0] if lpk[gl] >= 0
field col : max bound 16384
col[0] <- 0
col[z] <- 1                         for (z) in 0 .. 0 if okl[0]
col[gl] <- col[gl-1]                for (gl) in 1 .. nglz[0] if not okl[gl]
col[gl] <- col[gl-1] + 1            for (gl) in 1 .. nglz[0] if okl[gl]
field nokl : max bound 1
nokl[z] <- col[gl]                  for (gl) in 0 .. nglz[0] for (z) in 0 .. 0
field bad : or bound 1                      # 断片の外の書き方があった
bad[z] <- true                       for (z) in 0 .. 0 if badk[0] <= 16777215
# 掛ける項（× 定数 / ÷ 2^k / % 2^k / 場・列・計数器を掛ける）
field tmul : or bound 16384
tmul[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 6
tmul[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 7
tmul[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 8
tmul[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 10
tmul[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 12
tmul[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 14
tmul[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 15
tmul[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 16
tmul[gt] <- true                    for (gt) in 0 .. ngtz[0] if tvdv[gt]

bad[z] <- true                      for (z) in 0 .. 0 if nokr[0] != nrule[0]
bad[z] <- true                      for (z) in 0 .. 0 if noks[0] != nseed[0]
bad[z] <- true                      for (z) in 0 .. 0 if nokt[0] != ngt[0]
bad[z] <- true                      for (z) in 0 .. 0 if nokg[0] != ngg[0]
bad[z] <- true                      for (z) in 0 .. 0 if nokc[0] != ngc[0]
bad[z] <- true                      for (z) in 0 .. 0 if nokl[0] != ngl[0]
bad[z] <- true                      for (z) in 0 .. 0 if inpw[0] == 0   # 表が二つ以上
field dvbad : or bound 16384                   # 焼けない除数（0・負・即値に入らない）
dvbad[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 7 if tmv[gt] <= 0
dvbad[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if tmv[gt] <= 0
dvbad[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 7 if not ispw[gt] if tmv[gt] > 2147483647
dvbad[gt] <- true   for (gt) in 0 .. ngtz[0] if tmk[gt] == 8 if not ispw[gt] if tmv[gt] > 2147483647
bad[z] <- true                      for (gt) in 0 .. ngtz[0] for (z) in 0 .. 0 if dvbad[gt]
# ── **どこが悪いかを言う**（行は規則から、理由は条件から）───────────
badk[z] <- rlin[tmr[gt]] * 16 + 5   for (gt) in 0 .. ngtz[0] for (z) in 0 .. 0 if dvbad[gt]
# **`or` の場に true 以外を書くと、二つの答えが出ていた。** 解釈実行は
# 値が `true` でなければ何も置かない（⊥ のまま）。焼いた符号は `or` の
# join が値を見ないので、**規則が火を噴いた時点で 1 を置く**。
# 同じ源が二つの答えを持っていたので、焼かずに言う（理由 9）。
# 許すのは **`or` の場の読み**だけ（`pminus[t] <- ismin[prevw[t]]`）——
# それなら ⊥ は火を噴かず、両者は一致する。
field tmlt : max bound 16384                 # 項 gt の属する規則の束
tmlt[gt] <- rrlt[tmr[gt]]           for (gt) in 0 .. ngtz[0]
field tmfl : max bound 16384                 # 項が読む場の束（読みでなければ ⊥）
tmfl[gt] <- fdlat[tmf[gt]]          for (gt) in 0 .. ngtz[0] if tmk[gt] == 3
field orok : or bound 16384                  # or の規則の項として許される形
orok[gt] <- true                    for (gt) in 0 .. ngtz[0] if tmk[gt] == 3 if tmfl[gt] == 3
badk[z] <- rlin[tmr[gt]] * 16 + 9   for (gt) in 0 .. ngtz[0] for (z) in 0 .. 0
      if tmlt[gt] == 3 if not orok[gt]
badk[z] <- rlin[tmr[gt]] * 16 + 8   for (gt) in 0 .. ngtz[0] for (z) in 0 .. 0 if not okt[gt]
badk[z] <- rlin[gdr[gg]] * 16 + 8   for (gg) in 0 .. nggz[0] for (z) in 0 .. 0 if not okg[gg]
badk[z] <- rlin[cdr[gc]] * 16 + 8   for (gc) in 0 .. ngcz[0] for (z) in 0 .. 0 if not okc[gc]
# **内側の所有者の次元1 以降に、場の読みは置けない。** 内側は r9 だけで畳む（桁を上げて
# 足す）ので、次元1 の源がまた場を読むと、その読みが自分の座標を r9 に作って畳みかけを
# 潰す。形の表にも畳んで足す形が無く、二つの形が同じ位置に重なっていた ——
# `h[g[i, k[i]]]` は解釈実行が 123、焼いた側は何も書かない（`x[g[i, k[0]]]` は落ちる）。
# 直に読む `g[i, k[i]]` と、内側の次元0 の `h[g[k[i], i]]` は通る。
badk[z] <- rlin[cdr[gc]] * 16 + 8   for (gc) in 0 .. ngcz[0] for (z) in 0 .. 0
      if isin[cso[gc]] if csd[gc] >= 1 if cdsr[gc] >= 2 if cdsr[gc] <= 3
badk[z] <- rlin[cdr[gc]] * 16 + 8   for (gc) in 0 .. ngcz[0] for (z) in 0 .. 0
      if isin[cso[gc]] if csd[gc] >= 1 if cdsr[gc] == 5
badk[z] <- rlin[lpr[gl]] * 16 + 8   for (gl) in 0 .. nglz[0] for (z) in 0 .. 0 if not okl[gl]
badk[z] <- rlin[r] * 16 + 8   for (r) in 0 .. nrlz[0] for (z) in 0 .. 0 if not okr[r]
# **掛け算は直前の項にしか掛からない。** 焼いた符号は左から畳んでいたので
# `1 + 2 * 3` は 9、解釈実行は 7 —— 同じ言葉が二つの答えを持っていた。
# 黙って違う答えを出すくらいならと **焼かないことにしていた**（理由7）。
# いまは項が **群**に分かれ、和は升に溜まるので、どちらも 7 を出す。
# 断りは要らなくなった —— 直したので消す（残すと嘘になる）。

# **導けたものが一つも無いときは、番地の鎖も出ない**（`off` すら ⊥）。
# だから出口を後ろに置くだけでは足りない —— **前置きの三命令をそのまま
# 出口にする**（`form` は max で選ぶので、上書きは書けば済む）。
# そして **知らせも配置に依存してはいけない**。命令の後ろに置くと、
# 配置が壊れているときにこそ届かない（入れ子四重で segfault した）。
# 文字はファイル末尾の余白に敷くので番地は定数、八命令は即値を持たない
# 形（穴なし）だけで書ける —— 前置きの即値と混ざらない。
form[0] <- 165                       for (z) in 0 .. 0 if bad[0]   # mov eax, 1  (sys_write)
form[1] <- 166                       for (z) in 0 .. 0 if bad[0]   # mov edi, 2  (stderr)
form[2] <- 167                       for (z) in 0 .. 0 if bad[0]   # mov rsi, 4718528
form[3] <- 168                       for (z) in 0 .. 0 if bad[0]   # mov rdx, 61
form[4] <- 158                       for (z) in 0 .. 0 if bad[0]   # syscall
form[5] <- 156                       for (z) in 0 .. 0 if bad[0]   # mov eax, 60
form[6] <- 157                       for (z) in 0 .. 0 if bad[0]   # mov edi, 7
form[7] <- 158                       for (z) in 0 .. 0 if bad[0]   # syscall


# ══ どこが悪いかを言う ═════════════════════════════════════════════
# 終了コード 7 だけでは、書いた人はどこを直せばいいか分からない。
# 焼けなかったときは **標準エラーに一行**出してから止まる:
#
#   lattix: cannot bake - line 000042 reason 5
#
# 理由: 1 名前が 17 文字以上 / 2 入れ子が九重以上 / 3 項が九つ以上 /
#       4 宣言の無い場を読んだ / 5 焼けない除数（0・負・即値の外） / 6 表が無い・二つ以上 /
#       7 成層できない（非単調な読みが閉路の中にある。以前の 7「足した後に
#         掛ける形」は項の群で焼けるようになって空いていた） / 8 焼けない形（導けない要素）
#       9 or の値は true か or の読み / A 同じ名前を二度宣言した / B 種の座標が宣言の広さの外
#       C 数が符号つき 32 ビットに収まらない（割る数・余りの数は除く）
#       D 種の値が ⊥ / ⊤ の印と重なる
#       E 場の置き場が 2 GB を超える（番地が 32 ビットの即値に収まらない）
#       F 数の区間が言語の上限（4,194,304）より広い
#
# **十進の桁は割り算なしで出す。** 二のべきでしか割れないので、
# 逆数を掛けて 2^32 で寄せる（`v * 429496730 / 2^32` が `v / 10`）——
# 二のべきしか無い機械で十進を書く、昔からの手である。

# 比較のガードを一枚置いて **閉じてから**使う（気づき38）
field blz : max bound 1                     # 閉じた行番号
blz[0] <- 0
field bkz : max bound 1                     # 閉じた鍵（比較のガードが層を切る）
bkz[z] <- badk[0]                    for (z) in 0 .. 0 if badk[0] <= 16777215
blz[z] <- bkz[0] / 16                for (z) in 0 .. 0
field brz : max bound 1                     # 閉じた理由
brz[0] <- 0
brz[z] <- bkz[0] % 16                for (z) in 0 .. 0

# 鎖にすると `q` が自分を割ることになり **非単調**（処理系が正しく棄却した）。
# 桁ごとに独立に、行番号そのものから出す —— 逆数はどれも 32bit に収まる。
field q : max bound 8                       # 行番号を 10^k で割った商
q[k] <- blz[0]                              for (k) in 0 .. 0
q[k] <- blz[0] * 429496730 / 4294967296     for (k) in 1 .. 1
q[k] <- blz[0] * 42949673 / 4294967296      for (k) in 2 .. 2
q[k] <- blz[0] * 4294968 / 4294967296       for (k) in 3 .. 3
q[k] <- blz[0] * 429497 / 4294967296        for (k) in 4 .. 4
q[k] <- blz[0] * 687195 / 68719476736       for (k) in 5 .. 5
q[k] <- 0                                   for (k) in 6 .. 6
field t10 : max bound 8
t10[k] <- q[k+1] * 10                       for (k) in 0 .. 5
field dgt : max bound 8                     # k 桁目の数字
dgt[k] <- q[k] - t10[k]                     for (k) in 0 .. 5

field msg : max bound 64                    # 決まった文字（数字の所は空ける）
msg[0] <- 108
msg[1] <- 97
msg[2] <- 116
msg[3] <- 116
msg[4] <- 105
msg[5] <- 120
msg[6] <- 58
msg[7] <- 32
msg[8] <- 99
msg[9] <- 97
msg[10] <- 110
msg[11] <- 110
msg[12] <- 111
msg[13] <- 116
msg[14] <- 32
msg[15] <- 98
msg[16] <- 97
msg[17] <- 107
msg[18] <- 101
msg[19] <- 32
msg[20] <- 45
msg[21] <- 32
msg[22] <- 108
msg[23] <- 105
msg[24] <- 110
msg[25] <- 101
msg[26] <- 32
msg[33] <- 32
msg[34] <- 114
msg[35] <- 101
msg[36] <- 97
msg[37] <- 115
msg[38] <- 111
msg[39] <- 110
msg[40] <- 32
msg[42] <- 58
msg[43] <- 32
msg[60] <- 10


# ── 実体化 ──────────────────────────────────────────────────────
field total : max bound 1
total[0] <- 2097152
field tmax : max bound 1                      # total の一つ手前（区間の上端に書ける形）
tmax[0] <- total[0] - 1   for (z) in 0 .. 0

field out : max bound 2097152
out[i] <- 0                         for (i) in 0 .. tmax[0]
# コード面は 32 枚（131072 バイト）と **定数で宣言する**。末尾を定数キーで
# 留めると、データを実行時に移しても密配列サイズが縮まない（runtime.py 用）。
# 4096 では足りなくなった —— 命令が 862 本になった日に、コードがデータを踏んだ。
# 65536 でも足りなくなった —— 33_self が 110 規則になった日に、また踏んだ。
# 131072 でも足りなくなった —— 形の導出が断片に入った日に、三度目。
# 655360 も残り 8 KB になった —— 値の見張りと座標の濾しを足した日（2026-09-19）。
# 1 MB にした。`rcap` も一緒に上げる（詰め直しの置き場は rcap + 65536。下の見張り）。
# 2 MB にした（2026-09-23）—— ⊥ を 0 に置く形は升ごとに 4 バイト長く、attest.lx（1 MB の 98.9%）が溢れた。
# **踏んだことは黙って起きる**ので、今度は言うようにした ——
# 符号の長さを ELF ヘッダの空き（8..11 バイト目）に書く。読む側が確かめられる。
out[2097151] <- 0
out[8]  <- codelen[0] % 256   for (z) in 0 .. 0
out[9]  <- codelen[0] / 256 % 256   for (z) in 0 .. 0
out[10] <- codelen[0] / 65536 % 256   for (z) in 0 .. 0
out[11] <- codelen[0] / 16777216 % 256   for (z) in 0 .. 0   # 三度同じ穴は掘らない
# ELF ヘッダ（0 のバイトは既に敷いてあるので、0 でない所だけ置く）
out[0] <- 127
out[1] <- 69
out[2] <- 76
out[3] <- 70
out[4] <- 2
out[5] <- 1
out[6] <- 1
out[16] <- 2
out[18] <- 62
out[20] <- 1
out[24] <- 120
out[26] <- 64
out[32] <- 64
out[52] <- 64
out[54] <- 56
out[56] <- 1
out[58] <- 64
out[64] <- 1
out[68] <- 7
out[82] <- 64
out[90] <- 64
out[113] <- 16

# 大きさは出来上がってから決まる
# p_filesz は 96、p_memsz は 104（プログラムヘッダの先頭 64 から +32 / +40）
out[96]  <- total[0] % 256   for (z) in 0 .. 0
out[97]  <- total[0] / 256 % 256   for (z) in 0 .. 0
out[98]  <- total[0] / 65536 % 256   for (z) in 0 .. 0
# **同じ書き忘れが、こちら側では直っていなかった。**（下の msz の註を見よ。）
# p_memsz には四バイト目を足したのに、p_filesz には足さなかった ——
# 一つの判断が二箇所にあって、痛んだ片方だけを直した跡である。
# 像が 16 MB ちょうどになった日、total = 2^24 は三バイトで 0 に落ち、
# filesz = 0 の ELF が出来た。核は何も読み込まず、最初の命令で落ちる。
# **切り捨ては例外を出さない**ので、焼く側は最後まで正常に見える。
out[99]  <- total[0] / 16777216 % 256   for (z) in 0 .. 0
# 知らせ（焼けなかったときの一行）の番地も `total` から出る。
# `encb[167]` は `mov rsi, 番地` の七バイトで、その四バイトがこれ。
field mad : max bound 1                     # 知らせの番地（像の末尾 64 バイト）
mad[z] <- total[0] + 4194304 - 64   for (z) in 0 .. 0
encb[167,3] <- mad[0] % 256   for (z) in 0 .. 0
encb[167,4] <- mad[0] / 256 % 256   for (z) in 0 .. 0
encb[167,5] <- mad[0] / 65536 % 256   for (z) in 0 .. 0
encb[167,6] <- mad[0] / 16777216 % 256   for (z) in 0 .. 0

field msz : max bound 1                     # p_memsz（場と証人と生バイトの置き場）
msz[z] <- total[0] + 65536           for (z) in 0 .. 0   # p_memsz は像より小さくできない
# **詰め直しの置き場は、描く場の升数より小さくできない。** 前は rcap + 65536 で固定で、
# それより升の多い場を render すると置き場の外へ詰めて segfault した（二百万升で測った）。
field pbsz : max bound 1                    # 詰め直しの置き場の広さ
pbsz[0] <- rcap[0] + 65536   for (z) in 0 .. 0
field psz : max bound 8                     # 描く場の升数の和（前置きの鎖）
psz[k] <- fsz[orz[k]]                for (k) in 0 .. 0 if outw[0] == 1
psz[k] <- psz[k-1] + fsz[orz[k]]     for (k) in 1 .. nrfz[0] if outw[0] == 1
pbsz[z] <- psz[k]            for (k) in 0 .. nrfz[0] for (z) in 0 .. 0 if outw[0] == 1
msz[0] <- fbase[0] - 4194304 + ftot2[0]   for (z) in 0 .. 0
# **場の置き場は 2 GB の手前まで**（理由 E）。番地は符号つき 32 ビットの即値で焼き、
# p_memsz も四バイトしか書かないので、それを超える置き場は番地が折り返して **別の場か
# 地図の外を指した**（15 億升の or の場を二つ置くと segfault、50000 × 50000 は読みが
# 黙って失敗した）。行は 0 —— どの宣言のせいかではなく、足した大きさの話である。
# （14）即値で焼く番地は F の頭まで、F と K はそれぞれ rbx / r10 からの変位 —— 三つを別々に見る。
badk[z] <- 14   for (z) in 0 .. 0 if fbase[0] > 2143289343
badk[z] <- 14   for (z) in 0 .. 0 if ftot[0] > 2143289343
badk[z] <- 14   for (z) in 0 .. 0 if ktot[0] > 2143289343
# **断るときの像は小さく**（14）。p_memsz が 4 GB を越えうるようになって、面が大きすぎると断る像まで
# 10 GB の置き場を持ち、exec が置き場を取れずに SIGSEGV で落ちていた（知らせが出ない）。
# 前は四バイトしか書かなかったので、折り返して小さくなり、たまたま知らせが出ていた。
field mszo : max bound 1                    # 頭に書く p_memsz
mszo[z] <- msz[0]   for (z) in 0 .. 0 if not bad[0]
mszo[z] <- total[0] + 65536   for (z) in 0 .. 0 if bad[0]
out[104] <- mszo[0] % 256   for (z) in 0 .. 0
out[105] <- mszo[0] / 256 % 256   for (z) in 0 .. 0
out[106] <- mszo[0] / 65536 % 256   for (z) in 0 .. 0
# **四バイト目を書き忘れていた。** 16 MB までは三バイトで足りていたので、
# 足りなくなるまで誰も間違いに気づかない類の穴である —— 場が 11 MB を
# 超えた日に、⊥ を敷く最初のループが地図の外へ出て落ちた。
out[107] <- mszo[0] / 16777216 % 256   for (z) in 0 .. 0
# 二枚の面がそれぞれ 2 GB まで持てるので、p_memsz は 4 GB を越えうる（五バイト目）
out[108] <- mszo[0] / 4294967296 % 256   for (z) in 0 .. 0

# ── 符号面は **バイトの並び**である ─────────────────────────────────
# 「命令 n の p バイト目を 120+off[n]+p に置く」と書くと、座標が
# **場の読みと計数器の和**になり、生成器が自分では焼けない形になる。
# 向きを裏返す —— **バイトの位置を歩いて、どの命令の何バイト目かを鎖で出す**。
# 番地は座標である（気づき17）を、書く側でも使うということ。
# **符号の面は像の末尾 1024 バイトの手前まで**（2097152 - 1024）。末尾は知らせの置き場
# （⊥・⊤・値・はみ出しの知らせと、場の番号の枠）で、`out` は max で重ね書きするので、
# 符号がそこへ届けば **命令と知らせが黙って混ざる**。符号の長さはここでは断れない
# （下の見張りの註: 符号 → 長さ → 断り → 符号 の輪）が、面の広さなら断れる ——
# 届いた所で面を超え、焼き手が終了コード 6 で止まる。
field bpos : max bound 655360       # 命令 n の最初のバイトの位置
bpos[n] <- off[n] + 120             for (n) in 0 .. ninz[0]
field isst : or bound 2096128        # そのバイトは命令の頭
isst[bpos[n]] <- true               for (n) in 0 .. ninz[0]
field bmax : max bound 655360       # 符号面の最後のバイトの位置
bmax[0] <- codelen[0] + 119   for (z) in 0 .. 0
field bown : max bound 2096128       # バイト i を持つ命令
bown[bpos[n]] <- n                  for (n) in 0 .. ninz[0]
bown[i] <- bown[i-1]                for (i) in 1 .. bmax[0] if not isst[i]
field bofs : max bound 2096128       # 命令の中での位置（鎖）
bofs[i] <- 0                        for (i) in 0 .. bmax[0] if isst[i]
bofs[i] <- bofs[i-1] + 1            for (i) in 1 .. bmax[0] if not isst[i]
field bfm : max bound 2096128        # そのバイトの命令の形
bfm[i] <- form[bown[i]]             for (i) in 0 .. bmax[0]
field bho : max bound 2096128        # 穴の始まり
bho[i] <- shho[bfm[i]]              for (i) in 0 .. bmax[0]
field bhe : max bound 2096128        # 穴の終わり（開区間）
bhe[i] <- shho[bfm[i]] + 1          for (i) in 0 .. bmax[0] if shhk[bfm[i]] == 1
bhe[i] <- shho[bfm[i]] + 4          for (i) in 0 .. bmax[0] if shhk[bfm[i]] == 4
bhe[i] <- shho[bfm[i]] + 4          for (i) in 0 .. bmax[0] if shhk[bfm[i]] == 5
field ishole : or bound 2096128      # 穴の中のバイト
ishole[i] <- true                   for (i) in 0 .. bmax[0]
      if bofs[i] >= bho[i] if bofs[i] < bhe[i]
field bhj : max bound 2096128        # 穴の中での位置（鎖）
bhj[i] <- 0                         for (i) in 0 .. bmax[0] if ishole[i] if isst[i]
bhj[i] <- 0                         for (i) in 1 .. bmax[0] if ishole[i] if not ishole[i-1]
bhj[i] <- bhj[i-1] + 1              for (i) in 1 .. bmax[0] if ishole[i] if ishole[i-1]
      if not isst[i]
field vb : max bound 262144 4       # 命令 n の穴に入る値の j バイト目
vb[n,0] <- imm[n] % 256             for (n) in 0 .. ninz[0] if shhk[form[n]] == 1
vb[n,0] <- imm[n] % 256             for (n) in 0 .. ninz[0] if shhk[form[n]] == 4
vb[n,1] <- imm[n] / 256 % 256       for (n) in 0 .. ninz[0] if shhk[form[n]] == 4
vb[n,2] <- imm[n] / 65536 % 256     for (n) in 0 .. ninz[0] if shhk[form[n]] == 4
vb[n,3] <- imm[n] / 16777216 % 256  for (n) in 0 .. ninz[0] if shhk[form[n]] == 4
vb[n,0] <- rel[n] % 256             for (n) in 0 .. ninz[0] if shhk[form[n]] == 5
vb[n,1] <- rel[n] / 256 % 256       for (n) in 0 .. ninz[0] if shhk[form[n]] == 5
vb[n,2] <- rel[n] / 65536 % 256     for (n) in 0 .. ninz[0] if shhk[form[n]] == 5
vb[n,3] <- rel[n] / 16777216 % 256  for (n) in 0 .. ninz[0] if shhk[form[n]] == 5

# ── 倍率の穴（書く側）────────────────────────────────────────────
# 既定は **形がいま持っている倍率**（`fmsc`）。束が幅を言う場は下で差し替える。
# `min` なので、差し替えは必ず既定以下でなければならない —— ×8 が 192 で
# いちばん大きいから、×4(128)・×2(64)・×1(0) はどれも通る。
field scb : min bound 262144        # 命令 n の SIB の倍率ビット
scb[n] <- fmsc[form[n]]             for (n) in 0 .. ninz[0]
# 比較のガードを一枚置いて **閉じてから**使う（気づき38）
field issib : or bound 2096128       # そのバイトは SIB
issib[i] <- true                    for (i) in 0 .. bmax[0] if bofs[i] == shsb[bfm[i]]

# 骨（形ごとの定数バイト）と穴（即値・相対・**倍率**）—— 座標はどちらも i だけ
out[i] <- encb[bfm[i], bofs[i]]     for (i) in 0 .. bmax[0] if not ishole[i] if not issib[i]
out[i] <- vb[bown[i], bhj[i]]       for (i) in 0 .. bmax[0] if ishole[i]
out[i] <- sibb[bfm[i]] + scb[bown[i]]   for (i) in 0 .. bmax[0] if issib[i]

# ── 知らせの文字は **ファイル末尾の余白** へ ────────────────────────
# 命令の後ろに置くと、配置が壊れているときにこそ届かない。
# `total - 64` は符号にも場にも使わない 64 バイトで、地上データの頭
# （dbase = 4718592）のすぐ手前である。番地は 4194304 + 524224 = 4718528
# ——**定数**なので、形167 が即値として持てる（穴が要らない）。
# **番号は引くもの、言葉は読むもの。** 番号だけでは表を引きに行かねば
# ならない —— 人も、AI も。だから同じ行に言葉も置く（16 バイト固定）。
field rtx : max bound 16 16                  # 理由ごとの言葉（十六進の一桁）
