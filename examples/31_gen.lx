encb[167,1] <- 199
encb[167,2] <- 198
# **番地を数字で書いてはいけない。**（気づき33）—— ここには 4718528 と
# 書いてあった。それは 4194304 + 524288 - 64、つまり `total` の四枚目の写し
# である。`total` を動かした日、知らせだけが地図の外を指した —— そして
# 知らせは壊れたときにしか出ないので、**壊れた日に壊れている**。
# 一箇所（`total`）から導けば、片方だけ直ることはもう起こらない。
# 四バイト目も置く。三バイトで足りたのは像が 16 MB 未満だったからで、
# それは上限ではなく、まだ超えていないだけだった（気づき44、三度目）。
# 実際の四バイトは `total` の隣で書く（`mad` —— 下の「大きさは出来上がって
# から決まる」の段）。ここに数字を残さないことが要点である。
# ── **バイト升の形**（`or` の場のための五つ）──────────────────────
# 倍率はもう穴なので、SIB は index と base だけを持つ。変わるのは
# **命令の大きさ**（オペランド幅）で、これは opcode と REX が決める ——
# x86 では読みだけ形が変わる（`mov r64,m64` は 8B、`movzx r32,m8` は 0F B6）。
# だから倍率と違って、幅ごとに形が要る。**五つで足りた**。
# **穴を持たない形だけを足す。** SIB の検出は「穴の二つ手前が modrm」で
# 導いているので、穴が即値の形を足すと、即値の中のバイトが modrm に
# 見えることがある —— 値によって当たったり外れたりする、いちばん質の悪い形。
# 枠の番地は `total` から焼くので、この三つはどれも穴を持たない。
# REX.W を立てると **八バイト書く**。枠は四バイトなので隣の知らせを潰す ——
# 最初 4C と書いて、知らせの頭四文字が消えた（`latt` が 00 00 00 00 に）。
encb[180,0] <- 68                    # 44 89 3C 25 <枠>        mov [枠], r15d
encb[180,1] <- 137
encb[180,2] <- 60
encb[180,3] <- 37
encb[181,0] <- 72                    # 48 C7 C6 <枠>           mov rsi, 枠
encb[181,1] <- 199
encb[181,2] <- 198
