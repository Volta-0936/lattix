field mbz : max bound 1
mbz[z] <- total[0] - 64              for (z) in 0 .. 0
field msgo : max bound 64
msgo[j] <- total[0] - 64 + j         for (j) in 0 .. 60
out[msgo[j]] <- msg[j]               for (j) in 0 .. 60 if msg[j] >= 1 if bad[0]
out[msgo[j]] <- rtx[1,j-44]          for (j) in 44 .. 59 if brz[0] == 1 if bad[0]
out[msgo[j]] <- rtx[2,j-44]          for (j) in 44 .. 59 if brz[0] == 2 if bad[0]
out[msgo[j]] <- rtx[3,j-44]          for (j) in 44 .. 59 if brz[0] == 3 if bad[0]
