out[msgo[j]] <- rtx[15,j-44]         for (j) in 44 .. 59 if brz[0] == 15 if bad[0]
out[mbz[z] + 27] <- dgt[k] + 48      for (k) in 5 .. 5 for (z) in 0 .. 0 if bad[0]
out[mbz[z] + 28] <- dgt[k] + 48      for (k) in 4 .. 4 for (z) in 0 .. 0 if bad[0]
out[mbz[z] + 29] <- dgt[k] + 48      for (k) in 3 .. 3 for (z) in 0 .. 0 if bad[0]
out[mbz[z] + 30] <- dgt[k] + 48      for (k) in 2 .. 2 for (z) in 0 .. 0 if bad[0]
out[mbz[z] + 31] <- dgt[k] + 48      for (k) in 1 .. 1 for (z) in 0 .. 0 if bad[0]
out[mbz[z] + 32] <- dgt[k] + 48      for (k) in 0 .. 0 for (z) in 0 .. 0 if bad[0]
# 理由は十六進の一桁（A 以降は英字。行 * 16 + 理由 の鍵がもともと四ビットを持つ）
out[mbz[z] + 41] <- brz[0] + 48      for (z) in 0 .. 0 if bad[0] if brz[0] <= 9
out[mbz[z] + 41] <- brz[0] + 55      for (z) in 0 .. 0 if bad[0] if brz[0] >= 10

# ══ はみ出したときの一行（終了コード 6）════════════════════════════
#   焼けたプログラムが走っている最中に「宣言した広さ」を超えたら、
#   `ovf` へ飛んでここを書き出す。**知らせは像の中にずっと居る**ので
#   番地は定数 —— `total` から導く（数字では書かない）。
#   `bad` の一行は像の末尾 64 バイト、こちらはその手前 64 バイト。
#   二つは決して同時に出ない（焼けたか焼けなかったかのどちらかである）が、
#   **場所を分けておけば `max` で混ざる心配をしなくていい**。
