# **自分を焼くための一段目。** —— 断片だけで書いた字句解析。
#
# 21_lex は構成子（`cons`）で綴りを内容アドレスにしていた。ここでは構成子を
# 一つも使わない —— 使えるのは 31_gen が焼ける形だけである:
#
#   範囲ガード `if c >= 97`        上集合・下集合の帰属
#   比較ガード `if cls[i] != cls[i-1]`   同じ場を -1 ずれで比べる
#   鎖         `tnum[i] <- tnum[i-1] + 1`
#   場の値が座標 `tstart[tnum[i]] <- i`   —— **名前とは座標である**
#
# 入力は生のバイト（位置, 文字）。`table ch` の一行は置き場所で、
# 焼くときは標準入力から来る（`inp` の幅 1）。
# **文字の面は `rcap` である。** 生バイトの置き場（`31_gen` の `rcap`）が
# 524,288 なら、位置で引く場も 524,288 なければ「読める」は嘘になる ——
# 二つの数は一つの判断である（`dneed`/`dcap` と同じ形）。
# 実際、`lattix.lx` が 261,918 バイトまで育ったとき、面は 262,144 だった ——
# **自分の源を読めなくなる 226 バイト手前**まで来ていた。数えて言う（気づき35）。
# `test/accept.py` の「宣言の内側」の組が、この二つが同じであることを測る。
table ch = (0,32)

# ── 文字の種類 ──────────────────────────────────────────────────────
field alpha : or bound 589824
alpha[i] <- true  for (i,c) in ch if c >= 97 if c <= 122
alpha[i] <- true  for (i,c) in ch if c >= 65 if c <= 90
field digit : or bound 589824
digit[i] <- true  for (i,c) in ch if c >= 48 if c <= 57
field under : or bound 589824
under[i] <- true  for (i,c) in ch if c == 95
field idpart : or bound 589824
idpart[i] <- true for (i,c) in ch if alpha[i]
idpart[i] <- true for (i,c) in ch if digit[i]
idpart[i] <- true for (i,c) in ch if under[i]
field space : or bound 589824
space[i] <- true  for (i,c) in ch if c <= 32
field nl : or bound 589824
nl[i] <- true     for (i,c) in ch if c == 10

# ── 注釈は語ではない ────────────────────────────────────────────────
# `#` から行末まで。そこに書かれた `[` は括弧ではなく、`for` は語でもない。
# **注釈も座標の話である** —— 「# の後ろで、まだ改行を跨いでいない」だけ。
field hash : or bound 589824
hash[i] <- true for (i,c) in ch if c == 35
field incom : or bound 589824
incom[i] <- true for (i,c) in ch if hash[i]
incom[i] <- true for (i,c) in ch if i >= 1 if incom[i-1] if not nl[i]

# 1 = 語（英数と _）/ 3 = 空白 / 4 = 記号。**排他である**（束は max）
field cls : max bound 589824
cls[i] <- 1 for (i,c) in ch if idpart[i]
cls[i] <- 3 for (i,c) in ch if space[i]
cls[i] <- 4 for (i,c) in ch if not idpart[i] if not space[i]

# ── 語の切れ目。記号は一文字ずつ切る ────────────────────────────────
field brk : or bound 589824
brk[0] <- true
brk[i] <- true for (i,c) in ch if i >= 1 if cls[i] != cls[i-1]
brk[i] <- true for (i,c) in ch if i >= 1 if cls[i] == 4

# トークン番号は **位置に沿った鎖**（逐次実行ではない）
field tnum : max bound 589824
tnum[0] <- 0
tnum[i] <- tnum[i-1]     for (i,c) in ch if i >= 1 if not brk[i]
tnum[i] <- tnum[i-1] + 1 for (i,c) in ch if i >= 1 if brk[i]

# ── トークンの属性。**書き先の座標が場の値**（tnum）である ─────────
field tstart : min bound 589824       # そのトークンが始まる位置
tstart[tnum[i]] <- i for (i,c) in ch
field tkind : max bound 589824                   # 1 = 語 / 3 = 空白 / 4 = 記号
tkind[tnum[i]] <- cls[i] for (i,c) in ch
field tlen : count bound 589824                  # 何文字か
tlen[tnum[i]] <- 1 for (i,c) in ch

# 行番号（改行の数の鎖）。**行も座標である**
field lnum : max bound 589824
lnum[0] <- 1
lnum[i] <- lnum[i-1]     for (i,c) in ch if i >= 1 if not nl[i-1]
lnum[i] <- lnum[i-1] + 1 for (i,c) in ch if i >= 1 if nl[i-1]
field tline : max bound 589824
tline[tnum[i]] <- lnum[i] for (i,c) in ch
field tcom : or bound 589824                     # 注釈の中のトークン
tcom[tnum[i]] <- true for (i,c) in ch if incom[i]

# ── 括弧の深さ。**引き算が要る**（種5 の項）───────────────────────
field opn : or bound 589824
opn[i] <- true for (i,c) in ch if c == 91 if not incom[i]
opn[i] <- true for (i,c) in ch if c == 40 if not incom[i]
field clo : or bound 589824
clo[i] <- true for (i,c) in ch if c == 93 if not incom[i]
clo[i] <- true for (i,c) in ch if c == 41 if not incom[i]
# 深さは位置に沿った鎖。開いた次で +1、閉じた次で -1
field pre : max bound 589824
pre[0] <- 0
pre[i] <- pre[i-1]     for (i,c) in ch if i >= 1 if not opn[i-1] if not clo[i-1]
pre[i] <- pre[i-1] + 1 for (i,c) in ch if i >= 1 if opn[i-1]
pre[i] <- pre[i-1] - 1 for (i,c) in ch if i >= 1 if clo[i-1]

print pre

# ── 括弧の対応。**場の値が座標**（深さで引く）───────────────────────
# 開いた位置を「深さ」ごとに前へ運ぶ。閉じた所でその深さを引けば相手が出る ——
# スタックは要らない。深さは座標であって、時間の中の機構ではない（気づき9）。
field oat : or bound 589824 16
oat[i, pre[i] + 1] <- true for (i,c) in ch if opn[i]
field opos : max bound 589824 16
opos[i, d] <- opos[i-1, d] for (i,c) in ch for (d) in 0 .. 15
opos[i, d] <- i - 1        for (i,c) in ch for (d) in 0 .. 15 if oat[i-1, d]
field match : max bound 589824
match[i] <- opos[i, pre[i]] for (i,c) in ch if clo[i]

print match

print tstart
print tkind
print tline

# トークンの綴りも (トークン, 位置) の場に開く（気づき26 と同じ手）——
# `chv[tstart[t] + k]` の入れ子が要らなくなり、語の照合が二次元の読みになる。
# —— `tstart` は min なので ⊥ は ∞ であり、**⊥ から座標を作ると桁が溢れる**。
# 「無い」を座標の材料にしてはいけない（気づき27 の座標側）。
field tch : max bound 589824 8          # トークン t の k 文字目
tch[tnum[i], cpos[i]] <- c for (i,c) in ch if cpos[i] <= 7

# ── 語の照合。**インターンは要らない** —— 綴りは文字ガードで見る ─────
# `for` も `if` も、トークンの先頭から数文字を見れば分かる。
# 記号表を作ってから比べるのは、逐次の機械の順序である（気づき22 の裏）。
field kwfor : or bound 589824
kwfor[t] <- true for (t,zc) in ch if tlen[t] == 3 if not tcom[t]
      if tch[t,0] == 102 if tch[t,1] == 111 if tch[t,2] == 114
field kwif : or bound 589824
kwif[t] <- true for (t,zc) in ch if tlen[t] == 2 if not tcom[t]
      if tch[t,0] == 105 if tch[t,1] == 102

# ── 文と節の切れ目 ──────────────────────────────────────────────────
# 行頭から始まる語が文の頭。継続行は字下げされるので、行頭でなければ続き。
field lstart : or bound 589824
lstart[0] <- true
lstart[i] <- true for (i,c) in ch if i >= 1 if nl[i-1]
field col0 : or bound 589824
col0[tnum[i]] <- true for (i,c) in ch if lstart[i] if cls[i] != 3 if not incom[i]

field sbrk : or bound 589824             # 文の頭（`for` / `if` で始まる行は続き）
sbrk[t] <- true for (t,zc) in ch if col0[t] if not kwfor[t] if not kwif[t]
field snum : max bound 589824            # 文番号（トークンに沿った鎖）
snum[0] <- 0
snum[t] <- snum[t-1]     for (t,zc) in ch if t >= 1 if not sbrk[t]
snum[t] <- snum[t-1] + 1 for (t,zc) in ch if t >= 1 if sbrk[t]

field cbrk : or bound 589824             # 節の頭（文の頭・for・if）
cbrk[t] <- true for (t,zc) in ch if sbrk[t]
cbrk[t] <- true for (t,zc) in ch if kwfor[t]
cbrk[t] <- true for (t,zc) in ch if kwif[t]
field cnum : max bound 589824            # 文の中の節番号
cnum[0] <- 0
cnum[t] <- cnum[t-1]     for (t,zc) in ch if t >= 1 if not cbrk[t]
cnum[t] <- cnum[t-1] + 1 for (t,zc) in ch if t >= 1 if cbrk[t] if not sbrk[t]
cnum[t] <- 0             for (t,zc) in ch if t >= 1 if sbrk[t]

print snum
print cnum

# ══ 名前を比べる ═══════════════════════════════════════════════════
# 参照ではなく **比較** する（気づき24）。木を降りて節を引くには、動いている
# min を座標にしなければならない —— それは成層できない。だから引かずに比べる。
#
# ここでの新しい一手: **綴りを (出現, 位置) の場に開く**。
# トークンの中の位置もまた座標である。開いてしまえば、名前の一致は
# **たった一つの規則** になる —— `och[o,k] != dch[d,k]` の一行。
field kwnot : or bound 589824
kwnot[t] <- true for (t,zc) in ch if tlen[t] == 3 if not tcom[t]
      if tch[t,0] == 110 if tch[t,1] == 111 if tch[t,2] == 116
field kwfld : or bound 589824
kwfld[t] <- true for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 102 if tch[t,1] == 105 if tch[t,2] == 101
      if tch[t,3] == 108 if tch[t,4] == 100

# 出現 = `f[` の f（注釈の中は除く）。宣言 = `field` の次のトークン
# **出現は `[` の手前の語である**（空白を跨ぐ —— `prevw`）。前は `[` の一つ前のトークンを
# 数で引いていたので、`f [i]` では空白が出現になり、名前の無い出現を「宣言の無い場」
# （理由 4 —— 嘘の理由）と断っていた。解釈実行は受け取る（2026-09-20）。書き座標の読みは
# 一段にしておく（`prevw[tnum[i]]` と二段にすると、旧い道 —— 21_lex → 32_shape → 31_gen、
# test/selfbyte.py —— が書き先の座標を導けない）。記号は一文字ずつ語なので、`[` の語で回す。
field isocc : or bound 589824
isocc[prevw[t]] <- true for (t,zc) in ch if t >= 1 if tch[t,0] == 91 if not tcom[t]
# トークンには空白も含まれる。`field a` は三つ（`field` / 空白 / `a`）——
# **一つ前の語** は鎖で出す。位置を数えるのではなく、最後に見た語を運ぶ。
field lastw : max bound 589824           # t 以下で最後の非空白トークン
lastw[t] <- t          for (t,zc) in ch if tkind[t] != 3
lastw[t] <- lastw[t-1] for (t,zc) in ch if t >= 1 if tkind[t] == 3
field prevw : max bound 589824           # t の直前の非空白トークン
prevw[t] <- lastw[t-1] for (t,zc) in ch if t >= 1
# `source x : max from "ch"` も宣言である（外界から育つ場 —— 規則を持たない
# 場と同じ扱い。`from` は bound ではないので広さは既定のまま）。
field kwsrc : or bound 589824           # `source`
kwsrc[t] <- true for (t,zc) in ch if tlen[t] == 6 if not tcom[t]
      if tch[t,0] == 115 if tch[t,1] == 111 if tch[t,2] == 117
      if tch[t,3] == 114 if tch[t,4] == 99 if tch[t,5] == 101
field isdcl : or bound 589824
isdcl[t] <- true for (t,zc) in ch if tkind[t] == 1 if kwfld[prevw[t]]
isdcl[t] <- true for (t,zc) in ch if tkind[t] == 1 if kwsrc[prevw[t]]

field oseq : max bound 589824            # 出現の通し番号（鎖）
oseq[0] <- 0
oseq[t] <- oseq[t-1]     for (t,zc) in ch if t >= 1 if not isocc[t]
oseq[t] <- oseq[t-1] + 1 for (t,zc) in ch if t >= 1 if isocc[t]
field dseq : max bound 589824            # 宣言の通し番号（鎖）
dseq[0] <- 0
dseq[t] <- dseq[t-1]     for (t,zc) in ch if t >= 1 if not isdcl[t]
dseq[t] <- dseq[t-1] + 1 for (t,zc) in ch if t >= 1 if isdcl[t]


# **上限は数えて言う。**（気づき35）—— 8191 や 4095 と書くのは「測らない」の
# 言い換えで、小さい .lx でも大きい .lx でも同じだけ回ってしまう。
# 区間の上端は場に書ける（種2 のループ）ので、数えたものをそのまま上端にする。
field nocz : max bound 1                # 出現の数（最後の出現番号）
nocz[z] <- oseq[t] for (t,zc) in ch for (z) in 0 .. 0
field nstz : max bound 1                # 文の数（最後の文番号）
nstz[z] <- snum[t] for (t,zc) in ch for (z) in 0 .. 0
field ndcz : max bound 1                # 宣言の数（最後の宣言番号）
ndcz[z] <- dseq[t] for (t,zc) in ch for (z) in 0 .. 0

field cpos : max bound 589824            # トークンの中の位置（これも鎖）
cpos[0] <- 0
cpos[i] <- cpos[i-1] + 1 for (i,c) in ch if i >= 1 if not brk[i]
cpos[i] <- 0             for (i,c) in ch if i >= 1 if brk[i]

field ocof : max bound 589824            # 文字 i の属する出現
ocof[i] <- oseq[tnum[i]] for (i,c) in ch if isocc[tnum[i]]
field dcof : max bound 589824            # 文字 i の属する宣言
dcof[i] <- dseq[tnum[i]] for (i,c) in ch if isdcl[tnum[i]]

field och : max bound 32768 16          # 出現 o の k 文字目
och[ocof[i], cpos[i]] <- c for (i,c) in ch if isocc[tnum[i]] if cpos[i] <= 15
field dch : max bound 2048 16           # 宣言 d の k 文字目
dch[dcof[i], cpos[i]] <- c for (i,c) in ch if isdcl[tnum[i]] if cpos[i] <= 15

field oin : or bound 32768
oin[oseq[t]] <- true for (t,zc) in ch if isocc[t]
field din : or bound 2048
din[dseq[t]] <- true for (t,zc) in ch if isdcl[t]
# **名前は 8 文字 × 7 ビット = 56 ビット。一つの整数に畳める。**
# 綴りの照合に「出現 × 宣言」の面（8192×1024 が二枚 = 134MB）は要らなかった
# —— 要るのは **鍵が同じか**だけである。文字は 127 以下なので 128 進で
# 積めば、短い名前が長い名前の鍵と一致することは無い（長さの比較も鍵が言う）。
# 升で比べるのは、**比べるものに名前を付けていない**ことの言い換えだった。
# **鍵は二本。** 56 ビットに入るのは 8 文字までなので、9〜16 文字目は
# 二本目に積む（8 文字以下の名前は二本目が両側とも 0 になって、そのまま合う）。
# 17 文字以上は焼かない —— 鍵が衝突して **黙って間違う**からである。
field ok : max bound 32768 16            # 出現 o の鍵（k 文字目まで畳んだもの）
ok[o,0] <- och[o,0] for (o) in 0 .. nocz[0] if oin[o]
ok[o,k] <- ok[o,k-1] * 128 + och[o,k] for (o) in 0 .. nocz[0] for (k) in 1 .. 7 if oin[o]
ok[o,8] <- och[o,8] for (o) in 0 .. nocz[0] if oin[o]
ok[o,k] <- ok[o,k-1] * 128 + och[o,k] for (o) in 0 .. nocz[0] for (k) in 9 .. 15 if oin[o]
field okey : max bound 32768             # 出現 o の鍵（1〜8 文字目）
okey[o] <- ok[o,k] for (o) in 0 .. nocz[0] for (k) in 0 .. 7 if oin[o]
field okey2 : max bound 32768            # 出現 o の鍵（9〜16 文字目。無ければ 0）
okey2[o] <- 0 for (o) in 0 .. nocz[0]
okey2[o] <- ok[o,k] for (o) in 0 .. nocz[0] for (k) in 8 .. 15 if oin[o]
field dk : max bound 2048 16            # 宣言 d の鍵（途中）
dk[d,0] <- dch[d,0] for (d) in 0 .. ndcz[0] if din[d]
dk[d,k] <- dk[d,k-1] * 128 + dch[d,k] for (d) in 0 .. ndcz[0] for (k) in 1 .. 7 if din[d]
dk[d,8] <- dch[d,8] for (d) in 0 .. ndcz[0] if din[d]
dk[d,k] <- dk[d,k-1] * 128 + dch[d,k] for (d) in 0 .. ndcz[0] for (k) in 9 .. 15 if din[d]
field dkey : max bound 2048             # 宣言 d の鍵（1〜8 文字目）
dkey[d] <- dk[d,k] for (d) in 0 .. ndcz[0] for (k) in 0 .. 7 if din[d]
field dkey2 : max bound 2048            # 宣言 d の鍵（9〜16 文字目。無ければ 0）
dkey2[d] <- 0 for (d) in 0 .. ndcz[0]
dkey2[d] <- dk[d,k] for (d) in 0 .. ndcz[0] for (k) in 8 .. 15 if din[d]
field ofl : max bound 32768              # 出現 o が指す場（＝宣言の番号）
ofl[o] <- d for (o) in 0 .. nocz[0] for (d) in 0 .. ndcz[0]
      if oin[o] if din[d] if okey[o] == dkey[d] if okey2[o] == dkey2[d]

# **綴りの合う宣言が無い出現**（`g[i]` と書いたのに `field g` が無い）は
# 断片の外である。⊥ は比べられない（比べると規則ごと落ちる）ので、
# **合ったものに印を付けて、その否定を見る**。
field ohas : or bound 32768              # 宣言に行き当たった出現
ohas[o] <- true for (o) in 0 .. nocz[0] if ofl[o] >= 1
field onod : or bound 1                 # 行き当たらない出現があった
onod[z] <- true for (o) in 0 .. nocz[0] for (z) in 0 .. 0 if oin[o] if not ohas[o]

# ── 文と頭 ─────────────────────────────────────────────────────────
field osn : max bound 32768              # 出現の属する文
osn[oseq[t]] <- snum[t] for (t,zc) in ch if isocc[t]
field ohd : or bound 32768               # 出現が文の頭（＝書き先）
ohd[oseq[t]] <- true for (t,zc) in ch if isocc[t] if sbrk[t]

# ── 非単調な読み ───────────────────────────────────────────────────
# 四つある: `not` の直後 / 比較のある節の中 / **添字の中** / **向きの食い違い**
# （座標にできるのは確定した値だけ —— 気づき24 の表側）
field arrw : or bound 589824             # `<-` の `<`（比較ではない）
arrw[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 60 if tch[t+1,0] == 45
field cmpt : or bound 589824             # 比較の記号
cmpt[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 61
cmpt[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 33
cmpt[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 62
cmpt[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if not arrw[t]
      if tch[t,0] == 60
field gcl : max bound 589824             # 大域の節番号（鎖）
gcl[0] <- 0
gcl[t] <- gcl[t-1]     for (t,zc) in ch if t >= 1 if not cbrk[t]
gcl[t] <- gcl[t-1] + 1 for (t,zc) in ch if t >= 1 if cbrk[t]
field cmpcl : or bound 589824            # 比較を含む節
cmpcl[gcl[t]] <- true for (t,zc) in ch if cmpt[t]
field isneg : or bound 589824            # `not` の直後の語
isneg[t] <- true for (t,zc) in ch if kwnot[prevw[t]]
field tdep : max bound 589824            # トークンの括弧の深さ
tdep[t] <- pre[tstart[t]] for (t,zc) in ch if tlen[t] >= 1
# **flat の升は LVar である**（⊥ → v で止まる。⊤ は矛盾で、焼いた側は終了コード 4 で止まる）。
# 一度決まった値は動かないので、比べても、座標にしても、読んだ答えは取り消されない ——
# 比較と添字の中の flat の読みは単調である（解釈実行の classify と同じ判断。気づき24 の
# 「座標の契約は確定していること」の表側）。否定だけは別で、`not f[…]` は ⊥ で真に読まれる。
# 前は比較と添字を一律に非単調と数えていたので、flat の場を座標に読む再帰（項の番地の
# 鎖・原子の符号化・アクセサ）が、解釈実行は解けるのに焼く側だけ成層できなかった。
# **向きの合う比較（`lo <= hi`、min が左で max が右）はここでは緩めない。** 答えの上では単調だが、
# 証人の階数は「升が最後に動いた周回」なので、ガードが先に立ったあとで辺の升が動くと、導いた升の
# 階数が読んだ升の最後の階数より小さくなり、証明書が示せない（解釈実行の C の裏側 + attest.py でも
# 同じ形の本が REJECTED になる —— 証人の形の限界であって、焼く側の限界ではない）。
# flat は一度しか動かないので、使った値と最後の値が同じで、この問題が起きない。
field tnonm : or bound 589824
tnonm[t] <- true for (t,zc) in ch if isneg[t]
tnonm[t] <- true for (t,zc) in ch if cmpcl[gcl[t]] if not rfl[t]
tnonm[t] <- true for (t,zc) in ch if tdep[t] >= 1 if not rfl[t] if not isbnl[t]
tnonm[t] <- true for (t,zc) in ch if tnm4[t]
# **二重以上のループの集約は、読みで層を切る**（13f）。集約は「一度だけ数える」を日程で持つ
# （31_gen の `amul`）—— 読む場が同じ層で動くと二周目で数え直すので、読む場を下の層に閉じる。
# 余分に層を切るのは答えを変えない（読む場が集約を読み返していれば輪になって断る —— 前と同じ）。
field sagm : or bound 16384             # 文 s は二重以上のループの集約
sagm[snum[t]] <- true for (t,zc) in ch if kwfor[t] if lseq[t] >= 2 if sagg[snum[t]]
tnonm[t] <- true for (t,zc) in ch if sagm[snum[t]] if t > arrowt[snum[t]]
field onm : or bound 32768
onm[oseq[t]] <- true for (t,zc) in ch if isocc[t] if tnonm[t]

# ── 四つ目: **向きの食い違い** ─────────────────────────────────────
# 三つは **位置**だけを見ていた。答えの定義（解釈実行の `classify`）は
# 位置のほかに **向き**を見る。読む場は動く向きが決まっている —— min は
# 下へ、max / or / count は上へ、flat は動かない（一度入ったら ⊤ しかない）。
# 読む位置も要る向きが決まっている —— min の値は下へ、ほかの値と素の
# ガードと区間の上端は上へ、引く群は裏返り、証の無い `*` `/` `%` に
# 呑まれた読みは向きを失う（座標と同じになる）。食い違えば、書き手が
# 途中で持っていた値を読み手が **取り消せない**: `f2[f0[i]] <- f1[i]`
# （f2 は min、f1 は count）では、数え終わる前の 1 を min が掴んで離さない。
# 焼く側は三つしか数えていなかったので、同じ層で読んで **黙って間違えた**
# （入力 `abcdefghij` で f2[1] が 解釈 3 / 焼いた答え 1）。`lattix.lx` 自身の中にも
# 百十六本あった —— 値が一度しか入らない場（鎖）ばかりだったので出なかった。
# 流儀は `classify` と同じ: 向きを保つのは `+`、裏返すのは `-` の右、
# `* 数` と `/ 正の数` は保ち、それ以外の掛け割り余りは座標にする。
# **変数を掛ける読みは証さない**（解釈実行はデータで証せるが、焼く側は
# データを見ずに焼く）—— 余分に層を切るのは答えを変えない。足りないのが嘘である。
field vop : or bound 589824             # 値の式の、括弧の外の演算子
vop[t] <- true for (t,zc) in ch if aftarw[t] if isop[t]
field vadd : or bound 589824            # そのうち足し引き（群の切れ目）
vadd[t] <- true for (t,zc) in ch if vop[t] if isplus[t]
vadd[t] <- true for (t,zc) in ch if vop[t] if ismin[t]
# 手前と後ろの演算子は **鎖**で運ぶ（lastw / firstw と同じ手）。値の式は
# 矢印で始まり、節の頭で終わる —— その二つが番兵である。添字の中の
# 演算子は深さ 1 なので `vop` にならず、鎖は `f[i-1]` を一跨ぎにする。
field lopw : max bound 589824           # t 以前で最後の演算子（矢印も）
lopw[t] <- t         for (t,zc) in ch if vop[t]
lopw[t] <- t         for (t,zc) in ch if arrw[t]
lopw[t] <- lopw[t-1] for (t,zc) in ch if t >= 1 if not vop[t] if not arrw[t]
field ladw : max bound 589824           # t 以前で最後の足し引き（矢印も）
ladw[t] <- t         for (t,zc) in ch if vadd[t]
ladw[t] <- t         for (t,zc) in ch if arrw[t]
ladw[t] <- ladw[t-1] for (t,zc) in ch if t >= 1 if not vadd[t] if not arrw[t]
field nopw : min bound 589824           # t 以降で最初の演算子（節の頭も）
nopw[t] <- t         for (t,zc) in ch if vop[t]
nopw[t] <- t         for (t,zc) in ch if cbrk[t]
nopw[t] <- nopw[t+1] for (t,zc) in ch if not vop[t] if not cbrk[t]
field lopt : max bound 589824           # 因子 t の手前の演算子
lopt[t] <- lopw[t-1] for (t,zc) in ch if t >= 1
field lopa : max bound 589824           # その演算子の手前の語（前の因子）
lopa[t] <- prevw[lopt[t]] for (t,zc) in ch if t >= 1
field nopt : min bound 589824           # 因子 t の後ろの演算子
nopt[t] <- nopw[t+1] for (t,zc) in ch
field nxat : min bound 589824           # その演算子の次の語（次の因子）
nxat[t] <- nextw[nopt[t]] for (t,zc) in ch
field lead : or bound 589824            # 群の頭（手前が 矢印 / + / -）
lead[t] <- true for (t,zc) in ch if arrw[lopt[t]]
lead[t] <- true for (t,zc) in ch if isplus[lopt[t]]
lead[t] <- true for (t,zc) in ch if ismin[lopt[t]]
# 後ろに続く掛け割りが **全部** `* 数` か `/ 正の数` なら向きは保たれる
field tailok : or bound 589824
tailok[t] <- true for (t,zc) in ch if cbrk[nopt[t]]
tailok[t] <- true for (t,zc) in ch if isplus[nopt[t]]
tailok[t] <- true for (t,zc) in ch if ismin[nopt[t]]
tailok[t] <- true for (t,zc) in ch if isstar[nopt[t]] if isnum[nxat[t]]
      if tailok[nxat[t]]
tailok[t] <- true for (t,zc) in ch if isdiv[nopt[t]] if isnum[nxat[t]]
      if tval[nxat[t]] >= 1 if tailok[nxat[t]]
# **計数器を掛けても向きは保たれる**（14f。`fact[n] <- fact[n-1] * n`）—— 区間の下端が数一つなら
# 計数器は負にならない（下の `cnn`）
tailok[t] <- true for (t,zc) in ch if isstar[nopt[t]] if cnn[nxat[t]] if tailok[nxat[t]]
# 保たれるのは群の頭か、`数 * f[x]` の二つ目（`2 * 3 * f[x]` は保たない ——
# 答えの定義がそう読む。左が式なら証が無い）
field keep : or bound 589824
keep[t] <- true for (t,zc) in ch if tailok[t] if lead[t]
keep[t] <- true for (t,zc) in ch if tailok[t] if isstar[lopt[t]]
      if isnum[lopa[t]] if lead[lopa[t]]
keep[t] <- true for (t,zc) in ch if tailok[t] if isstar[lopt[t]]
      if cnn[lopa[t]] if lead[lopa[t]]
field sdn : or bound 16384               # 文 s の書き先は下へ動く（min）
sdn[s] <- true for (s) in 0 .. nstz[0] if hasr[s] if flatt[hfz[s]] == 1
# **書き先の側にも向きがある。** max / or / count の join は上へ動く値を、
# min の join は下へ動く値を **呑み込む**（途中の値は最後の値に負ける）。
# flat は呑めない —— 値どうしが比べられないので、3 のあとの 5 は ⊤ になる。
# sum も呑めない —— 寄与ごとに値を持つので、同じ寄与の値が変われば ⊤ になる。
# 呑めない書き先の値は、動く場を読んではならない（動かない flat だけ読める）。
field sor : or bound 16384               # 文 s の書き先は or
sor[s] <- true for (s) in 0 .. nstz[0] if hasr[s] if flatt[hfz[s]] == 3
field sagg : or bound 16384              # 文 s の書き先は集約（sum / count）
sagg[s] <- true for (s) in 0 .. nstz[0] if hasr[s] if flatt[hfz[s]] == 8
sagg[s] <- true for (s) in 0 .. nstz[0] if hasr[s] if flatt[hfz[s]] == 9
field sabs : or bound 16384              # 文 s の書き先は動く値を呑める
sabs[s] <- true for (s) in 0 .. nstz[0] if hasr[s] if flatt[hfz[s]] == 1
sabs[s] <- true for (s) in 0 .. nstz[0] if hasr[s] if flatt[hfz[s]] == 2
sabs[s] <- true for (s) in 0 .. nstz[0] if hasr[s] if flatt[hfz[s]] == 3
sabs[s] <- true for (s) in 0 .. nstz[0] if hasr[s] if flatt[hfz[s]] == 9
field vneg : or bound 589824            # 引かれる群の中
vneg[t] <- true for (t,zc) in ch if t >= 1 if ismin[ladw[t-1]]
field rqdn : or bound 589824            # その位置は下へ動くことを要る
rqdn[t] <- true for (t,zc) in ch if sdn[snum[t]] if not vneg[t]
rqdn[t] <- true for (t,zc) in ch if not sdn[snum[t]] if vneg[t]
field rdl : max bound 589824            # 読む場の束
rdl[t] <- flatt[ixcf[t]] for (t,zc) in ch if isocc[t]
field rup : or bound 589824             # 読む場は上へ動く（max / or / count）
rup[t] <- true for (t,zc) in ch if rdl[t] == 2
rup[t] <- true for (t,zc) in ch if rdl[t] == 3
rup[t] <- true for (t,zc) in ch if rdl[t] == 9
field rdn : or bound 589824             # 読む場は下へ動く（min）
rdn[t] <- true for (t,zc) in ch if rdl[t] == 1
field rfl : or bound 589824             # 読む場は動かない（flat）
rfl[t] <- true for (t,zc) in ch if rdl[t] == 6
# sum と、断片の知らない束は **どちらへも動く**とみなす（証が無い）
field ifocl : or bound 589824           # 括弧の外に演算子を持つ if 節
ifocl[gcl[t]] <- true for (t,zc) in ch if ifop[t]
field tnm4 : or bound 589824
tnm4[t] <- true for (t,zc) in ch if isocc[t] if aftarw[t] if not rfl[t]
      if not keep[t]
tnm4[t] <- true for (t,zc) in ch if isocc[t] if aftarw[t] if not rfl[t]
      if not sabs[snum[t]]
tnm4[t] <- true for (t,zc) in ch if isocc[t] if aftarw[t] if not rfl[t]
      if rqdn[t] if not rdn[t]
tnm4[t] <- true for (t,zc) in ch if isocc[t] if aftarw[t] if not rfl[t]
      if not rqdn[t] if not rup[t]
# 素のガード（`if f[x]`）と区間の上端（`.. f[0]`）は上へ動くことを要る
tnm4[t] <- true for (t,zc) in ch if isocc[t] if tdep[t] == 0 if not rfl[t]
      if not rup[t] if clif2[snum[t], cnum[t]]
tnm4[t] <- true for (t,zc) in ch if isocc[t] if tdep[t] == 0 if not rfl[t]
      if not rup[t] if isbnd[t] if not isbnl[t]
# 区間の **下端** は下へ動くことを要る（解釈実行の classify(.., 'DOWN')。区間が縮んではならない）
#   （下端の読みは丸括弧の中 —— 深さ 1 でも添字ではない）
tnm4[t] <- true for (t,zc) in ch if isocc[t] if not rfl[t]
      if not rdn[t] if isbnl[t]
# for 節の、上端でない読みは向きを言えない（区間の下端は下へ動くことを要る）
tnm4[t] <- true for (t,zc) in ch if isocc[t] if tdep[t] == 0 if cnum[t] >= 1
      if not isbnd[t] if not clif2[snum[t], cnum[t]]
# 式の辺は焼かない（種15）が、**成層は焼けるかどうかに寄りかからない**
tnm4[t] <- true for (t,zc) in ch if isocc[t] if tdep[t] == 0 if ifocl[gcl[t]]

# ══ 軸に沿った成層（14l）═══════════════════════════════════════════════
# 解釈実行は輪の中の否定を、書き先の **軸**（静的な区間の計数器）で具体例に開いて成層する（SPEC §4
# 「層は座標である」）。石取りの勝ち負け `win[n] <- 1 for (n) in 1 .. 15 if win[n - 1] == 0` は、場の
# 粒度では win → win の否定の輪だが、読むのはいつも **自分より小さい切り口** n - 1 である。
# 焼く側は、その形の規則を **一つのループに融合して n を昇る**（31_gen の融合）: 切り口 n を作るとき、
# 読む n - c（c >= 1）は前の周回の中で既に閉じている —— だから一周で正しく、二周目は何も動かさない。
# **二つの判断を一つにする**: ここで輪を許すのは、融合が必ず起きる形だけ（ループ一つ・数の区間・同じ端・
# 同じ場を書く規則が源の上で隣り合う）。生成器は、許された規則が融合しなかったら断る（31_gen、理由 7）
# —— 前段だけが許して生成器が融合しなければ、非単調な読みが途中の値を読んで **黙って間違える**。
# 読みは二段まで（自己検査の古い道の限界 —— sedv2 の註）。
field shof : max bound 16384             # 文 s の書き先の出現
shof[osn[o]] <- o for (o) in 0 .. nocz[0] if ohd[o]
field ohof : or bound 32768              # 出現 o の次元0 にずれがある
ohof[o] <- true for (o) in 0 .. nocz[0] if c0hf[o] >= 1
field sax1 : or bound 16384              # 文 s は軸の規則の形: 段0 が数の区間・書き先の次元0 がその計数器そのもの
# 内側にループがあってもよい（14n）—— 生成器は群の段0 だけを融合し、内側の段は規則ごとに回す
sax1[s] <- true for (s) in 0 .. nstz[0] if isrec[s] if lkd[s, 0] == 1 if llhv[s, 0]
      if c0sr[shof[s]] == 1 if c0cc[shof[s]] == 0 if not ohof[shof[s]]
field ohz : max bound 32768              # 出現 o の文の書き先の場（0 起点）
ohz[o] <- hfz[osn[o]] for (o) in 0 .. nocz[0] if oin[o]
field ohl : max bound 32768              # 同じもの（1 起点 —— ofl と比べる）
ohl[o] <- hfl[osn[o]] for (o) in 0 .. nocz[0] if oin[o]
field osx : or bound 32768               # 出現 o の文は軸の規則の形
osx[o] <- true for (o) in 0 .. nocz[0] if oin[o] if sax1[osn[o]]
field oax1 : or bound 32768              # 出現 o は同じ場の、書き先の軸より小さい切り口を読む（`f[n - c]`、c >= 1）
oax1[o] <- true for (o) in 0 .. nocz[0] if osx[o] if not ohd[o] if ofl[o] == ohl[o]
      if c0sr[o] == 1 if c0cc[o] == 0 if c0hf[o] == 1 if c0of[o] >= 128
# **軸の形でない書き手は、自分の場を読まなければ土台である**（14n）。`s[0, j] <- j for (j) in 0 .. 4` は
# 切り口 0 を敷くだけで、輪に入っていない —— 群より前の層で閉じていれば（下の wlvlb）、群は閉じた
# 切り口を読む。自分の場を読む書き手（`s[0, j] <- s[5, j]`）は輪の中なので、軸では受け取らない
field sfrd : or bound 16384              # 文 s は自分の書き先の場を読む
sfrd[osn[o]] <- true for (o) in 0 .. nocz[0] if oin[o] if not ohd[o] if ofl[o] == ohl[o]
field fxw : or bound 2048                # 場 f を書く規則に、軸の形でなく、f を読むものがある
fxw[hfz[s]] <- true for (s) in 0 .. nstz[0] if isrec[s] if not sax1[s] if sfrd[s]
field fxrd : or bound 2048               # 場 f を書く軸の規則が、f を軸の形でなく読む（同じ切り口や大きい切り口）
fxrd[ohz[o]] <- true for (o) in 0 .. nocz[0] if osx[o] if not ohd[o] if ofl[o] == ohl[o] if not oax1[o]
field fxl0 : min bound 2048              # 場 f の軸の規則の下端の最小 / 最大（同じでなければ融合しない）
fxl0[hfz[s]] <- llo2[s, 0] for (s) in 0 .. nstz[0] if sax1[s]
field fxl1 : max bound 2048
fxl1[hfz[s]] <- llo2[s, 0] for (s) in 0 .. nstz[0] if sax1[s]
field fxh0 : min bound 2048              # 上端の最小 / 最大
fxh0[hfz[s]] <- lhi2[s, 0] for (s) in 0 .. nstz[0] if sax1[s]
field fxh1 : max bound 2048
fxh1[hfz[s]] <- lhi2[s, 0] for (s) in 0 .. nstz[0] if sax1[s]
field isrl : or bound 16384              # 文 s は規則（isrec の写し。鎖の中で読む）
isrl[s] <- true for (s) in 0 .. nstz[0] if isrec[s]
field prr : max bound 16384              # 文 s より前の、最後の規則の文
prr[s] <- s - 1 for (s) in 1 .. nstz[0] if isrl[s-1]
prr[s] <- prr[s-1] for (s) in 1 .. nstz[0] if not isrl[s-1]
field prh : max bound 16384              # その規則の書き先の場
prh[s] <- hfz[prr[s]] for (s) in 0 .. nstz[0] if prr[s] >= 0
field fxfs : min bound 2048              # 場 f の最初の軸の規則の文
fxfs[hfz[s]] <- s for (s) in 0 .. nstz[0] if sax1[s]
field sxfs : max bound 16384             # 文 s の書き先の場の最初の軸の規則の文
sxfs[s] <- fxfs[hfz[s]] for (s) in 0 .. nstz[0] if sax1[s]
field fxg : or bound 2048                # 場 f の軸の規則のあいだに、別の場を書く規則がある
fxg[hfz[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if s > sxfs[s] if prh[s] != hfz[s]
# **軸の成層が要る場だけを軸の場にする**（14n）。形だけ見れば `x[n] <- … for (n) in 0 .. 9` はみな軸の規則の
# 形をしている。それを全部軸の群にすると、入口の +1（oxin）が **単調な相互再帰**（下ろしの機械の
# `_kf1[k, j + 1] <- _kg1[k, j] …` と `_kg1[k, j] <- _kf1[k, j] …`）に輪の +1 を作り、層が昇り続けて
# 成層できないと言った（内側にループを許した日に出た。一重でも同じ形は在った）。軸が要るのは、
# 自分の小さい切り口を **非単調に**読むときだけである
field fxnd : or bound 2048               # 場 f の軸の規則が、f の小さい切り口を非単調に読む
fxnd[ohz[o]] <- true for (o) in 0 .. nocz[0] if oax1[o] if onm[o]
field fax1 : or bound 2048               # 場 f は **一つで**軸に沿って成層できる（14l〜14n の形）
fax1[hfz[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if not fxw[hfz[s]] if not fxrd[hfz[s]]
      if fxl0[hfz[s]] == fxl1[hfz[s]] if fxh0[hfz[s]] == fxh1[hfz[s]] if fxnd[hfz[s]]
# ── **二つ以上の場が軸をまたいで読み合う群**（14o）────────────────────────────────
# グランディ数の mex（`has[n, v] <- … if gr[n - 1] == v` と `gr[n] <- v … if not has[n, v]`）・ライフゲーム
# （`nb[t, x, y] <- 1 … if g[t, …]` と `g[t, x, y] <- … if nb[t - 1, x, y] == 3`）は、場の粒度では否定の輪で、
# 一つの場の軸（上）でも受け取れない —— 輪が場をまたぐ。だが解釈実行が開く具体例は **切り口 n の中で
# 閉じる順序** を持つ: 切り口 n の has は gr[n - 1] だけを読み、切り口 n の gr は has[n] を読む。だから
# 群の規則を段0 で融合し、各 n で **源の順に** 回せば一周で正しい —— 読む切り口が n - c（c ≥ 1）なら前の周回で
# 閉じていて、同じ切り口 n を読むなら、その場の群の書き手が全部 **源の上で前に**いればこの周回で閉じている。
# 群は「軸の形の規則が、軸の形で読まれる場を軸の形で読む」繋がりの成分（いちばん小さい場の番号が名 ——
# min の鎖）。誰にも軸の形で読まれない場（`live[t] <- … if c[t, i]` の live）は群に入れない。
# 群が成り立たなければ、一つの場の軸（fax1）に戻る —— 14n までに受け取った本は同じに受け取る。
field ofzx : max bound 32768              # 出現 o の読む場（0 起点）
ofzx[o] <- ofl[o] - 1 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
field oxc0 : or bound 32768              # 出現 o は軸の規則の、同じ切り口の読み（`g[n, …]`）
oxc0[o] <- true for (o) in 0 .. nocz[0] if osx[o] if not ohd[o] if c0sr[o] == 1 if c0cc[o] == 0 if not ohof[o]
field oxc1 : or bound 32768              # 小さい切り口の読み（`g[n - c, …]`、c >= 1）
oxc1[o] <- true for (o) in 0 .. nocz[0] if osx[o] if not ohd[o] if c0sr[o] == 1 if c0cc[o] == 0 if c0hf[o] == 1
      if c0of[o] >= 128
# **降りる軸**（14p）: 大きい切り口を読む（`g[n + c, …]`、c >= 1）群は、段0 を上から下へ回せば同じ主張が立つ ——
# 切り口 n を作るとき、n + c は前の周回（上の切り口）で閉じている。後ろから解くゲーム・後ろ向きの動的計画法
field oxc2 : or bound 32768              # 大きい切り口の読み（`g[n + c, …]`、c >= 1）
oxc2[o] <- true for (o) in 0 .. nocz[0] if osx[o] if not ohd[o] if c0sr[o] == 1 if c0cc[o] == 0 if c0hf[o] == 1
      if c0of[o] >= 1 if c0of[o] <= 127
field fxs : or bound 2048                # 場 f を書く軸の形の規則がある
fxs[hfz[s]] <- true for (s) in 0 .. nstz[0] if sax1[s]
field fxrb : or bound 2048               # 場 f は軸の形の規則に、軸の形で読まれる
fxrb[ofzx[o]] <- true for (o) in 0 .. nocz[0] if oxc0[o]
fxrb[ofzx[o]] <- true for (o) in 0 .. nocz[0] if oxc1[o]
fxrb[ofzx[o]] <- true for (o) in 0 .. nocz[0] if oxc2[o]
# 群に入れるのは **読まれもし、読みもする**場だけ（輪の上に居うる場）。誰にも軸の形で読まれない場（`live`）も、
# 群の場を軸の形で読まない場（後ろ向きの本の `big[n, k] <- … if v[n] > k`）も、群の入口か出口であって輪の外 ——
# 入口は下の層で閉じる（oxin）。前は入口まで群に入れて同じ層に置き、解釈実行（入口を先の層に置く）と
# 層が食い違っていた（答えは同じだったが、strat.py の破れになった —— 14p）
field fxro : or bound 2048               # 場 f の軸の形の書き手が、軸の形の規則の書く場を軸の形で読む
fxro[ohz[o]] <- true for (o) in 0 .. nocz[0] if oxc0[o] if fxs[ofzx[o]]
fxro[ohz[o]] <- true for (o) in 0 .. nocz[0] if oxc1[o] if fxs[ofzx[o]]
fxro[ohz[o]] <- true for (o) in 0 .. nocz[0] if oxc2[o] if fxs[ofzx[o]]
field oxl : or bound 32768               # 出現 o は群を繋ぐ
oxl[o] <- true for (o) in 0 .. nocz[0] if oxc0[o] if fxs[ofzx[o]] if fxrb[ohz[o]] if fxro[ofzx[o]]
oxl[o] <- true for (o) in 0 .. nocz[0] if oxc1[o] if fxs[ofzx[o]] if fxrb[ohz[o]] if fxro[ofzx[o]]
oxl[o] <- true for (o) in 0 .. nocz[0] if oxc2[o] if fxs[ofzx[o]] if fxrb[ohz[o]] if fxro[ofzx[o]]
field bid : min bound 2048               # 場 f の群の名（成分のいちばん小さい場）
bid[hfz[s]] <- hfz[s] for (s) in 0 .. nstz[0] if sax1[s]
bid[ohz[o]] <- bid[ofzx[o]] for (o) in 0 .. nocz[0] if oxl[o]
bid[ofzx[o]] <- bid[ohz[o]] for (o) in 0 .. nocz[0] if oxl[o]
field sbid : max bound 16384             # 文 s の書き先の群（読みを二段に保つ写し）
sbid[s] <- bid[hfz[s]] for (s) in 0 .. nstz[0] if sax1[s]
field oxbk : max bound 32768              # 出現 o の文の書き先の群（頭の座標を一段に保つ写し —— 自己検査の古い道）
oxbk[o] <- bid[ohz[o]] for (o) in 0 .. nocz[0] if osx[o]
field obid : or bound 32768              # 出現 o は、軸の形の規則が自分の群の場を読む
obid[o] <- true for (o) in 0 .. nocz[0] if osx[o] if not ohd[o] if fxs[ofzx[o]] if bid[ofzx[o]] == bid[ohz[o]]
field bnd : or bound 2048                # 群 b の中に非単調な読みがある（群が要る）
bnd[oxbk[o]] <- true for (o) in 0 .. nocz[0] if oxl[o] if onm[o] if obid[o]
field bxrd : or bound 2048               # 群の規則が群の場を軸の形でなく読む
bxrd[oxbk[o]] <- true for (o) in 0 .. nocz[0] if obid[o] if not oxc0[o] if not oxc1[o] if not oxc2[o]
field bup : or bound 2048                # 群 b は小さい切り口を読む（昇る軸）/ 大きい切り口を読む（降りる軸）
bup[oxbk[o]] <- true for (o) in 0 .. nocz[0] if obid[o] if oxc1[o]
field bdn : or bound 2048
bdn[oxbk[o]] <- true for (o) in 0 .. nocz[0] if obid[o] if oxc2[o]
# **切り口の中の順序は源の順ではなく、読みが決める**（Lattix の答えは文の順に依らない —— 06_order_free）。
# 同じ切り口 n を読む文は、読む場の書き手より後に回す: 切り口の中の段 = 同じ切り口の読みに沿った最長路。
# 規則の番号（lib/fold.lx の rno）が群の中でこの段の順に並ぶので、融合した一周もこの順に回る。
# 段が昇り続けるなら（自分の切り口を読む・互いに同じ切り口を読む）切り口の中に輪がある —— 群にしない
field bsl : or bound 16384 8             # 文 s は切り口の中で k 段目以降に回る
bsl[s, 0] <- true for (s) in 0 .. nstz[0] if sax1[s]
field wsl : or bound 2048 8              # 場 f の軸の形の書き手が k 段目以降にいる
wsl[hfz[s], k] <- true for (s) in 0 .. nstz[0] for (k) in 0 .. 7 if sax1[s] if bsl[s, k]
bsl[osn[o], k + 1] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 6 if oxc0[o] if obid[o] if wsl[ofzx[o], k]
field ssl : max bound 16384              # 文 s の切り口の中の段
ssl[s] <- k for (s) in 0 .. nstz[0] for (k) in 0 .. 7 if bsl[s, k]
# **切り口の中の単調な輪は、切り口ごとに動かなくなるまで回す**（14q）。同じ切り口 n の二つの場が互いを単調に
# 読む（`b[n] <- c[n]`・`c[n] <- … if b[n] >= 1`）なら、切り口 n の中は単調な再帰で、源の順の一周では足りない。
# 群の段0 の中に「この切り口で何か動いたらもう一周」を入れる（31_gen の raxc）。切り口の中に非単調な読みが
# あって、しかも輪があるなら、途中の値を読むので断る
field bcy : or bound 2048                # 群の切り口の中に輪がある
bcy[sbid[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if bsl[s, 7]
field bnm0 : or bound 2048               # 群の中に、同じ切り口の非単調な読みがある
bnm0[oxbk[o]] <- true for (o) in 0 .. nocz[0] if oxc0[o] if obid[o] if onm[o]
field bxor : or bound 2048               # 切り口の中に、非単調な読みを含む輪がある
bxor[sbid[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if bsl[s, 7] if bnm0[sbid[s]]
field bxfs : min bound 2048              # 群 b の最初の文
bxfs[sbid[s]] <- s for (s) in 0 .. nstz[0] if sax1[s]
field sbfs : max bound 16384             # 文 s の群の最初の文
sbfs[s] <- bxfs[sbid[s]] for (s) in 0 .. nstz[0] if sax1[s]
field prb : max bound 16384              # 文 s の前の規則の書き先の群
prb[s] <- bid[prh[s]] for (s) in 0 .. nstz[0] if prr[s] >= 0
# 群の文が源の上で離れていてもよい（14o）—— 規則の番号（lib/fold.lx）が群を一続きに並べる。bxg は数えるだけ
field bxg : or bound 2048                # 群の文のあいだに、群の外の場を書く規則がある
bxg[sbid[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if s > sbfs[s] if not fxs[prh[s]]
bxg[sbid[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if s > sbfs[s] if prb[s] != sbid[s]
field bxw : or bound 2048                # 軸の形でない書き手が群の場を読む（土台になれない）
field obw : max bound 32768              # 出現 o の文（軸の形でない書き手）の書き先の群
obw[o] <- bid[ohz[o]] for (o) in 0 .. nocz[0] if oin[o] if not ohd[o] if not osx[o] if fxs[ohz[o]]
bxw[obw[o]] <- true for (o) in 0 .. nocz[0] if obw[o] >= 0 if fxs[ofzx[o]] if bid[ofzx[o]] == obw[o]
field bxl0 : min bound 2048              # 群の段0 の下端の最小 / 最大、上端の最小 / 最大
bxl0[sbid[s]] <- llo2[s, 0] for (s) in 0 .. nstz[0] if sax1[s]
field bxl1 : max bound 2048
bxl1[sbid[s]] <- llo2[s, 0] for (s) in 0 .. nstz[0] if sax1[s]
field bxh0 : min bound 2048
bxh0[sbid[s]] <- lhi2[s, 0] for (s) in 0 .. nstz[0] if sax1[s]
field bxh1 : max bound 2048
bxh1[sbid[s]] <- lhi2[s, 0] for (s) in 0 .. nstz[0] if sax1[s]
field bax0 : or bound 2048               # 群 b は成り立つ（端の違いは下ろしが揃える）
bax0[sbid[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if bnd[sbid[s]] if not bxrd[sbid[s]] if not bxor[sbid[s]]
      if not bxw[sbid[s]] if not bup[sbid[s]]
bax0[sbid[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if bnd[sbid[s]] if not bxrd[sbid[s]] if not bxor[sbid[s]]
      if not bxw[sbid[s]] if not bdn[sbid[s]]
field bax : or bound 2048                # 群 b は焼ける（端も揃っている）
bax[sbid[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if bax0[sbid[s]]
      if bxl0[sbid[s]] == bxl1[sbid[s]] if bxh0[sbid[s]] == bxh1[sbid[s]]
field fbk : max bound 2048               # 場 f の軸の群（群が成り立てば群の名、一つで成り立てば f）
fbk[hfz[s]] <- sbid[s] for (s) in 0 .. nstz[0] if sax1[s] if bax[sbid[s]]
fbk[hfz[s]] <- hfz[s] for (s) in 0 .. nstz[0] if sax1[s] if not bax[sbid[s]] if fax1[hfz[s]]
field fax : or bound 2048                # 場 f は軸に沿って成層できる
fax[hfz[s]] <- true for (s) in 0 .. nstz[0] if sax1[s] if fbk[hfz[s]] >= 0
field sax : or bound 16384               # 文 s は軸に沿って成層した規則（生成器が融合を確かめる）
sax[s] <- true for (s) in 0 .. nstz[0] if sax1[s] if fax[hfz[s]]
field sfb : max bound 16384              # 文 s の軸の群
sfb[s] <- fbk[hfz[s]] for (s) in 0 .. nstz[0] if sax[s]
field ofb : or bound 32768               # 出現 o は、軸の規則が自分の軸の群の場を読む
ofb[o] <- true for (o) in 0 .. nocz[0] if osx[o] if not ohd[o] if fax[ofzx[o]] if fbk[ofzx[o]] == fbk[ohz[o]]
field oax : or bound 32768               # 出現 o は軸で安全（非単調な読みでも層を切らない）
oax[o] <- true for (o) in 0 .. nocz[0] if oxc1[o] if ofb[o] if sax[osn[o]]
oax[o] <- true for (o) in 0 .. nocz[0] if oxc0[o] if ofb[o] if sax[osn[o]]
oax[o] <- true for (o) in 0 .. nocz[0] if oxc2[o] if ofb[o] if sax[osn[o]]
field sxcy : or bound 16384              # 文 s は切り口の中に単調な輪を持つ群の規則（切り口ごとに回し直す）
sxcy[s] <- true for (s) in 0 .. nstz[0] if sax[s] if bax[sbid[s]] if bcy[sbid[s]]
field sxdn : or bound 16384              # 文 s は降りる軸の群の規則（段0 を上から回す）
sxdn[s] <- true for (s) in 0 .. nstz[0] if sax[s] if bax[sbid[s]] if bdn[sbid[s]]
# **軸の群の入口は、群より前の層で閉じていなければならない**（h01 で見つけた SILENT）。融合した一周が
# 正しいのは「n - c の切り口は閉じている」からだが、その切り口の値が **同じ層で育つ別の場**を読んでいれば、
# 一周目に読んだのは途中の値で、非単調な読み（`if w[n - 1] < 15`）がそれを見て撃った実例は取り消せない。
# だから軸の規則が群の外の場を読むときは、単調な読みでも層を一つ上げる（入口を閉じてから回る）。
field oxin : or bound 32768              # 出現 o は、軸の規則が読む群の外の場
oxin[o] <- true for (o) in 0 .. nocz[0] if osx[o] if not ohd[o] if sax[osn[o]] if not oax[o]

# ══ 成層 ═══════════════════════════════════════════════════════════
# 辺の表は要らない。**場の番号を座標にして**書き手と読み手を繋ぐ。
# 重み付き最長路がそのまま層になる —— 非単調な辺だけが +1 する。
field hasr : or bound 16384              # 文 s は規則である（頭がある）
hasr[osn[o]] <- true for (o) in 0 .. nocz[0] if ohd[o]
field hfl : max bound 16384              # 文 s の書き先の場
hfl[osn[o]] <- ofl[o] for (o) in 0 .. nocz[0] if ohd[o]
# **深さを値ではなく座標にする。** 最長路を数として持つと、成層できない源
# （自分の場を否定で読む規則）で昇り続けて止まらない。「層 k 以上にいる」
# という **or の場**にすれば、k は 0..63 の座標なので **構造で有界**である。
# 止まらない代わりに「深すぎる」と言える —— これは値では書けなかった。
field wlvl : or bound 2048 128           # 場 f を書く文が層 k 以上にいる
field lvl : or bound 16384 128            # 文 s は層 k 以上にいる
lvl[s,0] <- true for (s) in 0 .. nstz[0] if hasr[s]
wlvl[hfl[s], k] <- true for (s) in 0 .. nstz[0] for (k) in 0 .. 127 if hasr[s]
      if hfl[s] >= 0 if lvl[s,k]
lvl[osn[o], k] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 127 if oin[o]
      if not ohd[o] if not onm[o] if not oxin[o] if wlvl[ofl[o], k]
lvl[osn[o], k + 1] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 126 if oin[o]
      if not ohd[o] if onm[o] if not oax[o] if wlvl[ofl[o], k]
# 軸の群の入口（単調な読みでも）は層を一つ上げる（上の oxin）
lvl[osn[o], k + 1] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 126 if oin[o]
      if not ohd[o] if not onm[o] if oxin[o] if wlvl[ofl[o], k]
# 軸で安全な非単調な読みは層を切らない（上の「軸に沿った成層」）
lvl[osn[o], k] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 127 if oin[o]
      if not ohd[o] if onm[o] if oax[o] if wlvl[ofl[o], k]
# ただし軸の場の **土台**（軸の群でない書き手 —— 種や `s[0, j] <- j for (j) …`）は、群より前の層で閉じる（14n）
field wlvlb : or bound 2048 128          # 場 f の、軸の群でない書き手が層 k 以上にいる
wlvlb[hfl[s], k] <- true for (s) in 0 .. nstz[0] for (k) in 0 .. 127 if hasr[s]
      if hfl[s] >= 0 if not sax[s] if lvl[s,k]
lvl[osn[o], k + 1] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 126 if oin[o]
      if not ohd[o] if oax[o] if wlvlb[ofl[o], k]
# 軸の群の文は **全部同じ層**にいる（段0 で融合するので。群の中の読みは層を分けない —— 14o）
field blv : or bound 2048 128            # 群 b の文が層 k 以上にいる
blv[sfb[s], k] <- true for (s) in 0 .. nstz[0] for (k) in 0 .. 127 if sax[s] if lvl[s, k]
lvl[s, k] <- true for (s) in 0 .. nstz[0] for (k) in 0 .. 127 if sax[s] if blv[sfb[s], k]
field level : max bound 16384            # 文 s の層（＝上にいる最大の k）
level[s] <- k for (s) in 0 .. nstz[0] for (k) in 0 .. 127 if lvl[s,k]
field toodeep : or bound 8              # 層が深すぎる（＝成層できない源）
toodeep[z] <- true for (z) in 0 .. 0 for (s) in 0 .. nstz[0] if lvl[s,127]
field strata : max bound 8             # 層の数（＝答えの深さ）
strata[z] <- level[s] + 1 for (z) in 0 .. 0 for (s) in 0 .. nstz[0] if hasr[s]

print ofl
print level
print level
print strata
print toodeep

# ══ 三段目: 形の導出 ═══════════════════════════════════════════════
# ここから先は **32_shape が Python 抜きでやっていたこと**を断片で書く。
# 道具は増えない —— 語の照合・鎖・場の値が座標・比較、それだけである。

# ── 残りの語 ───────────────────────────────────────────────────────
field kwtbl : or bound 589824           # `table`
kwtbl[t] <- true for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 116 if tch[t,1] == 97 if tch[t,2] == 98
      if tch[t,3] == 108 if tch[t,4] == 101
field kwprn : or bound 589824           # `print`
kwprn[t] <- true for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 112 if tch[t,1] == 114 if tch[t,2] == 105
      if tch[t,3] == 110 if tch[t,4] == 116
field kwin : or bound 589824            # `in`
kwin[t] <- true for (t,zc) in ch if tlen[t] == 2 if not tcom[t]
      if tch[t,0] == 105 if tch[t,1] == 110
field kwbnd : or bound 589824           # `bound`
kwbnd[t] <- true for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 98 if tch[t,1] == 111 if tch[t,2] == 117
      if tch[t,3] == 110 if tch[t,4] == 100
field kwtru : or bound 589824           # `true`
kwtru[t] <- true for (t,zc) in ch if tlen[t] == 4 if not tcom[t]
      if tch[t,0] == 116 if tch[t,1] == 114 if tch[t,2] == 117
      if tch[t,3] == 101
field kwrnd : or bound 589824           # `render`
kwrnd[t] <- true for (t,zc) in ch if tlen[t] == 6 if not tcom[t]
      if tch[t,0] == 114 if tch[t,1] == 101 if tch[t,2] == 110
      if tch[t,3] == 100 if tch[t,4] == 101 if tch[t,5] == 114
# `render out` の `out` は **括弧の付かない出現**である。名前の照合は
# 出現の側にしか無いので、出現に入れる —— 文の頭でも節の中でも矢印の後ろ
# でもないので、項にもガードにも書き先にもならない（種は付かない）。
isocc[t] <- true for (t,zc) in ch if kwrnd[prevw[t]] if tkind[t] == 1
# `print x` の `x` も出現である —— 宣言が無ければ解釈実行は断る（理由 4 で言う）。
# 焼く側は print を読まないので、宣言の無い名前を黙って通していた。
isocc[t] <- true for (t,zc) in ch if kwprn[prevw[t]] if tkind[t] == 1
# **render は書いた順に全部描く**（解釈実行と同じ）。前は `rndf[0]` 一つで、二つ書くと
# 場の番号の大きい方だけが残った。k 番目の render を文の鎖で数える（八つまで）。
field srnd : or bound 16384             # 文 s は render
srnd[snum[t]] <- true for (t,zc) in ch if sbrk[t] if kwrnd[t]
field rdo : max bound 16384             # 文 s より前にある render の数
rdo[s] <- 0                 for (s) in 0 .. nstz[0]
rdo[s] <- rdo[s-1] + 1      for (s) in 1 .. nstz[0] if srnd[s-1]
rdo[s] <- rdo[s-1]          for (s) in 1 .. nstz[0] if not srnd[s-1]
field rdt : max bound 589824           # トークン t の文より前の render の数
rdt[t] <- rdo[snum[t]] for (t,zc) in ch if kwrnd[prevw[t]] if tkind[t] == 1
# **書き先の座標は一段の読みで書く** —— 33_self は旧い道（21_lex → 32_shape → 31_gen。
# test/selfbyte.py）でも焼けねばならず、旧い道は書き先の読みを一段しか知らない。
field rndf : max bound 8               # k 番目の `render` が描く場（0 起点）
rndf[rdt[t]] <- ofl[oseq[t]] - 1 for (t,zc) in ch
      if kwrnd[prevw[t]] if tkind[t] == 1 if rdt[t] <= 7

# 束の名前。**束が替えるのは join だけ** なので、ここは番号を付けるだけ
field kwmin : or bound 589824
kwmin[t] <- true for (t,zc) in ch if tlen[t] == 3 if not tcom[t]
      if tch[t,0] == 109 if tch[t,1] == 105 if tch[t,2] == 110
field kwmax : or bound 589824
kwmax[t] <- true for (t,zc) in ch if tlen[t] == 3 if not tcom[t]
      if tch[t,0] == 109 if tch[t,1] == 97 if tch[t,2] == 120
field kwor : or bound 589824
kwor[t] <- true for (t,zc) in ch if tlen[t] == 2 if not tcom[t]
      if tch[t,0] == 111 if tch[t,1] == 114
field kwflt : or bound 589824
kwflt[t] <- true for (t,zc) in ch if tlen[t] == 4 if not tcom[t]
      if tch[t,0] == 102 if tch[t,1] == 108 if tch[t,2] == 97
      if tch[t,3] == 116
field kwsum : or bound 589824
kwsum[t] <- true for (t,zc) in ch if tlen[t] == 3 if not tcom[t]
      if tch[t,0] == 115 if tch[t,1] == 117 if tch[t,2] == 109
field kwcnt : or bound 589824
kwcnt[t] <- true for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 99 if tch[t,1] == 111 if tch[t,2] == 117
      if tch[t,3] == 110 if tch[t,4] == 116

# ── 次の語（空白を跨ぐ。prevw の裏返し。**鎖は両向きに回る**）────────
field firstw : min bound 589824         # t 以上で最初の非空白トークン
firstw[t] <- t           for (t,zc) in ch if tkind[t] != 3
firstw[t] <- firstw[t+1] for (t,zc) in ch if tkind[t] == 3
field nextw : min bound 589824          # t の直後の非空白トークン
nextw[t] <- firstw[t+1]  for (t,zc) in ch
# **出現の `[` と、次元0 の添字の語は、空白を跨いで引く**（`nextw`）。前は `[` を出現の
# 一つ後ろ（t+1）、添字を二つ後ろ（t+2）と **数で** 引いていた —— `f[ i ]`・`g[ 1 ]`・
# `n[ 0 ]` では添字が空白に当たり、座標の語の数えが理由 8 で断っていた（解釈実行は
# 受け取る。2026-09-20、偽物の数え上げに二次元の種を混ぜて見つけた）。
field obr : max bound 589824            # 出現 t の `[`（`[` の付かない出現 —— render / print —— には無い）
obr[t] <- nextw[t] for (t,zc) in ch if isocc[t] if tch[nextw[t], 0] == 91
field ob1 : max bound 589824            # 出現 t の次元0 の添字の語（`[` の次の、空白でない語）
ob1[t] <- nextw[obr[t]] for (t,zc) in ch if isocc[t]

# ── 数を読む。**桁を積むのは掛け算である** ─────────────────────────
field digv : max bound 589824           # 文字 i の数字の値
digv[i] <- c - 48 for (i,c) in ch if digit[i]
field numa : max bound 589824           # 18 桁までの数（その字句の先頭から i まで）
numa[i] <- digv[i]                  for (i,c) in ch if digit[i] if brk[i]
numa[i] <- numa[i-1] * 10 + digv[i] for (i,c) in ch if i >= 1 if digit[i]
      if not brk[i] if dpos[i] <= 17
# **桁は 64 ビットに収まる所まで積む。** 前は桁を際限なく積み、19 桁を越える数で焼き手
# そのものが `numv` で溢れて終了コード 3 で止まった（源のどの行かを言えない）。18 桁
# （10^18 未満）は必ず収まる。19 桁目は、手前の 18 桁が 922337203685477580 より小さいか、
# 等しくて 19 桁目が 7 以下のときだけ積む（2^63 - 1 まで）。収まらない数は `dlong` —— 焼く側が
# 理由 C で言う。上限は 32 ビットの即値に収まらないので積で作る（焼き手が自分を焼ける形）。
field dpos : max bound 589824           # 数の字句の中の桁の位置（0 起点）
dpos[i] <- 0                        for (i,c) in ch if digit[i] if brk[i]
dpos[i] <- dpos[i-1] + 1            for (i,c) in ch if i >= 1 if digit[i] if not brk[i]
field n18 : max bound 1                 # 922337203685477580
n18[z] <- 922337203 * 1000000000 + 685477580   for (z) in 0 .. 0
field numv : max bound 589824           # そのトークンの先頭から i までの数
numv[i] <- numa[i]                  for (i,c) in ch if digit[i] if dpos[i] <= 17
numv[i] <- numa[i-1] * 10 + digv[i] for (i,c) in ch if i >= 1 if digit[i] if dpos[i] == 18
      if numa[i-1] < n18[0]
numv[i] <- numa[i-1] * 10 + digv[i] for (i,c) in ch if i >= 1 if digit[i] if dpos[i] == 18
      if numa[i-1] == n18[0] if digv[i] <= 7
field dlong : or bound 589824           # 64 ビットに収まらない数の字句
dlong[tnum[i]] <- true              for (i,c) in ch if digit[i] if dpos[i] >= 19
dlong[tnum[i]] <- true              for (i,c) in ch if i >= 1 if digit[i] if dpos[i] == 18
      if numa[i-1] > n18[0]
dlong[tnum[i]] <- true              for (i,c) in ch if i >= 1 if digit[i] if dpos[i] == 18
      if numa[i-1] == n18[0] if digv[i] >= 8
field tval : max bound 589824           # 整数トークンの値
# 収まらない数は 1 と読む（焼かないので値は使われない。**別の理由が先に立たないように**
# —— 18 桁で切った値で読むと、割る数なら「二のべきでない」と嘘の理由が出た）
tval[tnum[i]] <- numv[i] for (i,c) in ch if digit[i] if not dlong[tnum[i]]
tval[t] <- 1             for (t,zc) in ch if dlong[t]

# ── 宣言の中身: `field 名 : 束 bound 広さ 広さ` ─────────────────────
field fdno : max bound 589824           # 宣言のトークン → 場番号（0 起点）
fdno[t] <- dseq[t] - 1 for (t,zc) in ch if isdcl[t]
field nfdz : max bound 1                # 場の最後の番号（0 起点）
nfdz[z] <- fdno[t] for (t,zc) in ch for (z) in 0 .. 0 if isdcl[t]
field latt : max bound 589824           # 宣言 t の束のトークン（名 → `:` → 束）
latt[t] <- nextw[nextw[t]] for (t,zc) in ch if isdcl[t]
field flatt : max bound 2048            # 場 f の束（1 min/2 max/3 or/6 flat/8 sum/9 count）
flatt[fdno[t]] <- 1 for (t,zc) in ch if isdcl[t] if kwmin[latt[t]]
flatt[fdno[t]] <- 2 for (t,zc) in ch if isdcl[t] if kwmax[latt[t]]
flatt[fdno[t]] <- 3 for (t,zc) in ch if isdcl[t] if kwor[latt[t]]
flatt[fdno[t]] <- 6 for (t,zc) in ch if isdcl[t] if kwflt[latt[t]]
flatt[fdno[t]] <- 8 for (t,zc) in ch if isdcl[t] if kwsum[latt[t]]
flatt[fdno[t]] <- 9 for (t,zc) in ch if isdcl[t] if kwcnt[latt[t]]

field bndt : max bound 589824           # 束の次のトークン（`bound` かどうか）
bndt[t] <- nextw[latt[t]] for (t,zc) in ch if isdcl[t]
field bw1 : max bound 589824            # 一つ目の広さのトークン
bw1[t] <- nextw[bndt[t]] for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
field bw2 : max bound 589824            # 二つ目の広さのトークン
bw2[t] <- nextw[bw1[t]] for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
# **宣言があるなら、それが広さである。** 既定の 64 を max で混ぜると
# `bound 4` が 64 升になり、2次元の畳みの掛け数まで狂う。
field fwid : max bound 2048             # 場 f の次元0 の広さ（宣言と使われ方が言う）
fwid[fdno[t]] <- 64 for (t,zc) in ch if isdcl[t] if not kwbnd[bndt[t]]
fwid[fdno[t]] <- tval[bw1[t]] for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
field hasw2 : or bound 2048             # 次元1 の広さを書いたか
hasw2[fdno[t]] <- true for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
      if tline[bw2[t]] == tline[t]
field fwid2 : max bound 2048            # 次元1 の広さ（同じ行に二つ目があれば）
fwid2[fdno[t]] <- tval[bw2[t]] for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
      if tline[bw2[t]] == tline[t]
# 書かなければ次元0 と同じ —— **種の座標を畳む掛け数はここにしかない**
fwid2[f] <- fwid[f] for (f) in 0 .. nfdz[0] if not hasw2[f]
field bw3 : max bound 589824            # 三つ目の広さのトークン
bw3[t] <- nextw[bw2[t]] for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]] if tline[bw2[t]] == tline[t]
field hasw3 : or bound 2048             # 次元2 の広さを書いたか
hasw3[fdno[t]] <- true for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
      if tline[bw3[t]] == tline[t] if isnum[bw3[t]]
field fwid3 : max bound 2048            # 次元2 の広さ（同じ行に三つ目があれば。無ければ次元0 と同じ）
fwid3[fdno[t]] <- tval[bw3[t]] for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
      if tline[bw3[t]] == tline[t] if isnum[bw3[t]]
fwid3[f] <- fwid[f] for (f) in 0 .. nfdz[0] if not hasw3[f]

# ── 頭の次数。**区切りは矢印より前の深さ1 の `,`** ──────────────────
field iscom : or bound 589824           # `,` のトークン
iscom[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 44
field arrowt : max bound 16384           # 文 s の `<-` の位置
arrowt[snum[t]] <- t for (t,zc) in ch if arrw[t]
field h2d : or bound 16384               # 文 s の頭は2次元
h2d[snum[t]] <- true for (t,zc) in ch if iscom[t] if tdep[t] == 1
      if t < arrowt[snum[t]]
field hfz : max bound 16384              # 文 s の書き先の場（0 起点）
hfz[s] <- hfl[s] - 1 for (s) in 0 .. nstz[0] if hasr[s]
field farr : max bound 2048             # 場 f の次数（**使われ方**が言う）
farr[hfz[s]] <- 1 for (s) in 0 .. nstz[0] if hasr[s]
farr[hfz[s]] <- 2 for (s) in 0 .. nstz[0] if hasr[s] if h2d[s]
# **読まれるだけの場も、宣言だけの場も次数を持つ。** 次数を書き先だけから取って
# いたので、規則の無い場は次数が ⊥ で置き場の大きさも ⊥ になり、置き場の鎖
# （`foff`）がそこで切れて、後ろの場がみな番地を失った —— 宣言を一行足しただけで
# 焼けた実行ファイルは segfault した（`test/mutate.py` が撒いて出した）。
farr[fdno[t]] <- 1 for (t,zc) in ch if isdcl[t]
farr[ixcf[t]] <- 2 for (t,zc) in ch if isocc[t] if iscom[d0cm[t]]
farr[ixcf[t]] <- 3 for (t,zc) in ch if isocc[t] if iscom[d1cm[t]]

# ── 表の行。**行も列も鎖である**（`(` で行が進み、`,` で列が進む）────
field isnum : or bound 589824           # 数のトークン（英数字は数で始まらない）
isnum[t] <- true for (t,zc) in ch if tch[t,0] >= 48 if tch[t,0] <= 57
field isopn : or bound 589824           # `(`
isopn[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 40
field istb : or bound 16384              # 文 s は表の定義
istb[snum[t]] <- true for (t,zc) in ch if kwtbl[t] if sbrk[t]
field rowbk : or bound 589824           # 行の切れ目（深さ0 の `(`）
rowbk[t] <- true for (t,zc) in ch if isopn[t] if tdep[t] == 0
field colbk : or bound 589824           # 列の切れ目（深さ1 の `,`）
colbk[t] <- true for (t,zc) in ch if iscom[t] if tdep[t] == 1
field rowc : max bound 589824           # トークン t の属する行（文の中で 1 起点）
rowc[t] <- 0             for (t,zc) in ch if sbrk[t]
rowc[t] <- rowc[t-1] + 1 for (t,zc) in ch if t >= 1 if not sbrk[t] if rowbk[t]
rowc[t] <- rowc[t-1]     for (t,zc) in ch if t >= 1 if not sbrk[t] if not rowbk[t]
field colc : max bound 589824           # トークン t の属する列
colc[t] <- 0             for (t,zc) in ch if sbrk[t]
colc[t] <- 0             for (t,zc) in ch if t >= 1 if rowbk[t]
colc[t] <- colc[t-1] + 1 for (t,zc) in ch if t >= 1 if colbk[t]
colc[t] <- colc[t-1]     for (t,zc) in ch if t >= 1 if not sbrk[t] if not rowbk[t]
      if not colbk[t]
field tbrow : max bound 16384 8         # 行 r の列 c の値（表は一つに均す）
tbrow[rowc[t], colc[t]] <- tval[t] for (t,zc) in ch if isnum[t]
      if istb[snum[t]] if tdep[t] == 1 if colc[t] <= 7 if rowc[t] <= 8191
# （**面の内側だけを書く。** 九列の表を書くと `tbrow[r, 8]` が面の外へ出て、焼き手そのものが
# 終了コード 6「入力が大きすぎる」—— 嘘の理由 —— で止まった。表の中身は焼き込まない
# ので、ここは読むためだけの面である。列の上限は焼く側が数えて言う。）
# **表は一つだけ。** 二つ書かれたら断片の外である —— 黙って混ぜずに数える
# （数え方は集約ではなく鎖。区間の集約はまだ焼けない）。
field ctb : max bound 16384              # ここまでの表の数
ctb[0] <- 0
ctb[z] <- 1                for (z) in 0 .. 0 if istb[0]
ctb[s] <- ctb[s-1]         for (s) in 1 .. nstz[0] if not istb[s]
ctb[s] <- ctb[s-1] + 1     for (s) in 1 .. nstz[0] if istb[s]
field ntb : max bound 1                 # 表の数
ntb[z] <- ctb[s]           for (s) in 0 .. nstz[0] for (z) in 0 .. 0
field hastb : or bound 1                # 表が一つはある
hastb[z] <- true           for (z) in 0 .. 0 if ntb[0] >= 1

field ncol : max bound 8               # 列の数（頭の添字は **変数**。定数だと座標が出ない）
# **表のループは一番外側に置く。** 生成器は rcx を 0 番のループの行に使うので、
# 表が 1 番目にいると、列を rcx（＝別のループの計数器）から引いてしまう。
ncol[z] <- colc[t] + 1 for (t,zc) in ch for (z) in 0 .. 0 if isnum[t]
      if istb[snum[t]] if tdep[t] == 1

# ── 種。**`for` が無い矢印の文が種である** ─────────────────────────
field hasfor : or bound 16384            # 文 s に for 節がある
hasfor[snum[t]] <- true for (t,zc) in ch if kwin[t]
field isseed : or bound 16384
isseed[s] <- true for (s) in 0 .. nstz[0] if arrowt[s] >= 0 if not hasfor[s]
field otok : max bound 32768             # 出現 o のトークン
otok[oseq[t]] <- t for (t,zc) in ch if isocc[t]
field hotok : max bound 16384            # 文 s の頭のトークン
hotok[osn[o]] <- otok[o] for (o) in 0 .. nocz[0] if ohd[o]
field sedf : max bound 16384             # 種の場（0 起点）
sedf[s] <- hfz[s] for (s) in 0 .. nstz[0] if isseed[s]
# 種の座標の語も **空白を跨いで引く**（前は頭の語から 2 つ目・4 つ目と数で引き、
# `q[0, 1] <- 2` の `1` が空白に当たって理由 8 と断っていた）
field sdt0 : max bound 16384             # 種 s の次元0 の添字の語
sdt0[s] <- ob1[hotok[s]] for (s) in 0 .. nstz[0] if isseed[s]
field sdt1 : max bound 16384             # その次の語（`]` か `,`）
sdt1[s] <- nextw[sdt0[s]] for (s) in 0 .. nstz[0] if isseed[s]
field sdt2 : max bound 16384             # 次元1 の添字の語
sdt2[s] <- nextw[sdt1[s]] for (s) in 0 .. nstz[0] if isseed[s]
field sdt3 : max bound 16384             # その次の語（`]`）
sdt3[s] <- nextw[sdt2[s]] for (s) in 0 .. nstz[0] if isseed[s]
field sedc : max bound 16384             # 種の座標
sedc[s] <- tval[sdt0[s]] for (s) in 0 .. nstz[0] if isseed[s] if not h2d[s]
# 2次元の種は `c1 * 次元1の広さ + c2` に畳む（`q[3,0]`）
field h3d : or bound 16384               # 文 s の頭は3次元（頭の出現に次元2 がある）
h3d[osn[o]] <- true for (o) in 0 .. nocz[0] if ohd[o] if has2[o]
sedc[s] <- tval[sdt0[s]] * fwid2[hfz[s]] + tval[sdt2[s]]
      for (s) in 0 .. nstz[0] if isseed[s] if h2d[s] if not h3d[s]
field sdt4 : max bound 16384             # 次元2 の添字の語（sdt3 が `,` のとき）
sdt4[s] <- nextw[sdt3[s]] for (s) in 0 .. nstz[0] if isseed[s] if h3d[s]
# 3次元の種は `(c0 * 広さ1 + c1) * 広さ2 + c2`
sedc[s] <- tval[sdt0[s]] * fwid2[hfz[s]] * fwid3[hfz[s]] + tval[sdt2[s]] * fwid3[hfz[s]] + tval[sdt4[s]]
      for (s) in 0 .. nstz[0] if isseed[s] if h3d[s]
field sedvt : max bound 16384            # 種の値のトークン
sedvt[s] <- nextw[arrowt[s] + 1] for (s) in 0 .. nstz[0] if isseed[s]
field sedv : max bound 16384             # 種の値（`true` は 1）
# **count の種は 1 である**（寄与が一つある、というだけ —— 値は数えない）。種は升に
# 値を直に置くので、`d[0] <- 0`（d は count）が 0、つまり ⊥ を置いていた。解釈実行は
# 1 と言う（`test/mutate.py` が束を count に替えて出した）。
field scnt : or bound 16384              # 文 s の書き先は count
scnt[s] <- true for (s) in 0 .. nstz[0] if hasr[s] if flatt[hfz[s]] == 9
sedv[s] <- tval[sedvt[s]] for (s) in 0 .. nstz[0] if isseed[s] if not scnt[s]
sedv[s] <- 1 for (s) in 0 .. nstz[0] if isseed[s] if kwtru[sedvt[s]] if not scnt[s]
sedv[s] <- 1 for (s) in 0 .. nstz[0] if isseed[s] if scnt[s]
# **負の数の種**（`f[1] <- -3`）。解釈実行は単項の `-` を `0 - 3` と読む。字句では `-` と `3` の
# 二語で、矢印の次の語は `-` —— 前は「種の値は数か true 一つ」（fold.lx）が理由 8 で断っていた。
# 下ろしが表の負の升（`(1,-3)`）を種にするようになって、自由に書いた本が当たった。
# `tval` は数の語にしか無いので、上の `tval[sedvt]` の規則は `-` の種では黙る（max が混ざらない）。
# **読みは二段まで**（`isnum[nextw[sedvt[s]]]` と書かない）。自己検査の古い道（21_lex → 32_shape → 31_gen。
# test/selfbyte.py）は三段の読みを導けず、ガードが一つ導けないまま「箱が足りない」と断った（14j の一周で見つけた）
field sedv2 : max bound 16384            # 種 s の値の二つ目の語
sedv2[s] <- nextw[sedvt[s]]  for (s) in 0 .. nstz[0] if isseed[s]
field sneg : or bound 16384              # 種 s の値は `-` 数
sneg[s] <- true for (s) in 0 .. nstz[0] if isseed[s] if ismin[sedvt[s]] if isnum[sedv2[s]]
field sedvn : max bound 16384            # 種 s の値の **最後の**語（ふつうは sedvt、`-` 数なら数の語）
sedvn[s] <- sedvt[s]         for (s) in 0 .. nstz[0] if isseed[s] if not sneg[s]
sedvn[s] <- sedv2[s]         for (s) in 0 .. nstz[0] if sneg[s]
# 印に届く負の種（-2147483647 以下）は **値にしない**。sedv も sdv も max の場で、そこへ置くと
# 焼き手（と下ろし）**自身**の見張りが止まる（終了コード 4 —— 行も理由も言えない）。語で見て断る（fold.lx、理由 D）。
sedv[s] <- 0 - tval[sedvn[s]] for (s) in 0 .. nstz[0] if sneg[s] if not scnt[s] if tval[sedvn[s]] <= 2147483646
# 種の値が **ある**（数・`true`・`-` 数・count）。fold.lx の `sdv` は max の場で、値の無い種にも
# 0 を置いて ⊥ を避けていた —— それを全部の種に置くと、負の種が 0 に負ける（max(0, -7) = 0）。
# 表の負の升 → 種 → 和で、-7 の寄与が黙って消えた（下ろしの s2 で見つけた）。0 は値の無い種にだけ。
field svok : or bound 16384
svok[s] <- true for (s) in 0 .. nstz[0] if isseed[s] if isnum[sedvt[s]]
svok[s] <- true for (s) in 0 .. nstz[0] if isseed[s] if kwtru[sedvt[s]]
svok[s] <- true for (s) in 0 .. nstz[0] if sneg[s]
svok[s] <- true for (s) in 0 .. nstz[0] if isseed[s] if scnt[s]

# ── 変数はどの列か。**束縛点の座標がそのまま答えである** ────────────
# `for (i,j,w) in edge` の i,j,w は組の 0/1/2 番目。使う側はその綴りを持つ
# だけなので、**綴りを比べて束縛点を引く**（気づき24・26 と同じ手）。
# 位置ごとに開くのは、`f[g[h[t],p],k]` が三重になって座標にできないから ——
# **座標は二段まで**、というのが機械の側の事実である。
field infor : or bound 589824           # `for` から `in` までの間
infor[t] <- true for (t,zc) in ch if kwfor[t]
infor[t] <- true for (t,zc) in ch if t >= 1 if infor[t-1] if not kwin[t]
field isbind : or bound 589824          # 束縛のトークン
isbind[t] <- true for (t,zc) in ch if infor[t] if tdep[t] == 1
      if tkind[t] == 1 if not isnum[t]
field lseq : max bound 589824           # 文の中の for 節の番号（1 起点の鎖）
lseq[t] <- 0             for (t,zc) in ch if sbrk[t]
lseq[t] <- lseq[t-1] + 1 for (t,zc) in ch if t >= 1 if kwfor[t] if not sbrk[t]
lseq[t] <- lseq[t-1]     for (t,zc) in ch if t >= 1 if not kwfor[t] if not sbrk[t]
field bnum : max bound 589824           # 文の中の束縛の通し番号
bnum[t] <- 0             for (t,zc) in ch if sbrk[t]
bnum[t] <- bnum[t-1] + 1 for (t,zc) in ch if t >= 1 if isbind[t-1] if not sbrk[t]
bnum[t] <- bnum[t-1]     for (t,zc) in ch if t >= 1 if not isbind[t-1] if not sbrk[t]
# **束縛の照合は鍵で比べる**（気づき42 を変数に）。前は束縛ごとに「文の n 番目の束縛」
# （bp / ub）と「綴りが違う」「同じ」（vd / vm）の四枚を六組持っていた —— 升で比べるのは、
# 比べるものに名前を付けていないことの言い換えである。**六つで閉じていた根拠は無く**、
# 下ろしは表の列を全部束縛してからループを重ねるので六つを越え、下ろしの前段だけが
# 十まで足していた（同じ判断を二箇所に。気づき34）。入れ子が八重まで焼けるようになった日に
# 焼き手の前段も六つでは足りなくなった。
# 鍵は字の鎖（同じ語の中で 128 倍して足す。字は 1..127 なので長くなるほど大きく、max が
# 最後の鍵を残す）。八文字で止めるのは前と同じ（九文字目からは長さで分ける）。
field ck : max bound 589824             # 字 i までの語の鍵（語の先頭から）
ck[i] <- c                     for (i,c) in ch if cpos[i] == 0
ck[i] <- ck[i-1] * 128 + c     for (i,c) in ch if i >= 1 if cpos[i] >= 1 if cpos[i] <= 7
field tkey : max bound 589824           # トークン t の鍵（1〜8 文字目）
tkey[tnum[i]] <- ck[i]         for (i,c) in ch if cpos[i] <= 7
field bnt : max bound 16384 10          # 文 s の n 番目の束縛のトークン（十まで）
bnt[snum[t], bnum[t]] <- t        for (t,zc) in ch if isbind[t] if bnum[t] <= 9
field bky : max bound 16384 10          # その鍵
bky[snum[t], bnum[t]] <- tkey[t]  for (t,zc) in ch if isbind[t] if bnum[t] <= 9
field bln : max bound 16384 10          # その長さ
bln[snum[t], bnum[t]] <- tlen[t]  for (t,zc) in ch if isbind[t] if bnum[t] <= 9
field vbnd : max bound 589824           # トークン t が指す束縛のトークン
vbnd[t] <- bnt[snum[t], n]   for (t,zc) in ch for (n) in 0 .. 9 if tkind[t] == 1
      if tkey[t] == bky[snum[t], n] if tlen[t] == bln[snum[t], n]
field vcolz : max bound 589824          # その変数の列（＝組の位置）
vcolz[t] <- colc[vbnd[t]] for (t,zc) in ch
field vlp : max bound 589824            # その変数の for 節の番号（1 起点）
vlp[t] <- lseq[vbnd[t]] for (t,zc) in ch
field vlpz : max bound 589824           # 同じもの（0 起点。表の行はこちら）
vlpz[t] <- vlp[t] - 1 for (t,zc) in ch

print vcolz
print vlp

# ══ 規則・ループ・項の行 ═══════════════════════════════════════════
field isrec : or bound 16384             # 文 s は規則（矢印があり for がある）
isrec[s] <- true for (s) in 0 .. nstz[0] if arrowt[s] >= 0 if hasfor[s]
field rlt : max bound 16384              # 書き先の束
rlt[s] <- flatt[hfz[s]] for (s) in 0 .. nstz[0] if isrec[s]
field rst : max bound 16384              # 層（成層はもう出してある）
rst[s] <- level[s] for (s) in 0 .. nstz[0] if isrec[s]
field rarr : max bound 16384             # 表の組の長さ（最大の位置 + 1）
rarr[snum[t]] <- colc[t] + 1 for (t,zc) in ch if isbind[t]

# ── ループ。`in` の次が数なら区間、名前なら表 ───────────────────────
field lz : max bound 589824             # for 節の番号（0 起点）
# **for の無い `in` は番号 -1 を持つ。** `mf[i] <- 1 (i) in 0 .. 3` を焼くと `lkd[s, -1]` へ書き、
# 焼き手そのものが終了コード 6（「入力が大きすぎる」—— 嘘の理由）で止まった。九つ目の for も
# 面の外（8）。書く所は 0..7 に守る —— 形の崩れは値の式の語の数えで理由 8 と言う。
lz[t] <- lseq[t] - 1 for (t,zc) in ch
field int1 : max bound 589824           # `in` の次の語（下端 or 表の名）
int1[t] <- nextw[t] for (t,zc) in ch if kwin[t]
# **区間かどうかは `..` が言う**（13i）。前は「`in` の次が数なら区間」で、下端は数一つに限られ
# ていた（`for (j) in i + 1 .. n` は表の名と読まれて断られた）。節の中の最初の `..` を探す。
field cdot : min bound 589824           # 大域の節 c の最初の `..` の一つ目の `.`（深さ 0）
cdot[gcl[u]] <- u for (u,zc) in ch if tlen[u] == 1 if tch[u,0] == 46 if tdep[u] == 0 if not tcom[u]
      if tch[nextw[u],0] == 46
field irng : or bound 589824            # `in` は区間を始める（その節に `..` がある）
irng[t] <- true for (t,zc) in ch if kwin[t] if cdot[gcl[t]] > t
field int2 : max bound 589824           # 一つ目の `.`
int2[t] <- cdot[gcl[t]] for (t,zc) in ch if kwin[t] if irng[t]
field int3 : max bound 589824           # 二つ目の `.`
int3[t] <- nextw[int2[t]] for (t,zc) in ch if kwin[t]
field int4 : max bound 589824           # 上端
int4[t] <- nextw[int3[t]] for (t,zc) in ch if kwin[t]
field lkd : max bound 16384 8            # 0 表 / 1 区間（上端が定数）/ 2 上端が場
# 表のループは `in` の次に語があるときだけ（行の終わりの `in` は ⊥ のまま —— 前段が断る。
# `not irng` だけで 0 を置くと、名の無い `in` が表のループになって走り出した）
lkd[snum[t], lz[t]] <- 0 for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if not irng[t]
      if tkind[int1[t]] >= 1
lkd[snum[t], lz[t]] <- 1 for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if irng[t]
      if isnum[int4[t]]
# **区間の端は場でもよい**（`for (n) in 0 .. nins[0]`）—— 記述が空間を決める
lkd[snum[t], lz[t]] <- 2 for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if irng[t]
      if isocc[int4[t]]
field llo2 : max bound 16384 8           # 区間の下端（数のとき）
llo2[snum[t], lz[t]] <- tval[int1[t]] for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t]
      if irng[t] if isnum[int1[t]]
# **負の数の下端**（`for (j) in -1 .. 3`。14k）。字句では `-` と `1` の二語。区間は符号つきで比べる
# （13i）ので、焼く側は下端を負の即値にするだけでよい。動的計画法の縁（`d[-1, j]` を `-1 ..` で回す）に要る
field in1n : max bound 589824             # 下端の二つ目の語（読みは二段まで —— 上の sedv2 の註）
in1n[t] <- nextw[int1[t]] for (t,zc) in ch if kwin[t] if irng[t]
field in1nn : max bound 589824            # 三つ目の語
in1nn[t] <- nextw[in1n[t]] for (t,zc) in ch if kwin[t] if irng[t]
field ilng : or bound 589824             # 下端は `-` 数
ilng[t] <- true for (t,zc) in ch if kwin[t] if irng[t] if ismin[int1[t]] if isnum[in1n[t]]
      if in1nn[t] == int2[t]
llo2[snum[t], lz[t]] <- 0 - tval[in1n[t]] for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t]
      if ilng[t]
field ilngm : or bound 589824            # その `-` の語（for 節の「括弧の外の演算子」から除く —— fold.lx）
ilngm[int1[t]] <- true for (t,zc) in ch if ilng[t]
field llhv : or bound 16384 8            # 文 s のループ L の下端は数（llo2 に値がある）—— fold.lx の既定の 0 は
llhv[snum[t], lz[t]] <- true for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if irng[t] if isnum[int1[t]]
llhv[snum[t], lz[t]] <- true for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if ilng[t]
# **下端の種**（13i）: 0 数 / 1 `(f[数])` / 2 `(f[外の区間の変数])` / 3 裸の外の区間の変数（`i ..`）。
# 解釈実行の文法では、`in` の次が **名前で `..` が続かない** なら表の名である（`in lo[0] .. 9` は断られる）。
# だから場の読みの下端は **丸括弧で包む**（`in (lo[0]) .. 9`）。名前は `..` が直に続くときだけ下端になる。
# 式の下端は下ろしが `_g` に持ち上げる（丸括弧の中身を持ち上げ、裸の式は丸括弧つきの参照にする）。
# 形が崩れていれば fold.lx が断る（理由 8）。
field ilo : max bound 589824             # 下端の読みの出現（`(f[x])` の f）
# （丸括弧の次の語。出現かどうかは使う所で見る —— `isocc[nextw[int1[t]]]` は三段の読みになる）
ilo[t] <- nextw[int1[t]] for (t,zc) in ch if kwin[t] if irng[t] if isopn[int1[t]]
field ilb : max bound 589824             # 下端の出現の添字のトークン
ilb[t] <- ob1[ilo[t]] for (t,zc) in ch if kwin[t] if irng[t] if ilo[t] >= 0
field llk2 : max bound 16384 8           # 下端の種
llk2[snum[t], lz[t]] <- 0 for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if irng[t]
llk2[snum[t], lz[t]] <- 1 for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if irng[t]
      if ilo[t] >= 0 if isocc[ilo[t]] if isnum[ilb[t]]
llk2[snum[t], lz[t]] <- 2 for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if irng[t]
      if ilo[t] >= 0 if isocc[ilo[t]] if not isnum[ilb[t]] if tkind[ilb[t]] == 1
llk2[snum[t], lz[t]] <- 3 for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if irng[t]
      if tkind[int1[t]] == 1 if not isnum[int1[t]] if nextw[int1[t]] == int2[t]
field llf2 : max bound 16384 8           # 下端の場（種1/2。出現の場 `ixcf` を引く —— 三段の読みを書かない）
llf2[snum[t], lz[t]] <- ixcf[ilo[t]] for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t]
      if irng[t] if ilo[t] >= 0
field ivl2 : max bound 589824            # 下端の変数のループ番号（種2 は添字、種3 は下端そのもの）
ivl2[t] <- vlpz[ilb[t]] for (t,zc) in ch if kwin[t] if irng[t] if ilo[t] >= 0
      if not isnum[ilb[t]] if tkind[ilb[t]] == 1
ivl2[t] <- vlpz[int1[t]] for (t,zc) in ch if kwin[t] if irng[t]
      if tkind[int1[t]] == 1 if not isnum[int1[t]] if nextw[int1[t]] == int2[t]
field llc2 : max bound 16384 8           # 下端の座標（種1）/ 変数のループ番号（種2/3）
llc2[snum[t], lz[t]] <- tval[ilb[t]] for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t]
      if irng[t] if ilo[t] >= 0 if isnum[ilb[t]]
llc2[snum[t], lz[t]] <- ivl2[t] for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t]
      if irng[t] if ivl2[t] >= 0
# ── 計数器は負にならないか（14f）─────────────────────────────────────
# 解釈実行は `x * y` の y が **規則の束縛の上で 0 以上**だと証せれば単調と読む（`_nonneg`: 束縛を数えて
# 最小を見る。ただし束縛が 20,000 を超えると数えずに証さない）。焼き手は同じことを **区間の端だけで**言う:
# 文のループが全部「数一つ .. 数一つ」の区間で、広さの積が 2^14 = 16,384 以下（20,000 の手前 —— 積は
# 二の対数の和で言う。掛けると八重の積が 64 ビットを越え、頭を打たせる比較は自分の鎖と輪になる）なら、
# 解釈実行も束縛を数え切り、下端が数（0 以上）の計数器の最小は下端である。表のループがあれば言わない
# （行の数は焼くときに分からない —— 下ろした本では区間になる）。**控えめな側にだけ倒す**: 焼き手が
# 単調と読んで解釈実行が読まなければ、解釈実行が断る本に焼き手が答えてしまう。
field i4n : max bound 589824            # 区間の上端の次の語
i4n[t] <- nextw[int4[t]] for (t,zc) in ch if kwin[t] if irng[t]
field i4e : or bound 589824             # 上端は数一つ
i4e[t] <- true for (t,zc) in ch if kwin[t] if irng[t] if isnum[int4[t]] if cbrk[i4n[t]]
i4e[t] <- true for (t,zc) in ch if kwin[t] if irng[t] if isnum[int4[t]] if tcom[i4n[t]]
i4e[t] <- true for (t,zc) in ch if kwin[t] if irng[t] if isnum[int4[t]] if snum[i4n[t]] != snum[t]
# **上端がファイルの最後の語でも「数一つ」である。** 上の三つは「上端の **次の語** が何か」で言う
# —— 最後の文では次の語が無い（`nextw` が ⊥）ので三つとも黙り、最後の文の計数器だけが
# 負になりうると読まれていた（accept の「計数器を掛ける再帰（通る）」が断られて見つけた）。
# 終わりは「次が無い」ではなく **最後の語の番号** で言う（無いことは単調な規則では書けない）。
field wend : max bound 1                # 最後の非空白トークン
wend[z] <- t for (t,zc) in ch for (z) in 0 .. 0 if tkind[t] != 3
i4e[t] <- true for (t,zc) in ch if kwin[t] if irng[t] if isnum[int4[t]] if int4[t] == wend[0]
field i1e : or bound 589824             # 下端は数一つ（`..` が直に続く）
i1e[t] <- true for (t,zc) in ch if kwin[t] if irng[t] if isnum[int1[t]] if nextw[int1[t]] == int2[t]
field lpos : or bound 16384 8           # 文 s のループ L の計数器は負にならない（下端が数一つ）
lpos[snum[t], lz[t]] <- true for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if i1e[t]
field lpwd : max bound 16384 8           # 文 s のループ L の広さ（数 .. 数 の区間。空なら 0）
lpwd[snum[t], lz[t]] <- tval[int4[t]] - tval[int1[t]] + 1   for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7
      if i1e[t] if i4e[t] if tval[int4[t]] >= tval[int1[t]]
lpwd[snum[t], lz[t]] <- 0   for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7
      if i1e[t] if i4e[t] if tval[int4[t]] < tval[int1[t]]
field pw2 : max bound 32                # 2^k
pw2[0] <- 1
pw2[k] <- pw2[k-1] * 2   for (k) in 1 .. 23
field lgw : min bound 16384 8           # その広さの二の対数（切り上げ。2^23 を越える広さは持たない）
lgw[s, l] <- k   for (s) in 0 .. nstz[0] for (l) in 0 .. 7 for (k) in 0 .. 23 if lpwd[s, l] <= pw2[k]
field lgs : max bound 16384 8           # ループ 0..L の広さの二の対数の和（鎖 —— 全部が数の区間の間だけ続く）
lgs[s, 0] <- lgw[s, 0]   for (s) in 0 .. nstz[0]
lgs[s, l] <- lgs[s, l-1] + lgw[s, l]   for (s) in 0 .. nstz[0] for (l) in 1 .. 7
field lnf : max bound 16384             # 文 s の最後のループの番号
lnf[snum[t]] <- lz[t]   for (t,zc) in ch if kwin[t] if lz[t] >= 0 if lz[t] <= 7
field lpok : or bound 16384             # 文 s の束縛は数え切れる（全部が数の区間で、積が 2^14 以下）
lpok[s] <- true   for (s) in 0 .. nstz[0] if lgs[s, lnf[s]] <= 14
field cnn : or bound 589824             # 語 t は負にならない計数器
cnn[t] <- true for (t,zc) in ch if tkind[t] == 1 if not isnum[t] if vbnd[t] >= 0
      if lkd[snum[t], vlpz[t]] >= 1 if lpos[snum[t], vlpz[t]] if lpok[snum[t]]
field lhi2 : max bound 16384 8           # 区間の上端（定数のとき）
lhi2[snum[t], lz[t]] <- tval[int4[t]] for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t]
      if irng[t] if isnum[int4[t]]
field lbf2 : max bound 16384 8           # 上端の場（種2）
# 上端の場は出現の場 `ixcf` を引く（前は `ofl[oseq[…]]` の三段を `oint4` で割っていた —— 升を一枚
# 使っていた。下ろしの置き場が 2 GB の手前に来ているので、既にある名前を使う）
lbf2[snum[t], lz[t]] <- ixcf[int4[t]] for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t]
      if irng[t] if isocc[int4[t]]
# **⊥ から座標を作らない**（気づき27 の座標側）—— 先に「あるとき」だけの
# 場に置いてから引く。`int4[t] + 2` は int4 が ⊥ だと桁が溢れる。
field int4b : max bound 589824           # 上端の場の添字のトークン（空白を跨ぐ）
int4b[t] <- ob1[int4[t]] for (t,zc) in ch if kwin[t]
      if irng[t] if isocc[int4[t]]
field lbc2 : max bound 16384 8           # 上端の座標（種2）/ 添字の変数のループ番号（種3）
lbc2[snum[t], lz[t]] <- tval[int4b[t]] for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t]
      if irng[t] if isocc[int4[t]]
# **種3: 上端の添字が外の変数**（`for (j) in 0 .. len[i]`）。反復空間は箱ではなく半空間で
# 切られる —— 焼く側は入るたびに上端を読み直す（31_gen の種3）。外の区間の変数かどうかは
# fold.lx が見る（ここで lkd を読んで決めると、lkd が自分を比べる輪になる）。
field ivl : max bound 589824             # 上端の添字の変数のループ番号
ivl[t] <- vlpz[int4b[t]] for (t,zc) in ch if kwin[t] if irng[t] if isocc[int4[t]]
      if not isnum[int4b[t]] if tkind[int4b[t]] == 1
lkd[snum[t], lz[t]] <- 3 for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t] if irng[t]
      if isocc[int4[t]] if not isnum[int4b[t]] if tkind[int4b[t]] == 1
lbc2[snum[t], lz[t]] <- ivl[t] for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if kwin[t]
      if irng[t] if isocc[int4[t]] if not isnum[int4b[t]] if tkind[int4b[t]] == 1
field lar2 : max bound 16384 8           # その節の組の長さ
lar2[snum[t], lz[t]] <- colc[t] + 1 for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7 if isbind[t]

# ── 項。**矢印より後ろ・節0・深さ0** が値の式である ─────────────────
field isclo : or bound 589824           # `]`
isclo[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 93
field tmatch : max bound 589824         # 閉じのトークン → 開きのトークン
tmatch[tnum[i]] <- tnum[match[i]] for (i,c) in ch if clo[i]
field tclos : max bound 589824          # 開きのトークン → 閉じのトークン
tclos[tmatch[t]] <- t for (t,zc) in ch if isclo[t]
field aftarw : or bound 589824          # 値の式の中（矢印の後ろ・節0・深さ0）
aftarw[t] <- true for (t,zc) in ch if cnum[t] == 0 if tdep[t] == 0
      if t > arrowt[snum[t]]
# 引き算の `-` と、矢印の `-` は別である（`<-` の後ろの数は定数であって
# 「引く定数」ではない）—— 種を取り違えると、種の値が符号ごと化ける。
field isstar : or bound 589824          # `*`
isstar[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 42
field ismin : or bound 589824           # 引き算の `-`（矢印の `-` ではない）
ismin[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 45 if tch[prevw[t],0] != 60
field pminus : or bound 589824          # 一つ前の語が引き算の `-`
pminus[t] <- ismin[prevw[t]] for (t,zc) in ch
field pplus : or bound 589824           # 一つ前の語が `+`
pplus[t] <- isplus[prevw[t]] for (t,zc) in ch
field pstar : or bound 589824           # 一つ前の語が `*`
pstar[t] <- isstar[prevw[t]] for (t,zc) in ch
# 二のべきで割る / 余りを取る（`imm[n] / 256 % 256`）—— バイトを取り出す形
field isdiv : or bound 589824           # `/`
isdiv[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 47
field ismod : or bound 589824           # `%`
ismod[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 37
field pdiv : or bound 589824            # 一つ前の語が `/`
pdiv[t] <- isdiv[prevw[t]] for (t,zc) in ch
field pmod : or bound 589824            # 一つ前の語が `%`
pmod[t] <- ismod[prevw[t]] for (t,zc) in ch
# **区間の上端の読みは、項でもガードでもない**（供給の話であって値ではない）
field isbnd : or bound 589824           # 区間の上端の場のトークン
isbnd[int4[t]] <- true for (t,zc) in ch if kwin[t] if irng[t]
      if isocc[int4[t]]
isbnd[ilo[t]] <- true for (t,zc) in ch if kwin[t] if irng[t] if ilo[t] >= 0 if isocc[ilo[t]]
field isbnl : or bound 589824           # そのうち区間の下端（13i。`(f[x])` の f）
isbnl[ilo[t]] <- true for (t,zc) in ch if kwin[t] if irng[t] if ilo[t] >= 0 if isocc[ilo[t]]
field istrm : or bound 589824           # 場の読みの項（名前のトークン）
istrm[t] <- true for (t,zc) in ch if isocc[t] if aftarw[t]
      if isrec[snum[t]] if not isbnd[t]
field istrmn : or bound 589824          # 定数の項
istrmn[t] <- true for (t,zc) in ch if aftarw[t] if isnum[t]
      if isrec[snum[t]]
# **`true` も値である**（解釈実行では 1）。項の種のどれにも当たらず黙って落ちて
# いたので、`x[i] <- true`（max）が 0、`true + 1` が 1 になっていた。`or` の書き先
# では `true` は項ではない（`or` の join は値を見ない —— 規則が撃てば 1 を置く）。
istrmn[t] <- true for (t,zc) in ch if aftarw[t] if kwtru[t]
      if isrec[snum[t]] if not sor[snum[t]]
field istrmv : or bound 589824          # 変数の項
istrmv[t] <- true for (t,zc) in ch if aftarw[t] if tkind[t] == 1
      if not isnum[t] if vbnd[t] >= 0 if isrec[snum[t]]
field istm : or bound 589824            # どれかの項
istm[t] <- true for (t,zc) in ch if istrm[t]
istm[t] <- true for (t,zc) in ch if istrmn[t]
istm[t] <- true for (t,zc) in ch if istrmv[t]
field tcnt : max bound 589824           # 項の通し番号（文の中）
tcnt[t] <- 0             for (t,zc) in ch if sbrk[t]
tcnt[t] <- tcnt[t-1] + 1 for (t,zc) in ch if t >= 1 if istm[t-1] if not sbrk[t]
tcnt[t] <- tcnt[t-1]     for (t,zc) in ch if t >= 1 if not istm[t-1] if not sbrk[t]
# **九本目は席の外へ書かない。** 項の席は八つしか無いのに、九本目を
# 席の外へ書いていた —— 書き座標のはみ出しが黙って隣を踏む穴に、
# **焼き手自身が寄りかかっていた**（座標に濾しを入れたら自分が止まった）。
# 数は別に数えているので、席に書かなくても「項が九つ」は言える。
field trkd : max bound 16384 8           # 1 定数 / 2 列 / 3 場 / 4 計数器
                                       # 5 引く / 6 掛ける / 7 割る / 8 余り（定数で）
                                       # 9 場を引く / 10 場を掛ける / 15 場で割る / 16 場で余り
                                       # 17 列で割る / 18 列で余り / 19 計数器で割る / 20 計数器で余り
# **`/` と `%` は場の読みには付けていなかった。** 付いていないのに素の
# 「場の読み」（種3）に落ちるので、`a[i] / a[i-1]` が **足し算**になって
# いた（97/98 が 195 になる）。列の側は最初から除いてあった（種2/4）——
# 同じ穴が場の側に空いたままだった（四度目）。除けば種が付かず、
# `okt` が立たないので **理由 8 で断る**。
trkd[snum[t], tcnt[t]] <- 3 for (t,zc) in ch if istrm[t] if not pminus[t] if tcnt[t] <= 7
      if not pstar[t] if not pdiv[t] if not pmod[t]
# 種9: 場の読みを **引く**（足せて引けないのは分類の穴だった）
trkd[snum[t], tcnt[t]] <- 9 for (t,zc) in ch if istrm[t] if pminus[t] if tcnt[t] <= 7
# 種10: 場の読みを **掛ける**。`8 * f[x]` は左からの畳み込みでは書けないが、
# `f[x] * 8` は書ける —— では `f[x] * g[y]` は？ 同じ穴がもう一つあった。
trkd[snum[t], tcnt[t]] <- 10 for (t,zc) in ch if istrm[t] if pstar[t] if tcnt[t] <= 7
# 種15 / 16: 場の読みで **割る / 余りを取る**（14f。床。割る数が 0 なら ⊥ —— 撃たない）。
# 長いあいだ「場で割る」は理由 8 だった（種が付かないまま足し算に落ちていた穴を、断ることで塞いでいた）。
# 自由に書いた本（平均 `tot[0] / cnt[0]`、桁 `x / pw[k] % 2`）が二本ここで止まった
trkd[snum[t], tcnt[t]] <- 15 for (t,zc) in ch if istrm[t] if pdiv[t] if tcnt[t] <= 7
trkd[snum[t], tcnt[t]] <- 16 for (t,zc) in ch if istrm[t] if pmod[t] if tcnt[t] <= 7
trkd[snum[t], tcnt[t]] <- 1 for (t,zc) in ch if istrmn[t] if not pminus[t] if tcnt[t] <= 7
      if not pstar[t] if not pdiv[t] if not pmod[t]
trkd[snum[t], tcnt[t]] <- 5 for (t,zc) in ch if istrmn[t] if pminus[t] if tcnt[t] <= 7
trkd[snum[t], tcnt[t]] <- 6 for (t,zc) in ch if istrmn[t] if pstar[t] if tcnt[t] <= 7
trkd[snum[t], tcnt[t]] <- 7 for (t,zc) in ch if istrmn[t] if pdiv[t] if tcnt[t] <= 7
trkd[snum[t], tcnt[t]] <- 8 for (t,zc) in ch if istrmn[t] if pmod[t] if tcnt[t] <= 7
# **変数も足すだけではない。** 列も計数器も引けるし掛けられる（種11〜14）——
# 場（種9/10）を直したときに、同じ穴が変数の側に空いたままだった（三度目）。
trkd[snum[t], tcnt[t]] <- 2 for (t,zc) in ch if istrmv[t] if tcnt[t] <= 7
      if not pminus[t] if not pstar[t] if not pdiv[t] if not pmod[t]
      if lkd[snum[t], vlpz[t]] == 0
trkd[snum[t], tcnt[t]] <- 4 for (t,zc) in ch if istrmv[t] if tcnt[t] <= 7
      if not pminus[t] if not pstar[t] if not pdiv[t] if not pmod[t]
      if lkd[snum[t], vlpz[t]] >= 1
trkd[snum[t], tcnt[t]] <- 11 for (t,zc) in ch if istrmv[t] if pminus[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] == 0
trkd[snum[t], tcnt[t]] <- 12 for (t,zc) in ch if istrmv[t] if pstar[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] == 0
trkd[snum[t], tcnt[t]] <- 13 for (t,zc) in ch if istrmv[t] if pminus[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] >= 1
trkd[snum[t], tcnt[t]] <- 14 for (t,zc) in ch if istrmv[t] if pstar[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] >= 1
# 種17〜20: 変数で **割る / 余りを取る**（14j。列 17 / 18、計数器 19 / 20）。種15 / 16 と同じく床で、
# 割る数が 0 なら ⊥（撃たない）。前は理由 8 —— 下ろしは表の列を場の読みにするので種15 で通ったが、
# 計数器は変数のまま残り、`100 / d` や、ガードを持ち上げた `_g[n, d] <- n % d`（約数を数える本）が止まった。
trkd[snum[t], tcnt[t]] <- 17 for (t,zc) in ch if istrmv[t] if pdiv[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] == 0
trkd[snum[t], tcnt[t]] <- 18 for (t,zc) in ch if istrmv[t] if pmod[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] == 0
trkd[snum[t], tcnt[t]] <- 19 for (t,zc) in ch if istrmv[t] if pdiv[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] >= 1
trkd[snum[t], tcnt[t]] <- 20 for (t,zc) in ch if istrmv[t] if pmod[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] >= 1
field trfl : max bound 16384 8           # 場（種3）
trfl[snum[t], tcnt[t]] <- ofl[oseq[t]] - 1 for (t,zc) in ch if istrm[t] if tcnt[t] <= 7
field trcl : max bound 16384 8           # 列 / ループ番号
trcl[snum[t], tcnt[t]] <- vcolz[t] for (t,zc) in ch if istrmv[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] == 0
trcl[snum[t], tcnt[t]] <- vlpz[t] for (t,zc) in ch if istrmv[t] if tcnt[t] <= 7
      if lkd[snum[t], vlpz[t]] >= 1
field trvl : max bound 16384 8           # 定数
trvl[snum[t], tcnt[t]] <- tval[t] for (t,zc) in ch if istrmn[t] if tcnt[t] <= 7
trvl[snum[t], tcnt[t]] <- 1 for (t,zc) in ch if istrmn[t] if kwtru[t] if tcnt[t] <= 7

print isrec
print rlt
print rst
print rarr
print lkd
print llo2
print lhi2
print lar2
print trkd
print trfl
print trcl
print trvl

# ══ ガードの行 ═════════════════════════════════════════════════════
# 断片の字句解析は記号を一文字ずつ切る（`>=` は `>` と `=`）。
# **二文字目は次のトークンの先頭文字**なので、そこを見れば演算子が決まる。
field nch : max bound 589824            # 次のトークンの先頭文字
nch[t] <- tch[t+1, 0] for (t,zc) in ch
field opc2 : max bound 589824           # 1 == / 2 != / 3 >= / 4 <= / 5 > / 6 <
opc2[t] <- 1 for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 61 if nch[t] == 61
opc2[t] <- 2 for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 33 if nch[t] == 61
opc2[t] <- 3 for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 62 if nch[t] == 61
opc2[t] <- 4 for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 60 if nch[t] == 61
opc2[t] <- 5 for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 62 if nch[t] != 61
opc2[t] <- 6 for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 60 if nch[t] != 61 if nch[t] != 45
field iscmp2 : or bound 589824          # 深さ0 の if 節の比較演算子
iscmp2[t] <- true for (t,zc) in ch if opc2[t] >= 1 if tdep[t] == 0
      if cnum[t] >= 1
field opnx : max bound 589824           # 演算子の次の語（右辺の先頭）
opnx[t] <- nextw[t]         for (t,zc) in ch if opc2[t] >= 5
opnx[t] <- nextw[nextw[t]]  for (t,zc) in ch if opc2[t] >= 1 if opc2[t] <= 4
field oppv : max bound 589824           # 演算子の前の語（左辺の末尾）
oppv[t] <- prevw[t] for (t,zc) in ch if opc2[t] >= 1

# ── 節の種。**節が一つのガードとは限らない**（比較は左右で二行）─────
field clif2 : or bound 16384 32          # 節 c は if 節
clif2[snum[t], cnum[t]] <- true for (t,zc) in ch if kwif[t]
field clcmp : or bound 16384 32          # その節は比較
clcmp[snum[t], cnum[t]] <- true for (t,zc) in ch if iscmp2[t]
field clneg : or bound 16384 32          # その節は否定の読み
clneg[snum[t], cnum[t]] <- true for (t,zc) in ch if kwnot[t]
field gadd : max bound 16384 32          # その節が足すガードの数
gadd[s,c] <- 0 for (s) in 0 .. nstz[0] for (c) in 0 .. 31
gadd[s,c] <- 1 for (s) in 0 .. nstz[0] for (c) in 0 .. 31 if clif2[s,c]
gadd[s,c] <- 2 for (s) in 0 .. nstz[0] for (c) in 0 .. 31 if clcmp[s,c]
field gcn : max bound 16384 32           # 節 c の手前までのガードの数（鎖）
gcn[s,0] <- 0 for (s) in 0 .. nstz[0]
gcn[s,c] <- gcn[s,c-1] + gadd[s,c-1] for (s) in 0 .. nstz[0] for (c) in 1 .. 31
field gno2 : max bound 589824           # そのトークンの属するガード番号
gno2[t] <- gcn[snum[t], cnum[t]] for (t,zc) in ch

# ── ガードの種。2 否定 / 3 比較の左 / 4 比較の右 / 9 肯定の読み ────────
field gkd : max bound 16384 32
gkd[snum[t], gno2[t]] <- 3 for (t,zc) in ch if iscmp2[t]
gkd[snum[t], gno2[t] + 1] <- 4 for (t,zc) in ch if iscmp2[t]
# **同じ判断を二箇所に書いたら、片方だけ直る**（気づき34）—— 区間の上端の
# 読みは辺ではない。`isgrd` はそう言っていたのに、ここは `isocc` を見ていた。
gkd[snum[t], gno2[t]] <- 2 for (t,zc) in ch if isgrd[t]
      if isneg[t] if not clcmp[snum[t], cnum[t]]
gkd[snum[t], gno2[t]] <- 9 for (t,zc) in ch if isgrd[t]
      if not isneg[t] if not clcmp[snum[t], cnum[t]]
# **辺は式ではない。** `if r + 1 == n[0]` の左は「計数器」でも「場の読み」でも
# 「定数」でもない —— 焼くと `r` だけを見て黙って外れる。だから **知らない種**
# （15）にして、生成器が「焼けない」と言えるようにする（不変条件8 を源の側でも）。
#
# **辺の形を数え上げるのをやめた。** 以前はここに六本並んでいた ——
# 左辺の手前が `+ - * / %` か（五本）、右辺の後ろに `± 数` が続くか（一本）。
# 数え上げは **漏れる**: `if 1 + a[i] >= 2` は左辺の手前が `[` なので当たらず、
# `if not a[i] + 1` は比較ではないので当たらない。どちらも黙って項を落として
# いた（気づき34 —— 同じ判断を六箇所に書けば、直らない所が残る）。
#
# 言いたいことは一つである —— **if 節の中に、括弧の外の演算子があってはならない**。
# 括弧の中（`f[i-1]` のずれ）は座標の話なので当たらない。
field isop : or bound 589824            # 演算子（+ - * / %）
isop[t] <- true for (t,zc) in ch if isplus[t]
isop[t] <- true for (t,zc) in ch if ismin[t]
isop[t] <- true for (t,zc) in ch if isstar[t]
isop[t] <- true for (t,zc) in ch if isdiv[t]
isop[t] <- true for (t,zc) in ch if ismod[t]
field ifop : or bound 589824            # if 節の中の、括弧の外の演算子
ifop[t] <- true for (t,zc) in ch if isop[t] if tdep[t] == 0
      if clif2[snum[t], cnum[t]]
gkd[snum[t], gno2[t]] <- 15 for (t,zc) in ch if ifop[t]
# **比較の節の `not` も式である。** 解釈実行は `if not a[i] > b[i]` を
# `(not a[i]) > b[i]` と読む（真偽を数と比べる）。辺にその形は無いのに、焼く側は
# `not` を黙って落として `a[i] > b[i]` を焼いていた。知らない種（15）にする。
gkd[snum[t], gno2[t]] <- 15 for (t,zc) in ch if iscmp2[t] if clneg[snum[t], cnum[t]]
gkd[snum[t], gno2[t] + 1] <- 15 for (t,zc) in ch if iscmp2[t]
      if clneg[snum[t], cnum[t]]
gkd[snum[t], gno2[t] + 1] <- 15 for (t,zc) in ch if ifop[t]
      if clcmp[snum[t], cnum[t]]

field ggv : max bound 16384 32           # 比較の要求（右の行が持つ）
ggv[snum[t], gno2[t] + 1] <- opc2[t] for (t,zc) in ch if iscmp2[t]

# ── 辺の種。0 場の読み / 1 表の列 / 2 区間の計数器 / 3 定数 ────────────
# **座標は二段まで。** `lkd[snum[t], vlpz[oppv[t]]]` は三段目なので、
# 中間の場に一度置く —— 三段目は黙って落ちる（気づき29）。名前を付ければ
# 「深い式」は消えて、ただの二段の読みが二本になる。
field ovlp : max bound 589824            # 左辺の変数の for 節番号（0 起点）
ovlp[t] <- vlpz[oppv[t]] for (t,zc) in ch if iscmp2[t]
field nvlp : max bound 589824            # 右辺の変数の for 節番号
nvlp[t] <- vlpz[opnx[t]] for (t,zc) in ch if iscmp2[t]
field gok2 : max bound 16384 32
field gov : max bound 16384 32           # 定数のとき、その値
field gc1 : max bound 16384 32           # 列 / ループ番号
field gfd : max bound 16384 32           # 場（辺が読みのとき）
gok2[snum[t], gno2[t]] <- 0 for (t,zc) in ch if iscmp2[t] if isclo[oppv[t]]
gok2[snum[t], gno2[t]] <- 3 for (t,zc) in ch if iscmp2[t] if isnum[oppv[t]]
gok2[snum[t], gno2[t]] <- 1 for (t,zc) in ch if iscmp2[t]
      if lkd[snum[t], ovlp[t]] == 0
gok2[snum[t], gno2[t]] <- 2 for (t,zc) in ch if iscmp2[t]
      if lkd[snum[t], ovlp[t]] >= 1
gov[snum[t], gno2[t]] <- tval[oppv[t]] for (t,zc) in ch if iscmp2[t]
      if isnum[oppv[t]]
gc1[snum[t], gno2[t]] <- vcolz[oppv[t]] for (t,zc) in ch if iscmp2[t]
      if lkd[snum[t], ovlp[t]] == 0
gc1[snum[t], gno2[t]] <- vlpz[oppv[t]] for (t,zc) in ch if iscmp2[t]
      if lkd[snum[t], ovlp[t]] >= 1
gok2[snum[t], gno2[t] + 1] <- 0 for (t,zc) in ch if iscmp2[t]
      if isocc[opnx[t]]
gok2[snum[t], gno2[t] + 1] <- 3 for (t,zc) in ch if iscmp2[t]
      if isnum[opnx[t]]
gok2[snum[t], gno2[t] + 1] <- 1 for (t,zc) in ch if iscmp2[t]
      if not isocc[opnx[t]] if lkd[snum[t], nvlp[t]] == 0
gok2[snum[t], gno2[t] + 1] <- 2 for (t,zc) in ch if iscmp2[t]
      if not isocc[opnx[t]] if lkd[snum[t], nvlp[t]] >= 1
gov[snum[t], gno2[t] + 1] <- tval[opnx[t]] for (t,zc) in ch if iscmp2[t]
      if isnum[opnx[t]]
gc1[snum[t], gno2[t] + 1] <- vcolz[opnx[t]] for (t,zc) in ch if iscmp2[t]
      if not isocc[opnx[t]] if lkd[snum[t], nvlp[t]] == 0
gc1[snum[t], gno2[t] + 1] <- vlpz[opnx[t]] for (t,zc) in ch if iscmp2[t]
      if not isocc[opnx[t]] if lkd[snum[t], nvlp[t]] >= 1

# 場は「読みの辺」のとき。左辺の場は `]` の相手、右辺は名前そのもの
field lnm : max bound 589824            # 左辺の `]` → その読みの名前トークン
lnm[t] <- tmatch[oppv[t]] for (t,zc) in ch if iscmp2[t] if isclo[oppv[t]]
field olno : max bound 589824            # 左辺の読みの出現番号（三段を割る）
olno[t] <- oseq[lnm[t]] for (t,zc) in ch if iscmp2[t] if isclo[oppv[t]]
field onxo : max bound 589824            # 右辺の読みの出現番号
onxo[t] <- oseq[opnx[t]] for (t,zc) in ch if iscmp2[t] if isocc[opnx[t]]
gfd[snum[t], gno2[t]] <- ofl[olno[t]] - 1 for (t,zc) in ch if iscmp2[t]
      if isclo[oppv[t]]
gfd[snum[t], gno2[t] + 1] <- ofl[onxo[t]] - 1 for (t,zc) in ch
      if iscmp2[t] if isocc[opnx[t]]
gfd[snum[t], gno2[t]] <- ofl[oseq[t]] - 1 for (t,zc) in ch if isgrd[t]
      if not clcmp[snum[t], cnum[t]]

print gkd
print ggv
print gok2
print gov
print gc1
print gfd

# ══ 座標の行 ═══════════════════════════════════════════════════════
# 所有者は **出現**である（書き先・項・ガードの辺）。次元は 0 と 1。
# 源は四つ —— 0 表の列 / 1 区間の計数器 / 2 列で引いた場 / 3 計数器で引いた場
# / 4 定数。ずれ（`f[i-1]`）は mod 256 で渡す ——
# **引き算が無いので鎖で作る**（neg[n] = 256 - n）。
field isplus : or bound 589824          # `+`
isplus[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 43
field neg : max bound 512              # 256 - n（鎖）
neg[0] <- 256
neg[n] <- neg[n-1] - 1 for (n) in 1 .. 255

field ixend : max bound 589824          # 添字の本体の終わり（読みなら `]`）
ixend[j] <- j          for (j,zc) in ch if not isocc[j]
ixend[j] <- tclos[obr[j]] for (j,zc) in ch if isocc[j]
field ixop : max bound 589824           # 本体の次の語（`+` / `-` / `,` / `]`）
ixop[j] <- nextw[ixend[j]] for (j,zc) in ch
field ixnm : max bound 589824           # そのまた次の語（ずれの数）
ixnm[j] <- nextw[ixop[j]] for (j,zc) in ch
field ixnv : max bound 589824           # ずれの数の値
ixnv[j] <- tval[ixnm[j]] for (j,zc) in ch
# **ずれは -128 から +127 まで。** ずれは `add r9, imm8` の一バイトで持つ —— 符号つきなので、
# 128 以上の `+` は負に化け（`c[i+200]` が c[i-56] を読み、升が外れて黙って ⊥）、129 以上の `-` は
# `neg` で正に化けていた（`c[i-200]` が c[i+56] を読み、**もっともらしい違う数**を答えた）。
# 前はここに「255 まで」と書いてあった —— 一バイトに入ることだけを見て、符号を見ていなかった。
# 外のずれはずれとして読まない（座標の語の数えが理由 8 で言う）。
# `0 - 2147483647` のような **ずれではない引き算**もここを通る（`ixend` は
# 出現でないトークンでは自分自身なので）ので、上限は数えて言う（気づき35）。
field ixhf : or bound 589824            # ずれがあるか
ixhf[j] <- true for (j,zc) in ch if isnum[ixnm[j]] if ismin[ixop[j]]
      if ixnv[j] <= 128
ixhf[j] <- true for (j,zc) in ch if isnum[ixnm[j]] if isplus[ixop[j]]
      if ixnv[j] <= 127
field ixof : max bound 589824           # ずれ（mod 256）
ixof[j] <- ixnv[j]      for (j,zc) in ch if isplus[ixop[j]] if isnum[ixnm[j]]
      if ixnv[j] <= 127
ixof[j] <- neg[ixnv[j]] for (j,zc) in ch if ismin[ixop[j]] if isnum[ixnm[j]]
      if ixnv[j] <= 128

# **前置のずれ**（`p[j+1]`）—— 内側の添字が動く。後置（`p[j] + 1`）とは
# 別の場所に別の命令が要る。同じ印に畳んでいたら **黙って落ちていた**。
field ixpre : or bound 589824           # 出現 j の内側の添字がずれている
ixpre[j] <- true for (j,zc) in ch if isocc[j] if ixhf[ob1[j]]
field ixpof : max bound 589824          # そのずれ（mod 256）
ixpof[j] <- ixof[ob1[j]] for (j,zc) in ch if isocc[j] if ixhf[ob1[j]]
# **前置のずれは源2/3 の行のものである。** 内側が鎖（`h[g[k[i]] …]`）か二次元
# （`g[g[j+1, j] - 1, j]`）なら、内側は自分の所有者を持ち、その添字のずれは内側の行が
# 持つ。外側の行にも前置の印を付けていたので、後置のずれ（`- 1`）が max に負けて
# **黙って落ちた**（`test/coords.py` が撒いて出した）。
field ixpr2 : or bound 589824           # 出現 j の前置のずれは、外側の行（源2/3）が持つ
ixpr2[j] <- true for (j,zc) in ch if ixpre[j] if not isocc[ob1[j]] if not iscom[d0cm[j]]

field ixsr : max bound 589824           # 添字トークンの源
ixsr[j] <- 4 for (j,zc) in ch if isnum[j]
ixsr[j] <- 0 for (j,zc) in ch if not isocc[j] if not isnum[j]
      if lkd[snum[j], vlpz[j]] == 0
ixsr[j] <- 1 for (j,zc) in ch if not isocc[j] if not isnum[j]
      if lkd[snum[j], vlpz[j]] >= 1
# 内側の読みの添字の変数の for 節と列（三段の読みを割る —— 出現の添字は ob1）
field ovl1 : max bound 589824           # 出現 j の次元0 の添字の変数の for 節（0 起点）
ovl1[j] <- vlpz[ob1[j]] for (j,zc) in ch if isocc[j]
field ovc1 : max bound 589824           # その変数の列
ovc1[j] <- vcolz[ob1[j]] for (j,zc) in ch if isocc[j]
ixsr[j] <- 2 for (j,zc) in ch if isocc[j] if lkd[snum[j], ovl1[j]] == 0
ixsr[j] <- 3 for (j,zc) in ch if isocc[j] if lkd[snum[j], ovl1[j]] >= 1
# **添字が読みのときは源5（鎖）。** `a[b[i]]` の `b` の添字は変数だから
# 源2/3 で済む —— 一段の間接を一つの形に畳んだものである。`a[b[h[i]]]` の
# `b` の添字は **読み**なので `vlpz` が ⊥ になり、どちらの規則も撃たず、
# 源が出ないまま座標が消えていた（三段目が落ちる。気づき29 はこれを
# 「中間の場に置け」で回避していた）。
#
# 回避する必要は無かった。**鎖の仕掛けは既に在る** —— 源5「内側の所有者が
# 座標を作り終えた所で読む」がそれで、`f[g[i,j]]` のために書かれていた。
# 内側が二次元でなくても、内側が **自分の座標を組み立てる** なら同じ形で済む。
# 深さは一段ずつ内側に開くだけなので、これで N 段まで届く（四段まで測った）。
ixsr[j] <- 5 for (j,zc) in ch if isocc[j] if isocc[ob1[j]]
field ixcc : max bound 589824           # 列 / ループ番号 / 定数
ixcc[j] <- tval[j]  for (j,zc) in ch if isnum[j]
ixcc[j] <- vcolz[j] for (j,zc) in ch if not isocc[j] if not isnum[j]
      if lkd[snum[j], vlpz[j]] == 0
ixcc[j] <- vlpz[j]  for (j,zc) in ch if not isocc[j] if not isnum[j]
      if lkd[snum[j], vlpz[j]] >= 1
ixcc[j] <- ovc1[j] for (j,zc) in ch if isocc[j]
      if lkd[snum[j], ovl1[j]] == 0
ixcc[j] <- ovl1[j]  for (j,zc) in ch if isocc[j]
      if lkd[snum[j], ovl1[j]] >= 1
# 源5 の `cdcc` は列でも計数器でもなく **内側の出現**である
# （31_gen の `cb[cdcc[gc]] <- cdpos[gc]` が所有者番号として読む）
ixcc[j] <- oseq[j] for (j,zc) in ch if isocc[j] if isocc[ob1[j]]
field ixcf : max bound 589824           # 場（源2/3）
ixcf[j] <- ofl[oseq[j]] - 1 for (j,zc) in ch if isocc[j]

# ── 出現の次元。0 は `[` の次、1 は `,` の次 ────────────────────────
field ix0e : max bound 589824           # 次元0 の添字の終わり（ずれ込み）
ix0e[t] <- ixend[ob1[t]] for (t,zc) in ch if isocc[t] if not ixhf[ob1[t]]
ix0e[t] <- ixnm[ob1[t]]  for (t,zc) in ch if isocc[t] if ixhf[ob1[t]]
field d0cm : max bound 589824           # 次元0 の直後の語
d0cm[t] <- nextw[ix0e[t]] for (t,zc) in ch if isocc[t]
field d1t : max bound 589824            # 次元1 の添字トークン
d1t[t] <- nextw[d0cm[t]] for (t,zc) in ch if isocc[t] if iscom[d0cm[t]]

field c0sr : max bound 32768            # 出現 o の次元0
c0sr[oseq[t]] <- ixsr[ob1[t]] for (t,zc) in ch if isocc[t]
field c0cc : max bound 32768
c0cc[oseq[t]] <- ixcc[ob1[t]] for (t,zc) in ch if isocc[t]
field c0cf : max bound 32768
c0cf[oseq[t]] <- ixcf[ob1[t]] for (t,zc) in ch if isocc[t]
field c0hf : max bound 32768            # 0 無し / 1 後置 / 2 前置
c0hf[oseq[t]] <- 1 for (t,zc) in ch if isocc[t] if ixhf[ob1[t]]
c0hf[oseq[t]] <- 2 for (t,zc) in ch if isocc[t] if ixpr2[ob1[t]]
field c0of : max bound 32768
c0of[oseq[t]] <- ixof[ob1[t]]  for (t,zc) in ch if isocc[t] if ixhf[ob1[t]]
c0of[oseq[t]] <- ixpof[ob1[t]] for (t,zc) in ch if isocc[t] if ixpr2[ob1[t]]
field has1 : or bound 32768             # 次元1 があるか
has1[oseq[t]] <- true for (t,zc) in ch if isocc[t] if iscom[d0cm[t]]
field c1sr : max bound 32768            # 出現 o の次元1
c1sr[oseq[t]] <- ixsr[d1t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d0cm[t]]
field c1cc : max bound 32768
c1cc[oseq[t]] <- ixcc[d1t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d0cm[t]]
field c1cf : max bound 32768
c1cf[oseq[t]] <- ixcf[d1t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d0cm[t]]
field c1hf : max bound 32768            # 0 無し / 1 後置 / 2 前置
c1hf[oseq[t]] <- 1 for (t,zc) in ch if isocc[t] if iscom[d0cm[t]]
      if ixhf[d1t[t]]
c1hf[oseq[t]] <- 2 for (t,zc) in ch if isocc[t] if iscom[d0cm[t]]
      if ixpr2[d1t[t]]
field c1of : max bound 32768
c1of[oseq[t]] <- ixof[d1t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d0cm[t]] if ixhf[d1t[t]]
c1of[oseq[t]] <- ixpof[d1t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d0cm[t]] if ixpr2[d1t[t]]
# ── 次元2。**次元は `,` に沿った鎖**で、次元1 の添字の終わりの次の語が `,` なら次元2 がある。
# 行の形（源・列・場・ずれ）は次元0・1 と同じで、焼く側（31_gen）は座標を (所有者, 次元) の行で
# 受け取り、掛けて足す鎖で畳む —— もう N 次元を向いていた。二次元に縛っていたのはここだけである。
field ix1e : max bound 589824           # 次元1 の添字の終わり（ずれ込み）
ix1e[t] <- ixend[d1t[t]]  for (t,zc) in ch if isocc[t] if iscom[d0cm[t]] if not ixhf[d1t[t]]
ix1e[t] <- ixnm[d1t[t]]   for (t,zc) in ch if isocc[t] if iscom[d0cm[t]] if ixhf[d1t[t]]
field d1cm : max bound 589824           # 次元1 の直後の語
d1cm[t] <- nextw[ix1e[t]] for (t,zc) in ch if isocc[t] if iscom[d0cm[t]]
field d2t : max bound 589824            # 次元2 の添字トークン
d2t[t] <- nextw[d1cm[t]] for (t,zc) in ch if isocc[t] if iscom[d1cm[t]]
field ix2e : max bound 589824           # 次元2 の添字の終わり（ずれ込み）
ix2e[t] <- ixend[d2t[t]]  for (t,zc) in ch if isocc[t] if iscom[d1cm[t]] if not ixhf[d2t[t]]
ix2e[t] <- ixnm[d2t[t]]   for (t,zc) in ch if isocc[t] if iscom[d1cm[t]] if ixhf[d2t[t]]
field d2cm : max bound 589824           # 次元2 の直後の語（`,` なら四次元 —— 焼かない）
d2cm[t] <- nextw[ix2e[t]] for (t,zc) in ch if isocc[t] if iscom[d1cm[t]]
field has2 : or bound 32768             # 次元2 があるか
has2[oseq[t]] <- true for (t,zc) in ch if isocc[t] if iscom[d1cm[t]]
field c2sr : max bound 32768            # 出現 o の次元2
c2sr[oseq[t]] <- ixsr[d2t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d1cm[t]]
field c2cc : max bound 32768
c2cc[oseq[t]] <- ixcc[d2t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d1cm[t]]
field c2cf : max bound 32768
c2cf[oseq[t]] <- ixcf[d2t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d1cm[t]]
field c2hf : max bound 32768            # 0 無し / 1 後置 / 2 前置
c2hf[oseq[t]] <- 1 for (t,zc) in ch if isocc[t] if iscom[d1cm[t]]
      if ixhf[d2t[t]]
c2hf[oseq[t]] <- 2 for (t,zc) in ch if isocc[t] if iscom[d1cm[t]]
      if ixpr2[d2t[t]]
field c2of : max bound 32768
c2of[oseq[t]] <- ixof[d2t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d1cm[t]] if ixhf[d2t[t]]
c2of[oseq[t]] <- ixpof[d2t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d1cm[t]] if ixpr2[d2t[t]]

# ── 所有者の種と番号 ───────────────────────────────────────────────
field isgrd : or bound 589824           # ガードの辺になる出現
# **内側の読みは辺ではない。** `f[g[i]]` の `g` は f の座標であって、
# ガードの辺ではない —— 深さ 0 の読みだけが辺になる（項は aftarw が既に言う）。
# 内も外も辺にすると、`max` が **内側を選ぶ**（番号が大きいから）。
isgrd[t] <- true for (t,zc) in ch if isocc[t] if cnum[t] >= 1 if not isbnd[t]
      if tdep[t] == 0
field grhs : or bound 589824            # 比較の右辺の読み
grhs[opnx[t]] <- true for (t,zc) in ch if iscmp2[t] if isocc[opnx[t]]
field okk : max bound 32768             # 0 項 / 1 ガード / 2 書き先
okk[o] <- 0 for (o) in 0 .. nocz[0] if istrm[otok[o]]
okk[o] <- 1 for (o) in 0 .. nocz[0] if isgrd[otok[o]]
okk[o] <- 2 for (o) in 0 .. nocz[0] if ohd[o]
field oix : max bound 32768             # 所有者の中の番号
oix[o] <- 0 for (o) in 0 .. nocz[0] if ohd[o]
oix[o] <- tcnt[otok[o]] for (o) in 0 .. nocz[0] if istrm[otok[o]]
oix[o] <- gno2[otok[o]] for (o) in 0 .. nocz[0] if isgrd[otok[o]]
      if not grhs[otok[o]]
oix[o] <- gno2[otok[o]] + 1 for (o) in 0 .. nocz[0] if isgrd[otok[o]]
      if grhs[otok[o]]

print okk
print oix
print c0sr
print c0cc
print c0cf
print c0hf
print c0of
print has1
print c1sr
print c1cc
print c1cf
print c1hf
print c1of

print flatt
print fwid
print fwid2
print farr
print tbrow
print isseed
print sedf
print sedc
print sedv
