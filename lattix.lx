# ══ 箱を超えたら言う —— `run.lx` の `zov` と同じ判断 ══════════════════
#   ここには見張りが無かった。場が 1024 を、規則が 2048 を、符号が 131,072
#   バイトを超えると、**黙って隣を踏み**、ELF の頭 23 バイトだけが出た
#   （終了コードは 0）。「黙って空を返す」は、この企画がいちばん嫌う壊れ方
#   である（気づき44: 上限は、超えたときを試すまで上限ではない）。
#
#   **上限は一箇所で言う**（気づき33）。下の `cap*` は宣言の `bound` と
#   揃えてある —— 片方だけ動かせば、この見張りが先に声を出す。
#   理由 0 は「箱が足りない」。行は 0（どの行のせいでもない、寸法の話）。
field capf : max bound 1            # 場ごとの箱（fbot / fsz / foff … の bound）
capf[0] <- 1024
#   **見張りは、最初の問いで自分を捕まえた。** `lattix.lx` は規則 2,406 本で、
#   規則ごとの箱は `bound 2048` だった —— 配っている焼き手が、自分の箱を
#   358 規則ぶん超えて走っていた（g4d はバイト一致していたので、踏んだ先が
#   たまたま無害だっただけである）。**黙って起きていた。** 箱を 4096 にした。
field capr : max bound 1            # 規則ごとの箱（okr … の bound）
capr[0] <- 8192
#   **見張る箱は、推測せずに読む。** 所有者の配列は `bound 16384` なのに
#   場の箱（1024）と比べて、正しい本まで断った —— 見張りが狼を呼んだ。
#   下の三つは、それぞれの配列の宣言を読んで揃えてある。
field capw : max bound 1            # 所有者ごとの箱（oflg / isin / coff / cb / ofld）
capw[0] <- 16384
badk[z] <- 0   for (z) in 0 .. 0 if nfl[0] > capf[0]
badk[z] <- 0   for (z) in 0 .. 0 if now[0] > capw[0]
badk[z] <- 0   for (z) in 0 .. 0 if nrl[0] > capr[0]
# **符号面だけ見張りが無かった。** 一度書いて外している —— `codelen`
# （バイト数）で見ようとしたからで、それは循環する（符号 → 長さ → 断り →
# 符号）。だが **命令の数** `nins` は循環しない: 規則と輪の数だけで決まり、
# 命令を一本も置く前に分かっている。ここを見ていなかったので、規則を 81 本
# 足した日に 131,072 本を越え、**黙って終了コード 6** が出た（知らせも
# 出ない —— 知らせを書く命令そのものが地図の外だったからである）。
field capi : max bound 1            # 命令ごとの箱（form / imm / jt … の bound）
capi[0] <- 262144
badk[z] <- 0   for (z) in 0 .. 0 if nins[0] > capi[0]
# **種にも見張りが無かった。** 種は「輪の無い規則」—— `x[3] <- 1` の形で、
# .lx を書いていると気づかないうちに増える（宣言の既定値、表の頭、
# 命令の綴り…）。1024 本目を書いた日に黙って落ちる、いちばん踏みやすい床。
field caps : max bound 1            # 種ごとの箱（sdf / sdc / sdv / sdp … の bound）
caps[0] <- 8192
badk[z] <- 0   for (z) in 0 .. 0 if nsd[0] > caps[0]
# **詰め直しの置き場も見る。** 上の `rcap` の所に「`out` の升数が
# rcap + 65536 を超えると、詰め直しが地図の外へ出る」と **書いてあった** ——
# 註だけで、検査は無かった。`total` を 1 MB に上げた日、焼いた道具は
# tiny な .lx でも segfault した。**註は見張りではない。**
field pcap : max bound 1            # 詰め直しの置き場（`out` はこれを超えられない）
pcap[z] <- rcap[0] + 65536   for (z) in 0 .. 0
# **置き場は描く場の升数でも取る**（`pbsz` の二行目: 描く本の置き場は `fsz[描く場]` 以上）。
# 焼き手自身の描く場は `out`（`total` 升）なので、焼き手の置き場は必ず `total` を容れる ——
# `rcap` を像に合わせて上げる必要は無い（09-23: 像を 2 MB にしたとき、rcap まで上げたら
# 生バイトの表（一文字 16 バイト）が 16 MB 太り、attest.lx の置き場が 2 GB を越えた）。
pcap[z] <- total[0]   for (z) in 0 .. 0
badk[z] <- 0   for (z) in 0 .. 0 if total[0] > pcap[0]

#   **符号の長さだけは、ここでは言えない。** 断りは命令を書く（`form[0..7]`）
#   ので、`codelen` を見て断ると 符号 → 長さ → 断り → 符号 の輪になる ——
#   処理系が正しく棄却した。だから長さは **ELF の頭（8..10 バイト目）に書いて
