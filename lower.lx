tpc[6, 16] <- 32
tpc[6, 17] <- 102
tpc[6, 18] <- 108
tpc[6, 19] <- 97
tpc[6, 20] <- 116
tpc[6, 21] <- 32
tpc[6, 22] <- 98
tpc[6, 23] <- 111
tpc[6, 24] <- 117
tpc[6, 25] <- 110
tpc[6, 26] <- 100
tpc[6, 27] <- 32
tph[6, 28] <- 3
