lx[crow[c], j + 1] <- lnw[cnd[c], 7]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 8
lx[crow[c], j + 1] <- lnw[cnd[c], 8]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 9
lx[crow[c], j + 1] <- lnw[cnd[c], 9]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 10
lx[crow[c], j + 1] <- lnw[cnd[c], 10]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 11
lx[crow[c], j + 1] <- lnw[cnd[c], 11]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 12
lx[crow[c], j + 1] <- lnw[cnd[c], 12]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 13
lx[crow[c], j + 1] <- lnw[cnd[c], 13]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 14
lx[crow[c], j + 1] <- lnw[cnd[c], 14]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 15
lx[crow[c], j + 1] <- lnw[cnd[c], 15]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 16
lx[crow[c], j + 1] <- tch[cnm[c], 0]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpm[cti[c], j] == 1
lx[crow[c], j + 1] <- tch[cnm[c], 1]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpm[cti[c], j] == 2
lx[crow[c], j + 1] <- tch[cnm[c], 2]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpm[cti[c], j] == 3
lx[crow[c], j + 1] <- tch[cnm[c], 3]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpm[cti[c], j] == 4
lx[crow[c], j + 1] <- tch[cnm[c], 4]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpm[cti[c], j] == 5
lx[crow[c], j + 1] <- tch[cnm[c], 5]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpm[cti[c], j] == 6
lx[crow[c], j + 1] <- tch[cnm[c], 6]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpm[cti[c], j] == 7
lx[crow[c], j + 1] <- tch[cnm[c], 7]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpm[cti[c], j] == 8
# ── 穴の桁ここまで ──
# <</digits>>
lk3[i, 0] <- lk[i] % 256           for (i) in 0 .. lkz[0]
lk3[i, 1] <- lk[i] / 256 % 256     for (i) in 0 .. lkz[0]
lk3[i, 2] <- lk[i] / 65536         for (i) in 0 .. lkz[0]
render lx
render lk3
