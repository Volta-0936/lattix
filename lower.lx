tpd[0, 17] <- 4
tph[0, 18] <- 2
tpd[0, 18] <- 3
tph[0, 19] <- 2
tpd[0, 19] <- 2
tph[0, 20] <- 2
tpd[0, 20] <- 1
tph[0, 21] <- 2
tpd[0, 21] <- 0
