# 型紙 131〜141: 構成子
#   出現 u の帯: 宣言 `field _st<u> : max bound B0 [B1]`・出現の中の番号の規則（基は 0 —— 共有の表の番号は
#   塊が列 31 に `x + 基` と置く）・帯の構成子 `_sk[基 .. 基+幅-1] <- k`
#   （実例は出現の `(` に置く —— 名のトークンは、外の出現の引数の区間の頭になりうる）
field kb0 : max bound 262144                # 出現 u の鍵の広さ（最初の引数の塊の広さ）
kb0[u] <- lab0[kr0[u]]             for (u,zc) in ch if kok[u]
field kb1 : max bound 262144
kb1[u] <- 1                        for (u,zc) in ch if kok[u]
kb1[u] <- lab1[kr0[u]]             for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 2
field kbw : max bound 262144                # 帯の幅
kbw[u] <- kb0[u] * kb1[u]          for (u,zc) in ch if kok[u]
field kbs : max bound 262144                # 帯の基（出現の順の前置きの鎖）
kbs[0] <- 0
kbs[t] <- kbs[t-1] + kbw[t-1]      for (t,zc) in ch if t >= 1 if kok[t-1]
kbs[t] <- kbs[t-1]                 for (t,zc) in ch if t >= 1 if not kok[t-1]
field ksz2 : max bound 1                    # 最後の場所の番号
ksz2[z] <- kbs[u] + kbw[u] - 1     for (u,zc) in ch for (z) in 0 .. 0 if kok[u]
iti[lin[kao[u]], 0] <- 131              for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 1
iti[lin[kao[u]], 0] <- 132              for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 2
ih0[lin[kao[u]], 0] <- u                for (u,zc) in ch if kok[u]
ih1[lin[kao[u]], 0] <- kb0[u]           for (u,zc) in ch if kok[u]
ih2[lin[kao[u]], 0] <- kb1[u]           for (u,zc) in ch if kok[u]
iti[lin[kao[u]], 1] <- 133              for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 1
iti[lin[kao[u]], 1] <- 134              for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 2
ih0[lin[kao[u]], 1] <- u                for (u,zc) in ch if kok[u]
ih1[lin[kao[u]], 1] <- kb1[u]           for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 2
ih1[lin[kao[u]], 1] <- 0                for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 1
ih2[lin[kao[u]], 1] <- 0                for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 2
ih2[lin[kao[u]], 1] <- kb0[u] - 1       for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 1
iti[lin[kao[u]], 2] <- 135              for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 2
ih0[lin[kao[u]], 2] <- kb0[u] - 1       for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 2
ih1[lin[kao[u]], 2] <- kb1[u] - 1       for (u,zc) in ch if kok[u] if lkyn[kr0[u]] == 2
iti[lin[kao[u]], 3] <- 136              for (u,zc) in ch if kok[u]
ih0[lin[kao[u]], 3] <- kap[u]           for (u,zc) in ch if kok[u]
ih1[lin[kao[u]], 3] <- kbs[u]           for (u,zc) in ch if kok[u]
ih2[lin[kao[u]], 3] <- kbs[u] + kbw[u] - 1   for (u,zc) in ch if kok[u]
#   宣言の種: `_kn[k] <- n` / `_knl[k] <- 名の長さ`（名のトークン）/ `_knm[k, j] <- 字`（名の字ごと）
field kcd : max bound 262144                # 構成子の名のトークン t → 番号（宣言）
kcd[nextw[t]] <- kcq[snum[t]]      for (t,zc) in ch if kwctr[t] if sbrk[t]
iti[lin[t], 0] <- 137              for (t,zc) in ch if kcd[t] >= 0
ih0[lin[t], 0] <- kcd[t]           for (t,zc) in ch if kcd[t] >= 0
ih1[lin[t], 0] <- kca[kcd[t]]      for (t,zc) in ch if kcd[t] >= 0
iti[lin[t], 1] <- 138              for (t,zc) in ch if kcd[t] >= 0
ih0[lin[t], 1] <- kcd[t]           for (t,zc) in ch if kcd[t] >= 0
ih1[lin[t], 1] <- tlen[t]          for (t,zc) in ch if kcd[t] >= 0
field kcdc : max bound 262144               # 名の字 i の構成子の番号
kcdc[i] <- kcd[tnum[i]]            for (i,c) in ch if kcd[tnum[i]] >= 0
iti[i + 127, 2] <- 139             for (i,c) in ch if kcdc[i] >= 0 if cpos[i] <= 15
ih0[i + 127, 2] <- kcdc[i]         for (i,c) in ch if kcdc[i] >= 0 if cpos[i] <= 15
ih1[i + 127, 2] <- cpos[i]         for (i,c) in ch if kcdc[i] >= 0 if cpos[i] <= 15
ih2[i + 127, 2] <- c               for (i,c) in ch if kcdc[i] >= 0 if cpos[i] <= 15
#   場所の数と項の字の広さ（構成子の在る本だけ。実例は源の字に居ない番号 10）
iti[10, 0] <- 140                  for (z) in 0 .. 0 if ksz2[0] >= 0
ih0[10, 0] <- ksz2[0]              for (z) in 0 .. 0
iti[10, 1] <- 141                  for (z) in 0 .. 0 if kcz[0] >= 0
#   **出現ごとの塊**（work/mklower.py の BLOCK）: 値の道を出現の場 `_c<A>` に閉じる。塊は長いので、
#   型紙の実例（位置ごとに八つ）ではなく、出現の密な番号 a の行 `lb[a, 升]` に帯をそのまま刷る
field kan : max bound 262144                # 出現 u の密な番号（出現の順の前置きの鎖）
kan[0] <- 0
kan[t] <- kan[t-1] + 1             for (t,zc) in ch if t >= 1 if kok[t-1]
kan[t] <- kan[t-1]                 for (t,zc) in ch if t >= 1 if not kok[t-1]
field kaz : max bound 1                     # 最後の密な番号
kaz[z] <- kan[u]                   for (u,zc) in ch for (z) in 0 .. 0 if kok[u]
field kbv0 : max bound 1024                 # 穴 0: 出現（名のトークン）
kbv0[kan[u]] <- u                  for (u,zc) in ch if kok[u]
field kbv1 : max bound 1024                 # 穴 1: 帯の幅 - 1
kbv1[kan[u]] <- kbw[u] - 1         for (u,zc) in ch if kok[u]
field kbv2 : max bound 1024                 # 穴 2: 帯の幅
kbv2[kan[u]] <- kbw[u]             for (u,zc) in ch if kok[u]
field kbv3 : max bound 1024                 # 穴 3: 帯の基（共有の表の場所の番号）
kbv3[kan[u]] <- kbs[u]             for (u,zc) in ch if kok[u]
field kbv4 : max bound 1024                 # 穴 4: 構成子
kbv4[kan[u]] <- kap[u]             for (u,zc) in ch if kok[u]
field kbv5 : max bound 1024                 # 穴 5・6: 折り込みの終わりの列（16 / 20 + 引数の数）
kbv5[kan[u]] <- kca[kap[u]] + 16   for (u,zc) in ch if kok[u]
field kbv6 : max bound 1024
kbv6[kan[u]] <- kca[kap[u]] + 20   for (u,zc) in ch if kok[u]
field bt : max bound 448                    # 塊の帯（三バイトずつ）
field btz : max bound 1
field btp : max bound 448 3
btp[i, j] <- i * 3 + j             for (i) in 0 .. btz[0] for (j) in 0 .. 2
field btb : max bound 1344                  # 帯の升 p のバイト
btb[btp[i, 0]] <- bt[i] % 256      for (i) in 0 .. btz[0]
btb[btp[i, 1]] <- bt[i] / 256 % 256   for (i) in 0 .. btz[0]
btb[btp[i, 2]] <- bt[i] / 65536    for (i) in 0 .. btz[0]
field btn : max bound 1
btn[z] <- btz[0] * 3 + 2           for (z) in 0 .. 0
field bdig : max bound 1024 256             # 出現 a の、穴の升の符号 128 + 16 穴 + 桁 → 字（届かない桁は ⊥）
# <<blocks>>
