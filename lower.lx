bdig[a, 150] <- 48 + kbv1[a] / 1000000 % 10   for (a) in 0 .. kaz[0] if kbv1[a] >= 1000000
bdig[a, 160] <- 48 + kbv2[a] % 10   for (a) in 0 .. kaz[0]
bdig[a, 161] <- 48 + kbv2[a] / 10 % 10   for (a) in 0 .. kaz[0] if kbv2[a] >= 10
