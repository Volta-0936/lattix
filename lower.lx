bdig[a, 225] <- 48 + kbv6[a] / 10 % 10   for (a) in 0 .. kaz[0] if kbv6[a] >= 10
# <</blocks>>
field lb : max bound 1024 1344              # 出現 a の塊の升 p
lb[a, p] <- btb[p]                 for (a) in 0 .. kaz[0] for (p) in 0 .. btn[0] if btb[p] >= 1 if btb[p] <= 127
lb[a, p] <- bdig[a, btb[p]]        for (a) in 0 .. kaz[0] for (p) in 0 .. btn[0] if btb[p] >= 128

# ANF（30〜47）: 区間の最初のトークン ta の実例に e = 1..7 で並べる（e = 0 はトークン自身の差し替え）
#   1 塊の頭 A / 2 塊の頭 B / 3・4 ループの節 / 5 宣言 / 6・7 本文の参照 A・B
field las : max bound 262144                # 区間 ta の文
las[t] <- snum[t]                  for (t,zc) in ch if lsa[t]
# 塊の場の次元 = 区間が使うループ（一つか二つ。一つも使わなければ文のループ 0 —— 一点の文なら `_z`）
field lrany : or bound 262144               # 区間はどれかのループを使う
lrany[t] <- true                   for (t,zc) in ch for (l) in 0 .. 7 if lru[t, l]
field lky0 : max bound 262144               # 塊の次元0 のループ
lky0[t] <- lrn0[t]                 for (t,zc) in ch if lsa[t] if lrany[t] if not krf[t]
lky0[t] <- 0                       for (t,zc) in ch if lsa[t] if not lrany[t] if not krf[t]
lky0[t] <- ku0[kra[t]]             for (t,zc) in ch if lsa[t] if krf[t] if kuf[kra[t]]
lky0[t] <- 0                       for (t,zc) in ch if lsa[t] if krf[t] if not kuf[kra[t]]
field lky1 : max bound 262144               # 塊の次元1 のループ（無ければ ⊥）
lky1[t] <- lrn1[t]                 for (t,zc) in ch if lsa[t] if lrany[t] if lrn1[t] > lrn0[t] if not krf[t]
lky1[t] <- ku1[kra[t]]             for (t,zc) in ch if lsa[t] if krf[t] if ku1[kra[t]] > ku0[kra[t]]
# **ループに依らない上端**（`0 .. nfile[] - 1`）は一点の塊にする（`_g[_z] <- … for (_z) in 0 .. 0`、
# 本文は `_g[0]` —— 種2 の形）。文のループ 0 を鍵にすると、上端がそのループ自身なら
# `for (i) in 0 .. _g[i]` の輪になる（13g で持ち上げを足した日に 30_build で出た）
field lrb0 : or bound 262144                # 区間の上端で、どのループも使わない
lrb0[t] <- true                    for (t,zc) in ch if lsa[t] if lrbc[t] if not lrany[t]
field lkyn : max bound 262144               # 塊の次元の数
lkyn[t] <- 1                       for (t,zc) in ch if lsa[t]
lkyn[t] <- 2                       for (t,zc) in ch if lsa[t] if lky1[t] >= 0
field lak0 : max bound 262144               # 塊の次元0 のループの書き方
lak0[t] <- lkk[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
lak0[t] <- 4                       for (t,zc) in ch if lrb0[t]            # 一点（`_z`）
field lak1 : max bound 262144               # 次元1 のループの書き方（無ければ ⊥）
lak1[t] <- lkk[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lav0 : max bound 262144
lav0[t] <- lkv[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field lav1 : max bound 262144
lav1[t] <- lkv[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lal0 : max bound 262144
lal0[t] <- lkl[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field lal1 : max bound 262144
lal1[t] <- lkl[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lah0 : max bound 262144
lah0[t] <- lkh[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field lah1 : max bound 262144
lah1[t] <- lkh[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field laf0 : max bound 262144
laf0[t] <- lkf[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field laf1 : max bound 262144
laf1[t] <- lkf[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lab0 : max bound 262144
lab0[t] <- lkb[las[t], lky0[t]]    for (t,zc) in ch if lsa[t]
field lab1 : max bound 262144
lab1[t] <- lkb[las[t], lky1[t]]    for (t,zc) in ch if lsa[t] if lkyn[t] == 2
field lae : max bound 262144                # 塊の字の後ろの行（ループの節の一行目）
lae[t] <- lhbk[t] + lcl[t] + 2      for (t,zc) in ch if lsa[t]
field lap : max bound 262144                # 参照の行: 親の塊の中の自分の最初の字の行（親が無ければ本文）
lap[t] <- lcs[t]                   for (t,zc) in ch if lsa[t] if ldp[t] == 1
lap[t] <- lhbk[lcpa[t]] + 2 + lcs[t] - lcs[lcpa[t]]   for (t,zc) in ch if lsa[t] if ldp[t] >= 2
# 1: 塊の頭 A
iti[lin[t], 1] <- 30               for (t,zc) in ch if lak0[t] == 1 if not krf[t]
iti[lin[t], 1] <- 31               for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3 if not krf[t]
iti[lin[t], 1] <- 32               for (t,zc) in ch if lak0[t] == 4 if not krf[t]
ih0[lin[t], 1] <- t                for (t,zc) in ch if lsa[t] if not krf[t]
#   構成子の引数: `_sv[_st<A>[鍵], i] <- `（原子なら `_sva`）。穴 0 は出現の名のトークン
field kat : or bound 262144                 # 引数の区間は原子を指す
kat[t] <- true                     for (t,zc) in ch if lsa[t] if krf[t] if ltat[t]
iti[lin[t], 1] <- 116              for (t,zc) in ch if lak0[t] == 1 if krf[t] if not kat[t]
iti[lin[t], 1] <- 117              for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3 if krf[t] if not kat[t]
iti[lin[t], 1] <- 118              for (t,zc) in ch if lak0[t] == 4 if krf[t] if not kat[t]
iti[lin[t], 1] <- 119              for (t,zc) in ch if lak0[t] == 1 if kat[t]
iti[lin[t], 1] <- 120              for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3 if kat[t]
iti[lin[t], 1] <- 121              for (t,zc) in ch if lak0[t] == 4 if kat[t]
ih0[lin[t], 1] <- kra[t]           for (t,zc) in ch if lsa[t] if krf[t]
ih1[lin[t], 1] <- lal0[t]          for (t,zc) in ch if lak0[t] == 1
inm[lin[t], 1] <- lav0[t]          for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3
irw[lin[t], 1] <- lhbk[t]           for (t,zc) in ch if lsa[t]
ibd[lin[t], 1] <- true             for (t,zc) in ch if lsa[t]
# 2: 塊の頭 B
iti[lin[t], 2] <- 33               for (t,zc) in ch if lsa[t] if lkyn[t] == 1 if not krf[t]
iti[lin[t], 2] <- 34               for (t,zc) in ch if lak1[t] == 1 if not krf[t]
iti[lin[t], 2] <- 35               for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3 if not krf[t]
iti[lin[t], 2] <- 122              for (t,zc) in ch if lsa[t] if lkyn[t] == 1 if krf[t]
iti[lin[t], 2] <- 123              for (t,zc) in ch if lak1[t] == 1 if krf[t]
iti[lin[t], 2] <- 124              for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3 if krf[t]
ih2[lin[t], 2] <- kri[t]           for (t,zc) in ch if lsa[t] if krf[t]
ih1[lin[t], 2] <- lal1[t]          for (t,zc) in ch if lak1[t] == 1
inm[lin[t], 2] <- lav1[t]          for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3
irw[lin[t], 2] <- lhbk[t] + 1       for (t,zc) in ch if lsa[t]
ibd[lin[t], 2] <- true             for (t,zc) in ch if lsa[t]
# 3・4: ループの節
iti[lin[t], 3] <- 36               for (t,zc) in ch if lak0[t] == 1
iti[lin[t], 3] <- 37               for (t,zc) in ch if lak0[t] == 2
iti[lin[t], 3] <- 38               for (t,zc) in ch if lak0[t] == 3
iti[lin[t], 3] <- 39               for (t,zc) in ch if lak0[t] == 4
ih0[lin[t], 3] <- lal0[t]          for (t,zc) in ch if lak0[t] >= 1 if lak0[t] <= 3
ih1[lin[t], 3] <- lah0[t]          for (t,zc) in ch if lak0[t] >= 1 if lak0[t] <= 3
inm[lin[t], 3] <- lav0[t]          for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3
ind[lin[t], 3] <- laf0[t]          for (t,zc) in ch if lak0[t] == 3
irw[lin[t], 3] <- lae[t]           for (t,zc) in ch if lsa[t]
ibd[lin[t], 3] <- true             for (t,zc) in ch if lsa[t]
iti[lin[t], 4] <- 36               for (t,zc) in ch if lak1[t] == 1
iti[lin[t], 4] <- 37               for (t,zc) in ch if lak1[t] == 2
iti[lin[t], 4] <- 38               for (t,zc) in ch if lak1[t] == 3
ih0[lin[t], 4] <- lal1[t]          for (t,zc) in ch if lak1[t] >= 1
ih1[lin[t], 4] <- lah1[t]          for (t,zc) in ch if lak1[t] >= 1
inm[lin[t], 4] <- lav1[t]          for (t,zc) in ch if lak1[t] >= 2
ind[lin[t], 4] <- laf1[t]          for (t,zc) in ch if lak1[t] == 3
irw[lin[t], 4] <- lae[t] + 1       for (t,zc) in ch if lak1[t] >= 1
ibd[lin[t], 4] <- true             for (t,zc) in ch if lak1[t] >= 1
# 5: 宣言
iti[lin[t], 5] <- 40               for (t,zc) in ch if lsa[t] if lkyn[t] == 1 if not krf[t]
iti[lin[t], 5] <- 41               for (t,zc) in ch if lsa[t] if lkyn[t] == 2 if not krf[t]
ih0[lin[t], 5] <- t                for (t,zc) in ch if lsa[t]
ih1[lin[t], 5] <- lab0[t]          for (t,zc) in ch if lsa[t]
ih2[lin[t], 5] <- lab1[t]          for (t,zc) in ch if lsa[t] if lkyn[t] == 2
irw[lin[t], 5] <- lae[t] + 2       for (t,zc) in ch if lsa[t]
ibd[lin[t], 5] <- true             for (t,zc) in ch if lsa[t]
# 6・7: 本文の参照（区間の最初の字の行と、その次の行 —— どちらも字が塊へ移って空いている）
# 鍵が一つなら参照は **一行**（二行に割ると、字が一つの区間では二行目が次の字の行に落ちる）
iti[lin[t], 6] <- 42               for (t,zc) in ch if lak0[t] == 1 if not krf[t] if lkyn[t] == 2
iti[lin[t], 6] <- 43               for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3 if not krf[t] if lkyn[t] == 2
iti[lin[t], 6] <- 44               for (t,zc) in ch if lak0[t] == 4 if not krf[t] if lkyn[t] == 2
iti[lin[t], 6] <- 142              for (t,zc) in ch if lak0[t] == 1 if not krf[t] if lkyn[t] == 1 if not lbpr[t]
iti[lin[t], 6] <- 143              for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3 if not krf[t] if lkyn[t] == 1
      if not lbpr[t]
iti[lin[t], 6] <- 144              for (t,zc) in ch if lak0[t] == 4 if not krf[t] if lkyn[t] == 1 if not lbpr[t]
iti[lin[t], 6] <- 157              for (t,zc) in ch if lrb0[t] if not lbpr[t]   # `_g<ta>[0]`（144 より大きい）
#   裸の下端の参照は丸括弧で包む（13i。`in _g[i] .. n` は解釈実行が表の名と読む）
iti[lin[t], 6] <- 112              for (t,zc) in ch if lak0[t] == 1 if lkyn[t] == 1 if lbpr[t]
iti[lin[t], 6] <- 113              for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3 if lkyn[t] == 1 if lbpr[t]
iti[lin[t], 6] <- 114              for (t,zc) in ch if lak0[t] == 4 if lkyn[t] == 1 if lbpr[t] if not lrb0[t]
iti[lin[t], 6] <- 115              for (t,zc) in ch if lrb0[t] if lbpr[t]
ih0[lin[t], 6] <- t                for (t,zc) in ch if lsa[t] if not krf[t]
#   構成子の出現の本文の参照 `_sid[_st<A>[鍵]]` —— 最初の引数の区間の行に一つだけ（ほかの引数は参照を置かない）
field kr0f : or bound 262144                # 最初の引数の区間
kr0f[t] <- true                    for (t,zc) in ch if lsa[t] if krf[t] if kri[t] == 0
iti[lin[t], 6] <- 125              for (t,zc) in ch if lak0[t] == 1 if kr0f[t] if lkyn[t] == 2
iti[lin[t], 6] <- 126              for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3 if kr0f[t] if lkyn[t] == 2
iti[lin[t], 6] <- 127              for (t,zc) in ch if lak0[t] == 4 if kr0f[t] if lkyn[t] == 2
iti[lin[t], 6] <- 145              for (t,zc) in ch if lak0[t] == 1 if kr0f[t] if lkyn[t] == 1
iti[lin[t], 6] <- 146              for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3 if kr0f[t] if lkyn[t] == 1
iti[lin[t], 6] <- 147              for (t,zc) in ch if lak0[t] == 4 if kr0f[t] if lkyn[t] == 1
ih0[lin[t], 6] <- kra[t]           for (t,zc) in ch if kr0f[t]
ih1[lin[t], 6] <- lal0[t]          for (t,zc) in ch if lak0[t] == 1
inm[lin[t], 6] <- lav0[t]          for (t,zc) in ch if lak0[t] >= 2 if lak0[t] <= 3
irw[lin[t], 6] <- lap[t]           for (t,zc) in ch if lsa[t]
ibd[lin[t], 6] <- true             for (t,zc) in ch if lsa[t]
iti[lin[t], 7] <- 46               for (t,zc) in ch if lak1[t] == 1 if not krf[t]
iti[lin[t], 7] <- 47               for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3 if not krf[t]
iti[lin[t], 7] <- 129              for (t,zc) in ch if lak1[t] == 1 if kr0f[t]
iti[lin[t], 7] <- 130              for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3 if kr0f[t]
ih1[lin[t], 7] <- lal1[t]          for (t,zc) in ch if lak1[t] == 1
inm[lin[t], 7] <- lav1[t]          for (t,zc) in ch if lak1[t] >= 2 if lak1[t] <= 3
irw[lin[t], 7] <- lap[t] + 1       for (t,zc) in ch if lsa[t]
ibd[lin[t], 7] <- true             for (t,zc) in ch if lsa[t]

# ── 実例を詰める（字の順 → 番号の鎖）─────────────────────────────────────
field ipm : max bound 262272                # 実例 n の使う枠の数（最大の e + 1）
ipm[n] <- e + 1                    for (n) in 0 .. nnz[0] for (e) in 0 .. 7 if iti[n, e] >= 0
field ibs : max bound 262272                # 実例 n の最初の詰めた番号
ibs[0] <- 0
ibs[n] <- ibs[n-1] + ipm[n-1]      for (n) in 1 .. nnz[0] if ipm[n-1] >= 1
ibs[n] <- ibs[n-1]                 for (n) in 1 .. nnz[0] if not ipm[n-1]
field icid : max bound 262272 8             # 実例 [n, e] の詰めた番号
icid[n, e] <- ibs[n] + e           for (n) in 0 .. nnz[0] for (e) in 0 .. 7 if iti[n, e] >= 0
field ncz : max bound 1                     # 最後の詰めた番号
ncz[z] <- icid[n, e]               for (n) in 0 .. nnz[0] for (e) in 0 .. 7 for (z) in 0 .. 0
      if iti[n, e] >= 0
field cti : max bound 262144                # 詰めた実例 c の型紙
cti[icid[n, e]] <- iti[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field crow : max bound 262144               # 詰めた実例 c の行（本文の字、無ければ末尾の 262144 + c）
crow[icid[n, e]] <- irw[n, e]      for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field ctl : or bound 262144                 # 詰めた実例 c は末尾に置く
ctl[icid[n, e]] <- true            for (n) in 0 .. nnz[0] for (e) in 0 .. 7
      if iti[n, e] >= 0 if not ibd[n, e]
crow[c] <- c + 262144              for (c) in 0 .. ncz[0] if ctl[c]
field ch0 : max bound 262144
ch0[icid[n, e]] <- ih0[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field ch1 : max bound 262144
ch1[icid[n, e]] <- ih1[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field ch2 : max bound 262144
ch2[icid[n, e]] <- ih2[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field ch3 : max bound 262144
ch3[icid[n, e]] <- ih3[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field cnd : max bound 262144
cnd[icid[n, e]] <- ind[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7
field cnm : max bound 262144
cnm[icid[n, e]] <- inm[n, e]       for (n) in 0 .. nnz[0] for (e) in 0 .. 7

# ── 出す ───────────────────────────────────────────────────────────────
field lx : max bound 524288 64              # 行 r の升 s（⊥ は幅 0）
lx[lrw[i], 0] <- c                 for (i,c) in ch if not ldl[i]
lx[crow[c], j + 1] <- tpc[cti[c], j]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tpc[cti[c], j] >= 0
# <<digits>>
# ── 穴の桁と名前の升（work/mklower.py が起こす。手で直さない）──
lx[crow[c], j + 1] <- 48 + ch0[c] % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 0
lx[crow[c], j + 1] <- 48 + ch0[c] / 10 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 1 if ch0[c] >= 10
lx[crow[c], j + 1] <- 48 + ch0[c] / 100 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 2 if ch0[c] >= 100
lx[crow[c], j + 1] <- 48 + ch0[c] / 1000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 3 if ch0[c] >= 1000
lx[crow[c], j + 1] <- 48 + ch0[c] / 10000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 4 if ch0[c] >= 10000
lx[crow[c], j + 1] <- 48 + ch0[c] / 100000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 5 if ch0[c] >= 100000
lx[crow[c], j + 1] <- 48 + ch0[c] / 1000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 6 if ch0[c] >= 1000000
lx[crow[c], j + 1] <- 48 + ch0[c] / 10000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 7 if ch0[c] >= 10000000
lx[crow[c], j + 1] <- 48 + ch0[c] / 100000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 8 if ch0[c] >= 100000000
lx[crow[c], j + 1] <- 48 + ch0[c] / 1000000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 1 if tpd[cti[c], j] == 9 if ch0[c] >= 1000000000
lx[crow[c], j + 1] <- 48 + ch1[c] % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 0
lx[crow[c], j + 1] <- 48 + ch1[c] / 10 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 1 if ch1[c] >= 10
lx[crow[c], j + 1] <- 48 + ch1[c] / 100 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 2 if ch1[c] >= 100
lx[crow[c], j + 1] <- 48 + ch1[c] / 1000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 3 if ch1[c] >= 1000
lx[crow[c], j + 1] <- 48 + ch1[c] / 10000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 4 if ch1[c] >= 10000
lx[crow[c], j + 1] <- 48 + ch1[c] / 100000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 5 if ch1[c] >= 100000
lx[crow[c], j + 1] <- 48 + ch1[c] / 1000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 6 if ch1[c] >= 1000000
lx[crow[c], j + 1] <- 48 + ch1[c] / 10000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 7 if ch1[c] >= 10000000
lx[crow[c], j + 1] <- 48 + ch1[c] / 100000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 8 if ch1[c] >= 100000000
lx[crow[c], j + 1] <- 48 + ch1[c] / 1000000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 2 if tpd[cti[c], j] == 9 if ch1[c] >= 1000000000
lx[crow[c], j + 1] <- 48 + ch2[c] % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 0
lx[crow[c], j + 1] <- 48 + ch2[c] / 10 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 1 if ch2[c] >= 10
lx[crow[c], j + 1] <- 48 + ch2[c] / 100 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 2 if ch2[c] >= 100
lx[crow[c], j + 1] <- 48 + ch2[c] / 1000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 3 if ch2[c] >= 1000
lx[crow[c], j + 1] <- 48 + ch2[c] / 10000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 4 if ch2[c] >= 10000
lx[crow[c], j + 1] <- 48 + ch2[c] / 100000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 5 if ch2[c] >= 100000
lx[crow[c], j + 1] <- 48 + ch2[c] / 1000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 3 if tpd[cti[c], j] == 6 if ch2[c] >= 1000000
lx[crow[c], j + 1] <- 48 + ch2[c] / 10000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
