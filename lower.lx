bdig[a, 177] <- 48 + kbv3[a] / 10 % 10   for (a) in 0 .. kaz[0] if kbv3[a] >= 10
bdig[a, 178] <- 48 + kbv3[a] / 100 % 10   for (a) in 0 .. kaz[0] if kbv3[a] >= 100
bdig[a, 179] <- 48 + kbv3[a] / 1000 % 10   for (a) in 0 .. kaz[0] if kbv3[a] >= 1000
bdig[a, 180] <- 48 + kbv3[a] / 10000 % 10   for (a) in 0 .. kaz[0] if kbv3[a] >= 10000
bdig[a, 181] <- 48 + kbv3[a] / 100000 % 10   for (a) in 0 .. kaz[0] if kbv3[a] >= 100000
bdig[a, 182] <- 48 + kbv3[a] / 1000000 % 10   for (a) in 0 .. kaz[0] if kbv3[a] >= 1000000
