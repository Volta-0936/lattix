btz[0] <- 444
bdig[a, 128] <- 48 + kbv0[a] % 10   for (a) in 0 .. kaz[0]
bdig[a, 129] <- 48 + kbv0[a] / 10 % 10   for (a) in 0 .. kaz[0] if kbv0[a] >= 10
bdig[a, 130] <- 48 + kbv0[a] / 100 % 10   for (a) in 0 .. kaz[0] if kbv0[a] >= 100
bdig[a, 131] <- 48 + kbv0[a] / 1000 % 10   for (a) in 0 .. kaz[0] if kbv0[a] >= 1000
