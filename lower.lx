# 型紙 70〜: print の機械の **行で引く場の宣言**（行の数 = print の升の数の和 + 1。本ごとに違う ——
# 前は機械が 65,536 行と書いていた。実例は源の字に居ない番号 0.. に置く。項の字の広さは構成子の在る本だけ）
field lrz : max bound 1
lrz[z] <- 1                        for (z) in 0 .. 0
lrz[z] <- lpe[t] + 1               for (t,zc) in ch for (z) in 0 .. 0 if lpo[t]
field ltw : max bound 1                     # 項の字の広さ
ltw[z] <- 1                        for (z) in 0 .. 0
field lcw : max bound 1                     # `_o` の広さ（構成子の在る本は項の字の席 87 + 1024）
lcw[z] <- 116                      for (z) in 0 .. 0
lcw[z] <- 1111                     for (z) in 0 .. 0 if kcz[0] >= 0
# 項の節の場（`_V0`〜`_VG`）の広さ: 構成子が無ければ 1 × 1（書かれないので置き場だけの場だった）
field lrzv : max bound 1
lrzv[z] <- 1                       for (z) in 0 .. 0
lrzv[z] <- lrz[0]                  for (z) in 0 .. 0 if kcz[0] >= 0
field lcwv : max bound 1
lcwv[z] <- 1                       for (z) in 0 .. 0
lcwv[z] <- lcw[0]                  for (z) in 0 .. 0 if kcz[0] >= 0
