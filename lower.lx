      if tph[cti[c], j] == 4 if tpd[cti[c], j] == 3 if ch3[c] >= 1000
lx[crow[c], j + 1] <- 48 + ch3[c] / 10000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 4 if tpd[cti[c], j] == 4 if ch3[c] >= 10000
lx[crow[c], j + 1] <- 48 + ch3[c] / 100000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 4 if tpd[cti[c], j] == 5 if ch3[c] >= 100000
lx[crow[c], j + 1] <- 48 + ch3[c] / 1000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 4 if tpd[cti[c], j] == 6 if ch3[c] >= 1000000
lx[crow[c], j + 1] <- 48 + ch3[c] / 10000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 4 if tpd[cti[c], j] == 7 if ch3[c] >= 10000000
lx[crow[c], j + 1] <- 48 + ch3[c] / 100000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 4 if tpd[cti[c], j] == 8 if ch3[c] >= 100000000
lx[crow[c], j + 1] <- 48 + ch3[c] / 1000000000 % 10   for (c) in 0 .. ncz[0] for (j) in 0 .. 62
      if tph[cti[c], j] == 4 if tpd[cti[c], j] == 9 if ch3[c] >= 1000000000
lx[crow[c], j + 1] <- dch[cnd[c], 0]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 1
lx[crow[c], j + 1] <- dch[cnd[c], 1]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 2
lx[crow[c], j + 1] <- dch[cnd[c], 2]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 3
lx[crow[c], j + 1] <- dch[cnd[c], 3]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 4
lx[crow[c], j + 1] <- dch[cnd[c], 4]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 5
lx[crow[c], j + 1] <- dch[cnd[c], 5]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 6
