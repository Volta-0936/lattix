bdig[a, 133] <- 48 + kbv0[a] / 100000 % 10   for (a) in 0 .. kaz[0] if kbv0[a] >= 100000
bdig[a, 144] <- 48 + kbv1[a] % 10   for (a) in 0 .. kaz[0]
bdig[a, 145] <- 48 + kbv1[a] / 10 % 10   for (a) in 0 .. kaz[0] if kbv1[a] >= 10
bdig[a, 146] <- 48 + kbv1[a] / 100 % 10   for (a) in 0 .. kaz[0] if kbv1[a] >= 100
