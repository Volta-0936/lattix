lx[crow[c], j + 1] <- dch[cnd[c], 10]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 11
lx[crow[c], j + 1] <- dch[cnd[c], 11]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 12
lx[crow[c], j + 1] <- dch[cnd[c], 12]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 13
lx[crow[c], j + 1] <- dch[cnd[c], 13]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 14
lx[crow[c], j + 1] <- dch[cnd[c], 14]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 15
lx[crow[c], j + 1] <- dch[cnd[c], 15]   for (c) in 0 .. ncz[0] for (j) in 0 .. 62 if tpn[cti[c], j] == 16
