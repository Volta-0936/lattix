# ── 帯ここまで ──
# <</templates>>

# ── トークンの終わりと数 ─────────────────────────────────────────────────
field lte : max bound 262144                # トークン t の最後の字
lte[t] <- tstart[t] + tlen[t] - 1   for (t,zc) in ch if tlen[t] >= 1
field lin : max bound 262144                # トークン t の実例の番号（最後の字 + 127）
lin[t] <- lte[t] + 127              for (t,zc) in ch if tlen[t] >= 1
field lis : max bound 262144                # トークン t の最初の字の実例の番号
lis[t] <- tstart[t] + 127           for (t,zc) in ch if tlen[t] >= 1
field nnz : max bound 1                     # 最後の実例の番号
nnz[z] <- i + 127                   for (i,c) in ch for (z) in 0 .. 0

# ── 束縛は十まで ─────────────────────────────────────────────────────────
# 前はここで 33_self の六つに四つ足していた。いまは 33_self が鍵で十まで引く（`bnt` / `bky`）
# —— 同じ判断を二箇所に持たない（気づき34）。

# **出現 t の場（0 起点）を値で一度引く。** 書き先の座標に `f[ofl[oseq[t]] - 1]` と書くと、宣言の無い
# 出現（ofl が ⊥）で焼いた本が 6 で止まる —— 焼き手の穴（三段の読みに後置のずれを付けた書き先は、
# ⊥ を見る前にずれを足してしまう。読みの側は正しい）。値で引けば ⊥ は規則ごと飛ぶ
field lof : max bound 262144
lof[t] <- ofl[oseq[t]] - 1         for (t,zc) in ch if isocc[t]

# ── 十七文字以上の場の名前 ─────────────────────────────────────────────
# 焼き手の名前は十六文字まで（鍵が二本 —— 気づき44）。長い名前の場は `_f<宣言の番号>` に付け替える。
# 付け替えた綴りは `lnw`（`@` の升が書く綴り —— print の規則が場を名指すのもこれ）。print の名の席は
# 元の綴りを三十二文字まで書く。（十六文字目まで同じで十七文字目から違う二つの名前は、前段の鍵が
# 同じ場と読む —— 焼き手と同じ限り）
field llg : or bound 1024                   # 宣言 d（1 起点）の名前は十七文字以上
llg[dseq[t]] <- true               for (t,zc) in ch if isdcl[t] if tlen[t] >= 17
field lnw : max bound 1024 16               # 宣言 d の下ろした後の綴り
lnw[d, k] <- dch[d, k]             for (d) in 0 .. ndcz[0] for (k) in 0 .. 15 if not llg[d]
lnw[d, 0] <- 95                    for (d) in 0 .. ndcz[0] if llg[d]
lnw[d, 1] <- 102                   for (d) in 0 .. ndcz[0] if llg[d]
lnw[d, 2] <- 48 + d % 10           for (d) in 0 .. ndcz[0] if llg[d] if d < 10
lnw[d, 2] <- 48 + d / 10 % 10      for (d) in 0 .. ndcz[0] if llg[d] if d >= 10 if d < 100
lnw[d, 3] <- 48 + d % 10           for (d) in 0 .. ndcz[0] if llg[d] if d >= 10 if d < 100
lnw[d, 2] <- 48 + d / 100 % 10     for (d) in 0 .. ndcz[0] if llg[d] if d >= 100 if d < 1000
lnw[d, 3] <- 48 + d / 10 % 10      for (d) in 0 .. ndcz[0] if llg[d] if d >= 100 if d < 1000
lnw[d, 4] <- 48 + d % 10           for (d) in 0 .. ndcz[0] if llg[d] if d >= 100 if d < 1000
lnw[d, 2] <- 48 + d / 1000 % 10    for (d) in 0 .. ndcz[0] if llg[d] if d >= 1000
lnw[d, 3] <- 48 + d / 100 % 10     for (d) in 0 .. ndcz[0] if llg[d] if d >= 1000
lnw[d, 4] <- 48 + d / 10 % 10      for (d) in 0 .. ndcz[0] if llg[d] if d >= 1000
lnw[d, 5] <- 48 + d % 10           for (d) in 0 .. ndcz[0] if llg[d] if d >= 1000
field lnt : max bound 262144                # 付け替える名のトークン → 宣言（1 起点）
lnt[t] <- dseq[t]                  for (t,zc) in ch if isdcl[t] if llg[dseq[t]]
lnt[t] <- ofl[oseq[t]]             for (t,zc) in ch if isocc[t] if llg[ofl[oseq[t]]] if not lpo[t]

# ── 構成子 ─────────────────────────────────────────────────────────────
# `constructor c(f1, …) bound N` は消して、print の機械の種（`_kn` 引数の数 / `_knm` 名 / `_knl` 名の長さ）に。
# `c(e1, …)` は **出現ごとの場** `_c<A>` へ: 引数ごとに ANF の塊を置き、塊の頭を `_c<A>[_st<A>[鍵], i] <- `
# （原子なら `_ca<A>`）に替える。塊の鍵は **出現の鍵**（全部の引数が使うループの和）。本文は
# `_c<A>[_st<A>[鍵], 30]` —— 番地は出現の塊（work/mklower.py の BLOCK）が **その出現の引数だけから** 折る。
# `_st<A>[x, y] = x * B1 + y` は出現の中の番号。print と番地の引きのための共有の表（`_sv` / `_sva` / `_sk`）へは
# 帯（基 = 前の出現の幅の和）に **写すだけ** で、値の道は共有の場を通らない（通すと場の粒度の成層で
# どの出現もどの出現にも依り、偽の非単調な輪ができる —— 22_parse がそうだった）。
# （項を座標にすることは、まだ下ろさない。アクセサの読みは 14d —— 下の「アクセサ」の節）
field kwctr : or bound 262144               # `constructor`（八文字までの綴りと長さで見る）
kwctr[t] <- true   for (t,zc) in ch if tlen[t] == 11 if not tcom[t] if tch[t,0] == 99 if tch[t,1] == 111
      if tch[t,2] == 110 if tch[t,3] == 115 if tch[t,4] == 116 if tch[t,5] == 114 if tch[t,6] == 117
      if tch[t,7] == 99
field kcs : or bound 8192                   # 文 s は構成子の宣言
kcs[snum[t]] <- true   for (t,zc) in ch if kwctr[t] if sbrk[t]
field kcq : max bound 8192                  # 文 s より前の構成子の宣言の数
kcq[s] <- 0            for (s) in 0 .. nstz[0]
kcq[s] <- kcq[s-1] + 1 for (s) in 1 .. nstz[0] if kcs[s-1]
kcq[s] <- kcq[s-1]     for (s) in 1 .. nstz[0] if not kcs[s-1]
field kct : max bound 64                    # 構成子 k の名のトークン
kct[kcq[snum[t]]] <- nextw[t]   for (t,zc) in ch if kwctr[t] if sbrk[t]
field kcz : max bound 1                     # 最後の構成子の番号
kcz[z] <- kcq[snum[t]]          for (t,zc) in ch for (z) in 0 .. 0 if kwctr[t] if sbrk[t]
field kca : max bound 64                    # 構成子 k の引数の数（名の後ろの括弧の中の語の列 + 1）
kca[kcq[snum[t]]] <- colc[t] + 1   for (t,zc) in ch if kcs[snum[t]] if tdep[t] == 1 if tkind[t] == 1
field kcn : max bound 262144                # 構成子の名のトークン → 番号
kcn[nextw[t]] <- kcq[snum[t]]   for (t,zc) in ch if kwctr[t] if sbrk[t]
# 名を比べる鍵（1〜8 文字目 / 9〜16 文字目。十六文字までは焼き手の名前と同じ）
field kkc : max bound 262144
kkc[i] <- c                     for (i,c) in ch if cpos[i] == 0
kkc[i] <- kkc[i-1] * 128 + c    for (i,c) in ch if i >= 1 if cpos[i] >= 1 if cpos[i] <= 7
field kkd : max bound 262144
kkd[i] <- c                     for (i,c) in ch if cpos[i] == 8
kkd[i] <- kkd[i-1] * 128 + c    for (i,c) in ch if i >= 1 if cpos[i] >= 9 if cpos[i] <= 15
field kk1 : max bound 262144
kk1[tnum[i]] <- kkc[i]          for (i,c) in ch if tkind[tnum[i]] == 1
field kk2 : max bound 262144
kk2[t] <- 0                     for (t,zc) in ch if tkind[t] == 1
kk2[tnum[i]] <- kkd[i]          for (i,c) in ch if tkind[tnum[i]] == 1
# 出現: 語の直後が `(` で、綴りが構成子の名（宣言の文の中は除く）
field kap : max bound 262144                # 出現の名のトークン u → 構成子の番号
kap[u] <- k    for (u,zc) in ch for (k) in 0 .. kcz[0] if tkind[u] == 1 if not tcom[u] if isopn[nextw[u]]
      if not kcs[snum[u]] if kk1[u] == kk1[kct[k]] if kk2[u] == kk2[kct[k]]
field kaf : or bound 262144                 # u は出現
kaf[u] <- true                  for (u,zc) in ch if kap[u] >= 0
field kao : max bound 262144                # 出現 u の `(`
kao[u] <- nextw[u]              for (u,zc) in ch if kaf[u]
field kac : max bound 262144                # その `)`
kac[u] <- lpc[kao[u]]           for (u,zc) in ch if kaf[u]
field kpo : max bound 262144                # `(` → 出現
kpo[kao[u]] <- u                for (u,zc) in ch if kaf[u]
field kpf : or bound 262144                 # 出現の `(`
kpf[kao[u]] <- true             for (u,zc) in ch if kaf[u]
# 区切り（出現の `(`・直下の `,`・`)`）と、その出現
field ksp : or bound 262144
ksp[kao[u]] <- true             for (u,zc) in ch if kaf[u]
ksp[kac[u]] <- true             for (u,zc) in ch if kaf[u]
ksp[c] <- true                  for (c,zc) in ch if iscom[c] if kpf[ibr[c]]
field ksa : max bound 262144
ksa[kao[u]] <- u                for (u,zc) in ch if kaf[u]
ksa[kac[u]] <- u                for (u,zc) in ch if kaf[u]
ksa[c] <- kpo[ibr[c]]           for (c,zc) in ch if iscom[c] if kpf[ibr[c]]
# 区切りに密な番号を振り（鎖）、同じ出現の次の区切りを比べて引く
field ksc : max bound 262144
ksc[0] <- 0
ksc[z] <- 1                     for (z) in 0 .. 0 if ksp[0]
ksc[t] <- ksc[t-1] + 1          for (t,zc) in ch if t >= 1 if ksp[t]
ksc[t] <- ksc[t-1]              for (t,zc) in ch if t >= 1 if not ksp[t]
field ksl : max bound 16384                 # 番号 j の区切り
ksl[ksc[t] - 1] <- t            for (t,zc) in ch if ksp[t]
field ksz : max bound 1
ksz[z] <- ksc[t] - 1            for (t,zc) in ch for (z) in 0 .. 0 if ksp[t]
field kny : min bound 262144                # 区切り x の、同じ出現の次の区切り
kny[ksl[a]] <- ksl[b]           for (a) in 0 .. ksz[0] for (b) in 0 .. ksz[0] if b > a
      if ksa[ksl[a]] == ksa[ksl[b]]
field kag : max bound 262144                # 区切り x の後ろの引数の番号
kag[kao[u]] <- 0                for (u,zc) in ch if kaf[u]
kag[kny[x]] <- kag[x] + 1       for (x,zc) in ch if ksp[x] if kny[x] >= 0
# 引数の区間（区切りの次の語から、次の区切りの前の語まで）—— 持ち上げる候補
field kas : max bound 262144                # 区切り x（`)` 以外）の後ろの引数の最初のトークン
kas[x] <- nextw[x]              for (x,zc) in ch if ksp[x] if kny[x] >= 0 if nextw[x] < kny[x]
field kra : max bound 262144                # 引数の区間の最初のトークン → 出現
kra[kas[x]] <- ksa[x]           for (x,zc) in ch if kas[x] >= 0
field kri : max bound 262144                # その引数の番号
kri[kas[x]] <- kag[x]           for (x,zc) in ch if kas[x] >= 0
field krf : or bound 262144                 # 引数の区間の最初のトークン
krf[kas[x]] <- true             for (x,zc) in ch if kas[x] >= 0
field kr0 : max bound 262144                # 出現 u の最初の引数の区間
kr0[ksa[x]] <- kas[x]           for (x,zc) in ch if kas[x] >= 0 if kag[x] == 0

# ── 表 ─────────────────────────────────────────────────────────────────
field tbk : max bound 8192                  # 文 s の表の番号（0 起点）
tbk[s] <- ctb[s] - 1                for (s) in 0 .. nstz[0] if istb[s]
field ntbz : max bound 1                    # 最後の表の番号
ntbz[z] <- tbk[s]                   for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if istb[s]
field tbn : max bound 16                    # 表 k の名のトークン
tbn[tbk[snum[t]]] <- nextw[t]       for (t,zc) in ch if kwtbl[t] if sbrk[t]
field nrw : max bound 16                    # 表 k の行数
nrw[tbk[snum[t]]] <- rowc[t]        for (t,zc) in ch if isnum[t] if istb[snum[t]] if tdep[t] == 1
# `table t = range(a, b)` は区間の表（行は a .. b-1 の一列）。ループは区間に書き換え、変数はそのまま
field kwrng : or bound 262144               # `range`
kwrng[t] <- true                    for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 114 if tch[t,1] == 97 if tch[t,2] == 110 if tch[t,3] == 103 if tch[t,4] == 101
field ltr : or bound 16                     # 表 k は range
ltr[tbk[snum[t]]] <- true           for (t,zc) in ch if kwrng[t] if istb[snum[t]]
field trl : max bound 16                    # range の下端
trl[tbk[snum[t]]] <- tval[t]        for (t,zc) in ch if isnum[t] if istb[snum[t]] if tdep[t] == 1
      if colc[t] == 0 if ltr[tbk[snum[t]]]
field trh : max bound 16                    # range の上端（含まない）
trh[tbk[snum[t]]] <- tval[t]        for (t,zc) in ch if isnum[t] if istb[snum[t]] if tdep[t] == 1
      if colc[t] == 1 if ltr[tbk[snum[t]]]
field isfr : or bound 262144                # 表の升の数（深さ一の数。range の表は升を持たない）
isfr[t] <- true                     for (t,zc) in ch if isnum[t] if istb[snum[t]] if tdep[t] == 1
      if not ltr[tbk[snum[t]]]

# ── `in t` の t はどの表か（綴りを比べる。八文字まで）───────────────────
field tnd : or bound 262144 16              # `in` の後ろの名と表 k の名の字が違う
tnd[u, k] <- true   for (u,zc) in ch for (k) in 0 .. ntbz[0] for (j) in 0 .. 7
      if kwin[u] if tch[int1[u], j] != tch[tbn[k], j]
field tix : max bound 262144                # `in` のトークン u が回す表
tix[u] <- k         for (u,zc) in ch for (k) in 0 .. ntbz[0]
      if kwin[u] if lkd[snum[u], lz[u]] == 0 if tlen[int1[u]] == tlen[tbn[k]] if not tnd[u, k]
field ltk : max bound 8192 8                # 文 s の for 節 L が回す表
ltk[snum[u], lz[u]] <- tix[u]       for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
field lft : max bound 8192 8                # 文 s の for 節 L の `for`
lft[snum[t], lz[t]] <- t            for (t,zc) in ch if kwfor[t] if lz[t] >= 0 if lz[t] <= 7
field lit : max bound 8192 8                # 文 s の for 節 L の表の名（表のループだけ）
lit[snum[u], lz[u]] <- int1[u]      for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
field lrn : max bound 262144                # range の表の名のトークン（`in` の後ろ）→ 表
lrn[int1[u]] <- tix[u]              for (u,zc) in ch if kwin[u] if ltr[tix[u]]

# ── 原子（綴り → 綴りの順の番号）───────────────────────────────────────
# 表の裸の名前（`tokyo`）と文字列（`"tokyo"`）は原子である。焼ける値は整数だけなので、**綴りの順の
# 番号**（0 起点）に置き換える —— 等しさも大小も min/max も、print の並び（解釈実行は綴りの辞書順に
# 並べる）もそのまま保たれる。print では番号を綴りに戻す（`_an[番号, k]`）。
# 記号表は作らない（気づき22・42）: 綴りを 6 バイトずつ四本の鍵に畳み（256 進 —— UTF-8 のバイト順は
# 符号点の順）、鍵の同じ最初の出現を正体にし、正体どうしを鍵で比べて **自分より小さい正体を数える**。
# 文字列は `"` の数の偶奇で切る（解釈実行と同じく一行の中で閉じる）。`emit "ch"`・`from "ch"`・
# `include "…"` の綴りは口や本の名前で値ではない —— 表と、矢印のある文の値・座標の中だけを原子にする。
field qq : or bound 262144                  # `"`
qq[t] <- true          for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 34
field qn : max bound 262144                 # t までの `"` の数（鎖）
qn[0] <- 0
qn[z] <- 1             for (z) in 0 .. 0 if qq[0]
qn[t] <- qn[t-1] + 1   for (t,zc) in ch if t >= 1 if qq[t]
qn[t] <- qn[t-1]       for (t,zc) in ch if t >= 1 if not qq[t]
field qpr : max bound 262144                # その偶奇（1 = 開きの `"` か、文字列の中）
qpr[t] <- qn[t] % 2    for (t,zc) in ch
field qa : max bound 262144                 # トークン t を含む文字列の開きの `"`（閉じも開きを指す）
qa[t] <- t             for (t,zc) in ch if qq[t] if qpr[t] == 1
qa[t] <- qa[t-1]       for (t,zc) in ch if t >= 1 if not qq[t] if qpr[t] == 1
qa[t] <- qa[t-1]       for (t,zc) in ch if t >= 1 if qq[t] if qpr[t] == 0
field qi : or bound 262144                  # 文字列の中身のトークン
qi[t] <- true          for (t,zc) in ch if not qq[t] if qpr[t] == 1
field qcl : max bound 262144                # 開きの `"` → 閉じの `"`
qcl[qa[t]] <- t        for (t,zc) in ch if qq[t] if qpr[t] == 0
field atv : or bound 262144                 # 原子の出現: 表の裸の名前か、原子にする文字列の開きの `"`
atv[t] <- true   for (t,zc) in ch if istb[snum[t]] if tdep[t] == 1 if tkind[t] == 1 if not isnum[t]
      if not tcom[t] if not qi[t] if not kwtru[t]
atv[t] <- true   for (t,zc) in ch if qq[t] if qpr[t] == 1 if istb[snum[t]]
atv[t] <- true   for (t,zc) in ch if qq[t] if qpr[t] == 1 if arrowt[snum[t]] >= 0 if t > arrowt[snum[t]]
atv[t] <- true   for (t,zc) in ch if qq[t] if qpr[t] == 1 if arrowt[snum[t]] >= 0 if t < arrowt[snum[t]]
      if tdep[t] >= 1
field atc : max bound 262144                # t までの原子の出現の数（鎖）
atc[0] <- 0
atc[z] <- 1            for (z) in 0 .. 0 if atv[0]
atc[t] <- atc[t-1] + 1 for (t,zc) in ch if t >= 1 if atv[t]
atc[t] <- atc[t-1]     for (t,zc) in ch if t >= 1 if not atv[t]
field atx : max bound 262144                # 出現 t の通し番号（0 起点。千二十四まで —— 越えれば 6 で言う）
atx[t] <- atc[t] - 1   for (t,zc) in ch if atv[t]
field atz : max bound 1                     # 最後の通し番号
atz[z] <- atx[t]       for (t,zc) in ch for (z) in 0 .. 0 if atv[t]
# 綴りの字: 裸の名前はトークンの字、文字列は開きの `"` の後ろから閉じの手前まで
field qat : max bound 262144                # 綴りを持つトークン t の出現の番号
qat[t] <- atx[t]       for (t,zc) in ch if atv[t] if not qq[t]
qat[t] <- atx[qa[t]]   for (t,zc) in ch if qi[t] if atv[qa[t]]
field atci : max bound 262144               # 字 i の出現の番号
atci[i] <- qat[tnum[i]]   for (i,c) in ch if qat[tnum[i]] >= 0
field atcp : max bound 262144               # 字 i の綴りの中の位置
atcp[i] <- cpos[i]        for (i,c) in ch if atv[tnum[i]] if not qq[tnum[i]]
atcp[i] <- i - tstart[qa[tnum[i]]] - 1   for (i,c) in ch if qi[tnum[i]] if atv[qa[tnum[i]]]
field atb : max bound 1024 24               # 出現 a の k バイト目（24 バイトまで。越えれば面の外 —— 6 で言う）
atb[atci[i], atcp[i]] <- c   for (i,c) in ch if atci[i] >= 0
field atl : max bound 1024                  # 出現 a のバイト数
atl[a] <- 0                  for (a) in 0 .. atz[0]
atl[atci[i]] <- atcp[i] + 1  for (i,c) in ch if atci[i] >= 0
# **⊥ は番兵ではない**（気づき22）—— 綴りの後ろは 0 で埋めてから畳む（短い綴りが先に並ぶ）
atb[a, k] <- 0               for (a) in 0 .. atz[0] for (k) in 0 .. 23 if k >= atl[a]
field atkk : max bound 1024 24              # 鍵を畳む途中（6 バイトごとに 0 から）
atkk[a, 0] <- atb[a, 0]      for (a) in 0 .. atz[0]
atkk[a, k] <- atkk[a, k-1] * 256 + atb[a, k]   for (a) in 0 .. atz[0] for (k) in 1 .. 5
atkk[a, 6] <- atb[a, 6]      for (a) in 0 .. atz[0]
atkk[a, k] <- atkk[a, k-1] * 256 + atb[a, k]   for (a) in 0 .. atz[0] for (k) in 7 .. 11
atkk[a, 12] <- atb[a, 12]    for (a) in 0 .. atz[0]
atkk[a, k] <- atkk[a, k-1] * 256 + atb[a, k]   for (a) in 0 .. atz[0] for (k) in 13 .. 17
atkk[a, 18] <- atb[a, 18]    for (a) in 0 .. atz[0]
atkk[a, k] <- atkk[a, k-1] * 256 + atb[a, k]   for (a) in 0 .. atz[0] for (k) in 19 .. 23
field ak0 : max bound 1024                  # 鍵（1〜6 バイト目）
ak0[a] <- atkk[a, 5]         for (a) in 0 .. atz[0]
field ak1 : max bound 1024                  # 鍵（7〜12 バイト目）
ak1[a] <- atkk[a, 11]        for (a) in 0 .. atz[0]
field ak2 : max bound 1024                  # 鍵（13〜18 バイト目）
ak2[a] <- atkk[a, 17]        for (a) in 0 .. atz[0]
field ak3 : max bound 1024                  # 鍵（19〜24 バイト目）
ak3[a] <- atkk[a, 23]        for (a) in 0 .. atz[0]
field atn : min bound 1024                  # 出現 a と同じ綴りの最初の出現（正体）
atn[a] <- b   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0]
      if ak0[a] == ak0[b] if ak1[a] == ak1[b] if ak2[a] == ak2[b] if ak3[a] == ak3[b]
field atf : or bound 1024                   # 出現 a は正体
atf[a] <- true   for (a) in 0 .. atz[0] if atn[a] == a
field alt : or bound 1024 1024              # 正体 a の綴りは出現 b の綴りより小さい（鍵の辞書順）
alt[a, b] <- true   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0] if atf[a] if ak0[a] < ak0[b]
alt[a, b] <- true   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0] if atf[a] if ak0[a] == ak0[b]
      if ak1[a] < ak1[b]
alt[a, b] <- true   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0] if atf[a] if ak0[a] == ak0[b]
      if ak1[a] == ak1[b] if ak2[a] < ak2[b]
alt[a, b] <- true   for (a) in 0 .. atz[0] for (b) in 0 .. atz[0] if atf[a] if ak0[a] == ak0[b]
      if ak1[a] == ak1[b] if ak2[a] == ak2[b] if ak3[a] < ak3[b]
# 数えるのは集約ではなく鎖（a に沿って、b より小さい正体を数える）
field arc : max bound 1024 1024
arc[b, 0] <- 0                 for (b) in 0 .. atz[0] if not alt[0, b]
arc[b, 0] <- 1                 for (b) in 0 .. atz[0] if alt[0, b]
arc[b, a] <- arc[b, a-1] + 1   for (b) in 0 .. atz[0] for (a) in 1 .. atz[0] if alt[a, b]
arc[b, a] <- arc[b, a-1]       for (b) in 0 .. atz[0] for (a) in 1 .. atz[0] if not alt[a, b]
field atr : max bound 1024                  # 出現 a の番号（綴りの順。同じ綴りは同じ番号）
atr[a] <- arc[a, k]          for (a) in 0 .. atz[0] for (k) in 0 .. atz[0]   # 鎖は増えるだけなので max が末尾を拾う
field qv : max bound 262144                 # 原子の出現 t の番号
qv[t] <- atr[atx[t]]         for (t,zc) in ch if atv[t]
# ── 集合 ─────────────────────────────────────────────────────────────
# `field s : set` は **or の場に要素の次元を一つ足したもの**である（`s[k] = {a, b}` ⟺ `s'[k, a]` と
# `s'[k, b]` が true）。和集合の join は or の join、空集合（⊥）は全部 ⊥ —— 束ごと焼ける。
# 下ろすのは `s[] <- {e}` / `s[k] <- {e}`（要素一つ）の書き先と print だけ。集合の読み・二次元の鍵・
# 要素が二つ以上の字面は下ろさない（`set` のまま残る → 焼き手が理由 8 で言う）。広さを書いた集合は鍵が一つの
# ものだけ（14u）。
# print は解釈実行と同じく **要素を str の順に**並べる（数も綴りで: 10 < 2。原子は番号の順が綴りの順）。
field kwset : or bound 262144               # `set`
kwset[t] <- true   for (t,zc) in ch if tlen[t] == 3 if not tcom[t] if tch[t,0] == 115 if tch[t,1] == 101
      if tch[t,2] == 116
field lset : or bound 1024                  # 場 f は集合
lset[fdno[t]] <- true   for (t,zc) in ch if isdcl[t] if kwset[latt[t]]
field lsvb : max bound 8192                 # 集合の文 s の値の `{`
lsvb[s] <- lvf[s]       for (s) in 0 .. nstz[0] if hasr[s] if lset[hfz[s]] if tch[lvf[s], 0] == 123
field lsve : max bound 8192                 # その要素の最初のトークン
lsve[s] <- nextw[lsvb[s]]   for (s) in 0 .. nstz[0] if lsvb[s] >= 0
field lsee : max bound 8192                 # 要素の最後のトークン（文字列なら閉じの `"`）
lsee[s] <- lsve[s]          for (s) in 0 .. nstz[0] if lsve[s] >= 0 if not qq[lsve[s]]
lsee[s] <- qcl[lsve[s]]     for (s) in 0 .. nstz[0] if lsve[s] >= 0 if qq[lsve[s]]
field lsvc : max bound 8192                 # 要素の後ろの語（`}` なら要素は一つ）
lsvc[s] <- nextw[lsee[s]]   for (s) in 0 .. nstz[0] if lsee[s] >= 0
field lsk1s : or bound 8192                 # 文 s の値は要素一つの集合 `{e}`
lsk1s[s] <- true            for (s) in 0 .. nstz[0] if lsvc[s] >= 0 if tch[lsvc[s], 0] == 125
field lsek : max bound 8192                 # 要素の書き方（1 表の変数 / 2 区間の変数 / 3 数か文字列）
lsek[s] <- 1                for (s) in 0 .. nstz[0] if lsk1s[s] if lvlk[lsve[s]] == 0 if not ltr[lvt[lsve[s]]]
lsek[s] <- 2                for (s) in 0 .. nstz[0] if lsk1s[s] if vbnd[lsve[s]] >= 0 if lvlk[lsve[s]] >= 1
lsek[s] <- 2                for (s) in 0 .. nstz[0] if lsk1s[s] if lvlk[lsve[s]] == 0 if ltr[lvt[lsve[s]]]
lsek[s] <- 3                for (s) in 0 .. nstz[0] if lsk1s[s] if isnum[lsve[s]]
lsek[s] <- 3                for (s) in 0 .. nstz[0] if lsk1s[s] if qq[lsve[s]]
field lsekf : or bound 8192                 # 要素の書き方が分かった
lsekf[s] <- true            for (s) in 0 .. nstz[0] if lsek[s] >= 1
field lsbd : or bound 1024                  # 集合 f は下ろせない
lsbd[hfz[s]] <- true        for (s) in 0 .. nstz[0] if lsk1s[s] if not lsekf[s]
lsbd[hfz[s]] <- true        for (s) in 0 .. nstz[0] if hasr[s] if lset[hfz[s]] if not lsk1s[s]
lsbd[lof[t]] <- true        for (t,zc) in ch if isocc[t] if not lhd[t] if not lpo[t]
lsbd[f] <- true             for (f) in 0 .. nfdz[0] if lset[f] if farr[f] == 2
#   広さを書いた集合（14u）: 鍵が一つで、書いた広さが一つのものだけ下ろす。宣言の `set bound W` を丸ごと
#   消して型紙 49 の `or bound W E` を差す（lb1 は書いた W、lb2 は要素の広さ）。`s[]` の集合に書いた広さは
#   鍵の広さではない（lb1 が W に化ける）・広さを二つ書いた・次元0 を負へずらす（書いた数を書き換える道と
#   消す字がぶつかる）ものは下ろさない
lsbd[fdno[t]] <- true       for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]] if lf0[fdno[t]]
lsbd[fdno[t]] <- true       for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]] if hasw2[fdno[t]]
lsbd[fdno[t]] <- true       for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]] if lng[fdno[t]] >= 1
field lsk : or bound 1024                   # 集合 f を下ろす
lsk[f] <- true              for (f) in 0 .. nfdz[0] if lset[f] if not lsbd[f]
field lsk0 : or bound 1024                  # 鍵の無い集合（`s[]`）→ 一次元の or
lsk0[f] <- true             for (f) in 0 .. nfdz[0] if lsk[f] if lf0[f]
field lsk1 : or bound 1024                  # 鍵が一つの集合（`s[k]`）→ 二次元の or
lsk1[f] <- true             for (f) in 0 .. nfdz[0] if lsk[f] if not lf0[f]
field lss : or bound 8192                   # 文 s は下ろす集合の書き先
lss[s] <- true              for (s) in 0 .. nstz[0] if lsk1s[s] if lsk[hfz[s]]
field lsel : or bound 262144                # 下ろす集合の要素のトークン（消して、書き先の座標に書く）
lsel[t] <- true             for (t,zc) in ch if lss[snum[t]] if t >= lsve[snum[t]] if t <= lsee[snum[t]]
field lsde : max bound 8192                 # 文 s の要素の次元（鍵の無い集合は 0、鍵が一つなら 1）
lsde[s] <- 0                for (s) in 0 .. nstz[0] if lss[s] if lsk0[hfz[s]]
lsde[s] <- 1                for (s) in 0 .. nstz[0] if lss[s] if lsk1[hfz[s]]
lbm[hfz[s], lsde[s]] <- ljm[lsve[s]]   for (s) in 0 .. nstz[0] if lss[s] if ljk[lsve[s]]
lbu[hfz[s], lsde[s]] <- true           for (s) in 0 .. nstz[0] if lss[s] if not ljk[lsve[s]] if not lsvm[s]
lbm[hfz[s], lsde[s]] <- 0              for (s) in 0 .. nstz[0] if lss[s] if lsvm[s]   # `-` 数（ずらせば k 以下）
ljm[j] <- qv[j]             for (j,zc) in ch if lsel[j] if qq[j] if atv[j]
ljk[j] <- true              for (j,zc) in ch if lsel[j] if qq[j] if atv[j]
lb2[f] <- lbm[f, 1] + 1     for (f) in 0 .. nfdz[0] if lsk1[f] if lbm[f, 1] >= 0
lb2[f] <- 256               for (f) in 0 .. nfdz[0] if lsk1[f] if lbu[f, 1]
field lsea : or bound 1024                  # 集合 f の要素は原子
lsea[hfz[s]] <- true        for (s) in 0 .. nstz[0] if lss[s] if qq[lsve[s]]
lsea[hfz[s]] <- true        for (s) in 0 .. nstz[0] if lss[s] if lta[lvt[lsve[s]], vcolz[lsve[s]]]
      if lvlk[lsve[s]] == 0
# 字の差し替え: 値 `{e}` → `true`（`{` が差し、要素と `}` は消える）。書き先 `s[]` → `s[e]`（`[` が差す）、
# `s[k]` → `s[k, e]`（`]` を消して `, e]` を差す）。要素の書き方は四つ（表の変数・区間の変数・数・文字列）
field lsh : max bound 8192                  # 集合の文 s の書き先の出現
lsh[s] <- hotok[s]          for (s) in 0 .. nstz[0] if lss[s]
field lsx0 : max bound 262144               # 鍵の無い集合の書き先の `[` → 文
lsx0[obr[lsh[s]]] <- s      for (s) in 0 .. nstz[0] if lss[s] if lsde[s] == 0
field lsx1 : max bound 262144               # 鍵が一つの集合の書き先の `]` → 文
lsx1[tclos[obr[lsh[s]]]] <- s   for (s) in 0 .. nstz[0] if lss[s] if lsde[s] == 1
field lsev : max bound 8192                 # 数か文字列の要素の値
lsev[s] <- tval[lsve[s]]    for (s) in 0 .. nstz[0] if lss[s] if isnum[lsve[s]]
lsev[s] <- qv[lsve[s]]      for (s) in 0 .. nstz[0] if lss[s] if qq[lsve[s]]
field lsxs : max bound 262144               # 書き先の `[` か `]` のトークン → 文
lsxs[t] <- lsx0[t]          for (t,zc) in ch if lsx0[t] >= 0
lsxs[t] <- lsx1[t]          for (t,zc) in ch if lsx1[t] >= 0
field lsxf : or bound 262144                # 集合の書き先の `[` か `]`（否定で読むための旗）
lsxf[t] <- true             for (t,zc) in ch if lsxs[t] >= 0
# **要素が負の集合**（14x）: 定義の集合は値の集まりなので負の数も入る（`d[] <- {w}` で w = -1、`{-3}`、
# `for (i) in -12 .. 3` の i）。下ろした or の場は要素を座標にするので、負の要素は広さの外だった（終了コード 6
# —— 自由に書いた本の DIFF 2）。書き先の座標のずらし（14c / 14x）と同じく **要素の次元の原点を k ずらす**:
# k は要素になりうるいちばん小さい値の大きさ（表の列の最小・区間の数の下端・`-N` の字面の最大）。print は要素を
# `座標 - k` で書き、綴りの順に並べる（`-` はどの数字より小さいので負の数が先。負の数どうしは大きさの綴りの順
# —— 機械の `_sPn`）。k は 127 まで（焼き手の座標のずれは符号つき一バイト —— 128 で理由 8。書き先の要素は
# `w + k` と書く）。k が 128 以上の集合と、原子の要素と負の要素を両方書く集合は下ろさない（理由 8）。
# k は字面と表から出す —— 下ろす集合（lss）から出すと、断り（lsbd）と輪になる
field lsvm : or bound 8192                  # 文 s の要素は `-` 数
lsvm[s] <- true             for (s) in 0 .. nstz[0] if lsve[s] >= 0 if ismin[lsve[s]] if isnum[nextw[lsve[s]]]
lsee[s] <- nextw[lsve[s]]   for (s) in 0 .. nstz[0] if lsvm[s]
lsek[s] <- 4                for (s) in 0 .. nstz[0] if lsk1s[s] if lsvm[s]
lsev[s] <- 0 - tval[nextw[lsve[s]]]   for (s) in 0 .. nstz[0] if lss[s] if lsvm[s]
field lsng : max bound 8192                 # 文 s の要素になりうるいちばん小さい値が負なら、その大きさ
lsng[s] <- 0 - ltmn[lvt[lsve[s]], vcolz[lsve[s]]]   for (s) in 0 .. nstz[0] if lsek[s] == 1
      if ltmn[lvt[lsve[s]], vcolz[lsve[s]]] < 0
lsng[s] <- 0 - llo2[s, vlpz[lsve[s]]]   for (s) in 0 .. nstz[0] if lsek[s] == 2 if lvlk[lsve[s]] >= 1
      if llhv[s, vlpz[lsve[s]]] if llo2[s, vlpz[lsve[s]]] < 0
lsng[s] <- tval[nextw[lsve[s]]]         for (s) in 0 .. nstz[0] if lsek[s] == 4
field lsnk0 : max bound 1024                # 集合 f の要素のずらしの候補
lsnk0[hfz[s]] <- lsng[s]    for (s) in 0 .. nstz[0] if lsng[s] >= 1
field lsqa : or bound 1024                  # 集合 f に原子の要素を書く文がある（字面で見る）
lsqa[hfz[s]] <- true        for (s) in 0 .. nstz[0] if lsek[s] == 3 if qq[lsve[s]]
lsqa[hfz[s]] <- true        for (s) in 0 .. nstz[0] if lsek[s] == 1 if lta[lvt[lsve[s]], vcolz[lsve[s]]]
lsbd[f] <- true             for (f) in 0 .. nfdz[0] if lsnk0[f] >= 128
lsbd[f] <- true             for (f) in 0 .. nfdz[0] if lsnk0[f] >= 1 if lsqa[f]
field lsnk : max bound 1024                 # 集合 f の要素のずらし
lsnk[f] <- lsnk0[f]         for (f) in 0 .. nfdz[0] if lsk[f] if lsnk0[f] >= 1
field lsnq : or bound 1024                  # 集合 f は要素をずらす
lsnq[f] <- true             for (f) in 0 .. nfdz[0] if lsnk[f] >= 1

# ── fourv（Belnap の四値）→ or の旗二つ（14b）───────────────────────────────
# Belnap の FOUR は知識の順序で **2 × 2 の積の束**である（Ginsberg の双束、Fitting の不動点意味論）:
# T の旗と F の旗の対で、⊥ = どちらも無い、T = T だけ、F = F だけ、⊤ = 両方。join は旗ごとの or、
# 否定は **旗を入れ替えるだけ**で、反転ではない —— だから否定が単調で、層が要らない。
# ガードが立つのは T の旗（解釈実行の `_truthy`: T と ⊤）、`not x` が立つのは F の旗（F と ⊤）。
# だから場に次元を一つ足した or に下ろす: `x[e]` → `x[e, 0]`（T の旗）/ `x[e, 1]`（F の旗）。
#   宣言      `fourv` → `or`（f・u・v の三字を消すだけ）。広さに旗の次元 ` 2` を足す
#   書き先    `x[e] <- true` → `x[e, 0] <- true`、`x[e] <- false` → `x[e, 1] <- true`
#   写し      `x[e] <- y[f]` → `x[e, _r9] <- y[f, _r9] for (_r9) in 0 .. 1`（旗ごとに写す）
#             `x[e] <- o[f]`（o は or の場）→ `x[e, 0] <- o[f]`（true は T —— 解釈実行と同じ）
#   否定の写し `x[e] <- not y[f]` → `x[e, _r9] <- y[f, _fsw[_r9]] for (_r9) in 0 .. 1`（入れ替えて写す）
#   ガード    `if x[e]` → `if x[e, 0]`、`if not x[e]` → `if x[e, 1]`（**否定が消える**）
#   print     値を原子 `T4` / `F4` の番号として書き（`_pav`）、⊤ の行は flat と同じ道（`⊤ CONFLICT`）
# **白い名簿で書く**（気づき47）: fourv の場の出現が上の形のどれでもなければ、その場は下ろさない
# （`fourv` のまま残る → 焼き手が宣言の行で理由 8 と言う）。旗は or の場の読みなので、焼き手の
# 「or の場に書けるのは true と or の場の読みだけ」（理由 9）の内側に収まる。
field kw4v : or bound 262144                # `fourv`
kw4v[t] <- true   for (t,zc) in ch if tlen[t] == 5 if not tcom[t] if tch[t,0] == 102 if tch[t,1] == 111
      if tch[t,2] == 117 if tch[t,3] == 114 if tch[t,4] == 118
field kwfls : or bound 262144               # `false`
kwfls[t] <- true  for (t,zc) in ch if tlen[t] == 5 if not tcom[t] if tch[t,0] == 102 if tch[t,1] == 97
      if tch[t,2] == 108 if tch[t,3] == 115 if tch[t,4] == 101
field l4f : or bound 1024                   # 場 f は fourv
l4f[fdno[t]] <- true   for (t,zc) in ch if isdcl[t] if kw4v[latt[t]]
field l4h : or bound 8192                   # 文 s の書き先は fourv
l4h[s] <- true         for (s) in 0 .. nstz[0] if hasr[s] if l4f[hfz[s]]
field l4vk : max bound 8192                 # 値の形（1 `true` / 2 `false` / 3 fourv の読み / 4 `not` + fourv の読み /
                                            #          5 or の場の読み —— 解釈実行は true を T と読む）
l4vk[s] <- 1   for (s) in 0 .. nstz[0] if l4h[s] if kwtru[lvf[s]]
l4vk[s] <- 2   for (s) in 0 .. nstz[0] if l4h[s] if kwfls[lvf[s]]
l4vk[s] <- 3   for (s) in 0 .. nstz[0] if l4h[s] if isocc[lvf[s]] if l4f[lof[lvf[s]]]
l4vk[s] <- 4   for (s) in 0 .. nstz[0] if l4h[s] if kwnot[lvf[s]] if isocc[nextw[lvf[s]]]
      if l4f[lof[nextw[lvf[s]]]]
l4vk[s] <- 5   for (s) in 0 .. nstz[0] if l4h[s] if isocc[lvf[s]] if flatt[lof[lvf[s]]] == 3
field l4vf : or bound 8192                  # 値の形が分かった
l4vf[s] <- true   for (s) in 0 .. nstz[0] if l4vk[s] >= 1
field l4ve : max bound 8192                 # 値の最後の語（`true` / `false` / 読みの `]`）
l4ve[s] <- lvf[s]                    for (s) in 0 .. nstz[0] if l4vk[s] >= 1 if l4vk[s] <= 2
l4ve[s] <- tclos[obr[lvf[s]]]        for (s) in 0 .. nstz[0] if l4vk[s] == 3
l4ve[s] <- tclos[obr[nextw[lvf[s]]]] for (s) in 0 .. nstz[0] if l4vk[s] == 4
l4ve[s] <- tclos[obr[lvf[s]]]        for (s) in 0 .. nstz[0] if l4vk[s] == 5
field l4bd : or bound 1024                  # fourv の場 f は下ろせない
#   値の形が名簿に無い / 値の後ろに語が続く（`y[i] + 1`・`true == x` …）
l4bd[hfz[s]] <- true   for (s) in 0 .. nstz[0] if l4h[s] if not l4vf[s]
l4bd[hfz[s]] <- true   for (s) in 0 .. nstz[0] if l4vf[s] if snum[nextw[l4ve[s]]] == s
      if not cbrk[nextw[l4ve[s]]] if not tcom[nextw[l4ve[s]]]
#   ガードの読み（`if x[e]` / `if not x[e]` —— 後ろに比較も算術も続かない）
field l4g : max bound 262144                # ガードの fourv の読み t → 旗（0 `if x` / 1 `if not x`）
l4g[t] <- 0   for (t,zc) in ch if isocc[t] if l4f[lof[t]] if kwif[prevw[t]]
l4g[t] <- 1   for (t,zc) in ch if isocc[t] if l4f[lof[t]] if kwnot[prevw[t]] if kwif[prevw[prevw[t]]]
field l4gc : max bound 262144               # その読みの `]`
l4gc[t] <- tclos[obr[t]]   for (t,zc) in ch if l4g[t] >= 0
field l4gx : or bound 262144                # ガードの読みの後ろに語が続く
l4gx[t] <- true   for (t,zc) in ch if l4g[t] >= 0 if snum[nextw[l4gc[t]]] == snum[t]
      if not cbrk[nextw[l4gc[t]]] if not tcom[nextw[l4gc[t]]]
#   名簿: 書き先・print・ガード・写しの読み。ほかの出現（座標・算術・比較・render・`is` …）は断る
field l4ok : or bound 262144                # fourv の場の出現 t は名簿の形
l4ok[t] <- true   for (t,zc) in ch if isocc[t] if lhd[t] if l4h[snum[t]]
l4ok[t] <- true   for (t,zc) in ch if lpo[t]
l4ok[t] <- true   for (t,zc) in ch if l4g[t] >= 0 if not l4gx[t]
l4ok[t] <- true   for (t,zc) in ch if isocc[t] if lvf[snum[t]] == t if l4vk[snum[t]] == 3
l4ok[t] <- true   for (t,zc) in ch if isocc[t] if nextw[lvf[snum[t]]] == t if l4vk[snum[t]] == 4
l4bd[lof[t]] <- true   for (t,zc) in ch if isocc[t] if l4f[lof[t]] if not l4ok[t]
#   次元は二つまで。広さを書いたなら、書いた広さの数が次元の数と同じ（` 2` を後ろに足すので）。
#   `x[]` と `x[i]` を両方使う場は `[]` が `[0]` に寄らない（別の升）ので下ろさない
l4bd[f] <- true   for (f) in 0 .. nfdz[0] if l4f[f] if farr[f] >= 3
l4bd[f] <- true   for (f) in 0 .. nfdz[0] if l4f[f] if lf0[f] if lfm1[f]
l4bd[fdno[t]] <- true   for (t,zc) in ch if isdcl[t] if l4f[fdno[t]] if kwbnd[bndt[t]] if hasw2[fdno[t]]
      if farr[fdno[t]] == 1
l4bd[fdno[t]] <- true   for (t,zc) in ch if isdcl[t] if l4f[fdno[t]] if kwbnd[bndt[t]] if not hasw2[fdno[t]]
      if farr[fdno[t]] == 2
l4bd[fdno[t]] <- true   for (t,zc) in ch if isdcl[t] if l4f[fdno[t]] if hasw3[fdno[t]]
field l4k : or bound 1024                   # fourv の場 f を下ろす
l4k[f] <- true   for (f) in 0 .. nfdz[0] if l4f[f] if not l4bd[f]
# 消す字: 宣言の束の f・u・v（`fourv` → `or`）、`false`、ガードと写しの `not`
field l4x : or bound 262144                 # 字を全部消すトークン（`false` / `not`）
ldl[i] <- true   for (i,c) in ch if l4x[tnum[i]]
field l4lt : or bound 262144                # 下ろす fourv の宣言の束のトークン
l4lt[latt[t]] <- true   for (t,zc) in ch if isdcl[t] if l4k[fdno[t]]
ldl[i] <- true   for (i,c) in ch if l4lt[tnum[i]] if cpos[i] == 0
ldl[i] <- true   for (i,c) in ch if l4lt[tnum[i]] if cpos[i] == 2
ldl[i] <- true   for (i,c) in ch if l4lt[tnum[i]] if cpos[i] == 4
# 宣言の広さ: 書いていなければ型紙 3（一次元 → `bound B 2`）/ 148（二次元 → `bound B1 B2 2`）。
# iti は max なので 2 / 3 に勝つ（穴 1 / 2 に旗の 2）。書いてあれば最後の広さの後ろに ` 2`（160）
iti[lin[lnl[t]], 0] <- 3     for (t,zc) in ch if lnb[t] if l4k[fdno[t]] if farr[fdno[t]] == 1
ih1[lin[lnl[t]], 0] <- 2     for (t,zc) in ch if lnb[t] if l4k[fdno[t]] if farr[fdno[t]] == 1
iti[lin[lnl[t]], 0] <- 148   for (t,zc) in ch if lnb[t] if l4k[fdno[t]] if farr[fdno[t]] == 2
ih2[lin[lnl[t]], 0] <- 2     for (t,zc) in ch if lnb[t] if l4k[fdno[t]] if farr[fdno[t]] == 2
field l4bt : max bound 262144               # 下ろす fourv の宣言 t の最後の広さのトークン
l4bt[t] <- bw1[t]   for (t,zc) in ch if isdcl[t] if l4k[fdno[t]] if kwbnd[bndt[t]] if farr[fdno[t]] == 1
l4bt[t] <- bw2[t]   for (t,zc) in ch if isdcl[t] if l4k[fdno[t]] if kwbnd[bndt[t]] if farr[fdno[t]] == 2
iti[lin[l4bt[t]], 0] <- 160               for (t,zc) in ch if l4bt[t] >= 0
irw[lin[l4bt[t]], 0] <- lrw[lte[l4bt[t]]] for (t,zc) in ch if l4bt[t] >= 0
ibd[lin[l4bt[t]], 0] <- true              for (t,zc) in ch if l4bt[t] >= 0
# 書き先の `]` → `, 旗]`（true 0 / false 1 / or の読み 0 —— 型紙 53）か `, _r9]`（写し —— 型紙 46）
field l4hc : max bound 8192                 # 下ろす fourv の書き先の `]`
l4hc[s] <- tclos[obr[hotok[s]]]    for (s) in 0 .. nstz[0] if l4h[s] if l4k[hfz[s]]
ldl[tstart[l4hc[s]]] <- true       for (s) in 0 .. nstz[0] if l4hc[s] >= 0
iti[lin[l4hc[s]], 0] <- 53         for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] <= 2
ih0[lin[l4hc[s]], 0] <- l4vk[s] - 1   for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] <= 2
iti[lin[l4hc[s]], 0] <- 53         for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 5
ih0[lin[l4hc[s]], 0] <- 0          for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 5
iti[lin[l4hc[s]], 0] <- 46         for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] >= 3 if l4vk[s] <= 4
ih1[lin[l4hc[s]], 0] <- 9          for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] >= 3 if l4vk[s] <= 4
irw[lin[l4hc[s]], 0] <- lrw[lte[l4hc[s]]]   for (s) in 0 .. nstz[0] if l4hc[s] >= 0
ibd[lin[l4hc[s]], 0] <- true       for (s) in 0 .. nstz[0] if l4hc[s] >= 0
# 値: `false` → `true`（54）。写しは読みの `]` を消して 161 / 163 を差す。種を規則にした文
# （型紙 8 が同じ `]` に ` for (_z) in 0 .. 0` を差す）は 162 / 164 —— 番号が大きいので max が選ぶ
l4x[lvf[s]] <- true                for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 2
iti[lin[lvf[s]], 0] <- 54          for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 2
irw[lin[lvf[s]], 0] <- lrw[lte[lvf[s]]]   for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 2
ibd[lin[lvf[s]], 0] <- true        for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 2
l4x[lvf[s]] <- true                for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 4
ldl[tstart[l4ve[s]]] <- true       for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] >= 3 if l4vk[s] <= 4
iti[lin[l4ve[s]], 0] <- 161        for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 3
iti[lin[l4ve[s]], 0] <- 162        for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 3 if lsq[l4ve[s]]
iti[lin[l4ve[s]], 0] <- 163        for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 4
iti[lin[l4ve[s]], 0] <- 164        for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] == 4 if lsq[l4ve[s]]
irw[lin[l4ve[s]], 0] <- lrw[lte[l4ve[s]]]   for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] >= 3
      if l4vk[s] <= 4
ibd[lin[l4ve[s]], 0] <- true       for (s) in 0 .. nstz[0] if l4hc[s] >= 0 if l4vk[s] >= 3 if l4vk[s] <= 4
field l4sw : or bound 1                     # 否定の写しがある（入れ替えの表 `_fsw` を一度だけ置く）
l4sw[z] <- true    for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if l4hc[s] >= 0 if l4vk[s] == 4
iti[13, 0] <- 170  for (z) in 0 .. 0 if l4sw[0]
# ガード: 読みの `]` → `, 旗]`（53。種を規則にした文は 165）、`if not` の `not` を消す
field l4gk : or bound 262144                # 下ろすガードの読み t
l4gk[t] <- true    for (t,zc) in ch if l4g[t] >= 0 if l4k[lof[t]]
l4x[prevw[t]] <- true              for (t,zc) in ch if l4gk[t] if l4g[t] == 1
ldl[tstart[l4gc[t]]] <- true       for (t,zc) in ch if l4gk[t]
iti[lin[l4gc[t]], 0] <- 53         for (t,zc) in ch if l4gk[t]
iti[lin[l4gc[t]], 0] <- 165        for (t,zc) in ch if l4gk[t] if lsq[l4gc[t]]
ih0[lin[l4gc[t]], 0] <- l4g[t]     for (t,zc) in ch if l4gk[t]
irw[lin[l4gc[t]], 0] <- lrw[lte[l4gc[t]]]   for (t,zc) in ch if l4gk[t]
ibd[lin[l4gc[t]], 0] <- true       for (t,zc) in ch if l4gk[t]
# print: 値は原子 T4 / F4（番号は利用者の原子の後ろ —— 綴りの順の番号は最後の出現の通し番号を越えない）。
# ⊤ の行は旗が両方立つ行（151 / 154）。原子の道（`_pav`）は数の字を書かず、⊤ の行は `⊤ CONFLICT` が書く
field lp4 : or bound 262144                 # 下ろす fourv の場の print
lp4[t] <- true     for (t,zc) in ch if lpo[t] if l4k[lpf[t]]
field l4a : max bound 1                     # 原子 T4 の番号（F4 はその次）
l4a[z] <- 0              for (z) in 0 .. 0
l4a[z] <- atz[0] + 1     for (z) in 0 .. 0
field l4pr : or bound 1                     # fourv の print がある
l4pr[z] <- true    for (t,zc) in ch for (z) in 0 .. 0 if lp4[t]
iti[12, 0] <- 29   for (z) in 0 .. 0 if l4pr[0]
ih0[12, 0] <- l4a[0]       for (z) in 0 .. 0 if l4pr[0]
ih1[12, 0] <- 0            for (z) in 0 .. 0 if l4pr[0]
ih2[12, 0] <- 84           for (z) in 0 .. 0 if l4pr[0]
iti[12, 1] <- 29   for (z) in 0 .. 0 if l4pr[0]
ih0[12, 1] <- l4a[0]       for (z) in 0 .. 0 if l4pr[0]
ih1[12, 1] <- 1            for (z) in 0 .. 0 if l4pr[0]
ih2[12, 1] <- 52           for (z) in 0 .. 0 if l4pr[0]
iti[12, 2] <- 29   for (z) in 0 .. 0 if l4pr[0]
ih0[12, 2] <- l4a[0] + 1   for (z) in 0 .. 0 if l4pr[0]
ih1[12, 2] <- 0            for (z) in 0 .. 0 if l4pr[0]
ih2[12, 2] <- 70           for (z) in 0 .. 0 if l4pr[0]
iti[12, 3] <- 29   for (z) in 0 .. 0 if l4pr[0]
ih0[12, 3] <- l4a[0] + 1   for (z) in 0 .. 0 if l4pr[0]
ih1[12, 3] <- 1            for (z) in 0 .. 0 if l4pr[0]
ih2[12, 3] <- 52           for (z) in 0 .. 0 if l4pr[0]
iti[lpd2[t], 2] <- 28              for (t,zc) in ch if lp4[t]
ih0[lpd2[t], 2] <- lpp[t]          for (t,zc) in ch if lp4[t]
#   一次元: 166 T + 167 旗0 / 166 F + 167 旗1 / 151 ⊤ + 167 旗0 + 167 旗1（三文字目・四文字目に並べる）
iti[lpd2[t], 3] <- 166             for (t,zc) in ch if lp1[t] if lp4[t]
ih0[lpd2[t], 3] <- lpp[t]          for (t,zc) in ch if lp1[t] if lp4[t]
ih1[lpd2[t], 3] <- l4a[0]          for (t,zc) in ch if lp1[t] if lp4[t]
ih2[lpd2[t], 3] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp1[t] if lp4[t]
iti[lpd2[t], 4] <- 167             for (t,zc) in ch if lp1[t] if lp4[t]
ih0[lpd2[t], 4] <- 0               for (t,zc) in ch if lp1[t] if lp4[t]
ind[lpd2[t], 4] <- lpf[t] + 1      for (t,zc) in ch if lp1[t] if lp4[t]
iti[lpd2[t], 5] <- 166             for (t,zc) in ch if lp1[t] if lp4[t]
ih0[lpd2[t], 5] <- lpp[t]          for (t,zc) in ch if lp1[t] if lp4[t]
ih1[lpd2[t], 5] <- l4a[0] + 1      for (t,zc) in ch if lp1[t] if lp4[t]
ih2[lpd2[t], 5] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp1[t] if lp4[t]
iti[lpd2[t], 6] <- 167             for (t,zc) in ch if lp1[t] if lp4[t]
ih0[lpd2[t], 6] <- 1               for (t,zc) in ch if lp1[t] if lp4[t]
ind[lpd2[t], 6] <- lpf[t] + 1      for (t,zc) in ch if lp1[t] if lp4[t]
iti[lpd2[t], 7] <- 151             for (t,zc) in ch if lp1[t] if lp4[t]
ih0[lpd2[t], 7] <- lpp[t]          for (t,zc) in ch if lp1[t] if lp4[t]
ih2[lpd2[t], 7] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp1[t] if lp4[t]
iti[lpd3[t], 0] <- 167             for (t,zc) in ch if lp1[t] if lp4[t]
ih0[lpd3[t], 0] <- 0               for (t,zc) in ch if lp1[t] if lp4[t]
ind[lpd3[t], 0] <- lpf[t] + 1      for (t,zc) in ch if lp1[t] if lp4[t]
iti[lpd3[t], 1] <- 167             for (t,zc) in ch if lp1[t] if lp4[t]
ih0[lpd3[t], 1] <- 1               for (t,zc) in ch if lp1[t] if lp4[t]
ind[lpd3[t], 1] <- lpf[t] + 1      for (t,zc) in ch if lp1[t] if lp4[t]
#   二次元: 168 T + 18 + 169 旗0 / 168 F + 18 + 169 旗1 / 154 ⊤ + 18 + 169 旗0 + 169 旗1。
#   座標の行（20 / 21）のガードは「場の読みが自分と等しい」（22）ではなく「行に値がある」（171 —— max で勝つ）
iti[lpd[t], 7] <- 171              for (t,zc) in ch if lp2[t] if lp4[t]
ih0[lpd[t], 7] <- lpp[t]           for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd1[t], 2] <- 171             for (t,zc) in ch if lp2[t] if lp4[t]
ih0[lpd1[t], 2] <- lpp[t]          for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd2[t], 3] <- 168             for (t,zc) in ch if lp2[t] if lp4[t]
ih0[lpd2[t], 3] <- lpp[t]          for (t,zc) in ch if lp2[t] if lp4[t]
ih1[lpd2[t], 3] <- l4a[0]          for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd2[t], 4] <- 18              for (t,zc) in ch if lp2[t] if lp4[t]
ih1[lpd2[t], 4] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lp4[t]
ih2[lpd2[t], 4] <- lpb2[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd2[t], 5] <- 169             for (t,zc) in ch if lp2[t] if lp4[t]
ih0[lpd2[t], 5] <- 0               for (t,zc) in ch if lp2[t] if lp4[t]
ind[lpd2[t], 5] <- lpf[t] + 1      for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd2[t], 6] <- 168             for (t,zc) in ch if lp2[t] if lp4[t]
ih0[lpd2[t], 6] <- lpp[t]          for (t,zc) in ch if lp2[t] if lp4[t]
ih1[lpd2[t], 6] <- l4a[0] + 1      for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd2[t], 7] <- 18              for (t,zc) in ch if lp2[t] if lp4[t]
ih1[lpd2[t], 7] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lp4[t]
ih2[lpd2[t], 7] <- lpb2[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd3[t], 0] <- 169             for (t,zc) in ch if lp2[t] if lp4[t]
ih0[lpd3[t], 0] <- 1               for (t,zc) in ch if lp2[t] if lp4[t]
ind[lpd3[t], 0] <- lpf[t] + 1      for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd3[t], 1] <- 154             for (t,zc) in ch if lp2[t] if lp4[t]
ih0[lpd3[t], 1] <- lpp[t]          for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd3[t], 2] <- 18              for (t,zc) in ch if lp2[t] if lp4[t]
ih1[lpd3[t], 2] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lp4[t]
ih2[lpd3[t], 2] <- lpb2[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd3[t], 3] <- 169             for (t,zc) in ch if lp2[t] if lp4[t]
ih0[lpd3[t], 3] <- 0               for (t,zc) in ch if lp2[t] if lp4[t]
ind[lpd3[t], 3] <- lpf[t] + 1      for (t,zc) in ch if lp2[t] if lp4[t]
iti[lpd3[t], 4] <- 169             for (t,zc) in ch if lp2[t] if lp4[t]
ih0[lpd3[t], 4] <- 1               for (t,zc) in ch if lp2[t] if lp4[t]
ind[lpd3[t], 4] <- lpf[t] + 1      for (t,zc) in ch if lp2[t] if lp4[t]

# ── 負の座標（14c）─────────────────────────────────────────────────────────
# 解釈実行の場は辞書なので `quotes[-1] <- 0`（前置きの鎖の基を -1 に置く —— 21_lex）が書ける。焼いた場は
# 0 から始まる並びなので、**次元0 の原点をずらす**: 負の数を書き先の次元0 に書く場は、全部の出現の次元0 に
# 同じ k を足す（k = 書いた負の数の大きさの最大）。足し方は二つ —— 次元0 が数一つなら数を書き換える（型紙 9）。
# それ以外は次元0 を持ち上げ（ANF）、塊の値の後ろに ` + k`（ループの節 36〜39 の頭に付けた 172〜175。
# 足し算は群の和でいちばん弱く、左から結ぶので、どんな式の後ろに付けても `(式) + k` になる）。広さも k 増やす。
# **全部の出現をずらせないときは、どれもずらさない**（持ち上げられない出現・print・区間の端・`[]`・fourv）
# —— 一つでもずらし損ねると別の升を読む（黙って違う答え）。ずらさなければ前と同じく、焼いた本が
# 負の座標で広さを越えて終了コード 6 で言う。render は座標の順に並べるだけなので、ずらしても同じバイトが出る。
field lngd : max bound 262144               # 出現 o の次元0 の最後の語（持ち上げる区間の終わりと同じ引き方）
lngd[o] <- prevw[lfcm[o]]          for (o,zc) in ch if isocc[o] if obr[o] >= 0 if lhc[o]
lngd[o] <- prevw[tclos[obr[o]]]    for (o,zc) in ch if isocc[o] if obr[o] >= 0 if not lhc[o]
field lngt : max bound 262144               # 書き先の出現 o の次元0 が `-N`（数）なら N
lngt[o] <- tval[nextw[ob1[o]]]     for (o,zc) in ch if lhd[o] if tlen[ob1[o]] == 1 if tch[ob1[o], 0] == 45
      if isnum[nextw[ob1[o]]] if lngd[o] == nextw[ob1[o]]
field lng : max bound 1024                  # 場 f の次元0 のずらしの候補
lng[lof[o]] <- lngt[o]             for (o,zc) in ch if lngt[o] >= 1
# **表の列の負の値も座標になる**（14x）: 書き先の次元0 が表の変数一つで、その列に負の値があれば、いちばん小さい
# 値の大きさだけずらす（`d[w] <- u for (u, w) in e` で w = -3 —— 前は負の座標で広さを越えて終了コード 6。
# 定義の場は辞書なので負の座標を持てる）。ずらし方も、ずらせないときの断り方も、負の数を書いたときと同じ道
field ltmn : min bound 16 16                # 表 k の列 c のいちばん小さい値
ltmn[tbk[snum[t]], colc[t]] <- ltsg[t]   for (t,zc) in ch if ltc[t]
field lngv : max bound 262144               # 書き先の出現 o の次元0 が負の値を持つ表の列の変数一つなら、その大きさ
lngv[o] <- 0 - ltmn[lvt[ob1[o]], vcolz[ob1[o]]]   for (o,zc) in ch if lhd[o] if lngd[o] == ob1[o]
      if tkind[ob1[o]] == 1 if vbnd[ob1[o]] >= 0 if lvlk[ob1[o]] == 0 if not ltr[lvt[ob1[o]]]
      if ltmn[lvt[ob1[o]], vcolz[ob1[o]]] < 0
lng[lof[o]] <- lngv[o]             for (o,zc) in ch if lngv[o] >= 1
field lngq : or bound 262144                # 出現 o の次元0 は表の列の変数一つ（持ち上げても広さは列が言う）
lngq[o] <- true                    for (o,zc) in ch if lngv[o] >= 1
field lng1 : or bound 262144                # 出現 o の次元0 は数一つ
lng1[o] <- true                    for (o,zc) in ch if isocc[o] if isnum[ob1[o]] if lngd[o] == ob1[o]
#   数一つでない次元0 は持ち上げさせる（`lqx` —— 焼き手が読めない語と同じ道）
lqx[ob1[o]] <- o                   for (o,zc) in ch if isocc[o] if lng[lof[o]] >= 1 if lngd[o] >= 0
      if not lng1[o]
field l0ok : or bound 262144                # 区間 t は持ち上がり、ループの節を持つ（構成子の引数の塊ではない）
l0ok[t] <- true                    for (t,zc) in ch if lsa[t] if lak0[t] >= 1 if lak0[t] <= 4 if not krf[t]
field l0cv : or bound 262144                # 出現 o の次元0 は、その次元ちょうどの塊になった
l0cv[o] <- true                    for (o,zc) in ch if isocc[o] if lngd[o] >= 0 if l0ok[ob1[o]]
      if lse[ob1[o]] == lngd[o]
field lnh : max bound 1024                  # 場 f の次元1 のずらしの候補（下の「次元1」）
field lnga : or bound 1024                  # 場 f はどちらかの次元をずらす候補
lnga[f] <- true    for (f) in 0 .. nfdz[0] if lng[f] >= 1
lnga[f] <- true    for (f) in 0 .. nfdz[0] if lnh[f] >= 1
field lngb : or bound 1024                  # 場 f はずらせない（どちらの次元も）
lngb[f] <- true    for (f) in 0 .. nfdz[0] if lng[f] >= 1000
lngb[f] <- true    for (f) in 0 .. nfdz[0] if lnh[f] >= 1000
lngb[f] <- true    for (f) in 0 .. nfdz[0] if lnga[f] if l4f[f]
lngb[f] <- true    for (f) in 0 .. nfdz[0] if lnga[f] if lf0[f]
# print する場もずらす（14k）—— print の行はずらした座標で並び、字を書く機械が `座標 - k` を書く（`_psh1/2`）。
# 集合の print（組の鍵を別の道で書く）と fourv の print だけは、まだずらさない
lngb[lpf[t]] <- true               for (t,zc) in ch if lpo[t] if not lp1[t] if not lp2[t]
lngb[lpf[t]] <- true               for (t,zc) in ch if lpo[t] if lp4[t]
lngb[lof[o]] <- true               for (o,zc) in ch if isocc[o] if clfor[snum[o], cnum[o]]
lngb[lof[o]] <- true               for (o,zc) in ch if isocc[o] if lng[lof[o]] >= 1 if lngd[o] >= 0
      if not lng1[o] if not l0cv[o]
field lngk : max bound 1024                 # 場 f の次元0 のずらし
lngk[f] <- lng[f]  for (f) in 0 .. nfdz[0] if lng[f] >= 1 if not lngb[f]
#   持ち上げた次元0: 塊のループの節を ` + k` つきに
field lngr : max bound 262144               # 塊（最初のトークン t）の値に足す k
lngr[ob1[o]] <- lngk[lof[o]]       for (o,zc) in ch if isocc[o] if lngk[lof[o]] >= 1 if lngd[o] >= 0
      if not lng1[o]
lngr[ob1[o]] <- lngk[lof[o]]       for (o,zc) in ch if isocc[o] if lngk[lof[o]] >= 1 if lng1[o] if l0cv[o]
iti[lin[t], 3] <- 172              for (t,zc) in ch if lngr[t] >= 1 if lak0[t] == 1
iti[lin[t], 3] <- 173              for (t,zc) in ch if lngr[t] >= 1 if lak0[t] == 2
iti[lin[t], 3] <- 174              for (t,zc) in ch if lngr[t] >= 1 if lak0[t] == 3
iti[lin[t], 3] <- 175              for (t,zc) in ch if lngr[t] >= 1 if lak0[t] == 4
ih3[lin[t], 3] <- lngr[t]          for (t,zc) in ch if lngr[t] >= 1
#   持ち上がらない数一つ: 数の字を消して N + k を差す（型紙 9）
field lngn : max bound 262144               # 書き換える数のトークン → 新しい数
lngn[ob1[o]] <- tval[ob1[o]] + lngk[lof[o]]   for (o,zc) in ch if isocc[o] if lngk[lof[o]] >= 1 if lng1[o]
      if not l0cv[o]
#   広さ: 書いていなければ型紙 2 / 3 / 148 の穴 0 を k 増やす（max）、書いてあれば広さの数を書き換える
ih0[lin[lnl[t]], 0] <- lb1[fdno[t]] + lngk[fdno[t]]   for (t,zc) in ch if lnb[t] if lngk[fdno[t]] >= 1
lngn[bw1[t]] <- lb1[fdno[t]] + lngk[fdno[t]]   for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
      if lngk[fdno[t]] >= 1
# **次元1**（`row[i, -1] <- 0`・`d[-1, j]` と両方 —— 動的計画法の縁）: 同じ形を次元1 の区間で。
# 次元1 の区間は深さ一の最初の `,` の次の語から `]` の前の語まで（三次元の出現はずらさない）
field lnhs : max bound 262144               # 出現 o の次元1 の最初の語
lnhs[o] <- nextw[lfcm[o]]          for (o,zc) in ch if isocc[o] if obr[o] >= 0 if lhc[o] if not l3o[o]
field lnhd : max bound 262144               # その最後の語
lnhd[o] <- prevw[tclos[obr[o]]]    for (o,zc) in ch if lnhs[o] >= 0
field lnht : max bound 262144               # 書き先の出現 o の次元1 が `-N` なら N
lnht[o] <- tval[nextw[lnhs[o]]]    for (o,zc) in ch if lhd[o] if lnhs[o] >= 0 if tlen[lnhs[o]] == 1
      if tch[lnhs[o], 0] == 45 if isnum[nextw[lnhs[o]]] if lnhd[o] == nextw[lnhs[o]]
lnh[lof[o]] <- lnht[o]             for (o,zc) in ch if lnht[o] >= 1
# 表の列の負の値（14x）: 次元1 が表の変数一つで、その列に負の値があれば、同じくずらす
field lnhv : max bound 262144
lnhv[o] <- 0 - ltmn[lvt[lnhs[o]], vcolz[lnhs[o]]]   for (o,zc) in ch if lhd[o] if lnhs[o] >= 0 if lnhd[o] == lnhs[o]
      if tkind[lnhs[o]] == 1 if vbnd[lnhs[o]] >= 0 if lvlk[lnhs[o]] == 0 if not ltr[lvt[lnhs[o]]]
      if ltmn[lvt[lnhs[o]], vcolz[lnhs[o]]] < 0
lnh[lof[o]] <- lnhv[o]             for (o,zc) in ch if lnhv[o] >= 1
field lnhq : or bound 262144                # 出現 o の次元1 は表の列の変数一つ（広さは列が言う）
lnhq[o] <- true                    for (o,zc) in ch if lnhv[o] >= 1
field lnh1 : or bound 262144                # 出現 o の次元1 は数一つ
lnh1[o] <- true                    for (o,zc) in ch if lnhs[o] >= 0 if isnum[lnhs[o]] if lnhd[o] == lnhs[o]
lqx[lnhs[o]] <- o                  for (o,zc) in ch if lnhs[o] >= 0 if lnh[lof[o]] >= 1 if not lnh1[o]
field l1cv : or bound 262144                # 出現 o の次元1 は、その次元ちょうどの塊になった
l1cv[o] <- true                    for (o,zc) in ch if lnhs[o] >= 0 if l0ok[lnhs[o]] if lse[lnhs[o]] == lnhd[o]
#   二次元でない出現（一次元・三次元）・持ち上がらない出現・広さを一つしか書いていない宣言があればずらさない
lngb[lof[o]] <- true               for (o,zc) in ch if isocc[o] if obr[o] >= 0 if lnh[lof[o]] >= 1
      if not lhc[o]
lngb[lof[o]] <- true               for (o,zc) in ch if isocc[o] if lnh[lof[o]] >= 1 if l3o[o]
lngb[lof[o]] <- true               for (o,zc) in ch if lnhs[o] >= 0 if lnh[lof[o]] >= 1 if not lnh1[o]
      if not l1cv[o]
lngb[fdno[t]] <- true              for (t,zc) in ch if isdcl[t] if lnh[fdno[t]] >= 1 if kwbnd[bndt[t]]
      if not hasw2[fdno[t]]
field lnhk : max bound 1024                 # 場 f の次元1 のずらし
lnhk[f] <- lnh[f]  for (f) in 0 .. nfdz[0] if lnh[f] >= 1 if not lngb[f]
lngr[lnhs[o]] <- lnhk[lof[o]]      for (o,zc) in ch if lnhs[o] >= 0 if lnhk[lof[o]] >= 1 if not lnh1[o]
lngr[lnhs[o]] <- lnhk[lof[o]]      for (o,zc) in ch if lnhs[o] >= 0 if lnhk[lof[o]] >= 1 if lnh1[o] if l1cv[o]
lngn[lnhs[o]] <- tval[lnhs[o]] + lnhk[lof[o]]   for (o,zc) in ch if lnhs[o] >= 0 if lnhk[lof[o]] >= 1
      if lnh1[o] if not l1cv[o]
ih1[lin[lnl[t]], 0] <- lb2[fdno[t]] + lnhk[fdno[t]]   for (t,zc) in ch if lnb[t] if lnhk[fdno[t]] >= 1
lngn[bw2[t]] <- lb2[fdno[t]] + lnhk[fdno[t]]   for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
      if lnhk[fdno[t]] >= 1
field lngf : or bound 262144                # 数を書き換えるトークン
lngf[t] <- true                    for (t,zc) in ch if lngn[t] >= 0
ldl[i] <- true                     for (i,c) in ch if lngf[tnum[i]]
iti[lin[t], 0] <- 9                for (t,zc) in ch if lngf[t]
ih0[lin[t], 0] <- lngn[t]          for (t,zc) in ch if lngf[t]
irw[lin[t], 0] <- lrw[lte[t]]      for (t,zc) in ch if lngf[t]
ibd[lin[t], 0] <- true             for (t,zc) in ch if lngf[t]

# ── 軸の規則の区間を揃える（14l）──────────────────────────────────────────────
# 焼き手は **軸に沿った成層**（石取りの勝ち負け `win[n] <- 1 … if win[n-1] == 0`）を、同じ場を書く軸の規則を
# 一つのループに融合して n を昇ることで焼く（33_self の「軸に沿った成層」・31_gen の融合）。融合するのは
# 区間の端が同じ規則だけなので、端の違う規則（`1 .. 15` と `2 .. 15`）を **いちばん広い区間に揃え、元の端を
# ガードにする**: `for (n) in 2 .. 15` → `for (n) in 1 .. 15 if n >= 2`。実例の集合は変わらない（広げた分は
# ガードで撃たない）。下端は数を書き換え（型紙 9）、上端は数を消して「新しい上端 + ガード」を差す（型紙 188〜190。
# 字の行には実例が一つしか住めないので、上端の行に一つにまとめる）。負の端と九文字以上の変数は揃えない
# 揃えるのは **軸の群**ごと（14o。二つ以上の場の群 —— 33_self の bax0 —— なら群の端の最小と最大へ、
# 成り立たなければ一つの場の軸（14l の形）へ）
field lqaf : or bound 1024                  # 場 f の軸の規則は一つで揃えられる
lqaf[hfz[s]] <- true   for (s) in 0 .. nstz[0] if sax1[s] if not fxw[hfz[s]] if not fxrd[hfz[s]]
      if fxl0[hfz[s]] >= 0 if fxnd[hfz[s]]
field lqbk : max bound 1024                 # 場 f の揃える群
lqbk[hfz[s]] <- sbid[s]   for (s) in 0 .. nstz[0] if sax1[s] if bax0[sbid[s]] if bxl0[sbid[s]] >= 0
lqbk[hfz[s]] <- hfz[s]    for (s) in 0 .. nstz[0] if sax1[s] if not bax0[sbid[s]] if lqaf[hfz[s]]
field slq : max bound 8192                  # 文 s の揃える群
slq[s] <- lqbk[hfz[s]]    for (s) in 0 .. nstz[0] if sax1[s]
field lqlo : min bound 1024                 # 群の下端の最小 / 上端の最大
lqlo[slq[s]] <- llo2[s, 0]   for (s) in 0 .. nstz[0] if slq[s] >= 0
field lqhi : max bound 1024
lqhi[slq[s]] <- lhi2[s, 0]   for (s) in 0 .. nstz[0] if slq[s] >= 0
field lqal : or bound 8192                  # 文 s の下端を下げる（最小の下端へ）
lqal[s] <- true   for (s) in 0 .. nstz[0] if slq[s] >= 0 if llo2[s, 0] > lqlo[slq[s]]
field lqah : or bound 8192                  # 文 s の上端を上げる（最大の上端へ）
lqah[s] <- true   for (s) in 0 .. nstz[0] if slq[s] >= 0 if lhi2[s, 0] < lqhi[slq[s]]
field lqin : max bound 8192                 # 文 s のループ 0 の `in`
lqin[snum[u]] <- u   for (u,zc) in ch if kwin[u] if lz[u] == 0
field lqv : max bound 8192                  # その変数のトークン（八文字まで）
lqv[s] <- lkv[s, 0]   for (s) in 0 .. nstz[0] if sax1[s] if tlen[lkv[s, 0]] <= 8
field lqup : max bound 262144               # 書き換える上端の数のトークン → 文
lqup[int4[lqin[s]]] <- s   for (s) in 0 .. nstz[0] if lqal[s] if lqv[s] >= 0
lqup[int4[lqin[s]]] <- s   for (s) in 0 .. nstz[0] if lqah[s] if lqv[s] >= 0
lngn[int1[lqin[s]]] <- lqlo[slq[s]]   for (s) in 0 .. nstz[0] if lqal[s] if lqv[s] >= 0
ldl[i] <- true                     for (i,c) in ch if lqup[tnum[i]] >= 0
iti[lin[t], 0] <- 188              for (t,zc) in ch if lqup[t] >= 0 if lqal[lqup[t]] if not lqah[lqup[t]]
iti[lin[t], 0] <- 189              for (t,zc) in ch if lqup[t] >= 0 if lqah[lqup[t]] if not lqal[lqup[t]]
iti[lin[t], 0] <- 190              for (t,zc) in ch if lqup[t] >= 0 if lqah[lqup[t]] if lqal[lqup[t]]
ih0[lin[t], 0] <- lqhi[slq[lqup[t]]]   for (t,zc) in ch if lqup[t] >= 0
ih1[lin[t], 0] <- llo2[lqup[t], 0]     for (t,zc) in ch if lqup[t] >= 0
ih2[lin[t], 0] <- lhi2[lqup[t], 0]     for (t,zc) in ch if lqup[t] >= 0
inm[lin[t], 0] <- lqv[lqup[t]]         for (t,zc) in ch if lqup[t] >= 0
irw[lin[t], 0] <- lrw[lte[t]]          for (t,zc) in ch if lqup[t] >= 0
ibd[lin[t], 0] <- true                 for (t,zc) in ch if lqup[t] >= 0

# ── アクセサ（14d）──────────────────────────────────────────────────────────
# 解釈実行は `constructor c(f, g)` から場 `c_f` / `c_g`（flat、項の番地で引く）と `_size`（max）を作り、
# 構成子の出現ごとに `c_f[番地] <- 引数` を足す。焼いた場は番地（56 ビット）を座標にできないので、
# **場所を比べて引く**: 出現の塊が場所 g ごとに番地を `_sad[g]` に写し（`_sv` と同じ道）、読み `c_f[e]` は
# 持ち上げた塊の値 `_sv[_ag, j] if _sad[_ag] == e for (_ag) in 0 .. _Sz[0] if _sk[_ag] == k` になる。
# 比べるのは flat どうしなので単調で、項を作る再帰の中でも層が要らない（13b）。同じ番地の場所は同じ中身
# （内容アドレス）なので、どの場所に当たっても答えは同じ。仕事は O(読み × 場所) —— 深さは O(1)（気づき24）。
# `_size[e]` は場所の大きさ `_ssz[g]`（1 と、子の場所の大きさ + 1 の max。子も番地を比べて引く）を同じ形で引く。
# 下ろさないもの（綴りが合わないまま残る → 焼き手が理由 4 で言う）: 原子を渡す引数のアクセサ・十七文字以上の
# 名前・書き先・区間の端・持ち上がらない読み
field lxft : or bound 262144                # 構成子の宣言の引数の名のトークン
lxft[t] <- true    for (t,zc) in ch if kcs[snum[t]] if tdep[t] == 1 if tkind[t] == 1 if colc[t] <= 3
field lxmc : max bound 262144               # トークン t より前の引数の名の数（アクセサの密な番号の鎖）
lxmc[0] <- 0
lxmc[t] <- lxmc[t-1] + 1   for (t,zc) in ch if t >= 1 if lxft[t-1]
lxmc[t] <- lxmc[t-1]       for (t,zc) in ch if t >= 1 if not lxft[t-1]
field lxmz : max bound 1                    # 最後のアクセサの番号
lxmz[z] <- lxmc[t]         for (t,zc) in ch for (z) in 0 .. 0 if lxft[t]
field lxk : max bound 256                   # アクセサ m の構成子
lxk[lxmc[t]] <- kcq[snum[t]]             for (t,zc) in ch if lxft[t]
field lxj : max bound 256                   # その引数の番号
lxj[lxmc[t]] <- colc[t]                  for (t,zc) in ch if lxft[t]
field lxn : max bound 262144                # 引数の名 t の構成子の名の長さ
lxn[t] <- tlen[kct[kcq[snum[t]]]]        for (t,zc) in ch if lxft[t]
field lxa : max bound 262144                # 引数の名 t の前に付く `構成子の名_` の長さ
lxa[t] <- lxn[t] + 1                     for (t,zc) in ch if lxft[t]
field lxl : max bound 256                   # アクセサ m の綴りの長さ
lxl[lxmc[t]] <- lxa[t] + tlen[t]         for (t,zc) in ch if lxft[t]
field lxq : max bound 256 16                # 綴りの p 文字目が引数の名の何文字目か
lxq[lxmc[t], p] <- p - lxa[t]            for (t,zc) in ch for (p) in 0 .. 15 if lxft[t] if p >= lxa[t]
field lxw : max bound 256 16                # アクセサ m の綴りの p 文字目
lxw[lxmc[t], p] <- tch[kct[kcq[snum[t]]], p]   for (t,zc) in ch for (p) in 0 .. 15 if lxft[t] if p < lxn[t]
lxw[lxmc[t], p] <- 95                    for (t,zc) in ch for (p) in 0 .. 15 if lxft[t] if p == lxn[t]
lxw[lxmc[t], p] <- tch[t, lxq[lxmc[t], p]]     for (t,zc) in ch for (p) in 0 .. 15 if lxft[t] if p >= lxa[t]
#   宣言の無い場の出現（`[` つき）に密な番号を振って、綴りを比べる
field lxdf : or bound 262144                # 出現 t の場は宣言してある
lxdf[t] <- true    for (t,zc) in ch if lof[t] >= 0
field lxu : or bound 262144                 # 宣言の無い場の出現
lxu[t] <- true     for (t,zc) in ch if isocc[t] if obr[t] >= 0 if not lxdf[t] if tkind[t] == 1
field lxuc : max bound 262144               # トークン t より前の宣言の無い出現の数
lxuc[0] <- 0
lxuc[t] <- lxuc[t-1] + 1   for (t,zc) in ch if t >= 1 if lxu[t-1]
lxuc[t] <- lxuc[t-1]       for (t,zc) in ch if t >= 1 if not lxu[t-1]
field lxut : max bound 4096                 # 宣言の無い出現 a のトークン
lxut[lxuc[t]] <- t         for (t,zc) in ch if lxu[t]
field lxuz : max bound 1
lxuz[z] <- lxuc[t]         for (t,zc) in ch for (z) in 0 .. 0 if lxu[t]
field lxd : or bound 4096 256               # 出現 a の綴りはアクセサ m と違う（字か長さ）
lxd[a, m] <- true   for (a) in 0 .. lxuz[0] for (m) in 0 .. lxmz[0] for (p) in 0 .. 15
      if tch[lxut[a], p] != lxw[m, p]
lxd[a, m] <- true   for (a) in 0 .. lxuz[0] for (m) in 0 .. lxmz[0] if tlen[lxut[a]] != lxl[m]
field lxam : max bound 262144               # 出現 u はアクセサ m の読み
lxam[lxut[a]] <- m  for (a) in 0 .. lxuz[0] for (m) in 0 .. lxmz[0] if not lxd[a, m]
field lxbad : or bound 256                  # アクセサ m は下ろさない（十七文字以上・原子を渡す引数）
lxbad[m] <- true    for (m) in 0 .. lxmz[0] if lxl[m] >= 17
lxbad[m] <- true    for (t,zc) in ch for (m) in 0 .. lxmz[0] if krf[t] if ltat[t] if lxk[m] == kap[kra[t]]
      if lxj[m] == kri[t]
#   下ろす読み（書き先・区間の端では下ろさない）と `_size` の読み
field lxo : or bound 262144                 # 下ろすアクセサの読み
lxo[u] <- true      for (u,zc) in ch if lxam[u] >= 0 if not lxbad[lxam[u]] if not lhd[u]
      if not clfor[snum[u], cnum[u]]
field lxs : or bound 262144                 # 下ろす `_size` の読み
lxs[u] <- true      for (u,zc) in ch if lxu[u] if tlen[u] == 5 if tch[u,0] == 95 if tch[u,1] == 115
      if tch[u,2] == 105 if tch[u,3] == 122 if tch[u,4] == 101 if kcz[0] >= 0 if not lhd[u]
      if not clfor[snum[u], cnum[u]]
field lxr : or bound 262144                 # 持ち上げる読み
lxr[u] <- true      for (u,zc) in ch if lxo[u]
lxr[u] <- true      for (u,zc) in ch if lxs[u]
#   持ち上げる区間は `[` から `]` まで（名は本文で消える）。名から始めると、同じ語から始まる区間
#   （構成子の引数 `cons(cons_hd[w[k]], …)`・ガードの辺）と始まりがぶつかり、どちらか一つしか立たない
lcd[obr[u]] <- tclos[obr[u]]   for (u,zc) in ch if lxr[u] if lok[snum[u]]
#   **持ち上がったときだけ書き換える**（持ち上がらなければ綴りのまま残り、焼き手が理由 4 で言う）
field lxok : or bound 262144
lxok[u] <- true     for (u,zc) in ch if lxr[u] if lsa[obr[u]] if lse[obr[u]] == tclos[obr[u]]
ldl[i] <- true      for (i,c) in ch if lxok[tnum[i]]
field lxob : max bound 262144               # 読み u の `[`
lxob[u] <- obr[u]   for (u,zc) in ch if lxok[u]
field lxcb : max bound 262144               # 読み u の `]`
lxcb[u] <- tclos[obr[u]]   for (u,zc) in ch if lxok[u]
ldl[tstart[lxob[u]]] <- true       for (u,zc) in ch if lxok[u]
ldl[tstart[lxcb[u]]] <- true       for (u,zc) in ch if lxok[u]
iti[lin[lxob[u]], 0] <- 176        for (u,zc) in ch if lxok[u] if lxo[u]
ih0[lin[lxob[u]], 0] <- lxj[lxam[u]]   for (u,zc) in ch if lxok[u] if lxo[u]
iti[lin[lxob[u]], 0] <- 178        for (u,zc) in ch if lxok[u] if lxs[u]
irw[lin[lxob[u]], 0] <- lrw[lte[lxob[u]]]   for (u,zc) in ch if lxok[u]
ibd[lin[lxob[u]], 0] <- true       for (u,zc) in ch if lxok[u]
iti[lin[lxcb[u]], 0] <- 177        for (u,zc) in ch if lxok[u] if lxo[u]
ih0[lin[lxcb[u]], 0] <- lxk[lxam[u]]   for (u,zc) in ch if lxok[u] if lxo[u]
iti[lin[lxcb[u]], 0] <- 179        for (u,zc) in ch if lxok[u] if lxs[u]
irw[lin[lxcb[u]], 0] <- lrw[lte[lxcb[u]]]   for (u,zc) in ch if lxok[u]
ibd[lin[lxcb[u]], 0] <- true       for (u,zc) in ch if lxok[u]
#   `_size` を読むなら場所の大きさの規則を一度だけ（型紙 180〜184）
field lxzp : or bound 1
lxzp[z] <- true     for (u,zc) in ch for (z) in 0 .. 0 if lxok[u] if lxs[u]
iti[14, 0] <- 180   for (z) in 0 .. 0 if lxzp[0]
iti[14, 1] <- 181   for (z) in 0 .. 0 if lxzp[0]
iti[14, 2] <- 182   for (z) in 0 .. 0 if lxzp[0]
iti[14, 3] <- 183   for (z) in 0 .. 0 if lxzp[0]
iti[14, 4] <- 184   for (z) in 0 .. 0 if lxzp[0]

# ── `is`（上集合の帰属 x ⊒ c）──────────────────────────────────────────
# 単調な読みだが、焼ける形では比較で書く: min は `<=`、max・sum・count は `>=`、flat は `==`
# （flat の ⊤ は、比較で読めば焼いた側が 5 で止まって言う）。左は場の読み（解釈実行もそれしか取らない）
field kwis : or bound 262144                # `is`
kwis[t] <- true   for (t,zc) in ch if tlen[t] == 2 if not tcom[t] if tch[t,0] == 105 if tch[t,1] == 115
field lis1 : max bound 262144               # `is` の左の出現
lis1[t] <- lbo[tmatch[prevw[t]]]   for (t,zc) in ch if kwis[t]
field lisl : max bound 262144               # その場の束
lisl[t] <- flatt[ofl[oseq[lis1[t]]] - 1]   for (t,zc) in ch if kwis[t]
field lisk : max bound 262144               # 差し替える型紙（66 `<=` / 67 `>=` / 68 `==`）
lisk[t] <- 66      for (t,zc) in ch if kwis[t] if lisl[t] == 1
lisk[t] <- 67      for (t,zc) in ch if kwis[t] if lisl[t] == 2
lisk[t] <- 67      for (t,zc) in ch if kwis[t] if lisl[t] == 8
lisk[t] <- 67      for (t,zc) in ch if kwis[t] if lisl[t] == 9
lisk[t] <- 68      for (t,zc) in ch if kwis[t] if lisl[t] == 6

# 表の升は数か原子。列が原子を持つかは (表, 列) の旗
field ltc : or bound 262144                 # 表の升（range の表は升を持たない）
ltc[t] <- true    for (t,zc) in ch if isfr[t]
ltc[t] <- true    for (t,zc) in ch if atv[t] if istb[snum[t]]
field ltv : max bound 262144                # 表の升の値
ltv[t] <- tval[t] for (t,zc) in ch if isfr[t]
ltv[t] <- qv[t]   for (t,zc) in ch if atv[t] if istb[snum[t]]
nrw[tbk[snum[t]]] <- rowc[t]        for (t,zc) in ch if atv[t] if istb[snum[t]]
field lta : or bound 16 16                  # 表 k の列 c は原子の列
lta[tbk[snum[t]], colc[t]] <- true  for (t,zc) in ch if atv[t] if istb[snum[t]]
# 規則の中の文字列は字を消して番号を差す（表の文は丸ごと消える）
field qdl : or bound 262144                 # 原子にする文字列のトークン（`"` も中身も）
qdl[t] <- true    for (t,zc) in ch if atv[qa[t]]
field qrl : or bound 262144                 # 規則・種の中の原子の文字列（開きの `"`）
qrl[t] <- true    for (t,zc) in ch if atv[t] if qq[t] if not istb[snum[t]] if not lsel[t]
# **どの (場, 次元) が原子を持つか**は不動点で決まる: 原子・原子の列の変数・値が原子の場の読みが
# 書き先の座標や値の頭に立てば、その場のその次元（値）は原子。print はそれを見て綴りに戻す
field ltat : or bound 262144                # トークン t は原子を指す
field aav : or bound 1024                   # 場 f の値は原子
field aat : or bound 1024 2                 # 場 f の次元 d は原子
field lvf : max bound 8192                  # 文 s の値の最初の語
lvf[s] <- nextw[arrowt[s] + 1]     for (s) in 0 .. nstz[0] if arrowt[s] >= 0
ltat[t] <- true   for (t,zc) in ch if qrl[t]
ltat[t] <- true   for (t,zc) in ch if lvu[t] if lta[lvt[t], vcolz[t]]
ltat[t] <- true   for (t,zc) in ch if isocc[t] if aav[ofl[oseq[t]] - 1]
aat[lhf[o], 0] <- true   for (o,zc) in ch if lhd[o] if ltat[lhj0[o]]
aat[lhf[o], 1] <- true   for (o,zc) in ch if lhd[o] if ltat[lhj1[o]]
aav[lhf[o]] <- true      for (o,zc) in ch if lhd[o] if ltat[lvf[snum[o]]]

# ── 場の広さ（下ろした後の）─────────────────────────────────────────────
# **広さは書き先の座標が言う**（区間解析）。書き先の次元ごとに添字の最大を出す: 数ならその数、
# 表の変数なら列の最大、区間の変数なら上端、それぞれ ± ずれ。分からない（読み・式・上端が場）
# 次元は既定（一次元 4096、二次元 256）以上。読みは広さに効かない（外は両方で ⊥）。
# 狭く推しすぎれば焼いた本が「宣言が嘘」（終了コード 6）と言う —— 黙って違う答えにはならない。
field lhb : or bound 1024                   # 場 f は広さを書いてある
lhb[fdno[t]] <- true                for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
field ltcm : max bound 16 16                # 表 k の列 j の最大の値
ltcm[tbk[snum[t]], colc[t]] <- ltv[t]   for (t,zc) in ch if ltc[t] if colc[t] <= 15
field ljo : max bound 262144                # 添字 j のずれ（無ければ 0）
ljo[j] <- 0                        for (j,zc) in ch if not ixhf[j]
ljo[j] <- ixnv[j]                  for (j,zc) in ch if ixhf[j] if isplus[ixop[j]]
ljo[j] <- 0 - ixnv[j]              for (j,zc) in ch if ixhf[j] if ismin[ixop[j]]
field ljm : max bound 262144                # 添字 j の最大（ずれ込み）
field ljk : or bound 262144                 # 添字 j の最大が分かる
ljm[j] <- tval[j] + ljo[j]         for (j,zc) in ch if isnum[j]
ljk[j] <- true                     for (j,zc) in ch if isnum[j]
ljm[j] <- qv[j]                    for (j,zc) in ch if qrl[j]
ljk[j] <- true                     for (j,zc) in ch if qrl[j]
field lvlk : max bound 262144               # 変数 j のループの書き方（lkd）
lvlk[j] <- lkd[snum[j], vlpz[j]]   for (j,zc) in ch if tkind[j] == 1 if vbnd[j] >= 0 if not isocc[j]
ljm[j] <- ltcm[lvt[j], vcolz[j]] + ljo[j]   for (j,zc) in ch if lvlk[j] == 0 if not ltr[lvt[j]]
ljk[j] <- true                     for (j,zc) in ch if lvlk[j] == 0 if not ltr[lvt[j]]
ljm[j] <- trh[lvt[j]] - 1 + ljo[j] for (j,zc) in ch if lvlk[j] == 0 if ltr[lvt[j]]
ljk[j] <- true                     for (j,zc) in ch if lvlk[j] == 0 if ltr[lvt[j]]
ljm[j] <- lhi2[snum[j], vlpz[j]] + ljo[j]   for (j,zc) in ch if lvlk[j] == 1
ljk[j] <- true                     for (j,zc) in ch if lvlk[j] == 1
field lhj0 : max bound 262144               # 書き先 o の次元 0 の添字
lhj0[o] <- ob1[o]                  for (o,zc) in ch if lhd[o] if obk[o]
field lhj1 : max bound 262144               # 書き先 o の次元 1 の添字
lhj1[o] <- d1t[o]                  for (o,zc) in ch if lhd[o] if obk[o] if iscom[d0cm[o]]
field lhj2 : max bound 262144               # 書き先 o の次元 2 の添字
lhj2[o] <- d2t[o]                  for (o,zc) in ch if lhd[o] if obk[o] if iscom[d1cm[o]]
field lhf : max bound 262144                # 書き先 o の場（0 起点）
lhf[o] <- ofl[oseq[o]] - 1         for (o,zc) in ch if lhd[o]
field lbm : max bound 1024 3                # 場 f の次元 d の書き先の添字の最大
field lbu : or bound 1024 3                 # 場 f の次元 d に分からない書き先がある
lbm[lhf[o], 0] <- ljm[lhj0[o]]     for (o,zc) in ch if lhd[o] if ljk[lhj0[o]] if not lcs0[lhj0[o]]
lbm[lhf[o], 0] <- ljm[lhj0[o]]     for (o,zc) in ch if lhd[o] if ljk[lhj0[o]] if lngq[o]   # 表の列でずらした次元0（14x）
lbu[lhf[o], 0] <- true             for (o,zc) in ch if lhd[o] if obk[o] if not ljk[lhj0[o]] if not lemp[obr[o]]
lbu[lhf[o], 0] <- true             for (o,zc) in ch if lhd[o] if lcs0[lhj0[o]] if not lngq[o]
lbm[lhf[o], 0] <- 0                for (o,zc) in ch if lhd[o] if lemp[obr[o]]
lbm[lhf[o], 1] <- ljm[lhj1[o]]     for (o,zc) in ch if lhd[o] if ljk[lhj1[o]] if not lcs0[lhj1[o]]
lbm[lhf[o], 1] <- ljm[lhj1[o]]     for (o,zc) in ch if lhd[o] if ljk[lhj1[o]] if lnhq[o]   # 表の列でずらした次元1（14x）
lbu[lhf[o], 1] <- true             for (o,zc) in ch if lhd[o] if lhj1[o] >= 0 if not ljk[lhj1[o]]
lbu[lhf[o], 1] <- true             for (o,zc) in ch if lhd[o] if lcs0[lhj1[o]] if not lnhq[o]
lbm[lhf[o], 2] <- ljm[lhj2[o]]     for (o,zc) in ch if lhd[o] if ljk[lhj2[o]] if not lcs0[lhj2[o]]
lbu[lhf[o], 2] <- true             for (o,zc) in ch if lhd[o] if lhj2[o] >= 0 if not ljk[lhj2[o]]
lbu[lhf[o], 2] <- true             for (o,zc) in ch if lhd[o] if lcs0[lhj2[o]]
field lb1 : max bound 1024                  # 場 f の次元0 の広さ
lb1[f] <- fwid[f]                   for (f) in 0 .. nfdz[0] if lhb[f]
lb1[f] <- 1                         for (f) in 0 .. nfdz[0] if not lhb[f]
lb1[f] <- lbm[f, 0] + 1             for (f) in 0 .. nfdz[0] if not lhb[f] if lbm[f, 0] >= 0
lb1[f] <- 4096                      for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 1 if lbu[f, 0]
lb1[f] <- 256                       for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 2 if lbu[f, 0]
lb1[f] <- 64                        for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 3 if lbu[f, 0]
field lb2 : max bound 1024                  # 場 f の次元1 の広さ（一次元は 1）
lb2[f] <- 1                         for (f) in 0 .. nfdz[0] if farr[f] == 1
lb2[f] <- fwid2[f]                  for (f) in 0 .. nfdz[0] if lhb[f] if farr[f] >= 2
lb2[f] <- 1                         for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] >= 2
lb2[f] <- lbm[f, 1] + 1             for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] >= 2 if lbm[f, 1] >= 0
lb2[f] <- 256                       for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 2 if lbu[f, 1]
lb2[f] <- 64                        for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 3 if lbu[f, 1]
# 三次元の既定は 64 × 64 × 64（二次元の 256 × 256 と同じ升の数の桁 —— 置き場は束 × 升で決まる）
field lb3 : max bound 1024                  # 場 f の次元2 の広さ（三次元でなければ 1）
lb3[f] <- 1                         for (f) in 0 .. nfdz[0] if farr[f] <= 2
lb3[f] <- fwid3[f]                  for (f) in 0 .. nfdz[0] if lhb[f] if farr[f] == 3
lb3[f] <- 1                         for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 3
lb3[f] <- lbm[f, 2] + 1             for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 3 if lbm[f, 2] >= 0
lb3[f] <- 64                        for (f) in 0 .. nfdz[0] if not lhb[f] if farr[f] == 3 if lbu[f, 2]
field lsz : max bound 1024                  # 場 f の升の数
lsz[f] <- lpb1[f] * lpb2[f] * lb3[f]  for (f) in 0 .. nfdz[0]   # ずらしたあとの広さ（14k）

# ── print（文の順に数える）──────────────────────────────────────────────
field lsp : or bound 8192                   # 文 s は print
lsp[snum[t]] <- true                for (t,zc) in ch if sbrk[t] if kwprn[t]
field pdo : max bound 8192                  # 文 s より前にある print の数
pdo[s] <- 0                         for (s) in 0 .. nstz[0]
pdo[s] <- pdo[s-1] + 1              for (s) in 1 .. nstz[0] if lsp[s-1]
pdo[s] <- pdo[s-1]                  for (s) in 1 .. nstz[0] if not lsp[s-1]
field lpo : or bound 262144                 # print の名のトークン
# **print の広さはずらしたあとの広さ**（14k）。ずらした場の宣言は広さが k 増えるので、print の行も k 増やす
field lpb1 : max bound 1024                 # print する場 f の次元0 の広さ（ずらしを足す）
lpb1[f] <- lb1[f]                   for (f) in 0 .. nfdz[0]
lpb1[f] <- lb1[f] + lngk[f]         for (f) in 0 .. nfdz[0] if lngk[f] >= 1
field lpb2 : max bound 1024                 # 次元1
lpb2[f] <- lb2[f]                   for (f) in 0 .. nfdz[0]
lpb2[f] <- lb2[f] + lnhk[f]         for (f) in 0 .. nfdz[0] if lnhk[f] >= 1
lpb1[f] <- lb1[f] + lsnk[f]         for (f) in 0 .. nfdz[0] if lsk0[f] if lsnq[f]   # 集合の要素のずらし（14x）
lpb2[f] <- lb2[f] + lsnk[f]         for (f) in 0 .. nfdz[0] if lsk1[f] if lsnq[f]
lpo[t] <- true                      for (t,zc) in ch if isocc[t] if kwprn[prevw[t]]
field pfd : max bound 64                    # print p の場（宣言の番号。1 起点）
pfd[pdo[snum[t]]] <- ofl[oseq[t]]   for (t,zc) in ch if lpo[t] if pdo[snum[t]] <= 63
field psz : max bound 64                    # print p の行の数（⊥ の行 + 升）
psz[p] <- lsz[pfd[p] - 1] + 1       for (p) in 0 .. 63 if pfd[p] >= 1
field pbs : max bound 64                    # print p の頭の行
pbs[0] <- 0
pbs[p] <- pbs[p-1] + psz[p-1]       for (p) in 1 .. 63 if psz[p-1] >= 1
# print の名のトークン t の場（0 起点）・番号・広さ
field lpf : max bound 262144
lpf[t] <- ofl[oseq[t]] - 1          for (t,zc) in ch if lpo[t]
field lpp : max bound 262144
lpp[t] <- pdo[snum[t]]              for (t,zc) in ch if lpo[t]
field lpb : max bound 262144                # その print の頭の行
lpb[t] <- pbs[lpp[t]]               for (t,zc) in ch if lpo[t]
field lpe : max bound 262144                # その print の最後の行
lpe[t] <- pbs[lpp[t]] + lsz[lpf[t]] for (t,zc) in ch if lpo[t]
field lpd : max bound 262144                # 名のトークン t の print のトークンの実例の番号
lpd[t] <- lis[prevw[t]]             for (t,zc) in ch if lpo[t]
field lp1 : or bound 262144                 # 一次元の print
lp1[t] <- true                      for (t,zc) in ch if lpo[t] if farr[lpf[t]] == 1 if not lsk[lpf[t]]
field lp2 : or bound 262144                 # 二次元の print
lp2[t] <- true                      for (t,zc) in ch if lpo[t] if farr[lpf[t]] == 2 if not lsk[lpf[t]]
field lpor : or bound 262144                 # or の場の print（`true` と書く）
field lpfl : or bound 262144                 # flat の場の print（⊤ の行を `⊤ CONFLICT` と書く）
lpfl[t] <- true                      for (t,zc) in ch if lpo[t] if flatt[lpf[t]] == 6
# **数の場も ⊤ を持つ**（14v）: 定義は flat の ⊤ を読んだ値を min / max / sum の場へも ⊤ として運び、
# `⊤ CONFLICT` と書く。⊤ の源は利用者の flat の場だけなので（count は ⊤ を一つと数え、or は `true` しか
# 書かない）、flat の場のある本の数の場の print に同じ ⊤ の行を足す —— 比較は ⊤ で立つので `< 0` と
# `>= 0` が両方立つのは ⊤ の升だけ（sum の 0 は ⊥ で立たない）。⊤ にならない場では行が一つも立たない
field lhflt : or bound 1                    # 本に利用者の flat の場がある
lhflt[z] <- true   for (t,zc) in ch for (z) in 0 .. 0 if lbflt[t]
lpfl[t] <- true                      for (t,zc) in ch if lpo[t] if flatt[lpf[t]] == 1 if lhflt[0]
lpfl[t] <- true                      for (t,zc) in ch if lpo[t] if flatt[lpf[t]] == 2 if lhflt[0]
lpfl[t] <- true                      for (t,zc) in ch if lpo[t] if flatt[lpf[t]] == 8 if lhflt[0]
lpor[t] <- true                      for (t,zc) in ch if lpo[t] if flatt[lpf[t]] == 3
field lf0 : or bound 1024                   # 場 f は `[]` で使われる（print は座標を書かない: `n[] = v`）
lf0[lof[prevw[t]]] <- true   for (t,zc) in ch if lemp[t] if isocc[prevw[t]]

# ── ANF: ガードの辺の算術に名前を置く ───────────────────────────────────
# 焼ける形のガードの辺は「読み・列・計数器・定数」だけ（SPEC §12）。`if x % 2 == 1` の `x % 2` は
# 辺に書けない —— **文の反復空間の上に場を一つ置き**（`_g<ta>[ループの変数] <- x % 2`）、辺を
# その読みに差し替える。コンパイラの ANF（部分式に名前を付ける）を反復空間に開いたもの。
# 区間は **字を動かすだけ** で作る: 区間の字は本文の行から塊の行へ移り（字に付く差し替えも一緒に）、
# 本文の抜けた行に参照 `_g<ta>[…]` を置く。場は flat（座標ごとに値は一つ。比べる前に閉じる）。
field lsym : or bound 262144                # 算術の記号（矢印の `-` を除く）
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 43
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 45 if not arrw[t-1]
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 42
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 47
lsym[t] <- true    for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 37
field lgz : max bound 1                     # 最後の節の番号
lgz[z] <- gcl[t]                   for (t,zc) in ch for (z) in 0 .. 0
field lch : max bound 262144                # 節 g の頭のトークン
lch[gcl[t]] <- t                   for (t,zc) in ch if cbrk[t]
field lgi : or bound 262144                 # 節 g は `if` の節
lgi[g] <- true                     for (g) in 0 .. lgz[0] if kwif[lch[g]]
field lgd : max bound 262144                # 節 g の深さ（`if` の括弧の深さ）
lgd[g] <- tdep[lch[g]]             for (g) in 0 .. lgz[0] if lgi[g]
field lcm : min bound 262144                # 節 g の最初の比較の記号（節の深さで）
lcm[gcl[t]] <- t                   for (t,zc) in ch if cmpt[t] if tdep[t] == lgd[gcl[t]]
field lcx : max bound 262144                # 節 g の最後の比較の記号
lcx[gcl[t]] <- t                   for (t,zc) in ch if cmpt[t] if tdep[t] == lgd[gcl[t]]
field lce : max bound 262144                # 節 g の最後の語か記号
lce[gcl[t]] <- t                   for (t,zc) in ch if tkind[t] != 3 if not tcom[t] if lgi[gcl[t]]
field lal : or bound 262144                 # 節 g の左辺に算術
lal[gcl[t]] <- true                for (t,zc) in ch if lsym[t] if tdep[t] == lgd[gcl[t]] if t < lcm[gcl[t]]
      if t > lch[gcl[t]]
field lar : or bound 262144                 # 節 g の右辺に算術
lar[gcl[t]] <- true                for (t,zc) in ch if lsym[t] if tdep[t] == lgd[gcl[t]] if t > lcx[gcl[t]]
# 文 s のループ（0 起点で二つまで。種を規則にした文は一点のループ `_z`）
field lnlp : max bound 8192                 # 文 s の for 節の数
lnlp[snum[t]] <- lz[t] + 1         for (t,zc) in ch if kwfor[t] if lz[t] >= 0
field lok : or bound 8192                   # 文 s は持ち上げてよい（ループが二つまで）
lok[s] <- true                     for (s) in 0 .. nstz[0] if lnlp[s] >= 1
lok[s] <- true                     for (s) in 0 .. nstz[0] if lsx[s]
field lcd : max bound 262144                # 持ち上げる候補の区間: 最初のトークン → 最後のトークン
lcd[nextw[lch[g]]] <- prevw[lcm[g]]   for (g) in 0 .. lgz[0] if lal[g] if lok[snum[lch[g]]]
lcd[nextw[lcx[g]]] <- lce[g]          for (g) in 0 .. lgz[0] if lar[g] if lok[snum[lch[g]]]
# **座標の次元**: 焼き手の前段（lib/fold.lx）が「座標の語として読めた」と数えなかった語 u
# （`c[i*2]` の `*`・`2`、`out[o[x], x - o[x]]` の `- o[x]` …）—— 焼き手が理由 8 で断る語
# **そのもの**を見て、その語を含む次元を持ち上げる。何を持ち上げるかの判断を下ろしに
# 二度書かない（気づき34）。書き先の座標の「定数で引いた読み」（`op[n[0] + 1]`）も同じく持ち上げる。
field lbo : max bound 262144                # `[` のトークン → その出現
lbo[obr[t]] <- t                   for (t,zc) in ch if obk[t]
field lqx : max bound 262144                # 次元を持ち上げさせる語 → その出現
lqx[u] <- lbo[ibr[u]]              for (u,zc) in ch if tdep[u] >= 1 if tch[ibr[u], 0] == 91
      if tkind[u] != 3 if not tcom[u] if not crdok[u] if not qdl[u]
field lhd : or bound 262144                 # 出現のトークン t は書き先
lhd[t] <- true                     for (t,zc) in ch if isocc[t] if ohd[oseq[t]]
lqx[p] <- lbo[ibr[p]]              for (p,zc) in ch if obk[p] if isnum[ob1[p]] if lhd[lbo[ibr[p]]]
lqx[p] <- lbo[ibr[p]]              for (p,zc) in ch if obk[p] if lemp[obr[p]] if lhd[lbo[ibr[p]]]
      if not lsxf[obr[p]]
lqx[p] <- lbo[ibr[p]]              for (p,zc) in ch if obk[p] if qrl[ob1[p]] if lhd[lbo[ibr[p]]]
field lq2 : or bound 262144                 # 語 u は出現の次元 1 に居る
lq2[u] <- true                     for (u,zc) in ch if lqx[u] >= 0 if lhc[lqx[u]] if u > lfcm[lqx[u]]
field lqo : max bound 262144                # 次元 0 を持ち上げる出現
lqo[u] <- lqx[u]                   for (u,zc) in ch if lqx[u] >= 0 if not lq2[u]
field lqo1 : max bound 262144               # 次元 1 を持ち上げる出現
# **三次元以上の出現の次元1 は持ち上げない。** 焼き手の前段は次元1 の後ろの語を座標と数えないので、
# 持ち上げると `,` ごと塊に入り、焼き手は **下ろしが足した行**（利用者の知らない行番号）で断る。
# 持ち上げなければ利用者の書いた行で断る（三次元は焼き手の資源 —— 次の口）
field lbc : max bound 262144                # 添字の `,` → その `[` の出現
lbc[c] <- lbo[ibr[c]]              for (c,zc) in ch if iscom[c] if tch[ibr[c], 0] == 91
# **次元の切れ目は深さ一の最初の `,` が言う**（14c）。前は前段の `d0cm`（次元0 の添字の後ろの語）で見ていたが、
# `d0cm` は添字を「読み・語 + ずれ」としか読まないので、`f[i * 2, j]` や `g[-1, 0]` では `,` でない語を指し、
# 次元0 の区間が括弧の中身ぜんぶになって `_g[…] <- i * 2, j` という壊れた塊を出していた（焼き手が断る）
field lfcm : min bound 262144               # 出現 o の添字の最初の `,`
lfcm[lbc[c]] <- c                  for (c,zc) in ch if lbc[c] >= 0
field lhc : or bound 262144                 # 出現 o の添字に `,` がある（二次元以上）
lhc[lbc[c]] <- true                for (c,zc) in ch if lbc[c] >= 0
field l3o : or bound 262144                 # 三次元以上の出現（次元1 の後ろにもう一つ `,`）
l3o[lbc[c]] <- true                for (c,zc) in ch if lbc[c] >= 0 if c > lfcm[lbc[c]]
lqo1[u] <- lqx[u]                  for (u,zc) in ch if lq2[u] if not l3o[lqx[u]]
lcd[ob1[lqo[u]]] <- prevw[lfcm[lqo[u]]]      for (u,zc) in ch if lqo[u] >= 0 if lhc[lqo[u]]
      if lok[snum[u]]
lcd[ob1[lqo[u]]] <- prevw[tclos[obr[lqo[u]]]]   for (u,zc) in ch if lqo[u] >= 0 if not lhc[lqo[u]]
      if lok[snum[u]]
lcd[nextw[lfcm[lqo1[u]]]] <- prevw[tclos[obr[lqo1[u]]]] for (u,zc) in ch if lqo1[u] >= 0 if lok[snum[u]]
# **内側の二次元の読みの次元1 に読み**（`al[nsep[match[k]+1, pre[k]]]` の `nsep[…, pre[k]]`）: 焼き手は
# 内側の出現を r9 一本で畳むので、次元1 の読みがそれを潰す —— 語は全部読めるのに断る（31_gen の
# `isin[cso[gc]] if csd[gc] >= 1`）。内側の出現ごと持ち上げる: 塊の中では **外側の読み** になる
field l2i : or bound 262144                 # 内側の二次元の出現で、次元1 に読みがある
l2i[t] <- true                     for (t,zc) in ch if obk[t] if tdep[t] >= 1 if tch[ibr[t], 0] == 91
      if iscom[d0cm[t]] if isocc[d1t[t]]
lcd[t] <- tclos[obr[t]]            for (t,zc) in ch if l2i[t] if lok[snum[t]]
# **値の丸括弧**（`(120 + c[0]) % 256`）: 焼ける値は群の和で、丸括弧を持たない。**中身**を持ち上げ、
# 中身が持ち上がったときだけ括弧の字を消す（`lpq`）
field lpc : max bound 262144                # `(` → 対の `)`（tclos は `[` だけ）
lpc[tmatch[t]] <- t                for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 41
# **入れ子の値の丸括弧**（14r。`(a[i] + 13 * (b[i] + 1) / 5) % 7` の内側）と **ガードの辺の丸括弧**
# （`if (a[i] % 2) == 0`・`if (x % 3) + 1 == 2`）: 前は値の節の深さ 0 の丸括弧だけが候補で、内側の丸括弧は
# 塊に残り、ガードの辺の丸括弧は辺ごと残って、焼き手が理由 8 で断っていた。
# 候補は **括弧の中身**（最初の語 `nextw[(]` から）で取る。括弧ごと取ると、辺の算術の候補（辺の最初の語から）と
# **始まりの語がぶつかる**（`lcd` は始まりの語ごとに一つ）—— `(x % 3) + 1` の辺と `(x % 3)` の括弧が同じ `(` で
# 始まり、max が辺を選んで括弧は残った。そのうえ字を消す規則は「区間が `(` で始まる」で括弧の塊と見ていたので、
# 辺の塊の `(` と **最後の語 `1` の字** を消していた（`_g[i] <- a[i] % 3) +`。焼き手がたまたま断っていた）。
# 「括弧の塊か」を最初の字で測り直さず、**括弧の対そのもの**（`lpc`）で言う（判断を二箇所に置かない）
field lvp : or bound 262144                 # `(` は値の丸括弧（外側まで丸括弧だけ）
lvp[t] <- true                     for (t,zc) in ch if isopn[t] if aftarw[t] if not tcom[t] if not kpf[t]
#   ガードの辺の丸括弧（節の深さで、最初の比較より前か、最後の比較より後ろ）
lvp[t] <- true                     for (t,zc) in ch if isopn[t] if lgi[gcl[t]] if tdep[t] == lgd[gcl[t]]
      if not tcom[t] if not kpf[t] if t > lch[gcl[t]] if t < lcm[gcl[t]]
lvp[t] <- true                     for (t,zc) in ch if isopn[t] if lgi[gcl[t]] if tdep[t] == lgd[gcl[t]]
      if not tcom[t] if not kpf[t] if t > lcx[gcl[t]]
#   値の丸括弧のすぐ内の丸括弧、構成子の引数の丸括弧（`cons((i + 1) % 3, 0)`）
lvp[t] <- true                     for (t,zc) in ch if isopn[t] if tdep[t] >= 1 if not tcom[t]
      if not kpf[t] if lvp[ibr[t]]
lvp[t] <- true                     for (t,zc) in ch if isopn[t] if tdep[t] >= 1 if not tcom[t]
      if not kpf[t] if kpf[ibr[t]]
#   添字のすぐ内の丸括弧（`a[(i + 1) % 5]`。添字の算術は次元ごと塊になるので、その中の丸括弧も値の丸括弧）
lvp[t] <- true                     for (t,zc) in ch if isopn[t] if tdep[t] >= 1 if not tcom[t]
      if not kpf[t] if tch[ibr[t], 0] == 91
lcd[nextw[t]] <- prevw[lpc[t]]     for (t,zc) in ch if lvp[t] if lok[snum[t]] if nextw[t] < lpc[t]
      if not lfnp[t]
# ── `min(a, b)` / `max(a, b)` の関数（14u）────────────────────────────────────
# 定義の関数は ⊥ に厳しい（どちらかが ⊥ なら ⊥）二項の min / max で、両方の引数に単調。焼き手の項は
# 左からの畳み込みで関数を持たない。だが min / max は **束の join そのもの**である —— 関数の束の場に、
# 二つの引数を二つの実例として書けば、join が関数になる。⊥ に厳しいのは、**どちらの実例も両方の
# 引数を読む**ことで言う: `_g[鍵] <- A * _md + B * _mc for (_mc) in 0 .. 1 for (_md) in 0 .. 1 if _mc != _md`
# —— (0, 1) の実例は A、(1, 0) の実例は B を置き、片方が ⊥ ならどちらの実例も撃たない。掛けるのは
# 計数器（0 と 1）なので単調で、関数を再帰の中に置ける（最短路の `min(d[u] + w, 上限)`）。
# 引数は塊に持ち上げ（掛け算の左に式を置くため）、`(` から `)` までをもう一つの塊にする（名で始めないのは、
# 名で始まる別の候補 —— ガードの辺・値の丸括弧の中身 —— と始まりの語がぶつからないため。名の字は消す）。
field lfn : max bound 262144                # min / max の関数の名 → 1 min / 2 max
lfn[t] <- 1              for (t,zc) in ch if kwmin[t] if isopn[nextw[t]] if hasr[snum[t]]
lfn[t] <- 2              for (t,zc) in ch if kwmax[t] if isopn[nextw[t]] if hasr[snum[t]]
field lfnp : or bound 262144                 # 関数の `(`
lfnp[nextw[t]] <- true    for (t,zc) in ch if lfn[t] >= 1
field lfnk : max bound 262144                # その `(` の関数
lfnk[nextw[t]] <- lfn[t]  for (t,zc) in ch if lfn[t] >= 1
field lfnc : min bound 262144               # 関数の `(` → 直下の最初の `,`
lfnc[ibr[c]] <- c        for (c,zc) in ch if iscom[c] if tdep[c] >= 1 if lfnp[ibr[c]]
field lfn2 : or bound 262144                # 直下の `,` が二つ以上（引数が三つ —— 定義も断る）
lfn2[ibr[c]] <- true     for (c,zc) in ch if iscom[c] if tdep[c] >= 1 if lfnp[ibr[c]] if c > lfnc[ibr[c]]
field lfnq : or bound 262144                 # 下ろす関数の `(`（引数が二つで、どちらにも語がある）
lfnq[p] <- true           for (p,zc) in ch if lfnp[p] if lfnc[p] >= 0 if not lfn2[p] if lok[snum[p]]
      if nextw[p] < lfnc[p] if nextw[lfnc[p]] < lpc[p]
lcd[nextw[p]] <- prevw[lfnc[p]]         for (p,zc) in ch if lfnq[p]
lcd[nextw[lfnc[p]]] <- prevw[lpc[p]]    for (p,zc) in ch if lfnq[p]
lcd[p] <- lpc[p]                        for (p,zc) in ch if lfnq[p]
#   引数の中の丸括弧も値の丸括弧（関数が値の外 —— 区間の上端など —— に居ても）
lvp[t] <- true                     for (t,zc) in ch if isopn[t] if tdep[t] >= 1 if not tcom[t]
      if not kpf[t] if lfnq[ibr[t]]
# **構成子の引数**（`c(e1, e2)` の e1・e2 —— 出現の鍵で場所の記録に持ち上げる）
lcd[kas[x]] <- prevw[kny[x]]       for (x,zc) in ch if kas[x] >= 0 if lok[snum[x]]
# **区間の上端の式**（13g）。焼き手は上端に数・`f[数]`・`f[外の区間の変数]` を焼く（種1/2/3）。
# それ以外（`n[i] - 1`、表の変数で引いた `n[i]` —— 下ろすと `n[_t0c0[_r0]]` の入れ子になる）は
# 上端の区間を持ち上げる: `_g<ta>[使うループ] <- 式`、本文の上端は `_g<ta>[…]` —— 種3 の形になる。
field lfe : max bound 262144                # for 節の最後の語（大域の節ごと）
lfe[gcl[t]] <- t                   for (t,zc) in ch if tkind[t] != 3 if not tcom[t] if clfor[snum[t], cnum[t]]
field lbs : or bound 262144                 # `in` の上端は焼き手がそのまま焼ける形
lbs[t] <- true   for (t,zc) in ch if kwin[t] if irng[t] if isnum[int4[t]] if lfe[gcl[t]] == int4[t]
lbs[t] <- true   for (t,zc) in ch if kwin[t] if irng[t] if isocc[int4[t]] if isnum[int4b[t]]
      if lfe[gcl[t]] == nextw[int4b[t]]
lbs[t] <- true   for (t,zc) in ch if kwin[t] if irng[t] if isocc[int4[t]] if not isnum[int4b[t]]
      if vbnd[int4b[t]] >= 0 if lkd[snum[t], ivl[t]] >= 1 if lfe[gcl[t]] == nextw[int4b[t]]
#   `f[]` は下ろしが `f[0]` にする（型紙 4）—— 種2 の形なので持ち上げない
lbs[t] <- true   for (t,zc) in ch if kwin[t] if irng[t] if isocc[int4[t]] if tch[int4b[t], 0] == 93
      if lfe[gcl[t]] == int4b[t]
lcd[int4[t]] <- lfe[gcl[t]]        for (t,zc) in ch if kwin[t] if irng[t] if not lbs[t] if lok[snum[t]]
field lrbc : or bound 262144                # 持ち上げる候補は区間の端
lrbc[int4[t]] <- true              for (t,zc) in ch if kwin[t] if irng[t] if not lbs[t] if lok[snum[t]]
# **区間の下端の式**（13i）。解釈実行の文法では、下端は数・`..` が直に続く名前・丸括弧の式・数や記号で
# 始まる式で、**名前で始まって `..` が続かないもの**（`in lo[0] .. 9`）は表の名と読まれて断られる ——
# それは持ち上げない（焼き手が理由 8 で断る。持ち上げると、定義が断る源に答えてしまう）。
# 焼き手は下端に数・`(f[数])`・`(f[外の区間の変数])`・裸の外の区間の変数を焼く。それ以外は持ち上げる:
#   丸括弧が下端ぜんぶを包む（`(i + 1) .. n`）→ 中身を持ち上げる。丸括弧は残るので `(_g<ta>[i]) .. n`
#   裸の式（`0 - 2 .. n`、表の変数 `a .. n`）→ ぜんぶ持ち上げ、参照を丸括弧つきの型紙で書く（112〜115）
# 下ろした本も解釈実行が読める Lattix である（下ろしは意味を変えずに形だけを変える）。
field lls : or bound 262144                 # `in` の下端は焼き手がそのまま焼ける形
lls[t] <- true   for (t,zc) in ch if kwin[t] if irng[t] if isnum[int1[t]] if nextw[int1[t]] == int2[t]
lls[t] <- true   for (t,zc) in ch if lps[t]
lls[t] <- true   for (t,zc) in ch if lbv3[t]
#   `(f[])` は下ろしが `(f[0])` にする（型紙 4）
lls[t] <- true   for (t,zc) in ch if kwin[t] if irng[t] if ilo[t] >= 0 if tch[ilb[t], 0] == 93
      if ilb[t] == ilbc[t] if tmatch[ilbp[t]] == int1[t] if nextw[ilbp[t]] == int2[t]
field llpi : or bound 262144                # 丸括弧が下端ぜんぶを包む（中身を持ち上げる）
llpi[t] <- true  for (t,zc) in ch if kwin[t] if irng[t] if isopn[int1[t]] if not lls[t]
      if tmatch[prevw[int2[t]]] == int1[t]
lcd[nextw[int1[t]]] <- prevw[prevw[int2[t]]]   for (t,zc) in ch if llpi[t] if lok[snum[t]]
lrbc[nextw[int1[t]]] <- true       for (t,zc) in ch if llpi[t] if lok[snum[t]]
field llbr : or bound 262144                # 裸の下端を持ち上げる（参照は丸括弧つき）
llbr[t] <- true  for (t,zc) in ch if kwin[t] if irng[t] if isnum[int1[t]] if nextw[int1[t]] != int2[t]
llbr[t] <- true  for (t,zc) in ch if kwin[t] if irng[t] if tkind[int1[t]] == 1 if not isnum[int1[t]]
      if nextw[int1[t]] == int2[t] if not lbv3[t]
llbr[t] <- true  for (t,zc) in ch if kwin[t] if irng[t] if tkind[int1[t]] == 4 if not isopn[int1[t]]
llbr[t] <- true  for (t,zc) in ch if kwin[t] if irng[t] if isopn[int1[t]] if not lls[t]
      if tmatch[prevw[int2[t]]] != int1[t]
lcd[int1[t]] <- prevw[int2[t]]     for (t,zc) in ch if llbr[t] if lok[snum[t]]
lrbc[int1[t]] <- true              for (t,zc) in ch if llbr[t] if lok[snum[t]]
field lbpr : or bound 262144                # 候補の参照は丸括弧で包む（裸の下端）
lbpr[int1[t]] <- true              for (t,zc) in ch if llbr[t] if lok[snum[t]]
# **入れ子の候補も持ち上げる**（`cons(102, cons(111, 0))` の内側の出現、`f[g[i*2]+1]` の内側の次元）。
# 候補の深さの鎖で、トークン t を含む深さ d の候補の最初のトークン `lcurd[t, d]` を運ぶ（括弧の対応と
# 同じ手 —— 開いた所を深さごとに前へ運ぶ。スタックは要らない）。字は **いちばん内側の持ち上げる区間**
# の塊の行へ移り、区間の参照は **親の塊の中の、自分の最初の字の行**（親が無ければ本文の行）に置く
field lcs0 : or bound 262144                # 候補の最初のトークン
lcs0[t] <- true                    for (t,zc) in ch if lcd[t] >= 0
field lce0 : or bound 262144                # 候補の最後のトークン
lce0[lcd[t]] <- true               for (t,zc) in ch if lcd[t] >= 0
field lnend : count bound 262144            # トークン t で終わる候補の数
lnend[lcd[t]] <- t                 for (t,zc) in ch if lcd[t] >= 0
field ldp : max bound 262144                # トークン t を含む候補の数（深さ）
ldp[0] <- 0
ldp[0] <- 1                        for (z) in 0 .. 0 if lcs0[0]
ldp[t] <- ldp[t-1] + 1 - lnend[t-1]   for (t,zc) in ch if t >= 1 if lcs0[t] if lce0[t-1]
ldp[t] <- ldp[t-1] + 1             for (t,zc) in ch if t >= 1 if lcs0[t] if not lce0[t-1]
ldp[t] <- ldp[t-1] - lnend[t-1]    for (t,zc) in ch if t >= 1 if not lcs0[t] if lce0[t-1]
ldp[t] <- ldp[t-1]                 for (t,zc) in ch if t >= 1 if not lcs0[t] if not lce0[t-1]
# 深さの上限は **前段の括弧の深さ** から出る: 候補はどれも括弧の中に一段ずつ居るが、ガードの辺と値の丸括弧は
# 括弧の手前から始まるので二段まで余計に積める —— 深さ ≤ 括弧の深さ + 2 ≤ 15 + 2。前段の括弧は 16 段で
# 止まる（越えれば前段が置き場の外に書いて終了コード 6）ので、17 段あれば **構造で足りる**。
# （前は 8 で、`cons` を十一重ねた 22_parse の `constructor` の綴りが、黙って崩れた塊になった）
field lcurd : max bound 262144 18           # トークン t を含む深さ d の候補の最初のトークン
lcurd[t, ldp[t]] <- t              for (t,zc) in ch if lcs0[t] if ldp[t] <= 17
lcurd[t, d] <- lcurd[t-1, d]       for (t,zc) in ch for (d) in 1 .. 17 if t >= 1 if d < ldp[t]
lcurd[t, d] <- lcurd[t-1, d]       for (t,zc) in ch for (d) in 1 .. 17 if t >= 1 if d == ldp[t] if not lcs0[t]
field lcpa : max bound 262144               # 候補 R の親（一つ外の候補）
lcpa[t] <- lcurd[t, ldp[t] - 1]    for (t,zc) in ch if lcs0[t] if ldp[t] >= 2
# **塊の場の次元は、区間が使うループだけ**（ループ不変の持ち上げ）。区間の値が依らないループは
# 塊の座標に要らない —— 四重のループの文でも、区間が二つのループの変数しか使わなければ二次元の場で
# 済む（多面体の射影）。使うループが三つ以上の区間は持ち上げない（焼き手が理由 8 で言う）。
# 変数は、自分を含む全部の候補の使うループに数える（入れ子の外側は内側の変数も使う）
field lru : or bound 262144 8               # 候補 ta はループ L の変数を使う
lru[lcurd[u, d], vlpz[u]] <- true  for (u,zc) in ch for (d) in 1 .. 17 if d <= ldp[u] if tkind[u] == 1
      if vbnd[u] >= 0 if not isbind[u] if not tcom[u] if not qi[u] if vlpz[u] <= 7
field lrn0 : min bound 262144               # 使う最初のループ
lrn0[t] <- l                       for (t,zc) in ch for (l) in 0 .. 7 if lru[t, l]
field lrn1 : max bound 262144               # 使う最後のループ
lrn1[t] <- l                       for (t,zc) in ch for (l) in 0 .. 7 if lru[t, l]
field lr3 : or bound 262144                 # 三つ以上のループを使う
lr3[t] <- true                     for (t,zc) in ch for (l) in 0 .. 7 if lru[t, l] if l > lrn0[t] if l < lrn1[t]
# 構成子の引数の区間は **出現の鍵** で持ち上げる（全部の引数が使うループの和。場所 = 出現 × 鍵の反復）
field kau : or bound 262144 8               # 出現 u の引数がループ L の変数を使う
kau[kra[t], l] <- true             for (t,zc) in ch for (l) in 0 .. 7 if krf[t] if lru[t, l]
field ku0 : min bound 262144                # 出現の使う最初のループ
ku0[u] <- l                        for (u,zc) in ch for (l) in 0 .. 7 if kau[u, l]
field ku1 : max bound 262144                # 最後のループ
ku1[u] <- l                        for (u,zc) in ch for (l) in 0 .. 7 if kau[u, l]
field ku3 : or bound 262144                 # 三つ以上
ku3[u] <- true                     for (u,zc) in ch for (l) in 0 .. 7 if kau[u, l] if l > ku0[u] if l < ku1[u]
field kuf : or bound 262144                 # 出現はどれかのループを使う
kuf[u] <- true                     for (u,zc) in ch for (l) in 0 .. 7 if kau[u, l]
field lr3x : or bound 262144                # 候補は持ち上げられない（使うループが三つ以上）
lr3x[t] <- true                    for (t,zc) in ch if lcs0[t] if lr3[t] if not krf[t]
lr3x[t] <- true                    for (t,zc) in ch if krf[t] if ku3[kra[t]]
#   裸の下端で二つのループを使うものは、丸括弧つきの二行の参照を持たない（焼き手が理由 8 で言う）
lr3x[t] <- true                    for (t,zc) in ch if lbpr[t] if lrn1[t] > lrn0[t]
# **書き方の分からないループを使う候補も持ち上げない**（`include` した本の表を回すループ —— 行の数が
# 分からない）。持ち上げると塊の頭と広さの穴が ⊥ のまま字だけが移り、崩れた塊を焼き手に渡していた。
# 持ち上げなければ焼き手が利用者の書いた行で断る
field lkkf : or bound 8192 8                # 文 s のループ L の書き方が分かる
lkkf[s, l] <- true                 for (s) in 0 .. nstz[0] for (l) in 0 .. 7 if lkk[s, l] >= 1
lr3x[t] <- true                    for (t,zc) in ch for (l) in 0 .. 7 if lcs0[t] if lru[t, l] if not lkkf[snum[t], l]
lr3x[t] <- true                    for (t,zc) in ch if lcs0[t] if not lrany[t] if not krf[t]
      if not lkkf[snum[t], 0]
#   構成子の引数は出現の鍵で判断する（引数ごとに違えば、出現が半分だけ下りる）
lr3x[t] <- true                    for (t,zc) in ch for (l) in 0 .. 7 if krf[t] if kau[kra[t], l]
      if not lkkf[snum[t], l]
lr3x[t] <- true                    for (t,zc) in ch if krf[t] if not kuf[kra[t]] if not lkkf[snum[t], 0]
# 持ち上げる候補: 自分が持ち上げられて、親も持ち上げる（外が本文に残るなら内も残す）
field lok2 : or bound 262144
lok2[t] <- true                    for (t,zc) in ch if lcs0[t] if ldp[t] == 1 if not lr3x[t]
lok2[t] <- true                    for (t,zc) in ch if lcs0[t] if ldp[t] >= 2 if not lr3x[t] if lok2[lcpa[t]]
field lse : max bound 262144                # 持ち上げる区間の最初のトークン → 最後のトークン
lse[t] <- lcd[t]                   for (t,zc) in ch if lok2[t]
field lsa : or bound 262144                 # 区間の最初のトークン
lsa[t] <- true                     for (t,zc) in ch if lse[t] >= 0
# トークン t を含む、いちばん内側の持ち上げる区間（持ち上げる候補は親も持ち上げるので、深さの上限を取る）
field lld : max bound 262144
lld[t] <- d                        for (t,zc) in ch for (d) in 1 .. 17 if d <= ldp[t] if lok2[lcurd[t, d]]
field lcur : max bound 262144               # トークン t を含むいちばん内側の区間の最初のトークン
lcur[t] <- lcurd[t, lld[t]]        for (t,zc) in ch if lld[t] >= 1
field lcs : max bound 262144                # 区間 ta の最初の字
lcs[t] <- tstart[t]                for (t,zc) in ch if lsa[t]
field lcl : max bound 262144                # 区間 ta の字の数（内側の区間の字も数える —— 塊に空きの行ができるだけ）
lcl[t] <- lte[lse[t]] - tstart[t] + 1   for (t,zc) in ch if lsa[t]
field lbz : max bound 262144                # 区間 ta の塊の行の数（頭二 + 字 + ループ二 + 宣言 + 予備）
lbz[t] <- lcl[t] + 6               for (t,zc) in ch if lsa[t]
field lbk : max bound 262144                # トークン t より前の塊の行の数（前置きの鎖）
lbk[0] <- 0
lbk[t] <- lbk[t-1] + lbz[t-1]      for (t,zc) in ch if t >= 1 if lbz[t-1] >= 1
lbk[t] <- lbk[t-1]                 for (t,zc) in ch if t >= 1 if not lbz[t-1]
field lhbk : max bound 262144               # 区間 ta の塊の最初の行（末尾の 393216 から）
lhbk[t] <- lbk[t] + 393216          for (t,zc) in ch if lsa[t]
# 字 i の行: ふだんは i（本文）、区間の中ならいちばん内側の区間の塊の行（頭の二行の後ろ）
field lin2 : or bound 262144                # 字 i は区間の中
lin2[i] <- true                    for (i,c) in ch if lcur[tnum[i]] >= 0
field lrw : max bound 262144                # 字 i の行
lrw[i] <- i                        for (i,c) in ch if not lin2[i]
lrw[i] <- lhbk[lcur[tnum[i]]] + 2 + i - lcs[lcur[tnum[i]]]   for (i,c) in ch if lin2[i]
# 文 s のループ L の書き方（1 表 / 2 区間の数 / 3 上端が場 / 4 一点）と穴
field lkk : max bound 8192 8
field lkv : max bound 8192 8                # 束縛のトークン（区間のループ）
field lkl : max bound 8192 8                # 下端（区間）/ L（表）
field lkh : max bound 8192 8                # 上端（数）/ 行数-1（表）/ 上端の場の添字
field lkf : max bound 8192 8                # 上端の場（宣言の番号。1 起点）
field lkb : max bound 8192 8                # 塊の場のその次元の広さ
lkk[snum[u], lz[u]] <- 1           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
lkl[snum[u], lz[u]] <- lz[u]       for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
lkh[snum[u], lz[u]] <- nrw[tix[u]] - 1   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
lkb[snum[u], lz[u]] <- nrw[tix[u]] for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 0 if not ltr[tix[u]]
lkk[snum[u], lz[u]] <- 2           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if ltr[tix[u]]
lkl[snum[u], lz[u]] <- trl[tix[u]] for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if ltr[tix[u]]
lkh[snum[u], lz[u]] <- trh[tix[u]] - 1   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if ltr[tix[u]]
lkb[snum[u], lz[u]] <- trh[tix[u]] for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if ltr[tix[u]]
lkk[snum[u], lz[u]] <- 2           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 1 if isnum[int1[u]]
lkl[snum[u], lz[u]] <- llo2[snum[u], lz[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 1
lkh[snum[u], lz[u]] <- lhi2[snum[u], lz[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 1
lkb[snum[u], lz[u]] <- lhi2[snum[u], lz[u]] + 1   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 1
lkk[snum[u], lz[u]] <- 3           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2 if isnum[int1[u]]
lkl[snum[u], lz[u]] <- llo2[snum[u], lz[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2
lkh[snum[u], lz[u]] <- tval[int4b[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2 if isnum[int4b[u]]
lkh[snum[u], lz[u]] <- 0           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2 if not isnum[int4b[u]]
lkf[snum[u], lz[u]] <- lbf2[snum[u], lz[u]] + 1   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2
lkb[snum[u], lz[u]] <- 4096        for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7
      if lkd[snum[u], lz[u]] == 2
lkv[snum[t], lz[t]] <- nextw[nextw[t]]   for (t,zc) in ch if kwfor[t] if lz[t] >= 0 if lz[t] <= 7
lkk[s, 0] <- 4                     for (s) in 0 .. nstz[0] if lsx[s]
lkb[s, 0] <- 1                     for (s) in 0 .. nstz[0] if lsx[s]
# **依存する区間（上端が `f[外の変数]`・式）を塊に写すときは、書き先の次元の広さで包む区間にする**（14p）。
# 塊の型紙は上端に数か `f[数]` しか書けないので、`for (k) in 1 .. n - 1` の文の値の丸括弧（二項係数を 1000 で
# 割る `(c[n - 1, k - 1] + c[n - 1, k]) % 1000`）は持ち上げられず、焼き手が理由 8 で断っていた。塊は式の値を
# 鍵ごとに置くだけ（純粋）なので、区間を広げても本文が読む鍵は全部入っていて、広げた鍵は誰も読まない。
# 広げる先は **その変数が裸で居る書き先の次元の、宣言した広さ** —— 本文の鍵はそこを越えられない
# （越えれば書き先がはみ出す）。宣言の無い場・変数が書き先に裸で居ない文は、今まで通り持ち上げない
field lfdb : or bound 1024                  # 場 f は広さを宣言した
lfdb[fdno[t]] <- true              for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
# 変数が裸で居る次元は **トークンで見る**（次元の添字がその変数の一語だけ）。前段の c0sr / c1sr は、上端の
# 読めない区間の変数を「区間の計数器」と数えないので使えない
field lhdt : or bound 589824                # 出現のトークン t は書き先
lhdt[t] <- true                    for (t,zc) in ch if isocc[t] if ohd[oseq[t]]
field lhw : max bound 8192 8                # 文 s のループ L の変数が裸で居る書き先の次元の広さ
lhw[snum[t], vlpz[ob1[t]]] <- fwid[fdno2[t]]    for (t,zc) in ch if lhdt[t] if lfdb[fdno2[t]]
      if tkind[ob1[t]] == 1 if vbnd[ob1[t]] >= 0 if d0cm[t] == nextw[ob1[t]]
lhw[snum[t], vlpz[d1t[t]]] <- fwid2[fdno2[t]]   for (t,zc) in ch if lhdt[t] if lfdb[fdno2[t]]
      if tkind[d1t[t]] == 1 if vbnd[d1t[t]] >= 0 if d1cm[t] == nextw[d1t[t]]
lhw[snum[t], vlpz[d2t[t]]] <- fwid3[fdno2[t]]   for (t,zc) in ch if lhdt[t] if lfdb[fdno2[t]]
      if tkind[d2t[t]] == 1 if vbnd[d2t[t]] >= 0 if d2cm[t] == nextw[d2t[t]]
field fdno2 : max bound 589824              # 書き先のトークンの場（0 起点）
fdno2[t] <- ofl[oseq[t]] - 1       for (t,zc) in ch if lhdt[t]
field lkdh : or bound 8192 8                # ループ L の上端は焼き手が読める形（数 / `f[数]`）
lkdh[s, l] <- true                 for (s) in 0 .. nstz[0] for (l) in 0 .. 7 if lkd[s, l] >= 0 if lkd[s, l] <= 2
lkk[snum[u], lz[u]] <- 2           for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if irng[u]
      if isnum[int1[u]] if not lkdh[snum[u], lz[u]] if lhw[snum[u], lz[u]] >= 1
lkl[snum[u], lz[u]] <- llo2[snum[u], lz[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if irng[u]
      if isnum[int1[u]] if not lkdh[snum[u], lz[u]] if lhw[snum[u], lz[u]] >= 1
lkh[snum[u], lz[u]] <- lhw[snum[u], lz[u]] - 1   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if irng[u]
      if isnum[int1[u]] if not lkdh[snum[u], lz[u]] if lhw[snum[u], lz[u]] >= 1
lkb[snum[u], lz[u]] <- lhw[snum[u], lz[u]]   for (u,zc) in ch if kwin[u] if lz[u] >= 0 if lz[u] <= 7 if irng[u]
      if isnum[int1[u]] if not lkdh[snum[u], lz[u]] if lhw[snum[u], lz[u]] >= 1
field lnk : max bound 8192                  # 文 s のループの数（一点も一つ）
lnk[s] <- lnlp[s]                  for (s) in 0 .. nstz[0] if lnlp[s] >= 1
lnk[s] <- 1                        for (s) in 0 .. nstz[0] if lsx[s]

# ── 消すもの ─────────────────────────────────────────────────────────────
field ltd : or bound 262144                 # 消すトークン
# 表のループの for 節（`for` の後ろから表の名まで）
ltd[t] <- true      for (t,zc) in ch if lz[t] >= 0 if lz[t] <= 7
      if t > lft[snum[t], lz[t]] if t <= lit[snum[t], lz[t]]
# 表のループの変数の出現（束縛そのものは for 節と一緒に消える）
field lvt : max bound 262144                # 変数の出現 t のループが回す表
lvt[t] <- ltk[snum[t], vlpz[t]]    for (t,zc) in ch if tkind[t] == 1 if vbnd[t] >= 0
field lvu : or bound 262144
lvu[t] <- true      for (t,zc) in ch if tkind[t] == 1 if not tcom[t] if not isbind[t] if not qi[t] if not lsel[t]
      if not kwin[prevw[t]]
      if vbnd[t] >= 0 if lkd[snum[t], vlpz[t]] == 0 if not ltr[lvt[t]]
#   区間の下端の裸の名前（`for (a, b) in seg for (j) in a .. b` の a。13i）も表の変数である ——
#   `in` の次でも、区間の節なら表の名ではない
lvu[t] <- true      for (t,zc) in ch if tkind[t] == 1 if not tcom[t] if not isbind[t] if not qi[t] if not lsel[t]
      if kwin[prevw[t]] if irng[prevw[t]]
      if vbnd[t] >= 0 if lkd[snum[t], vlpz[t]] == 0 if not ltr[lvt[t]]
ltd[t] <- true      for (t,zc) in ch if lvu[t]
ltd[t] <- true      for (t,zc) in ch if lrn[t] >= 0
field ldl : or bound 262144                 # 消す字
ldl[i] <- true      for (i,c) in ch if istb[snum[tnum[i]]] if c != 10
ldl[i] <- true      for (i,c) in ch if lsp[snum[tnum[i]]] if c != 10 if not lpxs[snum[tnum[i]]]
ldl[i] <- true      for (i,c) in ch if ltd[tnum[i]]
ldl[i] <- true      for (i,c) in ch if qdl[tnum[i]]
# 集合: 宣言の `set`、値の `{` と要素と `}`、鍵が一つの書き先の `]`、`is`
field lsdl : or bound 262144
lsdl[latt[t]] <- true              for (t,zc) in ch if isdcl[t] if lsk[fdno[t]]
lsdl[bndt[t]] <- true              for (t,zc) in ch if isdcl[t] if lsk[fdno[t]] if kwbnd[bndt[t]]
lsdl[bw1[t]] <- true               for (t,zc) in ch if isdcl[t] if lsk[fdno[t]] if kwbnd[bndt[t]]
lsdl[lsvb[s]] <- true              for (s) in 0 .. nstz[0] if lss[s]
lsdl[lsvc[s]] <- true              for (s) in 0 .. nstz[0] if lss[s]
lsdl[t] <- true                    for (t,zc) in ch if lsel[t]
lsdl[t] <- true                    for (t,zc) in ch if lsx1[t] >= 0
lsdl[t] <- true                    for (t,zc) in ch if lisk[t] >= 1
ldl[i] <- true      for (i,c) in ch if lsdl[tnum[i]]
ldl[i] <- true      for (i,c) in ch if lnt[tnum[i]] >= 1
# 構成子: 宣言の文は丸ごと、出現の名・`(`・直下の `,`・`)`（引数が持ち上がったときだけ）
field kdl : or bound 262144
kdl[t] <- true      for (t,zc) in ch if kcs[snum[t]]
field kok : or bound 262144                 # 出現 u は下ろす（最初の引数の区間が持ち上がった）
kok[u] <- true      for (u,zc) in ch if kaf[u] if lsa[kr0[u]]
kdl[u] <- true      for (u,zc) in ch if kok[u]
kdl[x] <- true      for (x,zc) in ch if ksp[x] if kok[ksa[x]]
ldl[i] <- true      for (i,c) in ch if kdl[tnum[i]] if c != 10
# ── 外界（13h）: `source` は宣言、`emit` は出力の場 ─────────────────────────
# 閉じた世界で走らせる（外界からの観測は無い）ので、`source x : max from "ch"` は規則を持たない場
# —— `field x : max` と同じ（33_self も宣言と数えている）。`emit "ch" <- …` は `emit_ch` という
# 集合の場に書くだけで、print にも render にも出ない —— 答え（出力）に影を落とさない。
# **消さずに、誰も読まない場へ書く規則にする**（`_e<t>[0] <- …`、flat の一升）。消すと、値の式や
# ガードの誤り（宣言の無い場の読み …）まで消えて、解釈実行が断る本に答えてしまう。規則として
# 残せば焼き手が読みもガードも検める。誰も読まないので、値が食い違って ⊤ になっても止まらない。
field kwemt : or bound 262144               # `emit`
kwemt[t] <- true    for (t,zc) in ch if tlen[t] == 4 if not tcom[t] if tch[t,0] == 101 if tch[t,1] == 109
      if tch[t,2] == 105 if tch[t,3] == 116
field kwfrm : or bound 262144               # `from`
kwfrm[t] <- true    for (t,zc) in ch if tlen[t] == 4 if not tcom[t] if tch[t,0] == 102 if tch[t,1] == 114
      if tch[t,2] == 111 if tch[t,3] == 109
field lemt : or bound 8192                  # 文 s は emit
lemt[snum[t]] <- true  for (t,zc) in ch if kwemt[t] if sbrk[t]
#   矢印の手前の語（`emit` とチャネルの文字列）を消し、`emit` の最初の字の後ろに頭 `_e<t>[0]` を差す
ldl[i] <- true      for (i,c) in ch if lemt[snum[tnum[i]]] if tnum[i] < arrowt[snum[tnum[i]]]
      if tkind[tnum[i]] != 3
iti[lis[t], 0] <- 159              for (t,zc) in ch if kwemt[t] if sbrk[t]    # `_e<t>[0]`
ih0[lis[t], 0] <- t                for (t,zc) in ch if kwemt[t] if sbrk[t]
ibd[lis[t], 0] <- true             for (t,zc) in ch if kwemt[t] if sbrk[t]
irw[lis[t], 0] <- lrw[tstart[t]]   for (t,zc) in ch if kwemt[t] if sbrk[t]
iti[lin[t], 1] <- 111              for (t,zc) in ch if kwemt[t] if sbrk[t]    # 宣言（末尾）
ih0[lin[t], 1] <- t                for (t,zc) in ch if kwemt[t] if sbrk[t]
field lsrd : or bound 8192                  # 文 s は source の宣言
lsrd[snum[t]] <- true  for (t,zc) in ch if kwsrc[t] if sbrk[t]
field lfrm : min bound 8192                 # その `from` の語
lfrm[snum[t]] <- t     for (t,zc) in ch if kwfrm[t] if lsrd[snum[t]]
ldl[i] <- true      for (i,c) in ch if lsrd[snum[tnum[i]]] if tnum[i] >= lfrm[snum[tnum[i]]] if c != 10
ldl[i] <- true      for (i,c) in ch if kwsrc[tnum[i]] if sbrk[tnum[i]]
iti[lis[t], 0] <- 158              for (t,zc) in ch if kwsrc[t] if sbrk[t]    # `field`
ibd[lis[t], 0] <- true             for (t,zc) in ch if kwsrc[t] if sbrk[t]
irw[lis[t], 0] <- lrw[tstart[t]]   for (t,zc) in ch if kwsrc[t] if sbrk[t]
field lpq : or bound 262144                 # 字を消す丸括弧の `(`: 値の丸括弧で、中身がちょうど一つの塊として持ち上がった
lpq[t] <- true      for (t,zc) in ch if lvp[t] if lse[nextw[t]] == prevw[lpc[t]] if not lfnp[t]
# 関数（14u）: 三つの塊がちょうど持ち上がったときだけ字を替える（どれかが別の候補に呑まれたら、`min(…)` の
# 字面が残って焼き手が理由 8 で言う —— 替えてしまうと、呑んだ塊の中で `for` 節が式の途中に割り込む）
field lfnok : or bound 262144
lfnok[p] <- true     for (p,zc) in ch if lfnq[p] if lse[p] == lpc[p] if lse[nextw[p]] == prevw[lfnc[p]]
      if lse[nextw[lfnc[p]]] == prevw[lpc[p]]
field lfnd : or bound 262144                # 消す語: 名・`(`・`,`・`)`
lfnd[prevw[p]] <- true   for (p,zc) in ch if lfnok[p]
lfnd[p] <- true          for (p,zc) in ch if lfnok[p]
lfnd[lfnc[p]] <- true    for (p,zc) in ch if lfnok[p]
lfnd[lpc[p]] <- true     for (p,zc) in ch if lfnok[p]
ldl[i] <- true      for (i,c) in ch if lfnd[tnum[i]]
#   `,` → ` * _md + `（型紙 200）、`)` → ` * _mc for (_mc) in 0 .. 1 for (_md) in 0 .. 1 if _mc != _md`（201）
iti[lin[lfnc[p]], 0] <- 200               for (p,zc) in ch if lfnok[p]
irw[lin[lfnc[p]], 0] <- lrw[lte[lfnc[p]]] for (p,zc) in ch if lfnok[p]
ibd[lin[lfnc[p]], 0] <- true              for (p,zc) in ch if lfnok[p]
iti[lin[lpc[p]], 0] <- 201                for (p,zc) in ch if lfnok[p]
irw[lin[lpc[p]], 0] <- lrw[lte[lpc[p]]]   for (p,zc) in ch if lfnok[p]
ibd[lin[lpc[p]], 0] <- true               for (p,zc) in ch if lfnok[p]
# **塊の束**（14u）。塊は flat だった —— 値が一度しか決まらない前提である。だが書き先へ単調に流れる値の中の
# 塊（値の丸括弧・関数の引数）の値は、**書き先の束の向きに時間とともに動く**（最短路 `d[v] <- (d[u] + w)`
# の丸括弧は d が下がるたびに下がる）。flat の塊では二つ目の値で ⊤ になるので、焼き手は flat を育つ場から
# 書く規則を非単調と読み、輪を断っていた（定義は答える —— DIFF）。塊の束を **書き先の束**（min / max）に
# すれば、塊は動く値を追い、答えは最後の値になる（鍵ごとに実例は一つ）。向きが合わない読み（`10 - (…)`）は
# 焼き手の極性の解析が層を切る —— 束の選び方は健全さを変えず、受け取れる本の広さだけを変える。
# 関数の塊（`(` から `)`）は関数の束でなければならない（join が関数になる）。
field lvv : or bound 262144                 # `(` は値の系譜（深さ 0 の値の中か、系譜の `(` のすぐ内）
lvv[t] <- true      for (t,zc) in ch if isopn[t] if aftarw[t] if not kpf[t] if not tcom[t]
lvv[t] <- true      for (t,zc) in ch if isopn[t] if tdep[t] >= 1 if not kpf[t] if not tcom[t] if lvv[ibr[t]]
field lbty : max bound 262144               # 塊 ta の束（1 min / 2 max。無ければ flat）
lbty[p] <- lfnk[p]                         for (p,zc) in ch if lfnok[p]
lbty[nextw[t]] <- flatt[hfz[snum[t]]]     for (t,zc) in ch if lpq[t] if lvv[t] if flatt[hfz[snum[t]]] <= 2
lbty[nextw[p]] <- flatt[hfz[snum[p]]]     for (p,zc) in ch if lfnok[p] if lvv[p] if flatt[hfz[snum[p]]] <= 2
lbty[nextw[lfnc[p]]] <- flatt[hfz[snum[p]]]   for (p,zc) in ch if lfnok[p] if lvv[p] if flatt[hfz[snum[p]]] <= 2
ldl[tstart[t]] <- true         for (t,zc) in ch if lpq[t]
ldl[tstart[lpc[t]]] <- true    for (t,zc) in ch if lpq[t]

# ── 差すもの（実例）: 型紙・穴・名前。本文の実例は行（irw）も持つ ──────────────────
field iti : max bound 262272 8              # 実例 [n, e] の型紙
field irw : max bound 262272 8              # 本文の実例の行（源の字の位置）。無ければ末尾
field ih0 : max bound 262272 8
field ih1 : max bound 262272 8
field ih2 : max bound 262272 8
field ih3 : max bound 262272 8
field ind : max bound 262272 8              # 名前の升が引く宣言（1 起点）
field inm : max bound 262272 8              # 綴りの升が引くトークン（束縛の変数名）
field ibd : or bound 262272 8               # 本文の実例（行は ibr）
# 型紙 0: 表のループの `for` の後ろ → ` (_r<L>) in 0 .. <行数-1>`
field lfk0 : max bound 262144               # `for` のトークン t が回す表
lfk0[t] <- ltk[snum[t], lz[t]]     for (t,zc) in ch if kwfor[t] if lz[t] >= 0 if lz[t] <= 7
      if lkd[snum[t], lz[t]] == 0
field lfk : max bound 262144                # そのうち行を持つ表（range でない）
lfk[t] <- lfk0[t]                  for (t,zc) in ch if lfk0[t] >= 0 if not ltr[lfk0[t]]
iti[lin[t], 0] <- 0                for (t,zc) in ch if lfk[t] >= 0
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lfk[t] >= 0
ibd[lin[t], 0] <- true           for (t,zc) in ch if lfk[t] >= 0
ih0[lin[t], 0] <- lz[t]            for (t,zc) in ch if lfk[t] >= 0
ih1[lin[t], 0] <- nrw[lfk[t]] - 1  for (t,zc) in ch if lfk[t] >= 0
#   重なった行を持つ表: 型紙 0 に「一列目が在る」のガードを続けた型紙 199（14t。同じ語の実例は一つの行に
#   重なるので、別の実例にせず一つの型紙にする —— iti は max なので 199 が 0 に勝つ）
iti[lin[t], 0] <- 199              for (t,zc) in ch if lfk[t] >= 0 if ltdk[lfk[t]]
ih2[lin[t], 0] <- lfk[t]           for (t,zc) in ch if lfk[t] >= 0 if ltdk[lfk[t]]
# 型紙 1: 表の変数 → `_t<k>c<j>[_r<L>]`
iti[lin[t], 0] <- 1                for (t,zc) in ch if lvu[t]
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lvu[t]
ibd[lin[t], 0] <- true           for (t,zc) in ch if lvu[t]
ih0[lin[t], 0] <- lvt[t]          for (t,zc) in ch if lvu[t]
ih1[lin[t], 0] <- vcolz[t]         for (t,zc) in ch if lvu[t]
ih2[lin[t], 0] <- vlpz[t]          for (t,zc) in ch if lvu[t]
# 型紙 7: range の表の名 → ` a .. b-1`
iti[lin[t], 0] <- 7                for (t,zc) in ch if lrn[t] >= 0
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lrn[t] >= 0
ibd[lin[t], 0] <- true             for (t,zc) in ch if lrn[t] >= 0
ih0[lin[t], 0] <- trl[lrn[t]]      for (t,zc) in ch if lrn[t] >= 0
ih1[lin[t], 0] <- trh[lrn[t]] - 1  for (t,zc) in ch if lrn[t] >= 0
# 型紙 8: 焼ける種の形でない種（値が式・読み・負の数、座標が式）→ 末尾に ` for (_z) in 0 .. 0`
#   焼ける種は「数の座標 <- 数か true」だけ（SPEC §12）。規則にすれば一点の区間で同じ意味になる。
field lsx : or bound 8192                   # 文 s は種だが、焼ける種の形でない
lsx[snum[t]] <- true               for (t,zc) in ch if isseed[snum[t]] if tkind[t] == 4 if not tcom[t]
      if tch[t,0] != 91 if tch[t,0] != 93 if tch[t,0] != 44 if not arrw[t] if not arrw[t-1] if not qq[t]
lsx[snum[t]] <- true               for (t,zc) in ch if isseed[snum[t]] if isocc[t] if not tcom[t]
      if t > arrowt[snum[t]]
field lsl : max bound 8192                  # 文 s の最後の語か記号
lsl[snum[t]] <- t                  for (t,zc) in ch if tkind[t] != 3 if not tcom[t]
field lsq : or bound 262144                 # 規則にする種の最後のトークン
lsq[t] <- true                     for (t,zc) in ch if lsx[snum[t]] if lsl[snum[t]] == t
iti[lin[t], 0] <- 8                for (t,zc) in ch if lsq[t] if not lin2[lte[t]]
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lsq[t]
ibd[lin[t], 0] <- true             for (t,zc) in ch if lsq[t]
#   **最後の語が持ち上がる区間の中なら**（`third[0] <- c_hd[c_tl[l[0]]]` のアクセサの `]`、値の丸括弧の `)`）、
#   その字は塊へ移るので、一点のループも一緒に塊へ行ってしまい、本文の参照 `_g[_z]` の `_z` が縛られない
#   （焼き手が理由 8）。そのときは **その字の元の行**（本文では空いている）に差す。本文の参照は外側の区間の
#   最初の二字の行に居るので、区間が三字以上なら重ならない（二字以下なら前と同じく塊へ行く —— 焼き手が言う）
field lsqo : max bound 262144               # 最後の語 t を含むいちばん外側の持ち上げる区間の三字目
lsqo[t] <- lcs[lcurd[t, 1]] + 2    for (t,zc) in ch if lsq[t] if lin2[lte[t]]
field lsqm : or bound 262144                # 一点のループを本文の元の行に差す
lsqm[t] <- true                    for (t,zc) in ch if lsqo[t] >= 0 if lte[t] >= lsqo[t]
iti[lin[t], 0] <- 8                for (t,zc) in ch if lsq[t] if lin2[lte[t]] if not lsqm[t]
iti[lin[t], 4] <- 8                for (t,zc) in ch if lsqm[t]
irw[lin[t], 4] <- lte[t]           for (t,zc) in ch if lsqm[t]
ibd[lin[t], 4] <- true             for (t,zc) in ch if lsqm[t]
# 型紙 2 / 3: 広さの無い場 → ` bound …`（束のトークンの後ろ）
field lnb : or bound 262144                 # 宣言 t は広さを書いていない
lnb[t] <- true                     for (t,zc) in ch if isdcl[t] if not kwbnd[bndt[t]]
field lnl : max bound 262144                # その束のトークン
lnl[t] <- latt[t]                  for (t,zc) in ch if lnb[t]
iti[lin[lnl[t]], 0] <- 2           for (t,zc) in ch if lnb[t] if farr[fdno[t]] == 1 if not lsk[fdno[t]]
iti[lin[lnl[t]], 0] <- 3           for (t,zc) in ch if lnb[t] if farr[fdno[t]] == 2 if not lsk[fdno[t]]
iti[lin[lnl[t]], 0] <- 148         for (t,zc) in ch if lnb[t] if farr[fdno[t]] == 3 if not lsk[fdno[t]]
ih2[lin[lnl[t]], 0] <- lb3[fdno[t]] for (t,zc) in ch if lnb[t] if farr[fdno[t]] == 3
ih0[lin[lnl[t]], 0] <- lb1[fdno[t]] for (t,zc) in ch if lnb[t]
ih1[lin[lnl[t]], 0] <- lb2[fdno[t]] for (t,zc) in ch if lnb[t] if farr[fdno[t]] >= 2
irw[lin[lnl[t]], 0] <- lrw[lte[lnl[t]]] for (t,zc) in ch if lnb[t]
ibd[lin[lnl[t]], 0] <- true for (t,zc) in ch if lnb[t]
# ── `budget`（14t）────────────────────────────────────────────────
# `budget depth <= N` は焼き手が数える（lib/fold.lx の bdst —— 焼き手の層は定義の層より浅くならない）ので残す。
# `budget io <= N`: 定義の io は「外界の源を後ろの層で読む emit の層」の数。**source の宣言が無い本は 0** なので、
#   その本では消す（N ≥ 0 はいつも満たす）。source のある本は残す —— 焼き手が知らない文として断る（理由 8）。
# `budget top <= N`: 定義は答えを出したあと、⊤ の升（fourv を除く）が N を越えれば終了コード 4 で終わる。
#   下ろしは flat の場ごとに ⊤ の升を数える規則（`_tpc`、count。⊤ は「少なくとも真」なので `< 0` と `>= 0` が
#   両方立つ）と、越えたら終了コードの升 `_exit` に 4 を置く規則を足す（31_gen が答えを書いたあとその値で終わる）。
#   三次元の flat の場がある本は数え方を持たないので、文を残して断る（理由 8）
field lbgt : or bound 262144                # `budget`
lbgt[t] <- true    for (t,zc) in ch if tlen[t] == 6 if not tcom[t] if tch[t,0] == 98 if tch[t,1] == 117
      if tch[t,2] == 100 if tch[t,3] == 103 if tch[t,4] == 101 if tch[t,5] == 116
field lbsrc : or bound 1                    # 本に source の宣言がある
lbsrc[z] <- true   for (t,zc) in ch for (z) in 0 .. 0 if kwsrc[t] if sbrk[t]
field lbflt : or bound 262144               # 宣言 t は利用者の flat の場（source を除く）
lbflt[t] <- true   for (t,zc) in ch if isdcl[t] if kwflt[latt[t]] if kwfld[prevw[t]]
# ⊤ を数える場は flat と、flat の場のある本の min / max / sum の場（14v —— 定義は fourv のほかは束を問わず数える）
field lbtpf : or bound 262144               # 宣言 t は ⊤ の升を数える利用者の場
lbtpf[t] <- true   for (t,zc) in ch if lbflt[t]
lbtpf[t] <- true   for (t,zc) in ch if isdcl[t] if kwmin[latt[t]] if kwfld[prevw[t]] if lhflt[0]
lbtpf[t] <- true   for (t,zc) in ch if isdcl[t] if kwmax[latt[t]] if kwfld[prevw[t]] if lhflt[0]
lbtpf[t] <- true   for (t,zc) in ch if isdcl[t] if kwsum[latt[t]] if kwfld[prevw[t]] if lhflt[0]
field lb3f : or bound 1                     # 三次元の ⊤ を数える場がある
lb3f[z] <- true    for (t,zc) in ch for (z) in 0 .. 0 if lbtpf[t] if farr[fdno[t]] >= 3
field lbiow : or bound 8192                 # 文 s は消してよい `budget io <= N`
lbiow[snum[t]] <- true for (t,zc) in ch if sbrk[t] if lbgt[t] if tlen[nextw[t]] == 2
      if tch[nextw[t], 0] == 105 if tch[nextw[t], 1] == 111 if not lbsrc[0]
field lbtop : or bound 8192                 # 文 s は下ろす `budget top <= N`
lbtop[snum[t]] <- true for (t,zc) in ch if sbrk[t] if lbgt[t] if tlen[nextw[t]] == 3
      if tch[nextw[t], 0] == 116 if tch[nextw[t], 1] == 111 if tch[nextw[t], 2] == 112 if not lb3f[0]
field lbN : max bound 8192                  # その N
lbN[snum[t]] <- tval[t]   for (t,zc) in ch if isnum[t] if lbtop[snum[t]]
ldl[i] <- true      for (i,c) in ch if lbiow[snum[tnum[i]]] if c != 10
ldl[i] <- true      for (i,c) in ch if lbtop[snum[tnum[i]]] if c != 10
#   型紙 194 / 195: 終了コードの升と ⊤ の数（`budget` の語の実例 —— 末尾へ）
iti[lin[t], 0] <- 194    for (t,zc) in ch if sbrk[t] if lbgt[t] if lbtop[snum[t]]
iti[lin[t], 1] <- 195    for (t,zc) in ch if sbrk[t] if lbgt[t] if lbtop[snum[t]]
ih0[lin[t], 1] <- lbN[snum[t]]   for (t,zc) in ch if sbrk[t] if lbgt[t] if lbtop[snum[t]]
#   型紙 192 / 193 / 196〜198: ⊤ を数える場ごとに ⊤ の升を数える（`field` の語の実例 —— 末尾へ）。場は下ろした広さで回す
field lbq : or bound 1                      # 本に下ろす `budget top` がある
lbq[z] <- true     for (t,zc) in ch for (z) in 0 .. 0 if sbrk[t] if lbgt[t] if lbtop[snum[t]]
iti[lin[prevw[t]], 0] <- 192   for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] <= 1
ih1[lin[prevw[t]], 0] <- lpb1[fdno[t]] - 1   for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] <= 1
ind[lin[prevw[t]], 0] <- fdno[t] + 1          for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] <= 1
iti[lin[prevw[t]], 1] <- 193   for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] <= 1
ind[lin[prevw[t]], 1] <- fdno[t] + 1          for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] <= 1
iti[lin[prevw[t]], 0] <- 196   for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] == 2
ih1[lin[prevw[t]], 0] <- lpb1[fdno[t]] - 1   for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] == 2
ih2[lin[prevw[t]], 0] <- lpb2[fdno[t]] - 1   for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] == 2
iti[lin[prevw[t]], 1] <- 197   for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] == 2
ind[lin[prevw[t]], 1] <- fdno[t] + 1          for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] == 2
iti[lin[prevw[t]], 2] <- 198   for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] == 2
ind[lin[prevw[t]], 2] <- fdno[t] + 1          for (t,zc) in ch if lbtpf[t] if lbq[0] if farr[fdno[t]] == 2
# 型紙 4: `n[]` → `n[0]`
field lob : or bound 262144                 # `[`
lob[t] <- true                     for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 91
field lcb : or bound 262144                 # `]`
lcb[t] <- true                     for (t,zc) in ch if tlen[t] == 1 if not tcom[t] if tch[t,0] == 93
field lemp : or bound 262144                # 中身の無い `[]` の `[`
lemp[t] <- true                    for (t,zc) in ch if lob[t] if lcb[nextw[t]]
# **`f[]` を `f[0]` と読んでよいのは、その場を添字つきで使っていないときだけ**。解釈実行は `f[]` の鍵を
# 空の組とし、`f[0]` とは別の升である（`lo[0] <- 4` の後の `lo[]` は ⊥）。両方で使う場を `f[0]` に
# 寄せると、定義が ⊥ と言う升に 4 を答えていた（13i の試験で出た。前からある穴）。寄せずに残せば、
# 焼き手が利用者の行で断る（理由 8）
field lfm1 : or bound 2048                  # 場は添字つきで使われる
lfm1[ixcf[t]] <- true              for (t,zc) in ch if isocc[t] if obr[t] >= 0 if not lemp[obr[t]]
iti[lin[t], 0] <- 4                for (t,zc) in ch if lemp[t] if not lsxf[t] if not lfm1[ixcf[prevw[t]]]
irw[lin[t], 0] <- lrw[lte[t]]           for (t,zc) in ch if lemp[t]
ibd[lin[t], 0] <- true           for (t,zc) in ch if lemp[t]
# **表の行は集合である**（14t）: 定義は同じ行を二度書いても一度と数える（規則の実例は変数の束縛で決まり、
# 同じ行は同じ束縛になる）。下ろした本は行の番号で回すので、`sum` / `count` が重なった行を二度数えて **黙って
# 違っていた**（自由に書いた本を撒いて三本出た。04 からの穴）。重なった行（前の行と全部の列が同じ）の升は
# 種にしない（⊥ の升を読む実例は撃たない）。列を読まない規則もあるので、重なった行を持つ表を回すループには
# 「一列目が在る」のガードを足す（型紙 199）。比べるのは行 4,095 まで —— 越える表は ltcv の広さを越えて
# 下ろしが止まる（終了コード 6。黙らない）
field ltsg : max bound 262144               # 升の値（符号つき。負の数の値は大きさを持つ）
ltsg[t] <- ltv[t]                  for (t,zc) in ch if ltc[t] if not pminus[t]
ltsg[t] <- 0 - ltv[t]              for (t,zc) in ch if ltc[t] if pminus[t]
field ltcv : max bound 16 4096 16           # 表 k の行 r（1 起点）の列 c の値
ltcv[tbk[snum[t]], rowc[t], colc[t]] <- ltsg[t]   for (t,zc) in ch if ltc[t]
field ltar : max bound 16                   # 表 k の列の数
ltar[tbk[snum[t]]] <- colc[t] + 1  for (t,zc) in ch if ltc[t]
field ltdp : or bound 16 4096               # 表 k の行 r は、前のどれかの行と全部の列が同じ
#   比べ方: 行ごとに二本の鍵（列の値を法 2147483647 と 2147483629 で畳み、列ごとの掛ける数で重みを付けて足す）を作り、
#   鍵が二本とも同じ前の行（いちばん前のもの）とだけ列を全部比べる。鍵が同じで列が違う（鍵のぶつかり）なら
#   重なりとは言わない —— 二本の 31 ビットの法がぶつかる割合は 2^-62 で、そのとき重なった三つ目の行を見落とす。
#   行を総当たりで比べる形（列の数ごとの十六の規則）は焼き手の広さを越え、列の鎖で畳む形（`% M` の自己再帰）は
#   成層できなかった。鍵は sum の場で足す（和が 0 になって ⊥ に落ちないよう、行ごとに 1 を足しておく）
field ltp1 : max bound 16                   # 列 c の掛ける数（一本目。1000003 の c 乗 mod 2147483647）
ltp1[0] <- 1
ltp1[1] <- 1000003
ltp1[2] <- 1426104154
ltp1[3] <- 1049561761
ltp1[4] <- 1604566856
ltp1[5] <- 1953433226
ltp1[6] <- 2061642598
ltp1[7] <- 57298384
ltp1[8] <- 1544709545
ltp1[9] <- 1274554124
ltp1[10] <- 633364108
ltp1[11] <- 66148026
ltp1[12] <- 1433149184
ltp1[13] <- 206851044
ltp1[14] <- 1744706798
ltp1[15] <- 1828017126
field ltp2 : max bound 16                   # 二本目（1000033 の c 乗 mod 2147483629）
ltp2[0] <- 1
ltp2[1] <- 1000033
ltp2[2] <- 1486113604
ltp2[3] <- 895266740
ltp2[4] <- 1768937804
ltp2[5] <- 97107895
ltp2[6] <- 1889857155
ltp2[7] <- 782781117
ltp2[8] <- 1921366523
ltp2[9] <- 1163301944
ltp2[10] <- 1206495014
ltp2[11] <- 1216152618
ltp2[12] <- 1904973937
ltp2[13] <- 1926370392
ltp2[14] <- 1560574051
ltp2[15] <- 1952109545
field ltk1 : sum bound 16 4096              # 行の鍵（一本目）
field ltk2 : sum bound 16 4096              # 二本目
ltk1[k, r] <- 1    for (k) in 0 .. 15 for (r) in 1 .. nrw[k]
ltk2[k, r] <- 1    for (k) in 0 .. 15 for (r) in 1 .. nrw[k]
ltk1[k, r] <- ltcv[k, r, c] % 2147483647 * ltp1[c] % 2147483647   for (k) in 0 .. 15 for (r) in 1 .. nrw[k] for (c) in 0 .. 15
      if c < ltar[k]
ltk2[k, r] <- ltcv[k, r, c] % 2147483629 * ltp2[c] % 2147483629   for (k) in 0 .. 15 for (r) in 1 .. nrw[k] for (c) in 0 .. 15
      if c < ltar[k]
field ltcd : min bound 16 4096              # 鍵が二本とも同じ、いちばん前の行
ltcd[k, r] <- r2   for (k) in 0 .. 15 for (r) in 2 .. nrw[k] for (r2) in 1 .. nrw[k] if r2 < r
      if ltk1[k, r2] == ltk1[k, r] if ltk2[k, r2] == ltk2[k, r]
field ltne : or bound 16 4096               # その行と、どこかの列が違う（鍵のぶつかり）
ltne[k, r] <- true   for (k) in 0 .. 15 for (r) in 2 .. nrw[k] for (c) in 0 .. 15 if c < ltar[k]
      if ltcd[k, r] >= 1 if ltcv[k, ltcd[k, r], c] != ltcv[k, r, c]
ltdp[k, r] <- true   for (k) in 0 .. 15 for (r) in 2 .. nrw[k] if ltcd[k, r] >= 1 if not ltne[k, r]
field ltdc : or bound 262144                # 升 t の行は重なった行
ltdc[t] <- true                    for (t,zc) in ch if ltc[t] if ltdp[tbk[snum[t]], rowc[t]]
field ltdk : or bound 16                    # 表 k は重なった行を持つ
ltdk[k] <- true                    for (k) in 0 .. 15 for (r) in 1 .. nrw[k] if ltdp[k, r]
# 型紙 5: 表の升 → 種 `_t<k>c<j>[<行>] <- <値>`（末尾。原子は綴りの順の番号）
iti[lin[t], 0] <- 5                for (t,zc) in ch if ltc[t] if not ltdc[t]
ih0[lin[t], 0] <- tbk[snum[t]]     for (t,zc) in ch if ltc[t]
ih1[lin[t], 0] <- colc[t]          for (t,zc) in ch if ltc[t]
ih2[lin[t], 0] <- rowc[t] - 1      for (t,zc) in ch if ltc[t]
ih3[lin[t], 0] <- ltv[t]           for (t,zc) in ch if ltc[t]
# **負の数の升**（`(1,-3)`）。字句では `-` と `3` の二語で、値は `3` の語が持つ —— 前は符号が
# 表の文ごと消え、`_t0c1[1] <- 3` と **黙って** 正の数になっていた（自由に書いた本で見つけた。SILENT）。
# 桁の穴は負を書けない（`% 10` は床の余り）ので、大きさを穴に置き、型紙 185 が `-` を前に付ける
# （iti は max —— 185 が 5 に勝つ）。
iti[lin[t], 0] <- 185              for (t,zc) in ch if ltc[t] if isfr[t] if pminus[t] if not ltdc[t]
# 型紙 6: 表の列 → `field _t<k>c<j> : flat bound <行数>`（一行目の升の手前の `(` か `,` が持つ）
field lfc : max bound 262144                # 一行目の升 t の手前の記号
lfc[t] <- prevw[t]                 for (t,zc) in ch if ltc[t] if rowc[t] == 1
iti[lin[lfc[t]], 0] <- 6           for (t,zc) in ch if ltc[t] if rowc[t] == 1
ih0[lin[lfc[t]], 0] <- tbk[snum[t]] for (t,zc) in ch if ltc[t] if rowc[t] == 1
ih1[lin[lfc[t]], 0] <- colc[t]     for (t,zc) in ch if ltc[t] if rowc[t] == 1
ih2[lin[lfc[t]], 0] <- nrw[tbk[snum[t]]] for (t,zc) in ch if ltc[t] if rowc[t] == 1
# 型紙 10〜24: print（名のトークン t が、手前の `print` の最初の字に並べる）
#   一次元: 10 宣言 / 11 行の番号 / 12 値を集める / 13 頭と終わり / 14 行と print の上限 / 15 or
iti[lpd[t], 0] <- 10               for (t,zc) in ch if lp1[t]
ih0[lpd[t], 0] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih1[lpd[t], 0] <- lpb1[lpf[t]]      for (t,zc) in ch if lp1[t]
iti[lpd[t], 1] <- 11               for (t,zc) in ch if lp1[t]
ih0[lpd[t], 1] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih1[lpd[t], 1] <- lpb[t] + 1       for (t,zc) in ch if lp1[t]
ih2[lpd[t], 1] <- lpb1[lpf[t]] - 1  for (t,zc) in ch if lp1[t]
iti[lpd[t], 2] <- 12               for (t,zc) in ch if lp1[t] if not lpfl[t] if not lp4[t]
#   flat の一次元（13e）: 値の写しは print のトークンの三文字目へ移して ⊤ の行を避ける後ろ（150）を
#   付け、⊤ の行（151 + 152）を続ける —— 型紙は升 63 までなので分けて並べる
iti[lpd2[t], 3] <- 12              for (t,zc) in ch if lp1[t] if lpfl[t]
ih0[lpd2[t], 3] <- lpp[t]          for (t,zc) in ch if lp1[t] if lpfl[t]
ih2[lpd2[t], 3] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp1[t] if lpfl[t]
ind[lpd2[t], 3] <- lpf[t] + 1      for (t,zc) in ch if lp1[t] if lpfl[t]
iti[lpd2[t], 4] <- 150             for (t,zc) in ch if lp1[t] if lpfl[t]
ih0[lpd2[t], 4] <- lpp[t]          for (t,zc) in ch if lp1[t] if lpfl[t]
iti[lpd2[t], 5] <- 151             for (t,zc) in ch if lp1[t] if lpfl[t]
ih0[lpd2[t], 5] <- lpp[t]          for (t,zc) in ch if lp1[t] if lpfl[t]
ih2[lpd2[t], 5] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp1[t] if lpfl[t]
iti[lpd2[t], 6] <- 152             for (t,zc) in ch if lp1[t] if lpfl[t]
ind[lpd2[t], 6] <- lpf[t] + 1      for (t,zc) in ch if lp1[t] if lpfl[t]
ih0[lpd[t], 2] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih2[lpd[t], 2] <- lpb1[lpf[t]] - 1  for (t,zc) in ch if lp1[t]
ind[lpd[t], 2] <- lpf[t] + 1       for (t,zc) in ch if lp1[t]
iti[lpd[t], 3] <- 13               for (t,zc) in ch if lp1[t]
ih0[lpd[t], 3] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih1[lpd[t], 3] <- lpb[t]           for (t,zc) in ch if lp1[t]
ih2[lpd[t], 3] <- lpe[t]           for (t,zc) in ch if lp1[t]
iti[lpd[t], 4] <- 14               for (t,zc) in ch if lp1[t]
ih0[lpd[t], 4] <- lpp[t]           for (t,zc) in ch if lp1[t]
ih2[lpd[t], 4] <- lpe[t]           for (t,zc) in ch if lp1[t]
iti[lpd[t], 5] <- 15               for (t,zc) in ch if lp1[t] if lpor[t]
ih0[lpd[t], 5] <- lpp[t]           for (t,zc) in ch if lp1[t] if lpor[t]
iti[lpd[t], 6] <- 25               for (t,zc) in ch if lp1[t] if lf0[lpf[t]]
ih0[lpd[t], 6] <- lpp[t]           for (t,zc) in ch if lp1[t] if lf0[lpf[t]]
#   二次元: 16 宣言 / 17 行の番号 + 18 輪 / 19 値 + 18 / 20 座標0 + 18 + 22 / 21 座標1 + 18 + 22 /
#           13 / 14 / 23 二次元の印 / 15 or
field lpd1 : max bound 262144               # print のトークンの二文字目の実例の番号
lpd1[t] <- lpd[t] + 1              for (t,zc) in ch if lpo[t]
iti[lpd[t], 0] <- 16               for (t,zc) in ch if lp2[t]
ih0[lpd[t], 0] <- lpp[t]           for (t,zc) in ch if lp2[t]
ih1[lpd[t], 0] <- lpb1[lpf[t]]      for (t,zc) in ch if lp2[t]
ih2[lpd[t], 0] <- lpb2[lpf[t]]      for (t,zc) in ch if lp2[t]
iti[lpd[t], 1] <- 17               for (t,zc) in ch if lp2[t]
ih0[lpd[t], 1] <- lpp[t]           for (t,zc) in ch if lp2[t]
ih1[lpd[t], 1] <- lpb2[lpf[t]]      for (t,zc) in ch if lp2[t]
ih2[lpd[t], 1] <- lpb[t] + 1       for (t,zc) in ch if lp2[t]
iti[lpd[t], 3] <- 19               for (t,zc) in ch if lp2[t] if not lpfl[t] if not lp4[t]
ih0[lpd[t], 3] <- lpp[t]           for (t,zc) in ch if lp2[t]
ind[lpd[t], 3] <- lpf[t] + 1       for (t,zc) in ch if lp2[t]
iti[lpd[t], 5] <- 20               for (t,zc) in ch if lp2[t]
ih0[lpd[t], 5] <- lpp[t]           for (t,zc) in ch if lp2[t]
iti[lpd[t], 7] <- 22               for (t,zc) in ch if lp2[t]
ind[lpd[t], 7] <- lpf[t] + 1       for (t,zc) in ch if lp2[t]
iti[lpd1[t], 0] <- 21              for (t,zc) in ch if lp2[t]
ih0[lpd1[t], 0] <- lpp[t]          for (t,zc) in ch if lp2[t]
iti[lpd1[t], 2] <- 22              for (t,zc) in ch if lp2[t]
ind[lpd1[t], 2] <- lpf[t] + 1      for (t,zc) in ch if lp2[t]
iti[lpd1[t], 3] <- 13              for (t,zc) in ch if lp2[t]
ih0[lpd1[t], 3] <- lpp[t]          for (t,zc) in ch if lp2[t]
ih1[lpd1[t], 3] <- lpb[t]          for (t,zc) in ch if lp2[t]
ih2[lpd1[t], 3] <- lpe[t]          for (t,zc) in ch if lp2[t]
iti[lpd1[t], 4] <- 14              for (t,zc) in ch if lp2[t]
ih0[lpd1[t], 4] <- lpp[t]          for (t,zc) in ch if lp2[t]
ih2[lpd1[t], 4] <- lpe[t]          for (t,zc) in ch if lp2[t]
iti[lpd1[t], 5] <- 23              for (t,zc) in ch if lp2[t]
ih0[lpd1[t], 5] <- lpp[t]          for (t,zc) in ch if lp2[t]
iti[lpd1[t], 6] <- 15              for (t,zc) in ch if lp2[t] if lpor[t]
ih0[lpd1[t], 6] <- lpp[t]          for (t,zc) in ch if lp2[t] if lpor[t]
#   輪（18）は 2 / 4 / 6 と二文字目の 1 に置く（値・座標の規則の続きの行）
iti[lpd[t], 2] <- 18               for (t,zc) in ch if lp2[t]
iti[lpd[t], 4] <- 18               for (t,zc) in ch if lp2[t] if not lpfl[t] if not lp4[t]
#   flat の二次元（13e）: 値の写し（19 + 18）を三文字目へ移して ⊤ の行を避ける後ろ（153）を付け、
#   ⊤ の行（154 + 18 + 155 + 156）を四文字目に（四文字目は集合の print も使うが、集合は flat でない）
iti[lpd2[t], 3] <- 19              for (t,zc) in ch if lp2[t] if lpfl[t]
ih0[lpd2[t], 3] <- lpp[t]          for (t,zc) in ch if lp2[t] if lpfl[t]
ind[lpd2[t], 3] <- lpf[t] + 1      for (t,zc) in ch if lp2[t] if lpfl[t]
iti[lpd2[t], 4] <- 18              for (t,zc) in ch if lp2[t] if lpfl[t]
ih1[lpd2[t], 4] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lpfl[t]
ih2[lpd2[t], 4] <- lpb2[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lpfl[t]
iti[lpd2[t], 5] <- 153             for (t,zc) in ch if lp2[t] if lpfl[t]
ih0[lpd2[t], 5] <- lpp[t]          for (t,zc) in ch if lp2[t] if lpfl[t]
iti[lpd3[t], 0] <- 154             for (t,zc) in ch if lp2[t] if lpfl[t]
ih0[lpd3[t], 0] <- lpp[t]          for (t,zc) in ch if lp2[t] if lpfl[t]
iti[lpd3[t], 1] <- 18              for (t,zc) in ch if lp2[t] if lpfl[t]
ih1[lpd3[t], 1] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lpfl[t]
ih2[lpd3[t], 1] <- lpb2[lpf[t]] - 1 for (t,zc) in ch if lp2[t] if lpfl[t]
iti[lpd3[t], 2] <- 155             for (t,zc) in ch if lp2[t] if lpfl[t]
ind[lpd3[t], 2] <- lpf[t] + 1      for (t,zc) in ch if lp2[t] if lpfl[t]
iti[lpd3[t], 3] <- 156             for (t,zc) in ch if lp2[t] if lpfl[t]
ind[lpd3[t], 3] <- lpf[t] + 1      for (t,zc) in ch if lp2[t] if lpfl[t]
iti[lpd[t], 6] <- 18               for (t,zc) in ch if lp2[t]
iti[lpd1[t], 1] <- 18              for (t,zc) in ch if lp2[t]
ih1[lpd[t], 2] <- lpb1[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih2[lpd[t], 2] <- lpb2[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih1[lpd[t], 4] <- lpb1[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih2[lpd[t], 4] <- lpb2[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih1[lpd[t], 6] <- lpb1[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih2[lpd[t], 6] <- lpb2[lpf[t]] - 1  for (t,zc) in ch if lp2[t]
ih1[lpd1[t], 1] <- lpb1[lpf[t]] - 1 for (t,zc) in ch if lp2[t]
ih2[lpd1[t], 1] <- lpb2[lpf[t]] - 1 for (t,zc) in ch if lp2[t]
#   名前の字（24）: 名のトークンの字 i ごとに `_pnm[<p>, <k>] <- <字>`
iti[i + 127, 0] <- 24              for (i,c) in ch if lpo[tnum[i]] if cpos[i] <= 31
ih0[i + 127, 0] <- lpp[tnum[i]]    for (i,c) in ch if lpo[tnum[i]] if cpos[i] <= 31
ih1[i + 127, 0] <- cpos[i]         for (i,c) in ch if lpo[tnum[i]] if cpos[i] <= 31
ih2[i + 127, 0] <- c               for (i,c) in ch if lpo[tnum[i]] if cpos[i] <= 31
#   原子（26 座標0 / 27 座標1 / 28 値）: print のトークンの三文字目に並べる
