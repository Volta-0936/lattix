pa[s, pb + t] <- vc[s - 1, MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]]   for (s) in 1 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 0 if lat == 9
pa[s, pb + t] <- vb[s - 1, MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]]   for (s) in 1 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 0 if lat == 10
pa[s, pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]) % mo   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 1
pa[s, pb + t] <- mu * pa[s, p1 + t] + pa[s, p2 + t]   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 2
pa[s, pb + t] <- pa[s, p1 + t] % mo   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 3
pa[s, pb + t] <- pa[s, p1 + t] / mo   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 4
pa[s, pb + t] <- AE1[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]]   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 5
pa[s, pb + t] <- AE2[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]]   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 6
pa[s, pb + t] <- mu * pa[s, p1 + t] + mo * pa[s, p2 + t]   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 7
pa[s, pb + t] <- pa[s, p1 + t] / pa[s, p2 + t]   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 8
pa[s, pb + t] <- pa[s, p1 + t] % pa[s, p2 + t]   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 9
pa[s, pb + t] <- pa[s, p1 + t] * pa[s, p2 + t]   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 10
pa[s, pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]) / mo   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 11
# ── 多面体の寄与。辺一本が空間ひとつを覆う。──────────────
fq[s, e] <- true   for (s) in 0 .. 47 for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == s
fq[s, e] <- true   for (s) in 0 .. 47 for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == s
fn[s, e, t] <- true   for (s) in 0 .. 47 for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == s
fn[s, e, t] <- true   for (s) in 0 .. 47 for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == s if kk == 1 if lat == 0 if op == 1 if (MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa[s, MB[cm] + MU[cm] * t] + MI2[cm] * pa[s, MB2[cm] + MU2[cm] * t]) == (MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa[s, MB[wm] + MU[wm] * t] + MI2[wm] * pa[s, MB2[wm] + MU2[wm] * t])
fn[s, e, t] <- true   for (s) in 0 .. 47 for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == s if kk == 1 if lat == 0 if op == 2 if (MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa[s, MB[cm] + MU[cm] * t] + MI2[cm] * pa[s, MB2[cm] + MU2[cm] * t]) != (MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa[s, MB[wm] + MU[wm] * t] + MI2[wm] * pa[s, MB2[wm] + MU2[wm] * t])
