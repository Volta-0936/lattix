nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 11 if lat == 2 if op == 5 if n == 0 if vx2[rz2[c]] > w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 11 if lat == 5 if op == 1 if n == 0 if vf2[rz2[c]] == w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 11 if lat == 5 if op == 2 if n == 0 if vf2[rz2[c]] != w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 11 if lat == 5 if op == 2 if n == 1 if vf2[rz2[c]] != vf2[rz2[r1]] + w
