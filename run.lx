# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz10[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz10[q] <- im * vf10[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz10[q] <- im * vn9[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz10[q] <- im * vx9[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz10[q] <- im * vf9[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 9 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn10[rz10[q]] <- vn9[rz10[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx10[rz10[q]] <- vx9[rz10[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo10[rz10[q]] <- vo9[rz10[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va10[rz10[q]] <- va9[rz10[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf10[rz10[q]] <- vf9[rz10[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v410[rz10[q]] <- v49[rz10[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs10[rz10[q]] <- vs9[rz10[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 10）。閉じた面 9 からしか読まない。
ct10[rz10[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 0
ct10[rz10[t]] <- vn9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 1
ct10[rz10[t]] <- vx9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 2
ct10[rz10[t]] <- vo9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 3
ct10[rz10[t]] <- va9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 4
ct10[rz10[t]] <- vf9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 5
ct10[rz10[t]] <- v49[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 6
ct10[rz10[t]] <- vs9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 7
ct10[rz10[t]] <- vm9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 8
ct10[rz10[t]] <- vc9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 9
ct10[rz10[t]] <- vb9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 4 if la == 10
ct10[rz10[t]] <- ct10[rz10[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 1 if n == 1
ct10[rz10[t]] <- ct10[rz10[a]] + ct10[rz10[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 1 if n == 2
ct10[rz10[t]] <- ct10[rz10[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 6 if n == 1
ct10[rz10[t]] <- ct10[rz10[a]] * ct10[rz10[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 6 if n == 2
ct10[rz10[t]] <- ct10[rz10[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 7 if n == 1
ct10[rz10[t]] <- ct10[rz10[a]] / ct10[rz10[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 7 if n == 2
ct10[rz10[t]] <- ct10[rz10[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 8 if n == 1
ct10[rz10[t]] <- ct10[rz10[a]] % ct10[rz10[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -11 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc10[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 10
ng10[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 10
ng10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 0 if op == 1 if n == 1 if ct10[rz10[c]] == ct10[rz10[r1]] + w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 1 if op == 1 if n == 0 if vn9[rz10[c]] == w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 1 if op == 1 if n == 1 if vn9[rz10[c]] == vn9[rz10[r1]] + w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 1 if op == 1 if n == 2 if vn9[rz10[c]] == vn9[rz10[r1]] + vn9[rz10[r2]] + w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 1 if op == 3 if n == 0 if vn9[rz10[c]] >= w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 1 if op == 4 if n == 0 if vn9[rz10[c]] <= w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 1 if op == 5 if n == 0 if vn9[rz10[c]] > w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 2 if op == 1 if n == 0 if vx9[rz10[c]] == w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 2 if op == 1 if n == 1 if vx9[rz10[c]] == vx9[rz10[r1]] + w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 2 if op == 2 if n == 0 if vx9[rz10[c]] != w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 2 if op == 3 if n == 0 if vx9[rz10[c]] >= w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 2 if op == 4 if n == 0 if vx9[rz10[c]] <= w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 2 if op == 5 if n == 0 if vx9[rz10[c]] > w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 2 if op == 6 if n == 1 if vx9[rz10[c]] < vx9[rz10[r1]] + w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 5 if op == 1 if n == 0 if vf9[rz10[c]] == w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 5 if op == 2 if n == 0 if vf9[rz10[c]] != w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 5 if op == 3 if n == 0 if vf9[rz10[c]] >= w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 9 if op == 1 if n == 0 if vc9[rz10[c]] == w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 1 if lat == 9 if op == 3 if n == 0 if vc9[rz10[c]] >= w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 2 if lat == 3 if not vo9[rz10[c]]
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 3 if lat == 3 if vo10[rz10[c]]
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 3 if lat == 5 if vf10[rz10[c]]
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 4 if lat == 1 if vn10[rz10[c]] is w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 4 if lat == 5 if vf10[rz10[c]] is w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 4 if lat == 8 if vm10[rz10[c]] is w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 5 if lat == 6 if not v410[rz10[c]]
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 11 if lat == 2 if op == 3 if n == 0 if vx10[rz10[c]] >= w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 11 if lat == 2 if op == 5 if n == 0 if vx10[rz10[c]] > w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 11 if lat == 5 if op == 1 if n == 0 if vf10[rz10[c]] == w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 11 if lat == 5 if op == 2 if n == 0 if vf10[rz10[c]] != w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 11 if lat == 5 if op == 2 if n == 1 if vf10[rz10[c]] != vf10[rz10[r1]] + w
nc10[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 10 if k == 11 if lat == 5 if op == 5 if n == 0 if vf10[rz10[c]] > w
ok10[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 10 if nc10[e] >= ng10[e]
ok10[e] <- ok9[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 10
# 値で決まる座標を番地の面へ写す（層 10）
pa10[pb + t] <- vx9[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa10[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 10 if kd == 0 if lat == 2
pa10[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa10[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 10 if kd == 1
pa10[pb + t] <- mu * pa10[p1 + t] + pa10[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 10 if kd == 2
# ── 多面体の寄与（層 10）。辺一本が空間ひとつを覆う。────────
fq10[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 10
fq10[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 10
fn10[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10
fn10[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 10 if kk == 2 if lat == 3 if not vo9[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa10[MB[cm] + MU[cm] * t]]
fn10[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 10 if kk == 3 if lat == 3 if vo10[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa10[MB[cm] + MU[cm] * t]]
fn10[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 10 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn10[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 10 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx10[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa10[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo10[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if fn10[e,t] >= fq10[e]
fo10[e,t] <- fo9[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 10
vn10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- vn9[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 10
vx10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- vx9[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 10
vo10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- vo9[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 10
vf10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- vf9[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 10
v410[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- v49[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 10
vn10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa10[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if lat == 1 if vf == 0 if fo10[e,t]
vx10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa10[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if lat == 2 if vf == 0 if fo10[e,t]
vx10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- vx10[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa10[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa10[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if lat == 2 if vf == 1 if fo10[e,t] if n == 1
vx10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- vx10[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa10[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if lat == 2 if vf == 4 if fo10[e,t]
vo10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if lat == 3 if vf == 2 if fo10[e,t]
vf10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa10[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if lat == 5 if vf == 0 if fo10[e,t]
vf10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- vf10[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa10[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if lat == 5 if vf == 4 if fo10[e,t]
v410[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if lat == 6 if vf == 2 if fo10[e,t]
v410[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 10 if lat == 6 if vf == 5 if fo10[e,t]
vm10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa10[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa10[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 10 if lat == 8 if vf == 0 if fo10[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn10[rz10[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 1 if vf == 0
vn10[rz10[t]] <- vn10[rz10[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn10[rz10[t]] <- vn10[rz10[a]] + vn10[rz10[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn10[rz10[t]] <- vn10[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 1 if vf == 4 if la == 1
vx10[rz10[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 0
vx10[rz10[t]] <- vx10[rz10[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx10[rz10[t]] <- vx10[rz10[a]] + vx10[rz10[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx10[rz10[t]] <- vn9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 4 if la == 1
vx10[rz10[t]] <- vx10[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 4 if la == 2
vx10[rz10[t]] <- vf9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 4 if la == 5
vx10[rz10[t]] <- vx9[rz10[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx10[rz10[t]] <- vx10[rz10[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx10[rz10[t]] <- vx10[rz10[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx10[rz10[t]] <- vx9[rz10[a]] / vx9[rz10[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx10[rz10[t]] <- vx9[rz10[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx10[rz10[t]] <- vx9[rz10[a]] % vx9[rz10[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo10[rz10[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 3 if vf == 2
vo10[rz10[t]] <- vo10[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 3 if vf == 4 if la == 3
vf10[rz10[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 0
vf10[rz10[t]] <- vx9[rz10[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf10[rz10[t]] <- vf10[rz10[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf10[rz10[t]] <- vf10[rz10[a]] + vf10[rz10[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf10[rz10[t]] <- vx9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 4 if la == -2
vf10[rz10[t]] <- vx9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 4 if la == 2
vf10[rz10[t]] <- vf10[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 4 if la == 5
vf10[rz10[t]] <- vn9[rz10[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf10[rz10[t]] <- vx9[rz10[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf10[rz10[t]] <- vf10[rz10[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf10[rz10[t]] <- vx9[rz10[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf10[rz10[t]] <- vf10[rz10[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v410[rz10[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 6 if vf == 2
vs10[rz10[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 7 if vf == 3
vs10[rz10[t]] <- {vf10[rz10[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 10 if ok10[e] if lat == 7 if vf == 9 if la == 5
vm10[rz10[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 10 if ok10[e] if lat == 8 if vf == 0
vm10[rz10[t]] <- vf9[rz10[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 10 if ok10[e] if lat == 8 if vf == 4 if la == 5
vc10[rz10[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 10 if ok10[e] if lat == 9 if vf == 0

# ══ 層 11 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz11[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz11[q] <- im * vf11[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz11[q] <- im * vn10[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz11[q] <- im * vx10[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz11[q] <- im * vf10[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 10 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn11[rz11[q]] <- vn10[rz11[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx11[rz11[q]] <- vx10[rz11[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo11[rz11[q]] <- vo10[rz11[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va11[rz11[q]] <- va10[rz11[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf11[rz11[q]] <- vf10[rz11[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v411[rz11[q]] <- v410[rz11[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs11[rz11[q]] <- vs10[rz11[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 11）。閉じた面 10 からしか読まない。
ct11[rz11[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 0
ct11[rz11[t]] <- vn10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 1
ct11[rz11[t]] <- vx10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 2
ct11[rz11[t]] <- vo10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 3
ct11[rz11[t]] <- va10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 4
ct11[rz11[t]] <- vf10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 5
ct11[rz11[t]] <- v410[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 6
ct11[rz11[t]] <- vs10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 7
ct11[rz11[t]] <- vm10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 8
ct11[rz11[t]] <- vc10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 9
ct11[rz11[t]] <- vb10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 4 if la == 10
ct11[rz11[t]] <- ct11[rz11[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 1 if n == 1
ct11[rz11[t]] <- ct11[rz11[a]] + ct11[rz11[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 1 if n == 2
ct11[rz11[t]] <- ct11[rz11[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 6 if n == 1
ct11[rz11[t]] <- ct11[rz11[a]] * ct11[rz11[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 6 if n == 2
ct11[rz11[t]] <- ct11[rz11[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 7 if n == 1
ct11[rz11[t]] <- ct11[rz11[a]] / ct11[rz11[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 7 if n == 2
ct11[rz11[t]] <- ct11[rz11[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 8 if n == 1
ct11[rz11[t]] <- ct11[rz11[a]] % ct11[rz11[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -12 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc11[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 11
ng11[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 11
ng11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 0 if op == 1 if n == 1 if ct11[rz11[c]] == ct11[rz11[r1]] + w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 1 if op == 1 if n == 0 if vn10[rz11[c]] == w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 1 if op == 1 if n == 1 if vn10[rz11[c]] == vn10[rz11[r1]] + w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 1 if op == 1 if n == 2 if vn10[rz11[c]] == vn10[rz11[r1]] + vn10[rz11[r2]] + w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 1 if op == 3 if n == 0 if vn10[rz11[c]] >= w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 1 if op == 4 if n == 0 if vn10[rz11[c]] <= w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 1 if op == 5 if n == 0 if vn10[rz11[c]] > w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 2 if op == 1 if n == 0 if vx10[rz11[c]] == w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 2 if op == 1 if n == 1 if vx10[rz11[c]] == vx10[rz11[r1]] + w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 2 if op == 2 if n == 0 if vx10[rz11[c]] != w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 2 if op == 3 if n == 0 if vx10[rz11[c]] >= w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 2 if op == 4 if n == 0 if vx10[rz11[c]] <= w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 2 if op == 5 if n == 0 if vx10[rz11[c]] > w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 2 if op == 6 if n == 1 if vx10[rz11[c]] < vx10[rz11[r1]] + w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 5 if op == 1 if n == 0 if vf10[rz11[c]] == w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 5 if op == 2 if n == 0 if vf10[rz11[c]] != w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 5 if op == 3 if n == 0 if vf10[rz11[c]] >= w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 9 if op == 1 if n == 0 if vc10[rz11[c]] == w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 1 if lat == 9 if op == 3 if n == 0 if vc10[rz11[c]] >= w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 2 if lat == 3 if not vo10[rz11[c]]
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 3 if lat == 3 if vo11[rz11[c]]
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 3 if lat == 5 if vf11[rz11[c]]
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 4 if lat == 1 if vn11[rz11[c]] is w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 4 if lat == 5 if vf11[rz11[c]] is w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 4 if lat == 8 if vm11[rz11[c]] is w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 5 if lat == 6 if not v411[rz11[c]]
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 11 if lat == 2 if op == 3 if n == 0 if vx11[rz11[c]] >= w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 11 if lat == 2 if op == 5 if n == 0 if vx11[rz11[c]] > w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 11 if lat == 5 if op == 1 if n == 0 if vf11[rz11[c]] == w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 11 if lat == 5 if op == 2 if n == 0 if vf11[rz11[c]] != w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 11 if lat == 5 if op == 2 if n == 1 if vf11[rz11[c]] != vf11[rz11[r1]] + w
nc11[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 11 if k == 11 if lat == 5 if op == 5 if n == 0 if vf11[rz11[c]] > w
ok11[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 11 if nc11[e] >= ng11[e]
ok11[e] <- ok10[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 11
# 値で決まる座標を番地の面へ写す（層 11）
pa11[pb + t] <- vx10[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa11[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 11 if kd == 0 if lat == 2
pa11[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa11[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 11 if kd == 1
pa11[pb + t] <- mu * pa11[p1 + t] + pa11[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 11 if kd == 2
# ── 多面体の寄与（層 11）。辺一本が空間ひとつを覆う。────────
fq11[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 11
fq11[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 11
fn11[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11
fn11[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 11 if kk == 2 if lat == 3 if not vo10[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa11[MB[cm] + MU[cm] * t]]
fn11[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 11 if kk == 3 if lat == 3 if vo11[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa11[MB[cm] + MU[cm] * t]]
fn11[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 11 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn11[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 11 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx11[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa11[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo11[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if fn11[e,t] >= fq11[e]
fo11[e,t] <- fo10[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 11
vn11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- vn10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 11
vx11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- vx10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 11
vo11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- vo10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 11
vf11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- vf10[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 11
v411[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- v410[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 11
vn11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa11[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if lat == 1 if vf == 0 if fo11[e,t]
vx11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa11[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if lat == 2 if vf == 0 if fo11[e,t]
vx11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- vx11[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa11[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa11[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if lat == 2 if vf == 1 if fo11[e,t] if n == 1
vx11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- vx11[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa11[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if lat == 2 if vf == 4 if fo11[e,t]
vo11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if lat == 3 if vf == 2 if fo11[e,t]
vf11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa11[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if lat == 5 if vf == 0 if fo11[e,t]
vf11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- vf11[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa11[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if lat == 5 if vf == 4 if fo11[e,t]
v411[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if lat == 6 if vf == 2 if fo11[e,t]
v411[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 11 if lat == 6 if vf == 5 if fo11[e,t]
vm11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa11[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa11[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 11 if lat == 8 if vf == 0 if fo11[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn11[rz11[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 1 if vf == 0
vn11[rz11[t]] <- vn11[rz11[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn11[rz11[t]] <- vn11[rz11[a]] + vn11[rz11[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn11[rz11[t]] <- vn11[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 1 if vf == 4 if la == 1
vx11[rz11[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 0
vx11[rz11[t]] <- vx11[rz11[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx11[rz11[t]] <- vx11[rz11[a]] + vx11[rz11[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx11[rz11[t]] <- vn10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 4 if la == 1
vx11[rz11[t]] <- vx11[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 4 if la == 2
vx11[rz11[t]] <- vf10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 4 if la == 5
vx11[rz11[t]] <- vx10[rz11[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx11[rz11[t]] <- vx11[rz11[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx11[rz11[t]] <- vx11[rz11[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx11[rz11[t]] <- vx10[rz11[a]] / vx10[rz11[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx11[rz11[t]] <- vx10[rz11[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx11[rz11[t]] <- vx10[rz11[a]] % vx10[rz11[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo11[rz11[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 3 if vf == 2
vo11[rz11[t]] <- vo11[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 3 if vf == 4 if la == 3
vf11[rz11[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 0
vf11[rz11[t]] <- vx10[rz11[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf11[rz11[t]] <- vf11[rz11[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf11[rz11[t]] <- vf11[rz11[a]] + vf11[rz11[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf11[rz11[t]] <- vx10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 4 if la == -2
vf11[rz11[t]] <- vx10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 4 if la == 2
vf11[rz11[t]] <- vf11[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 4 if la == 5
vf11[rz11[t]] <- vn10[rz11[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf11[rz11[t]] <- vx10[rz11[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf11[rz11[t]] <- vf11[rz11[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf11[rz11[t]] <- vx10[rz11[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf11[rz11[t]] <- vf11[rz11[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v411[rz11[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 6 if vf == 2
vs11[rz11[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 7 if vf == 3
vs11[rz11[t]] <- {vf11[rz11[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 11 if ok11[e] if lat == 7 if vf == 9 if la == 5
vm11[rz11[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 11 if ok11[e] if lat == 8 if vf == 0
vm11[rz11[t]] <- vf10[rz11[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 11 if ok11[e] if lat == 8 if vf == 4 if la == 5
vc11[rz11[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 11 if ok11[e] if lat == 9 if vf == 0

# ══ 層 12 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz12[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz12[q] <- im * vf12[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz12[q] <- im * vn11[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz12[q] <- im * vx11[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz12[q] <- im * vf11[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 11 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn12[rz12[q]] <- vn11[rz12[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx12[rz12[q]] <- vx11[rz12[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo12[rz12[q]] <- vo11[rz12[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va12[rz12[q]] <- va11[rz12[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf12[rz12[q]] <- vf11[rz12[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v412[rz12[q]] <- v411[rz12[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs12[rz12[q]] <- vs11[rz12[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 12）。閉じた面 11 からしか読まない。
ct12[rz12[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 0
ct12[rz12[t]] <- vn11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 1
ct12[rz12[t]] <- vx11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 2
ct12[rz12[t]] <- vo11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 3
ct12[rz12[t]] <- va11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 4
ct12[rz12[t]] <- vf11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 5
ct12[rz12[t]] <- v411[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 6
ct12[rz12[t]] <- vs11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 7
ct12[rz12[t]] <- vm11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 8
ct12[rz12[t]] <- vc11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 9
ct12[rz12[t]] <- vb11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 4 if la == 10
ct12[rz12[t]] <- ct12[rz12[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 1 if n == 1
ct12[rz12[t]] <- ct12[rz12[a]] + ct12[rz12[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 1 if n == 2
ct12[rz12[t]] <- ct12[rz12[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 6 if n == 1
ct12[rz12[t]] <- ct12[rz12[a]] * ct12[rz12[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 6 if n == 2
ct12[rz12[t]] <- ct12[rz12[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 7 if n == 1
ct12[rz12[t]] <- ct12[rz12[a]] / ct12[rz12[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 7 if n == 2
ct12[rz12[t]] <- ct12[rz12[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 8 if n == 1
ct12[rz12[t]] <- ct12[rz12[a]] % ct12[rz12[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -13 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc12[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 12
ng12[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 12
ng12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 0 if op == 1 if n == 1 if ct12[rz12[c]] == ct12[rz12[r1]] + w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 1 if op == 1 if n == 0 if vn11[rz12[c]] == w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 1 if op == 1 if n == 1 if vn11[rz12[c]] == vn11[rz12[r1]] + w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 1 if op == 1 if n == 2 if vn11[rz12[c]] == vn11[rz12[r1]] + vn11[rz12[r2]] + w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 1 if op == 3 if n == 0 if vn11[rz12[c]] >= w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 1 if op == 4 if n == 0 if vn11[rz12[c]] <= w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 1 if op == 5 if n == 0 if vn11[rz12[c]] > w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 2 if op == 1 if n == 0 if vx11[rz12[c]] == w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 2 if op == 1 if n == 1 if vx11[rz12[c]] == vx11[rz12[r1]] + w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 2 if op == 2 if n == 0 if vx11[rz12[c]] != w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 2 if op == 3 if n == 0 if vx11[rz12[c]] >= w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 2 if op == 4 if n == 0 if vx11[rz12[c]] <= w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 2 if op == 5 if n == 0 if vx11[rz12[c]] > w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 2 if op == 6 if n == 1 if vx11[rz12[c]] < vx11[rz12[r1]] + w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 5 if op == 1 if n == 0 if vf11[rz12[c]] == w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 5 if op == 2 if n == 0 if vf11[rz12[c]] != w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 5 if op == 3 if n == 0 if vf11[rz12[c]] >= w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 9 if op == 1 if n == 0 if vc11[rz12[c]] == w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 1 if lat == 9 if op == 3 if n == 0 if vc11[rz12[c]] >= w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 2 if lat == 3 if not vo11[rz12[c]]
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 3 if lat == 3 if vo12[rz12[c]]
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 3 if lat == 5 if vf12[rz12[c]]
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 4 if lat == 1 if vn12[rz12[c]] is w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 4 if lat == 5 if vf12[rz12[c]] is w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 4 if lat == 8 if vm12[rz12[c]] is w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 5 if lat == 6 if not v412[rz12[c]]
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 11 if lat == 2 if op == 3 if n == 0 if vx12[rz12[c]] >= w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 11 if lat == 2 if op == 5 if n == 0 if vx12[rz12[c]] > w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 11 if lat == 5 if op == 1 if n == 0 if vf12[rz12[c]] == w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 11 if lat == 5 if op == 2 if n == 0 if vf12[rz12[c]] != w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 11 if lat == 5 if op == 2 if n == 1 if vf12[rz12[c]] != vf12[rz12[r1]] + w
nc12[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 12 if k == 11 if lat == 5 if op == 5 if n == 0 if vf12[rz12[c]] > w
ok12[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 12 if nc12[e] >= ng12[e]
ok12[e] <- ok11[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 12
# 値で決まる座標を番地の面へ写す（層 12）
pa12[pb + t] <- vx11[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa12[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 12 if kd == 0 if lat == 2
pa12[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa12[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 12 if kd == 1
pa12[pb + t] <- mu * pa12[p1 + t] + pa12[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 12 if kd == 2
# ── 多面体の寄与（層 12）。辺一本が空間ひとつを覆う。────────
fq12[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 12
fq12[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 12
fn12[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12
fn12[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 12 if kk == 2 if lat == 3 if not vo11[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa12[MB[cm] + MU[cm] * t]]
fn12[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 12 if kk == 3 if lat == 3 if vo12[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa12[MB[cm] + MU[cm] * t]]
fn12[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 12 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn12[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 12 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx12[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa12[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo12[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if fn12[e,t] >= fq12[e]
fo12[e,t] <- fo11[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 12
vn12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- vn11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 12
vx12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- vx11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 12
vo12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- vo11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 12
vf12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- vf11[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 12
v412[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- v411[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 12
vn12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa12[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if lat == 1 if vf == 0 if fo12[e,t]
vx12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa12[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if lat == 2 if vf == 0 if fo12[e,t]
vx12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- vx12[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa12[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa12[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if lat == 2 if vf == 1 if fo12[e,t] if n == 1
vx12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- vx12[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa12[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if lat == 2 if vf == 4 if fo12[e,t]
vo12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if lat == 3 if vf == 2 if fo12[e,t]
vf12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa12[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if lat == 5 if vf == 0 if fo12[e,t]
vf12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- vf12[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa12[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if lat == 5 if vf == 4 if fo12[e,t]
v412[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if lat == 6 if vf == 2 if fo12[e,t]
v412[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 12 if lat == 6 if vf == 5 if fo12[e,t]
vm12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa12[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa12[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 12 if lat == 8 if vf == 0 if fo12[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn12[rz12[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 1 if vf == 0
vn12[rz12[t]] <- vn12[rz12[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn12[rz12[t]] <- vn12[rz12[a]] + vn12[rz12[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn12[rz12[t]] <- vn12[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 1 if vf == 4 if la == 1
vx12[rz12[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 0
vx12[rz12[t]] <- vx12[rz12[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx12[rz12[t]] <- vx12[rz12[a]] + vx12[rz12[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx12[rz12[t]] <- vn11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 4 if la == 1
vx12[rz12[t]] <- vx12[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 4 if la == 2
vx12[rz12[t]] <- vf11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 4 if la == 5
vx12[rz12[t]] <- vx11[rz12[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx12[rz12[t]] <- vx12[rz12[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx12[rz12[t]] <- vx12[rz12[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx12[rz12[t]] <- vx11[rz12[a]] / vx11[rz12[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx12[rz12[t]] <- vx11[rz12[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx12[rz12[t]] <- vx11[rz12[a]] % vx11[rz12[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo12[rz12[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 3 if vf == 2
vo12[rz12[t]] <- vo12[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 3 if vf == 4 if la == 3
vf12[rz12[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 0
vf12[rz12[t]] <- vx11[rz12[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf12[rz12[t]] <- vf12[rz12[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf12[rz12[t]] <- vf12[rz12[a]] + vf12[rz12[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf12[rz12[t]] <- vx11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 4 if la == -2
vf12[rz12[t]] <- vx11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 4 if la == 2
vf12[rz12[t]] <- vf12[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 4 if la == 5
vf12[rz12[t]] <- vn11[rz12[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf12[rz12[t]] <- vx11[rz12[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf12[rz12[t]] <- vf12[rz12[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf12[rz12[t]] <- vx11[rz12[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf12[rz12[t]] <- vf12[rz12[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v412[rz12[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 6 if vf == 2
vs12[rz12[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 7 if vf == 3
vs12[rz12[t]] <- {vf12[rz12[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 12 if ok12[e] if lat == 7 if vf == 9 if la == 5
vm12[rz12[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 12 if ok12[e] if lat == 8 if vf == 0
vm12[rz12[t]] <- vf11[rz12[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 12 if ok12[e] if lat == 8 if vf == 4 if la == 5
vc12[rz12[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 12 if ok12[e] if lat == 9 if vf == 0

# ══ 層 13 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz13[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz13[q] <- im * vf13[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz13[q] <- im * vn12[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz13[q] <- im * vx12[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz13[q] <- im * vf12[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 12 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn13[rz13[q]] <- vn12[rz13[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx13[rz13[q]] <- vx12[rz13[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo13[rz13[q]] <- vo12[rz13[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va13[rz13[q]] <- va12[rz13[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf13[rz13[q]] <- vf12[rz13[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v413[rz13[q]] <- v412[rz13[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs13[rz13[q]] <- vs12[rz13[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 13）。閉じた面 12 からしか読まない。
ct13[rz13[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 0
ct13[rz13[t]] <- vn12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 1
ct13[rz13[t]] <- vx12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 2
ct13[rz13[t]] <- vo12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 3
ct13[rz13[t]] <- va12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 4
ct13[rz13[t]] <- vf12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 5
ct13[rz13[t]] <- v412[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 6
ct13[rz13[t]] <- vs12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 7
ct13[rz13[t]] <- vm12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 8
ct13[rz13[t]] <- vc12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 9
ct13[rz13[t]] <- vb12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 4 if la == 10
ct13[rz13[t]] <- ct13[rz13[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 1 if n == 1
ct13[rz13[t]] <- ct13[rz13[a]] + ct13[rz13[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 1 if n == 2
ct13[rz13[t]] <- ct13[rz13[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 6 if n == 1
ct13[rz13[t]] <- ct13[rz13[a]] * ct13[rz13[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 6 if n == 2
ct13[rz13[t]] <- ct13[rz13[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 7 if n == 1
ct13[rz13[t]] <- ct13[rz13[a]] / ct13[rz13[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 7 if n == 2
ct13[rz13[t]] <- ct13[rz13[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 8 if n == 1
ct13[rz13[t]] <- ct13[rz13[a]] % ct13[rz13[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -14 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc13[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 13
ng13[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 13
ng13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 0 if op == 1 if n == 1 if ct13[rz13[c]] == ct13[rz13[r1]] + w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 1 if op == 1 if n == 0 if vn12[rz13[c]] == w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 1 if op == 1 if n == 1 if vn12[rz13[c]] == vn12[rz13[r1]] + w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 1 if op == 1 if n == 2 if vn12[rz13[c]] == vn12[rz13[r1]] + vn12[rz13[r2]] + w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 1 if op == 3 if n == 0 if vn12[rz13[c]] >= w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 1 if op == 4 if n == 0 if vn12[rz13[c]] <= w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 1 if op == 5 if n == 0 if vn12[rz13[c]] > w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 2 if op == 1 if n == 0 if vx12[rz13[c]] == w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 2 if op == 1 if n == 1 if vx12[rz13[c]] == vx12[rz13[r1]] + w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 2 if op == 2 if n == 0 if vx12[rz13[c]] != w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 2 if op == 3 if n == 0 if vx12[rz13[c]] >= w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 2 if op == 4 if n == 0 if vx12[rz13[c]] <= w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 2 if op == 5 if n == 0 if vx12[rz13[c]] > w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 2 if op == 6 if n == 1 if vx12[rz13[c]] < vx12[rz13[r1]] + w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 5 if op == 1 if n == 0 if vf12[rz13[c]] == w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 5 if op == 2 if n == 0 if vf12[rz13[c]] != w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 5 if op == 3 if n == 0 if vf12[rz13[c]] >= w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 9 if op == 1 if n == 0 if vc12[rz13[c]] == w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 1 if lat == 9 if op == 3 if n == 0 if vc12[rz13[c]] >= w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 2 if lat == 3 if not vo12[rz13[c]]
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 3 if lat == 3 if vo13[rz13[c]]
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 3 if lat == 5 if vf13[rz13[c]]
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 4 if lat == 1 if vn13[rz13[c]] is w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 4 if lat == 5 if vf13[rz13[c]] is w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 4 if lat == 8 if vm13[rz13[c]] is w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 5 if lat == 6 if not v413[rz13[c]]
