# ══ run.lx —— 走らせる物。**これ一枚で全部のプログラムが走る** ══
#
#   入れる物: 表 `eg`（寄与の辺）/ `cd`（条件）/ `ix`（升を指す番号）
#   層の上限: 16   升の番号の上限: 214362840040925879（**測った**値）
#     大きいのは、内容アドレスを座標にする場があるからである ——
#     こちらが大きく書いたのではなく、content address がそう宣言している。
#     焼くときは、その場だけが hash 表に落ちる（他は密配列）。
#   辺の上限: 35269   指し番号の上限: 25760
#
#   プログラムごとに変わるのは **表だけ**である。
#   規則の数 2556 行は、言語の形の数であって
#   プログラムの大きさではない。

# ══ 走らせる物 —— 寄与の関係を閉じる ════════════════════════════
#  升は番号。場も座標も、もうここには無い。

# ── 多面体の道 —— **反復空間を点に潰さずに渡す** ────────────────
#  「宣言されているものを、そのまま機械に渡すには？」（CLAUDE.md）
#  軸の中身は `dat` の行に置いてある（区間も表と同じ形）。
field D : flat bound 1002 6
D[r,c] <- v            for (r,c,v) in dat
field SB : max bound 24 4
SB[sp,j] <- b   for (sp,j,b,w,d) in spc
field SW : max bound 24 4
SW[sp,j] <- w   for (sp,j,b,w,d) in spc
field SD : max bound 24 4
SD[sp,j] <- d   for (sp,j,b,w,d) in spc
field SZ : max bound 24
SZ[sp] <- n            for (sp,n) in ssz
field MC : max bound 812
MC[x] <- k0            for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field MA0 : max bound 812
MA0[x] <- a0   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field ML0 : max bound 812
ML0[x] <- l0   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field MK0 : max bound 812
MK0[x] <- m0   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field MA1 : max bound 812
MA1[x] <- a1   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field ML1 : max bound 812
ML1[x] <- l1   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field MK1 : max bound 812
MK1[x] <- m1   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field MA2 : max bound 812
MA2[x] <- a2   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field ML2 : max bound 812
ML2[x] <- l2   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field MK2 : max bound 812
MK2[x] <- m2   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field MI : max bound 812
MI[x] <- im   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field MB : max bound 812
MB[x] <- ib   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
field MU : max bound 812
MU[x] <- iu   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu) in mp
