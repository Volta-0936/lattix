nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 11 if lat == 2 if op == 5 if n == 0 if vx13[rz13[c]] > w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 11 if lat == 5 if op == 1 if n == 0 if vf13[rz13[c]] == w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 11 if lat == 5 if op == 2 if n == 0 if vf13[rz13[c]] != w
nc13[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 13 if k == 11 if lat == 5 if op == 2 if n == 1 if vf13[rz13[c]] != vf13[rz13[r1]] + w
