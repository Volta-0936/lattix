vb[s, MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa[s, MB[dm] + MU[dm] * t] + MI2[dm] * pa[s, MB2[dm] + MU2[dm] * t]] <- vb[s, MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa[s, MB[wm] + MU[wm] * t] + MI2[wm] * pa[s, MB2[wm] + MU2[wm] * t]   for (s) in 0 .. 47 for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= s if lat == 10 if vf == 1 if fo[s, e, t] if n == 1
vb[s, MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa[s, MB[dm] + MU[dm] * t] + MI2[dm] * pa[s, MB2[dm] + MU2[dm] * t]] <- vb[s, MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]] + vb[s, MC[bm] + MK0[bm] * D[SB[sp,MA0[bm]] + (t / SD[sp,MA0[bm]]) % SW[sp,MA0[bm]], ML0[bm]] + MK1[bm] * D[SB[sp,MA1[bm]] + (t / SD[sp,MA1[bm]]) % SW[sp,MA1[bm]], ML1[bm]] + MK2[bm] * D[SB[sp,MA2[bm]] + (t / SD[sp,MA2[bm]]) % SW[sp,MA2[bm]], ML2[bm]] + MI[bm] * pa[s, MB[bm] + MU[bm] * t] + MI2[bm] * pa[s, MB2[bm] + MU2[bm] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa[s, MB[wm] + MU[wm] * t] + MI2[wm] * pa[s, MB2[wm] + MU2[wm] * t]   for (s) in 0 .. 47 for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= s if lat == 10 if vf == 1 if fo[s, e, t] if n == 2
vb[s, MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa[s, MB[dm] + MU[dm] * t] + MI2[dm] * pa[s, MB2[dm] + MU2[dm] * t]] <- vb[s, MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]]   for (s) in 0 .. 47 for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= s if lat == 10 if vf == 4 if fo[s, e, t]
# ── 寄与。これが全部である。──────────────────────────────
vf[s, rz[s, t]] <- vf[s, rz[s, a]] % w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 8 if n == 1 if la == 5
vc[s, rz[s, t]] <- w      for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= s if ok[s, e] if lat == 9 if vf == 0
vx[s, rz[s, t]] <- w      for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 0
vx[s, rz[s, t]] <- vx[s - 1, rz[s, a]] % vx[s - 1, rz[s, b]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 8 if n == 2 if la == -2
vf[s, rz[s, t]] <- vn[s - 1, rz[s, a]] * w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 6 if n == 1 if la == 1
vm[s, rz[s, t]] <- w      for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= s if ok[s, e] if lat == 8 if vf == 0
vo[s, rz[s, t]] <- vo[s, rz[s, a]]   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 3 if vf == 4 if la == 3
vn[s, rz[s, t]] <- w      for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 1 if vf == 0
vs[s, rz[s, t]] <- {w}    for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 7 if vf == 3
v4[s, rz[s, t]] <- true   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 6 if vf == 2
vx[s, rz[s, t]] <- vf[s, rz[s, a]] / w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 7 if n == 1 if la == 5
vx[s, rz[s, t]] <- vx[s - 1, rz[s, a]] / vx[s - 1, rz[s, b]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 7 if n == 2 if la == -2
vn[s, rz[s, t]] <- vn[s, rz[s, a]]   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 1 if vf == 4 if la == 1
vx[s, rz[s, t]] <- vx[s, rz[s, a]] / w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 7 if n == 1 if la == 2
vf[s, rz[s, t]] <- vx[s - 1, rz[s, a]] + w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 1 if n == 1 if la == 2
vx[s, rz[s, t]] <- vf[s - 1, rz[s, a]] % w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 8 if n == 1 if la == -5
vf[s, rz[s, t]] <- vf[s, rz[s, a]] + w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 1 if n == 1 if la == 5
vx[s, rz[s, t]] <- vx[s - 1, rz[s, a]] % w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx[s, rz[s, t]] <- vf[s, rz[s, a]] * w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 6 if n == 1 if la == 5
vn[s, rz[s, t]] <- vn[s, rz[s, a]] + w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 1 if vf == 1 if n == 1 if la == 1
vx[s, rz[s, t]] <- vx[s, rz[s, a]] * w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx[s, rz[s, t]] <- vx[s, rz[s, a]] + vx[s, rz[s, b]] + w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 1 if n == 2 if la == 2
vo[s, rz[s, t]] <- true   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 3 if vf == 2
vf[s, rz[s, t]] <- vx[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 4 if la == 2
vx[s, rz[s, t]] <- vx[s, rz[s, a]]   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 4 if la == 2
vf[s, rz[s, t]] <- vf[s, rz[s, a]]   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 4 if la == 5
vx[s, rz[s, t]] <- vf[s, rz[s, a]]   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 4 if la == 5
vs[s, rz[s, t]] <- {vf[s, rz[s, a]]}   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 7 if vf == 9 if la == 5
vf[s, rz[s, t]] <- vx[s - 1, rz[s, a]] % w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 8 if n == 1 if la == 2
vx[s, rz[s, t]] <- vx[s - 1, rz[s, a]] * w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 6 if n == 1 if la == -2
vf[s, rz[s, t]] <- vx[s - 1, rz[s, a]] * w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf[s, rz[s, t]] <- vf[s, rz[s, a]] * w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 6 if n == 1 if la == 5
vx[s, rz[s, t]] <- vx[s, rz[s, a]] + w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx[s, rz[s, t]] <- vf[s, rz[s, a]] + w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 1 if n == 1 if la == 5
vf[s, rz[s, t]] <- vx[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 4 if la == -2
vf[s, rz[s, t]] <- vf[s, rz[s, a]] + vf[s, rz[s, b]] + w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf[s, rz[s, t]] <- w      for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 5 if vf == 0
vm[s, rz[s, t]] <- vf[s, rz[s, a]]   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= s if ok[s, e] if lat == 8 if vf == 4 if la == 5
vx[s, rz[s, t]] <- vn[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 2 if vf == 4 if la == 1
vn[s, rz[s, t]] <- vn[s, rz[s, a]] + vn[s, rz[s, b]] + w   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == s if ok[s, e] if lat == 1 if vf == 1 if n == 2 if la == 1

field zov : or bound 8      # 宣言した上限を超えた（0 層 / 1 空間 / 2 写像 / 3 辺 / 4 指し番号 / 5 行 / 6 点 / 7 番地）
zov[0] <- true for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st >= 48 if st != 999
zov[0] <- true for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st >= 48 if st != 999
zov[0] <- true for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp if st >= 48 if st != 999
zov[0] <- true for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 48 if st != 999
zov[0] <- true for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st >= 48 if st != 999
zov[0] <- true for (e,st,lat,t,vf,n,a,la,b,w) in eg if 0 - st > 48
zov[1] <- true for (sp,n) in ssz if sp >= 128
zov[2] <- true for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp if x >= 32768
zov[3] <- true for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if e >= 6136
zov[3] <- true for (e,st,lat,t,vf,n,a,la,b,w) in eg if e >= 6136
zov[4] <- true for (q,im,ic,il,iz,dl) in ix if q >= 3996
zov[5] <- true for (r,c,v) in dat if r >= 1002
zov[5] <- true for (r,c,v) in dat if c >= 6
zov[6] <- true for (sp,n) in ssz if n > 10368
zov[7] <- true for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp if pb >= 137378

