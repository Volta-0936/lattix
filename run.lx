vo4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 4 if lat == 3 if vf == 2 if fo4[e,t]
vf4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa4[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 4 if lat == 5 if vf == 0 if fo4[e,t]
vf4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- vf4[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa4[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 4 if lat == 5 if vf == 4 if fo4[e,t]
v44[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 4 if lat == 6 if vf == 2 if fo4[e,t]
v44[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 4 if lat == 6 if vf == 5 if fo4[e,t]
vm4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa4[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 4 if lat == 8 if vf == 0 if fo4[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn4[rz4[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 1 if vf == 0
vn4[rz4[t]] <- vn4[rz4[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn4[rz4[t]] <- vn4[rz4[a]] + vn4[rz4[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn4[rz4[t]] <- vn4[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 1 if vf == 4 if la == 1
vx4[rz4[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 0
vx4[rz4[t]] <- vx4[rz4[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx4[rz4[t]] <- vx4[rz4[a]] + vx4[rz4[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx4[rz4[t]] <- vn3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 4 if la == 1
vx4[rz4[t]] <- vx4[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 4 if la == 2
vx4[rz4[t]] <- vf3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 4 if la == 5
vx4[rz4[t]] <- vx3[rz4[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx4[rz4[t]] <- vx4[rz4[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx4[rz4[t]] <- vx4[rz4[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx4[rz4[t]] <- vx3[rz4[a]] / vx3[rz4[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx4[rz4[t]] <- vx3[rz4[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx4[rz4[t]] <- vx3[rz4[a]] % vx3[rz4[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo4[rz4[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 3 if vf == 2
vo4[rz4[t]] <- vo4[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 3 if vf == 4 if la == 3
vf4[rz4[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 0
vf4[rz4[t]] <- vx3[rz4[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf4[rz4[t]] <- vf4[rz4[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf4[rz4[t]] <- vf4[rz4[a]] + vf4[rz4[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf4[rz4[t]] <- vx3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 4 if la == -2
vf4[rz4[t]] <- vx3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 4 if la == 2
vf4[rz4[t]] <- vf4[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 4 if la == 5
vf4[rz4[t]] <- vn3[rz4[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf4[rz4[t]] <- vx3[rz4[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf4[rz4[t]] <- vf4[rz4[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf4[rz4[t]] <- vx3[rz4[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf4[rz4[t]] <- vf4[rz4[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v44[rz4[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 6 if vf == 2
vs4[rz4[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 7 if vf == 3
vs4[rz4[t]] <- {vf4[rz4[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 4 if ok4[e] if lat == 7 if vf == 9 if la == 5
vm4[rz4[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 4 if ok4[e] if lat == 8 if vf == 0
vm4[rz4[t]] <- vf3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 4 if ok4[e] if lat == 8 if vf == 4 if la == 5
vc4[rz4[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 4 if ok4[e] if lat == 9 if vf == 0

# ══ 層 5 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz5[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz5[q] <- im * vf5[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz5[q] <- im * vn4[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz5[q] <- im * vx4[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz5[q] <- im * vf4[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 4 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn5[rz5[q]] <- vn4[rz5[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx5[rz5[q]] <- vx4[rz5[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo5[rz5[q]] <- vo4[rz5[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va5[rz5[q]] <- va4[rz5[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf5[rz5[q]] <- vf4[rz5[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v45[rz5[q]] <- v44[rz5[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs5[rz5[q]] <- vs4[rz5[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 5）。閉じた面 4 からしか読まない。
ct5[rz5[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 0
ct5[rz5[t]] <- vn4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 1
ct5[rz5[t]] <- vx4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 2
ct5[rz5[t]] <- vo4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 3
ct5[rz5[t]] <- va4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 4
ct5[rz5[t]] <- vf4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 5
ct5[rz5[t]] <- v44[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 6
ct5[rz5[t]] <- vs4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 7
ct5[rz5[t]] <- vm4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 8
ct5[rz5[t]] <- vc4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 9
ct5[rz5[t]] <- vb4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 4 if la == 10
ct5[rz5[t]] <- ct5[rz5[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 1 if n == 1
ct5[rz5[t]] <- ct5[rz5[a]] + ct5[rz5[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 1 if n == 2
ct5[rz5[t]] <- ct5[rz5[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 6 if n == 1
ct5[rz5[t]] <- ct5[rz5[a]] * ct5[rz5[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 6 if n == 2
ct5[rz5[t]] <- ct5[rz5[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 7 if n == 1
ct5[rz5[t]] <- ct5[rz5[a]] / ct5[rz5[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 7 if n == 2
ct5[rz5[t]] <- ct5[rz5[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 8 if n == 1
ct5[rz5[t]] <- ct5[rz5[a]] % ct5[rz5[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -6 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc5[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 5
ng5[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 5
ng5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 0 if op == 1 if n == 1 if ct5[rz5[c]] == ct5[rz5[r1]] + w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 1 if op == 1 if n == 0 if vn4[rz5[c]] == w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 1 if op == 1 if n == 1 if vn4[rz5[c]] == vn4[rz5[r1]] + w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 1 if op == 1 if n == 2 if vn4[rz5[c]] == vn4[rz5[r1]] + vn4[rz5[r2]] + w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 1 if op == 3 if n == 0 if vn4[rz5[c]] >= w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 1 if op == 4 if n == 0 if vn4[rz5[c]] <= w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 1 if op == 5 if n == 0 if vn4[rz5[c]] > w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 2 if op == 1 if n == 0 if vx4[rz5[c]] == w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 2 if op == 1 if n == 1 if vx4[rz5[c]] == vx4[rz5[r1]] + w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 2 if op == 2 if n == 0 if vx4[rz5[c]] != w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 2 if op == 3 if n == 0 if vx4[rz5[c]] >= w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 2 if op == 4 if n == 0 if vx4[rz5[c]] <= w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 2 if op == 5 if n == 0 if vx4[rz5[c]] > w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 2 if op == 6 if n == 1 if vx4[rz5[c]] < vx4[rz5[r1]] + w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 5 if op == 1 if n == 0 if vf4[rz5[c]] == w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 5 if op == 2 if n == 0 if vf4[rz5[c]] != w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 5 if op == 3 if n == 0 if vf4[rz5[c]] >= w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 9 if op == 1 if n == 0 if vc4[rz5[c]] == w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 1 if lat == 9 if op == 3 if n == 0 if vc4[rz5[c]] >= w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 2 if lat == 3 if not vo4[rz5[c]]
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 3 if lat == 3 if vo5[rz5[c]]
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 3 if lat == 5 if vf5[rz5[c]]
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 4 if lat == 1 if vn5[rz5[c]] is w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 4 if lat == 5 if vf5[rz5[c]] is w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 4 if lat == 8 if vm5[rz5[c]] is w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 5 if lat == 6 if not v45[rz5[c]]
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 11 if lat == 2 if op == 3 if n == 0 if vx5[rz5[c]] >= w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 11 if lat == 2 if op == 5 if n == 0 if vx5[rz5[c]] > w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 11 if lat == 5 if op == 1 if n == 0 if vf5[rz5[c]] == w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 11 if lat == 5 if op == 2 if n == 0 if vf5[rz5[c]] != w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 11 if lat == 5 if op == 2 if n == 1 if vf5[rz5[c]] != vf5[rz5[r1]] + w
nc5[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 5 if k == 11 if lat == 5 if op == 5 if n == 0 if vf5[rz5[c]] > w
ok5[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 5 if nc5[e] >= ng5[e]
ok5[e] <- ok4[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 5
# 値で決まる座標を番地の面へ写す（層 5）
pa5[pb + t] <- vx4[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa5[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 5 if kd == 0 if lat == 2
pa5[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa5[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 5 if kd == 1
pa5[pb + t] <- mu * pa5[p1 + t] + pa5[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 5 if kd == 2
# ── 多面体の寄与（層 5）。辺一本が空間ひとつを覆う。────────
fq5[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 5
fq5[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 5
fn5[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5
fn5[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 5 if kk == 2 if lat == 3 if not vo4[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa5[MB[cm] + MU[cm] * t]]
fn5[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 5 if kk == 3 if lat == 3 if vo5[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa5[MB[cm] + MU[cm] * t]]
fn5[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 5 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn5[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 5 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx5[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa5[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo5[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if fn5[e,t] >= fq5[e]
fo5[e,t] <- fo4[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 5
vn5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- vn4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 5
vx5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- vx4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 5
vo5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- vo4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 5
vf5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- vf4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 5
v45[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- v44[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 5
vn5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa5[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if lat == 1 if vf == 0 if fo5[e,t]
vx5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa5[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if lat == 2 if vf == 0 if fo5[e,t]
vx5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- vx5[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa5[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa5[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if lat == 2 if vf == 1 if fo5[e,t] if n == 1
vx5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- vx5[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa5[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if lat == 2 if vf == 4 if fo5[e,t]
vo5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if lat == 3 if vf == 2 if fo5[e,t]
vf5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa5[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if lat == 5 if vf == 0 if fo5[e,t]
vf5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- vf5[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa5[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if lat == 5 if vf == 4 if fo5[e,t]
v45[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if lat == 6 if vf == 2 if fo5[e,t]
v45[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 5 if lat == 6 if vf == 5 if fo5[e,t]
vm5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa5[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa5[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 5 if lat == 8 if vf == 0 if fo5[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn5[rz5[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 1 if vf == 0
vn5[rz5[t]] <- vn5[rz5[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn5[rz5[t]] <- vn5[rz5[a]] + vn5[rz5[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn5[rz5[t]] <- vn5[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 1 if vf == 4 if la == 1
vx5[rz5[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 0
vx5[rz5[t]] <- vx5[rz5[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx5[rz5[t]] <- vx5[rz5[a]] + vx5[rz5[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx5[rz5[t]] <- vn4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 4 if la == 1
vx5[rz5[t]] <- vx5[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 4 if la == 2
vx5[rz5[t]] <- vf4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 4 if la == 5
vx5[rz5[t]] <- vx4[rz5[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx5[rz5[t]] <- vx5[rz5[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx5[rz5[t]] <- vx5[rz5[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx5[rz5[t]] <- vx4[rz5[a]] / vx4[rz5[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx5[rz5[t]] <- vx4[rz5[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx5[rz5[t]] <- vx4[rz5[a]] % vx4[rz5[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo5[rz5[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 3 if vf == 2
vo5[rz5[t]] <- vo5[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 3 if vf == 4 if la == 3
vf5[rz5[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 0
vf5[rz5[t]] <- vx4[rz5[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf5[rz5[t]] <- vf5[rz5[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf5[rz5[t]] <- vf5[rz5[a]] + vf5[rz5[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf5[rz5[t]] <- vx4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 4 if la == -2
vf5[rz5[t]] <- vx4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 4 if la == 2
vf5[rz5[t]] <- vf5[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 4 if la == 5
vf5[rz5[t]] <- vn4[rz5[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf5[rz5[t]] <- vx4[rz5[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf5[rz5[t]] <- vf5[rz5[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf5[rz5[t]] <- vx4[rz5[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf5[rz5[t]] <- vf5[rz5[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v45[rz5[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 6 if vf == 2
vs5[rz5[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 7 if vf == 3
vs5[rz5[t]] <- {vf5[rz5[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 5 if ok5[e] if lat == 7 if vf == 9 if la == 5
vm5[rz5[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 5 if ok5[e] if lat == 8 if vf == 0
vm5[rz5[t]] <- vf4[rz5[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 5 if ok5[e] if lat == 8 if vf == 4 if la == 5
vc5[rz5[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 5 if ok5[e] if lat == 9 if vf == 0

# ══ 層 6 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz6[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz6[q] <- im * vf6[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz6[q] <- im * vn5[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz6[q] <- im * vx5[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz6[q] <- im * vf5[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 5 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn6[rz6[q]] <- vn5[rz6[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx6[rz6[q]] <- vx5[rz6[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo6[rz6[q]] <- vo5[rz6[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va6[rz6[q]] <- va5[rz6[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf6[rz6[q]] <- vf5[rz6[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v46[rz6[q]] <- v45[rz6[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs6[rz6[q]] <- vs5[rz6[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 6）。閉じた面 5 からしか読まない。
ct6[rz6[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 0
ct6[rz6[t]] <- vn5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 1
ct6[rz6[t]] <- vx5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 2
ct6[rz6[t]] <- vo5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 3
ct6[rz6[t]] <- va5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 4
ct6[rz6[t]] <- vf5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 5
ct6[rz6[t]] <- v45[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 6
ct6[rz6[t]] <- vs5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 7
ct6[rz6[t]] <- vm5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 8
ct6[rz6[t]] <- vc5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 9
ct6[rz6[t]] <- vb5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 4 if la == 10
ct6[rz6[t]] <- ct6[rz6[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 1 if n == 1
ct6[rz6[t]] <- ct6[rz6[a]] + ct6[rz6[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 1 if n == 2
ct6[rz6[t]] <- ct6[rz6[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 6 if n == 1
ct6[rz6[t]] <- ct6[rz6[a]] * ct6[rz6[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 6 if n == 2
ct6[rz6[t]] <- ct6[rz6[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 7 if n == 1
ct6[rz6[t]] <- ct6[rz6[a]] / ct6[rz6[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 7 if n == 2
ct6[rz6[t]] <- ct6[rz6[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 8 if n == 1
ct6[rz6[t]] <- ct6[rz6[a]] % ct6[rz6[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -7 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc6[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 6
ng6[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 6
ng6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 0 if op == 1 if n == 1 if ct6[rz6[c]] == ct6[rz6[r1]] + w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 1 if op == 1 if n == 0 if vn5[rz6[c]] == w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 1 if op == 1 if n == 1 if vn5[rz6[c]] == vn5[rz6[r1]] + w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 1 if op == 1 if n == 2 if vn5[rz6[c]] == vn5[rz6[r1]] + vn5[rz6[r2]] + w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 1 if op == 3 if n == 0 if vn5[rz6[c]] >= w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 1 if op == 4 if n == 0 if vn5[rz6[c]] <= w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 1 if op == 5 if n == 0 if vn5[rz6[c]] > w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 2 if op == 1 if n == 0 if vx5[rz6[c]] == w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 2 if op == 1 if n == 1 if vx5[rz6[c]] == vx5[rz6[r1]] + w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 2 if op == 2 if n == 0 if vx5[rz6[c]] != w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 2 if op == 3 if n == 0 if vx5[rz6[c]] >= w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 2 if op == 4 if n == 0 if vx5[rz6[c]] <= w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 2 if op == 5 if n == 0 if vx5[rz6[c]] > w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 2 if op == 6 if n == 1 if vx5[rz6[c]] < vx5[rz6[r1]] + w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 5 if op == 1 if n == 0 if vf5[rz6[c]] == w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 5 if op == 2 if n == 0 if vf5[rz6[c]] != w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 5 if op == 3 if n == 0 if vf5[rz6[c]] >= w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 9 if op == 1 if n == 0 if vc5[rz6[c]] == w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 1 if lat == 9 if op == 3 if n == 0 if vc5[rz6[c]] >= w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 2 if lat == 3 if not vo5[rz6[c]]
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 3 if lat == 3 if vo6[rz6[c]]
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 3 if lat == 5 if vf6[rz6[c]]
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 4 if lat == 1 if vn6[rz6[c]] is w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 4 if lat == 5 if vf6[rz6[c]] is w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 4 if lat == 8 if vm6[rz6[c]] is w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 5 if lat == 6 if not v46[rz6[c]]
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 11 if lat == 2 if op == 3 if n == 0 if vx6[rz6[c]] >= w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 11 if lat == 2 if op == 5 if n == 0 if vx6[rz6[c]] > w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 11 if lat == 5 if op == 1 if n == 0 if vf6[rz6[c]] == w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 11 if lat == 5 if op == 2 if n == 0 if vf6[rz6[c]] != w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 11 if lat == 5 if op == 2 if n == 1 if vf6[rz6[c]] != vf6[rz6[r1]] + w
nc6[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 6 if k == 11 if lat == 5 if op == 5 if n == 0 if vf6[rz6[c]] > w
ok6[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 6 if nc6[e] >= ng6[e]
ok6[e] <- ok5[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 6
# 値で決まる座標を番地の面へ写す（層 6）
pa6[pb + t] <- vx5[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa6[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 6 if kd == 0 if lat == 2
pa6[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa6[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 6 if kd == 1
pa6[pb + t] <- mu * pa6[p1 + t] + pa6[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 6 if kd == 2
# ── 多面体の寄与（層 6）。辺一本が空間ひとつを覆う。────────
fq6[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 6
fq6[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 6
fn6[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6
fn6[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 6 if kk == 2 if lat == 3 if not vo5[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa6[MB[cm] + MU[cm] * t]]
fn6[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 6 if kk == 3 if lat == 3 if vo6[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa6[MB[cm] + MU[cm] * t]]
fn6[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 6 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn6[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 6 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx6[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa6[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo6[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if fn6[e,t] >= fq6[e]
fo6[e,t] <- fo5[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 6
vn6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- vn5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 6
vx6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- vx5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 6
vo6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- vo5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 6
vf6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- vf5[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 6
v46[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- v45[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 6
vn6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa6[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if lat == 1 if vf == 0 if fo6[e,t]
vx6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa6[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if lat == 2 if vf == 0 if fo6[e,t]
vx6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- vx6[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa6[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa6[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if lat == 2 if vf == 1 if fo6[e,t] if n == 1
vx6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- vx6[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa6[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if lat == 2 if vf == 4 if fo6[e,t]
vo6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if lat == 3 if vf == 2 if fo6[e,t]
vf6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa6[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if lat == 5 if vf == 0 if fo6[e,t]
vf6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- vf6[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa6[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if lat == 5 if vf == 4 if fo6[e,t]
v46[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if lat == 6 if vf == 2 if fo6[e,t]
v46[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 6 if lat == 6 if vf == 5 if fo6[e,t]
vm6[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa6[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa6[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 6 if lat == 8 if vf == 0 if fo6[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn6[rz6[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 1 if vf == 0
vn6[rz6[t]] <- vn6[rz6[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn6[rz6[t]] <- vn6[rz6[a]] + vn6[rz6[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn6[rz6[t]] <- vn6[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 1 if vf == 4 if la == 1
vx6[rz6[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 0
vx6[rz6[t]] <- vx6[rz6[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx6[rz6[t]] <- vx6[rz6[a]] + vx6[rz6[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx6[rz6[t]] <- vn5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 4 if la == 1
vx6[rz6[t]] <- vx6[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 4 if la == 2
vx6[rz6[t]] <- vf5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 4 if la == 5
vx6[rz6[t]] <- vx5[rz6[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx6[rz6[t]] <- vx6[rz6[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx6[rz6[t]] <- vx6[rz6[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx6[rz6[t]] <- vx5[rz6[a]] / vx5[rz6[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx6[rz6[t]] <- vx5[rz6[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx6[rz6[t]] <- vx5[rz6[a]] % vx5[rz6[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo6[rz6[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 3 if vf == 2
vo6[rz6[t]] <- vo6[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 3 if vf == 4 if la == 3
vf6[rz6[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 0
vf6[rz6[t]] <- vx5[rz6[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf6[rz6[t]] <- vf6[rz6[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf6[rz6[t]] <- vf6[rz6[a]] + vf6[rz6[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf6[rz6[t]] <- vx5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 4 if la == -2
vf6[rz6[t]] <- vx5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 4 if la == 2
vf6[rz6[t]] <- vf6[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 4 if la == 5
vf6[rz6[t]] <- vn5[rz6[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf6[rz6[t]] <- vx5[rz6[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf6[rz6[t]] <- vf6[rz6[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf6[rz6[t]] <- vx5[rz6[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf6[rz6[t]] <- vf6[rz6[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v46[rz6[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 6 if vf == 2
vs6[rz6[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 7 if vf == 3
vs6[rz6[t]] <- {vf6[rz6[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 6 if ok6[e] if lat == 7 if vf == 9 if la == 5
vm6[rz6[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 6 if ok6[e] if lat == 8 if vf == 0
vm6[rz6[t]] <- vf5[rz6[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 6 if ok6[e] if lat == 8 if vf == 4 if la == 5
vc6[rz6[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 6 if ok6[e] if lat == 9 if vf == 0

# ══ 層 7 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz7[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz7[q] <- im * vf7[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz7[q] <- im * vn6[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz7[q] <- im * vx6[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz7[q] <- im * vf6[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 6 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn7[rz7[q]] <- vn6[rz7[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx7[rz7[q]] <- vx6[rz7[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo7[rz7[q]] <- vo6[rz7[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va7[rz7[q]] <- va6[rz7[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf7[rz7[q]] <- vf6[rz7[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v47[rz7[q]] <- v46[rz7[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs7[rz7[q]] <- vs6[rz7[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 7）。閉じた面 6 からしか読まない。
ct7[rz7[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 0
ct7[rz7[t]] <- vn6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 1
ct7[rz7[t]] <- vx6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 2
ct7[rz7[t]] <- vo6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 3
ct7[rz7[t]] <- va6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 4
ct7[rz7[t]] <- vf6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 5
ct7[rz7[t]] <- v46[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 6
ct7[rz7[t]] <- vs6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 7
ct7[rz7[t]] <- vm6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 8
ct7[rz7[t]] <- vc6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 9
ct7[rz7[t]] <- vb6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 4 if la == 10
ct7[rz7[t]] <- ct7[rz7[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 1 if n == 1
ct7[rz7[t]] <- ct7[rz7[a]] + ct7[rz7[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 1 if n == 2
ct7[rz7[t]] <- ct7[rz7[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 6 if n == 1
ct7[rz7[t]] <- ct7[rz7[a]] * ct7[rz7[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 6 if n == 2
ct7[rz7[t]] <- ct7[rz7[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 7 if n == 1
ct7[rz7[t]] <- ct7[rz7[a]] / ct7[rz7[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 7 if n == 2
ct7[rz7[t]] <- ct7[rz7[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 8 if n == 1
ct7[rz7[t]] <- ct7[rz7[a]] % ct7[rz7[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -8 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc7[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 7
ng7[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 7
ng7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 0 if op == 1 if n == 1 if ct7[rz7[c]] == ct7[rz7[r1]] + w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 1 if op == 1 if n == 0 if vn6[rz7[c]] == w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 1 if op == 1 if n == 1 if vn6[rz7[c]] == vn6[rz7[r1]] + w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 1 if op == 1 if n == 2 if vn6[rz7[c]] == vn6[rz7[r1]] + vn6[rz7[r2]] + w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 1 if op == 3 if n == 0 if vn6[rz7[c]] >= w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 1 if op == 4 if n == 0 if vn6[rz7[c]] <= w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 1 if op == 5 if n == 0 if vn6[rz7[c]] > w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 2 if op == 1 if n == 0 if vx6[rz7[c]] == w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 2 if op == 1 if n == 1 if vx6[rz7[c]] == vx6[rz7[r1]] + w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 2 if op == 2 if n == 0 if vx6[rz7[c]] != w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 2 if op == 3 if n == 0 if vx6[rz7[c]] >= w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 2 if op == 4 if n == 0 if vx6[rz7[c]] <= w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 2 if op == 5 if n == 0 if vx6[rz7[c]] > w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 2 if op == 6 if n == 1 if vx6[rz7[c]] < vx6[rz7[r1]] + w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 5 if op == 1 if n == 0 if vf6[rz7[c]] == w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 5 if op == 2 if n == 0 if vf6[rz7[c]] != w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 5 if op == 3 if n == 0 if vf6[rz7[c]] >= w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 9 if op == 1 if n == 0 if vc6[rz7[c]] == w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 1 if lat == 9 if op == 3 if n == 0 if vc6[rz7[c]] >= w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 2 if lat == 3 if not vo6[rz7[c]]
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 3 if lat == 3 if vo7[rz7[c]]
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 3 if lat == 5 if vf7[rz7[c]]
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 4 if lat == 1 if vn7[rz7[c]] is w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 4 if lat == 5 if vf7[rz7[c]] is w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 4 if lat == 8 if vm7[rz7[c]] is w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 5 if lat == 6 if not v47[rz7[c]]
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 11 if lat == 2 if op == 3 if n == 0 if vx7[rz7[c]] >= w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 11 if lat == 2 if op == 5 if n == 0 if vx7[rz7[c]] > w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 11 if lat == 5 if op == 1 if n == 0 if vf7[rz7[c]] == w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 11 if lat == 5 if op == 2 if n == 0 if vf7[rz7[c]] != w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 11 if lat == 5 if op == 2 if n == 1 if vf7[rz7[c]] != vf7[rz7[r1]] + w
nc7[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 7 if k == 11 if lat == 5 if op == 5 if n == 0 if vf7[rz7[c]] > w
ok7[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 7 if nc7[e] >= ng7[e]
ok7[e] <- ok6[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 7
# 値で決まる座標を番地の面へ写す（層 7）
pa7[pb + t] <- vx6[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa7[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 7 if kd == 0 if lat == 2
pa7[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa7[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 7 if kd == 1
pa7[pb + t] <- mu * pa7[p1 + t] + pa7[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 7 if kd == 2
# ── 多面体の寄与（層 7）。辺一本が空間ひとつを覆う。────────
fq7[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 7
fq7[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 7
fn7[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 7
fn7[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 7 if kk == 2 if lat == 3 if not vo6[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa7[MB[cm] + MU[cm] * t]]
fn7[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 7 if kk == 3 if lat == 3 if vo7[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa7[MB[cm] + MU[cm] * t]]
