vx7[rz7[t]] <- vx6[rz7[a]] / vx6[rz7[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx7[rz7[t]] <- vx6[rz7[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx7[rz7[t]] <- vx6[rz7[a]] % vx6[rz7[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo7[rz7[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 3 if vf == 2
vo7[rz7[t]] <- vo7[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 3 if vf == 4 if la == 3
vf7[rz7[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 0
vf7[rz7[t]] <- vx6[rz7[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf7[rz7[t]] <- vf7[rz7[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf7[rz7[t]] <- vf7[rz7[a]] + vf7[rz7[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf7[rz7[t]] <- vx6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 4 if la == -2
vf7[rz7[t]] <- vx6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 4 if la == 2
vf7[rz7[t]] <- vf7[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 4 if la == 5
vf7[rz7[t]] <- vn6[rz7[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf7[rz7[t]] <- vx6[rz7[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf7[rz7[t]] <- vf7[rz7[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf7[rz7[t]] <- vx6[rz7[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf7[rz7[t]] <- vf7[rz7[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v47[rz7[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 6 if vf == 2
vs7[rz7[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 7 if vf == 3
vs7[rz7[t]] <- {vf7[rz7[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 7 if ok7[e] if lat == 7 if vf == 9 if la == 5
vm7[rz7[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 7 if ok7[e] if lat == 8 if vf == 0
vm7[rz7[t]] <- vf6[rz7[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 7 if ok7[e] if lat == 8 if vf == 4 if la == 5
vc7[rz7[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 7 if ok7[e] if lat == 9 if vf == 0

# ══ 層 8 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz8[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz8[q] <- im * vf8[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz8[q] <- im * vn7[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz8[q] <- im * vx7[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz8[q] <- im * vf7[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 7 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn8[rz8[q]] <- vn7[rz8[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx8[rz8[q]] <- vx7[rz8[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo8[rz8[q]] <- vo7[rz8[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va8[rz8[q]] <- va7[rz8[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf8[rz8[q]] <- vf7[rz8[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v48[rz8[q]] <- v47[rz8[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs8[rz8[q]] <- vs7[rz8[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 8）。閉じた面 7 からしか読まない。
ct8[rz8[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 0
ct8[rz8[t]] <- vn7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 1
ct8[rz8[t]] <- vx7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 2
ct8[rz8[t]] <- vo7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 3
ct8[rz8[t]] <- va7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 4
ct8[rz8[t]] <- vf7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 5
ct8[rz8[t]] <- v47[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 6
ct8[rz8[t]] <- vs7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 7
ct8[rz8[t]] <- vm7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 8
ct8[rz8[t]] <- vc7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 9
ct8[rz8[t]] <- vb7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 4 if la == 10
ct8[rz8[t]] <- ct8[rz8[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 1 if n == 1
ct8[rz8[t]] <- ct8[rz8[a]] + ct8[rz8[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 1 if n == 2
ct8[rz8[t]] <- ct8[rz8[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 6 if n == 1
ct8[rz8[t]] <- ct8[rz8[a]] * ct8[rz8[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 6 if n == 2
ct8[rz8[t]] <- ct8[rz8[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 7 if n == 1
ct8[rz8[t]] <- ct8[rz8[a]] / ct8[rz8[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 7 if n == 2
ct8[rz8[t]] <- ct8[rz8[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 8 if n == 1
ct8[rz8[t]] <- ct8[rz8[a]] % ct8[rz8[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -9 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc8[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 8
ng8[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 8
ng8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 0 if op == 1 if n == 1 if ct8[rz8[c]] == ct8[rz8[r1]] + w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 1 if op == 1 if n == 0 if vn7[rz8[c]] == w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 1 if op == 1 if n == 1 if vn7[rz8[c]] == vn7[rz8[r1]] + w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 1 if op == 1 if n == 2 if vn7[rz8[c]] == vn7[rz8[r1]] + vn7[rz8[r2]] + w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 1 if op == 3 if n == 0 if vn7[rz8[c]] >= w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 1 if op == 4 if n == 0 if vn7[rz8[c]] <= w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 1 if op == 5 if n == 0 if vn7[rz8[c]] > w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 2 if op == 1 if n == 0 if vx7[rz8[c]] == w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 2 if op == 1 if n == 1 if vx7[rz8[c]] == vx7[rz8[r1]] + w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 2 if op == 2 if n == 0 if vx7[rz8[c]] != w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 2 if op == 3 if n == 0 if vx7[rz8[c]] >= w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 2 if op == 4 if n == 0 if vx7[rz8[c]] <= w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 2 if op == 5 if n == 0 if vx7[rz8[c]] > w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 2 if op == 6 if n == 1 if vx7[rz8[c]] < vx7[rz8[r1]] + w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 5 if op == 1 if n == 0 if vf7[rz8[c]] == w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 5 if op == 2 if n == 0 if vf7[rz8[c]] != w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 5 if op == 3 if n == 0 if vf7[rz8[c]] >= w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 9 if op == 1 if n == 0 if vc7[rz8[c]] == w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 1 if lat == 9 if op == 3 if n == 0 if vc7[rz8[c]] >= w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 2 if lat == 3 if not vo7[rz8[c]]
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 3 if lat == 3 if vo8[rz8[c]]
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 3 if lat == 5 if vf8[rz8[c]]
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 4 if lat == 1 if vn8[rz8[c]] is w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 4 if lat == 5 if vf8[rz8[c]] is w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 4 if lat == 8 if vm8[rz8[c]] is w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 5 if lat == 6 if not v48[rz8[c]]
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 11 if lat == 2 if op == 3 if n == 0 if vx8[rz8[c]] >= w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 11 if lat == 2 if op == 5 if n == 0 if vx8[rz8[c]] > w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 11 if lat == 5 if op == 1 if n == 0 if vf8[rz8[c]] == w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 11 if lat == 5 if op == 2 if n == 0 if vf8[rz8[c]] != w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 11 if lat == 5 if op == 2 if n == 1 if vf8[rz8[c]] != vf8[rz8[r1]] + w
nc8[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 8 if k == 11 if lat == 5 if op == 5 if n == 0 if vf8[rz8[c]] > w
ok8[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 8 if nc8[e] >= ng8[e]
ok8[e] <- ok7[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 8
# 値で決まる座標を番地の面へ写す（層 8）
pa8[pb + t] <- vx7[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa8[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 8 if kd == 0 if lat == 2
pa8[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa8[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 8 if kd == 1
pa8[pb + t] <- mu * pa8[p1 + t] + pa8[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 8 if kd == 2
# ── 多面体の寄与（層 8）。辺一本が空間ひとつを覆う。────────
fq8[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 8
fq8[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 8
fn8[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 8
fn8[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 8 if kk == 2 if lat == 3 if not vo7[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa8[MB[cm] + MU[cm] * t]]
fn8[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 8 if kk == 3 if lat == 3 if vo8[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa8[MB[cm] + MU[cm] * t]]
fn8[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 8 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn8[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 8 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx8[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa8[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
