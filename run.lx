field fq15 : count bound 35269
field fn15 : count bound 35269 10368
field fo15 : or bound 35269 10368

# ══ 層 0 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz0[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz0[q] <- im * vf0[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc0[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0
ng0[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0
ng0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 3 if lat == 3 if vo0[rz0[c]]
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 3 if lat == 5 if vf0[rz0[c]]
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 4 if lat == 1 if vn0[rz0[c]] is w
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 4 if lat == 5 if vf0[rz0[c]] is w
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 4 if lat == 8 if vm0[rz0[c]] is w
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 5 if lat == 6 if not v40[rz0[c]]
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 11 if lat == 2 if op == 3 if n == 0 if vx0[rz0[c]] >= w
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 11 if lat == 2 if op == 5 if n == 0 if vx0[rz0[c]] > w
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 11 if lat == 5 if op == 1 if n == 0 if vf0[rz0[c]] == w
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 11 if lat == 5 if op == 2 if n == 0 if vf0[rz0[c]] != w
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 11 if lat == 5 if op == 2 if n == 1 if vf0[rz0[c]] != vf0[rz0[r1]] + w
nc0[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 0 if k == 11 if lat == 5 if op == 5 if n == 0 if vf0[rz0[c]] > w
ok0[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 if nc0[e] >= ng0[e]
# 値で決まる座標を番地の面へ写す（層 0）
pa0[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa0[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 0 if kd == 1
pa0[pb + t] <- mu * pa0[p1 + t] + pa0[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 0 if kd == 2
# ── 多面体の寄与（層 0）。辺一本が空間ひとつを覆う。────────
fq0[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 0
fq0[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 0
fn0[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0
fn0[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 0 if kk == 3 if lat == 3 if vo0[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa0[MB[cm] + MU[cm] * t]]
fn0[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 0 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn0[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 0 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx0[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa0[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo0[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if fn0[e,t] >= fq0[e]
vn0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa0[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if lat == 1 if vf == 0 if fo0[e,t]
vx0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa0[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if lat == 2 if vf == 0 if fo0[e,t]
vx0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- vx0[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa0[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa0[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if lat == 2 if vf == 1 if fo0[e,t] if n == 1
vx0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- vx0[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa0[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if lat == 2 if vf == 4 if fo0[e,t]
vo0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if lat == 3 if vf == 2 if fo0[e,t]
vf0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa0[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if lat == 5 if vf == 0 if fo0[e,t]
vf0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- vf0[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa0[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if lat == 5 if vf == 4 if fo0[e,t]
v40[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if lat == 6 if vf == 2 if fo0[e,t]
v40[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 0 if lat == 6 if vf == 5 if fo0[e,t]
vm0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa0[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa0[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 0 if lat == 8 if vf == 0 if fo0[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn0[rz0[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 1 if vf == 0
vn0[rz0[t]] <- vn0[rz0[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn0[rz0[t]] <- vn0[rz0[a]] + vn0[rz0[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn0[rz0[t]] <- vn0[rz0[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 1 if vf == 4 if la == 1
vx0[rz0[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 2 if vf == 0
vx0[rz0[t]] <- vx0[rz0[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx0[rz0[t]] <- vx0[rz0[a]] + vx0[rz0[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx0[rz0[t]] <- vx0[rz0[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 2 if vf == 4 if la == 2
vx0[rz0[t]] <- vx0[rz0[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx0[rz0[t]] <- vx0[rz0[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vo0[rz0[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 3 if vf == 2
vo0[rz0[t]] <- vo0[rz0[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 3 if vf == 4 if la == 3
vf0[rz0[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 5 if vf == 0
vf0[rz0[t]] <- vf0[rz0[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf0[rz0[t]] <- vf0[rz0[a]] + vf0[rz0[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf0[rz0[t]] <- vf0[rz0[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 5 if vf == 4 if la == 5
vf0[rz0[t]] <- vf0[rz0[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf0[rz0[t]] <- vf0[rz0[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v40[rz0[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 6 if vf == 2
vs0[rz0[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 7 if vf == 3
vs0[rz0[t]] <- {vf0[rz0[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 0 if ok0[e] if lat == 7 if vf == 9 if la == 5
vm0[rz0[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 0 if ok0[e] if lat == 8 if vf == 0
vc0[rz0[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 0 if ok0[e] if lat == 9 if vf == 0

# ══ 層 1 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz1[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz1[q] <- im * vf1[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz1[q] <- im * vn0[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz1[q] <- im * vx0[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz1[q] <- im * vf0[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 0 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn1[rz1[q]] <- vn0[rz1[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx1[rz1[q]] <- vx0[rz1[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo1[rz1[q]] <- vo0[rz1[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va1[rz1[q]] <- va0[rz1[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf1[rz1[q]] <- vf0[rz1[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v41[rz1[q]] <- v40[rz1[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs1[rz1[q]] <- vs0[rz1[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 1）。閉じた面 0 からしか読まない。
ct1[rz1[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 0
ct1[rz1[t]] <- vn0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 1
ct1[rz1[t]] <- vx0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 2
ct1[rz1[t]] <- vo0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 3
ct1[rz1[t]] <- va0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 4
ct1[rz1[t]] <- vf0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 5
ct1[rz1[t]] <- v40[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 6
ct1[rz1[t]] <- vs0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 7
ct1[rz1[t]] <- vm0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 8
ct1[rz1[t]] <- vc0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 9
ct1[rz1[t]] <- vb0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 4 if la == 10
ct1[rz1[t]] <- ct1[rz1[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 1 if n == 1
ct1[rz1[t]] <- ct1[rz1[a]] + ct1[rz1[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 1 if n == 2
ct1[rz1[t]] <- ct1[rz1[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 6 if n == 1
ct1[rz1[t]] <- ct1[rz1[a]] * ct1[rz1[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 6 if n == 2
ct1[rz1[t]] <- ct1[rz1[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 7 if n == 1
ct1[rz1[t]] <- ct1[rz1[a]] / ct1[rz1[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 7 if n == 2
ct1[rz1[t]] <- ct1[rz1[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 8 if n == 1
ct1[rz1[t]] <- ct1[rz1[a]] % ct1[rz1[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -2 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc1[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 1
ng1[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 1
ng1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 0 if op == 1 if n == 1 if ct1[rz1[c]] == ct1[rz1[r1]] + w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 1 if op == 1 if n == 0 if vn0[rz1[c]] == w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 1 if op == 1 if n == 1 if vn0[rz1[c]] == vn0[rz1[r1]] + w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 1 if op == 1 if n == 2 if vn0[rz1[c]] == vn0[rz1[r1]] + vn0[rz1[r2]] + w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 1 if op == 3 if n == 0 if vn0[rz1[c]] >= w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 1 if op == 4 if n == 0 if vn0[rz1[c]] <= w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 1 if op == 5 if n == 0 if vn0[rz1[c]] > w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 2 if op == 1 if n == 0 if vx0[rz1[c]] == w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 2 if op == 1 if n == 1 if vx0[rz1[c]] == vx0[rz1[r1]] + w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 2 if op == 2 if n == 0 if vx0[rz1[c]] != w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 2 if op == 3 if n == 0 if vx0[rz1[c]] >= w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 2 if op == 4 if n == 0 if vx0[rz1[c]] <= w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 2 if op == 5 if n == 0 if vx0[rz1[c]] > w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 2 if op == 6 if n == 1 if vx0[rz1[c]] < vx0[rz1[r1]] + w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 5 if op == 1 if n == 0 if vf0[rz1[c]] == w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 5 if op == 2 if n == 0 if vf0[rz1[c]] != w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 5 if op == 3 if n == 0 if vf0[rz1[c]] >= w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 9 if op == 1 if n == 0 if vc0[rz1[c]] == w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 1 if lat == 9 if op == 3 if n == 0 if vc0[rz1[c]] >= w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 2 if lat == 3 if not vo0[rz1[c]]
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 3 if lat == 3 if vo1[rz1[c]]
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 3 if lat == 5 if vf1[rz1[c]]
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 4 if lat == 1 if vn1[rz1[c]] is w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 4 if lat == 5 if vf1[rz1[c]] is w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 4 if lat == 8 if vm1[rz1[c]] is w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 5 if lat == 6 if not v41[rz1[c]]
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 11 if lat == 2 if op == 3 if n == 0 if vx1[rz1[c]] >= w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 11 if lat == 2 if op == 5 if n == 0 if vx1[rz1[c]] > w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 11 if lat == 5 if op == 1 if n == 0 if vf1[rz1[c]] == w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 11 if lat == 5 if op == 2 if n == 0 if vf1[rz1[c]] != w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 11 if lat == 5 if op == 2 if n == 1 if vf1[rz1[c]] != vf1[rz1[r1]] + w
nc1[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 1 if k == 11 if lat == 5 if op == 5 if n == 0 if vf1[rz1[c]] > w
ok1[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 1 if nc1[e] >= ng1[e]
ok1[e] <- ok0[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 1
# 値で決まる座標を番地の面へ写す（層 1）
pa1[pb + t] <- vx0[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa1[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 1 if kd == 0 if lat == 2
pa1[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa1[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 1 if kd == 1
pa1[pb + t] <- mu * pa1[p1 + t] + pa1[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 1 if kd == 2
# ── 多面体の寄与（層 1）。辺一本が空間ひとつを覆う。────────
fq1[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 1
fq1[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 1
fn1[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1
fn1[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 1 if kk == 2 if lat == 3 if not vo0[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa1[MB[cm] + MU[cm] * t]]
fn1[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 1 if kk == 3 if lat == 3 if vo1[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa1[MB[cm] + MU[cm] * t]]
fn1[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 1 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn1[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 1 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx1[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa1[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo1[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if fn1[e,t] >= fq1[e]
fo1[e,t] <- fo0[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 1
vn1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- vn0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 1
vx1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- vx0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 1
vo1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- vo0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 1
vf1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- vf0[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 1
v41[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- v40[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 1
vn1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa1[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if lat == 1 if vf == 0 if fo1[e,t]
vx1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa1[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if lat == 2 if vf == 0 if fo1[e,t]
vx1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- vx1[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa1[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa1[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if lat == 2 if vf == 1 if fo1[e,t] if n == 1
vx1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- vx1[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa1[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if lat == 2 if vf == 4 if fo1[e,t]
vo1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if lat == 3 if vf == 2 if fo1[e,t]
vf1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa1[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if lat == 5 if vf == 0 if fo1[e,t]
vf1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- vf1[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa1[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if lat == 5 if vf == 4 if fo1[e,t]
v41[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if lat == 6 if vf == 2 if fo1[e,t]
v41[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 1 if lat == 6 if vf == 5 if fo1[e,t]
vm1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa1[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa1[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 1 if lat == 8 if vf == 0 if fo1[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn1[rz1[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 1 if vf == 0
vn1[rz1[t]] <- vn1[rz1[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn1[rz1[t]] <- vn1[rz1[a]] + vn1[rz1[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn1[rz1[t]] <- vn1[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 1 if vf == 4 if la == 1
vx1[rz1[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 0
vx1[rz1[t]] <- vx1[rz1[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx1[rz1[t]] <- vx1[rz1[a]] + vx1[rz1[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx1[rz1[t]] <- vn0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 4 if la == 1
vx1[rz1[t]] <- vx1[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 4 if la == 2
vx1[rz1[t]] <- vf0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 4 if la == 5
vx1[rz1[t]] <- vx0[rz1[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx1[rz1[t]] <- vx1[rz1[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx1[rz1[t]] <- vx1[rz1[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx1[rz1[t]] <- vx0[rz1[a]] / vx0[rz1[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx1[rz1[t]] <- vx0[rz1[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx1[rz1[t]] <- vx0[rz1[a]] % vx0[rz1[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo1[rz1[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 3 if vf == 2
vo1[rz1[t]] <- vo1[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 3 if vf == 4 if la == 3
vf1[rz1[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 0
vf1[rz1[t]] <- vx0[rz1[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf1[rz1[t]] <- vf1[rz1[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf1[rz1[t]] <- vf1[rz1[a]] + vf1[rz1[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf1[rz1[t]] <- vx0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 4 if la == -2
vf1[rz1[t]] <- vx0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 4 if la == 2
vf1[rz1[t]] <- vf1[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 4 if la == 5
vf1[rz1[t]] <- vn0[rz1[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf1[rz1[t]] <- vx0[rz1[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf1[rz1[t]] <- vf1[rz1[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf1[rz1[t]] <- vx0[rz1[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf1[rz1[t]] <- vf1[rz1[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v41[rz1[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 6 if vf == 2
vs1[rz1[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 7 if vf == 3
vs1[rz1[t]] <- {vf1[rz1[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 1 if ok1[e] if lat == 7 if vf == 9 if la == 5
vm1[rz1[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 1 if ok1[e] if lat == 8 if vf == 0
vm1[rz1[t]] <- vf0[rz1[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 1 if ok1[e] if lat == 8 if vf == 4 if la == 5
vc1[rz1[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 1 if ok1[e] if lat == 9 if vf == 0

# ══ 層 2 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz2[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz2[q] <- im * vf2[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz2[q] <- im * vn1[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz2[q] <- im * vx1[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz2[q] <- im * vf1[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 1 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn2[rz2[q]] <- vn1[rz2[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx2[rz2[q]] <- vx1[rz2[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo2[rz2[q]] <- vo1[rz2[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va2[rz2[q]] <- va1[rz2[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf2[rz2[q]] <- vf1[rz2[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v42[rz2[q]] <- v41[rz2[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs2[rz2[q]] <- vs1[rz2[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 2）。閉じた面 1 からしか読まない。
ct2[rz2[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 0
ct2[rz2[t]] <- vn1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 1
ct2[rz2[t]] <- vx1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 2
ct2[rz2[t]] <- vo1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 3
ct2[rz2[t]] <- va1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 4
ct2[rz2[t]] <- vf1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 5
ct2[rz2[t]] <- v41[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 6
ct2[rz2[t]] <- vs1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 7
ct2[rz2[t]] <- vm1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 8
ct2[rz2[t]] <- vc1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 9
ct2[rz2[t]] <- vb1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 4 if la == 10
ct2[rz2[t]] <- ct2[rz2[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 1 if n == 1
ct2[rz2[t]] <- ct2[rz2[a]] + ct2[rz2[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 1 if n == 2
ct2[rz2[t]] <- ct2[rz2[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 6 if n == 1
ct2[rz2[t]] <- ct2[rz2[a]] * ct2[rz2[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 6 if n == 2
ct2[rz2[t]] <- ct2[rz2[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 7 if n == 1
ct2[rz2[t]] <- ct2[rz2[a]] / ct2[rz2[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 7 if n == 2
ct2[rz2[t]] <- ct2[rz2[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 8 if n == 1
ct2[rz2[t]] <- ct2[rz2[a]] % ct2[rz2[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -3 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc2[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 2
ng2[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 2
ng2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 0 if op == 1 if n == 1 if ct2[rz2[c]] == ct2[rz2[r1]] + w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 1 if op == 1 if n == 0 if vn1[rz2[c]] == w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 1 if op == 1 if n == 1 if vn1[rz2[c]] == vn1[rz2[r1]] + w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 1 if op == 1 if n == 2 if vn1[rz2[c]] == vn1[rz2[r1]] + vn1[rz2[r2]] + w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 1 if op == 3 if n == 0 if vn1[rz2[c]] >= w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 1 if op == 4 if n == 0 if vn1[rz2[c]] <= w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 1 if op == 5 if n == 0 if vn1[rz2[c]] > w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 2 if op == 1 if n == 0 if vx1[rz2[c]] == w
