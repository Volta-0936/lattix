ok2[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 2 if nc2[e] >= ng2[e]
ok2[e] <- ok1[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 2
# 値で決まる座標を番地の面へ写す（層 2）
pa2[pb + t] <- vx1[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa2[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 2 if kd == 0 if lat == 2
pa2[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa2[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 2 if kd == 1
pa2[pb + t] <- mu * pa2[p1 + t] + pa2[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 2 if kd == 2
# ── 多面体の寄与（層 2）。辺一本が空間ひとつを覆う。────────
fq2[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 2
fq2[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 2
fn2[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2
fn2[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 2 if kk == 2 if lat == 3 if not vo1[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa2[MB[cm] + MU[cm] * t]]
fn2[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 2 if kk == 3 if lat == 3 if vo2[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa2[MB[cm] + MU[cm] * t]]
fn2[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 2 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn2[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 2 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx2[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa2[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo2[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if fn2[e,t] >= fq2[e]
fo2[e,t] <- fo1[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 2
vn2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- vn1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 2
vx2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- vx1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 2
vo2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- vo1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 2
vf2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- vf1[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 2
v42[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- v41[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 2
vn2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa2[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if lat == 1 if vf == 0 if fo2[e,t]
vx2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa2[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if lat == 2 if vf == 0 if fo2[e,t]
vx2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- vx2[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa2[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa2[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if lat == 2 if vf == 1 if fo2[e,t] if n == 1
vx2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- vx2[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa2[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if lat == 2 if vf == 4 if fo2[e,t]
vo2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if lat == 3 if vf == 2 if fo2[e,t]
vf2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa2[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if lat == 5 if vf == 0 if fo2[e,t]
vf2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- vf2[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa2[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if lat == 5 if vf == 4 if fo2[e,t]
v42[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if lat == 6 if vf == 2 if fo2[e,t]
v42[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 2 if lat == 6 if vf == 5 if fo2[e,t]
vm2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa2[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa2[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 2 if lat == 8 if vf == 0 if fo2[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn2[rz2[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 1 if vf == 0
vn2[rz2[t]] <- vn2[rz2[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn2[rz2[t]] <- vn2[rz2[a]] + vn2[rz2[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn2[rz2[t]] <- vn2[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 1 if vf == 4 if la == 1
vx2[rz2[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 0
vx2[rz2[t]] <- vx2[rz2[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx2[rz2[t]] <- vx2[rz2[a]] + vx2[rz2[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx2[rz2[t]] <- vn1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 4 if la == 1
vx2[rz2[t]] <- vx2[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 4 if la == 2
vx2[rz2[t]] <- vf1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 4 if la == 5
vx2[rz2[t]] <- vx1[rz2[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx2[rz2[t]] <- vx2[rz2[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx2[rz2[t]] <- vx2[rz2[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx2[rz2[t]] <- vx1[rz2[a]] / vx1[rz2[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx2[rz2[t]] <- vx1[rz2[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx2[rz2[t]] <- vx1[rz2[a]] % vx1[rz2[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo2[rz2[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 3 if vf == 2
vo2[rz2[t]] <- vo2[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 3 if vf == 4 if la == 3
vf2[rz2[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 0
vf2[rz2[t]] <- vx1[rz2[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf2[rz2[t]] <- vf2[rz2[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf2[rz2[t]] <- vf2[rz2[a]] + vf2[rz2[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf2[rz2[t]] <- vx1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 4 if la == -2
vf2[rz2[t]] <- vx1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 4 if la == 2
vf2[rz2[t]] <- vf2[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 4 if la == 5
vf2[rz2[t]] <- vn1[rz2[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf2[rz2[t]] <- vx1[rz2[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf2[rz2[t]] <- vf2[rz2[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf2[rz2[t]] <- vx1[rz2[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf2[rz2[t]] <- vf2[rz2[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v42[rz2[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 6 if vf == 2
vs2[rz2[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 7 if vf == 3
vs2[rz2[t]] <- {vf2[rz2[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 2 if ok2[e] if lat == 7 if vf == 9 if la == 5
vm2[rz2[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 2 if ok2[e] if lat == 8 if vf == 0
vm2[rz2[t]] <- vf1[rz2[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 2 if ok2[e] if lat == 8 if vf == 4 if la == 5
vc2[rz2[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 2 if ok2[e] if lat == 9 if vf == 0

# ══ 層 3 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz3[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz3[q] <- im * vf3[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz3[q] <- im * vn2[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz3[q] <- im * vx2[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz3[q] <- im * vf2[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 2 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn3[rz3[q]] <- vn2[rz3[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx3[rz3[q]] <- vx2[rz3[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo3[rz3[q]] <- vo2[rz3[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va3[rz3[q]] <- va2[rz3[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf3[rz3[q]] <- vf2[rz3[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v43[rz3[q]] <- v42[rz3[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs3[rz3[q]] <- vs2[rz3[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 3）。閉じた面 2 からしか読まない。
ct3[rz3[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 0
ct3[rz3[t]] <- vn2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 1
ct3[rz3[t]] <- vx2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 2
ct3[rz3[t]] <- vo2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 3
ct3[rz3[t]] <- va2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 4
ct3[rz3[t]] <- vf2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 5
ct3[rz3[t]] <- v42[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 6
ct3[rz3[t]] <- vs2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 7
ct3[rz3[t]] <- vm2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 8
ct3[rz3[t]] <- vc2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 9
ct3[rz3[t]] <- vb2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 4 if la == 10
ct3[rz3[t]] <- ct3[rz3[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 1 if n == 1
ct3[rz3[t]] <- ct3[rz3[a]] + ct3[rz3[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 1 if n == 2
ct3[rz3[t]] <- ct3[rz3[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 6 if n == 1
ct3[rz3[t]] <- ct3[rz3[a]] * ct3[rz3[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 6 if n == 2
ct3[rz3[t]] <- ct3[rz3[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 7 if n == 1
ct3[rz3[t]] <- ct3[rz3[a]] / ct3[rz3[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 7 if n == 2
ct3[rz3[t]] <- ct3[rz3[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 8 if n == 1
ct3[rz3[t]] <- ct3[rz3[a]] % ct3[rz3[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -4 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc3[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 3
ng3[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 3
ng3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 0 if op == 1 if n == 1 if ct3[rz3[c]] == ct3[rz3[r1]] + w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 1 if op == 1 if n == 0 if vn2[rz3[c]] == w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 1 if op == 1 if n == 1 if vn2[rz3[c]] == vn2[rz3[r1]] + w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 1 if op == 1 if n == 2 if vn2[rz3[c]] == vn2[rz3[r1]] + vn2[rz3[r2]] + w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 1 if op == 3 if n == 0 if vn2[rz3[c]] >= w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 1 if op == 4 if n == 0 if vn2[rz3[c]] <= w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 1 if op == 5 if n == 0 if vn2[rz3[c]] > w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 2 if op == 1 if n == 0 if vx2[rz3[c]] == w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 2 if op == 1 if n == 1 if vx2[rz3[c]] == vx2[rz3[r1]] + w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 2 if op == 2 if n == 0 if vx2[rz3[c]] != w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 2 if op == 3 if n == 0 if vx2[rz3[c]] >= w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 2 if op == 4 if n == 0 if vx2[rz3[c]] <= w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 2 if op == 5 if n == 0 if vx2[rz3[c]] > w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 2 if op == 6 if n == 1 if vx2[rz3[c]] < vx2[rz3[r1]] + w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 5 if op == 1 if n == 0 if vf2[rz3[c]] == w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 5 if op == 2 if n == 0 if vf2[rz3[c]] != w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 5 if op == 3 if n == 0 if vf2[rz3[c]] >= w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 9 if op == 1 if n == 0 if vc2[rz3[c]] == w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 1 if lat == 9 if op == 3 if n == 0 if vc2[rz3[c]] >= w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 2 if lat == 3 if not vo2[rz3[c]]
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 3 if lat == 3 if vo3[rz3[c]]
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 3 if lat == 5 if vf3[rz3[c]]
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 4 if lat == 1 if vn3[rz3[c]] is w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 4 if lat == 5 if vf3[rz3[c]] is w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 4 if lat == 8 if vm3[rz3[c]] is w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 5 if lat == 6 if not v43[rz3[c]]
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 11 if lat == 2 if op == 3 if n == 0 if vx3[rz3[c]] >= w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 11 if lat == 2 if op == 5 if n == 0 if vx3[rz3[c]] > w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 11 if lat == 5 if op == 1 if n == 0 if vf3[rz3[c]] == w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 11 if lat == 5 if op == 2 if n == 0 if vf3[rz3[c]] != w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 11 if lat == 5 if op == 2 if n == 1 if vf3[rz3[c]] != vf3[rz3[r1]] + w
nc3[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 3 if k == 11 if lat == 5 if op == 5 if n == 0 if vf3[rz3[c]] > w
ok3[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 3 if nc3[e] >= ng3[e]
ok3[e] <- ok2[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 3
# 値で決まる座標を番地の面へ写す（層 3）
pa3[pb + t] <- vx2[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa3[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 3 if kd == 0 if lat == 2
pa3[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa3[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 3 if kd == 1
pa3[pb + t] <- mu * pa3[p1 + t] + pa3[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 3 if kd == 2
# ── 多面体の寄与（層 3）。辺一本が空間ひとつを覆う。────────
fq3[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 3
fq3[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 3
fn3[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3
fn3[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 3 if kk == 2 if lat == 3 if not vo2[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa3[MB[cm] + MU[cm] * t]]
fn3[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 3 if kk == 3 if lat == 3 if vo3[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa3[MB[cm] + MU[cm] * t]]
fn3[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 3 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn3[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 3 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx3[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa3[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo3[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if fn3[e,t] >= fq3[e]
fo3[e,t] <- fo2[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 3
vn3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- vn2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 3
vx3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- vx2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 3
vo3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- vo2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 3
vf3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- vf2[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 3
v43[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- v42[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 3
vn3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa3[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if lat == 1 if vf == 0 if fo3[e,t]
vx3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa3[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if lat == 2 if vf == 0 if fo3[e,t]
vx3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- vx3[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa3[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa3[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if lat == 2 if vf == 1 if fo3[e,t] if n == 1
vx3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- vx3[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa3[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if lat == 2 if vf == 4 if fo3[e,t]
vo3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if lat == 3 if vf == 2 if fo3[e,t]
vf3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa3[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if lat == 5 if vf == 0 if fo3[e,t]
vf3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- vf3[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa3[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if lat == 5 if vf == 4 if fo3[e,t]
v43[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if lat == 6 if vf == 2 if fo3[e,t]
v43[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 3 if lat == 6 if vf == 5 if fo3[e,t]
vm3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa3[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa3[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 3 if lat == 8 if vf == 0 if fo3[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn3[rz3[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 1 if vf == 0
vn3[rz3[t]] <- vn3[rz3[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn3[rz3[t]] <- vn3[rz3[a]] + vn3[rz3[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn3[rz3[t]] <- vn3[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 1 if vf == 4 if la == 1
vx3[rz3[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 0
vx3[rz3[t]] <- vx3[rz3[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx3[rz3[t]] <- vx3[rz3[a]] + vx3[rz3[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx3[rz3[t]] <- vn2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 4 if la == 1
vx3[rz3[t]] <- vx3[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 4 if la == 2
vx3[rz3[t]] <- vf2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 4 if la == 5
vx3[rz3[t]] <- vx2[rz3[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx3[rz3[t]] <- vx3[rz3[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx3[rz3[t]] <- vx3[rz3[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx3[rz3[t]] <- vx2[rz3[a]] / vx2[rz3[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx3[rz3[t]] <- vx2[rz3[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx3[rz3[t]] <- vx2[rz3[a]] % vx2[rz3[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo3[rz3[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 3 if vf == 2
vo3[rz3[t]] <- vo3[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 3 if vf == 4 if la == 3
vf3[rz3[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 0
vf3[rz3[t]] <- vx2[rz3[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf3[rz3[t]] <- vf3[rz3[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf3[rz3[t]] <- vf3[rz3[a]] + vf3[rz3[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf3[rz3[t]] <- vx2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 4 if la == -2
vf3[rz3[t]] <- vx2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 4 if la == 2
vf3[rz3[t]] <- vf3[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 4 if la == 5
vf3[rz3[t]] <- vn2[rz3[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf3[rz3[t]] <- vx2[rz3[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf3[rz3[t]] <- vf3[rz3[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf3[rz3[t]] <- vx2[rz3[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf3[rz3[t]] <- vf3[rz3[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v43[rz3[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 6 if vf == 2
vs3[rz3[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 7 if vf == 3
vs3[rz3[t]] <- {vf3[rz3[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 3 if ok3[e] if lat == 7 if vf == 9 if la == 5
vm3[rz3[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 3 if ok3[e] if lat == 8 if vf == 0
vm3[rz3[t]] <- vf2[rz3[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 3 if ok3[e] if lat == 8 if vf == 4 if la == 5
vc3[rz3[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 3 if ok3[e] if lat == 9 if vf == 0

# ══ 層 4 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz4[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz4[q] <- im * vf4[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz4[q] <- im * vn3[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz4[q] <- im * vx3[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz4[q] <- im * vf3[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 3 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn4[rz4[q]] <- vn3[rz4[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx4[rz4[q]] <- vx3[rz4[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo4[rz4[q]] <- vo3[rz4[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va4[rz4[q]] <- va3[rz4[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf4[rz4[q]] <- vf3[rz4[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v44[rz4[q]] <- v43[rz4[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs4[rz4[q]] <- vs3[rz4[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 4）。閉じた面 3 からしか読まない。
ct4[rz4[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 0
ct4[rz4[t]] <- vn3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 1
ct4[rz4[t]] <- vx3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 2
ct4[rz4[t]] <- vo3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 3
ct4[rz4[t]] <- va3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 4
ct4[rz4[t]] <- vf3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 5
ct4[rz4[t]] <- v43[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 6
ct4[rz4[t]] <- vs3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 7
ct4[rz4[t]] <- vm3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 8
ct4[rz4[t]] <- vc3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 9
ct4[rz4[t]] <- vb3[rz4[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 4 if la == 10
ct4[rz4[t]] <- ct4[rz4[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 1 if n == 1
ct4[rz4[t]] <- ct4[rz4[a]] + ct4[rz4[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 1 if n == 2
ct4[rz4[t]] <- ct4[rz4[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 6 if n == 1
ct4[rz4[t]] <- ct4[rz4[a]] * ct4[rz4[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 6 if n == 2
ct4[rz4[t]] <- ct4[rz4[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 7 if n == 1
ct4[rz4[t]] <- ct4[rz4[a]] / ct4[rz4[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 7 if n == 2
ct4[rz4[t]] <- ct4[rz4[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 8 if n == 1
ct4[rz4[t]] <- ct4[rz4[a]] % ct4[rz4[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -5 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc4[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 4
ng4[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 4
ng4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 0 if op == 1 if n == 1 if ct4[rz4[c]] == ct4[rz4[r1]] + w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 1 if op == 1 if n == 0 if vn3[rz4[c]] == w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 1 if op == 1 if n == 1 if vn3[rz4[c]] == vn3[rz4[r1]] + w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 1 if op == 1 if n == 2 if vn3[rz4[c]] == vn3[rz4[r1]] + vn3[rz4[r2]] + w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 1 if op == 3 if n == 0 if vn3[rz4[c]] >= w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 1 if op == 4 if n == 0 if vn3[rz4[c]] <= w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 1 if op == 5 if n == 0 if vn3[rz4[c]] > w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 2 if op == 1 if n == 0 if vx3[rz4[c]] == w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 2 if op == 1 if n == 1 if vx3[rz4[c]] == vx3[rz4[r1]] + w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 2 if op == 2 if n == 0 if vx3[rz4[c]] != w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 2 if op == 3 if n == 0 if vx3[rz4[c]] >= w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 2 if op == 4 if n == 0 if vx3[rz4[c]] <= w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 2 if op == 5 if n == 0 if vx3[rz4[c]] > w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 2 if op == 6 if n == 1 if vx3[rz4[c]] < vx3[rz4[r1]] + w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 5 if op == 1 if n == 0 if vf3[rz4[c]] == w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 5 if op == 2 if n == 0 if vf3[rz4[c]] != w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 5 if op == 3 if n == 0 if vf3[rz4[c]] >= w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 9 if op == 1 if n == 0 if vc3[rz4[c]] == w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 1 if lat == 9 if op == 3 if n == 0 if vc3[rz4[c]] >= w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 2 if lat == 3 if not vo3[rz4[c]]
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 3 if lat == 3 if vo4[rz4[c]]
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 3 if lat == 5 if vf4[rz4[c]]
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 4 if lat == 1 if vn4[rz4[c]] is w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 4 if lat == 5 if vf4[rz4[c]] is w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 4 if lat == 8 if vm4[rz4[c]] is w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 5 if lat == 6 if not v44[rz4[c]]
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 11 if lat == 2 if op == 3 if n == 0 if vx4[rz4[c]] >= w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 11 if lat == 2 if op == 5 if n == 0 if vx4[rz4[c]] > w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 11 if lat == 5 if op == 1 if n == 0 if vf4[rz4[c]] == w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 11 if lat == 5 if op == 2 if n == 0 if vf4[rz4[c]] != w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 11 if lat == 5 if op == 2 if n == 1 if vf4[rz4[c]] != vf4[rz4[r1]] + w
nc4[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 4 if k == 11 if lat == 5 if op == 5 if n == 0 if vf4[rz4[c]] > w
ok4[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 4 if nc4[e] >= ng4[e]
ok4[e] <- ok3[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 4
# 値で決まる座標を番地の面へ写す（層 4）
pa4[pb + t] <- vx3[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa4[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 4 if kd == 0 if lat == 2
pa4[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa4[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 4 if kd == 1
pa4[pb + t] <- mu * pa4[p1 + t] + pa4[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 4 if kd == 2
# ── 多面体の寄与（層 4）。辺一本が空間ひとつを覆う。────────
fq4[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 4
fq4[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 4
fn4[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 4
fn4[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 4 if kk == 2 if lat == 3 if not vo3[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa4[MB[cm] + MU[cm] * t]]
fn4[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 4 if kk == 3 if lat == 3 if vo4[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa4[MB[cm] + MU[cm] * t]]
fn4[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 4 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn4[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 4 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx4[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa4[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo4[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 4 if fn4[e,t] >= fq4[e]
fo4[e,t] <- fo3[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 4
vn4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- vn3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 4
vx4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- vx3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 4
vo4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- vo3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 4
vf4[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- vf3[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 4
v44[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]] <- v43[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa4[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 4
