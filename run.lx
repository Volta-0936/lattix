vs8[rz8[t]] <- {vf8[rz8[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 8 if ok8[e] if lat == 7 if vf == 9 if la == 5
vm8[rz8[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 8 if ok8[e] if lat == 8 if vf == 0
vm8[rz8[t]] <- vf7[rz8[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 8 if ok8[e] if lat == 8 if vf == 4 if la == 5
vc8[rz8[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 8 if ok8[e] if lat == 9 if vf == 0

# ══ 層 9 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz9[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz9[q] <- im * vf9[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz9[q] <- im * vn8[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz9[q] <- im * vx8[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz9[q] <- im * vf8[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 8 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn9[rz9[q]] <- vn8[rz9[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx9[rz9[q]] <- vx8[rz9[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo9[rz9[q]] <- vo8[rz9[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va9[rz9[q]] <- va8[rz9[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf9[rz9[q]] <- vf8[rz9[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v49[rz9[q]] <- v48[rz9[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs9[rz9[q]] <- vs8[rz9[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 9）。閉じた面 8 からしか読まない。
ct9[rz9[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 0
ct9[rz9[t]] <- vn8[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 1
ct9[rz9[t]] <- vx8[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 2
ct9[rz9[t]] <- vo8[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 3
ct9[rz9[t]] <- va8[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 4
ct9[rz9[t]] <- vf8[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 5
ct9[rz9[t]] <- v48[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 6
ct9[rz9[t]] <- vs8[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 7
ct9[rz9[t]] <- vm8[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 8
ct9[rz9[t]] <- vc8[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 9
ct9[rz9[t]] <- vb8[rz9[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 4 if la == 10
ct9[rz9[t]] <- ct9[rz9[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 1 if n == 1
ct9[rz9[t]] <- ct9[rz9[a]] + ct9[rz9[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 1 if n == 2
ct9[rz9[t]] <- ct9[rz9[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 6 if n == 1
ct9[rz9[t]] <- ct9[rz9[a]] * ct9[rz9[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 6 if n == 2
ct9[rz9[t]] <- ct9[rz9[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 7 if n == 1
ct9[rz9[t]] <- ct9[rz9[a]] / ct9[rz9[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 7 if n == 2
ct9[rz9[t]] <- ct9[rz9[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 8 if n == 1
ct9[rz9[t]] <- ct9[rz9[a]] % ct9[rz9[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -10 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc9[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 9
ng9[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 9
ng9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 0 if op == 1 if n == 1 if ct9[rz9[c]] == ct9[rz9[r1]] + w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 1 if op == 1 if n == 0 if vn8[rz9[c]] == w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 1 if op == 1 if n == 1 if vn8[rz9[c]] == vn8[rz9[r1]] + w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 1 if op == 1 if n == 2 if vn8[rz9[c]] == vn8[rz9[r1]] + vn8[rz9[r2]] + w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 1 if op == 3 if n == 0 if vn8[rz9[c]] >= w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 1 if op == 4 if n == 0 if vn8[rz9[c]] <= w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 1 if op == 5 if n == 0 if vn8[rz9[c]] > w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 2 if op == 1 if n == 0 if vx8[rz9[c]] == w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 2 if op == 1 if n == 1 if vx8[rz9[c]] == vx8[rz9[r1]] + w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 2 if op == 2 if n == 0 if vx8[rz9[c]] != w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 2 if op == 3 if n == 0 if vx8[rz9[c]] >= w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 2 if op == 4 if n == 0 if vx8[rz9[c]] <= w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 2 if op == 5 if n == 0 if vx8[rz9[c]] > w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 2 if op == 6 if n == 1 if vx8[rz9[c]] < vx8[rz9[r1]] + w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 5 if op == 1 if n == 0 if vf8[rz9[c]] == w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 5 if op == 2 if n == 0 if vf8[rz9[c]] != w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 5 if op == 3 if n == 0 if vf8[rz9[c]] >= w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 9 if op == 1 if n == 0 if vc8[rz9[c]] == w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 1 if lat == 9 if op == 3 if n == 0 if vc8[rz9[c]] >= w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 2 if lat == 3 if not vo8[rz9[c]]
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 3 if lat == 3 if vo9[rz9[c]]
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 3 if lat == 5 if vf9[rz9[c]]
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 4 if lat == 1 if vn9[rz9[c]] is w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 4 if lat == 5 if vf9[rz9[c]] is w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 4 if lat == 8 if vm9[rz9[c]] is w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 5 if lat == 6 if not v49[rz9[c]]
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 11 if lat == 2 if op == 3 if n == 0 if vx9[rz9[c]] >= w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 11 if lat == 2 if op == 5 if n == 0 if vx9[rz9[c]] > w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 11 if lat == 5 if op == 1 if n == 0 if vf9[rz9[c]] == w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 11 if lat == 5 if op == 2 if n == 0 if vf9[rz9[c]] != w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 11 if lat == 5 if op == 2 if n == 1 if vf9[rz9[c]] != vf9[rz9[r1]] + w
nc9[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 9 if k == 11 if lat == 5 if op == 5 if n == 0 if vf9[rz9[c]] > w
ok9[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 9 if nc9[e] >= ng9[e]
ok9[e] <- ok8[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 9
# 値で決まる座標を番地の面へ写す（層 9）
pa9[pb + t] <- vx8[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa9[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 9 if kd == 0 if lat == 2
pa9[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa9[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 9 if kd == 1
pa9[pb + t] <- mu * pa9[p1 + t] + pa9[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 9 if kd == 2
# ── 多面体の寄与（層 9）。辺一本が空間ひとつを覆う。────────
fq9[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 9
fq9[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 9
fn9[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 9
fn9[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 9 if kk == 2 if lat == 3 if not vo8[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa9[MB[cm] + MU[cm] * t]]
fn9[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 9 if kk == 3 if lat == 3 if vo9[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa9[MB[cm] + MU[cm] * t]]
fn9[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 9 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn9[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 9 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx9[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa9[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo9[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 9 if fn9[e,t] >= fq9[e]
fo9[e,t] <- fo8[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 9
vn9[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa9[MB[dm] + MU[dm] * t]] <- vn8[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa9[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 9
vx9[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa9[MB[dm] + MU[dm] * t]] <- vx8[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa9[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 9
vo9[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa9[MB[dm] + MU[dm] * t]] <- vo8[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa9[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 9
