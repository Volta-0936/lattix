vx15[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa15[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 15 if lat == 2 if vf == 0 if fo15[e,t]
vx15[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]] <- vx15[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa15[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa15[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 15 if lat == 2 if vf == 1 if fo15[e,t] if n == 1
