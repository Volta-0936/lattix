ok13[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 13 if nc13[e] >= ng13[e]
ok13[e] <- ok12[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 13
# 値で決まる座標を番地の面へ写す（層 13）
pa13[pb + t] <- vx12[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa13[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 13 if kd == 0 if lat == 2
pa13[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa13[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 13 if kd == 1
pa13[pb + t] <- mu * pa13[p1 + t] + pa13[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 13 if kd == 2
# ── 多面体の寄与（層 13）。辺一本が空間ひとつを覆う。────────
fq13[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 13
fq13[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 13
fn13[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13
fn13[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 13 if kk == 2 if lat == 3 if not vo12[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa13[MB[cm] + MU[cm] * t]]
fn13[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 13 if kk == 3 if lat == 3 if vo13[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa13[MB[cm] + MU[cm] * t]]
fn13[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 13 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn13[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 13 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx13[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa13[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo13[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if fn13[e,t] >= fq13[e]
fo13[e,t] <- fo12[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 13
vn13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- vn12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 13
vx13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- vx12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 13
vo13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- vo12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 13
vf13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- vf12[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 13
v413[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- v412[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 13
vn13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa13[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if lat == 1 if vf == 0 if fo13[e,t]
vx13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa13[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if lat == 2 if vf == 0 if fo13[e,t]
vx13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- vx13[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa13[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa13[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if lat == 2 if vf == 1 if fo13[e,t] if n == 1
vx13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- vx13[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa13[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if lat == 2 if vf == 4 if fo13[e,t]
vo13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if lat == 3 if vf == 2 if fo13[e,t]
vf13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa13[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if lat == 5 if vf == 0 if fo13[e,t]
vf13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- vf13[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa13[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if lat == 5 if vf == 4 if fo13[e,t]
v413[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if lat == 6 if vf == 2 if fo13[e,t]
v413[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 13 if lat == 6 if vf == 5 if fo13[e,t]
vm13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa13[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa13[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 13 if lat == 8 if vf == 0 if fo13[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn13[rz13[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 1 if vf == 0
vn13[rz13[t]] <- vn13[rz13[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn13[rz13[t]] <- vn13[rz13[a]] + vn13[rz13[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn13[rz13[t]] <- vn13[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 1 if vf == 4 if la == 1
vx13[rz13[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 0
vx13[rz13[t]] <- vx13[rz13[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx13[rz13[t]] <- vx13[rz13[a]] + vx13[rz13[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx13[rz13[t]] <- vn12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 4 if la == 1
vx13[rz13[t]] <- vx13[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 4 if la == 2
vx13[rz13[t]] <- vf12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 4 if la == 5
vx13[rz13[t]] <- vx12[rz13[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx13[rz13[t]] <- vx13[rz13[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx13[rz13[t]] <- vx13[rz13[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx13[rz13[t]] <- vx12[rz13[a]] / vx12[rz13[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx13[rz13[t]] <- vx12[rz13[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx13[rz13[t]] <- vx12[rz13[a]] % vx12[rz13[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo13[rz13[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 3 if vf == 2
vo13[rz13[t]] <- vo13[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 3 if vf == 4 if la == 3
vf13[rz13[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 0
vf13[rz13[t]] <- vx12[rz13[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf13[rz13[t]] <- vf13[rz13[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf13[rz13[t]] <- vf13[rz13[a]] + vf13[rz13[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf13[rz13[t]] <- vx12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 4 if la == -2
vf13[rz13[t]] <- vx12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 4 if la == 2
vf13[rz13[t]] <- vf13[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 4 if la == 5
vf13[rz13[t]] <- vn12[rz13[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf13[rz13[t]] <- vx12[rz13[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf13[rz13[t]] <- vf13[rz13[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf13[rz13[t]] <- vx12[rz13[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf13[rz13[t]] <- vf13[rz13[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v413[rz13[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 6 if vf == 2
vs13[rz13[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 7 if vf == 3
vs13[rz13[t]] <- {vf13[rz13[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 13 if ok13[e] if lat == 7 if vf == 9 if la == 5
vm13[rz13[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 13 if ok13[e] if lat == 8 if vf == 0
vm13[rz13[t]] <- vf12[rz13[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 13 if ok13[e] if lat == 8 if vf == 4 if la == 5
vc13[rz13[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 13 if ok13[e] if lat == 9 if vf == 0

# ══ 層 14 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz14[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz14[q] <- im * vf14[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz14[q] <- im * vn13[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz14[q] <- im * vx13[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz14[q] <- im * vf13[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 13 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn14[rz14[q]] <- vn13[rz14[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx14[rz14[q]] <- vx13[rz14[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo14[rz14[q]] <- vo13[rz14[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va14[rz14[q]] <- va13[rz14[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf14[rz14[q]] <- vf13[rz14[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v414[rz14[q]] <- v413[rz14[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs14[rz14[q]] <- vs13[rz14[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 14）。閉じた面 13 からしか読まない。
ct14[rz14[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 0
ct14[rz14[t]] <- vn13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 1
ct14[rz14[t]] <- vx13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 2
ct14[rz14[t]] <- vo13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 3
ct14[rz14[t]] <- va13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 4
ct14[rz14[t]] <- vf13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 5
ct14[rz14[t]] <- v413[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 6
ct14[rz14[t]] <- vs13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 7
ct14[rz14[t]] <- vm13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 8
ct14[rz14[t]] <- vc13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 9
ct14[rz14[t]] <- vb13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 4 if la == 10
ct14[rz14[t]] <- ct14[rz14[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 1 if n == 1
ct14[rz14[t]] <- ct14[rz14[a]] + ct14[rz14[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 1 if n == 2
ct14[rz14[t]] <- ct14[rz14[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 6 if n == 1
ct14[rz14[t]] <- ct14[rz14[a]] * ct14[rz14[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 6 if n == 2
ct14[rz14[t]] <- ct14[rz14[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 7 if n == 1
ct14[rz14[t]] <- ct14[rz14[a]] / ct14[rz14[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 7 if n == 2
ct14[rz14[t]] <- ct14[rz14[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 8 if n == 1
ct14[rz14[t]] <- ct14[rz14[a]] % ct14[rz14[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -15 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc14[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 14
ng14[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 14
ng14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 0 if op == 1 if n == 1 if ct14[rz14[c]] == ct14[rz14[r1]] + w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 1 if op == 1 if n == 0 if vn13[rz14[c]] == w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 1 if op == 1 if n == 1 if vn13[rz14[c]] == vn13[rz14[r1]] + w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 1 if op == 1 if n == 2 if vn13[rz14[c]] == vn13[rz14[r1]] + vn13[rz14[r2]] + w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 1 if op == 3 if n == 0 if vn13[rz14[c]] >= w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 1 if op == 4 if n == 0 if vn13[rz14[c]] <= w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 1 if op == 5 if n == 0 if vn13[rz14[c]] > w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 2 if op == 1 if n == 0 if vx13[rz14[c]] == w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 2 if op == 1 if n == 1 if vx13[rz14[c]] == vx13[rz14[r1]] + w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 2 if op == 2 if n == 0 if vx13[rz14[c]] != w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 2 if op == 3 if n == 0 if vx13[rz14[c]] >= w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 2 if op == 4 if n == 0 if vx13[rz14[c]] <= w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 2 if op == 5 if n == 0 if vx13[rz14[c]] > w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 2 if op == 6 if n == 1 if vx13[rz14[c]] < vx13[rz14[r1]] + w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 5 if op == 1 if n == 0 if vf13[rz14[c]] == w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 5 if op == 2 if n == 0 if vf13[rz14[c]] != w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 5 if op == 3 if n == 0 if vf13[rz14[c]] >= w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 9 if op == 1 if n == 0 if vc13[rz14[c]] == w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 1 if lat == 9 if op == 3 if n == 0 if vc13[rz14[c]] >= w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 2 if lat == 3 if not vo13[rz14[c]]
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 3 if lat == 3 if vo14[rz14[c]]
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 3 if lat == 5 if vf14[rz14[c]]
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 4 if lat == 1 if vn14[rz14[c]] is w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 4 if lat == 5 if vf14[rz14[c]] is w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 4 if lat == 8 if vm14[rz14[c]] is w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 5 if lat == 6 if not v414[rz14[c]]
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 11 if lat == 2 if op == 3 if n == 0 if vx14[rz14[c]] >= w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 11 if lat == 2 if op == 5 if n == 0 if vx14[rz14[c]] > w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 11 if lat == 5 if op == 1 if n == 0 if vf14[rz14[c]] == w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 11 if lat == 5 if op == 2 if n == 0 if vf14[rz14[c]] != w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 11 if lat == 5 if op == 2 if n == 1 if vf14[rz14[c]] != vf14[rz14[r1]] + w
nc14[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 14 if k == 11 if lat == 5 if op == 5 if n == 0 if vf14[rz14[c]] > w
ok14[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 14 if nc14[e] >= ng14[e]
ok14[e] <- ok13[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 14
# 値で決まる座標を番地の面へ写す（層 14）
pa14[pb + t] <- vx13[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa14[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 14 if kd == 0 if lat == 2
pa14[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa14[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 14 if kd == 1
pa14[pb + t] <- mu * pa14[p1 + t] + pa14[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 14 if kd == 2
# ── 多面体の寄与（層 14）。辺一本が空間ひとつを覆う。────────
fq14[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 14
fq14[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 14
fn14[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14
fn14[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 14 if kk == 2 if lat == 3 if not vo13[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa14[MB[cm] + MU[cm] * t]]
fn14[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 14 if kk == 3 if lat == 3 if vo14[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa14[MB[cm] + MU[cm] * t]]
fn14[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 14 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn14[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 14 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx14[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa14[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo14[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if fn14[e,t] >= fq14[e]
fo14[e,t] <- fo13[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 14
vn14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- vn13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 14
vx14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- vx13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 14
vo14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- vo13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 14
vf14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- vf13[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 14
v414[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- v413[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 14
vn14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa14[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if lat == 1 if vf == 0 if fo14[e,t]
vx14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa14[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if lat == 2 if vf == 0 if fo14[e,t]
vx14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- vx14[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa14[MB[am] + MU[am] * t]] + MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa14[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if lat == 2 if vf == 1 if fo14[e,t] if n == 1
vx14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- vx14[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa14[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if lat == 2 if vf == 4 if fo14[e,t]
vo14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if lat == 3 if vf == 2 if fo14[e,t]
vf14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa14[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if lat == 5 if vf == 0 if fo14[e,t]
vf14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- vf14[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa14[MB[am] + MU[am] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if lat == 5 if vf == 4 if fo14[e,t]
v414[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if lat == 6 if vf == 2 if fo14[e,t]
v414[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- false  for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 14 if lat == 6 if vf == 5 if fo14[e,t]
vm14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa14[MB[dm] + MU[dm] * t]] <- MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]] + MI[wm] * pa14[MB[wm] + MU[wm] * t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st <= 14 if lat == 8 if vf == 0 if fo14[e,t]
# ── 寄与。これが全部である。──────────────────────────────
vn14[rz14[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 1 if vf == 0
vn14[rz14[t]] <- vn14[rz14[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 1 if vf == 1 if n == 1 if la == 1
vn14[rz14[t]] <- vn14[rz14[a]] + vn14[rz14[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 1 if vf == 1 if n == 2 if la == 1
vn14[rz14[t]] <- vn14[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 1 if vf == 4 if la == 1
vx14[rz14[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 0
vx14[rz14[t]] <- vx14[rz14[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 1 if n == 1 if la == 2
vx14[rz14[t]] <- vx14[rz14[a]] + vx14[rz14[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 1 if n == 2 if la == 2
vx14[rz14[t]] <- vn13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 4 if la == 1
vx14[rz14[t]] <- vx14[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 4 if la == 2
vx14[rz14[t]] <- vf13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 4 if la == 5
vx14[rz14[t]] <- vx13[rz14[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 6 if n == 1 if la == -2
vx14[rz14[t]] <- vx14[rz14[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 6 if n == 1 if la == 2
vx14[rz14[t]] <- vx14[rz14[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 7 if n == 1 if la == 2
vx14[rz14[t]] <- vx13[rz14[a]] / vx13[rz14[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 7 if n == 2 if la == -2
vx14[rz14[t]] <- vx13[rz14[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 8 if n == 1 if la == -2
vx14[rz14[t]] <- vx13[rz14[a]] % vx13[rz14[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 2 if vf == 8 if n == 2 if la == -2
vo14[rz14[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 3 if vf == 2
vo14[rz14[t]] <- vo14[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 3 if vf == 4 if la == 3
vf14[rz14[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 0
vf14[rz14[t]] <- vx13[rz14[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 1 if n == 1 if la == 2
vf14[rz14[t]] <- vf14[rz14[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 1 if n == 1 if la == 5
vf14[rz14[t]] <- vf14[rz14[a]] + vf14[rz14[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 1 if n == 2 if la == 5
vf14[rz14[t]] <- vx13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 4 if la == -2
vf14[rz14[t]] <- vx13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 4 if la == 2
vf14[rz14[t]] <- vf14[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 4 if la == 5
vf14[rz14[t]] <- vn13[rz14[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 6 if n == 1 if la == 1
vf14[rz14[t]] <- vx13[rz14[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 6 if n == 1 if la == 2
vf14[rz14[t]] <- vf14[rz14[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 6 if n == 1 if la == 5
vf14[rz14[t]] <- vx13[rz14[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 8 if n == 1 if la == 2
vf14[rz14[t]] <- vf14[rz14[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 5 if vf == 8 if n == 1 if la == 5
v414[rz14[t]] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 6 if vf == 2
vs14[rz14[t]] <- {w}    for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 7 if vf == 3
vs14[rz14[t]] <- {vf14[rz14[a]]}   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st == 14 if ok14[e] if lat == 7 if vf == 9 if la == 5
vm14[rz14[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 14 if ok14[e] if lat == 8 if vf == 0
vm14[rz14[t]] <- vf13[rz14[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 14 if ok14[e] if lat == 8 if vf == 4 if la == 5
vc14[rz14[t]] <- w      for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st <= 14 if ok14[e] if lat == 9 if vf == 0

# ══ 層 15 ═══════════════════════════════════════════
# 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。
rz15[q] <- iz        for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz15[q] <- im * vf15[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == -5
rz15[q] <- im * vn14[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 1
rz15[q] <- im * vx14[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 2
rz15[q] <- im * vf14[ic] + iz   for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 14 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn15[rz15[q]] <- vn14[rz15[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 1
vx15[rz15[q]] <- vx14[rz15[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 2
vo15[rz15[q]] <- vo14[rz15[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 3
va15[rz15[q]] <- va14[rz15[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 4
vf15[rz15[q]] <- vf14[rz15[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 5
v415[rz15[q]] <- v414[rz15[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 6
vs15[rz15[q]] <- vs14[rz15[q]]   for (q,im,ic,il,iz,dl) in ix if dl == 7
# 条件のための項（層 15）。閉じた面 14 からしか読まない。
ct15[rz15[t]] <- w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 0
ct15[rz15[t]] <- vn14[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 1
ct15[rz15[t]] <- vx14[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 2
ct15[rz15[t]] <- vo14[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 3
ct15[rz15[t]] <- va14[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 4
ct15[rz15[t]] <- vf14[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 5
ct15[rz15[t]] <- v414[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 6
ct15[rz15[t]] <- vs14[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 7
ct15[rz15[t]] <- vm14[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 8
ct15[rz15[t]] <- vc14[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 9
ct15[rz15[t]] <- vb14[rz15[a]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 4 if la == 10
ct15[rz15[t]] <- ct15[rz15[a]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 1 if n == 1
ct15[rz15[t]] <- ct15[rz15[a]] + ct15[rz15[b]] + w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 1 if n == 2
ct15[rz15[t]] <- ct15[rz15[a]] * w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 6 if n == 1
ct15[rz15[t]] <- ct15[rz15[a]] * ct15[rz15[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 6 if n == 2
ct15[rz15[t]] <- ct15[rz15[a]] / w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 7 if n == 1
ct15[rz15[t]] <- ct15[rz15[a]] / ct15[rz15[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 7 if n == 2
ct15[rz15[t]] <- ct15[rz15[a]] % w   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 8 if n == 1
ct15[rz15[t]] <- ct15[rz15[a]] % ct15[rz15[b]]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == -16 if vf == 8 if n == 2
# 条件は **数える**。否定にすると、単調な肯定まで輪に入る。
nc15[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 15
ng15[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 15
ng15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 0 if op == 1 if n == 1 if ct15[rz15[c]] == ct15[rz15[r1]] + w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 1 if op == 1 if n == 0 if vn14[rz15[c]] == w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 1 if op == 1 if n == 1 if vn14[rz15[c]] == vn14[rz15[r1]] + w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 1 if op == 1 if n == 2 if vn14[rz15[c]] == vn14[rz15[r1]] + vn14[rz15[r2]] + w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 1 if op == 3 if n == 0 if vn14[rz15[c]] >= w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 1 if op == 4 if n == 0 if vn14[rz15[c]] <= w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 1 if op == 5 if n == 0 if vn14[rz15[c]] > w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 2 if op == 1 if n == 0 if vx14[rz15[c]] == w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 2 if op == 1 if n == 1 if vx14[rz15[c]] == vx14[rz15[r1]] + w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 2 if op == 2 if n == 0 if vx14[rz15[c]] != w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 2 if op == 3 if n == 0 if vx14[rz15[c]] >= w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 2 if op == 4 if n == 0 if vx14[rz15[c]] <= w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 2 if op == 5 if n == 0 if vx14[rz15[c]] > w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 2 if op == 6 if n == 1 if vx14[rz15[c]] < vx14[rz15[r1]] + w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 5 if op == 1 if n == 0 if vf14[rz15[c]] == w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 5 if op == 2 if n == 0 if vf14[rz15[c]] != w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 5 if op == 3 if n == 0 if vf14[rz15[c]] >= w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 9 if op == 1 if n == 0 if vc14[rz15[c]] == w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 1 if lat == 9 if op == 3 if n == 0 if vc14[rz15[c]] >= w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 2 if lat == 3 if not vo14[rz15[c]]
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 3 if lat == 3 if vo15[rz15[c]]
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 3 if lat == 5 if vf15[rz15[c]]
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 4 if lat == 1 if vn15[rz15[c]] is w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 4 if lat == 5 if vf15[rz15[c]] is w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 4 if lat == 8 if vm15[rz15[c]] is w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 5 if lat == 6 if not v415[rz15[c]]
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 11 if lat == 2 if op == 3 if n == 0 if vx15[rz15[c]] >= w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 11 if lat == 2 if op == 5 if n == 0 if vx15[rz15[c]] > w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 11 if lat == 5 if op == 1 if n == 0 if vf15[rz15[c]] == w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 11 if lat == 5 if op == 2 if n == 0 if vf15[rz15[c]] != w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 11 if lat == 5 if op == 2 if n == 1 if vf15[rz15[c]] != vf15[rz15[r1]] + w
nc15[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 15 if k == 11 if lat == 5 if op == 5 if n == 0 if vf15[rz15[c]] > w
ok15[e] <- true   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 15 if nc15[e] >= ng15[e]
ok15[e] <- ok14[e]   for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < 15
# 値で決まる座標を番地の面へ写す（層 15）
pa15[pb + t] <- vx14[MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa15[MB[am] + MU[am] * t]]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 15 if kd == 0 if lat == 2
pa15[pb + t] <- (MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa15[MB[am] + MU[am] * t]) % mo   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 15 if kd == 1
pa15[pb + t] <- mu * pa15[p1 + t] + pa15[p2 + t]   for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= 15 if kd == 2
# ── 多面体の寄与（層 15）。辺一本が空間ひとつを覆う。────────
fq15[e] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg if st == 15
fq15[e] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc if st == 15
fn15[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 15
fn15[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 15 if kk == 2 if lat == 3 if not vo14[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa15[MB[cm] + MU[cm] * t]]
fn15[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 15 if kk == 3 if lat == 3 if vo15[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa15[MB[cm] + MU[cm] * t]]
fn15[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 15 if kk == 6 if lat == 0 if op == 3 if MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] >= MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fn15[e,t] <- true   for (e,sp,st,kk,lat,cm,op,n,r1,r2,wm) in fc for (t) in 0 .. SZ[sp] - 1 if st == 15 if kk == 11 if lat == 2 if op == 5 if n == 0 if vx15[MC[cm] + MK0[cm] * D[SB[sp,MA0[cm]] + (t / SD[sp,MA0[cm]]) % SW[sp,MA0[cm]], ML0[cm]] + MK1[cm] * D[SB[sp,MA1[cm]] + (t / SD[sp,MA1[cm]]) % SW[sp,MA1[cm]], ML1[cm]] + MK2[cm] * D[SB[sp,MA2[cm]] + (t / SD[sp,MA2[cm]]) % SW[sp,MA2[cm]], ML2[cm]] + MI[cm] * pa15[MB[cm] + MU[cm] * t]] > MC[wm] + MK0[wm] * D[SB[sp,MA0[wm]] + (t / SD[sp,MA0[wm]]) % SW[sp,MA0[wm]], ML0[wm]] + MK1[wm] * D[SB[sp,MA1[wm]] + (t / SD[sp,MA1[wm]]) % SW[sp,MA1[wm]], ML1[wm]] + MK2[wm] * D[SB[sp,MA2[wm]] + (t / SD[sp,MA2[wm]]) % SW[sp,MA2[wm]], ML2[wm]]
fo15[e,t] <- true   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st == 15 if fn15[e,t] >= fq15[e]
fo15[e,t] <- fo14[e,t]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st < 15
vn15[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]] <- vn14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 1 if st < 15
vx15[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]] <- vx14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 2 if st < 15
vo15[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]] <- vo14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 3 if st < 15
vf15[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]] <- vf14[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 5 if st < 15
v415[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]] <- v414[MC[dm] + MK0[dm] * D[SB[sp,MA0[dm]] + (t / SD[sp,MA0[dm]]) % SW[sp,MA0[dm]], ML0[dm]] + MK1[dm] * D[SB[sp,MA1[dm]] + (t / SD[sp,MA1[dm]]) % SW[sp,MA1[dm]], ML1[dm]] + MK2[dm] * D[SB[sp,MA2[dm]] + (t / SD[sp,MA2[dm]]) % SW[sp,MA2[dm]], ML2[dm]] + MI[dm] * pa15[MB[dm] + MU[dm] * t]]   for (e,sp,st,lat,vf,n,dm,am,bm,wm) in fg for (t) in 0 .. SZ[sp] - 1 if lat == 6 if st < 15
