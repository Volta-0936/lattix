nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 2 if op == 2 if n == 0 if vx1[rz2[c]] != w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 2 if op == 3 if n == 0 if vx1[rz2[c]] >= w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 2 if op == 4 if n == 0 if vx1[rz2[c]] <= w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 2 if op == 5 if n == 0 if vx1[rz2[c]] > w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 2 if op == 6 if n == 1 if vx1[rz2[c]] < vx1[rz2[r1]] + w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 5 if op == 1 if n == 0 if vf1[rz2[c]] == w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 5 if op == 2 if n == 0 if vf1[rz2[c]] != w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 5 if op == 3 if n == 0 if vf1[rz2[c]] >= w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 9 if op == 1 if n == 0 if vc1[rz2[c]] == w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 1 if lat == 9 if op == 3 if n == 0 if vc1[rz2[c]] >= w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 2 if lat == 3 if not vo1[rz2[c]]
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 3 if lat == 3 if vo2[rz2[c]]
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 3 if lat == 5 if vf2[rz2[c]]
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 4 if lat == 1 if vn2[rz2[c]] is w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 4 if lat == 5 if vf2[rz2[c]] is w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 4 if lat == 8 if vm2[rz2[c]] is w
nc2[e] <- true   for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == 2 if k == 5 if lat == 6 if not v42[rz2[c]]
