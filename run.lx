# ══ run.lx —— 走らせる物。**これ一枚で全部のプログラムが走る** ══
#
#   入れる物: 表 `eg`（寄与の辺）/ `cd`（条件）/ `ix`（升を指す番号）
#   層の上限: 48   升の番号の上限: 437671048959211563（**測った**値）
#     大きいのは、内容アドレスを座標にする場があるからである ——
#     こちらが大きく書いたのではなく、content address がそう宣言している。
#     焼くときは、その場だけが hash 表に落ちる（他は密配列）。
#   辺の上限: 6136   指し番号の上限: 3996
#
#   プログラムごとに変わるのは **表だけ**である。
#   規則の数 353 行は、言語の形の数であって
#   プログラムの大きさではない。

# ══ 走らせる物 —— 寄与の関係を閉じる ════════════════════════════
#  升は番号。場も座標も、もうここには無い。**層も座標である。**

# ── 多面体の道 —— **反復空間を点に潰さずに渡す** ────────────────
#  「宣言されているものを、そのまま機械に渡すには？」（CLAUDE.md）
#  軸の中身は `dat` の行に置いてある（区間も表と同じ形）。
field D : flat bound 1002 6
D[r,c] <- v            for (r,c,v) in dat
field SB : max bound 128 4
SB[sp,j] <- b   for (sp,j,b,w,d) in spc
field SW : max bound 128 4
SW[sp,j] <- w   for (sp,j,b,w,d) in spc
field SD : max bound 128 4
SD[sp,j] <- d   for (sp,j,b,w,d) in spc
field SZ : max bound 128
SZ[sp] <- n            for (sp,n) in ssz
field MC : max bound 32768
MC[x] <- k0            for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MA0 : max bound 32768
MA0[x] <- a0   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field ML0 : max bound 32768
ML0[x] <- l0   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MK0 : max bound 32768
MK0[x] <- m0   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MA1 : max bound 32768
MA1[x] <- a1   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field ML1 : max bound 32768
ML1[x] <- l1   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MK1 : max bound 32768
MK1[x] <- m1   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MA2 : max bound 32768
MA2[x] <- a2   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field ML2 : max bound 32768
ML2[x] <- l2   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MK2 : max bound 32768
MK2[x] <- m2   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MI : max bound 32768
MI[x] <- im   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MB : max bound 32768
MB[x] <- ib   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MU : max bound 32768
MU[x] <- iu   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MI2 : max bound 32768
MI2[x] <- i2   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MB2 : max bound 32768
MB2[x] <- b2   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field MU2 : max bound 32768
MU2[x] <- u2   for (x,k0,a0,l0,m0,a1,l1,m1,a2,l2,m2,im,ib,iu,i2,b2,u2) in mp
field AE1 : flat bound 71454279745205302
field AE2 : flat bound 71454279745205302
AE1[x] <- e1   for (x,e1,e2) in ate
AE2[x] <- e2   for (x,e1,e2) in ate
field vn : min bound 48 437671048959211563
field vx : max bound 48 437671048959211563
field vo : or bound 48 437671048959211563
field va : and bound 48 437671048959211563
field vf : flat bound 48 437671048959211563
field v4 : fourv bound 48 437671048959211563
field vs : set bound 48 437671048959211563
field vm : sum bound 48 437671048959211563
field vc : count bound 48 437671048959211563
field vb : bag bound 48 437671048959211563
field rz : flat bound 48 3996
field nc : count bound 48 6136
field ng : count bound 48 6136
field ok : or bound 48 6136
field ct : flat bound 48 437671048959211563
field pa : flat bound 48 137378
pa[s, 0] <- 0   for (s) in 0 .. 47
field fq : count bound 48 6136
field fn : count bound 48 6136 10368
field fo : or bound 48 6136 10368

# ══ 升を指す番号を解く。m = 0 はそのまま、それ以外は値で決まる升。══
rz[s, q] <- iz        for (s) in 0 .. 47 for (q,im,ic,il,iz,dl) in ix if im == 0
# 内容アドレスは育たない（⊥ → v → ⊤）ので **生きた面**でよい
rz[s, q] <- im * vf[s, ic] + iz   for (s) in 0 .. 47 for (q,im,ic,il,iz,dl) in ix if il == -5
rz[s, q] <- im * vn[s - 1, ic] + iz   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if il == 1
rz[s, q] <- im * vx[s - 1, ic] + iz   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if il == 2
rz[s, q] <- im * vf[s - 1, ic] + iz   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if il == 5
# 閉じた層 s-1 を引き継ぐ（寄与元キー付きの束は引き継がず作り直す）
vn[s, rz[s, q]] <- vn[s - 1, rz[s, q]]   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if dl == 1
vx[s, rz[s, q]] <- vx[s - 1, rz[s, q]]   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if dl == 2
vo[s, rz[s, q]] <- vo[s - 1, rz[s, q]]   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if dl == 3
va[s, rz[s, q]] <- va[s - 1, rz[s, q]]   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if dl == 4
vf[s, rz[s, q]] <- vf[s - 1, rz[s, q]]   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if dl == 5
v4[s, rz[s, q]] <- v4[s - 1, rz[s, q]]   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if dl == 6
vs[s, rz[s, q]] <- vs[s - 1, rz[s, q]]   for (s) in 1 .. 47 for (q,im,ic,il,iz,dl) in ix if dl == 7
# ── 条件のための項。閉じた面 s-1 からしか読まない。────────────
ct[s, rz[s, t]] <- w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 0
ct[s, rz[s, t]] <- vn[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 1
ct[s, rz[s, t]] <- vx[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 2
ct[s, rz[s, t]] <- vo[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 3
ct[s, rz[s, t]] <- va[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 4
ct[s, rz[s, t]] <- vf[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 5
ct[s, rz[s, t]] <- v4[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 6
ct[s, rz[s, t]] <- vs[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 7
ct[s, rz[s, t]] <- vm[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 8
ct[s, rz[s, t]] <- vc[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 9
ct[s, rz[s, t]] <- vb[s - 1, rz[s, a]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 4 if la == 10
ct[s, rz[s, t]] <- ct[s, rz[s, a]] + w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 1 if n == 1
ct[s, rz[s, t]] <- ct[s, rz[s, a]] + ct[s, rz[s, b]] + w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 1 if n == 2
ct[s, rz[s, t]] <- ct[s, rz[s, a]] * w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 6 if n == 1
ct[s, rz[s, t]] <- ct[s, rz[s, a]] * ct[s, rz[s, b]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 6 if n == 2
ct[s, rz[s, t]] <- ct[s, rz[s, a]] / w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 7 if n == 1
ct[s, rz[s, t]] <- ct[s, rz[s, a]] / ct[s, rz[s, b]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 7 if n == 2
ct[s, rz[s, t]] <- ct[s, rz[s, a]] % w   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 8 if n == 1
ct[s, rz[s, t]] <- ct[s, rz[s, a]] % ct[s, rz[s, b]]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == 0 - s - 1 if vf == 8 if n == 2
# ── 条件は **数える**。否定にすると、単調な肯定まで輪に入る。──
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == s
ng[s, e] <- true   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == s
ng[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 1 if op == 5 if n == 0 if vn[s - 1, rz[s, c]] > w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 2 if op == 2 if n == 0 if vx[s - 1, rz[s, c]] != w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 2 if op == 1 if n == 1 if vx[s - 1, rz[s, c]] == vx[s - 1, rz[s, r1]] + w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 2 if op == 4 if n == 0 if vx[s - 1, rz[s, c]] <= w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 1 if op == 1 if n == 2 if vn[s - 1, rz[s, c]] == vn[s - 1, rz[s, r1]] + vn[s - 1, rz[s, r2]] + w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 9 if op == 3 if n == 0 if vc[s - 1, rz[s, c]] >= w
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 4 if lat == 1 if vn[s, rz[s, c]] is w
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 11 if lat == 5 if op == 1 if n == 0 if vf[s, rz[s, c]] == w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 5 if op == 1 if n == 0 if vf[s - 1, rz[s, c]] == w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 5 if op == 3 if n == 0 if vf[s - 1, rz[s, c]] >= w
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 11 if lat == 5 if op == 5 if n == 0 if vf[s, rz[s, c]] > w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 2 if op == 1 if n == 0 if vx[s - 1, rz[s, c]] == w
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 11 if lat == 5 if op == 2 if n == 1 if vf[s, rz[s, c]] != vf[s, rz[s, r1]] + w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 2 if op == 3 if n == 0 if vx[s - 1, rz[s, c]] >= w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 1 if op == 1 if n == 1 if vn[s - 1, rz[s, c]] == vn[s - 1, rz[s, r1]] + w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 1 if op == 4 if n == 0 if vn[s - 1, rz[s, c]] <= w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 0 if op == 1 if n == 1 if ct[s, rz[s, c]] == ct[s, rz[s, r1]] + w
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 3 if lat == 3 if vo[s, rz[s, c]]
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 2 if op == 5 if n == 0 if vx[s - 1, rz[s, c]] > w
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 4 if lat == 5 if vf[s, rz[s, c]] is w
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 4 if lat == 8 if vm[s, rz[s, c]] is w
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 11 if lat == 5 if op == 2 if n == 0 if vf[s, rz[s, c]] != w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 5 if op == 2 if n == 0 if vf[s - 1, rz[s, c]] != w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 1 if op == 3 if n == 0 if vn[s - 1, rz[s, c]] >= w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 1 if op == 1 if n == 0 if vn[s - 1, rz[s, c]] == w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 2 if lat == 3 if not vo[s - 1, rz[s, c]]
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 11 if lat == 2 if op == 5 if n == 0 if vx[s, rz[s, c]] > w
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 5 if lat == 6 if not v4[s, rz[s, c]]
nc[s, e] <- true   for (s) in 0 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 11 if lat == 2 if op == 3 if n == 0 if vx[s, rz[s, c]] >= w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 2 if op == 6 if n == 1 if vx[s - 1, rz[s, c]] < vx[s - 1, rz[s, r1]] + w
nc[s, e] <- true   for (s) in 1 .. 47 for (e,st,k,lat,c,op,n,r1,r2,w) in cd if st == s if k == 1 if lat == 9 if op == 1 if n == 0 if vc[s - 1, rz[s, c]] == w
ok[s, e] <- true   for (s) in 0 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st == s if nc[s, e] >= ng[s, e]
ok[s, e] <- ok[s - 1, e]   for (s) in 1 .. 47 for (e,st,lat,t,vf,n,a,la,b,w) in eg if st >= 0 if st < s
# ── 値で決まる座標を番地の面へ写す。その層までの写しを全部持つ。──
pa[s, pb + t] <- vc[s, MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]]   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 0 if lat == -9
pa[s, pb + t] <- v4[s, MC[am] + MK0[am] * D[SB[sp,MA0[am]] + (t / SD[sp,MA0[am]]) % SW[sp,MA0[am]], ML0[am]] + MK1[am] * D[SB[sp,MA1[am]] + (t / SD[sp,MA1[am]]) % SW[sp,MA1[am]], ML1[am]] + MK2[am] * D[SB[sp,MA2[am]] + (t / SD[sp,MA2[am]]) % SW[sp,MA2[am]], ML2[am]] + MI[am] * pa[s, MB[am] + MU[am] * t] + MI2[am] * pa[s, MB2[am] + MU2[am] * t]]   for (s) in 0 .. 47 for (e,sp,st,kd,lat,pb,am,mo,p1,p2,mu) in fp for (t) in 0 .. SZ[sp] - 1 if st >= 0 if st <= s if kd == 0 if lat == -6
