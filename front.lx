zfpk[zgrul[s, i], i + 56] <- 10 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgvv[s, i] if zgrul[s, i] >= 0
zfplt[zgrul[s, i], i + 56] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgvv[s, i] if zgrul[s, i] >= 0
zfpam[zgrul[s, i], i + 56] <- zgrul[s, i] * 128 + 4 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgvv[s, i] if zgrul[s, i] >= 0
zfpsr[zgrul[s, i], i + 56] <- zfpb[zgrul[s, i], i + 40] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgvv[s, i] if zgrul[s, i] >= 0
      if zfpb[zgrul[s, i], i + 40] >= 1
zfps2[zgrul[s, i], i + 56] <- zfpb[zgrul[s, i], i + 48] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgvv[s, i] if zgrul[s, i] >= 0
      if zfpb[zgrul[s, i], i + 48] >= 1
zmc[zgm2[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgvv[s, i]
zmn[zgm2[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgvv[s, i]
zmia[zgm2[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgvv[s, i]
zmib[zgm2[s, i]] <- zfpb[zgrul[s, i], i + 56] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm2[s, i] >= 1 if zgvv[s, i]
      if zgrul[s, i] >= 0 if zfpb[zgrul[s, i], i + 56] >= 1
zmiu[zgm2[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgvv[s, i]

zfpu[zgrul[s, i], i + 40] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zbf[s, i] if zgrul[s, i] >= 0
zrdq[zgro[s, i]] <- zgrul[s, i] * 128 + i + 32 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zbf[s, i] if zgro[s, i] >= 0 if zgrul[s, i] >= 0
zfplt[zgrul[s, i], i + 40] <- zlatf[zgrfd[s, i]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zbf[s, i] if zgrul[s, i] >= 0 if zgrfd[s, i] >= 0
      if zfws[zgrfd[s, i]] <= zfgst[zgrul[s, i]] - 1
zfplt[zgrul[s, i], i + 40] <- 0 - 5 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zbf[s, i] if zgrul[s, i] >= 0 if zgrfd[s, i] >= 0
      if zlatf[zgrfd[s, i]] == 5
      if zfws[zgrfd[s, i]] >= zfgst[zgrul[s, i]]
zfpam[zgrul[s, i], i + 40] <- zgrul[s, i] * 128 + i + 32 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zbf[s, i] if zgrul[s, i] >= 0
# 右辺の二本目（枠 48+i、写像 58+i）
zfpu[zgrul[s, i], i + 48] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zbf[s, i] if zgrf2[s, i] if zgrul[s, i] >= 0
zrdq[zgro2[s, i]] <- zgrul[s, i] * 128 + i + 40 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zbf[s, i] if zgro2[s, i] >= 0 if zgrul[s, i] >= 0
zfplt[zgrul[s, i], i + 48] <- zlatf[zgrfd2[s, i]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zbf[s, i] if zgrul[s, i] >= 0 if zgrfd2[s, i] >= 0
      if zfws[zgrfd2[s, i]] <= zfgst[zgrul[s, i]] - 1
zfplt[zgrul[s, i], i + 48] <- 0 - 5 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zbf[s, i] if zgrul[s, i] >= 0 if zgrfd2[s, i] >= 0
      if zlatf[zgrfd2[s, i]] == 5
      if zfws[zgrfd2[s, i]] >= zfgst[zgrul[s, i]]
zfpam[zgrul[s, i], i + 48] <- zgrul[s, i] * 128 + i + 40 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zbf[s, i] if zgrf2[s, i] if zgrul[s, i] >= 0
# 種1 の左の cm（間接だけの写像）と右の wm（間接だけの写像）
zmn[zgm[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zbf[s, i]
zmc[zgm[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zbf[s, i]
zmia[zgm[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zbf[s, i]
zmib[zgm[s, i]] <- zfpb[zgrul[s, i], i + 32] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm[s, i] >= 1 if zbf[s, i]
      if zgrul[s, i] >= 0 if zfpb[zgrul[s, i], i + 32] >= 1
zmiu[zgm[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zbf[s, i]
zmc[zgm2[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zbf[s, i] if not zgrhc[s, i]
zmc[zgm2[s, i]] <- zgrst[s, i] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zbf[s, i] if zgrhc[s, i]
zmj0[zgm2[s, i]] <- zvlpz[zgrvt[s, i]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm2[s, i] >= 1 if zbf[s, i] if zgrvt[s, i] >= 0
zmc0[zgm2[s, i]] <- zvcolz[zgrvt[s, i]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm2[s, i] >= 1 if zbf[s, i] if zgrvt[s, i] >= 0
      if lkd[s, zvlpz[zgrvt[s, i]]] == 0
zmc0[zgm2[s, i]] <- 0 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm2[s, i] >= 1 if zbf[s, i] if zgrvt[s, i] >= 0
      if lkd[s, zvlpz[zgrvt[s, i]]] >= 1
zmm0[zgm2[s, i]] <- 1 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm2[s, i] >= 1 if zbf[s, i] if zgrvt[s, i] >= 0
zmia[zgm2[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zbf[s, i]
zmib[zgm2[s, i]] <- zfpb[zgrul[s, i], i + 40] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm2[s, i] >= 1 if zbf[s, i]
      if zgrul[s, i] >= 0 if zfpb[zgrul[s, i], i + 40] >= 1
zmiu[zgm2[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zbf[s, i]
zmia2[zgm2[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zbf[s, i] if zgrf2[s, i]
zmib2[zgm2[s, i]] <- zfpb[zgrul[s, i], i + 48] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm2[s, i] >= 1 if zbf[s, i] if zgrf2[s, i]
      if zgrul[s, i] >= 0 if zfpb[zgrul[s, i], i + 48] >= 1
zmiu2[zgm2[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zbf[s, i] if zgrf2[s, i]

# 左の写像（種6 の左 = 一次式そのもの / 種1 の左 = 間接だけの写像）
field zgm : max bound 4096 8            # 左の写像の枠番号（書く先）
zgm[s, i] <- zgrul[s, i] * 128 + 8 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgt[s, i] >= 0 if zgrul[s, i] >= 0
zmu[zgm[s, i]] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1
zmc[zgm[s, i]] <- tval[zgl[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgl[s, i] >= 0 if isnum[zgl[s, i]]
      if not zgch[s, i] if not zgfl[s, i] if not zgcha[s, i]
      if not zgofm[s, i]
zmc[zgm[s, i]] <- 0 - tval[zgl[s, i]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm[s, i] >= 1 if zgl[s, i] >= 0
      if isnum[zgl[s, i]] if not zgch[s, i] if not zgfl[s, i]
      if not zgcha[s, i] if zgofm[s, i]
zmn[zgm[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgl[s, i] >= 0 if isnum[zgl[s, i]]
      if not zgch[s, i] if not zgfl[s, i] if not zgcha[s, i]
zmc[zgm[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgl[s, i] >= 0 if not isnum[zgl[s, i]]
      if not zgfl[s, i] if not zbxl[s, i] if not zbxr[s, i]
zmn[zgm[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgl[s, i] >= 0 if not isnum[zgl[s, i]]
      if not zglf[s, i] if not zgfl[s, i]
zmj0[zgm[s, i]] <- zvlpz[zgl[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgl[s, i] >= 0 if not isnum[zgl[s, i]]
      if not zglf[s, i] if not zgfl[s, i]
zmc0[zgm[s, i]] <- zvcolz[zgl[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgl[s, i] >= 0 if not isnum[zgl[s, i]]
      if not zglf[s, i] if not zgfl[s, i]
      if lkd[s, zvlpz[zgl[s, i]]] == 0
zmc0[zgm[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgl[s, i] >= 0 if not isnum[zgl[s, i]]
      if not zglf[s, i] if not zgfl[s, i]
      if lkd[s, zvlpz[zgl[s, i]]] >= 1
zmm0[zgm[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgl[s, i] >= 0 if not isnum[zgl[s, i]]
      if not zglf[s, i] if not zgfl[s, i]
# 種1 の左: 定数 0 + 間接 (1, 面の基, 1) —— 閉じた読みのときだけ
zmn[zgm[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zglf[s, i] if not zgrf[s, i] if zfck[s, i] == 1
zmc[zgm[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zglf[s, i] if not zgrf[s, i] if zfck[s, i] == 1
zmia[zgm[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zglf[s, i] if not zgrf[s, i] if zfck[s, i] == 1
zmib[zgm[s, i]] <- zfpb[zgrul[s, i], i + 32] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm[s, i] >= 1 if zglf[s, i] if not zgrf[s, i]
      if zgrul[s, i] >= 0 if zfpb[zgrul[s, i], i + 32] >= 1 if zfck[s, i] == 1
zmiu[zgm[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zglf[s, i] if not zgrf[s, i] if zfck[s, i] == 1

# 右の写像（一次式）
field zgm2 : max bound 4096 8           # 右の写像の枠番号
zgm2[s, i] <- zgrul[s, i] * 128 + 9 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgt[s, i] >= 0 if zgrul[s, i] >= 0
zmu[zgm2[s, i]] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1
# 右辺が定数だけなら符号つきの和（`<= 0 - 1` は −1 —— 負の定数は引き算で書く）
zmc[zgm2[s, i]] <- zgrst[s, i] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if isnum[zgr[s, i]]
      if not zgrf[s, i] if not zgrhv[s, i]
zmc[zgm2[s, i]] <- tval[zgr[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if isnum[zgr[s, i]]
      if zgrf[s, i]
zmc[zgm2[s, i]] <- tval[zgr[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if isnum[zgr[s, i]]
      if zgrhv[s, i]
zmn[zgm2[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if isnum[zgr[s, i]]
# 右辺が 変数 ± 定数（`k - 1`）—— 定数は符号つきの和（zgrst）
zmc[zgm2[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if not isnum[zgr[s, i]]
      if not zgrf[s, i] if not zgrhc[s, i]
zmc[zgm2[s, i]] <- zgrst[s, i] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if not isnum[zgr[s, i]]
      if not zgrf[s, i] if zgrhc[s, i]
zmn[zgm2[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if not isnum[zgr[s, i]]
      if not zgrf[s, i]
zmj0[zgm2[s, i]] <- zvlpz[zgr[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if not isnum[zgr[s, i]]
      if not zgrf[s, i]
zmc0[zgm2[s, i]] <- zvcolz[zgr[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if not isnum[zgr[s, i]]
      if not zgrf[s, i] if lkd[s, zvlpz[zgr[s, i]]] == 0
zmc0[zgm2[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if not isnum[zgr[s, i]]
      if not zgrf[s, i] if lkd[s, zvlpz[zgr[s, i]]] >= 1
zmm0[zgm2[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm2[s, i] >= 1 if zgr[s, i] >= 0 if not isnum[zgr[s, i]]
      if not zgrf[s, i]

# ── or の場の門（肯定 2? 否定…）: gkd 9 = 肯定（種3）/ gkd 2 = 否定（種2）──
field zgpo : max bound 4096 8           # 肯定/否定の読みの出現
zgpo[snum[t], zgn[t]] <- oseq[t] for (t,zc) in ch if isgrd[t]
      if not clcmp[snum[t], cnum[t]]
field zgis : or bound 4096 8            # ガード (s,i) は `is`
zgis[snum[t], zgn[t]] <- true for (t,zc) in ch if zkwis[t]
field zgisn : max bound 4096 8          # is の右辺（数）
zgisn[snum[t], zgn[t]] <- tval[nextw[t]] for (t,zc) in ch if zkwis[t]
      if isnum[nextw[t]]
zgisn[snum[t], zgn[t]] <- zatct[nextw[nextw[t]]] for (t,zc) in ch
      if zkwis[t] if zqt34[nextw[t]]
      if zatct[nextw[nextw[t]]] >= 1
zfck[s, i] <- 3 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgkd[s, i] == 9 if zgpo[s, i] >= 0 if not zgis[s, i]
zfck[s, i] <- 4 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgkd[s, i] == 9 if zgpo[s, i] >= 0 if zgis[s, i]
zfck[s, i] <- 2 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgkd[s, i] == 2 if zgpo[s, i] >= 0
      if zlatf[ofl[zgpo[s, i]] - 1] <= 5
zfck[s, i] <- 5 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgkd[s, i] == 2 if zgpo[s, i] >= 0
      if zlatf[ofl[zgpo[s, i]] - 1] == 6
zfclt[s, i] <- zlatf[ofl[zgpo[s, i]] - 1] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgkd[s, i] >= 2 if zgkd[s, i] <= 2 if zgpo[s, i] >= 0
zfclt[s, i] <- zlatf[ofl[zgpo[s, i]] - 1] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgkd[s, i] == 9 if zgpo[s, i] >= 0
zfcop[s, i] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgkd[s, i] == 9 if zgpo[s, i] >= 0
zfcop[s, i] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgkd[s, i] == 2 if zgpo[s, i] >= 0
field zgr2 : max bound 4096 8           # その規則
zgr2[s, i] <- zrn[s] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgpo[s, i] >= 0 if zrn[s] >= 0
field zgm2b : max bound 4096 8          # その右の写像（9+3i）の番号
zgm2b[s, i] <- zgr2[s, i] * 128 + 9 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgr2[s, i] >= 0
zfcam[s, i] <- zgr2[s, i] * 128 + 8 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgpo[s, i] >= 0 if zgr2[s, i] >= 0
zrdq[zgpo[s, i]] <- zgr2[s, i] * 128 + 8 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgpo[s, i] >= 0 if zgr2[s, i] >= 0
zfcwm[s, i] <- zgr2[s, i] * 128 + 9 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgis[s, i] if zgpo[s, i] >= 0 if zgr2[s, i] >= 0
zmu[zgm2b[s, i]] <- true for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgis[s, i] if zgpo[s, i] >= 0 if zgr2[s, i] >= 0
zmc[zgm2b[s, i]] <- zgisn[s, i] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgis[s, i] if zgpo[s, i] >= 0 if zgr2[s, i] >= 0
      if zgisn[s, i] >= 0

# ── fg の行 ────────────────────────────────────────────────────────
field ztn : max bound 4096              # 文 s の項の数
ztn[snum[t]] <- tcnt[t] + 1 for (t,zc) in ch if istm[t]
field zone1 : or bound 4096             # 値が同じ束の読み一つだけ（vf 4）
zone1[zrn[s]] <- true for (s) in 0 .. nstz[0] if zisr[s] if zrn[s] >= 0
      if ztn[s] == 1 if zns[zrn[s]] == 1
field zfgvf : max bound 4096
# 一元の集合 {v} は vf 3（wm がその元の写像）
field zisbr : or bound 262144           # 一文字の `{`
zisbr[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 123
field zsetv : or bound 4096             # 値が { … }
zsetv[s] <- true for (s) in 0 .. nstz[0] if zisr[s]
      if zisbr[nextw[nextw[arrowt[s]]]]
zfgvf[zrn[s]] <- 3 for (s) in 0 .. nstz[0] if zisr[s] if zsetv[s]
      if zrn[s] >= 0
zfgvf[zrn[s]] <- 2 for (s) in 0 .. nstz[0] if zisr[s] if ztrue[s]
      if zrn[s] >= 0
zfgvf[zrn[s]] <- 5 for (s) in 0 .. nstz[0] if zisr[s] if zfalse[s]
      if zrn[s] >= 0
zfgvf[zrn[s]] <- 1 for (s) in 0 .. nstz[0] if zisr[s] if not ztrue[s]
      if zrn[s] >= 0 if zhasa[zrn[s]] if not zone1[zrn[s]]
zfgvf[zrn[s]] <- 4 for (s) in 0 .. nstz[0] if zisr[s] if not ztrue[s]
      if zrn[s] >= 0 if zone1[zrn[s]]
zfgvf[zrn[s]] <- 0 for (s) in 0 .. nstz[0] if zisr[s] if not ztrue[s]
      if zrn[s] >= 0 if not zhasa[zrn[s]]
zfgvf[r] <- 6 for (r) in 0 .. znrm[0] if zhopp[r]    # 逆向きの生きた読みを引く
field zfgns : max bound 4096
zfgns[r] <- zns[r] for (r) in 0 .. znrm[0] if zns[r] >= 1
zfgns[r] <- 0 for (r) in 0 .. znrm[0] if not zhasa[r]
zfgns[r] <- zns[r] + 1 for (r) in 0 .. znrm[0] if zhopp[r] if zns[r] >= 1
zfgns[r] <- 1 for (r) in 0 .. znrm[0] if zhopp[r]

print zfgst
print zfglat
print zfgvf
print zfgns
print zwm
print zmu
print zmc

# ══ 三枚目 —— 測った広さ ═══════════════════════════════════════════
#
# `bound` の無い場の広さは **測って言う**（気づき35）。測るといっても
# 走らせる必要は無い —— 番地の写像は座標の一次式で、軸の列の下端と上端は
# dat が知っている。だから場の広さは **区間算術の min/max** で出る。
# flat.py の「一巡目で測る」は、実はこの静的な計算だった。

field zfbnd : or bound 1024             # 場 f は bound を宣言している
zfbnd[fdno[t]] <- true for (t,zc) in ch if isdcl[t] if kwbnd[bndt[t]]
field zqspan : max bound 64             # 軸 q の幅 - 1
zqspan[q] <- zqw[q] - 1 for (q) in 0 .. znqm[0] if zqw[q] >= 1
field zqcmin : min bound 64 8           # 軸 q の列 c の最小値
zqcmin[q, c] <- zdat[zqb[q] + i, c] for (q) in 0 .. znqm[0]
      for (i) in 0 .. zqspan[q] for (c) in 0 .. 7 if zqb[q] >= 1
field zqcmax : max bound 64 8           # 軸 q の列 c の最大値
zqcmax[q, c] <- zdat[zqb[q] + i, c] for (q) in 0 .. znqm[0]
      for (i) in 0 .. zqspan[q] for (c) in 0 .. 7 if zqb[q] >= 1

# ── 写像になった出現ぜんぶが、場の広さの証人である ──────────────────
field zmoc : or bound 8192              # 写像になった出現
zmoc[o] <- true for (o) in 0 .. nocz[0] if zrdq[o] >= 0
field zof2 : max bound 8192             # 出現 o の場
zof2[o] <- ofl[o] - 1 for (o) in 0 .. nocz[0] if zmoc[o]
field zoq : max bound 8192 3            # 出現 o の次元 d の軸
zoq[o, d] <- zax[zsr[o], zdj[o, d]] - 1 for (o) in 0 .. nocz[0]
      for (d) in 0 .. 2 if zmoc[o] if zdk[o, d] <= 1
      if zax[zsr[o], zdj[o, d]] >= 1
field zmol : max bound 8192 3           # 出現の座標の下端（次元ごと）
zmol[o, d] <- zdc[o, d] for (o) in 0 .. nocz[0] for (d) in 0 .. 2
      if zmoc[o] if zdk[o, d] == 4
zmol[o, d] <- zqcmin[zoq[o, d], zdc[o, d]] + zdof[o, d]
      for (o) in 0 .. nocz[0] for (d) in 0 .. 2
      if zmoc[o] if zdk[o, d] <= 1 if zoq[o, d] >= 0
field zmoh : max bound 8192 3           # 出現の座標の上端（次元ごと）
zmoh[o, d] <- zdc[o, d] for (o) in 0 .. nocz[0] for (d) in 0 .. 2
      if zmoc[o] if zdk[o, d] == 4
zmoh[o, d] <- zqcmax[zoq[o, d], zdc[o, d]] + zdof[o, d]
      for (o) in 0 .. nocz[0] for (d) in 0 .. 2
      if zmoc[o] if zdk[o, d] <= 1 if zoq[o, d] >= 0
field zextl : min bound 1024 3          # 場 f の次元 d の測った下端
zextl[zof2[o], d] <- zmol[o, d] for (o) in 0 .. nocz[0] for (d) in 0 .. 2
      if zmoc[o] if zof2[o] >= 0
field zexth : max bound 1024 3          # 場 f の次元 d の測った上端
zexth[zof2[o], d] <- zmoh[o, d] for (o) in 0 .. nocz[0] for (d) in 0 .. 2
      if zmoc[o] if zof2[o] >= 0
field zfused : or bound 1024 3          # 次元 d が一度でも写像に出た場
zfused[zof2[o], d] <- true for (o) in 0 .. nocz[0] for (d) in 0 .. 2
      if zmoc[o] if zof2[o] >= 0 if zmoh[o, d] >= zmol[o, d]

# ── 広さと下端（bound があれば宣言、無ければ測った値） ──────────────
field zflo0 : max bound 1024            # 次元0 の下端
zflo0[f] <- 0 - 64 for (f) in 0 .. nfdz[0] if zfbnd[f] if not zexu[f, 0]
zflo0[f] <- zextl[f, 0] for (f) in 0 .. nfdz[0] if not zfbnd[f]
      if zfused[f, 0] if zexth[f, 0] >= zextl[f, 0] if not zexu[f, 0]
zflo0[f] <- 0 for (f) in 0 .. nfdz[0] if not zfbnd[f] if not zfused[f, 0]
      if not zexu[f, 0]
zflo0[f] <- zexl[f, 0] for (f) in 0 .. znf2m[0] if zexu[f, 0]
field zflo1 : max bound 1024            # 次元1 の下端
zflo1[f] <- 0 - 64 for (f) in 0 .. nfdz[0] if zfbnd[f] if not zexu[f, 1]
zflo1[f] <- zextl[f, 1] for (f) in 0 .. nfdz[0] if not zfbnd[f]
      if zfused[f, 1] if zexth[f, 1] >= zextl[f, 1] if not zexu[f, 1]
zflo1[f] <- 0 for (f) in 0 .. nfdz[0] if not zfbnd[f] if not zfused[f, 1]
      if not zexu[f, 1]
zflo1[f] <- zexl[f, 1] for (f) in 0 .. znf2m[0] if zexu[f, 1]
field zflo2 : max bound 1024            # 次元2 の下端
zflo2[f] <- zextl[f, 2] for (f) in 0 .. nfdz[0] if not zfbnd[f]
      if zfused[f, 2] if zexth[f, 2] >= zextl[f, 2]
zflo2[f] <- 0 for (f) in 0 .. nfdz[0] if not zfbnd[f] if not zfused[f, 2]

# ══ 構成子 ═════════════════════════════════════════════════════════
#
# 構成は副作用ではなく寄与である（参照実装の脱糖と同じ）。使用ごとに
# 引数場（nm_引数）と _size への規則が生え、番地は引数の一次式（法 M）——
# Horner の折り込みは環の準同型なので、hash-consing は多面体の算術になる。
# この一枚目: 引数が升の読みだけの形（z_twoctor）。原子・入れ子・一次式は次。

# ── 宣言 ────────────────────────────────────────────────────────────
field zkwcd : or bound 524288           # `constructor` の語
# tch は先頭 8 文字しか持たない（33_self の約束）—— 長さ 11 で頭 8 文字が
# `construc` の語は constructor だけである。
field zkwcd1 : or bound 262144          # `constructor` の前半
zkwcd1[t] <- true for (t,zc) in ch if tlen[t] == 11 if not tcom[t]
      if tch[t,0] == 99 if tch[t,1] == 111 if tch[t,2] == 110
      if tch[t,3] == 115 if tch[t,4] == 116
zkwcd[t] <- true for (t,zc) in ch if zkwcd1[t] if tch[t,5] == 114
      if tch[t,6] == 117 if tch[t,7] == 99
field ziscd : or bound 4096             # 文 s は構成子の宣言
ziscd[snum[t]] <- true for (t,zc) in ch if zkwcd[t] if sbrk[t]
field zcdc : max bound 4096             # 文 s までの宣言の数（s を含む）
zcdc[0] <- 0 for (z) in 0 .. 0 if not ziscd[0]
zcdc[0] <- 1 for (z) in 0 .. 0 if ziscd[0]
zcdc[s] <- zcdc[s-1] for (s) in 1 .. nstz[0] if not ziscd[s]
zcdc[s] <- zcdc[s-1] + 1 for (s) in 1 .. nstz[0] if ziscd[s]
field zcdn : max bound 4096             # 文 s の構成子番号（0 起点）
zcdn[s] <- zcdc[s] - 1 for (s) in 0 .. nstz[0] if ziscd[s]
field zncd : max bound 1                # 構成子の数
zncd[z] <- 0 for (z) in 0 .. 0
zncd[z] <- zcdc[s] for (s) in 0 .. nstz[0] for (z) in 0 .. 0
field zncdm : max bound 1
zncdm[z] <- zncd[z] - 1 for (z) in 0 .. 0
field zcdt : max bound 64               # 構成子 c の名前のトークン
zcdt[zcdn[snum[t]]] <- nextw[t] for (t,zc) in ch if zkwcd[t] if sbrk[t]
      if zcdn[snum[t]] >= 0
field zcar : max bound 64               # 構成子 c の引数の数
zcar[zcdn[snum[t]]] <- colc[t] + 1 for (t,zc) in ch if tkind[t] == 1
      if ziscd[snum[t]] if tdep[t] == 1 if zcdn[snum[t]] >= 0
field zcat : max bound 64 8             # 構成子 c の引数 k の名前のトークン
zcat[zcdn[snum[t]], colc[t]] <- t for (t,zc) in ch if tkind[t] == 1
      if ziscd[snum[t]] if tdep[t] == 1 if zcdn[snum[t]] >= 0

# ── 名前の鍵（使用と宣言を突き合わせる） ────────────────────────────
zisnm[zcdt[c]] <- true for (c) in 0 .. zncdm[0] if zcdt[c] >= 0
field zcnk : max bound 64               # 構成子 c の名前の鍵
zcnk[c] <- ztnk[zcdt[c]] for (c) in 0 .. zncdm[0] if zcdt[c] >= 0
      if ztnk[zcdt[c]] >= 1
field zcnk2 : max bound 64              # 二本目（全文字の折り込み）
zcnk2[c] <- ztnk2[zcdt[c]] for (c) in 0 .. zncdm[0] if zcdt[c] >= 0
      if ztnk2[zcdt[c]] >= 0

# ── 使用（値の位置の呼び出し。**深さも座標である** —— 入れ子も同じ形） ──
field zcut : or bound 262144            # 使用の名前のトークン
zisnm[t] <- true for (t,zc) in ch if tkind[t] == 1 if not isnum[t]
      if isopn[nextw[t]] if cnum[t] == 0 if t >= arrowt[snum[t]] + 1
      if isrec[snum[t]]
zisnm[t] <- true for (t,zc) in ch if tkind[t] == 1 if not isnum[t]
      if isopn[nextw[t]] if cnum[t] == 0 if t >= arrowt[snum[t]] + 1
      if isseed[snum[t]]
zcut[t] <- true for (t,zc) in ch for (c) in 0 .. zncdm[0] if tkind[t] == 1
      if not isnum[t] if isopn[nextw[t]] if cnum[t] == 0
      if t >= arrowt[snum[t]] + 1
      if ztnk[t] >= 1 if ztnk[t] == zcnk[c]
      if ztnk2[t] == zcnk2[c]
field zcuc : max bound 262144           # 使用 → 構成子番号
zcuc[t] <- c for (t,zc) in ch for (c) in 0 .. zncdm[0] if zcut[t]
      if ztnk[t] == zcnk[c] if ztnk2[t] == zcnk2[c]
field zucc : max bound 262144           # 使用の通し番号（鎖）
zucc[0] <- 0 for (z) in 0 .. 0 if not zcut[0]
zucc[0] <- 1 for (z) in 0 .. 0 if zcut[0]
zucc[t] <- zucc[t-1] for (t,zc) in ch if t >= 1 if not zcut[t]
zucc[t] <- zucc[t-1] + 1 for (t,zc) in ch if t >= 1 if zcut[t]
field znuse : max bound 1               # 使用の数
znuse[z] <- 0 for (z) in 0 .. 0
znuse[z] <- zucc[t] for (t,zc) in ch for (z) in 0 .. 0
field znusem : max bound 1
znusem[z] <- znuse[z] - 1 for (z) in 0 .. 0
field zut : max bound 4096              # 使用 u → 名前のトークン
zut[zucc[t] - 1] <- t for (t,zc) in ch if zcut[t] if zucc[t] >= 1
field zuc : max bound 4096              # 使用 u → 構成子
zuc[u] <- zcuc[zut[u]] for (u) in 0 .. znusem[0] if zut[u] >= 0
field zus : max bound 4096              # 使用 u → 文
zus[u] <- snum[zut[u]] for (u) in 0 .. znusem[0] if zut[u] >= 0
field zur : max bound 4096              # 使用 u → host の規則
zur[u] <- zrn[zus[u]] for (u) in 0 .. znusem[0] if zus[u] >= 0
      if zrn[zus[u]] >= 0

# ── 使用の引数（深さごとのコンマで割る。colc は線形にしか数えない ——
#     深さ d のコンマだけを数える列が要る。深さは座標である）────────
field zacd : max bound 262144 16        # 深さ d のコンマの数（開きで 0 に戻る）
zacd[t, d] <- 0 for (t,zc) in ch for (d) in 0 .. 15 if isopn[t]
      if tdep[t] == d - 1
zacd[t, d] <- zacd[t-1, d] + 1 for (t,zc) in ch for (d) in 0 .. 15
      if t >= 1 if iscom[t] if tdep[t] == d
zacd[t, d] <- zacd[t-1, d] for (t,zc) in ch for (d) in 0 .. 15
      if t >= 1 if not isopn[t] if not iscom[t]
zacd[t, d] <- zacd[t-1, d] for (t,zc) in ch for (d) in 0 .. 15
      if t >= 1 if isopn[t] if tdep[t] != d - 1
zacd[t, d] <- zacd[t-1, d] for (t,zc) in ch for (d) in 0 .. 15
      if t >= 1 if iscom[t] if tdep[t] != d
zacd[0, d] <- 0 for (d) in 0 .. 15
field zclch : max bound 262144          # 開きの文字 → 閉じの文字（match の逆）
zclch[match[i]] <- i for (i,c) in ch if clo[i] if match[i] >= 0
field zucl : max bound 4096             # 使用の閉じ括弧のトークン
zucl[zucc[t] - 1] <- tnum[zclch[tstart[nextw[t]]]] for (t,zc) in ch
      if zcut[t] if zucc[t] >= 1 if zclch[tstart[nextw[t]]] >= 1
field zuao : max bound 4096 8           # 使用 u の引数 k の出現（読みのとき）
# 読みの引数の写像は host の枠に建てる —— この一枚目は深さ0 の使用だけ
# （入れ子の読みの引数は次の一枚。定数と入れ子の定数は深さを問わない）。
# 囲む使用は **括弧の相手で引く**（ch × ch の総当たりは要らない）: t の深さの
# 直近の開き（opos —— 深さは座標）のトークンの前の語が、t を直に囲む使用。
field zenu : max bound 262144           # トークン t を直に囲む括弧の前の語
zenu[t] <- prevw[tnum[opos[tstart[t], tdep[t]]]] for (t,zc) in ch
      if tlen[t] >= 1 if tdep[t] >= 1 if opos[tstart[t], tdep[t]] >= 0
zuao[zucc[zenu[t]] - 1, zacd[t, tdep[t]]] <- oseq[t] for (t,zc) in ch
      if isocc[t] if tdep[t] >= 1 if zenu[t] >= 0 if zcut[zenu[t]]
      if zucc[zenu[t]] >= 1
field zuat : min bound 4096 8           # 引数 k の最初の中身のトークン
zuat[zucc[zenu[t]] - 1, zacd[t, tdep[t]]] <- t for (t,zc) in ch
      if tkind[t] == 1 if tdep[t] >= 1 if zenu[t] >= 0 if zcut[zenu[t]]
      if zucc[zenu[t]] >= 1
field zuak : max bound 4096 8           # 引数 k の種（0 列 / 1 計数器 / 4 定数 / 7 読み）
zuak[u, k] <- 7 for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuao[u, k] >= 0
zuak[u, k] <- 4 for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuat[u, k] >= 0 if isnum[zuat[u, k]]
zuak[u, k] <- 0 for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuat[u, k] >= 0 if not isnum[zuat[u, k]]
      if not isocc[zuat[u, k]] if lkd[zus[u], zvlpz[zuat[u, k]]] == 0
zuak[u, k] <- 1 for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuat[u, k] >= 0 if not isnum[zuat[u, k]]
      if not isocc[zuat[u, k]] if lkd[zus[u], zvlpz[zuat[u, k]]] >= 1
zuak[u, k] <- 9 for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuat[u, k] >= 0 if zcut[zuat[u, k]]
field zuau : max bound 4096 8           # 入れ子の引数の使用番号（種9）
zuau[u, k] <- zucc[zuat[u, k]] - 1 for (u) in 0 .. znusem[0]
      for (k) in 0 .. 7 if zuak[u, k] == 9 if zuat[u, k] >= 0
      if zucc[zuat[u, k]] >= 1
# 引数が「読み·定数 + 読み」（tcc[..]*256 + tc2[..]）—— 種10。
# 値は二本の pa を fp 種7 で畳む（μ = 係数、ν = 1）。
field zua1c : max bound 4096 8          # 一本目の読みの閉じ括弧
zua1c[u, k] <- tnum[zclch[tstart[nextw[zuat[u, k]]]]] for (u) in 0 .. znusem[0]
      for (k) in 0 .. 7 if zuat[u, k] >= 0 if isocc[zuat[u, k]]
      if zclch[tstart[nextw[zuat[u, k]]]] >= 1
field zua10 : or bound 4096 8           # その形か
zua10[u, k] <- true for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zua1c[u, k] >= 0 if isstar[nextw[zua1c[u, k]]]
      if isnum[nextw[nextw[zua1c[u, k]]]]
      if isplus[nextw[nextw[nextw[zua1c[u, k]]]]]
      if isocc[nextw[nextw[nextw[nextw[zua1c[u, k]]]]]]
zuak[u, k] <- 10 for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zua10[u, k]
field zuamu : max bound 4096 8          # 係数（μ）
zuamu[u, k] <- tval[nextw[nextw[zua1c[u, k]]]] for (u) in 0 .. znusem[0]
      for (k) in 0 .. 7 if zua10[u, k]
field zua1o : max bound 4096 8          # 一本目の読みの出現
zua1o[u, k] <- oseq[zuat[u, k]] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zua10[u, k]
field zua2o : max bound 4096 8          # 二本目の読みの出現
zua2o[u, k] <- oseq[nextw[nextw[nextw[nextw[zua1c[u, k]]]]]]
      for (u) in 0 .. znusem[0] for (k) in 0 .. 7 if zua10[u, k]
field zuav : max bound 4096 8           # 定数の引数の値
zuav[u, k] <- tval[zuat[u, k]] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 4 if zuat[u, k] >= 0
field zuaj : max bound 4096 8           # 変数の引数の for 節
zuaj[u, k] <- zvlpz[zuat[u, k]] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] <= 1 if zuat[u, k] >= 0
zuaj[u, k] <- zvlpz[zuat[u, k]] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 8 if zuat[u, k] >= 0
field zuacl : max bound 4096 8          # 変数の引数の列（計数器は 0）
zuacl[u, k] <- zvcolz[zuat[u, k]] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 0 if zuat[u, k] >= 0
zuacl[u, k] <- zvcolz[zuat[u, k]] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 8 if zuat[u, k] >= 0
zuacl[u, k] <- 0 for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 1

# ── 合成の場: _size と 引数場（nm_引数） ────────────────────────────
# 番号: 宣言された場の後ろに _size、続いて構成子の宣言順に引数場。
field zhuse : or bound 1                # 構成子が使われている
zhuse[z] <- true for (z) in 0 .. 0 if znuse[z] >= 1
field znf0 : max bound 1                # 宣言された場の数
znf0[z] <- nfdz[z] + 1 for (z) in 0 .. 0
field zszf : max bound 1                # _size の場番号
zszf[z] <- znf0[z] for (z) in 0 .. 0 if zhuse[z]
field zcab : max bound 64               # 構成子 c の引数場の基（前置きの鎖）
zcab[0] <- znf0[z] + 1 for (z) in 0 .. 0 if zhuse[z]
zcab[c] <- zcab[c-1] + zcar[c-1] for (c) in 1 .. zncdm[0]
field zafn : max bound 64 8             # 構成子 c の引数 k の場番号
zafn[c, k] <- zcab[c] + k for (c) in 0 .. zncdm[0] for (k) in 0 .. 7
      if zcab[c] >= 1 if k <= zcar[c] - 1
field znf2 : max bound 1                # 場の数ぜんぶ
znf2[z] <- znf0[z] for (z) in 0 .. 0 if not zhuse[z]
znf2[z] <- zcab[c] + zcar[c] for (c) in 0 .. zncdm[0] for (z) in 0 .. 0
      if zhuse[z] if zcab[c] >= 1
field znf2m : max bound 1
znf2m[z] <- znf2[z] - 1 for (z) in 0 .. 0

# 名前の鍵: nm_引数 の綴りを二本の鍵に畳む（場の置き場は辞書順のまま）
field zanp : max bound 64 8             # 引数場の綴りの位置 p の文字
field zaky : max bound 1024 24          # 引数場 f の鍵の鎖（f は場番号）
field zanl : max bound 64 8             # 引数場 (c,k) の綴りの長さ
zanl[c, k] <- tlen[zcdt[c]] + 1 + tlen[zcat[c, k]] for (c) in 0 .. zncdm[0]
      for (k) in 0 .. 7 if zcdt[c] >= 0 if zcat[c, k] >= 0
field zach : max bound 1024 24          # 引数場 f の位置 p の文字
zach[zafn[c, k], p] <- tch[zcdt[c], p] for (c) in 0 .. zncdm[0]
      for (k) in 0 .. 7 for (p) in 0 .. 7 if zafn[c, k] >= 1
      if zcdt[c] >= 0 if p <= tlen[zcdt[c]] - 1
zach[zafn[c, k], p] <- 95 for (c) in 0 .. zncdm[0] for (k) in 0 .. 7
      for (p) in 0 .. 23 if zafn[c, k] >= 1 if zcdt[c] >= 0
      if p == tlen[zcdt[c]]
field zchp : max bound 262144 24        # トークンの p 文字目（24 まで。ch から）
zchp[tnum[i], cpos[i]] <- c for (i,c) in ch if cpos[i] <= 23
zach[zafn[c, k], p] <- zchp[zcdt[c], p] for (c) in 0 .. zncdm[0]
      for (k) in 0 .. 7 for (p) in 8 .. 23 if zafn[c, k] >= 1
      if zcdt[c] >= 0 if p <= tlen[zcdt[c]] - 1
zach[zafn[c, k], p] <- zchp[zcat[c, k], p - tlen[zcdt[c]] - 1]
      for (c) in 0 .. zncdm[0] for (k) in 0 .. 7 for (p) in 0 .. 23
      if zafn[c, k] >= 1 if zcdt[c] >= 0 if zcat[c, k] >= 0
      if p >= tlen[zcdt[c]] + 1
      if p <= tlen[zcdt[c]] + tlen[zcat[c, k]]
zach[zafn[c, k], p] <- 0 for (c) in 0 .. zncdm[0] for (k) in 0 .. 7
      for (p) in 0 .. 23 if zafn[c, k] >= 1 if zanl[c, k] >= 1
      if p >= zanl[c, k]
zaky[f, 0] <- zach[f, 0] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1
zaky[f, p] <- zaky[f, p-1] * 128 + zach[f, p] for (f) in 0 .. znf2m[0]
      for (p) in 1 .. 7 for (z) in 0 .. 0 if f >= znf0[z] + 1
zaky[f, 8] <- zach[f, 8] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1
zaky[f, p] <- zaky[f, p-1] * 128 + zach[f, p] for (f) in 0 .. znf2m[0]
      for (p) in 9 .. 15 for (z) in 0 .. 0 if f >= znf0[z] + 1
zaky[f, 16] <- zach[f, 16] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1
zaky[f, p] <- zaky[f, p-1] * 128 + zach[f, p] for (f) in 0 .. znf2m[0]
      for (p) in 17 .. 23 for (z) in 0 .. 0 if f >= znf0[z] + 1

# ── 合成の場の **読み**（25_eval: `cons_head[efref_args[..]]`, `_size[..]`）──
# 宣言が無いので 33_self の ofl は行き当たらない。出現の鍵（okey/okey2:
# 綴りの長さぶんだけ詰めた鍵）を引数場の綴りから同じ形で作り、ofl を継ぐ。
field zafl : max bound 1024             # 引数場 f の綴りの長さ
zafl[zafn[c, k]] <- zanl[c, k] for (c) in 0 .. zncdm[0] for (k) in 0 .. 7
      if zafn[c, k] >= 1 if zanl[c, k] >= 1
field zaok : max bound 1024             # 引数場 f の鍵（1〜8 文字目。okey と同形）
zaok[f] <- zaky[f, zafl[f] - 1] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1 if zafl[f] >= 1 if zafl[f] <= 8
zaok[f] <- zaky[f, 7] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1 if zafl[f] >= 9
field zaok2 : max bound 1024            # 引数場 f の鍵（9〜16 文字目。無ければ 0）
zaok2[f] <- 0 for (f) in 0 .. znf2m[0] for (z) in 0 .. 0 if f >= znf0[z] + 1
zaok2[f] <- zaky[f, zafl[f] - 1] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1 if zafl[f] >= 9 if zafl[f] <= 16
zaok2[f] <- zaky[f, 15] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1 if zafl[f] >= 17
ofl[o] <- f + 1 for (o) in 0 .. nocz[0] for (f) in 0 .. znf2m[0]
      for (z) in 0 .. 0 if oin[o] if f >= znf0[z] + 1
      if okey[o] == zaok[f] if okey2[o] == zaok2[f]
ofl[o] <- zszf[z] + 1 for (o) in 0 .. nocz[0] for (z) in 0 .. 0 if oin[o]
      if zhuse[z] if okey[o] == 25744276837 if okey2[o] == 0

# ── 全部の場の鍵（宣言された場・_size・引数場を一枚に） ─────────────
field zfk1 : max bound 1024             # 鍵（1〜8 文字）
zfk1[f] <- zfky[f] for (f) in 0 .. nfdz[0]
zfk1[zszf[z]] <- 53989661657268224 for (z) in 0 .. 0 if zhuse[z]
zfk1[f] <- zaky[f, 7] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1
field zfk2 : max bound 1024             # 鍵（9〜16 文字）
zfk2[f] <- dkey2[f+1] for (f) in 0 .. nfdz[0]
zfk2[zszf[z]] <- 0 for (z) in 0 .. 0 if zhuse[z]
zfk2[f] <- zaky[f, 15] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1
field zfk3 : max bound 1024             # 鍵（17〜24 文字）
zfk3[f] <- 0 for (f) in 0 .. nfdz[0]
zfk3[zszf[z]] <- 0 for (z) in 0 .. 0 if zhuse[z]
zfk3[f] <- zaky[f, 23] for (f) in 0 .. znf2m[0] for (z) in 0 .. 0
      if f >= znf0[z] + 1

# ── 測った広さの口（走らせた側が寄越す。合成の場はここが言う） ───────
table ext = (0, 0, 0, 0)
field zexl : max bound 1024 2           # 場 f の次元 d の下端
zexl[f, d] <- lo for (f, d, lo, w) in ext if f <= 1021
field zexw : max bound 1024 3           # 幅
zexw[f, d] <- w for (f, d, lo, w) in ext if f <= 1021
field zexu : or bound 1024 3            # 口が言っている
zexu[f, d] <- true for (f, d, lo, w) in ext if w >= 1 if f <= 1021

# ── 合成の規則（使用ごと: 引数場 ×n・_size ×(n+1)） ─────────────────
field zucar : max bound 4096            # 使用 u の引数の数
zucar[u] <- zcar[zuc[u]] for (u) in 0 .. znusem[0] if zuc[u] >= 0
field zsyc : max bound 4096             # 使用 u より前の合成規則の数（鎖）
zsyc[0] <- 0
zsyc[u] <- zsyc[u-1] + zucar[u-1] * 2 + 1 for (u) in 1 .. znusem[0]
field zsyb : max bound 4096             # 使用 u の合成規則の基
zsyb[u] <- znr[z] + zsyc[u] for (u) in 0 .. znusem[0] for (z) in 0 .. 0
      if zsyc[u] >= 0
field znr2 : max bound 1                # 規則の数（合成込み）
znr2[z] <- znr[z] for (z) in 0 .. 0 if not zhuse[z]
znr2[z] <- zsyb[u] + zucar[u] * 2 + 1 for (u) in 0 .. znusem[0]
      for (z) in 0 .. 0 if zsyb[u] >= 1
field znr2m : max bound 1
znr2m[z] <- znr2[z] - 1 for (z) in 0 .. 0

# 合成規則の家の行の骨格: 空間・層・束は host から
field zsyrr : max bound 4096            # 合成規則 → host の規則
zsyrr[zsyb[u] + j] <- zur[u] for (u) in 0 .. znusem[0] for (j) in 0 .. 16
      if zsyb[u] >= 1 if zur[u] >= 0 if j <= zucar[u] * 2
field zsyru : max bound 4096            # 合成規則 → 使用
zsyru[zsyb[u] + j] <- u for (u) in 0 .. znusem[0] for (j) in 0 .. 16
      if zsyb[u] >= 1 if j <= zucar[u] * 2
field zsyj : max bound 4096             # 合成規則 → 塊の中の番号
zsyj[zsyb[u] + j] <- j for (u) in 0 .. znusem[0] for (j) in 0 .. 16
      if zsyb[u] >= 1 if j <= zucar[u] * 2
zspof[r] <- zspof[zsyrr[r]] for (r) in 0 .. znr2m[0] if zsyrr[r] >= 0
      if zspof[zsyrr[r]] >= 0
zfgst[r] <- zfgst[zsyrr[r]] for (r) in 0 .. znr2m[0] if zsyrr[r] >= 0
      if zfgst[zsyrr[r]] >= 0 if zuhrd[zsyru[r]]
zfgst[r] <- zlevg[zus[zsyru[r]]] for (r) in 0 .. znr2m[0] if zsyrr[r] >= 0
      if not zuhrd[zsyru[r]] if zlevg[zus[zsyru[r]]] >= 0
zsszr[r] <- zssz[zspof[r]] for (r) in 0 .. znr2m[0] if zsyrr[r] >= 0
      if zspof[r] >= 0
# 書き先: j < n は引数場、j >= n は _size
field zsyf : max bound 4096             # 合成規則の書き先の場
zsyf[r] <- zafn[zuc[zsyru[r]], zsyj[r]] for (r) in 0 .. znr2m[0]
      if zsyru[r] >= 0 if zsyj[r] <= zucar[zsyru[r]] - 1
      if zuc[zsyru[r]] >= 0
zsyf[r] <- zszf[z] for (r) in 0 .. znr2m[0] for (z) in 0 .. 0
      if zsyru[r] >= 0 if zsyj[r] >= zucar[zsyru[r]]
zfglat[r] <- zlatf[zsyf[r]] for (r) in 0 .. znr2m[0] if zsyf[r] >= 1
# _size を読む合成規則は、_size のどの書き手よりも下に居られない ——
# 単調な読みの辺は層を運ぶ（SCC の持ち上げ。書く層の最大まで昇る）。
field zszmx : max bound 1               # _size の書き手の層の最大
zszmx[z] <- zfgst[zur[u]] for (u) in 0 .. znusem[0] for (z) in 0 .. 0
      if zur[u] >= 0 if zfgst[zur[u]] >= 0
zfgst[r] <- zszmx[z] for (r) in 0 .. znr2m[0] for (z) in 0 .. 0
      if zissy[r] if zsyj[r] >= zucar[zsyru[r]] + 1 if zszmx[z] >= 0
zfws[zsyf[r]] <- zfgst[r] for (r) in 0 .. znr2m[0] if zsyf[r] >= 1
      if zfgst[r] >= 0

# ── 折り込みの定数（Horner、法 M1 / M2） ────────────────────────────
field zpwa : flat bound 16              # K1^e % M1（鎖は flat）
zpwa[0] <- 1
zpwa[e] <- zpwa[e-1] * 1000003 % 268435399 for (e) in 1 .. 9
field zpwb : flat bound 16              # K2^e % M2（鎖は flat）
zpwb[0] <- 1
zpwb[e] <- zpwb[e-1] * 1000033 % 268435367 for (e) in 1 .. 9
field zcf1 : flat bound 64 24           # 名前の折り込みの鎖（M1。鎖は flat）
zcf1[c, 0] <- (zchp[zcdt[c], 0] + 1) % 268435399 for (c) in 0 .. zncdm[0]
      if zcdt[c] >= 0
zcf1[c, p] <- (zcf1[c, p-1] * 1000003 + zchp[zcdt[c], p] + 1) % 268435399
      for (c) in 0 .. zncdm[0] for (p) in 1 .. 23 if zcdt[c] >= 0
      if p <= tlen[zcdt[c]] - 1
field zcf2 : flat bound 64 24           # 名前の折り込みの鎖（M2。鎖は flat）
zcf2[c, 0] <- (zchp[zcdt[c], 0] + 1) % 268435367 for (c) in 0 .. zncdm[0]
      if zcdt[c] >= 0
zcf2[c, p] <- (zcf2[c, p-1] * 1000033 + zchp[zcdt[c], p] + 1) % 268435367
      for (c) in 0 .. zncdm[0] for (p) in 1 .. 23 if zcdt[c] >= 0
      if p <= tlen[zcdt[c]] - 1
field zcc1 : max bound 64               # 構成子 c の定数（M1）
zcc1[c] <- ((zcf1[c, tlen[zcdt[c]] - 1] * 1000003 + zcar[c] + 1) % 268435399) * zpwa[zcar[c]] % 268435399 for (c) in 0 .. zncdm[0] if zcdt[c] >= 0 if zcar[c] >= 1
field zcc2 : max bound 64               # 構成子 c の定数（M2）
zcc2[c] <- ((zcf2[c, tlen[zcdt[c]] - 1] * 1000033 + zcar[c] + 1) % 268435367) * zpwb[zcar[c]] % 268435367 for (c) in 0 .. zncdm[0] if zcdt[c] >= 0 if zcar[c] >= 1
field zqco1 : max bound 64 8            # 引数 i の係数 3·K1^(n-1-i) % M1
zqco1[c, i] <- zpwa[zcar[c] - 1 - i] * 3 % 268435399 for (c) in 0 .. zncdm[0]
      for (i) in 0 .. 7 if zcar[c] >= 1 if i <= zcar[c] - 1
field zqco2 : max bound 64 8            # 引数 i の係数 3·K2^(n-1-i) % M2
zqco2[c, i] <- zpwb[zcar[c] - 1 - i] * 3 % 268435367 for (c) in 0 .. zncdm[0]
      for (i) in 0 .. 7 if zcar[c] >= 1 if i <= zcar[c] - 1

# 枠は表で引く（3 本目は空いている番号へ —— 場合分けを作らない）
field zuca : max bound 8              # 引数 k の写しの枠
zuca[0] <- 16
zuca[1] <- 17
zuca[2] <- 26
field zum1 : max bound 8              # 引数 k の法 M1 / AE1 の枠
zum1[0] <- 18
zum1[1] <- 19
zum1[2] <- 28
field zum2 : max bound 8              # 引数 k の法 M2 / AE2 の枠
zum2[0] <- 21
zum2[1] <- 22
zum2[2] <- 29
field zuam : max bound 8              # 引数 k の読みの写像の番号（+r·64）
zuam[0] <- 64
zuam[1] <- 65
zuam[2] <- 66
field zuae : max bound 8              # 引数 k の番号の写像の番号（+r·64）
zuae[0] <- 72
zuae[1] <- 73
zuae[2] <- 74
# ── 番地の鎖を張る（構成子を持つ規則ごと。この一枚目: 引数は読みだけ）──
# 枠: 16+k 引数の写し / 18+k 法 M1 / 20 M1 の一次式 / 21+k 法 M2 /
#     23 M2 の一次式 / 24 対（番地）/ 25 _size の読みの座標
field zcrr : or bound 4096              # 規則 r は鎖を張る（host か合成）
zcrr[zur[u]] <- true for (u) in 0 .. znusem[0] if zur[u] >= 0
      if tdep[zut[u]] == 0
zcrr[r] <- true for (r) in 0 .. znr2m[0] if zsyru[r] >= 0
field zcru : max bound 4096             # その規則の使用
zcru[zur[u]] <- u for (u) in 0 .. znusem[0] if zur[u] >= 0
      if tdep[zut[u]] == 0
zcru[r] <- zsyru[r] for (r) in 0 .. znr2m[0] if zsyru[r] >= 0
# 引数の読みの写像は host の枠に一度だけ建てる（内容は共有される）
zrdq[zuao[u, k]] <- zur[u] * 128 + zuam[k] for (u) in 0 .. znusem[0]
      for (k) in 0 .. 2 if zuao[u, k] >= 0 if zur[u] >= 0
      if tdep[zut[u]] == 0
# 入れ子の使用の読みの引数は host の写像 124+k に（外の 64+k と分ける）
zrdq[zuao[u, k]] <- zur[u] * 128 + k + 124 for (u) in 0 .. znusem[0]
      for (k) in 0 .. 2 if zuao[u, k] >= 0 if zur[u] >= 0
      if tdep[zut[u]] >= 1
zfpu[r, zuca[k]] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpu[r, zum1[k]] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpu[r, zum2[k]] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpu[r, 20] <- true for (r) in 0 .. znr2m[0] if zcrr[r]
zfpu[r, 23] <- true for (r) in 0 .. znr2m[0] if zcrr[r]
zfpu[r, 24] <- true for (r) in 0 .. znr2m[0] if zcrr[r]
# 引数の写し（種0。生きた flat は −5、閉じていれば +束）
field zuaf : max bound 4096 8           # 使用 u の引数 k の場
zuaf[u, k] <- ofl[zuao[u, k]] - 1 for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuao[u, k] >= 0
zfplt[r, zuca[k]] <- zlatf[zuaf[zcru[r], k]] for (r) in 0 .. znr2m[0]
      for (k) in 0 .. 2 if zcrr[r] if zuaf[zcru[r], k] >= 0
      if zfws[zuaf[zcru[r], k]] <= zfgst[r] - 1
zfplt[r, zuca[k]] <- 0 - 5 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuaf[zcru[r], k] >= 0
      if zlatf[zuaf[zcru[r], k]] == 5
      if zfws[zuaf[zcru[r], k]] >= zfgst[r]
zfplt[r, zuca[k]] <- 0 - zlatf[zuaf[zcru[r], k]] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuaf[zcru[r], k] >= 0
      if zlatf[zuaf[zcru[r], k]] >= 2 if zlatf[zuaf[zcru[r], k]] <= 3
      if zfws[zuaf[zcru[r], k]] >= zfgst[r]
zfplt[r, zuca[k]] <- 0 - zlatf[zuaf[zcru[r], k]] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuaf[zcru[r], k] >= 0
      if zlatf[zuaf[zcru[r], k]] == 6
      if zfws[zuaf[zcru[r], k]] >= zfgst[r]
zfplt[r, zuca[k]] <- 0 - zlatf[zuaf[zcru[r], k]] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuaf[zcru[r], k] >= 0
      if zlatf[zuaf[zcru[r], k]] == 9
      if zfws[zuaf[zcru[r], k]] >= zfgst[r]
zfpam[r, zuca[k]] <- zur[zcru[r]] * 128 + zuam[k] for (r) in 0 .. znr2m[0]
      for (k) in 0 .. 2 if zcrr[r] if k <= zucar[zcru[r]] - 1
      if zur[zcru[r]] >= 0 if zuak[zcru[r], k] == 7
      if tdep[zut[zcru[r]]] == 0
zfpam[r, zuca[k]] <- zur[zcru[r]] * 128 + k + 124 for (r) in 0 .. znr2m[0]
      for (k) in 0 .. 2 if zcrr[r] if k <= zucar[zcru[r]] - 1
      if zur[zcru[r]] >= 0 if zuak[zcru[r], k] == 7
      if tdep[zut[zcru[r]]] >= 1
# 法（種3: pa % M。源は引数の写し）
zfpk[r, zum1[k]] <- 3 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpmo[r, zum1[k]] <- 268435399 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpsr[r, zum1[k]] <- zfpb[r, zuca[k]] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zfpb[r, zuca[k]] >= 1 if zuak[zcru[r], k] == 7
zfplt[r, zum1[k]] <- 0 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpam[r, zum1[k]] <- r * 128 + 4 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpk[r, zum2[k]] <- 3 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpmo[r, zum2[k]] <- 268435367 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpsr[r, zum2[k]] <- zfpb[r, zuca[k]] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zfpb[r, zuca[k]] >= 1 if zuak[zcru[r], k] == 7
zfplt[r, zum2[k]] <- 0 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
zfpam[r, zum2[k]] <- r * 128 + 4 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 7
# 一次式（種1: 写像 % M。写像 = 定数 + Σ 係数·pa[法の写し]）
field zcuc2 : max bound 4096            # 規則 r の構成子
zcuc2[r] <- zuc[zcru[r]] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuc[zcru[r]] >= 0
# 定数の引数を鎖で折り込む（cst = (cst + co·enc) % M。enc(整数) = 3·(g % M)）
# **鎖は使用ごとである** —— 入れ子の使用は自分の残差を持ち、外の使用は
# それを enc(番地) = 3·(番地 % M) として畳む。底から上へ、深さの順に閉じる。
field zuh1 : flat bound 4096 8          # M1 の残差（引数 k 個まで見た後）
zuh1[u, 0] <- zcc1[zuc[u]] for (u) in 0 .. znusem[0]
      if zuc[u] >= 0 if zcc1[zuc[u]] >= 0
zuh1[u, k+1] <- zuh1[u, k] for (u) in 0 .. znusem[0] for (k) in 0 .. 6
      if k <= zucar[u] - 1 if zuak[u, k] >= 0
      if zuak[u, k] != 4 if zuak[u, k] != 9
zuh1[u, k+1] <- (zuh1[u, k] + zpwa[zucar[u] - 1 - k] * (3 * zuav[u, k] % 268435399)) % 268435399 for (u) in 0 .. znusem[0] for (k) in 0 .. 6 if k <= zucar[u] - 1 if zuak[u, k] == 4
zuh1[u, k+1] <- (zuh1[u, k] + zpwa[zucar[u] - 1 - k] * (3 * ((zuad1[zuau[u, k]] * 268435367 + zuad2[zuau[u, k]]) % 268435399) % 268435399)) % 268435399 for (u) in 0 .. znusem[0] for (k) in 0 .. 6 if k <= zucar[u] - 1 if zuak[u, k] == 9 if not zuhrd[zuau[u, k]]
zuh1[u, k+1] <- zuh1[u, k] for (u) in 0 .. znusem[0] for (k) in 0 .. 6
      if k <= zucar[u] - 1 if zuak[u, k] == 9 if zuhrd[zuau[u, k]]
field zuh2 : flat bound 4096 8          # M2 の残差
zuh2[u, 0] <- zcc2[zuc[u]] for (u) in 0 .. znusem[0]
      if zuc[u] >= 0 if zcc2[zuc[u]] >= 0
zuh2[u, k+1] <- zuh2[u, k] for (u) in 0 .. znusem[0] for (k) in 0 .. 6
      if k <= zucar[u] - 1 if zuak[u, k] >= 0
      if zuak[u, k] != 4 if zuak[u, k] != 9
zuh2[u, k+1] <- (zuh2[u, k] + zpwb[zucar[u] - 1 - k] * (3 * zuav[u, k] % 268435367)) % 268435367 for (u) in 0 .. znusem[0] for (k) in 0 .. 6 if k <= zucar[u] - 1 if zuak[u, k] == 4
zuh2[u, k+1] <- (zuh2[u, k] + zpwb[zucar[u] - 1 - k] * (3 * zuad2[zuau[u, k]] % 268435367)) % 268435367 for (u) in 0 .. znusem[0] for (k) in 0 .. 6 if k <= zucar[u] - 1 if zuak[u, k] == 9 if not zuhrd[zuau[u, k]]
zuh2[u, k+1] <- zuh2[u, k] for (u) in 0 .. znusem[0] for (k) in 0 .. 6
      if k <= zucar[u] - 1 if zuak[u, k] == 9 if zuhrd[zuau[u, k]]
field zuad1 : flat bound 4096           # 使用 u の残差（M1。定数の引数だけ見た分）
zuad1[u] <- zuh1[u, zucar[u]] for (u) in 0 .. znusem[0]
      if zucar[u] >= 1 if zuh1[u, zucar[u]] >= 0
field zuad2 : flat bound 4096           # 同（M2）
zuad2[u] <- zuh2[u, zucar[u]] for (u) in 0 .. znusem[0]
      if zucar[u] >= 1 if zuh2[u, zucar[u]] >= 0
zmu[r * 128 + 60] <- true for (r) in 0 .. znr2m[0] if zcrr[r]
zmc[r * 128 + 60] <- zuad1[zcru[r]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zuad1[zcru[r]] >= 0
zmu[r * 128 + 61] <- true for (r) in 0 .. znr2m[0] if zcrr[r]
zmc[r * 128 + 61] <- zuad2[zcru[r]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zuad2[zcru[r]] >= 0
# 変数の引数 → 枠（係数 3·K^(n-1-k) % M。枠の位置は引数の順）
zmj0[r * 128 + 60] <- zuaj[zcru[r], 0] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 0] <= 1
zmc0[r * 128 + 60] <- zuacl[zcru[r], 0] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 0] <= 1
zmm0[r * 128 + 60] <- zqco1[zcuc2[r], 0] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 0] <= 1 if zcuc2[r] >= 0
zmj1[r * 128 + 60] <- zuaj[zcru[r], 1] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 1] <= 1
zmc1[r * 128 + 60] <- zuacl[zcru[r], 1] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 1] <= 1
zmm1[r * 128 + 60] <- zqco1[zcuc2[r], 1] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 1] <= 1 if zcuc2[r] >= 0
zmj0[r * 128 + 61] <- zuaj[zcru[r], 0] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 0] <= 1
zmc0[r * 128 + 61] <- zuacl[zcru[r], 0] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 0] <= 1
zmm0[r * 128 + 61] <- zqco2[zcuc2[r], 0] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 0] <= 1 if zcuc2[r] >= 0
zmj1[r * 128 + 61] <- zuaj[zcru[r], 1] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 1] <= 1
zmc1[r * 128 + 61] <- zuacl[zcru[r], 1] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 1] <= 1
zmm1[r * 128 + 61] <- zqco2[zcuc2[r], 1] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zuak[zcru[r], 1] <= 1 if zcuc2[r] >= 0
# 読みの引数 → 間接（読みの順で ind, ind2 に詰める）
field zra0 : min bound 4096             # 一本目の間接の引数番号（読み・綴り）
zra0[r] <- k for (r) in 0 .. znr2m[0] for (k) in 0 .. 7 if zcrr[r]
      if zuak[zcru[r], k] >= 7 if zuak[zcru[r], k] <= 8
zra0[r] <- k for (r) in 0 .. znr2m[0] for (k) in 0 .. 7 if zcrr[r]
      if zuak[zcru[r], k] == 10
field zra1 : min bound 4096             # 二本目
zra1[r] <- k for (r) in 0 .. znr2m[0] for (k) in 0 .. 7 if zcrr[r]
      if zuak[zcru[r], k] >= 7 if zuak[zcru[r], k] <= 8 if k >= zra0[r] + 1
zra1[r] <- k for (r) in 0 .. znr2m[0] for (k) in 0 .. 7 if zcrr[r]
      if zuak[zcru[r], k] == 10 if k >= zra0[r] + 1
# 読みを持つ入れ子の引数（種9・非定数）が読みより **前**にあるなら、
# 読みは二本目の間接に譲る（間接の順は引数の順 —— 参照実装と同じ）。
field zuhrd : or bound 4096             # 使用 u の引数に読み・変数がある
zuhrd[u] <- true for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] >= 7 if zuak[u, k] <= 8
zuhrd[u] <- true for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 10
zuhrd[u] <- true for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] <= 1 if zuat[u, k] >= 0
field zn9k : min bound 4096             # 読みを持つ入れ子の引数の位置
zn9k[r] <- k for (r) in 0 .. znr2m[0] for (k) in 0 .. 7 if zcrr[r]
      if zuak[zcru[r], k] == 9 if zuhrd[zuau[zcru[r], k]]
field zniu : max bound 4096             # その内の使用
zniu[r] <- zuau[zcru[r], zn9k[r]] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zn9k[r] >= 0
field zw9a : or bound 4096              # 種9（非定数）が読みより前
zw9a[r] <- true for (r) in 0 .. znr2m[0] if zcrr[r] if zn9k[r] >= 0
      if zra0[r] >= 0 if zn9k[r] <= zra0[r] - 1
zmia[r * 128 + 60] <- zci1[zcru[r], zra0[r]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra0[r] >= 0 if zci1[zcru[r], zra0[r]] >= 0
      if not zw9a[r]
zmib[r * 128 + 60] <- zfpb[r, zum1[zra0[r]]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra0[r] >= 0 if zfpb[r, 18 + zra0[r]] >= 1
      if not zw9a[r]
zmiu[r * 128 + 60] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r] if zra0[r] >= 0
zmia2[r * 128 + 60] <- zci1[zcru[r], zra0[r]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra0[r] >= 0 if zci1[zcru[r], zra0[r]] >= 0
      if zw9a[r]
zmib2[r * 128 + 60] <- zfpb[r, zum1[zra0[r]]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra0[r] >= 0 if zfpb[r, zum1[zra0[r]]] >= 1
      if zw9a[r]
zmiu2[r * 128 + 60] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r]
      if zra0[r] >= 0 if zw9a[r]
zmia2[r * 128 + 60] <- zci1[zcru[r], zra1[r]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra1[r] >= 0 if zci1[zcru[r], zra1[r]] >= 0
      if not zhr2[r]
zmib2[r * 128 + 60] <- zfpb[r, zum1[zra1[r]]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra1[r] >= 0 if zfpb[r, zum1[zra1[r]]] >= 1
      if not zhr2[r]
zmiu2[r * 128 + 60] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r] if zra1[r] >= 0
zmia[r * 128 + 61] <- zci2[zcru[r], zra0[r]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra0[r] >= 0 if zci2[zcru[r], zra0[r]] >= 0
      if not zw9a[r]
zmib[r * 128 + 61] <- zfpb[r, zum2[zra0[r]]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra0[r] >= 0 if zfpb[r, 21 + zra0[r]] >= 1
      if not zw9a[r]
zmiu[r * 128 + 61] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r] if zra0[r] >= 0
zmia2[r * 128 + 61] <- zci2[zcru[r], zra0[r]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra0[r] >= 0 if zci2[zcru[r], zra0[r]] >= 0
      if zw9a[r]
zmib2[r * 128 + 61] <- zfpb[r, zum2[zra0[r]]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra0[r] >= 0 if zfpb[r, zum2[zra0[r]]] >= 1
      if zw9a[r]
zmiu2[r * 128 + 61] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r]
      if zra0[r] >= 0 if zw9a[r]
zmia2[r * 128 + 61] <- zci2[zcru[r], zra1[r]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra1[r] >= 0 if zci2[zcru[r], zra1[r]] >= 0
      if not zhr2[r]
zmib2[r * 128 + 61] <- zfpb[r, zum2[zra1[r]]] for (r) in 0 .. znr2m[0]
      if zcrr[r] if zra1[r] >= 0 if zfpb[r, zum2[zra1[r]]] >= 1
      if not zhr2[r]
zmiu2[r * 128 + 61] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r] if zra1[r] >= 0
zfpk[r, 20] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r]
zfpmo[r, 20] <- 268435399 for (r) in 0 .. znr2m[0] if zcrr[r]
zfplt[r, 20] <- 0 for (r) in 0 .. znr2m[0] if zcrr[r]
zfpam[r, 20] <- r * 128 + 60 for (r) in 0 .. znr2m[0] if zcrr[r]
zfpk[r, 23] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r]
zfpmo[r, 23] <- 268435367 for (r) in 0 .. znr2m[0] if zcrr[r]
zfplt[r, 23] <- 0 for (r) in 0 .. znr2m[0] if zcrr[r]
zfpam[r, 23] <- r * 128 + 61 for (r) in 0 .. znr2m[0] if zcrr[r]
# 対（種2: 番地 = h1·M2 + h2）
zfpk[r, 24] <- 2 for (r) in 0 .. znr2m[0] if zcrr[r]
zfplt[r, 24] <- 0 for (r) in 0 .. znr2m[0] if zcrr[r]
zfpam[r, 24] <- r * 128 + 4 for (r) in 0 .. znr2m[0] if zcrr[r]
zfpsr[r, 24] <- zfpb[r, 20] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zfpb[r, 20] >= 1
field zfps2 : max bound 4096 128         # fp の列9（対の h2）
zfps2[r, 24] <- zfpb[r, 23] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zfpb[r, 23] >= 1
field zfpx : max bound 4096 128          # fp の列10（対の法 M2）
zfpx[r, 24] <- 268435367 for (r) in 0 .. znr2m[0] if zcrr[r]
# 零の写像（合成規則にも）
zmu[r * 128 + 4] <- true for (r) in 0 .. znr2m[0] if zcrr[r]
zmc[r * 128 + 4] <- 0 for (r) in 0 .. znr2m[0] if zcrr[r]

# ── 合成規則と host の家の行 ────────────────────────────────────────
field zish : or bound 4096              # 規則 r は使用の host
zish[zur[u]] <- true for (u) in 0 .. znusem[0] if zur[u] >= 0
      if tdep[zut[u]] == 0
# host の wm: 値 = 構成した番地（対の枠を読む間接）
zmia[r * 128 + 3] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r] if zish[r]
zmib[r * 128 + 3] <- zfpb[r, 24] for (r) in 0 .. znr2m[0] if zcrr[r]
      if zish[r] if zfpb[r, 24] >= 1
zmiu[r * 128 + 3] <- 1 for (r) in 0 .. znr2m[0] if zcrr[r] if zish[r]
field zissy : or bound 4096             # 規則 r は合成
zissy[r] <- true for (r) in 0 .. znr2m[0] if zsyru[r] >= 0
# 合成規則の dm: 書き先の場の基 + (番地 − 下端)·歩幅（歩幅は 1）
zmu[r * 128] <- true for (r) in 0 .. znr2m[0] if zissy[r]
zmc[r * 128] <- zfb[zsyf[r]] - zflo0[zsyf[r]] for (r) in 0 .. znr2m[0]
      if zissy[r] if zsyf[r] >= 1
zmia[r * 128] <- zfs0[zsyf[r]] for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyf[r] >= 1
zmib[r * 128] <- zfpb[r, 24] for (r) in 0 .. znr2m[0] if zissy[r]
      if zfpb[r, 24] >= 1
zmiu[r * 128] <- 1 for (r) in 0 .. znr2m[0] if zissy[r]
# 引数場の規則（j = k）: vf4、am は host の引数の写像
field zfgam : max bound 4096            # am の写像の明示の番号
field zsyak : max bound 4096            # 引数場の規則の引数の種
zsyak[r] <- zuak[zsyru[r], zsyj[r]] for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zuak[zsyru[r], zsyj[r]] >= 0
zfgvf[r] <- 4 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] == zfglat[r]
zfgns[r] <- 1 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] == zfglat[r]
# 深い読みの引数（座標に読みがある）: 値は pa 写し越し（vf0・wm 間接）
zfgvf[r] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] != zfglat[r]
zfgns[r] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] != zfglat[r]
zmu[r * 128 + 3] <- true for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] != zfglat[r]
zmc[r * 128 + 3] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] != zfglat[r]
zmia[r * 128 + 3] <- 1 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] != zfglat[r]
zmib[r * 128 + 3] <- zfpb[r, zuca[zsyj[r]]] for (r) in 0 .. znr2m[0]
      if zissy[r] if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] != zfglat[r] if zfpb[r, zuca[zsyj[r]]] >= 1
zmiu[r * 128 + 3] <- 1 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] != zfglat[r]
zfgam[r] <- zur[zsyru[r]] * 128 + zuam[zsyj[r]] for (r) in 0 .. znr2m[0]
      if zissy[r] if zsyj[r] <= zucar[zsyru[r]] - 1 if zur[zsyru[r]] >= 0
      if zsyak[r] == 7 if tdep[zut[zsyru[r]]] == 0
      if zlatf[zuaf[zsyru[r], zsyj[r]]] == zfglat[r]
zfgam[r] <- zur[zsyru[r]] * 128 + 124 + zsyj[r] for (r) in 0 .. znr2m[0]
      if zissy[r] if zsyj[r] <= zucar[zsyru[r]] - 1 if zur[zsyru[r]] >= 0
      if zsyak[r] == 7 if tdep[zut[zsyru[r]]] >= 1
      if zlatf[zuaf[zsyru[r], zsyj[r]]] == zfglat[r]
zwm[r] <- r * 128 + 4 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] == zfglat[r]
zwm[r] <- r * 128 + 3 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 7
      if zlatf[zuaf[zsyru[r], zsyj[r]]] != zfglat[r]
# 変数・定数の引数場: vf0、値は wm の一次式
zfgvf[r] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] <= 4
zfgvf[r] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 8
zfgns[r] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] <= 4
zfgns[r] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 8
zwm[r] <- r * 128 + 3 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] <= 4
zwm[r] <- r * 128 + 3 for (r) in 0 .. znr2m[0] if zissy[r]
