field zgrhc : or bound 4096 8           # 右辺に定数がある
zgrhc[snum[t], zgn[t]] <- true for (t,zc) in ch if zgpo2[t]
      if isnum[t]
field zgrvt : min bound 4096 8          # 右辺の変数のトークン
zgrvt[snum[t], zgn[t]] <- t for (t,zc) in ch if zgpo2[t]
      if tkind[t] == 1 if not isnum[t] if not isocc[t] if vbnd[t] >= 0

# ── 反転の比較 —— 左辺が一次式で右辺が裸の読み（`pc < maxpc[]`）。
