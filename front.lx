zfpu[r, zum2[k]] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuak[zcru[r], k] == 10
zfpk[r, zum2[k]] <- 3 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuak[zcru[r], k] == 10
zfpmo[r, zum2[k]] <- 268435367 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuak[zcru[r], k] == 10
zfplt[r, zum2[k]] <- 0 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuak[zcru[r], k] == 10
zfpsr[r, zum2[k]] <- zfpb[r, k + 102] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuak[zcru[r], k] == 10
      if zfpb[r, k + 102] >= 1
zfpam[r, zum2[k]] <- r * 128 + 4 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if zuak[zcru[r], k] == 10

# 引数場の規則（j = k、種10）: vf0、値は畳みを読む間接
zfgvf[r] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
zfgns[r] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
zwm[r] <- r * 128 + 3 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
zmu[r * 128 + 3] <- true for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
zmc[r * 128 + 3] <- 0 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
zmia[r * 128 + 3] <- 1 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
zmib[r * 128 + 3] <- zfpb[r, 97 + zsyj[r] * 2] for (r) in 0 .. znr2m[0]
      if zissy[r] if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
      if zfpb[r, 97 + zsyj[r] * 2] >= 1
zmiu[r * 128 + 3] <- 1 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
zmia2[r * 128 + 3] <- zuamu[zsyru[r], zsyj[r]] for (r) in 0 .. znr2m[0]
      if zissy[r] if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
zmib2[r * 128 + 3] <- zfpb[r, 96 + zsyj[r] * 2] for (r) in 0 .. znr2m[0]
      if zissy[r] if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
      if zfpb[r, 96 + zsyj[r] * 2] >= 1
zmiu2[r * 128 + 3] <- 1 for (r) in 0 .. znr2m[0] if zissy[r]
      if zsyj[r] <= zucar[zsyru[r]] - 1 if zsyak[r] == 10
# _size の二本目（種10）: 座標 = 畳みを読む間接
zmc[r * 128 + 1] <- zfb[zszf[z]] - zflo0[zszf[z]] for (r) in 0 .. znr2m[0]
      for (z) in 0 .. 0 if zissy[r] if zsyk[r] >= 0 if zszf[z] >= 1
      if zsyk2[r] == 10
zmia[r * 128 + 1] <- 1 for (r) in 0 .. znr2m[0] if zissy[r] if zsyk[r] >= 0
      if zsyk2[r] == 10
zmib[r * 128 + 1] <- zfpb[r, 102 + zsyk[r]] for (r) in 0 .. znr2m[0]
      if zissy[r] if zsyk[r] >= 0 if zfpb[r, 102 + zsyk[r]] >= 1
      if zsyk2[r] == 10
zmiu[r * 128 + 1] <- 1 for (r) in 0 .. znr2m[0] if zissy[r] if zsyk[r] >= 0
      if zsyk2[r] == 10

# ── 入れ子の使用が読みを持つとき（cons(bind(f[..], g[..]), 0)）───────
# 内の番地は定数でない。内の鎖を **同じ規則の枠**（80..93 の帯）に建て、
# 外の鎖は係数 3·K^(n-1-k) で（対 % M）を間接に足す。この一枚: 木に一つ。
field zwa0 : min bound 4096             # 内の使用の読みの引数（一本目）
zwa0[r] <- k for (r) in 0 .. znr2m[0] for (k) in 0 .. 7 if zniu[r] >= 0
      if zuak[zniu[r], k] == 7
field zwa1 : min bound 4096             # 二本目
zwa1[r] <- k for (r) in 0 .. znr2m[0] for (k) in 0 .. 7 if zniu[r] >= 0
      if zuak[zniu[r], k] == 7 if k >= zwa0[r] + 1
# 引数の写し（枠 80+k、写像は host の 124+k を共有）
zfpu[r, k + 80] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfplt[r, k + 80] <- zlatf[zuaf[zniu[r], k]] for (r) in 0 .. znr2m[0]
      for (k) in 0 .. 2 if zniu[r] >= 0 if zuaf[zniu[r], k] >= 0
      if zuak[zniu[r], k] == 7
      if zfws[zuaf[zniu[r], k]] <= zfgst[r] - 1
zfplt[r, k + 80] <- 0 - 5 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if zuaf[zniu[r], k] >= 0 if zuak[zniu[r], k] == 7
      if zlatf[zuaf[zniu[r], k]] == 5
      if zfws[zuaf[zniu[r], k]] >= zfgst[r]
zfplt[r, k + 80] <- 0 - zlatf[zuaf[zniu[r], k]] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if zuaf[zniu[r], k] >= 0 if zuak[zniu[r], k] == 7
      if zlatf[zuaf[zniu[r], k]] >= 2 if zlatf[zuaf[zniu[r], k]] <= 3
      if zfws[zuaf[zniu[r], k]] >= zfgst[r]
zfplt[r, k + 80] <- 0 - zlatf[zuaf[zniu[r], k]] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if zuaf[zniu[r], k] >= 0 if zuak[zniu[r], k] == 7
      if zlatf[zuaf[zniu[r], k]] == 6
      if zfws[zuaf[zniu[r], k]] >= zfgst[r]
zfplt[r, k + 80] <- 0 - zlatf[zuaf[zniu[r], k]] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if zuaf[zniu[r], k] >= 0 if zuak[zniu[r], k] == 7
      if zlatf[zuaf[zniu[r], k]] == 9
      if zfws[zuaf[zniu[r], k]] >= zfgst[r]
zfpam[r, k + 80] <- zur[zniu[r]] * 128 + k + 124 for (r) in 0 .. znr2m[0]
      for (k) in 0 .. 2 if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1
      if zuak[zniu[r], k] == 7 if zur[zniu[r]] >= 0
# 法（83+k: %M1、86+k: %M2）
zfpu[r, k + 83] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfpk[r, k + 83] <- 3 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfpmo[r, k + 83] <- 268435399 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfplt[r, k + 83] <- 0 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfpsr[r, k + 83] <- zfpb[r, k + 80] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
      if zfpb[r, k + 80] >= 1
zfpam[r, k + 83] <- r * 128 + 4 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfpu[r, k + 86] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfpk[r, k + 86] <- 3 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfpmo[r, k + 86] <- 268435367 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfplt[r, k + 86] <- 0 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
zfpsr[r, k + 86] <- zfpb[r, k + 80] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
      if zfpb[r, k + 80] >= 1
zfpam[r, k + 86] <- r * 128 + 4 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zniu[r] >= 0 if k <= zucar[zniu[r]] - 1 if zuak[zniu[r], k] == 7
# 一次式（89: %M1 が写像 122、90: %M2 が写像 123）と対（91）と（対 % M）
zfpu[r, 89] <- true for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpk[r, 89] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpmo[r, 89] <- 268435399 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfplt[r, 89] <- 0 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpam[r, 89] <- r * 128 + 122 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpu[r, 90] <- true for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpk[r, 90] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpmo[r, 90] <- 268435367 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfplt[r, 90] <- 0 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpam[r, 90] <- r * 128 + 123 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpu[r, 91] <- true for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpk[r, 91] <- 2 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfplt[r, 91] <- 0 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpam[r, 91] <- r * 128 + 4 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpsr[r, 91] <- zfpb[r, 89] for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zfpb[r, 89] >= 1
zfps2[r, 91] <- zfpb[r, 90] for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zfpb[r, 90] >= 1
zfpx[r, 91] <- 268435367 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpu[r, 92] <- true for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpk[r, 92] <- 3 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpmo[r, 92] <- 268435399 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfplt[r, 92] <- 0 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpsr[r, 92] <- zfpb[r, 91] for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zfpb[r, 91] >= 1
zfpam[r, 92] <- r * 128 + 4 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpu[r, 93] <- true for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpk[r, 93] <- 3 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpmo[r, 93] <- 268435367 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfplt[r, 93] <- 0 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zfpsr[r, 93] <- zfpb[r, 91] for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zfpb[r, 91] >= 1
zfpam[r, 93] <- r * 128 + 4 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
# 内の一次式の写像（122: M1 / 123: M2）—— 定数部 + Σ 係数·pa[法]
zmu[r * 128 + 122] <- true for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zmc[r * 128 + 122] <- zuad1[zniu[r]] for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zuad1[zniu[r]] >= 0
zmia[r * 128 + 122] <- zci1[zniu[r], zwa0[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zwa0[r] >= 0 if zci1[zniu[r], zwa0[r]] >= 0
zmib[r * 128 + 122] <- zfpb[r, 83 + zwa0[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zwa0[r] >= 0 if zfpb[r, 83 + zwa0[r]] >= 1
zmiu[r * 128 + 122] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zwa0[r] >= 0
zmia2[r * 128 + 122] <- zci1[zniu[r], zwa1[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zwa1[r] >= 0 if zci1[zniu[r], zwa1[r]] >= 0
zmib2[r * 128 + 122] <- zfpb[r, 83 + zwa1[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zwa1[r] >= 0 if zfpb[r, 83 + zwa1[r]] >= 1
zmiu2[r * 128 + 122] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zwa1[r] >= 0
zmu[r * 128 + 123] <- true for (r) in 0 .. znr2m[0] if zniu[r] >= 0
zmc[r * 128 + 123] <- zuad2[zniu[r]] for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zuad2[zniu[r]] >= 0
zmia[r * 128 + 123] <- zci2[zniu[r], zwa0[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zwa0[r] >= 0 if zci2[zniu[r], zwa0[r]] >= 0
zmib[r * 128 + 123] <- zfpb[r, 86 + zwa0[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zwa0[r] >= 0 if zfpb[r, 86 + zwa0[r]] >= 1
zmiu[r * 128 + 123] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zwa0[r] >= 0
zmia2[r * 128 + 123] <- zci2[zniu[r], zwa1[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zwa1[r] >= 0 if zci2[zniu[r], zwa1[r]] >= 0
zmib2[r * 128 + 123] <- zfpb[r, 86 + zwa1[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zwa1[r] >= 0 if zfpb[r, 86 + zwa1[r]] >= 1
zmiu2[r * 128 + 123] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zwa1[r] >= 0
# 外の鎖への間接（読みより前なら一本目、後なら二本目）
field zh7f : or bound 4096              # 読みが種9 より前
zh7f[r] <- true for (r) in 0 .. znr2m[0] if zra0[r] >= 0 if zn9k[r] >= 0
      if zra0[r] <= zn9k[r] - 1
zmia[r * 128 + 60] <- zci1[zcru[r], zn9k[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if not zh7f[r] if zci1[zcru[r], zn9k[r]] >= 0
zmib[r * 128 + 60] <- zfpb[r, 92] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if not zh7f[r] if zfpb[r, 92] >= 1
zmiu[r * 128 + 60] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if not zh7f[r]
zmia2[r * 128 + 60] <- zci1[zcru[r], zn9k[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zh7f[r] if zci1[zcru[r], zn9k[r]] >= 0
zmib2[r * 128 + 60] <- zfpb[r, 92] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zh7f[r] if zfpb[r, 92] >= 1
zmiu2[r * 128 + 60] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zh7f[r]
zmia[r * 128 + 61] <- zci2[zcru[r], zn9k[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if not zh7f[r] if zci2[zcru[r], zn9k[r]] >= 0
zmib[r * 128 + 61] <- zfpb[r, 93] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if not zh7f[r] if zfpb[r, 93] >= 1
zmiu[r * 128 + 61] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if not zh7f[r]
zmia2[r * 128 + 61] <- zci2[zcru[r], zn9k[r]] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zh7f[r] if zci2[zcru[r], zn9k[r]] >= 0
zmib2[r * 128 + 61] <- zfpb[r, 93] for (r) in 0 .. znr2m[0]
      if zniu[r] >= 0 if zh7f[r] if zfpb[r, 93] >= 1
zmiu2[r * 128 + 61] <- 1 for (r) in 0 .. znr2m[0] if zniu[r] >= 0
      if zh7f[r]


# ── 依存する区間のガードを合成する（文のガード席 7、写像 29/30/31、枠 39）──
# 半空間 `n[i] − c >= j`: cm = ずれ + 間接（読みの写し）、wm = 計数器 j。
# 文に依存する区間が二つあってもよい（`for (i) in 0 .. n[]-1 for (j) in
# 0 .. m[i]-1`）—— q 本目（文の中の順）は席 7−q に置く（席の写像は 8+3i
# / 9+3i / 10+3i、枠は 32+i —— ガードの席の並びそのまま）。
field zdlq : max bound 2048             # 依存する区間のループ g → 文の中の順
zdlq[g] <- 0 for (g) in 0 .. znglm[0] if lpk[g] == 3
zdlq[g] <- zdlq[h] + 1 for (g) in 0 .. znglm[0] for (h) in 0 .. znglm[0]
      if lpk[g] == 3 if lpk[h] == 3 if zlps[h] == zlps[g] if h <= g - 1
field zdlr : max bound 4096 2           # 文 s の q 本目の依存する区間のループ g
zdlr[zlps[g], zdlq[g]] <- g for (g) in 0 .. znglm[0] if lpk[g] == 3
      if zlps[g] >= 0 if zdlq[g] <= 1
field zdgi : max bound 4096 2           # その席（7 − q）
zdgi[s, q] <- 7 - q for (s) in 0 .. nstz[0] for (q) in 0 .. 1 if zdlr[s, q] >= 0
# 端が **裸の読みで生きた非 flat**（`0 .. n[i]`、n がこの層で育つ）なら
# 種11（単調な比較 —— cm は読みの番地の写像そのもの）。ずれがある形
# （`n[i] - 1`）は flat.py の pcell が pa に畳むので、生きていても種1。
field zdk11 : or bound 4096 2           # 文 s の q 本目の依存するガードは種11
zdk11[s, q] <- true for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0
      if zlhof[zdlr[s, q]] == 0 if lpbf[zdlr[s, q]] >= 0
      if zfws[lpbf[zdlr[s, q]]] >= zfgst[zrn[s]]
      if zlatf[lpbf[zdlr[s, q]]] != 5 if zlatf[lpbf[zdlr[s, q]]] <= 7
zfck[s, zdgi[s, q]] <- 11 for (s) in 0 .. nstz[0] for (q) in 0 .. 1 if zdk11[s, q]
zfclt[s, zdgi[s, q]] <- zlatf[lpbf[zdlr[s, q]]] for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdk11[s, q]
zfcam[s, zdgi[s, q]] <- zrn[s] * 128 + 10 + zdgi[s, q] * 3 for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdk11[s, q]
zfck[s, zdgi[s, q]] <- 1 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zfclt[s, zdgi[s, q]] <- 0 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zfcop[s, zdgi[s, q]] <- 3 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0
zfcam[s, zdgi[s, q]] <- zrn[s] * 128 + 8 + zdgi[s, q] * 3 for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zfcwm[s, zdgi[s, q]] <- zrn[s] * 128 + 9 + zdgi[s, q] * 3 for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdlr[s, q] >= 0 if zrn[s] >= 0
field zdgm : max bound 4096 2           # 席の読みの写像（10+3i）
zdgm[s, q] <- zrn[s] * 128 + 10 + zdgi[s, q] * 3 for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdlr[s, q] >= 0 if zrn[s] >= 0
field zdgu : max bound 4096 2           # 席の枠（32+i）
zdgu[s, q] <- 32 + zdgi[s, q] for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0
field zdgc : max bound 4096 2           # 席の cm の写像（8+3i）
zdgc[s, q] <- zrn[s] * 128 + 8 + zdgi[s, q] * 3 for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdlr[s, q] >= 0 if zrn[s] >= 0
field zdgw : max bound 4096 2           # 席の wm の写像（9+3i）
zdgw[s, q] <- zrn[s] * 128 + 9 + zdgi[s, q] * 3 for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdlr[s, q] >= 0 if zrn[s] >= 0
zrdq[zlbo[zdlr[s, q]]] <- zdgm[s, q] for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if zlbo[zdlr[s, q]] >= 0
zfpu[zrn[s], zdgu[s, q]] <- true for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zfplt[zrn[s], zdgu[s, q]] <- zlatf[lpbf[zdlr[s, q]]] for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdlr[s, q] >= 0 if zrn[s] >= 0 if lpbf[zdlr[s, q]] >= 0
      if zfws[lpbf[zdlr[s, q]]] <= zfgst[zrn[s]] - 1
zfplt[zrn[s], zdgu[s, q]] <- 0 - zlatf[lpbf[zdlr[s, q]]] for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdlr[s, q] >= 0 if zrn[s] >= 0 if lpbf[zdlr[s, q]] >= 0
      if zfws[lpbf[zdlr[s, q]]] >= zfgst[zrn[s]] if not zdk11[s, q]
zfpam[zrn[s], zdgu[s, q]] <- zdgm[s, q] for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zmu[zdgc[s, q]] <- true for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zmn[zdgc[s, q]] <- 0 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zmc[zdgc[s, q]] <- zlhof[zdlr[s, q]] for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zmia[zdgc[s, q]] <- 1 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zmib[zdgc[s, q]] <- zfpb[zrn[s], zdgu[s, q]] for (s) in 0 .. nstz[0]
      for (q) in 0 .. 1 if zdlr[s, q] >= 0 if zrn[s] >= 0
      if zfpb[zrn[s], zdgu[s, q]] >= 1 if not zdk11[s, q]
zmiu[zdgc[s, q]] <- 1 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0 if not zdk11[s, q]
zmu[zdgw[s, q]] <- true for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0
zmn[zdgw[s, q]] <- 1 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0
zmc[zdgw[s, q]] <- 0 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0
zmj0[zdgw[s, q]] <- lpi[zdlr[s, q]] for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0
zmc0[zdgw[s, q]] <- 0 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0
zmm0[zdgw[s, q]] <- 1 for (s) in 0 .. nstz[0] for (q) in 0 .. 1
      if zdlr[s, q] >= 0 if zrn[s] >= 0

# ══ 原子（綴りの値） ═══════════════════════════════════════════════
#
# 表の升に書かれた綴りは **番号**になる（ATOMB + 綴りの順位）。番号づけが
# 綴りの順なので min/max/比較は文字列のままと同じ答えを出す。ate 表が
# 剰余（enc = 3·折り込み+1）を運び、構成子は AE1/AE2[番号] を pa に写す。
# 折り込みも比較も **文字の座標の上の鎖**で書く —— 文字の面を広げない。

field zqtk : or bound 262144            # 綴りのトークン（表の升の原子）
# 引用符つき（"x"）でも素の綴り（x）でもよい —— 表の丸括弧の中の
# 数でない語は、どちらも原子である（29_dataflow の none / x / y …）。
zqtk[t] <- true for (t,zc) in ch if tkind[t] == 1 if not isnum[t]
      if istb[snum[t]] if tdep[t] == 1 if not tcom[t]
# is の右辺の綴り（`status[j] is "done"`）も原子の候補である ——
# 参照実装の _allatoms はガードの綴りも数えて番号を配る。
field zkwis : or bound 262144           # `is` の語
zkwis[t] <- true for (t,zc) in ch if tlen[t] == 2 if not tcom[t]
      if tch[t,0] == 105 if tch[t,1] == 115 if isrec[snum[t]]
field zqt34 : or bound 262144           # 一文字の `"`
zqt34[t] <- true for (t,zc) in ch if tlen[t] == 1 if not tcom[t]
      if tch[t,0] == 34
field zqtka : or bound 262144           # 原子の候補（表 + is の右辺）
zqtka[t] <- true for (t,zc) in ch if zqtk[t]
zqtka[nextw[nextw[t]]] <- true for (t,zc) in ch if zkwis[t]
      if zqt34[nextw[t]]
field zqac : or bound 262144            # 綴りのトークンに属する文字
zqac[i] <- true for (i,c) in ch if zqtka[tnum[i]]
field zprc : max bound 262144           # 綴りのトークンの通し番号（鎖）
zprc[0] <- 0 for (z) in 0 .. 0 if not zqtka[0]
zprc[0] <- 1 for (z) in 0 .. 0 if zqtka[0]
zprc[t] <- zprc[t-1] for (t,zc) in ch if t >= 1 if not zqtka[t]
zprc[t] <- zprc[t-1] + 1 for (t,zc) in ch if t >= 1 if zqtka[t]
field zprov : max bound 262144          # トークン → 仮番号（0 起点）
zprov[t] <- zprc[t] - 1 for (t,zc) in ch if zqtka[t]
field znpv : max bound 1                # 仮番号の数
znpv[z] <- 0 for (z) in 0 .. 0
znpv[z] <- zprc[t] for (t,zc) in ch for (z) in 0 .. 0
field znpvm : max bound 1
znpvm[z] <- znpv[z] - 1 for (z) in 0 .. 0
field zatok : max bound 64              # 仮番号 → トークン（最初の出現）
zatok[zprov[t]] <- t for (t,zc) in ch if zqtka[t] if zprov[t] >= 0
      if zprc[t] >= 1
field zaltk : max bound 64 24           # 仮番号 a の k 文字目（無い所は 0）
zaltk[zprov[tnum[i]], cpos[i]] <- c for (i,c) in ch if zqac[i]
      if cpos[i] <= 23 if zprov[tnum[i]] >= 0
zaltk[a, k] <- 0 for (a) in 0 .. znpvm[0] for (k) in 0 .. 23
      if zatok[a] >= 0 if k >= tlen[zatok[a]]
field zpref : or bound 64 4096          # a と b は k 文字目まで同じ（b·24+k）
zpref[a, b * 24] <- true for (a) in 0 .. znpvm[0] for (b) in 0 .. znpvm[0]
zpref[a, b * 24 + k] <- true for (a) in 0 .. znpvm[0] for (b) in 0 .. znpvm[0]
      for (k) in 1 .. 23 if zpref[a, b * 24 + k - 1]
      if zaltk[a, k - 1] == zaltk[b, k - 1]
field zsame : or bound 64 64            # 同じ綴り
zsame[a, b] <- true for (a) in 0 .. znpvm[0] for (b) in 0 .. znpvm[0]
      if zpref[a, b * 24 + 23] if zaltk[a, 23] == zaltk[b, 23]
field zaless : or bound 64 64           # a の綴り < b の綴り
zaless[a, b] <- true for (a) in 0 .. znpvm[0] for (b) in 0 .. znpvm[0]
      for (k) in 0 .. 23 if zpref[a, b * 24 + k]
      if zaltk[a, k] <= zaltk[b, k] - 1
field zadup : or bound 64               # 前に同じ綴りがある
zadup[a] <- true for (a) in 0 .. znpvm[0] for (b) in 0 .. znpvm[0]
      if b <= a - 1 if zsame[b, a]
field zarep : or bound 64               # 代表
zarep[a] <- true for (a) in 0 .. znpvm[0] if zatok[a] >= 0 if not zadup[a]
field zarnk : count bound 64            # 綴りの順位（小さい綴りの代表の数）
zarnk[a] <- 1 for (a) in 0 .. znpvm[0] if zarep[a]
zarnk[a] <- 1 for (a) in 0 .. znpvm[0] for (b) in 0 .. znpvm[0]
      if zarep[a] if zarep[b] if zaless[b, a]
field zaof : max bound 64               # 仮番号 → 順位（0 起点。全員）
zaof[a] <- zarnk[b] - 1 for (a) in 0 .. znpvm[0] for (b) in 0 .. znpvm[0]
      if zarep[b] if zsame[b, a] if zarnk[b] >= 1
field znat : max bound 1                # 原子の数
znat[z] <- 0 for (z) in 0 .. 0
znat[z] <- zarnk[a] for (a) in 0 .. znpvm[0] for (z) in 0 .. 0

# ── 原子の置き場（数の上端のすぐ上） ────────────────────────────────
# zamx は zdat（原子の番号が混ざる）を経由してはならない —— 表の数の列の
# 最大・区間の上端・定数の座標だけから出す（flat の num フィルタと同じ）。
field zlpg : max bound 4096 8           # (規則, 節) → ループ番号
zlpg[zlpr[g], lpi[g]] <- g for (g) in 0 .. znglm[0] if zlpr[g] >= 0
field zcmx2 : max bound 64 8            # 表 tb の列 c の数の最大
zcmx2[ztbs[snum[t]], colc[t]] <- tval[t] for (t,zc) in ch if isnum[t]
      if istb[snum[t]] if tdep[t] == 1 if ztbs[snum[t]] >= 0
field zodtb : max bound 8192 2          # 出現の次元 d のループの表
zodtb[o, d] <- zltb[zlpg[zsr[o], zdj[o, d]]] for (o) in 0 .. nocz[0]
      for (d) in 0 .. 1 if zmoc[o] if zdk[o, d] == 0
      if zlpg[zsr[o], zdj[o, d]] >= 0
field zamx : max bound 1                # 数の座標・番地の上端
zamx[z] <- 0 for (z) in 0 .. 0
zamx[z] <- zdc[o, d] for (o) in 0 .. nocz[0] for (d) in 0 .. 1
      for (z) in 0 .. 0 if zmoc[o] if zdk[o, d] == 4
zamx[z] <- zcmx2[zodtb[o, d], zdc[o, d]] + zdof[o, d]
      for (o) in 0 .. nocz[0] for (d) in 0 .. 1 for (z) in 0 .. 0
      if zmoc[o] if zdk[o, d] == 0 if zodtb[o, d] >= 0
      if not zacl[zodtb[o, d], zdc[o, d]]
zamx[z] <- zlphi2[zlpg[zsr[o], zdj[o, d]]] + zdof[o, d]
      for (o) in 0 .. nocz[0] for (d) in 0 .. 1 for (z) in 0 .. 0
      if zmoc[o] if zdk[o, d] == 1 if zlpg[zsr[o], zdj[o, d]] >= 0
# 走らせた側は自分の数の上端を知っている —— 印の行 (1022, 0, 上端, 1)
zamx[z] <- lo for (f, d, lo, w) in ext for (z) in 0 .. 0 if f == 1022
field zatb : max bound 1                # 原子の基
zatb[z] <- zamx[z] + 1 for (z) in 0 .. 0 if zamx[z] >= 0

# ── dat と ate ─────────────────────────────────────────────────────
field zatct : max bound 262144          # 綴りのトークン → 番号（ATOMB + 順位）
zatct[t] <- zatb[z] + zaof[zprov[t]] for (t,zc) in ch for (z) in 0 .. 0
      if zqtka[t] if zprov[t] >= 0 if zaof[zprov[t]] >= 0 if zatb[z] >= 1
ztbh2[ztrw[t], colc[t]] <- true for (t,zc) in ch if zqtk[t]
      if ztrw[t] >= 1
field ztbva : max bound 8192 8          # (通し行, 列) の原子の番号
ztbva[ztrw[t], colc[t]] <- zatct[t] for (t,zc) in ch if zqtk[t]
      if ztrw[t] >= 1 if zatct[t] >= 1
field zacl : or bound 64 8              # 表 tb の列 c に綴りがある（atomcol）
zacl[ztbs[snum[t]], colc[t]] <- true for (t,zc) in ch if zqtk[t]
      if ztbs[snum[t]] >= 0
# 折り込み（文字の鎖。長さの上限は要らない）
field zaf1p : flat bound 262144         # M1 の折り込み（法を取る前）
zaf1p[i] <- zcp1[i] for (i,c) in ch if zqac[i] if i == tstart[tnum[i]]
zaf1p[i] <- zaf1[i-1] * 1000003 + zcp1[i] for (i,c) in ch
      if zqac[i] if i >= tstart[tnum[i]] + 1
field zaf1 : flat bound 262144          # M1 の折り込み（文字 i まで）
zaf1[i] <- zaf1p[i] % 268435399 for (i,c) in ch if zqac[i]
field zaf2p : flat bound 262144         # M2 の折り込み（法を取る前）
zaf2p[i] <- zcp1[i] for (i,c) in ch if zqac[i] if i == tstart[tnum[i]]
zaf2p[i] <- zaf2[i-1] * 1000033 + zcp1[i] for (i,c) in ch
      if zqac[i] if i >= tstart[tnum[i]] + 1
field zaf2 : flat bound 262144          # M2 の折り込み
zaf2[i] <- zaf2p[i] % 268435367 for (i,c) in ch if zqac[i]
field zate1 : max bound 64              # 順位 → enc（M1）
zate1[zaof[zprov[t]]] <- zaf1[zlast[t]] * 3 + 1
      for (t,zc) in ch if zqtka[t] if zprov[t] >= 0 if zaof[zprov[t]] >= 0
field zate2 : max bound 64              # 順位 → enc（M2）
zate2[zaof[zprov[t]]] <- zaf2[zlast[t]] * 3 + 1
      for (t,zc) in ch if zqtka[t] if zprov[t] >= 0 if zaof[zprov[t]] >= 0

# ── 構成子の綴りの引数（種 8）: AE を pa に写して係数 co で足す ──────
zuak[u, k] <- 8 for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuat[u, k] >= 0 if not isnum[zuat[u, k]]
      if not isocc[zuat[u, k]] if zur[u] >= 0
      if zlpg[zur[u], zvlpz[zuat[u, k]]] >= 0
      if zltb[zlpg[zur[u], zvlpz[zuat[u, k]]]] >= 0
      if zacl[zltb[zlpg[zur[u], zvlpz[zuat[u, k]]]], zvcolz[zuat[u, k]]]
field zqp1 : max bound 64 8             # 係数 K1^(n-1-i) % M1（3 なし）
zqp1[c, i] <- zpwa[zcar[c] - 1 - i] for (c) in 0 .. zncdm[0]
      for (i) in 0 .. 7 if zcar[c] >= 1 if i <= zcar[c] - 1
field zqp2 : max bound 64 8             # 係数 K2^(n-1-i) % M2
zqp2[c, i] <- zpwb[zcar[c] - 1 - i] for (c) in 0 .. zncdm[0]
      for (i) in 0 .. 7 if zcar[c] >= 1 if i <= zcar[c] - 1

# ── 種8（綴りの引数）の枠: AE1/AE2[番号] を pa に写す（種5・種6） ────
zfpu[r, zum1[k]] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zfpu[r, zum2[k]] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zfpk[r, zum1[k]] <- 5 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zfpk[r, zum2[k]] <- 6 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zfplt[r, zum1[k]] <- 0 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zfplt[r, zum2[k]] <- 0 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zfpam[r, zum1[k]] <- r * 128 + zuae[k] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zfpam[r, zum2[k]] <- r * 128 + zuae[k] for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zmu[r * 128 + zuae[k]] <- true for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zmc[r * 128 + zuae[k]] <- 0 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
zmj0[r * 128 + zuae[k]] <- zuaj[zcru[r], k] for (r) in 0 .. znr2m[0]
      for (k) in 0 .. 2 if zcrr[r] if k <= zucar[zcru[r]] - 1
      if zuak[zcru[r], k] == 8
zmc0[r * 128 + zuae[k]] <- zuacl[zcru[r], k] for (r) in 0 .. znr2m[0]
      for (k) in 0 .. 2 if zcrr[r] if k <= zucar[zcru[r]] - 1
      if zuak[zcru[r], k] == 8
zmm0[r * 128 + zuae[k]] <- 1 for (r) in 0 .. znr2m[0] for (k) in 0 .. 2
      if zcrr[r] if k <= zucar[zcru[r]] - 1 if zuak[zcru[r], k] == 8
# 引数 k の間接の係数（種7 は 3·K^e、種8 は K^e）
field zci1 : max bound 4096 8
zci1[u, k] <- zqco1[zuc[u], k] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 7 if zuc[u] >= 0
zci1[u, k] <- zqp1[zuc[u], k] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 8 if zuc[u] >= 0
zci1[u, k] <- zqco1[zuc[u], k] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 9 if zuc[u] >= 0
zci1[u, k] <- zqco1[zuc[u], k] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 10 if zuc[u] >= 0
field zci2 : max bound 4096 8
zci2[u, k] <- zqco2[zuc[u], k] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 7 if zuc[u] >= 0
zci2[u, k] <- zqp2[zuc[u], k] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 8 if zuc[u] >= 0
zci2[u, k] <- zqco2[zuc[u], k] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 9 if zuc[u] >= 0
zci2[u, k] <- zqco2[zuc[u], k] for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuak[u, k] == 10 if zuc[u] >= 0

# ── 間接が三本のとき: 後ろの二本を対で畳む（fp 種7）────────────────
field zra2 : min bound 4096             # 三本目の間接の引数番号
zra2[r] <- k for (r) in 0 .. znr2m[0] for (k) in 0 .. 7 if zcrr[r]
      if zuak[zcru[r], k] >= 7 if zuak[zcru[r], k] <= 8 if k >= zra1[r] + 1
field zhr2 : or bound 4096              # 三本目がある
zhr2[r] <- true for (r) in 0 .. znr2m[0] if zcrr[r] if zra2[r] >= 0
zfpu[r, 30] <- true for (r) in 0 .. znr2m[0] if zhr2[r]
zfpu[r, 31] <- true for (r) in 0 .. znr2m[0] if zhr2[r]
zfpk[r, 30] <- 7 for (r) in 0 .. znr2m[0] if zhr2[r]
zfpk[r, 31] <- 7 for (r) in 0 .. znr2m[0] if zhr2[r]
zfplt[r, 30] <- 0 for (r) in 0 .. znr2m[0] if zhr2[r]
zfplt[r, 31] <- 0 for (r) in 0 .. znr2m[0] if zhr2[r]
zfpam[r, 30] <- r * 128 + 4 for (r) in 0 .. znr2m[0] if zhr2[r]
zfpam[r, 31] <- r * 128 + 4 for (r) in 0 .. znr2m[0] if zhr2[r]
# 列: mo = 二本目の係数 / sr = 三本目の基 / s2 = 二本目の基 / x = 三本目の係数
zfpmo[r, 30] <- zci1[zcru[r], zra1[r]] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zci1[zcru[r], zra1[r]] >= 0
zfpsr[r, 30] <- zfpb[r, zum1[zra2[r]]] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zfpb[r, zum1[zra2[r]]] >= 1
zfps2[r, 30] <- zfpb[r, zum1[zra1[r]]] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zfpb[r, zum1[zra1[r]]] >= 1
zfpx[r, 30] <- zci1[zcru[r], zra2[r]] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zci1[zcru[r], zra2[r]] >= 0
zfpmo[r, 31] <- zci2[zcru[r], zra1[r]] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zci2[zcru[r], zra1[r]] >= 0
zfpsr[r, 31] <- zfpb[r, zum2[zra2[r]]] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zfpb[r, zum2[zra2[r]]] >= 1
zfps2[r, 31] <- zfpb[r, zum2[zra1[r]]] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zfpb[r, zum2[zra1[r]]] >= 1
zfpx[r, 31] <- zci2[zcru[r], zra2[r]] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zci2[zcru[r], zra2[r]] >= 0
# 三本のときの ind2 は (1, 畳んだ枠)
zmia2[r * 128 + 60] <- 1 for (r) in 0 .. znr2m[0] if zhr2[r]
zmib2[r * 128 + 60] <- zfpb[r, 30] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zfpb[r, 30] >= 1
zmia2[r * 128 + 61] <- 1 for (r) in 0 .. znr2m[0] if zhr2[r]
zmib2[r * 128 + 61] <- zfpb[r, 31] for (r) in 0 .. znr2m[0] if zhr2[r]
      if zfpb[r, 31] >= 1
