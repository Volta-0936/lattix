# 右辺の区域（演算子の後ろ・同じ節・深さ0）の項を拾う
field zclot : max bound 262144          # 大域の節 → 比較の演算子のトークン
zclot[gcl[t]] <- t for (t,zc) in ch if iscmp2[t]
field zgpo2 : or bound 262144           # 右辺の区域のトークン
zgpo2[t] <- true for (t,zc) in ch if cmpcl[gcl[t]] if tdep[t] == 0
      if cnum[t] >= 1 if t >= zclot[gcl[t]] + 1 if zclot[gcl[t]] >= 0
      if not tcom[t]
field zgro : max bound 4096 8           # 右辺の一本目の読みの出現（min で拾う）
field zgro1m : min bound 4096 8
zgro1m[snum[t], zgn[t]] <- oseq[t] for (t,zc) in ch if zgpo2[t]
      if isocc[t] if not isbnd[t]
zgro[s, i] <- zgro1m[s, i] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgro1m[s, i] >= 0
field zgro2 : min bound 4096 8          # 二本目
zgro2[snum[t], zgn[t]] <- oseq[t] for (t,zc) in ch if zgpo2[t]
      if isocc[t] if not isbnd[t]
      if oseq[t] >= zgro1m[snum[t], zgn[t]] + 1
field zgrst : sum bound 4096 8          # 右辺の定数の和（符号つき）
zgrst[snum[t], zgn[t]] <- tval[t] for (t,zc) in ch if zgpo2[t]
