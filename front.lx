# ══ front.lx —— 家の表への算術（第2段の一枚目） ═══════════════════════
#
# 33_self.lx（バイト → 規則の形）と lib/fold.lx（形の番号づけ）の後ろに
# 繋いで使う。ここから下は **規則の形 → 家の表** の算術だけである ——
# 判断は上（成層・束・ループ・項・ガード）が全部済ませている。
#
#   出すもの（この一枚目）: dat / spc / ssz
#     dat[行, 列]  軸の中身（表の行・区間の点・番兵の一点）
#     spc[空間, 軸] → 基・幅・歩幅
#     ssz[空間]    点の数
#
# 形の言葉（気づき22・37）: 軸も空間も **最初に現れた場所が名前**である。
# 同じ (下端, 上端) の区間は一本の軸を共有し、同じ軸の列を持つ規則は
# 一つの空間を共有する —— 挿入も探索も無く、min と前置きの鎖だけで番号が出る。

# ── 閉じた値の口 ────────────────────────────────────────────────────
# 区間の上端が場の読みのとき（`for (i) in 0 .. n[]`）、その値は前の層で
# 閉じている —— 前段と走らせる物は **超段ごとに交代する**（BSP）。この口が
# その交代の継ぎ目で、走らせた側が (場, 座標, 値) を書いて寄越す。
table orc = (0, 0, 0)
field zorc : max bound 1024 64          # 閉じた値（場, 座標 → 値）
zorc[f, c] <- v for (f, c, v) in orc

# ══ 精密な成層（参照実装と同じ判断） ═══════════════════════════════
# 33_self の lvl は比較を一律に非単調と見る（断片の安全側）。参照実装は
# **束の向き**で見る —— `a[i] > k` は max（昇る場）に対して単調で、層を
# 食わない（真になったら二度と偽にならない）。ここでは断片の成層を触らず、
# 家の表のための層をもう一枚、精密な非単調で数え直す。
#
# 非単調な読みとは: 否定 / 添字の中（flat・fourv を除く）/ 向きの合わない
# 比較（== と != は flat 以外すべて）/ 束の違う値の読み（flat・fourv を除く）。
field zosen : max bound 8192            # 出現の場の向き（1 下る / 2 昇る / 5 flat / 6 fourv）
zosen[o] <- 1 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zlatf[ofl[o] - 1] == 1
zosen[o] <- 2 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zlatf[ofl[o] - 1] >= 2 if zlatf[ofl[o] - 1] <= 3
zosen[o] <- 2 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zlatf[ofl[o] - 1] >= 8
# sum / bag の向きは束でなく **プログラム**が言う（参照実装 field_senses）: 寄与に
# 場の読みがあれば向き無し（NONE = 3 —— どの要る向きとも合わない → 非単調）
field zsnr : or bound 1024              # 場 f の寄与に読みがある
zsnr[hfz[osn[o]]] <- true for (o) in 0 .. nocz[0] if zoval[o] if oin[o]
      if osn[o] >= 0 if hfz[osn[o]] >= 0
zosen[o] <- 3 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zlatf[ofl[o] - 1] == 8 if zsnr[ofl[o] - 1]
zosen[o] <- 3 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zlatf[ofl[o] - 1] == 10 if zsnr[ofl[o] - 1]
zosen[o] <- 1 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zlatf[ofl[o] - 1] == 4
zosen[o] <- 2 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zlatf[ofl[o] - 1] == 7
zosen[o] <- 5 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zlatf[ofl[o] - 1] == 5
zosen[o] <- 6 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zlatf[ofl[o] - 1] == 6
# 頭の場の要る向き —— 定義（lattix.py の tgt_req）と同じ写像:
# sense が下る束（min / and）だけ 1、他は全部 2（flat / fourv / set の頭も 2）
field zhsen : max bound 4096
zhsen[s] <- 1 for (s) in 0 .. nstz[0] if hfl[s] >= 1
      if zlatf[hfl[s] - 1] == 1
zhsen[s] <- 1 for (s) in 0 .. nstz[0] if hfl[s] >= 1
      if zlatf[hfl[s] - 1] == 4
zhsen[s] <- 2 for (s) in 0 .. nstz[0] if hfl[s] >= 1
      if zlatf[hfl[s] - 1] >= 2 if zlatf[hfl[s] - 1] <= 3
zhsen[s] <- 2 for (s) in 0 .. nstz[0] if hfl[s] >= 1
      if zlatf[hfl[s] - 1] >= 5
field zrq : max bound 262144            # 比較の辺の要る向き（1 下る / 2 昇る / 4 座標）
zrq[oppv[t]] <- 2 for (t,zc) in ch if iscmp2[t] if opc2[t] == 5
zrq[oppv[t]] <- 2 for (t,zc) in ch if iscmp2[t] if opc2[t] == 3
zrq[oppv[t]] <- 1 for (t,zc) in ch if iscmp2[t] if opc2[t] == 4
zrq[oppv[t]] <- 1 for (t,zc) in ch if iscmp2[t] if opc2[t] == 6
zrq[oppv[t]] <- 4 for (t,zc) in ch if iscmp2[t] if opc2[t] <= 2
zrq[opnx[t]] <- 1 for (t,zc) in ch if iscmp2[t] if opc2[t] == 5
zrq[opnx[t]] <- 1 for (t,zc) in ch if iscmp2[t] if opc2[t] == 3
zrq[opnx[t]] <- 2 for (t,zc) in ch if iscmp2[t] if opc2[t] == 4
zrq[opnx[t]] <- 2 for (t,zc) in ch if iscmp2[t] if opc2[t] == 6
zrq[opnx[t]] <- 4 for (t,zc) in ch if iscmp2[t] if opc2[t] <= 2
field zonm : or bound 8192              # 精密な非単調の読み
zonm[oseq[t]] <- true for (t,zc) in ch if isocc[t] if isneg[t]
      if zosen[oseq[t]] <= 5
# 構成子の使用の引数の読みは **値の写し**である —— 昇る束なら生きたまま
# 単調（参照実装の live copy と同じ）。下る束だけ閉じる（成層できない）。
zonm[oseq[t]] <- true for (t,zc) in ch if isocc[t] if tdep[t] >= 1
      if zosen[oseq[t]] <= 4 if not zisua[oseq[t]]
zonm[oseq[t]] <- true for (t,zc) in ch if isocc[t] if tdep[t] >= 1
      if zosen[oseq[t]] == 1 if zisua[oseq[t]]
zonm[oseq[tmatch[oppv[t]]]] <- true for (t,zc) in ch if iscmp2[t]
      if isclo[oppv[t]] if zosen[oseq[tmatch[oppv[t]]]] <= 4
      if zrq[oppv[t]] != zosen[oseq[tmatch[oppv[t]]]]
zonm[oseq[opnx[t]]] <- true for (t,zc) in ch if iscmp2[t]
      if isocc[opnx[t]] if zosen[oseq[opnx[t]]] <= 4
      if zrq[opnx[t]] != zosen[oseq[opnx[t]]]
# 左辺が 読み ± 定数（match[k]+1 == k）—— 読みの向きは同じ規則で判じる
zonm[oseq[tmatch[prevw[prevw[oppv[t]]]]]] <- true for (t,zc) in ch
      if iscmp2[t] if isnum[oppv[t]] if isclo[prevw[prevw[oppv[t]]]]
      if isplus[prevw[oppv[t]]]
      if zosen[oseq[tmatch[prevw[prevw[oppv[t]]]]]] <= 4
      if zrq[oppv[t]] != zosen[oseq[tmatch[prevw[prevw[oppv[t]]]]]]
zonm[oseq[tmatch[prevw[prevw[oppv[t]]]]]] <- true for (t,zc) in ch
      if iscmp2[t] if isnum[oppv[t]] if isclo[prevw[prevw[oppv[t]]]]
      if ismin[prevw[oppv[t]]]
      if zosen[oseq[tmatch[prevw[prevw[oppv[t]]]]]] <= 4
      if zrq[oppv[t]] != zosen[oseq[tmatch[prevw[prevw[oppv[t]]]]]]
# 値の読みは **向きが合えば単調**である（束の名は関係ない）—— max を flat の
# 頭に読むのは単調（どちらも昇る）、min を max に読むのは非単調（向きが逆）。
# 引き算の右は要る向きが **裏返る**（classify の FLIP）。
zonm[oseq[t]] <- true for (t,zc) in ch if istrm[t] if ofl[oseq[t]] >= 1
      if hfl[snum[t]] >= 1 if zosen[oseq[t]] <= 4
      if zosen[oseq[t]] != zhsen[snum[t]]
      if trkd[snum[t], tcnt[t]] != 9 if not zisua[oseq[t]]
zonm[oseq[t]] <- true for (t,zc) in ch if istrm[t] if ofl[oseq[t]] >= 1
      if hfl[snum[t]] >= 1 if zosen[oseq[t]] <= 4
      if zosen[oseq[t]] == zhsen[snum[t]]
      if trkd[snum[t], tcnt[t]] == 9
# 鎖のガードの芯（`f[i] % c == k` の f[i]）—— 剰余は向きを壊すので常に非単調
zonm[zgco[s, i]] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgch[s, i] if zgco[s, i] >= 0
# 値の鎖の % も同じ（flat / fourv の芯だけは ⊥→v で止まるので単調）
field zhmod : or bound 4096
zhmod[s] <- true for (s) in 0 .. nstz[0] if zchny[s] if zchk1[s] == 3
zhmod[s] <- true for (s) in 0 .. nstz[0] if zchny[s] if zchk2[s] == 3
zonm[zchoc[s]] <- true for (s) in 0 .. nstz[0] if zchn[s] if zhmod[s]
      if zchoc[s] >= 0 if zosen[zchoc[s]] <= 4
zonm[zchpoc[s]] <- true for (s) in 0 .. nstz[0] if zchpp[s] if zhmod[s]
      if zchpoc[s] >= 0 if zosen[zchpoc[s]] <= 4
field zwlv : or bound 1024 128          # 場 f を書く文が層 k 以上（精密）
field zlvl : or bound 4096 128          # 文 s は層 k 以上（精密）
zlvl[s,0] <- true for (s) in 0 .. nstz[0] if hasr[s]
zwlv[hfl[s], k] <- true for (s) in 0 .. nstz[0] for (k) in 0 .. 127
      if hasr[s] if hfl[s] >= 0 if zlvl[s,k]
zlvl[osn[o], k] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 127 if oin[o]
      if not ohd[o] if not zonm[o] if zwlv[ofl[o], k]
zlvl[osn[o], k + 1] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 126
      if oin[o] if not ohd[o] if zonm[o] if zwlv[ofl[o], k]
field zlevel : max bound 4096           # 文 s の層（精密）
zlevel[s] <- k for (s) in 0 .. nstz[0] for (k) in 0 .. 127 if zlvl[s,k]
# 値の読みを除いた層（ガード・座標だけ）—— 定数の構成子の合成規則は
# host の値の読みに縛られない（参照実装は合成規則を独立に成層する）
field zoval : or bound 8192             # 出現 o は値の位置
zoval[oseq[t]] <- true for (t,zc) in ch if isocc[t] if cnum[t] == 0
      if t >= arrowt[snum[t]] + 1
field zlvg : or bound 4096 128
zlvg[s, 0] <- true for (s) in 0 .. nstz[0] if hasr[s]
zlvg[osn[o], k] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 127
      if oin[o] if not ohd[o] if not zonm[o] if zwlv[ofl[o], k]
      if not zoval[o]
zlvg[osn[o], k + 1] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 126
      if oin[o] if not ohd[o] if zonm[o] if zwlv[ofl[o], k]
      if not zoval[o]
field zlevg : max bound 4096
zlevg[s] <- k for (s) in 0 .. nstz[0] for (k) in 0 .. 127 if zlvg[s, k]

# ── 誤りの報告（PLAN 2.7）—— 断るべき本は断る。行と理由を場に置く ────────
# 種1: 成層できない（否定を跨いで自分に戻る —— 層が 127 を超える）。
# 参照実装は「recursion through a non-monotone dep」で断る。行は輪の最初の文。
field zerr : max bound 4096             # 文 s の誤りの種（0 無し / 1 成層できない / 2 前段の制限）
zerr[s] <- 1 for (s) in 0 .. nstz[0] if zlvl[s, 127]
# 種2: 前段の制限（言語の制限ではない）—— 一文のガードは八つまで（席 8）。
# 黙って九つ目を落としてはいけない（自己適用で三本落ちていた）。
zerr[s] <- 2 for (s) in 0 .. nstz[0] if zgcn[s, 31] >= 9
field zerrl : min bound 8               # 誤りの行（最初の文の行）
zerrl[zerr[s]] <- tline[hotok[s]] for (s) in 0 .. nstz[0] if zerr[s] >= 1
      if hotok[s] >= 0
field zerra : or bound 1                # 誤りがある（家の表は読むな）
zerra[z] <- true for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if zerr[s] >= 1

# ── 家の規則 = 矢印のある文（種も規則も同じ扱い —— 点が一つの空間） ──
field zisr : or bound 4096              # 文 s は家の規則になる
# 空の区間（`for (s) in 1 .. nstz[0]` で nstz が 0）を持つ文は実例が無い ——
# 家にも点にも要らない（flat.py は空間を作らずに消す）。
field zlemp : or bound 4096             # 文 s に空の区間ループがある
zlemp[zlps[g]] <- true for (g) in 0 .. znglm[0] if lpk[g] >= 1 if zlps[g] >= 0
      if zlphi2[g] <= lplo[g] - 1
zisr[s] <- true for (s) in 0 .. nstz[0] if isseed[s]
zisr[s] <- true for (s) in 0 .. nstz[0] if isrec[s] if not zlemp[s]
field zrc : max bound 4096              # 文 s までの家の規則の数（s を含む）
zrc[0] <- 0                for (z) in 0 .. 0 if not zisr[0]
zrc[0] <- 1                for (z) in 0 .. 0 if zisr[0]
zrc[s] <- zrc[s-1]         for (s) in 1 .. nstz[0] if not zisr[s]
zrc[s] <- zrc[s-1] + 1     for (s) in 1 .. nstz[0] if zisr[s]
field zrn : max bound 4096              # 文 s の家の規則番号（0 起点）
zrn[s] <- zrc[s] - 1       for (s) in 0 .. nstz[0] if zisr[s]
# **書き先の座標は 読み か 一次式**（読み×定数+… は場に置く —— 前段は自分が家になる形で書く）
field zrw3 : max bound 4096             # 規則 r の枠 3（wm の写像）の番号
zrw3[s] <- zrn[s] * 128 + 3 for (s) in 0 .. nstz[0] if zisr[s]
field znr : max bound 1                 # 家の規則の数
znr[z] <- 0 for (z) in 0 .. 0
znr[z] <- zrc[s] for (s) in 0 .. nstz[0] for (z) in 0 .. 0
field znrm : max bound 1                # 引きやすい形（数 - 1）
znrm[z] <- znr[z] - 1 for (z) in 0 .. 0

# ── ループを家の規則番号へ写す ──────────────────────────────────────
field zlpr : max bound 2048             # ループ g の家の規則番号
zlpr[glno[t]] <- zrn[snum[t]] for (t,zc) in ch if isgl[t]
field zngl : max bound 1                # ループの数（無ければ 0）
zngl[z] <- 0 for (z) in 0 .. 0
zngl[z] <- glno[t] + 1 for (t,zc) in ch for (z) in 0 .. 0 if isgl[t]
field znglm : max bound 1
znglm[z] <- zngl[z] - 1 for (z) in 0 .. 0
field zhasl : or bound 4096             # 規則 r はループを持つ
zhasl[zlpr[g]] <- true for (g) in 0 .. znglm[0]

# ── 区間の軸を intern する（同じ (下端, 上端) は一本） ─────────────
# 鍵は (下端, 上端) を一語に畳んだもの（気づき42: 比べたい物そのものに名前を）。
field zlphi2 : max bound 2048           # 区間ループ g の実効の上端
zlphi2[g] <- lphi[g] for (g) in 0 .. znglm[0] if lpk[g] == 1
zlphi2[g] <- zorc[lpbf[g], lpbc[g]] for (g) in 0 .. znglm[0] if lpk[g] == 2
      if lpbf[g] >= 0
# ── 依存する区間（`for (j) in 0 .. n[i] - 1`）: 種3 ────────────────
# 端が外側の変数に依る。多面体は 箱 ∩ 半空間 —— 矩形は場の **最大**
# （口 orc の座標 63）で取り、元の端は半空間のガード `n[i]-1 >= j` として
# fc に合成する（参照実装 flat.py の _family と同じ判断）。
lkd[snum[t], lz[t]] <- 3 for (t,zc) in ch if kwin[t] if isnum[int1[t]]
      if isocc[int4[t]] if tkind[int4b[t]] == 1 if not isnum[int4b[t]]
# 上端が `n[]`（添字なし）なら座標は 0（口 orc の鍵と同じ）
lbc2[snum[t], lz[t]] <- 0 for (t,zc) in ch if kwin[t] if isnum[int1[t]]
      if isocc[int4[t]] if isclo[int4b[t]]
# 上端の升が口 orc に無い（この層でまだ閉じていない —— source など）なら、
# 種2 でも **矩形 × ガード**に落ちる（flat.py: gval が int でない → _family）
field zorch : or bound 1024 64          # 口 orc に (場, 座標) の行がある
zorch[f, c] <- true for (f, c, v) in orc if f >= 0 if c >= 0
lkd[snum[t], lz[t]] <- 3 for (t,zc) in ch if kwin[t] if isnum[int1[t]]
      if isocc[int4[t]] if lbf2[snum[t], lz[t]] >= 0
      if lbc2[snum[t], lz[t]] >= 0
      if not zorch[lbf2[snum[t], lz[t]], lbc2[snum[t], lz[t]]]
field zlbo2 : max bound 4096 8          # 上端の読みの出現（文, 節）
zlbo2[snum[t], lz[t]] <- oint4[t] for (t,zc) in ch if kwin[t]
      if isnum[int1[t]] if isocc[int4[t]]
field zlbo : max bound 2048             # ループ g の上端の読みの出現
zlbo[glno[t]] <- zlbo2[snum[t], lz[t]] for (t,zc) in ch if isgl[t]
field zlps : max bound 2048             # ループ g の文
zlps[glno[t]] <- snum[t] for (t,zc) in ch if isgl[t]
field zlbcl2 : max bound 4096 8         # 上端の読みの閉じ括弧のトークン
zlbcl2[snum[t], lz[t]] <- tnum[zclch[tstart[nextw[int4[t]]]]] for (t,zc) in ch
      if kwin[t] if isnum[int1[t]] if isocc[int4[t]]
      if zclch[tstart[nextw[int4[t]]]] >= 1
field zlhof2 : max bound 4096 8         # 上端の読みの後ろの ± 定数
zlhof2[snum[t], lz[t]] <- 0 for (t,zc) in ch if kwin[t]
      if zlbcl2[snum[t], lz[t]] >= 0
      if not isplus[nextw[zlbcl2[snum[t], lz[t]]]]
      if not ismin[nextw[zlbcl2[snum[t], lz[t]]]]
zlhof2[snum[t], lz[t]] <- tval[nextw[nextw[zlbcl2[snum[t], lz[t]]]]]
      for (t,zc) in ch if kwin[t] if zlbcl2[snum[t], lz[t]] >= 0
      if isplus[nextw[zlbcl2[snum[t], lz[t]]]]
      if isnum[nextw[nextw[zlbcl2[snum[t], lz[t]]]]]
zlhof2[snum[t], lz[t]] <- 0 - tval[nextw[nextw[zlbcl2[snum[t], lz[t]]]]]
      for (t,zc) in ch if kwin[t] if zlbcl2[snum[t], lz[t]] >= 0
      if ismin[nextw[zlbcl2[snum[t], lz[t]]]]
      if isnum[nextw[nextw[zlbcl2[snum[t], lz[t]]]]]
field zlhof : max bound 2048            # ループ g の端のずれ
zlhof[glno[t]] <- zlhof2[snum[t], lz[t]] for (t,zc) in ch if isgl[t]
zlphi2[g] <- zorc[lpbf[g], 63] + zlhof[g] for (g) in 0 .. znglm[0]
      if lpk[g] == 3 if lpbf[g] >= 0
# 測った升が一つも無ければ端は ⊥ —— ガードが全部消すので矩形は一点でよい
zlphi2[g] <- lplo[g] for (g) in 0 .. znglm[0] if lpk[g] == 3
field zrky : max bound 2048             # 区間ループ g の鍵
# 種3 は矩形 (下端, 最大) に書き換わった区間 —— 軸の名は **値**で共有される
# （種1 と同じ鍵。flat.py の region は書き換え後の repr で intern する）
zrky[g] <- lplo[g] * 1048576 + zlphi2[g] for (g) in 0 .. znglm[0]
      if lpk[g] == 1 if zlphi2[g] >= lplo[g]
zrky[g] <- 1099511627776 + lplo[g] * 1073741824 + lpbf[g] * 1048576 + lpbc[g] for (g) in 0 .. znglm[0] if lpk[g] == 2 if lpbf[g] >= 0
      if zlphi2[g] >= lplo[g]
zrky[g] <- lplo[g] * 1048576 + zlphi2[g] for (g) in 0 .. znglm[0]
      if lpk[g] == 3 if zlphi2[g] >= lplo[g]
# 実例の無い文（zlemp —— 別の区間が空）の区間は軸にならない: 代表にも
# 前例にもしない（flat.py は空間を作らずに消すので、その軸の行は出ない）。
field zlive : or bound 2048             # 区間ループ g は実例のある文のもの
zlive[g] <- true for (g) in 0 .. znglm[0] if lpk[g] >= 1 if zlps[g] >= 0
      if not zlemp[zlps[g]]
field zrdup : or bound 2048             # 前に同じ鍵がある
zrdup[g] <- true for (g) in 0 .. znglm[0] for (h) in 0 .. znglm[0]
      if h <= g - 1 if zrky[h] == zrky[g] if zlive[h]
field zrrep : or bound 2048             # 代表（最初の出現）
zrrep[g] <- true for (g) in 0 .. znglm[0] if lpk[g] >= 1 if not zrdup[g]
      if zrky[g] >= 1 if zlive[g]
field zrgc : max bound 2048             # g までの代表の数（g を含む）
zrgc[0] <- 0               for (z) in 0 .. 0 if not zrrep[0]
zrgc[0] <- 1               for (z) in 0 .. 0 if zrrep[0]
zrgc[g] <- zrgc[g-1]       for (g) in 1 .. znglm[0] if not zrrep[g]
zrgc[g] <- zrgc[g-1] + 1   for (g) in 1 .. znglm[0] if zrrep[g]
field znrr : max bound 1                # 区間の軸の数
znrr[z] <- 0 for (z) in 0 .. 0
znrr[z] <- zrgc[g] for (g) in 0 .. znglm[0] for (z) in 0 .. 0

# ── 軸（＝region）の番号。並びは 番兵の一点 / 表 / 区間 ─────────────
field zhasu : or bound 1                # 点が一つの空間を使う規則がある
zhasu[z] <- true for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if zisr[s]
      if not hasfor[s]
# `0 .. 0` の区間は番兵の一点と **同じ軸**（flat.py の region は repr で
# intern するので UNIT と同じ鍵になる —— 測れなかった依存する区間がここに来る）
zhasu[z] <- true for (g) in 0 .. znglm[0] for (z) in 0 .. 0 if lpk[g] >= 1
      if zrky[g] == 0
# ── 表は何枚でもよい。行は **全表を通した鎖**で数え、名前は鍵で引く ──
field ztbs : max bound 4096             # 表の文 s → 表番号（0 起点）
ztbs[s] <- ctb[s] - 1 for (s) in 0 .. nstz[0] if istb[s] if ctb[s] >= 1
field ztrw : max bound 262144           # 全表を通した行番号（1 起点の鎖）
ztrw[0] <- 0
ztrw[t] <- ztrw[t-1] for (t,zc) in ch if t >= 1 if not rowbk[t]
ztrw[t] <- ztrw[t-1] for (t,zc) in ch if t >= 1 if rowbk[t]
      if not istb[snum[t]]
ztrw[t] <- ztrw[t-1] + 1 for (t,zc) in ch if t >= 1 if rowbk[t]
      if istb[snum[t]]
field zisnm : or bound 262144           # 名前の鍵が要るトークン
zisnm[nextw[t]] <- true for (t,zc) in ch if kwtbl[t] if sbrk[t]
zisnm[int1[t]] <- true for (t,zc) in ch if kwin[t] if not isnum[int1[t]]
field zink : max bound 262144 8         # 名前の鍵（文字の鎖）
zink[t, 0] <- tch[t, 0] for (t,zc) in ch if zisnm[t]
zink[t, k] <- zink[t, k-1] * 128 + tch[t, k] for (t,zc) in ch
      for (k) in 1 .. 7 if zisnm[t] if k <= tlen[t] - 1
field ztnk : max bound 262144           # 名前の鍵（頭 8 文字）
ztnk[t] <- zink[t, tlen[t] - 1] for (t,zc) in ch if zisnm[t]
      if tlen[t] >= 1 if tlen[t] <= 8
ztnk[t] <- zink[t, 7] for (t,zc) in ch if zisnm[t] if tlen[t] >= 9
# 長い名前は頭 8 文字では割れない（because_seed / because_unary）——
# 全文字の折り込みを二本目の鍵にする（文字の座標の上の鎖）。
field znmc : or bound 262144            # 名前のトークンに属する文字
znmc[i] <- true for (i,c) in ch if zisnm[tnum[i]]
# 折り込みは 「読み×定数 + 読み」 と 「読み % 法」 の二段に割る（家の値の形）
field zcp1 : flat bound 262144          # 文字 + 1
zcp1[i] <- c + 1 for (i,c) in ch
field zqf1p : flat bound 262144         # 法を取る前
zqf1p[i] <- zcp1[i] for (i,c) in ch if znmc[i] if i == tstart[tnum[i]]
zqf1p[i] <- zqf1[i-1] * 1000003 + zcp1[i] for (i,c) in ch
      if znmc[i] if i >= tstart[tnum[i]] + 1
field zqf1 : flat bound 262144          # 名前の折り込み（文字 i まで）
zqf1[i] <- zqf1p[i] % 268435399 for (i,c) in ch if znmc[i]
field zlast : max bound 262144          # トークンの最後の文字の位置
zlast[t] <- tstart[t] + tlen[t] - 1 for (t,zc) in ch if tlen[t] >= 1
field ztnk2 : max bound 262144          # 名前の鍵（全文字の折り込み）
ztnk2[t] <- zqf1[zlast[t]] for (t,zc) in ch if zisnm[t]
      if tlen[t] >= 1
field ztdn : max bound 262144           # 表の宣言の名前トークン → 表番号
ztdn[nextw[t]] <- ztbs[snum[t]] for (t,zc) in ch if kwtbl[t] if sbrk[t]
      if ztbs[snum[t]] >= 0
field zdnm : or bound 262144            # 表の宣言の名前トークン
zdnm[nextw[t]] <- true for (t,zc) in ch if kwtbl[t] if sbrk[t]
# 名前は **表ごとに引く**（ch × ch の総当たりは 5 万字で 25 億 —— 表の数は
# 小さいので ch × 表。鍵を座標にした疎の場は、自分を家にするとき一巡目の
# 仮の広さ（2^63）が測定器から溢れる —— 前段は自分が家になる形で書く）
field ztbdt : max bound 64              # 表 tb の名前のトークン
ztbdt[ztbs[snum[t]]] <- nextw[t] for (t,zc) in ch if kwtbl[t] if sbrk[t]
      if ztbs[snum[t]] >= 0
field ztbmt : max bound 262144          # 源の名前トークン → 表番号（鍵で引く）
ztbmt[t] <- tb for (t,zc) in ch for (tb) in 0 .. zntb[0] if zisnm[t]
      if not zdnm[t] if ztbdt[tb] >= 0 if ztnk[t] == ztnk[ztbdt[tb]]
      if ztnk2[t] == ztnk2[ztbdt[tb]]
field zltb : max bound 2048             # 表のループ g → 表番号
zltb[glno[t] - 1] <- ztbmt[int1[t]] for (t,zc) in ch if kwin[t]
      if not isnum[int1[t]] if ztbmt[int1[t]] >= 0 if glno[t] >= 1
field ztbud : or bound 64               # 表 tb は源に使われている
ztbud[zltb[g]] <- true for (g) in 0 .. znglm[0] if lpk[g] == 0
      if zltb[g] >= 0
field ztbu : or bound 1                 # 表を源に使うループがある
ztbu[z] <- true for (g) in 0 .. znglm[0] for (z) in 0 .. 0 if lpk[g] == 0
field zntb : max bound 1                # 表の数 - 1
zntb[z] <- 0 for (z) in 0 .. 0
zntb[z] <- ztbs[s] for (s) in 0 .. nstz[0] for (z) in 0 .. 0 if istb[s]
      if ztbs[s] >= 0
field ztbc : max bound 64               # tb までの使われた表の数（tb を含む）
ztbc[0] <- 0 for (z) in 0 .. 0 if not ztbud[0]
ztbc[0] <- 1 for (z) in 0 .. 0 if ztbud[0]
ztbc[tb] <- ztbc[tb-1] for (tb) in 1 .. zntb[0] if not ztbud[tb]
ztbc[tb] <- ztbc[tb-1] + 1 for (tb) in 1 .. zntb[0] if ztbud[tb]
field znu : max bound 1                 # 番兵の軸の数（0 か 1）
znu[z] <- 0 for (z) in 0 .. 0 if not zhasu[z]
znu[z] <- 1 for (z) in 0 .. 0 if zhasu[z]
field znt : max bound 1                 # 表の軸の数
znt[z] <- 0 for (z) in 0 .. 0 if not ztbu[z]
znt[z] <- ztbc[tb] for (tb) in 0 .. zntb[0] for (z) in 0 .. 0 if ztbu[z]
field znq : max bound 1                 # 軸の数ぜんぶ
# **前段は自分が家になる形で書く**: 直の読みは二本まで（am/bm）。三本目からは
# 中間の場に畳む（家の値の形は am + bm + wm）。
field znut : max bound 1                # 使用の軸 + 表の軸
znut[z] <- znu[z] + znt[z] for (z) in 0 .. 0
znq[z] <- znut[z] + znrr[z] for (z) in 0 .. 0
field znqm : max bound 1
znqm[z] <- znq[z] - 1 for (z) in 0 .. 0
field zqoft : max bound 64              # 表 tb の軸の番号
zqoft[tb] <- znu[z] + ztbc[tb] - 1 for (tb) in 0 .. zntb[0]
      for (z) in 0 .. 0 if ztbud[tb] if ztbc[tb] >= 1
field zrgno : max bound 2048            # 区間ループ g の軸の番号（代表）
zrgno[g] <- znut[z] + zrgc[g] - 1 for (g) in 0 .. znglm[0]
      for (z) in 0 .. 0 if zrrep[g]
field zrgof : max bound 2048            # 区間ループ g の軸の番号（全員）
zrgof[g] <- zrgno[h] for (g) in 0 .. znglm[0] for (h) in 0 .. znglm[0]
      if lpk[g] >= 1 if zrrep[h] if zrky[h] == zrky[g]
zrgof[g] <- 0 for (g) in 0 .. znglm[0] if lpk[g] >= 1 if zrky[g] == 0

# ── 軸の属性: 幅・下端・中身の列数（表ごと） ────────────────────────
# `table steps = range(0, 18)` は **半開区間の省略記法**である —— 参照実装は
# 18 行（0..17）に開く。字句の上では一行二列 (0, 18) にしか見えないので、
# `range` の語を見た表だけ、行を区間として開き直す。
field ztrgt : or bound 64               # 表 tb は range(...) で書かれている
# ガードは一文に八つまで（家の席 8）—— 語の照合は二段に割る
field zkwrg : or bound 262144           # `range` の語
zkwrg[t] <- true for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 114 if tch[t,1] == 97 if tch[t,2] == 110
      if tch[t,3] == 103 if tch[t,4] == 101
ztrgt[ztbs[snum[t]]] <- true for (t,zc) in ch if istb[snum[t]] if zkwrg[t]
      if ztbs[snum[t]] >= 0
field ztrmin : min bound 64             # 表 tb の最初の行（通し番号）
ztrmin[ztbs[snum[t]]] <- ztrw[t] for (t,zc) in ch if rowbk[t]
      if istb[snum[t]] if ztbs[snum[t]] >= 0
field ztrmax : max bound 64             # 表 tb の最後の行（通し番号）
ztrmax[ztbs[snum[t]]] <- ztrw[t] for (t,zc) in ch if rowbk[t]
      if istb[snum[t]] if ztbs[snum[t]] >= 0
field ztlot : max bound 64              # range の下端
ztlot[ztbs[snum[t]]] <- tval[nextw[t]] for (t,zc) in ch
      if istb[snum[t]] if rowbk[t] if ztrgt[ztbs[snum[t]]]
      if ztbs[snum[t]] >= 0
field zthit : max bound 64              # range の上端（半開）
zthit[ztbs[snum[t]]] <- tval[nextw[nextw[nextw[t]]]] for (t,zc) in ch
      if istb[snum[t]] if rowbk[t] if ztrgt[ztbs[snum[t]]]
      if ztbs[snum[t]] >= 0
field ztbnn : max bound 64              # 表 tb の行の数
ztbnn[tb] <- ztrmax[tb] - ztrmin[tb] + 1 for (tb) in 0 .. zntb[0]
      if not ztrgt[tb] if ztrmax[tb] >= ztrmin[tb]
ztbnn[tb] <- zthit[tb] - ztlot[tb] for (tb) in 0 .. zntb[0]
      if ztrgt[tb] if zthit[tb] >= ztlot[tb]
field zncolt : max bound 64             # 表 tb の列の数 - 1
zncolt[ztbs[snum[t]]] <- colc[t] for (t,zc) in ch if isnum[t]
      if istb[snum[t]] if tdep[t] == 1 if ztbs[snum[t]] >= 0
zncolt[ztbs[snum[t]]] <- colc[t] for (t,zc) in ch if zqtk[t]
      if ztbs[snum[t]] >= 0
field zqw : max bound 64                # 軸 q の幅（行の数）
zqw[0] <- 1 for (z) in 0 .. 0 if zhasu[z]
zqw[zqoft[tb]] <- ztbnn[tb] for (tb) in 0 .. zntb[0] if ztbud[tb]
      if zqoft[tb] >= 0 if ztbnn[tb] >= 1
zqw[zrgno[g]] <- zlphi2[g] - lplo[g] + 1 for (g) in 0 .. znglm[0]
      if zrrep[g] if zlphi2[g] >= lplo[g]
field zqb : max bound 64                # 軸 q の基（前置きの鎖。行 0 は空けておく）
zqb[0] <- 1
zqb[q] <- zqb[q-1] + zqw[q-1] for (q) in 1 .. znqm[0]

# ── dat: 軸の中身 ──────────────────────────────────────────────────
field ztbh2 : or bound 8192 8           # (通し行, 列) に数が書いてある
ztbh2[ztrw[t], colc[t]] <- true for (t,zc) in ch if isnum[t]
      if istb[snum[t]] if tdep[t] == 1 if ztrw[t] >= 1
field ztbv : max bound 8192 8           # (通し行, 列) の値
ztbv[ztrw[t], colc[t]] <- tval[t] for (t,zc) in ch if isnum[t]
      if istb[snum[t]] if tdep[t] == 1 if ztrw[t] >= 1
field ztsp2 : max bound 64              # 表 tb の行の数 - 1
ztsp2[tb] <- ztbnn[tb] - 1 for (tb) in 0 .. zntb[0] if ztbnn[tb] >= 1
field zdat : max bound 8192 8           # 家の dat（行, 列 → 値）
zdat[1, 0] <- 0 for (z) in 0 .. 0 if zhasu[z]
# 書き先の座標は 読み か 一次式 —— 「深い読み + 変数」は行の場に置く
field zdrt : max bound 64 1024          # 表 tb の i 行目の dat の行
zdrt[tb, i] <- zqb[zqoft[tb]] + i for (tb) in 0 .. zntb[0]
      for (i) in 0 .. ztsp2[tb] if ztbud[tb] if zqoft[tb] >= 0
field zdsr : max bound 64 1024          # 表 tb の i 行目の源の行（ztbv の行）
zdsr[tb, i] <- ztrmin[tb] + i for (tb) in 0 .. zntb[0]
      for (i) in 0 .. ztsp2[tb] if ztbud[tb]
zdat[zdrt[tb, i], c] <- ztbv[zdsr[tb, i], c] for (tb) in 0 .. zntb[0]
      for (i) in 0 .. ztsp2[tb] for (c) in 0 .. zncolt[tb] if ztbud[tb]
      if not ztrgt[tb] if ztbh2[zdsr[tb, i], c] if zqoft[tb] >= 0
zdat[zdrt[tb, i], c] <- 0 for (tb) in 0 .. zntb[0]
      for (i) in 0 .. ztsp2[tb] for (c) in 0 .. zncolt[tb] if ztbud[tb]
      if not ztrgt[tb] if not ztbh2[zdsr[tb, i], c] if zqoft[tb] >= 0
zdat[zdrt[tb, i], 0] <- ztlot[tb] + i for (tb) in 0 .. zntb[0]
      for (i) in 0 .. ztsp2[tb] if ztbud[tb] if ztrgt[tb] if zqoft[tb] >= 0
zdat[zdrt[tb, i], c] <- ztbva[zdsr[tb, i], c] for (tb) in 0 .. zntb[0]
      for (i) in 0 .. ztsp2[tb] for (c) in 0 .. zncolt[tb] if ztbud[tb]
      if not ztrgt[tb] if ztbva[zdsr[tb, i], c] >= 1 if zqoft[tb] >= 0
field zrspan : max bound 2048           # 区間ループ g の幅 - 1（数え上げの上端）
zrspan[g] <- zlphi2[g] - lplo[g] for (g) in 0 .. znglm[0]
      if zrrep[g] if zlphi2[g] >= lplo[g]
field zqbg : max bound 2048             # 区間ループ g の軸の基の行
zqbg[g] <- zqb[zrgno[g]] for (g) in 0 .. znglm[0] if zrrep[g]
zdat[zqbg[g] + i, 0] <- lplo[g] + i for (g) in 0 .. znglm[0]
      for (i) in 0 .. zrspan[g] if zrrep[g]

# ── 規則の軸の列（枠は四つ。0 は「無い」、q+1 が入る） ───────────────
field zax : max bound 4096 4            # 規則 r の j 番目の軸 + 1
zax[r, j] <- 0 for (r) in 0 .. znrm[0] for (j) in 0 .. 3
zax[zlpr[g], lpi[g]] <- zqoft[zltb[g]] + 1 for (g) in 0 .. znglm[0]
      if lpk[g] == 0 if zltb[g] >= 0 if zqoft[zltb[g]] >= 0
zax[zlpr[g], lpi[g]] <- zrgof[g] + 1 for (g) in 0 .. znglm[0] if lpk[g] >= 1
zax[zrn[s], 0] <- 1 for (s) in 0 .. nstz[0] if zisr[s] if not hasfor[s]

# ── 空間を intern する（鍵 = 軸の列を一語に畳む） ───────────────────
field zsig : max bound 4096             # 規則 r の空間の鍵
field zsig1 : max bound 4096            # 鍵の下半分（軸 0・1）
zsig1[r] <- zax[r,0] + zax[r,1] * 128 for (r) in 0 .. znrm[0] if zax[r,0] >= 0
zsig[r] <- zsig1[r] + zax[r,2] * 4096 + zax[r,3] * 262144
      for (r) in 0 .. znrm[0] if zax[r,0] >= 0
field zsdup : or bound 4096
zsdup[r] <- true for (r) in 0 .. znrm[0] for (h) in 0 .. znrm[0]
      if h <= r - 1 if zsig[h] == zsig[r]
field zsrep : or bound 4096             # 代表（最初の規則）
zsrep[r] <- true for (r) in 0 .. znrm[0] if not zsdup[r]
field zsc : max bound 4096              # r までの代表の数
zsc[0] <- 0              for (z) in 0 .. 0 if not zsrep[0]
zsc[0] <- 1              for (z) in 0 .. 0 if zsrep[0]
zsc[r] <- zsc[r-1]       for (r) in 1 .. znrm[0] if not zsrep[r]
zsc[r] <- zsc[r-1] + 1   for (r) in 1 .. znrm[0] if zsrep[r]
field znsp : max bound 1                # 空間の数
znsp[z] <- 0 for (z) in 0 .. 0
znsp[z] <- zsc[r] for (r) in 0 .. znrm[0] for (z) in 0 .. 0
field znspm : max bound 1
znspm[z] <- znsp[z] - 1 for (z) in 0 .. 0
field zspno : max bound 4096            # 代表 r の空間番号
zspno[r] <- zsc[r] - 1 for (r) in 0 .. znrm[0] if zsrep[r]
field zspof : max bound 4096            # 規則 r の空間番号（全員）
zspof[r] <- zspno[h] for (r) in 0 .. znrm[0] for (h) in 0 .. znrm[0]
      if zsrep[h] if zsig[h] == zsig[r]
field zspr : max bound 64               # 空間 sp の代表の規則
zspr[zspno[r]] <- r for (r) in 0 .. znrm[0] if zsrep[r]

# ── 空間の行: 基・幅・歩幅・点の数 ──────────────────────────────────
field zsax : max bound 64 4             # 空間 sp の j 番目の軸
zsax[sp, j] <- zax[zspr[sp], j] - 1 for (sp) in 0 .. znspm[0] for (j) in 0 .. 3
      if zax[zspr[sp], j] >= 1
field zsn : max bound 64                # 空間 sp の軸の数
zsn[sp] <- j + 1 for (sp) in 0 .. znspm[0] for (j) in 0 .. 3
      if zax[zspr[sp], j] >= 1
field zspb : max bound 64 4             # spc の基
zspb[sp, j] <- zqb[zsax[sp, j]] for (sp) in 0 .. znspm[0] for (j) in 0 .. 3
      if zax[zspr[sp], j] >= 1
field zspw : max bound 64 4             # spc の幅
zspw[sp, j] <- zqw[zsax[sp, j]] for (sp) in 0 .. znspm[0] for (j) in 0 .. 3
      if zax[zspr[sp], j] >= 1
field zsps : flat bound 64 4            # spc の歩幅（後ろの軸の幅の積）。**鎖は flat** —— 層は座標である（軸に沿った展開を要らなくする: flat は ⊥→v で剰余も積も単調）
zsps[sp, j] <- 1 for (sp) in 0 .. znspm[0] for (j) in 0 .. 3
      if j == zsn[sp] - 1
zsps[sp, j] <- zsps[sp, j+1] * zspw[sp, j+1] for (sp) in 0 .. znspm[0]
      for (j) in 0 .. 2 if j <= zsn[sp] - 2
field zssz : max bound 64               # 点の数
zssz[sp] <- zsps[sp, 0] * zspw[sp, 0] for (sp) in 0 .. znspm[0]
      if zsps[sp, 0] >= 1

print zdat
print zspb
print zspw
print zsps
print zssz
print zspof

# ══ 二枚目 —— 場の置き場・写像・fg / fc / fp ═══════════════════════
#
# 番地 = 場の基 + Σ (座標 + 64) · 歩幅。場の基は **名前の辞書順**の
# 前置きの鎖（dkey がそのまま順序である —— 名前とは座標である。気づき22）。
# 写像は intern しない —— 規則 r の枠 k に番号 r·32+k で置く。番号は
# ラベルであって意味を持たない（突き合わせは中身で比べる）。

# ── 場の置き場（lay） ───────────────────────────────────────────────
# dkey は **綴りの長さぶんだけ**詰めた鍵なので、短い名前ほど小さくなって
# 辞書順にならない（"far" < "dist"）。左詰めに直す —— 8 文字ぶんに伸ばす。
field zp128 : max bound 16              # 128 のべき（鎖）
zp128[0] <- 1
zp128[k] <- zp128[k-1] * 128 for (k) in 1 .. 8
field zfln : max bound 1024             # 場 f の名前の長さ
zfln[fdno[t]] <- tlen[t] for (t,zc) in ch if isdcl[t]
field zfky : max bound 1024             # 左詰めの鍵（辞書順 = 数の順）
field zfln8 : max bound 1024            # 8 − 名前の長さ（座標の「定数 − 読み」は場に置く）
zfln8[f] <- 8 - zfln[f] for (f) in 0 .. nfdz[0] if zfln[f] <= 8
zfky[f] <- dkey[f+1] * zp128[zfln8[f]] for (f) in 0 .. nfdz[0]
      if zfln[f] <= 8
zfky[f] <- dkey[f+1] for (f) in 0 .. nfdz[0] if zfln[f] >= 9
field zfles : or bound 1024 1024        # 場 f の名は場 g の名より小さい
zfles[f,g] <- true for (f) in 0 .. znf2m[0] for (g) in 0 .. znf2m[0]
      if zfk1[f] <= zfk1[g] - 1
zfles[f,g] <- true for (f) in 0 .. znf2m[0] for (g) in 0 .. znf2m[0]
      if zfk1[f] == zfk1[g] if zfk2[f] <= zfk2[g] - 1
zfles[f,g] <- true for (f) in 0 .. znf2m[0] for (g) in 0 .. znf2m[0]
      if zfk1[f] == zfk1[g] if zfk2[f] == zfk2[g] if zfk3[f] <= zfk3[g] - 1
field zfrk : count bound 1024           # 辞書順の順位 + 1
zfrk[f] <- 1 for (f) in 0 .. znf2m[0]
zfrk[f] <- 1 for (f) in 0 .. znf2m[0] for (g) in 0 .. znf2m[0]
      if zfles[g,f]
field zford : max bound 1024            # 順位 → 場
zford[zfrk[f] - 1] <- f for (f) in 0 .. znf2m[0] if zfrk[f] >= 1
field zfna : max bound 1024             # 次数（1 / 2 / 3）
zfna[f] <- farr[f] for (f) in 0 .. nfdz[0]
zfna[ofl[o] - 1] <- 3 for (o) in 0 .. nocz[0] if okk[o] == 2
      if zd2[o] >= 0 if ofl[o] >= 1
# 書き手の無い場（source）の次数は **読まれ方**が言う
zfna[ofl[o] - 1] <- 1 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
zfna[ofl[o] - 1] <- 2 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zd1[o] >= 0
zfna[ofl[o] - 1] <- 3 for (o) in 0 .. nocz[0] if oin[o] if ofl[o] >= 1
      if zhas2[o]
zfna[f] <- 1 for (f) in 0 .. znf2m[0] for (z) in 0 .. 0 if f >= znf0[z]
# 使われない場（宣言だけ —— 自己適用で zanp が出た）も置き場を持つ: 次数 0、
# 升は一つ（flat.py の lay は使われ方の次数で並べ、次数 0 は sz [1]）。
field zfusd : or bound 1024             # 場 f は使われている（次数がある）
zfusd[f] <- true for (f) in 0 .. znf2m[0] if zfna[f] >= 1
field zfsz0 : max bound 1024            # 次元0 の広さ（宣言 + 64 / 測った幅）
zfsz0[f] <- fwid[f] + 64 for (f) in 0 .. nfdz[0] if zfbnd[f]
      if not zexu[f, 0]
zfsz0[f] <- zexth[f, 0] - zextl[f, 0] + 1 for (f) in 0 .. nfdz[0]
      if not zfbnd[f] if zfused[f, 0] if zexth[f, 0] >= zextl[f, 0]
      if not zexu[f, 0]
zfsz0[f] <- 1 for (f) in 0 .. nfdz[0] if not zfbnd[f] if not zfused[f, 0]
      if not zexu[f, 0]
zfsz0[f] <- zexw[f, 0] for (f) in 0 .. znf2m[0] if zexu[f, 0]
field zfsz1 : max bound 1024            # 次元1 の広さ（宣言 + 64 / 測った幅）
zfsz1[f] <- fwid2[f] + 64 for (f) in 0 .. nfdz[0] if zfna[f] == 2
      if zfbnd[f] if not zexu[f, 1]
zfsz1[f] <- zexth[f, 1] - zextl[f, 1] + 1 for (f) in 0 .. nfdz[0]
      if zfna[f] == 2 if not zfbnd[f] if zfused[f, 1]
      if zexth[f, 1] >= zextl[f, 1] if not zexu[f, 1]
zfsz1[f] <- zexth[f, 1] - zextl[f, 1] + 1 for (f) in 0 .. nfdz[0]
      if zfna[f] == 3 if not zfbnd[f] if zfused[f, 1]
      if zexth[f, 1] >= zextl[f, 1] if not zexu[f, 1]
zfsz1[f] <- 1 for (f) in 0 .. nfdz[0] if zfna[f] == 2 if not zfbnd[f]
      if not zfused[f, 1] if not zexu[f, 1]
zfsz1[f] <- zexw[f, 1] for (f) in 0 .. znf2m[0] if zexu[f, 1]
field zfsz2 : max bound 1024            # 次元2 の広さ（測った幅）
zfsz2[f] <- zexth[f, 2] - zextl[f, 2] + 1 for (f) in 0 .. nfdz[0]
      if zfna[f] == 3 if not zfbnd[f] if zfused[f, 2]
      if zexth[f, 2] >= zextl[f, 2]
zfsz2[f] <- 1 for (f) in 0 .. nfdz[0] if zfna[f] == 3 if not zfbnd[f]
      if not zfused[f, 2]
field zfna0 : or bound 1024             # 添字なしで使われる場
zfna0[ofl[oseq[t]] - 1] <- true for (t,zc) in ch if isocc[t] if isclo[t+2]
      if ofl[oseq[t]] >= 1
field zfvol : max bound 1024            # 升の数
zfvol[f] <- 1 for (f) in 0 .. znf2m[0] if zfna0[f]
zfvol[f] <- 1 for (f) in 0 .. znf2m[0] if not zfusd[f]
zfvol[f] <- zfsz0[f] for (f) in 0 .. znf2m[0] if zfna[f] == 1
      if not zfna0[f]
zfvol[f] <- zfsz0[f] * zfsz1[f] for (f) in 0 .. znf2m[0] if zfna[f] == 2
      if not zfna0[f]
zfvol[f] <- zfsz0[f] * zfsz1[f] * zfsz2[f] for (f) in 0 .. znf2m[0]
      if zfna[f] == 3 if not zfna0[f]
field zfs0 : max bound 1024             # 次元0 の歩幅
zfs0[f] <- 1 for (f) in 0 .. znf2m[0] if zfna[f] == 1
zfs0[f] <- zfsz1[f] for (f) in 0 .. znf2m[0] if zfna[f] == 2
zfs0[f] <- zfsz1[f] * zfsz2[f] for (f) in 0 .. znf2m[0] if zfna[f] == 3
field zfs1 : max bound 1024             # 次元1 の歩幅
zfs1[f] <- 1 for (f) in 0 .. znf2m[0] if zfna[f] <= 2
zfs1[f] <- zfsz2[f] for (f) in 0 .. znf2m[0] if zfna[f] == 3
field zfbk : max bound 1024             # 順位 k の基（前置きの鎖）
zfbk[0] <- 0
zfbk[k] <- zfbk[k-1] + zfvol[zford[k-1]] for (k) in 1 .. znf2m[0]
field zfb : max bound 1024              # 場 f の基
zfb[f] <- zfbk[zfrk[f] - 1] for (f) in 0 .. znf2m[0] if zfrk[f] >= 1
field zkwst : or bound 524288           # `set` の語
zkwst[t] <- true for (t,zc) in ch if tlen[t] == 3 if not tcom[t]
      if tch[t,0] == 115 if tch[t,1] == 101 if tch[t,2] == 116
field zkw4 : or bound 524288            # `fourv` の語
zkw4[t] <- true for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 102 if tch[t,1] == 111 if tch[t,2] == 117
      if tch[t,3] == 114 if tch[t,4] == 118
field zlatf : max bound 1024            # 束（flat.py の番号: flat は 5）
zlatf[f] <- flatt[f] for (f) in 0 .. nfdz[0] if flatt[f] <= 3
zlatf[f] <- 5 for (f) in 0 .. nfdz[0] if flatt[f] == 6
zlatf[f] <- flatt[f] for (f) in 0 .. nfdz[0] if flatt[f] >= 8
zlatf[fdno[t]] <- 6 for (t,zc) in ch if isdcl[t] if zkw4[latt[t]]
zlatf[fdno[t]] <- 7 for (t,zc) in ch if isdcl[t] if zkwst[latt[t]]
zlatf[zszf[z]] <- 2 for (z) in 0 .. 0 if zhuse[z]
field zlva : or bound 1024              # 生きたまま読める昇る束（2,3,5,6,9 → −束）
zlva[f] <- true for (f) in 0 .. nfdz[0] if zlatf[f] >= 2 if zlatf[f] <= 3
zlva[f] <- true for (f) in 0 .. nfdz[0] if zlatf[f] >= 5 if zlatf[f] <= 6
zlva[f] <- true for (f) in 0 .. nfdz[0] if zlatf[f] == 9
zlatf[f] <- 5 for (f) in 0 .. znf2m[0] for (z) in 0 .. 0 if f >= znf0[z] + 1
field zfws : max bound 1024             # 場 f を書く最大の層（fstr）
# 書き手の無い場（source、宣言だけの場）は −1 —— どの層から読んでも閉じている
# （flat.py の fstr.get(f, -1) と同じ）。書き手があれば max がそちらを取る。
zfws[f] <- 0 - 1 for (f) in 0 .. nfdz[0]
# **実例の無い文（zlemp）も書き手である** —— flat.py の fstr は全規則の最大
# （消える規則も数える）。読みが生きているか閉じているかの判断が揃う。
zfws[hfz[s]] <- zlevel[s] for (s) in 0 .. nstz[0] if isrec[s] if hfz[s] >= 0
zfws[hfz[s]] <- zlevel[s] for (s) in 0 .. nstz[0] if isseed[s] if hfz[s] >= 0

# ── 外界との往復（`source x : lat from "ch"`）—— 応答を読む規則は、その
# チャネルへ emit する規則（emit_ch を書く規則）より真に後の層に居る。
# 非単調な読みと同じ +1 の辺。チャネルの場は emit_ch という名の場なので、
# チャネルの語から **その名の鍵**を作って宣言に行き当てる（辺の表は要らない）。
field zsrcw : max bound 262144          # source の宣言 t → チャネルの語のトークン
zsrcw[t] <- nextw[nextw[nextw[nextw[nextw[t]]]]] for (t,zc) in ch if isdcl[t]
      if kwsrc[prevw[t]]
field zskc : max bound 262144 16        # emit_ + 語 の鍵の鎖（k 文字目まで）
zskc[zsrcw[t], 0] <- 3499815153536 + tch[zsrcw[t], 0] for (t,zc) in ch   # 27342305887 * 128（定数どうしの積は畳んで書く）
      if isdcl[t] if kwsrc[prevw[t]] if zsrcw[t] >= 0
zskc[w, k] <- zskc[w, k-1] * 128 + tch[w, k] for (w,zc) in ch for (k) in 1 .. 2
      if zskc[w, k-1] >= 1 if k <= tlen[w] - 1
zskc[w, 3] <- tch[w, 3] for (w,zc) in ch if zskc[w, 0] >= 1 if tlen[w] >= 4
zskc[w, k] <- zskc[w, k-1] * 128 + tch[w, k] for (w,zc) in ch for (k) in 4 .. 10
      if zskc[w, k-1] >= 1 if k <= tlen[w] - 1
field zsk1 : max bound 262144           # 鍵（1〜8 文字目 = emit_ + 語の頭 3 字）
zsk1[w] <- zskc[w, k] for (w,zc) in ch for (k) in 0 .. 2 if zskc[w, 0] >= 1
field zsk2 : max bound 262144           # 鍵（9〜16 文字目 = 語の 4 字目から）
zsk2[w] <- 0 for (w,zc) in ch if zskc[w, 0] >= 1
zsk2[w] <- zskc[w, k] for (w,zc) in ch for (k) in 3 .. 10 if zskc[w, 0] >= 1
field zsrcf : max bound 1024            # source の場 f → チャネルの場（0 起点）
zsrcf[fdno[t]] <- d - 1 for (t,zc) in ch for (d) in 0 .. ndcz[0] if isdcl[t]
      if kwsrc[prevw[t]] if zsrcw[t] >= 0 if din[d]
      if dkey[d] == zsk1[zsrcw[t]] if dkey2[d] == zsk2[zsrcw[t]]
zlvl[osn[o], k + 1] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 126 if oin[o]
      if not ohd[o] if ofl[o] >= 1 if zsrcf[ofl[o] - 1] >= 0
      if zwlv[zsrcf[ofl[o] - 1] + 1, k]
zlvg[osn[o], k + 1] <- true for (o) in 0 .. nocz[0] for (k) in 0 .. 126 if oin[o]
      if not ohd[o] if ofl[o] >= 1 if zsrcf[ofl[o] - 1] >= 0
      if zwlv[zsrcf[ofl[o] - 1] + 1, k] if not zoval[o]

# ── 規則の頭・層・束 ────────────────────────────────────────────────
field zsr : max bound 8192              # 出現 o の家の規則番号
zsr[o] <- zrn[osn[o]] for (o) in 0 .. nocz[0] if zrn[osn[o]] >= 0
field zho : max bound 4096              # 規則 r の頭の出現
zho[zsr[o]] <- o for (o) in 0 .. nocz[0] if okk[o] == 2 if zsr[o] >= 0
field zfgst : max bound 4096            # fg の層
zfgst[zrn[s]] <- zlevel[s] for (s) in 0 .. nstz[0] if zisr[s] if zrn[s] >= 0
field zfglat : max bound 4096           # fg の束
zfglat[zrn[s]] <- zlatf[hfz[s]] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0
field zsszr : max bound 4096            # 規則 r の空間の点の数
zsszr[r] <- zssz[zspof[r]] for (r) in 0 .. znrm[0] if zspof[r] >= 0

# ── 出現の座標 → 番地の写像の部品（1次元だけ。符号付きのずれ） ──────
field zoar0 : or bound 8192             # 出現 o は添字なし（`n[]`）
zoar0[oseq[t]] <- true for (t,zc) in ch if isocc[t] if isclo[t+2]
field zsof : max bound 8192             # 出現 o のずれ（符号付き）
zsof[oseq[t]] <- 0 for (t,zc) in ch if isocc[t] if not ixhf[t+2]
      if not isocc[t+2]
zsof[oseq[t]] <- ixnv[t+2] for (t,zc) in ch if isocc[t]
      if isplus[ixop[t+2]] if isnum[ixnm[t+2]]
zsof[oseq[t]] <- 0 - ixnv[t+2] for (t,zc) in ch if isocc[t]
      if ismin[ixop[t+2]] if isnum[ixnm[t+2]]
# 次元0 が読みで、閉じ括弧の後ろに ± 数が続く形（mulop[ast[k]-1]）
field zdrc0 : max bound 8192            # 内の読みの閉じ括弧のトークン
zdrc0[oseq[t]] <- tnum[zclch[tstart[nextw[t+2]]]] for (t,zc) in ch
      if isocc[t] if isocc[t+2] if zclch[tstart[nextw[t+2]]] >= 1
zsof[oseq[t]] <- 0 for (t,zc) in ch if isocc[t] if isocc[t+2]
      if zdrc0[oseq[t]] >= 0
      if not isplus[nextw[zdrc0[oseq[t]]]]
      if not ismin[nextw[zdrc0[oseq[t]]]]
zsof[oseq[t]] <- tval[nextw[nextw[zdrc0[oseq[t]]]]] for (t,zc) in ch
      if isocc[t] if isocc[t+2] if zdrc0[oseq[t]] >= 0
      if isplus[nextw[zdrc0[oseq[t]]]]
      if isnum[nextw[nextw[zdrc0[oseq[t]]]]]
zsof[oseq[t]] <- 0 - tval[nextw[nextw[zdrc0[oseq[t]]]]] for (t,zc) in ch
      if isocc[t] if isocc[t+2] if zdrc0[oseq[t]] >= 0
      if ismin[nextw[zdrc0[oseq[t]]]]
      if isnum[nextw[nextw[zdrc0[oseq[t]]]]]
# 次元0 が 読み + 変数（`zdat[zqb[zrgno[g]] + i, 0]`）—— 読みは間接（枠）、
# 変数は写像の枠（flat.py の pcell: 一次式 + 間接）。ずれは 0。
field zd0rv : or bound 8192             # 出現 o の次元0 は 読み + 変数
zd0rv[oseq[t]] <- true for (t,zc) in ch if isocc[t] if isocc[t+2]
      if zdrc0[oseq[t]] >= 0 if isplus[nextw[zdrc0[oseq[t]]]]
      if tkind[nextw[nextw[zdrc0[oseq[t]]]]] == 1
      if not isnum[nextw[nextw[zdrc0[oseq[t]]]]]
      if not isocc[nextw[nextw[zdrc0[oseq[t]]]]]
field zd0rvt : max bound 8192           # その変数のトークン
zd0rvt[oseq[t]] <- nextw[nextw[zdrc0[oseq[t]]]] for (t,zc) in ch if isocc[t]
      if isocc[t+2] if zdrc0[oseq[t]] >= 0 if zd0rv[oseq[t]]
zsof[o] <- 0 for (o) in 0 .. nocz[0] if zd0rv[o]
# ── 束縛 6/7 の補い —— 33_self の照合は bp0..bp5（六変数）まで。
# `for (pc,op,d,s1,s2,tg) in prog for (v) in vars` の v は 7 本目である。
field zbp6 : max bound 4096             # 文 s の 6 番目の束縛
zbp6[snum[t]] <- t for (t,zc) in ch if isbind[t] if bnum[t] == 6
field zub6 : max bound 262144
zub6[t] <- zbp6[snum[t]] for (t,zc) in ch
field zvd6 : or bound 262144
zvd6[t] <- true for (t,zc) in ch for (k) in 0 .. 7
      if tch[t,k] != tch[zub6[t],k]
field zvm6 : or bound 262144
zvm6[t] <- true for (t,zc) in ch if tkind[t] == 1 if zub6[t] >= 0
      if tlen[t] == tlen[zub6[t]] if not zvd6[t]
field zbp7 : max bound 4096             # 文 s の 7 番目の束縛
zbp7[snum[t]] <- t for (t,zc) in ch if isbind[t] if bnum[t] == 7
field zub7 : max bound 262144
zub7[t] <- zbp7[snum[t]] for (t,zc) in ch
field zvd7 : or bound 262144
zvd7[t] <- true for (t,zc) in ch for (k) in 0 .. 7
      if tch[t,k] != tch[zub7[t],k]
field zvm7 : or bound 262144
zvm7[t] <- true for (t,zc) in ch if tkind[t] == 1 if zub7[t] >= 0
      if tlen[t] == tlen[zub7[t]] if not zvd7[t]
field zvbnd : max bound 262144          # 補いの束縛トークン
zvbnd[t] <- zub6[t] for (t,zc) in ch if zvm6[t]
zvbnd[t] <- zub7[t] for (t,zc) in ch if zvm7[t]
field zvlpz : max bound 262144          # vlpz + 束縛 6/7 の補い
zvlpz[t] <- vlpz[t] for (t,zc) in ch
zvlpz[t] <- lseq[zvbnd[t]] - 1 for (t,zc) in ch if zvbnd[t] >= 0
field zvcolz : max bound 262144         # vcolz + 束縛 6/7 の補い
zvcolz[t] <- vcolz[t] for (t,zc) in ch
zvcolz[t] <- colc[zvbnd[t]] for (t,zc) in ch if zvbnd[t] >= 0

field zoj : max bound 8192              # 出現 o の添字の for 節（源0/1 のとき）
zoj[oseq[t]] <- zvlpz[t+2] for (t,zc) in ch if isocc[t] if ixsr[t+2] <= 1
field zinoc : max bound 8192            # 出現 o の添字の中の読み（入れ子）
zinoc[oseq[t]] <- oseq[t+2] for (t,zc) in ch if isocc[t] if isocc[t+2]

# ── 次元ごとの座標の部品（0 列 / 1 計数器 / 4 定数 / 7 読み） ────────
field zd1 : max bound 8192              # 次元1 の添字トークン
zd1[oseq[t]] <- d1t[t] for (t,zc) in ch if isocc[t] if iscom[d0cm[t]]
field zdk : max bound 8192 3
zdk[oseq[t], 0] <- 4 for (t,zc) in ch if isocc[t] if isnum[t+2]
# 負の定数の座標（`quotes[-1] <- 0` の種）—— `-` と数の二語で一つの定数
field zdneg : or bound 8192             # 次元0 の定数が負
zdneg[oseq[t]] <- true for (t,zc) in ch if isocc[t] if ismin[t+2]
      if isnum[t+3]
field zdnv : max bound 8192             # その絶対値
zdnv[oseq[t]] <- tval[t+3] for (t,zc) in ch if isocc[t] if ismin[t+2]
      if isnum[t+3]
zdk[oseq[t], 0] <- 4 for (t,zc) in ch if isocc[t] if ismin[t+2]
      if isnum[t+3]
zdk[oseq[t], 0] <- 7 for (t,zc) in ch if isocc[t] if isocc[t+2]
# 次元0 が「定数 + 読み」（`out[120 + off[i]]`、後ろの `+ 1` も定数の和へ）
field zdcr : or bound 8192              # 次元0 は 定数 + 読み
zdcr[oseq[t]] <- true for (t,zc) in ch if isocc[t] if isnum[t+2]
      if isplus[nextw[t+2]] if isocc[nextw[nextw[t+2]]]
zdk[oseq[t], 0] <- 7 for (t,zc) in ch if isocc[t] if isnum[t+2]
      if isplus[nextw[t+2]] if isocc[nextw[nextw[t+2]]]
zdro[oseq[t], 0] <- oseq[nextw[nextw[t+2]]] for (t,zc) in ch if isocc[t]
      if isnum[t+2] if isplus[nextw[t+2]] if isocc[nextw[nextw[t+2]]]
field zdcs : sum bound 8192             # その定数の和（頭 + 末尾のずれ）
zdcs[oseq[t]] <- tval[t+2] for (t,zc) in ch if isocc[t] if isnum[t+2]
      if isplus[nextw[t+2]] if isocc[nextw[nextw[t+2]]]
field zdcri : max bound 8192            # その内の読みのトークン
zdcri[oseq[t]] <- nextw[nextw[t+2]] for (t,zc) in ch if isocc[t]
      if isnum[t+2] if isplus[nextw[t+2]] if isocc[nextw[nextw[t+2]]]
field zdcrc : max bound 8192            # その読みの閉じ括弧のトークン
zdcrc[o] <- tnum[zclch[tstart[nextw[zdcri[o]]]]] for (o) in 0 .. nocz[0]
      if zdcr[o] if zdcri[o] >= 0
      if zclch[tstart[nextw[zdcri[o]]]] >= 1
zdcs[o] <- tval[nextw[nextw[zdcrc[o]]]] for (o) in 0 .. nocz[0]
      if zdcr[o] if zdcrc[o] >= 0 if isplus[nextw[zdcrc[o]]]
      if isnum[nextw[nextw[zdcrc[o]]]]
zdof[o, 0] <- zdcs[o] for (o) in 0 .. nocz[0] if zdcr[o]
      if zdcs[o] >= 1
zdk[oseq[t], 0] <- 0 for (t,zc) in ch if isocc[t] if not isnum[t+2]
      if not isocc[t+2] if not isclo[t+2] if lkd[snum[t], zvlpz[t+2]] == 0
zdk[oseq[t], 0] <- 1 for (t,zc) in ch if isocc[t] if not isnum[t+2]
      if not isocc[t+2] if not isclo[t+2] if lkd[snum[t], zvlpz[t+2]] >= 1
zdk[o, 1] <- 4 for (o) in 0 .. nocz[0] if zd1[o] >= 0 if isnum[zd1[o]]
zdk[o, 1] <- 7 for (o) in 0 .. nocz[0] if zd1[o] >= 0 if isocc[zd1[o]]
field zd1s : max bound 8192             # 次元1 の変数の for 節
zd1s[oseq[t]] <- zvlpz[d1t[t]] for (t,zc) in ch if isocc[t]
      if iscom[d0cm[t]] if not isnum[d1t[t]] if not isocc[d1t[t]]
zdk[o, 1] <- 0 for (o) in 0 .. nocz[0] if zd1[o] >= 0 if not isnum[zd1[o]]
      if not isocc[zd1[o]] if lkd[osn[o], zd1s[o]] == 0
zdk[o, 1] <- 1 for (o) in 0 .. nocz[0] if zd1[o] >= 0 if not isnum[zd1[o]]
      if not isocc[zd1[o]] if lkd[osn[o], zd1s[o]] >= 1
field zc0cc : max bound 8192            # c0cc + 束縛 6/7 の補い
zc0cc[o] <- c0cc[o] for (o) in 0 .. nocz[0]
zc0cc[oseq[t]] <- zvcolz[t+2] for (t,zc) in ch if isocc[t]
      if zvbnd[t+2] >= 0 if lkd[snum[t], zvlpz[t+2]] == 0
zc0cc[oseq[t]] <- zvlpz[t+2] for (t,zc) in ch if isocc[t]
      if zvbnd[t+2] >= 0 if lkd[snum[t], zvlpz[t+2]] >= 1
field zdc : max bound 8192 3            # 定数 / 列（計数器は 0）
zdc[o, 0] <- zc0cc[o] for (o) in 0 .. nocz[0] if zdk[o, 0] == 4
      if not zdneg[o]
zdc[o, 0] <- 0 - zdnv[o] for (o) in 0 .. nocz[0] if zdk[o, 0] == 4
      if zdneg[o]
zdc[o, 0] <- zc0cc[o] for (o) in 0 .. nocz[0] if zdk[o, 0] == 0
zdc[o, 0] <- 0 for (o) in 0 .. nocz[0] if zdk[o, 0] == 1
# 読み + 変数 の変数の枠（列は表のとき、計数器は 0）
zdj[o, 0] <- zvlpz[zd0rvt[o]] for (o) in 0 .. nocz[0] if zd0rv[o]
      if zd0rvt[o] >= 0
zdc[o, 0] <- zvcolz[zd0rvt[o]] for (o) in 0 .. nocz[0] if zd0rv[o]
      if zd0rvt[o] >= 0 if osn[o] >= 0 if lkd[osn[o], zvlpz[zd0rvt[o]]] == 0
zdc[o, 0] <- 0 for (o) in 0 .. nocz[0] if zd0rv[o]
      if zd0rvt[o] >= 0 if osn[o] >= 0 if lkd[osn[o], zvlpz[zd0rvt[o]]] >= 1
zdc[o, 1] <- tval[zd1[o]] for (o) in 0 .. nocz[0] if zdk[o, 1] == 4
      if zd1[o] >= 0
zdc[o, 1] <- zvcolz[zd1[o]] for (o) in 0 .. nocz[0] if zdk[o, 1] == 0
      if zd1[o] >= 0
zdc[o, 1] <- 0 for (o) in 0 .. nocz[0] if zdk[o, 1] == 1
field zdj : max bound 8192 3            # for 節（列・計数器の種）
zdj[o, 0] <- zoj[o] for (o) in 0 .. nocz[0] if zdk[o, 0] == 0
zdj[o, 0] <- zc0cc[o] for (o) in 0 .. nocz[0] if zdk[o, 0] == 1
zdj[o, 1] <- zd1s[o] for (o) in 0 .. nocz[0] if zdk[o, 1] <= 1
field zdof : max bound 8192 3           # 符号付きのずれ
zdof[o, 0] <- zsof[o] for (o) in 0 .. nocz[0] if zsof[o] >= 0
zdof[o, 0] <- zsof[o] for (o) in 0 .. nocz[0] if zsof[o] <= 0 - 1
zdof[o, 1] <- 0 for (o) in 0 .. nocz[0] if zd1[o] >= 0
      if not ixhf[zd1[o]]
zdof[o, 1] <- ixnv[zd1[o]] for (o) in 0 .. nocz[0] if zd1[o] >= 0
      if isplus[ixop[zd1[o]]] if isnum[ixnm[zd1[o]]]
zdof[o, 1] <- 0 - ixnv[zd1[o]] for (o) in 0 .. nocz[0] if zd1[o] >= 0
      if ismin[ixop[zd1[o]]] if isnum[ixnm[zd1[o]]]
field zdro : max bound 8192 3           # 読みの種のときの内側の出現
zdro[o, 0] <- zinoc[o] for (o) in 0 .. nocz[0] if zdk[o, 0] == 7
zdro[o, 1] <- oseq[zd1[o]] for (o) in 0 .. nocz[0] if zdk[o, 1] == 7
      if zd1[o] >= 0
# 種8: 次元1 が「変数 ± 読み」（`out[owner[i], i - owner[i]]`）——
# 変数の枠と読みの間接が同じ次元に重なる。係数は符号 × 歩幅。
field zd1sg : max bound 8192            # 符号（1 足す / 2 引く）
zd1sg[o] <- 2 for (o) in 0 .. nocz[0] if zd1[o] >= 0
      if not isnum[zd1[o]] if not isocc[zd1[o]]
      if ismin[nextw[zd1[o]]] if isocc[nextw[nextw[zd1[o]]]]
zd1sg[o] <- 1 for (o) in 0 .. nocz[0] if zd1[o] >= 0
      if not isnum[zd1[o]] if not isocc[zd1[o]]
      if isplus[nextw[zd1[o]]] if isocc[nextw[nextw[zd1[o]]]]
zdk[o, 1] <- 8 for (o) in 0 .. nocz[0] if zd1sg[o] >= 1
zdro[o, 1] <- oseq[nextw[nextw[zd1[o]]]] for (o) in 0 .. nocz[0]
      if zdk[o, 1] == 8 if zd1[o] >= 0
field zdrd1 : or bound 8192             # 次元1 に読みがある（種7 / 種8）
zdrd1[o] <- true for (o) in 0 .. nocz[0] if zdk[o, 1] == 7
zdrd1[o] <- true for (o) in 0 .. nocz[0] if zdk[o, 1] == 8
# 次元2 の読み（`trow[stab[..], rw, bind_pos[..]]`）は二本目の間接の席を
# 次元1 と分け合う（次元1 が読みでないとき。三つとも読みは zh3r の畳み）。
# 席 b = 次元1 の読み / 次元2 の読み —— 中身・歩幅・場を席で引く。
field zdrd2 : or bound 8192             # 次元2 に読みがあり、次元1 に無い
zdrd2[o] <- true for (o) in 0 .. nocz[0] if zdk[o, 2] == 7 if not zdrd1[o]
field zdrdb : or bound 8192             # 二本目の席に読みがある
zdrdb[o] <- true for (o) in 0 .. nocz[0] if zdrd1[o]
zdrdb[o] <- true for (o) in 0 .. nocz[0] if zdrd2[o]
field zdrob : max bound 8192            # 二本目の席の内側の出現
zdrob[o] <- zdro[o, 1] for (o) in 0 .. nocz[0] if zdrd1[o] if zdro[o, 1] >= 0
zdrob[o] <- oseq[zd2[o]] for (o) in 0 .. nocz[0] if zdrd2[o] if zd2[o] >= 0
field zfsb : max bound 8192             # 二本目の席の歩幅（次元2 は 1）
zfsb[o] <- zfs1[zrdf[o]] for (o) in 0 .. nocz[0] if zdrd1[o] if zrdq[o] >= 0
zfsb[o] <- 1 for (o) in 0 .. nocz[0] if zdrd2[o] if zrdq[o] >= 0
# 種8 の変数の枠（種0/1 と同じ形）
zdc[o, 1] <- zvcolz[zd1[o]] for (o) in 0 .. nocz[0] if zdk[o, 1] == 8
      if zd1[o] >= 0 if lkd[osn[o], zd1s[o]] == 0
zdc[o, 1] <- 0 for (o) in 0 .. nocz[0] if zdk[o, 1] == 8
      if zd1[o] >= 0 if lkd[osn[o], zd1s[o]] >= 1
zdj[o, 1] <- zd1s[o] for (o) in 0 .. nocz[0] if zdk[o, 1] == 8

# ── 次元0 が 変数 × 変数（`comp[i * j]` —— 24_space）: 種12 ────────────
# 軸の一次式は写像で書けるが積は書けない —— 二つの変数を枠108/109（種11:
# 写像 ÷ 1）に落とし、積を枠110（種10）に置き、番地の間接でその積を読む
# （flat.py の pcell → _chains → pchain の道と同じ）。
field zdvv : or bound 8192              # 次元0 は 変数 × 変数
zdvv[oseq[t]] <- true for (t,zc) in ch if isocc[t] if tkind[t+2] == 1
      if not isnum[t+2] if not isocc[t+2] if isstar[nextw[t+2]]
      if tkind[nextw[nextw[t+2]]] == 1 if not isnum[nextw[nextw[t+2]]]
zdk[oseq[t], 0] <- 12 for (t,zc) in ch if isocc[t] if zdvv[oseq[t]]
field zdv1 : max bound 8192             # 左の変数のトークン
zdv1[oseq[t]] <- t + 2 for (t,zc) in ch if isocc[t] if zdvv[oseq[t]]
field zdv2 : max bound 8192             # 右の変数のトークン
zdv2[oseq[t]] <- nextw[nextw[t+2]] for (t,zc) in ch if isocc[t] if zdvv[oseq[t]]
field zdvm1 : max bound 8192            # 左の変数の写像（63）
zdvm1[o] <- zsr[o] * 128 + 63 for (o) in 0 .. nocz[0] if zdvv[o] if zsr[o] >= 0
field zdvm2 : max bound 8192            # 右の変数の写像（119）
zdvm2[o] <- zsr[o] * 128 + 119 for (o) in 0 .. nocz[0] if zdvv[o] if zsr[o] >= 0
zmu[zdvm1[o]] <- true for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zmn[zdvm1[o]] <- 1 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zmc[zdvm1[o]] <- 0 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zmj0[zdvm1[o]] <- zvlpz[zdv1[o]] for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zmc0[zdvm1[o]] <- 0 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
      if lkd[osn[o], zvlpz[zdv1[o]]] >= 1
zmc0[zdvm1[o]] <- zvcolz[zdv1[o]] for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
      if lkd[osn[o], zvlpz[zdv1[o]]] == 0
zmm0[zdvm1[o]] <- 1 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zmu[zdvm2[o]] <- true for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zmn[zdvm2[o]] <- 1 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zmc[zdvm2[o]] <- 0 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zmj0[zdvm2[o]] <- zvlpz[zdv2[o]] for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zmc0[zdvm2[o]] <- 0 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
      if lkd[osn[o], zvlpz[zdv2[o]]] >= 1
zmc0[zdvm2[o]] <- zvcolz[zdv2[o]] for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
      if lkd[osn[o], zvlpz[zdv2[o]]] == 0
zmm0[zdvm2[o]] <- 1 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpu[zsr[o], 108] <- true for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpk[zsr[o], 108] <- 11 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfplt[zsr[o], 108] <- 0 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpmo[zsr[o], 108] <- 1 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpam[zsr[o], 108] <- zdvm1[o] for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpu[zsr[o], 109] <- true for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpk[zsr[o], 109] <- 11 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfplt[zsr[o], 109] <- 0 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpmo[zsr[o], 109] <- 1 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpam[zsr[o], 109] <- zdvm2[o] for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpu[zsr[o], 110] <- true for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpk[zsr[o], 110] <- 10 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfplt[zsr[o], 110] <- 0 for (o) in 0 .. nocz[0] if zdvv[o] if zrdq[o] >= 0
zfpam[zsr[o], 110] <- zsr[o] * 128 + 4 for (o) in 0 .. nocz[0] if zdvv[o]
      if zrdq[o] >= 0
zfpsr[zsr[o], 110] <- zfpb[zsr[o], 108] for (o) in 0 .. nocz[0] if zdvv[o]
      if zrdq[o] >= 0 if zfpb[zsr[o], 108] >= 1
zfps2[zsr[o], 110] <- zfpb[zsr[o], 109] for (o) in 0 .. nocz[0] if zdvv[o]
      if zrdq[o] >= 0 if zfpb[zsr[o], 109] >= 1
zdl0[o] <- 0 - zflo0[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 0] == 12
zmia[zrdq[o]] <- zfs0[zrdf[o]] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 0] == 12
zmib[zrdq[o]] <- zfpb[zsr[o], 110] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 0] == 12 if zfpb[zsr[o], 110] >= 1
zmiu[zrdq[o]] <- 1 for (o) in 0 .. nocz[0] if zrdq[o] >= 0 if zdk[o, 0] == 12

# ── 次元2（`rd[pc, v, d]` —— 三次元の場）。写像の枠は三本目（zmj2）へ ──
field zd1cm : max bound 8192            # 次元1 の直後の語（i+1 はずれの後ろ）
zd1cm[o] <- nextw[zd1[o]] for (o) in 0 .. nocz[0] if zd1[o] >= 0
      if not ixhf[zd1[o]]
zd1cm[o] <- nextw[ixnm[zd1[o]]] for (o) in 0 .. nocz[0] if zd1[o] >= 0
      if ixhf[zd1[o]]
# 次元1 が読み（rn[k]）なら、その閉じ括弧の次の語へ（角括弧を跨ぐ）
zd1cm[o] <- nextw[tnum[zclch[tstart[nextw[zd1[o]]]]]] for (o) in 0 .. nocz[0]
      if zd1[o] >= 0 if isocc[zd1[o]]
      if zclch[tstart[nextw[zd1[o]]]] >= 1
field zd2 : max bound 8192              # 次元2 の添字トークン
zd2[o] <- nextw[zd1cm[o]] for (o) in 0 .. nocz[0] if zd1cm[o] >= 0
      if iscom[zd1cm[o]]
field zhas2 : or bound 8192             # 次元2 があるか
zhas2[o] <- true for (o) in 0 .. nocz[0] if zd2[o] >= 0
field zd2s : max bound 8192             # 次元2 の変数の for 節
zd2s[o] <- zvlpz[zd2[o]] for (o) in 0 .. nocz[0] if zd2[o] >= 0
      if not isnum[zd2[o]] if not isocc[zd2[o]]
zdk[o, 2] <- 4 for (o) in 0 .. nocz[0] if zd2[o] >= 0 if isnum[zd2[o]]
zdk[o, 2] <- 7 for (o) in 0 .. nocz[0] if zd2[o] >= 0 if isocc[zd2[o]]
zdk[o, 2] <- 0 for (o) in 0 .. nocz[0] if zd2[o] >= 0 if not isnum[zd2[o]]
      if not isocc[zd2[o]] if lkd[osn[o], zd2s[o]] == 0
zdk[o, 2] <- 1 for (o) in 0 .. nocz[0] if zd2[o] >= 0 if not isnum[zd2[o]]
      if not isocc[zd2[o]] if lkd[osn[o], zd2s[o]] >= 1
zdc[o, 2] <- tval[zd2[o]] for (o) in 0 .. nocz[0] if zdk[o, 2] == 4
      if zd2[o] >= 0
zdc[o, 2] <- zvcolz[zd2[o]] for (o) in 0 .. nocz[0] if zdk[o, 2] == 0
      if zd2[o] >= 0
zdc[o, 2] <- 0 for (o) in 0 .. nocz[0] if zdk[o, 2] == 1
zdj[o, 2] <- zd2s[o] for (o) in 0 .. nocz[0] if zdk[o, 2] <= 1
zdof[o, 2] <- 0 for (o) in 0 .. nocz[0] if zd2[o] >= 0
      if not ixhf[zd2[o]]
zdof[o, 2] <- ixnv[zd2[o]] for (o) in 0 .. nocz[0] if zd2[o] >= 0
      if isplus[ixop[zd2[o]]] if isnum[ixnm[zd2[o]]]
zdof[o, 2] <- 0 - ixnv[zd2[o]] for (o) in 0 .. nocz[0] if zd2[o] >= 0
      if ismin[ixop[zd2[o]]] if isnum[ixnm[zd2[o]]]

# 写像の部品（鍵 m = 規則·32 + 枠）。枠: 0 dm / 1 am / 2 bm / 3 wm / 4 零 /
#   8+3g ガード左 cm / 9+3g ガード右 / 10+3g ガード左の fp の番地 /
#   24+u 束ちがいの読み（fp の番地）
field zmu : or bound 524288             # 使っている写像
field zmc : max bound 524288            # 定数
field zmn : max bound 524288            # 枠の数
field zmj0 : max bound 524288
field zmc0 : max bound 524288
field zmm0 : max bound 524288
field zmj1 : max bound 524288
field zmc1 : max bound 524288
field zmm1 : max bound 524288
field zmj2 : max bound 524288
field zmc2 : max bound 524288
field zmm2 : max bound 524288
field zmia : max bound 524288           # 間接: 係数
field zmib : max bound 524288           # 間接: 番地面の基
field zmiu : max bound 524288           # 間接: 使うか
field zmia2 : max bound 524288          # 間接2: 係数
field zmib2 : max bound 524288          # 間接2: 番地面の基
field zmiu2 : max bound 524288          # 間接2: 使うか

# 零の写像（規則ごとに一つ。ラベルは違っても中身は同じ）
zmu[r * 128 + 4] <- true for (r) in 0 .. znrm[0]
zmc[r * 128 + 4] <- 0 for (r) in 0 .. znrm[0]
zmn[r * 128 + 4] <- 0 for (r) in 0 .. znrm[0]

# ── dm: 頭の番地は読みと同じ道（zrdq に枠 r·32 を渡すだけ） ─────────
field zdmf : max bound 4096             # 規則 r の頭の場
zdmf[r] <- ofl[zho[r]] - 1 for (r) in 0 .. znrm[0] if zho[r] >= 0
zrdq[zho[r]] <- r * 128 for (r) in 0 .. znrm[0] if zho[r] >= 0

# ── 項の解析: 読み（同じ束 / 違う束）と一次式の部品 ─────────────────
# 種（for の無い文）にも項はある —— `top[] <- form[k]` は種の形をした読みで
# ある。33_self は種を定数としか見ないので、ここで項の印を種にも広げる
#（33_self の istm の鎖と trkd の表がそのまま種にも働く）。
istrm[t] <- true for (t,zc) in ch if isocc[t] if aftarw[t]
      if isseed[snum[t]] if not isbnd[t] if not tcom[t]
istrmn[t] <- true for (t,zc) in ch if aftarw[t] if isnum[t]
      if isseed[snum[t]] if not tcom[t]
field ztmo : max bound 524288           # 項トークン → 出現番号
ztmo[t] <- oseq[t] for (t,zc) in ch if istrm[t]
field ztml : max bound 524288           # 読みの項の束
ztml[t] <- zlatf[ofl[oseq[t]] - 1] for (t,zc) in ch if istrm[t]
field zrlat : max bound 524288          # そのトークンの規則の束
zrlat[t] <- zfglat[zrn[snum[t]]] for (t,zc) in ch if istm[t]
      if zrn[snum[t]] >= 0
# 係数つきの読み（次の項が `* 定数`）—— am/bm の直の読みは重み 1 しか
# 書けないが、間接の m には係数が畳める。だから pa 経由（mis の道）へ。
field zco6 : or bound 524288            # この読みの項の次が `* 定数`
zco6[t] <- true for (t,zc) in ch if istrm[t]
      if trkd[snum[t], tcnt[t] + 1] == 6
field zocof : max bound 8192            # 出現の係数
zocof[oseq[t]] <- trvl[snum[t], tcnt[t] + 1] for (t,zc) in ch if istrm[t]
      if zco6[t]
field zmco : or bound 8192              # 出現に係数がある
zmco[oseq[t]] <- true for (t,zc) in ch if istrm[t] if zco6[t]
field zsamel : or bound 524288          # 同じ束の読みの項（足す形・重み 1）
zsamel[t] <- true for (t,zc) in ch if istrm[t] if not zchn[snum[t]]
      if not zchdv[snum[t]]
      if trkd[snum[t], tcnt[t]] == 3 if ztml[t] == zrlat[t]
      if not zco6[t] if not zprd1[t]
field zmisl : or bound 524288           # pa 経由の読みの項（束ちがい / 係数つき / 引かれた）
zmisl[t] <- true for (t,zc) in ch if istrm[t] if not zchn[snum[t]]
      if trkd[snum[t], tcnt[t]] == 3 if ztml[t] != zrlat[t]
zmisl[t] <- true for (t,zc) in ch if istrm[t] if not zchn[snum[t]]
      if trkd[snum[t], tcnt[t]] == 3 if zco6[t]
zmisl[t] <- true for (t,zc) in ch if istrm[t] if not zchn[snum[t]]
      if trkd[snum[t], tcnt[t]] == 9 if not zoppl[t]
# ── 向きの逆な束を、生きたまま引く（vf 6）────────────────────────────
# `hi[f] - lo[f] + 1`（max が生きた min を引く）。下るほど値は上がるので
# 単調だが、pa（flat）には写せない（下る値は ⊥ → v → v' と動く）——
# 面から直に読む。am がその読み、同じ束の読み一本は bm（n = 2）。
field zoppl : or bound 524288           # 引かれた読みの項で、束が逆向き・生きている
zoppl[t] <- true for (t,zc) in ch if istrm[t] if not zchn[snum[t]]
      if trkd[snum[t], tcnt[t]] == 9 if not zco6[t] if not zprd1[t]
      if ztml[t] == 1 if zrlat[t] == 2
      if zfws[ofl[oseq[t]] - 1] >= zfgst[zrn[snum[t]]]
zoppl[t] <- true for (t,zc) in ch if istrm[t] if not zchn[snum[t]]
      if trkd[snum[t], tcnt[t]] == 9 if not zco6[t] if not zprd1[t]
      if ztml[t] == 2 if zrlat[t] == 1
      if zfws[ofl[oseq[t]] - 1] >= zfgst[zrn[snum[t]]]
field zopp : min bound 4096             # 規則 r の逆向きの生きた読み（出現）
zopp[zrn[snum[t]]] <- oseq[t] for (t,zc) in ch if zoppl[t]
      if zrn[snum[t]] >= 0
field zhopp : or bound 4096             # 規則 r は逆向きの生きた読みを持つ
zhopp[zrn[snum[t]]] <- true for (t,zc) in ch if zoppl[t]
      if zrn[snum[t]] >= 0
# ── 読み × 読み（`f[x] * g[y]`、flat.py の鎖の項 / 種10 の枠の積）────────
# 左右の読みは枠3・枠4 の写し（zmis / zmis2 —— 束ちがいの読みと同じ道）、
# 積は枠107（種10: pa[p1]·pa[p2]）、wm の間接はその積を一本で読む。
# 積の下ではどちらの読みも向きが壊れる（参照実装は COORD）—— flat/fourv 以外は非単調。
field zttk : max bound 4096 8           # 文 s の項 k のトークン
zttk[snum[t], tcnt[t]] <- t for (t,zc) in ch if istm[t] if tcnt[t] <= 7
field zprd2 : or bound 524288           # 積の右の読みの項（`* g[y]` の g）
zprd2[t] <- true for (t,zc) in ch if istrm[t] if trkd[snum[t], tcnt[t]] == 10
      if not zchny[snum[t]] if tcnt[t] >= 1
      if istrm[zttk[snum[t], tcnt[t] - 1]]
field zprd1 : or bound 524288           # 積の左の読みの項
zprd1[t] <- true for (t,zc) in ch if istrm[t] if tcnt[t] <= 6
      if zttk[snum[t], tcnt[t] + 1] >= 0 if zprd2[zttk[snum[t], tcnt[t] + 1]]
zmisl[t] <- true for (t,zc) in ch if zprd1[t]
zmisl[t] <- true for (t,zc) in ch if zprd2[t]
field zhprd : or bound 4096             # 規則 r は積を持つ
zhprd[zrn[snum[t]]] <- true for (t,zc) in ch if zprd2[t] if zrn[snum[t]] >= 0
zonm[oseq[t]] <- true for (t,zc) in ch if zprd1[t] if zosen[oseq[t]] <= 4
zonm[oseq[t]] <- true for (t,zc) in ch if zprd2[t] if zosen[oseq[t]] <= 4
zfpu[r, 107] <- true for (r) in 0 .. znrm[0] if zhprd[r]
zfpk[r, 107] <- 10 for (r) in 0 .. znrm[0] if zhprd[r]
zfplt[r, 107] <- 0 for (r) in 0 .. znrm[0] if zhprd[r]
zfpam[r, 107] <- r * 128 + 4 for (r) in 0 .. znrm[0] if zhprd[r]
zfpsr[r, 107] <- zfpb[r, 3] for (r) in 0 .. znrm[0] if zhprd[r]
      if zfpb[r, 3] >= 1
zfps2[r, 107] <- zfpb[r, 4] for (r) in 0 .. znrm[0] if zhprd[r]
      if zfpb[r, 4] >= 1
zmia[r * 128 + 3] <- 1 for (r) in 0 .. znrm[0] if zhprd[r]
      if not zoneg[zmis[r]]
zmia[r * 128 + 3] <- 0 - 1 for (r) in 0 .. znrm[0] if zhprd[r]
      if zoneg[zmis[r]]
zmib[r * 128 + 3] <- zfpb[r, 107] for (r) in 0 .. znrm[0] if zhprd[r]
      if zfpb[r, 107] >= 1
zmiu[r * 128 + 3] <- 1 for (r) in 0 .. znrm[0] if zhprd[r]
field zoneg : or bound 8192             # 出現は引かれている（係数の符号 −）
zoneg[oseq[t]] <- true for (t,zc) in ch if istrm[t]
      if trkd[snum[t], tcnt[t]] == 9
field zam : min bound 4096              # 規則 r の一本目の同束の読み（出現）
zam[zrn[snum[t]]] <- oseq[t] for (t,zc) in ch if zsamel[t]
      if zrn[snum[t]] >= 0
field zam2 : min bound 4096             # 二本目
zam2[zrn[snum[t]]] <- oseq[t] for (t,zc) in ch if zsamel[t]
      if zrn[snum[t]] >= 0 if oseq[t] >= zam[zrn[snum[t]]] + 1
field zns : count bound 4096            # 同束の読みの数
zns[zrn[snum[t]]] <- 1 for (t,zc) in ch if zsamel[t] if zrn[snum[t]] >= 0
field zmis : min bound 4096             # 一本目の違う束の読み（出現）
zmis[zrn[snum[t]]] <- oseq[t] for (t,zc) in ch if zmisl[t]
      if zrn[snum[t]] >= 0
field zmis2 : min bound 4096            # 二本目
zmis2[zrn[snum[t]]] <- oseq[t] for (t,zc) in ch if zmisl[t]
      if zrn[snum[t]] >= 0 if oseq[t] >= zmis[zrn[snum[t]]] + 1
field zhasm : or bound 4096             # 違う束の読みがある
zhasm[zrn[snum[t]]] <- true for (t,zc) in ch if zmisl[t]
      if zrn[snum[t]] >= 0
field zhasa : or bound 4096             # 同束の読みがある
zhasa[zrn[snum[t]]] <- true for (t,zc) in ch if zsamel[t]
      if zrn[snum[t]] >= 0
zhasa[r] <- true for (r) in 0 .. znrm[0] if zhopp[r]   # 逆向きの読みも直の読み（am）

# ── 値の鎖（読みに定数の * / % を外へ重ねた形） ─────────────────────
# `imm[i] / 256 % 256` は pa の変換の鎖になる —— 掛けは間接の係数に畳め、
# 割りと剰余だけが升を要る（枠 3 が芯、枠 4 と 7 が変換）。
field zistc : or bound 524288           # 鎖の項（* / % の定数）
zistc[t] <- true for (t,zc) in ch if istrmn[t]
      if trkd[snum[t], tcnt[t]] >= 6 if trkd[snum[t], tcnt[t]] <= 8
field zistcd : or bound 524288          # ÷ / % の定数の項
zistcd[t] <- true for (t,zc) in ch if istrmn[t]
      if trkd[snum[t], tcnt[t]] >= 7 if trkd[snum[t], tcnt[t]] <= 8
field zhdvt : or bound 4096             # ÷ / % の項がある
zhdvt[snum[t]] <- true for (t,zc) in ch if zistcd[t]
field znotc : or bound 4096             # 鎖の形を破る項を持つ文
znotc[snum[t]] <- true for (t,zc) in ch if istm[t] if tcnt[t] >= 1
      if not zistc[t]
znotc[snum[t]] <- true for (t,zc) in ch if istm[t] if tcnt[t] == 0
      if not istrm[t]
field zhcht : or bound 4096             # 鎖の項が一つはある
zhcht[snum[t]] <- true for (t,zc) in ch if zistc[t]
field zchn : or bound 4096              # 文 s は値の鎖
zchn[s] <- true for (s) in 0 .. nstz[0] if zhcht[s] if not znotc[s]
# 芯が一次式の鎖（`half[i] <- i / 2`）—— 写しは要らず、最初の ÷/% が
# (写像) ÷ 法（種11）/ (写像) % 法（種1）で一枚になる。
field znotca : or bound 4096            # 芯が変数の鎖を破る項
znotca[snum[t]] <- true for (t,zc) in ch if istm[t] if tcnt[t] >= 1
      if not zistcd[t]
znotca[snum[t]] <- true for (t,zc) in ch if istm[t] if tcnt[t] == 0
      if not istrmv[t]
znotca[snum[t]] <- true for (t,zc) in ch if istm[t] if tcnt[t] == 0
      if istrmv[t] if trkd[snum[t], 0] >= 11
field zchav : or bound 4096             # 文 s は芯が一次式の鎖
zchav[s] <- true for (s) in 0 .. nstz[0] if zhdvt[s] if not znotca[s]
      if not zchn[s]
# 括弧の芯の鎖（`(120 + codelen[]) % 256`）—— 括弧の中は深さ1 なので
# 項の機構に見えない。芯 = 定数の和 + 読み一つ。写しの枠 + (写像)%法。
field zchpoc : min bound 4096           # 括弧の芯の読み（出現）
zchpoc[snum[t]] <- oseq[t] for (t,zc) in ch if isocc[t] if tdep[t] == 1
      if cnum[t] == 0 if t >= arrowt[snum[t]] + 1 if isrec[snum[t]]
zchpoc[snum[t]] <- oseq[t] for (t,zc) in ch if isocc[t] if tdep[t] == 1
      if cnum[t] == 0 if t >= arrowt[snum[t]] + 1 if isseed[snum[t]]
field zchpc : sum bound 4096            # 括弧の芯の定数の和
zchpc[snum[t]] <- tval[t] for (t,zc) in ch if isnum[t] if tdep[t] == 1
      if not tcom[t] if cnum[t] == 0 if t >= arrowt[snum[t]] + 1
      if isrec[snum[t]]
zchpc[snum[t]] <- tval[t] for (t,zc) in ch if isnum[t] if tdep[t] == 1
      if not tcom[t] if cnum[t] == 0 if t >= arrowt[snum[t]] + 1
      if isseed[snum[t]]
field zchpp : or bound 4096             # 文 s は括弧の芯の鎖
zchpp[s] <- true for (s) in 0 .. nstz[0] if zhdvt[s] if zchpoc[s] >= 0
      if trkd[s, 0] >= 7 if trkd[s, 0] <= 8
field zchny : or bound 4096             # 鎖（どの形でも）
zchny[s] <- true for (s) in 0 .. nstz[0] if zchn[s]
zchny[s] <- true for (s) in 0 .. nstz[0] if zchav[s]
zchny[s] <- true for (s) in 0 .. nstz[0] if zchpp[s]
# 読み ÷/% 読み（`back[n] <- pow2[n] / pow2[n-1]`）—— 割る数も升。
# 写しを二枚（枠3・枠4）、種8/9 が一枚（枠7）。どちらの読みも
# 割り算の下では向きが壊れる（COORD —— classify と同じ）ので非単調。
field zistrd : or bound 524288          # ÷ / % の右の読みの項
zistrd[t] <- true for (t,zc) in ch if istrm[t] if pdiv[t]
zistrd[t] <- true for (t,zc) in ch if istrm[t] if pmod[t]
field zchdv : or bound 4096             # 文 s は pa で割る鎖
zchdv[snum[t]] <- true for (t,zc) in ch if zistrd[t] if tcnt[t] == 1
      if trkd[snum[t], 0] == 3 if ztn[snum[t]] == 2
field zchdo1 : min bound 4096           # 割られる読み（出現）
zchdo1[snum[t]] <- oseq[t] for (t,zc) in ch if istrm[t] if tcnt[t] == 0
      if zchdv[snum[t]]
field zchdo2 : min bound 4096           # 割る読み（出現）
zchdo2[snum[t]] <- oseq[t] for (t,zc) in ch if zistrd[t] if tcnt[t] == 1
      if zchdv[snum[t]]
field zchdk : max bound 4096            # 種（8 ÷ / 9 %）
zchdk[snum[t]] <- 8 for (t,zc) in ch if zistrd[t] if tcnt[t] == 1
      if zchdv[snum[t]] if pdiv[t]
zchdk[snum[t]] <- 9 for (t,zc) in ch if zistrd[t] if tcnt[t] == 1
      if zchdv[snum[t]] if pmod[t]
zonm[zchdo1[s]] <- true for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdo1[s] >= 0 if zosen[zchdo1[s]] <= 4
zonm[zchdo2[s]] <- true for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdo2[s] >= 0 if zosen[zchdo2[s]] <= 4
field zchdr : max bound 4096            # 規則番号
zchdr[s] <- zrn[s] for (s) in 0 .. nstz[0] if zchdv[s] if zrn[s] >= 0
field zchdm3 : max bound 4096           # その枠 3 の写像の番号
zchdm3[s] <- zchdr[s] * 128 + 3 for (s) in 0 .. nstz[0] if zchdr[s] >= 0
zrdq[zchdo1[s]] <- zchdr[s] * 128 + 58 for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdo1[s] >= 0 if zchdr[s] >= 0
zrdq[zchdo2[s]] <- zchdr[s] * 128 + 59 for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdo2[s] >= 0 if zchdr[s] >= 0
field zchdf1 : max bound 4096           # その場
zchdf1[s] <- ofl[zchdo1[s]] - 1 for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdo1[s] >= 0
field zchdf2 : max bound 4096
zchdf2[s] <- ofl[zchdo2[s]] - 1 for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdo2[s] >= 0
zfpu[zchdr[s], 3] <- true for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdr[s] >= 0
zfpu[zchdr[s], 4] <- true for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdr[s] >= 0
zfpu[zchdr[s], 7] <- true for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdr[s] >= 0
zfplt[zchdr[s], 3] <- zlatf[zchdf1[s]] for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdr[s] >= 0 if zchdf1[s] >= 0
      if zfws[zchdf1[s]] <= zfgst[zchdr[s]] - 1
zfplt[zchdr[s], 3] <- 0 - 5 for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdr[s] >= 0 if zchdf1[s] >= 0 if zlatf[zchdf1[s]] == 5
      if zfws[zchdf1[s]] >= zfgst[zchdr[s]]
zfplt[zchdr[s], 4] <- zlatf[zchdf2[s]] for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdr[s] >= 0 if zchdf2[s] >= 0
      if zfws[zchdf2[s]] <= zfgst[zchdr[s]] - 1
zfplt[zchdr[s], 4] <- 0 - 5 for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdr[s] >= 0 if zchdf2[s] >= 0 if zlatf[zchdf2[s]] == 5
      if zfws[zchdf2[s]] >= zfgst[zchdr[s]]
zfpam[zchdr[s], 3] <- zchdr[s] * 128 + 58 for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdr[s] >= 0
zfpam[zchdr[s], 4] <- zchdr[s] * 128 + 59 for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdr[s] >= 0
zfpk[zchdr[s], 7] <- zchdk[s] for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdr[s] >= 0 if zchdk[s] >= 8
zfplt[zchdr[s], 7] <- 0 for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdr[s] >= 0
zfpam[zchdr[s], 7] <- zchdr[s] * 128 + 4 for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdr[s] >= 0
zfpsr[zchdr[s], 7] <- zfpb[zchdr[s], 3] for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdr[s] >= 0 if zfpb[zchdr[s], 3] >= 1
zfps2[zchdr[s], 7] <- zfpb[zchdr[s], 4] for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdr[s] >= 0 if zfpb[zchdr[s], 4] >= 1
zmia[zchdm3[s]] <- 1 for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdr[s] >= 0
zmib[zchdm3[s]] <- zfpb[zchdr[s], 7] for (s) in 0 .. nstz[0]
      if zchdv[s] if zchdr[s] >= 0 if zfpb[zchdr[s], 7] >= 1
zmiu[zchdm3[s]] <- 1 for (s) in 0 .. nstz[0] if zchdv[s]
      if zchdr[s] >= 0
field zchoc : min bound 4096            # 鎖の芯の出現
zchoc[snum[t]] <- oseq[t] for (t,zc) in ch if istrm[t] if zchn[snum[t]]
# 掛けの位置が意味を分ける: 最初の ÷/% より **前**の係数は枠の写像に
# 畳まれ（μ·pa ÷ M —— (写像)÷法 の種11）、**後**の係数は wm の間接に乗る。
field zhmula : or bound 4096            # 割りの前に掛けがある
zhmula[snum[t]] <- true for (t,zc) in ch if istrmn[t] if zchn[snum[t]]
      if trkd[snum[t], tcnt[t]] == 6 if zhch1[snum[t]]
      if tcnt[t] <= zcho1[snum[t]] - 1
field zchcfa : max bound 4096           # その係数
zchcfa[snum[t]] <- trvl[snum[t], tcnt[t]] for (t,zc) in ch if istrmn[t]
      if zchn[snum[t]] if trkd[snum[t], tcnt[t]] == 6 if zhch1[snum[t]]
      if tcnt[t] <= zcho1[snum[t]] - 1
field zhmulb : or bound 4096            # 割りの後（または割りが無い）に掛け
zhmulb[snum[t]] <- true for (t,zc) in ch if istrmn[t] if zchn[snum[t]]
      if trkd[snum[t], tcnt[t]] == 6 if not zhch1[snum[t]]
zhmulb[snum[t]] <- true for (t,zc) in ch if istrmn[t] if zchn[snum[t]]
      if trkd[snum[t], tcnt[t]] == 6 if zhch1[snum[t]]
      if tcnt[t] >= zcho1[snum[t]] + 1
field zchcfb : max bound 4096           # その係数
zchcfb[snum[t]] <- trvl[snum[t], tcnt[t]] for (t,zc) in ch if istrmn[t]
      if zchn[snum[t]] if trkd[snum[t], tcnt[t]] == 6 if not zhch1[snum[t]]
zchcfb[snum[t]] <- trvl[snum[t], tcnt[t]] for (t,zc) in ch if istrmn[t]
      if zchn[snum[t]] if trkd[snum[t], tcnt[t]] == 6 if zhch1[snum[t]]
      if tcnt[t] >= zcho1[snum[t]] + 1
field zcho1 : min bound 4096            # 一つ目の / % の項番号
zcho1[snum[t]] <- tcnt[t] for (t,zc) in ch if istrmn[t] if zchny[snum[t]]
      if trkd[snum[t], tcnt[t]] >= 7
field zcho2 : min bound 4096            # 二つ目
zcho2[snum[t]] <- tcnt[t] for (t,zc) in ch if istrmn[t] if zchny[snum[t]]
      if trkd[snum[t], tcnt[t]] >= 7 if tcnt[t] >= zcho1[snum[t]] + 1
field zchnn : count bound 4096          # / % の数
zchnn[snum[t]] <- 1 for (t,zc) in ch if istrmn[t] if zchny[snum[t]]
      if trkd[snum[t], tcnt[t]] >= 7
field zchk1 : max bound 4096            # 一つ目の種（fp: % は 3 / `/` は 4）
zchk1[s] <- 3 for (s) in 0 .. nstz[0] if zcho1[s] >= 0
      if trkd[s, zcho1[s]] == 8
zchk1[s] <- 4 for (s) in 0 .. nstz[0] if zcho1[s] >= 0
      if trkd[s, zcho1[s]] == 7
field zchm1 : max bound 4096            # 一つ目の法
zchm1[s] <- trvl[s, zcho1[s]] for (s) in 0 .. nstz[0] if zcho1[s] >= 0
field zchk2 : max bound 4096
zchk2[s] <- 3 for (s) in 0 .. nstz[0] if zcho2[s] >= 0
      if trkd[s, zcho2[s]] == 8
zchk2[s] <- 4 for (s) in 0 .. nstz[0] if zcho2[s] >= 0
      if trkd[s, zcho2[s]] == 7
field zchm2 : max bound 4096
zchm2[s] <- trvl[s, zcho2[s]] for (s) in 0 .. nstz[0] if zcho2[s] >= 0
field zchr : max bound 4096             # 鎖の文の規則番号
zchr[s] <- zrn[s] for (s) in 0 .. nstz[0] if zchny[s] if zrn[s] >= 0
field zchm3 : max bound 4096            # 鎖の規則の写像 3 / 58 / 62 の番号
zchm3[s] <- zchr[s] * 128 + 3 for (s) in 0 .. nstz[0] if zchr[s] >= 0
field zchm58 : max bound 4096
zchm58[s] <- zchr[s] * 128 + 58 for (s) in 0 .. nstz[0] if zchr[s] >= 0
field zchm62 : max bound 4096
zchm62[s] <- zchr[s] * 128 + 62 for (s) in 0 .. nstz[0] if zchr[s] >= 0
zrdq[zchoc[s]] <- zchr[s] * 128 + 58 for (s) in 0 .. nstz[0] if zchn[s]
      if zchoc[s] >= 0 if zchr[s] >= 0
zrdq[zchpoc[s]] <- zchr[s] * 128 + 58 for (s) in 0 .. nstz[0] if zchpp[s]
      if zchpoc[s] >= 0 if zchr[s] >= 0

# ── 読みの番地の写像（出現 o の座標から。dm と同じ算術） ─────────────
# 書く先は「どの枠か」が呼び出しごとに違うので、**枠番号を場の値で渡す**。
# zrdm[o] = その読みの写像を置いた枠（m 番号）。書くのは使う側の規則。
field zrdq : max bound 8192             # 出現 o の読みの写像を置く枠（m 番号）
zrdq[zam[r]] <- r * 128 + 1 for (r) in 0 .. znrm[0] if zhasa[r]
      if zam[r] >= 0
# vf 6: am は逆向きの生きた読み、同じ束の読みは bm へ（max なので 2 が勝つ）
zrdq[zopp[r]] <- r * 128 + 1 for (r) in 0 .. znrm[0] if zhopp[r]
      if zopp[r] >= 0
zrdq[zam[r]] <- r * 128 + 2 for (r) in 0 .. znrm[0] if zhopp[r]
      if zam[r] >= 0
zrdq[zam2[r]] <- r * 128 + 2 for (r) in 0 .. znrm[0] if zhasa[r]
      if zns[r] == 2 if zam2[r] >= 0
zrdq[zmis[r]] <- r * 128 + 58 for (r) in 0 .. znrm[0] if zhasm[r]
      if zmis[r] >= 0
zrdq[zmis2[r]] <- r * 128 + 59 for (r) in 0 .. znrm[0] if zhasm[r]
      if zmis2[r] >= 1
field zrdf : max bound 8192             # その読みの場
zrdf[o] <- ofl[o] - 1 for (o) in 0 .. nocz[0] if zrdq[o] >= 0
zmu[zrdq[o]] <- true for (o) in 0 .. nocz[0] if zrdq[o] >= 0
# 次元ごとの定数の寄与（q0 + q1）。歩幅は 次元0 が zfs0、次元1 が 1。
# **家の値は 読み×読み まで**（(読み − 読み) × 読み は一次式でない）——
# 「定数 − 下端」を一度場に置いてから歩幅を掛ける（前段は自分が家になる形で書く）。
field zdl0 : max bound 8192            # 次元0 の座標の定数 − 下端
zdl0[o] <- zdc[o, 0] - zflo0[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 0] == 4
zdl0[o] <- zdof[o, 0] - zflo0[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 0] <= 1
zdl0[o] <- zdof[o, 0] - zflo0[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 0] == 7
field zq0 : max bound 8192
zq0[o] <- 0 for (o) in 0 .. nocz[0] if zrdq[o] >= 0 if zoar0[o]
zq0[o] <- zdl0[o] * zfs0[zrdf[o]] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
field zdl1 : max bound 8192            # 次元1 の座標の定数 − 下端
zdl1[o] <- zdc[o, 1] - zflo1[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 1] == 4
zdl1[o] <- zdof[o, 1] - zflo1[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 1] <= 1
zdl1[o] <- zdof[o, 1] - zflo1[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdrd1[o]
field zq1 : max bound 8192
zq1[o] <- 0 for (o) in 0 .. nocz[0] if zrdq[o] >= 0 if not has1[o]
zq1[o] <- zdl1[o] * zfs1[zrdf[o]] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
field zq2 : max bound 8192
zq2[o] <- 0 for (o) in 0 .. nocz[0] if zrdq[o] >= 0 if not zhas2[o]
zq2[o] <- zdc[o, 2] - zflo2[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 2] == 4
zq2[o] <- zdof[o, 2] - zflo2[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 2] <= 1
zq2[o] <- zdof[o, 2] - zflo2[zrdf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 2] == 7
field zq01 : max bound 8192            # 次元 0・1 の定数の寄与
zq01[o] <- zq0[o] + zq1[o] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
field zqs : max bound 8192             # 三次元ぶんの定数の寄与
zqs[o] <- zq01[o] + zq2[o] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
zmc[zrdq[o]] <- zfb[zrdf[o]] + zqs[o] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
# 枠: 次元0 の変数 → 枠0（歩幅 zfs0）、次元1 の変数 → 枠1（歩幅 1）
zmj0[zrdq[o]] <- zdj[o, 0] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 0] <= 1
zmc0[zrdq[o]] <- zdc[o, 0] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 0] <= 1
zmm0[zrdq[o]] <- zfs0[zrdf[o]] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 0] <= 1
# 読み + 変数: 変数の枠（間接は種7 の道がそのまま）
zmj0[zrdq[o]] <- zdj[o, 0] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zd0rv[o]
zmc0[zrdq[o]] <- zdc[o, 0] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zd0rv[o]
zmm0[zrdq[o]] <- zfs0[zrdf[o]] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zd0rv[o]
zmj1[zrdq[o]] <- zdj[o, 1] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 1] <= 1
zmc1[zrdq[o]] <- zdc[o, 1] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 1] <= 1
zmm1[zrdq[o]] <- zfs1[zrdf[o]] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 1] <= 1
zmj1[zrdq[o]] <- zdj[o, 1] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 1] == 8
zmc1[zrdq[o]] <- zdc[o, 1] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 1] == 8
zmm1[zrdq[o]] <- zfs1[zrdf[o]] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 1] == 8
zmj2[zrdq[o]] <- zdj[o, 2] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 2] <= 1
zmc2[zrdq[o]] <- zdc[o, 2] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 2] <= 1
zmm2[zrdq[o]] <- 1 for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 2] <= 1
# 間接: 読みの添字の中の読みは、どの枠の読みでも同じ形 ——
# 「どの枠か」が番地の面の枠 u と内側の写像の番号を決める。**表で引く**
#（場合分けを作らない）: 枠 k → (u₀, u₁, 内側の写像₀, 内側の写像₁)。
field zu0k : max bound 64
zu0k[0] <- 5
zu0k[1] <- 8
zu0k[2] <- 10
zu0k[58] <- 12
zu0k[59] <- 14
field zu1k : max bound 64
zu1k[0] <- 6
zu1k[1] <- 9
zu1k[2] <- 11
zu1k[58] <- 13
zu1k[59] <- 15
field zm0k : max bound 64
zm0k[0] <- 48
zm0k[1] <- 50
zm0k[2] <- 52
zm0k[58] <- 54
zm0k[59] <- 56
field zm1k : max bound 64
zm1k[0] <- 49
zm1k[1] <- 51
zm1k[2] <- 53
zm1k[58] <- 55
zm1k[59] <- 57
# zrk は flat（LVar）—— 内側の読みの枠は外側の枠から **同じ層の中で**
# 導かれる（入れ子の深さぶんの再帰）。flat の座標読みは単調なので、
# この再帰は成層を要らない（⊥ → v で止まる升だけを読む）。
field zrk : flat bound 8192             # 出現 o の枠番号（m − r·64）
zrk[o] <- zrdq[o] - zsr[o] * 128 for (o) in 0 .. nocz[0] if zsr[o] >= 0
zfpu[zsr[o], zu0k[zrk[o]]] <- true for (o) in 0 .. nocz[0]
      if zdk[o, 0] == 7
zfpu[zsr[o], zu1k[zrk[o]]] <- true for (o) in 0 .. nocz[0]
      if zdrdb[o]
zrdq[zdro[o, 0]] <- zsr[o] * 128 + zm0k[zrk[o]] for (o) in 0 .. nocz[0]
      if zdk[o, 0] == 7 if zdro[o, 0] >= 0
zrdq[zdrob[o]] <- zsr[o] * 128 + zm1k[zrk[o]] for (o) in 0 .. nocz[0]
      if zdrdb[o] if zdrob[o] >= 0
zmia[zrdq[o]] <- zfs0[zrdf[o]] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 0] == 7 if zu0k[zrk[o]] >= 1
zmib[zrdq[o]] <- zfpb[zsr[o], zu0k[zrk[o]]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 0] == 7 if zrk[o] >= 0
      if zu0k[zrk[o]] >= 1 if zfpb[zsr[o], zu0k[zrk[o]]] >= 1
zmiu[zrdq[o]] <- 1 for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 0] == 7 if zu0k[zrk[o]] >= 1
zmia2[zrdq[o]] <- zfsb[o] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdrdb[o] if zdk[o, 1] <= 7 if zu1k[zrk[o]] >= 1 if not zh3r[o]
zmia2[zrdq[o]] <- zfsb[o] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 1] == 8 if zd1sg[o] == 1 if zu1k[zrk[o]] >= 1
zmia2[zrdq[o]] <- 0 - zfsb[o] for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 1] == 8 if zd1sg[o] == 2 if zu1k[zrk[o]] >= 1
zmib2[zrdq[o]] <- zfpb[zsr[o], zu1k[zrk[o]]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdrdb[o] if zrk[o] >= 0
      if zu1k[zrk[o]] >= 1 if zfpb[zsr[o], zu1k[zrk[o]]] >= 1
      if not zh3r[o]
zmiu2[zrdq[o]] <- 1 for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdrdb[o] if zu1k[zrk[o]] >= 1
# 内側の読みの fp（束: 閉じていれば +束、生きた flat は −5）と写像
field zinf : max bound 8192             # 内側の読みの場（次元0）
zinf[o] <- ofl[zdro[o, 0]] - 1 for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdk[o, 0] == 7 if zdro[o, 0] >= 0
field zinf1 : max bound 8192            # 内側の読みの場（次元1）
zinf1[o] <- ofl[zdrob[o]] - 1 for (o) in 0 .. nocz[0] if zrdq[o] >= 0
      if zdrdb[o] if zdrob[o] >= 0
zfplt[zsr[o], zu0k[zrk[o]]] <- zlatf[zinf[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 0] == 7 if zu0k[zrk[o]] >= 1
      if zinf[o] >= 0 if zfws[zinf[o]] <= zfgst[zsr[o]] - 1
zfplt[zsr[o], zu0k[zrk[o]]] <- 0 - 5 for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdk[o, 0] == 7 if zu0k[zrk[o]] >= 1
      if zinf[o] >= 0 if zlatf[zinf[o]] == 5 if zfws[zinf[o]] >= zfgst[zsr[o]]
zfplt[zsr[o], zu1k[zrk[o]]] <- zlatf[zinf1[o]] for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdrdb[o] if zu1k[zrk[o]] >= 1
      if zinf1[o] >= 0 if zfws[zinf1[o]] <= zfgst[zsr[o]] - 1
zfplt[zsr[o], zu1k[zrk[o]]] <- 0 - 5 for (o) in 0 .. nocz[0]
      if zrdq[o] >= 0 if zdrdb[o] if zu1k[zrk[o]] >= 1
      if zinf1[o] >= 0 if zlatf[zinf1[o]] == 5
      if zfws[zinf1[o]] >= zfgst[zsr[o]]
zfpam[zsr[o], zu0k[zrk[o]]] <- zsr[o] * 128 + zm0k[zrk[o]]
      for (o) in 0 .. nocz[0] if zrdq[o] >= 0 if zdk[o, 0] == 7
      if zu0k[zrk[o]] >= 1
zfpam[zsr[o], zu1k[zrk[o]]] <- zsr[o] * 128 + zm1k[zrk[o]]
      for (o) in 0 .. nocz[0] if zrdq[o] >= 0 if zdrdb[o]
      if zu1k[zrk[o]] >= 1

# ── 深い入れ子（読みの中の読みの中の読み …、hf[snum[k]] の外側）────
# 表 zu0k/zm0k は一段しか言えない。深い出現の枠と写像は **規則ごとの
# 前置きの鎖**で配る（可変長の置き場は必ず前置きの鎖）。判定は構文だけ ——
# 「親を持つ読みで、なお読みを持つ」。番地の流れは外から内へ、oseq に
# 沿って後ろへしか指さないので、鎖は一巡で閉じる。
field ztbl : or bound 8192              # 表 zu0k が席を持つ出現（dm/am/鎖）
ztbl[zho[r]] <- true for (r) in 0 .. znrm[0] if zho[r] >= 0
ztbl[zam[r]] <- true for (r) in 0 .. znrm[0] if zam[r] >= 0
ztbl[zam2[r]] <- true for (r) in 0 .. znrm[0] if zam2[r] >= 0
ztbl[zmis[r]] <- true for (r) in 0 .. znrm[0] if zmis[r] >= 0
ztbl[zmis2[r]] <- true for (r) in 0 .. znrm[0] if zmis2[r] >= 1
ztbl[zchoc[s]] <- true for (s) in 0 .. nstz[0] if zchoc[s] >= 0
ztbl[zchpoc[s]] <- true for (s) in 0 .. nstz[0] if zchpoc[s] >= 0
ztbl[zchdo1[s]] <- true for (s) in 0 .. nstz[0] if zchdo1[s] >= 0
ztbl[zchdo2[s]] <- true for (s) in 0 .. nstz[0] if zchdo2[s] >= 0
field zisua : or bound 8192             # 出現 o は構成子の使用の引数
zisua[zuao[u, k]] <- true for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zuao[u, k] >= 0
zisua[zua1o[u, k]] <- true for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zua1o[u, k] >= 0
zisua[zua2o[u, k]] <- true for (u) in 0 .. znusem[0] for (k) in 0 .. 7
      if zua2o[u, k] >= 0
field zdin : or bound 8192              # 出現 o は内側の読み（親がいる）
zdin[zdro[o, 0]] <- true for (o) in 0 .. nocz[0] if zdk[o, 0] == 7
      if zdro[o, 0] >= 0
zdin[zdrob[o]] <- true for (o) in 0 .. nocz[0] if zdrdb[o]
      if zdrob[o] >= 0
field zdpo : or bound 8192              # 鎖で席を配る親（表に席が無く、読みを持つ）
zdpo[o] <- true for (o) in 0 .. nocz[0] if not ztbl[o] if zdk[o, 0] == 7
zdpo[o] <- true for (o) in 0 .. nocz[0] if not ztbl[o] if zdrdb[o]
# 内側の読みは席が鎖から来る —— zam に拾われていても鎖が親（head の arrow）
zdpo[o] <- true for (o) in 0 .. nocz[0] if zdin[o] if zdk[o, 0] == 7
zdpo[o] <- true for (o) in 0 .. nocz[0] if zdin[o] if zdrdb[o]
# 使用の引数の読みは席が 64+k / 124+k —— zam に拾われていても鎖が親
zdpo[o] <- true for (o) in 0 .. nocz[0] if zisua[o] if zdk[o, 0] == 7
zdpo[o] <- true for (o) in 0 .. nocz[0] if zisua[o] if zdrdb[o]
field zdpc : max bound 8192             # 文の中の深い親の数（o まで。鎖）
zdpc[0] <- 0 for (z) in 0 .. 0 if not zdpo[0]
zdpc[0] <- 1 for (z) in 0 .. 0 if zdpo[0]
zdpc[o] <- zdpc[o-1] for (o) in 1 .. nocz[0] if osn[o] == osn[o-1]
      if not zdpo[o]
zdpc[o] <- zdpc[o-1] + 1 for (o) in 1 .. nocz[0] if osn[o] == osn[o-1]
      if zdpo[o]
zdpc[o] <- 0 for (o) in 1 .. nocz[0] if osn[o] != osn[o-1] if not zdpo[o]
zdpc[o] <- 1 for (o) in 1 .. nocz[0] if osn[o] != osn[o-1] if zdpo[o]
field zdu0 : max bound 8192             # 深い親の枠（次元0。次元1 は +1）
zdu0[o] <- zdpc[o] * 2 + 66 for (o) in 0 .. nocz[0] if zdpo[o]
      if zdpc[o] >= 1
field zdm0v : max bound 8192            # 深い親の内側の写像（次元0。次元1 は +1）
zdm0v[o] <- zdpc[o] * 2 + 74 for (o) in 0 .. nocz[0] if zdpo[o]
      if zdpc[o] >= 1
zfpu[zsr[o], zdu0[o]] <- true for (o) in 0 .. nocz[0] if zdpo[o]
      if zdk[o, 0] == 7 if zdu0[o] >= 68 if zdu0[o] <= 126
      if zrdq[o] >= 0
zfpu[zsr[o], zdu0[o] + 1] <- true for (o) in 0 .. nocz[0] if zdpo[o]
      if zdrdb[o] if zdu0[o] >= 68 if zdu0[o] <= 126
      if zrdq[o] >= 0
zrdq[zdro[o, 0]] <- zsr[o] * 128 + zdm0v[o] for (o) in 0 .. nocz[0]
      if zdpo[o] if zdk[o, 0] == 7 if zdro[o, 0] >= 0 if zdm0v[o] >= 76
zrdq[zdrob[o]] <- zsr[o] * 128 + zdm0v[o] + 1 for (o) in 0 .. nocz[0]
      if zdpo[o] if zdrdb[o] if zdrob[o] >= 0 if zdm0v[o] >= 76
zmia[zrdq[o]] <- zfs0[zrdf[o]] for (o) in 0 .. nocz[0] if zdpo[o]
      if zrdq[o] >= 0 if zdk[o, 0] == 7 if zdu0[o] >= 68
zmib[zrdq[o]] <- zfpb[zsr[o], zdu0[o]] for (o) in 0 .. nocz[0] if zdpo[o]
      if zrdq[o] >= 0 if zdk[o, 0] == 7 if zdu0[o] >= 68
      if zfpb[zsr[o], zdu0[o]] >= 1
zmiu[zrdq[o]] <- 1 for (o) in 0 .. nocz[0] if zdpo[o]
      if zrdq[o] >= 0 if zdk[o, 0] == 7 if zdu0[o] >= 68
zmia2[zrdq[o]] <- zfsb[o] for (o) in 0 .. nocz[0] if zdpo[o]
      if zrdq[o] >= 0 if zdrdb[o] if zdk[o, 1] <= 7 if zdu0[o] >= 68
zmia2[zrdq[o]] <- zfsb[o] for (o) in 0 .. nocz[0] if zdpo[o]
      if zrdq[o] >= 0 if zdk[o, 1] == 8 if zd1sg[o] == 1 if zdu0[o] >= 68
zmia2[zrdq[o]] <- 0 - zfsb[o] for (o) in 0 .. nocz[0] if zdpo[o]
      if zrdq[o] >= 0 if zdk[o, 1] == 8 if zd1sg[o] == 2 if zdu0[o] >= 68
zmib2[zrdq[o]] <- zfpb[zsr[o], zdu0[o] + 1] for (o) in 0 .. nocz[0]
      if zdpo[o] if zrdq[o] >= 0 if zdrdb[o] if zdu0[o] >= 68
      if zfpb[zsr[o], zdu0[o] + 1] >= 1
zmiu2[zrdq[o]] <- 1 for (o) in 0 .. nocz[0] if zdpo[o]
      if zrdq[o] >= 0 if zdrdb[o] if zdu0[o] >= 68
zfplt[zsr[o], zdu0[o]] <- zlatf[zinf[o]] for (o) in 0 .. nocz[0]
      if zdpo[o] if zrdq[o] >= 0 if zdk[o, 0] == 7 if zdu0[o] >= 68
      if zinf[o] >= 0 if zfws[zinf[o]] <= zfgst[zsr[o]] - 1
zfplt[zsr[o], zdu0[o]] <- 0 - zlatf[zinf[o]] for (o) in 0 .. nocz[0]
      if zdpo[o] if zrdq[o] >= 0 if zdk[o, 0] == 7 if zdu0[o] >= 68
      if zinf[o] >= 0 if zlva[zinf[o]] if zfws[zinf[o]] >= zfgst[zsr[o]]
zfplt[zsr[o], zdu0[o] + 1] <- zlatf[zinf1[o]] for (o) in 0 .. nocz[0]
      if zdpo[o] if zrdq[o] >= 0 if zdrdb[o] if zdu0[o] >= 68
      if zinf1[o] >= 0 if zfws[zinf1[o]] <= zfgst[zsr[o]] - 1
zfplt[zsr[o], zdu0[o] + 1] <- 0 - zlatf[zinf1[o]] for (o) in 0 .. nocz[0]
      if zdpo[o] if zrdq[o] >= 0 if zdrdb[o] if zdu0[o] >= 68
      if zinf1[o] >= 0 if zlva[zinf1[o]]
      if zfws[zinf1[o]] >= zfgst[zsr[o]]
zfpam[zsr[o], zdu0[o]] <- zsr[o] * 128 + zdm0v[o] for (o) in 0 .. nocz[0]
      if zdpo[o] if zrdq[o] >= 0 if zdk[o, 0] == 7 if zdu0[o] >= 68
zfpam[zsr[o], zdu0[o] + 1] <- zsr[o] * 128 + zdm0v[o] + 1
      for (o) in 0 .. nocz[0] if zdpo[o] if zrdq[o] >= 0 if zdrdb[o]
      if zdu0[o] >= 68


# ── 次元2 の読み（trow[nm[..], rn[k], cn[k]]）—— 間接は二本のまま、
# 次元1 と次元2 を fp 種7 で一本に畳む（μ = 次元1 の歩幅、ν = 1）。
field zh3r : or bound 8192              # 三つの次元がぜんぶ読み
zh3r[o] <- true for (o) in 0 .. nocz[0] if zdk[o, 0] == 7
      if zdrd1[o] if zdk[o, 2] == 7
zdro[o, 2] <- oseq[zd2[o]] for (o) in 0 .. nocz[0] if zdk[o, 2] == 7
      if zd2[o] >= 0
zrdq[zdro[o, 2]] <- zsr[o] * 128 + 127 for (o) in 0 .. nocz[0]
      if zh3r[o] if zdro[o, 2] >= 0
field zinf2 : max bound 8192            # 次元2 の内側の読みの場
zinf2[o] <- ofl[zdro[o, 2]] - 1 for (o) in 0 .. nocz[0] if zh3r[o]
      if zdro[o, 2] >= 0
zfpu[zsr[o], 94] <- true for (o) in 0 .. nocz[0] if zh3r[o]
      if zrdq[o] >= 0
zfplt[zsr[o], 94] <- zlatf[zinf2[o]] for (o) in 0 .. nocz[0] if zh3r[o]
      if zrdq[o] >= 0 if zinf2[o] >= 0
      if zfws[zinf2[o]] <= zfgst[zsr[o]] - 1
zfplt[zsr[o], 94] <- 0 - 5 for (o) in 0 .. nocz[0] if zh3r[o]
      if zrdq[o] >= 0 if zinf2[o] >= 0 if zlatf[zinf2[o]] == 5
      if zfws[zinf2[o]] >= zfgst[zsr[o]]
zfpam[zsr[o], 94] <- zsr[o] * 128 + 127 for (o) in 0 .. nocz[0]
      if zh3r[o] if zrdq[o] >= 0
zfpu[zsr[o], 95] <- true for (o) in 0 .. nocz[0] if zh3r[o]
      if zrdq[o] >= 0
zfpk[zsr[o], 95] <- 7 for (o) in 0 .. nocz[0] if zh3r[o] if zrdq[o] >= 0
zfpmo[zsr[o], 95] <- zfs1[zrdf[o]] for (o) in 0 .. nocz[0] if zh3r[o]
      if zrdq[o] >= 0
zfpx[zsr[o], 95] <- 1 for (o) in 0 .. nocz[0] if zh3r[o] if zrdq[o] >= 0
zfplt[zsr[o], 95] <- 0 for (o) in 0 .. nocz[0] if zh3r[o] if zrdq[o] >= 0
zfpsr[zsr[o], 95] <- zfpb[zsr[o], zu1k[zrk[o]]] for (o) in 0 .. nocz[0]
      if zh3r[o] if zrdq[o] >= 0 if zu1k[zrk[o]] >= 1
      if zfpb[zsr[o], zu1k[zrk[o]]] >= 1
zfpsr[zsr[o], 95] <- zfpb[zsr[o], zdu0[o] + 1] for (o) in 0 .. nocz[0]
      if zh3r[o] if zrdq[o] >= 0 if zdpo[o] if zdu0[o] >= 68
      if zfpb[zsr[o], zdu0[o] + 1] >= 1
zfps2[zsr[o], 95] <- zfpb[zsr[o], 94] for (o) in 0 .. nocz[0]
      if zh3r[o] if zrdq[o] >= 0 if zfpb[zsr[o], 94] >= 1
zfpam[zsr[o], 95] <- zsr[o] * 128 + 4 for (o) in 0 .. nocz[0]
      if zh3r[o] if zrdq[o] >= 0
zmia2[zrdq[o]] <- 1 for (o) in 0 .. nocz[0] if zh3r[o] if zrdq[o] >= 0
zmib2[zrdq[o]] <- zfpb[zsr[o], 95] for (o) in 0 .. nocz[0] if zh3r[o]
      if zrdq[o] >= 0 if zfpb[zsr[o], 95] >= 1
zmiu2[zrdq[o]] <- 1 for (o) in 0 .. nocz[0] if zh3r[o] if zrdq[o] >= 0

# ── zam / zmis を枠へ写す規則は閉じた値だけを見る（min は動く。気づき24）──
# （上の zrdq の規則に比較の門を足した形で書き直してある）

# ── 値の一次式: 定数の和と、変数の枠 ────────────────────────────────
field ztrue : or bound 4096             # 値が true の文
ztrue[snum[t]] <- true for (t,zc) in ch if kwtru[t] if aftarw[t]
      if cnum[t] == 0 if tdep[t] == 0
field zkwfls : or bound 524288          # `false` の語
zkwfls[t] <- true for (t,zc) in ch if tlen[t] == 5 if not tcom[t]
      if tch[t,0] == 102 if tch[t,1] == 97 if tch[t,2] == 108
      if tch[t,3] == 115 if tch[t,4] == 101
field zfalse : or bound 4096            # 値が false の文
zfalse[snum[t]] <- true for (t,zc) in ch if zkwfls[t] if aftarw[t]
      if cnum[t] == 0 if tdep[t] == 0
field zhask : or bound 4096             # 定数の項がある（規則）
zhask[zrn[snum[t]]] <- true for (t,zc) in ch if istrmn[t]
      if zrn[snum[t]] >= 0 if trkd[snum[t], tcnt[t]] <= 5
field zwks : sum bound 4096             # 定数の項の和（符号つき）
zwks[zrn[snum[t]]] <- trvl[snum[t], tcnt[t]] for (t,zc) in ch if istrmn[t]
      if zrn[snum[t]] >= 0 if trkd[snum[t], tcnt[t]] == 1
zwks[zrn[snum[t]]] <- 0 - trvl[snum[t], tcnt[t]] for (t,zc) in ch if istrmn[t]
      if zrn[snum[t]] >= 0 if trkd[snum[t], tcnt[t]] == 5
field zvarl : or bound 524288           # 変数の項（列 / 計数器、符号つき）
zvarl[t] <- true for (t,zc) in ch if istrmv[t] if trkd[snum[t], tcnt[t]] == 2
      if not zchav[snum[t]]
zvarl[t] <- true for (t,zc) in ch if istrmv[t] if trkd[snum[t], tcnt[t]] == 4
      if not zchav[snum[t]]
zvarl[t] <- true for (t,zc) in ch if istrmv[t] if trkd[snum[t], tcnt[t]] == 11
zvarl[t] <- true for (t,zc) in ch if istrmv[t] if trkd[snum[t], tcnt[t]] == 13
field zvis : or bound 4096 8            # 文 s の項 i は変数の項
zvis[snum[t], tcnt[t]] <- true for (t,zc) in ch if zvarl[t]
field zvac : max bound 4096 8           # 項 i より前の変数の項の数（枠番号）
zvac[s, 0] <- 0 for (s) in 0 .. nstz[0]
zvac[s, i] <- zvac[s, i-1] for (s) in 0 .. nstz[0] for (i) in 1 .. 7
      if not zvis[s, i-1]
zvac[s, i] <- zvac[s, i-1] + 1 for (s) in 0 .. nstz[0] for (i) in 1 .. 7
      if zvis[s, i-1]
field zvsj : max bound 4096 4           # 枠 k の軸 j
zvsj[snum[t], zvac[snum[t], tcnt[t]]] <- zvlpz[t] for (t,zc) in ch
      if zvarl[t] if zvac[snum[t], tcnt[t]] >= 0
field zvscc : max bound 4096 4          # 枠 k の列
zvscc[snum[t], zvac[snum[t], tcnt[t]]] <- zvcolz[t] for (t,zc) in ch
      if zvarl[t] if zvac[snum[t], tcnt[t]] >= 0
      if lkd[snum[t], zvlpz[t]] == 0
zvscc[snum[t], zvac[snum[t], tcnt[t]]] <- 0 for (t,zc) in ch
      if zvarl[t] if zvac[snum[t], tcnt[t]] >= 0
      if lkd[snum[t], zvlpz[t]] >= 1
field zvco6 : or bound 524288           # 変数の項の次が `* 定数`
zvco6[t] <- true for (t,zc) in ch if istrmv[t]
      if trkd[snum[t], tcnt[t] + 1] == 6
field zvsm : max bound 4096 4           # 枠 k の係数（± 定数）
zvsm[snum[t], zvac[snum[t], tcnt[t]]] <- 1 for (t,zc) in ch
      if zvarl[t] if zvac[snum[t], tcnt[t]] >= 0
      if trkd[snum[t], tcnt[t]] <= 4 if not zvco6[t]
zvsm[snum[t], zvac[snum[t], tcnt[t]]] <- 0 - 1 for (t,zc) in ch
      if zvarl[t] if zvac[snum[t], tcnt[t]] >= 0
      if trkd[snum[t], tcnt[t]] >= 11 if not zvco6[t]
zvsm[snum[t], zvac[snum[t], tcnt[t]]] <- trvl[snum[t], tcnt[t] + 1]
      for (t,zc) in ch if zvarl[t] if zvac[snum[t], tcnt[t]] >= 0
      if trkd[snum[t], tcnt[t]] <= 4 if zvco6[t]
zvsm[snum[t], zvac[snum[t], tcnt[t]]] <- 0 - trvl[snum[t], tcnt[t] + 1]
      for (t,zc) in ch if zvarl[t] if zvac[snum[t], tcnt[t]] >= 0
      if trkd[snum[t], tcnt[t]] >= 11 if zvco6[t]
field zvn : max bound 4096              # 文 s の変数の枠の数
zvn[s] <- 0 for (s) in 0 .. nstz[0]
zvn[s] <- zvac[s, i] + 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zvis[s, i]

# ── wm（枠 3）: 定数 + 変数の枠 + 束ちがいの読みの間接 ──────────────
field zwm : max bound 4096              # 規則 r の wm の枠（true なら零）
zwm[zrn[s]] <- zrn[s] * 128 + 4 for (s) in 0 .. nstz[0] if zisr[s]
      if ztrue[s] if zrn[s] >= 0
zwm[zrn[s]] <- zrn[s] * 128 + 3 for (s) in 0 .. nstz[0] if zisr[s]
      if not ztrue[s] if zrn[s] >= 0
zmu[zrw3[s]] <- true for (s) in 0 .. nstz[0] if zisr[s]
      if not ztrue[s] if zrn[s] >= 0
zmc[zrw3[s]] <- zwks[zrn[s]] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zhask[zrn[s]]
zmc[zrw3[s]] <- 0 for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if not zhask[zrn[s]] if not ztrue[s]
zmn[zrw3[s]] <- zvn[s] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if not ztrue[s] if zvn[s] >= 0
zmj0[zrw3[s]] <- zvsj[s, 0] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zvn[s] >= 1
zmc0[zrw3[s]] <- zvscc[s, 0] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zvn[s] >= 1
zmm0[zrw3[s]] <- zvsm[s, 0] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zvn[s] >= 1
zmj1[zrw3[s]] <- zvsj[s, 1] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zvn[s] >= 2
zmc1[zrw3[s]] <- zvscc[s, 1] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zvn[s] >= 2
zmm1[zrw3[s]] <- zvsm[s, 1] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zvn[s] >= 2
zmj2[zrw3[s]] <- zvsj[s, 2] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zvn[s] >= 3
zmc2[zrw3[s]] <- zvscc[s, 2] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zvn[s] >= 3
zmm2[zrw3[s]] <- zvsm[s, 2] for (s) in 0 .. nstz[0] if zisr[s]
      if zrn[s] >= 0 if zvn[s] >= 3

# ── 番地の面の枠（fp）。u: 0..2 ガード左 / 3,4 束ちがいの読み・鎖 ────
field zfpu : or bound 4096 128           # 使っている枠
zfpu[r, 3] <- true for (r) in 0 .. znrm[0] if zhasm[r]
zfpu[r, 4] <- true for (r) in 0 .. znrm[0] if zhasm[r] if zmis2[r] >= 1
zfpu[zchr[s], 3] <- true for (s) in 0 .. nstz[0] if zchn[s] if zchr[s] >= 0
zfpu[zchr[s], 3] <- true for (s) in 0 .. nstz[0] if zchpp[s] if zchr[s] >= 0
zfpu[zchr[s], 4] <- true for (s) in 0 .. nstz[0] if zchny[s] if zchr[s] >= 0
      if zchnn[s] >= 1
zfpu[zchr[s], 7] <- true for (s) in 0 .. nstz[0] if zchny[s] if zchr[s] >= 0
      if zchnn[s] >= 2
field zfpc : max bound 4096 128          # u までの使っている枠の数（u を含む）
zfpc[r, 0] <- 0 for (r) in 0 .. znr2m[0] if not zfpu[r, 0]
zfpc[r, 0] <- 1 for (r) in 0 .. znr2m[0] if zfpu[r, 0]
zfpc[r, u] <- zfpc[r, u-1] for (r) in 0 .. znr2m[0] for (u) in 1 .. 127
      if not zfpu[r, u]
zfpc[r, u] <- zfpc[r, u-1] + 1 for (r) in 0 .. znr2m[0] for (u) in 1 .. 127
      if zfpu[r, u]
field zfpn : max bound 4096             # 規則 r の枠の数
zfpn[r] <- zfpc[r, 31] for (r) in 0 .. znr2m[0] if zfpc[r, 31] >= 0
zfpn[r] <- zfpc[r, 63] for (r) in 0 .. znr2m[0] if zfpc[r, 63] >= 0
zfpn[r] <- zfpc[r, 127] for (r) in 0 .. znr2m[0] if zfpc[r, 127] >= 0
field zpab : max bound 4096             # 規則 r の番地の面の基（前置きの鎖）
zpab[0] <- 1
zpab[r] <- zpab[r-1] + zfpn[r-1] * zsszr[r-1] for (r) in 1 .. znr2m[0]
field zfpi : max bound 4096 128          # 枠 u の番号（0 起点）—— 家の値は 読み + 読み×読み まで
zfpi[r, u] <- zfpc[r, u] - 1 for (r) in 0 .. znr2m[0] for (u) in 0 .. 127
      if zfpu[r, u]
field zfpb : max bound 4096 128          # 枠 u の番地の面の基
zfpb[r, u] <- zpab[r] + zfpi[r, u] * zsszr[r] for (r) in 0 .. znr2m[0]
      for (u) in 0 .. 127 if zfpu[r, u] if zpab[r] >= 1

# wm の間接（束ちがい・係数つきの読みは番地の面から足す。係数は m に畳む）
zmia[r * 128 + 3] <- 1 for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r]
      if not zmco[zmis[r]] if not zoneg[zmis[r]]
zmia[r * 128 + 3] <- zocof[zmis[r]] for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r]
      if zmco[zmis[r]] if zocof[zmis[r]] >= 1 if not zoneg[zmis[r]]
zmia[r * 128 + 3] <- 0 - 1 for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r]
      if not zmco[zmis[r]] if zoneg[zmis[r]]
zmia[r * 128 + 3] <- 0 - zocof[zmis[r]] for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r]
      if zmco[zmis[r]] if zocof[zmis[r]] >= 1 if zoneg[zmis[r]]
zmib[r * 128 + 3] <- zfpb[r, 3] for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r]
      if zfpb[r, 3] >= 1
zmiu[r * 128 + 3] <- 1 for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r]
zmia2[r * 128 + 3] <- 1 for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r] if zmis2[r] >= 1
      if not zmco[zmis2[r]] if not zoneg[zmis2[r]]
zmia2[r * 128 + 3] <- zocof[zmis2[r]] for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r]
      if zmis2[r] >= 1 if zmco[zmis2[r]] if zocof[zmis2[r]] >= 1
      if not zoneg[zmis2[r]]
zmia2[r * 128 + 3] <- 0 - 1 for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r]
      if zmis2[r] >= 1 if not zmco[zmis2[r]] if zoneg[zmis2[r]]
zmia2[r * 128 + 3] <- 0 - zocof[zmis2[r]] for (r) in 0 .. znrm[0]
      if zhasm[r] if not zhprd[r] if zmis2[r] >= 1 if zmco[zmis2[r]]
      if zocof[zmis2[r]] >= 1 if zoneg[zmis2[r]]
zmib2[r * 128 + 3] <- zfpb[r, 4] for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r]
      if zmis2[r] >= 1 if zfpb[r, 4] >= 1
zmiu2[r * 128 + 3] <- 1 for (r) in 0 .. znrm[0] if zhasm[r] if not zhprd[r] if zmis2[r] >= 1

# ── 家のガード番号。33_self の gno2 は点の道の `cd` の行番号（比較は左右で
# 二行）なので 8 席に 4 つしか入らない。家では **if 節ひとつ = ガード一つ**
# —— 節ごとに +1 で数え直す（zgn）。種（2 否定 / 3 比較 / 9 肯定）も同じ番号で。
field zgcn : max bound 4096 32          # 節 c の手前までの家のガードの数（鎖）
zgcn[s, 0] <- 0 for (s) in 0 .. nstz[0]
zgcn[s, c] <- zgcn[s, c-1] for (s) in 0 .. nstz[0] for (c) in 1 .. 31
      if not clif2[s, c-1]
zgcn[s, c] <- zgcn[s, c-1] + 1 for (s) in 0 .. nstz[0] for (c) in 1 .. 31
      if clif2[s, c-1]
field zgn : max bound 262144            # そのトークンの属する家のガード番号
zgn[t] <- zgcn[snum[t], cnum[t]] for (t,zc) in ch
field zgkd : max bound 4096 32          # 家のガードの種（2 否定 / 3 比較 / 9 肯定）
zgkd[snum[t], zgn[t]] <- 3 for (t,zc) in ch if iscmp2[t]
zgkd[snum[t], zgn[t]] <- 2 for (t,zc) in ch if isgrd[t]
      if isneg[t] if not clcmp[snum[t], cnum[t]]
zgkd[snum[t], zgn[t]] <- 9 for (t,zc) in ch if isgrd[t]
      if not isneg[t] if not clcmp[snum[t], cnum[t]]

# ══ ガード ═════════════════════════════════════════════════════════
# 比較は (s, ガード番号) の左の行が持つ。演算子の左右のトークンから
# 「定数 / 変数（列・計数器）/ 升の読み」を見分け、写像に落とす。
field zgt : max bound 4096 8            # ガード i の演算子のトークン
zgt[snum[t], zgn[t]] <- t for (t,zc) in ch if iscmp2[t]
field zgl : max bound 4096 8            # 左辺の末尾のトークン
zgl[s, i] <- oppv[zgt[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgt[s, i] >= 0
field zgr : max bound 4096 8            # 右辺の先頭のトークン
zgr[s, i] <- opnx[zgt[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgt[s, i] >= 0
field zgop : max bound 4096 8           # 演算子（1 == / 2 != / 3 >= / 4 <= / 5 > / 6 <）
zgop[s, i] <- opc2[zgt[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgt[s, i] >= 0
field zglf : or bound 4096 8            # 左辺は升の読み
zglf[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgl[s, i] >= 0 if isclo[zgl[s, i]]
field zgrf : or bound 4096 8            # 右辺に升の読みがある
zgrf[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgro1m[s, i] >= 0
field zglo : max bound 4096 8           # 左辺の読みの出現
zglo[s, i] <- oseq[tmatch[zgl[s, i]]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zglf[s, i] if zgl[s, i] >= 0
field zglfd : max bound 4096 8          # 左辺の読みの場
zglfd[s, i] <- ofl[zglo[s, i]] - 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zglo[s, i] >= 0

# ── 読み ± 定数 の辺（match[k]+1 == k / k != parw[snum[k]]-1）────────
# ずれは cm/wm の写像の定数に入る（参照実装の pa の定数と同じ席）。
field zgof : or bound 4096 8            # 左辺は 読み + 定数
zgof[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgl[s, i] >= 0 if isnum[zgl[s, i]] if isplus[prevw[zgl[s, i]]]
      if isclo[prevw[prevw[zgl[s, i]]]]
field zgofm : or bound 4096 8           # 左辺は 読み − 定数
zgofm[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgl[s, i] >= 0 if isnum[zgl[s, i]] if ismin[prevw[zgl[s, i]]]
      if isclo[prevw[prevw[zgl[s, i]]]]
zglf[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7 if zgof[s, i]
zglf[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7 if zgofm[s, i]
zglo[s, i] <- oseq[tmatch[prevw[prevw[zgl[s, i]]]]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgof[s, i]
zglo[s, i] <- oseq[tmatch[prevw[prevw[zgl[s, i]]]]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgofm[s, i]
field zgrcl : max bound 4096 8          # 右の読みの閉じ括弧のトークン
zgrcl[s, i] <- tnum[zclch[tstart[nextw[zgr[s, i]]]]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgr[s, i] >= 0 if isocc[zgr[s, i]]
      if zclch[tstart[nextw[zgr[s, i]]]] >= 1
field zgrof : or bound 4096 8           # 右辺は 読み + 定数
zgrof[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgrcl[s, i] >= 0 if isplus[nextw[zgrcl[s, i]]]
      if isnum[nextw[nextw[zgrcl[s, i]]]]
field zgrofm : or bound 4096 8          # 右辺は 読み − 定数
zgrofm[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgrcl[s, i] >= 0 if ismin[nextw[zgrcl[s, i]]]
      if isnum[nextw[nextw[zgrcl[s, i]]]]
field zgrov : max bound 4096 8          # その符号つきの値
zgrov[s, i] <- tval[nextw[nextw[zgrcl[s, i]]]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgrof[s, i]
zgrov[s, i] <- 0 - tval[nextw[nextw[zgrcl[s, i]]]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgrofm[s, i]

# ── ガードの鎖: 左辺が `読み % 定数` —— 鎖も升である（pa に畳んで種1） ──
# 値の鎖（zchn）と同じ算術がガードにも乗る。読みを枠 32+i に写し、
# 剰余の枠 56+i を重ね、cm はその出口を指す間接だけの写像になる。
field zismod : or bound 262144          # トークンは一文字の `%`
zismod[t] <- true for (t,zc) in ch if tlen[t] == 1 if tch[t, 0] == 37
field zgch : or bound 4096 8            # ガード (s,i) の左辺は鎖
zgch[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgl[s, i] >= 0 if isnum[zgl[s, i]] if zismod[prevw[zgl[s, i]]]
      if isclo[prevw[prevw[zgl[s, i]]]]
field zgcmo : max bound 4096 8          # 鎖の法
zgcmo[s, i] <- tval[zgl[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgch[s, i]
field zgco : max bound 4096 8           # 鎖の芯の出現
zgco[s, i] <- oseq[tmatch[prevw[prevw[zgl[s, i]]]]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgch[s, i]
field zgcfd : max bound 4096 8          # 鎖の芯の場
zgcfd[s, i] <- ofl[zgco[s, i]] - 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgco[s, i] >= 0
# 芯が変数の鎖（`if i % 2 == 1`）—— 写しは要らず、(写像)%法（種1）一枚
field zgcha : or bound 4096 8
zgcha[s, i] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgl[s, i] >= 0 if isnum[zgl[s, i]] if zismod[prevw[zgl[s, i]]]
      if tkind[prevw[prevw[zgl[s, i]]]] == 1
      if not isnum[prevw[prevw[zgl[s, i]]]]
      if not isclo[prevw[prevw[zgl[s, i]]]]
field zgcav : max bound 4096 8          # その変数のトークン
zgcav[s, i] <- prevw[prevw[zgl[s, i]]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgcha[s, i]
zgcmo[s, i] <- tval[zgl[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgcha[s, i]

# ── 比較の種: 両辺が一次式なら 6、左が閉じた読みなら 1 ──────────────
field zfck : max bound 4096 8           # fc の種
field zfclt : max bound 4096 8          # fc の束
field zfcam : max bound 4096 8          # fc の左の写像（枠番号）
field zfcop : max bound 4096 8          # fc の演算子
field zfcwm : max bound 4096 8          # fc の右の写像（枠番号）
field zgrul : max bound 4096 8          # ガード (s,i) の規則番号
zgrul[s, i] <- zrn[s] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgt[s, i] >= 0 if zrn[s] >= 0
field zgm3 : max bound 4096 8           # ガードの三つ目の写像（10+3i）の番号
zgm3[s, i] <- zgrul[s, i] * 128 + 10 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgrul[s, i] >= 0

# 種6: 両辺とも読みでない（鎖でもない）
zfck[s, i] <- 6 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgt[s, i] >= 0 if not zglf[s, i] if not zgrf[s, i]
      if not zgch[s, i] if not zgcha[s, i]
zfclt[s, i] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgt[s, i] >= 0 if not zglf[s, i] if not zgrf[s, i]
      if not zgch[s, i] if not zgcha[s, i]
zfcop[s, i] <- zgop[s, i] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgt[s, i] >= 0 if not zgfl[s, i]
zfcam[s, i] <- zgrul[s, i] * 128 + 8 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgt[s, i] >= 0 if zgrul[s, i] >= 0
zfcwm[s, i] <- zgrul[s, i] * 128 + 9 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgt[s, i] >= 0 if zgrul[s, i] >= 0

# 種1: 左が閉じた読み（右は一次式）—— cm は番地の面の間接、読みは fp で写す
zfck[s, i] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zglf[s, i] if not zgrf[s, i] if zglfd[s, i] >= 0
      if zfws[zglfd[s, i]] <= zfgst[zgrul[s, i]] - 1
zfclt[s, i] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zglf[s, i] if not zgrf[s, i] if zglfd[s, i] >= 0
      if zfws[zglfd[s, i]] <= zfgst[zgrul[s, i]] - 1
# 種11: 左が生きた読み（単調な比較 —— 向きが合うので層を食っていない）。
# cm は読みの番地の写像そのもの（番地の面を通らない）。
zfck[s, i] <- 11 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zglf[s, i] if not zgrf[s, i] if zglfd[s, i] >= 0
      if zfws[zglfd[s, i]] >= zfgst[zgrul[s, i]] if zlatf[zglfd[s, i]] != 5
zfclt[s, i] <- zlatf[zglfd[s, i]] for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zglf[s, i] if not zgrf[s, i] if zglfd[s, i] >= 0
      if zfws[zglfd[s, i]] >= zfgst[zgrul[s, i]] if zlatf[zglfd[s, i]] != 5
zrdq[zglo[s, i]] <- zgrul[s, i] * 128 + 8 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zglf[s, i] if not zgrf[s, i]
      if zglo[s, i] >= 0 if zgrul[s, i] >= 0 if zglfd[s, i] >= 0
      if zfws[zglfd[s, i]] >= zfgst[zgrul[s, i]] if zlatf[zglfd[s, i]] != 5
# 生きた flat の左は種1 のまま（LVar は生きた面から pa へ。lt −5）
zfck[s, i] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zglf[s, i] if not zgrf[s, i] if zglfd[s, i] >= 0
      if zfws[zglfd[s, i]] >= zfgst[zgrul[s, i]] if zlatf[zglfd[s, i]] == 5
zfclt[s, i] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zglf[s, i] if not zgrf[s, i] if zglfd[s, i] >= 0
      if zfws[zglfd[s, i]] >= zfgst[zgrul[s, i]] if zlatf[zglfd[s, i]] == 5
zfpu[zgrul[s, i], i + 32] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zglf[s, i] if not zgrf[s, i] if zgrul[s, i] >= 0
      if zglfd[s, i] >= 0 if zfws[zglfd[s, i]] >= zfgst[zgrul[s, i]]
      if zlatf[zglfd[s, i]] == 5
zrdq[zglo[s, i]] <- zgrul[s, i] * 128 + 10 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zglf[s, i] if not zgrf[s, i]
      if zglo[s, i] >= 0 if zgrul[s, i] >= 0
      if zglfd[s, i] >= 0 if zfws[zglfd[s, i]] >= zfgst[zgrul[s, i]]
      if zlatf[zglfd[s, i]] == 5
zfplt[zgrul[s, i], i + 32] <- 0 - 5 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zglf[s, i] if not zgrf[s, i]
      if zglfd[s, i] >= 0 if zgrul[s, i] >= 0
      if zfws[zglfd[s, i]] >= zfgst[zgrul[s, i]] if zlatf[zglfd[s, i]] == 5
zfpam[zgrul[s, i], i + 32] <- zgrul[s, i] * 128 + 10 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zglf[s, i] if not zgrf[s, i] if zgrul[s, i] >= 0
      if zglfd[s, i] >= 0 if zfws[zglfd[s, i]] >= zfgst[zgrul[s, i]]
      if zlatf[zglfd[s, i]] == 5
zfpu[zgrul[s, i], i + 32] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zglf[s, i] if not zgrf[s, i] if zgrul[s, i] >= 0
      if zglfd[s, i] >= 0 if zfws[zglfd[s, i]] <= zfgst[zgrul[s, i]] - 1
zrdq[zglo[s, i]] <- zgrul[s, i] * 128 + 10 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zglf[s, i] if not zgrf[s, i]
      if zglo[s, i] >= 0 if zgrul[s, i] >= 0
      if zglfd[s, i] >= 0 if zfws[zglfd[s, i]] <= zfgst[zgrul[s, i]] - 1
field zfplt : max bound 4096 128         # fp の束（正 = 閉じた読み）
zfplt[zgrul[s, i], i + 32] <- zlatf[zglfd[s, i]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zglf[s, i] if not zgrf[s, i]
      if zglfd[s, i] >= 0 if zgrul[s, i] >= 0
      if zfws[zglfd[s, i]] <= zfgst[zgrul[s, i]] - 1
# 閉じた読みは正の束、生きた読みは負の束（定義が単調と認めた読みだけが
# 同じ層に居られる —— pcell と同じ判断。flat.py の (0, -束) と対）
zfplt[r, 3] <- zlatf[ofl[zmis[r]] - 1] for (r) in 0 .. znrm[0]
      if zhasm[r] if zmis[r] >= 0
      if zfws[ofl[zmis[r]] - 1] <= zfgst[r] - 1
zfplt[r, 3] <- 0 - zlatf[ofl[zmis[r]] - 1] for (r) in 0 .. znrm[0]
      if zhasm[r] if zmis[r] >= 0
      if zfws[ofl[zmis[r]] - 1] >= zfgst[r]
zfplt[r, 4] <- zlatf[ofl[zmis2[r]] - 1] for (r) in 0 .. znrm[0]
      if zhasm[r] if zmis2[r] >= 1
      if zfws[ofl[zmis2[r]] - 1] <= zfgst[r] - 1
zfplt[r, 4] <- 0 - zlatf[ofl[zmis2[r]] - 1] for (r) in 0 .. znrm[0]
      if zhasm[r] if zmis2[r] >= 1
      if zfws[ofl[zmis2[r]] - 1] >= zfgst[r]
field zfpam : max bound 4096 128         # fp の読みの写像（枠番号）
zfpam[zgrul[s, i], i + 32] <- zgrul[s, i] * 128 + 10 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zglf[s, i] if not zgrf[s, i] if zgrul[s, i] >= 0
      if zglfd[s, i] >= 0 if zfws[zglfd[s, i]] <= zfgst[zgrul[s, i]] - 1
zfpam[r, 3] <- r * 128 + 58 for (r) in 0 .. znrm[0] if zhasm[r]
zfpam[r, 4] <- r * 128 + 59 for (r) in 0 .. znrm[0] if zhasm[r]
      if zmis2[r] >= 1

# ── 鎖のガード —— 読みを枠 32+i に写し、剰余の枠 56+i を重ねる（種1） ──
zfck[s, i] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgch[s, i]
zfclt[s, i] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgch[s, i]
zrdq[zgco[s, i]] <- zgrul[s, i] * 128 + 10 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgch[s, i] if zgco[s, i] >= 0
      if zgrul[s, i] >= 0
zfpu[zgrul[s, i], i + 32] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgch[s, i] if zgrul[s, i] >= 0
zfplt[zgrul[s, i], i + 32] <- zlatf[zgcfd[s, i]] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgch[s, i] if zgrul[s, i] >= 0
      if zgcfd[s, i] >= 0 if zfws[zgcfd[s, i]] <= zfgst[zgrul[s, i]] - 1
zfplt[zgrul[s, i], i + 32] <- 0 - 5 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgch[s, i] if zgrul[s, i] >= 0
      if zgcfd[s, i] >= 0 if zlatf[zgcfd[s, i]] == 5
      if zfws[zgcfd[s, i]] >= zfgst[zgrul[s, i]]
zfpam[zgrul[s, i], i + 32] <- zgrul[s, i] * 128 + 10 + i * 3 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgch[s, i] if zgrul[s, i] >= 0
zfpu[zgrul[s, i], i + 56] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgch[s, i] if zgrul[s, i] >= 0
zfpk[zgrul[s, i], i + 56] <- 3 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgch[s, i] if zgrul[s, i] >= 0
zfpmo[zgrul[s, i], i + 56] <- zgcmo[s, i] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgch[s, i] if zgrul[s, i] >= 0
      if zgcmo[s, i] >= 1
zfpsr[zgrul[s, i], i + 56] <- zfpb[zgrul[s, i], i + 32] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgch[s, i] if zgrul[s, i] >= 0
      if zfpb[zgrul[s, i], i + 32] >= 1
zfplt[zgrul[s, i], i + 56] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgch[s, i] if zgrul[s, i] >= 0
zfpam[zgrul[s, i], i + 56] <- zgrul[s, i] * 128 + 4 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgch[s, i] if zgrul[s, i] >= 0
# cm = 定数 0 + 間接 (1, 鎖の出口, 1)
zmn[zgm[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgch[s, i]
zmc[zgm[s, i]] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgch[s, i]
zmia[zgm[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgch[s, i]
zmib[zgm[s, i]] <- zfpb[zgrul[s, i], i + 56] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgm[s, i] >= 1 if zgch[s, i]
      if zgrul[s, i] >= 0 if zfpb[zgrul[s, i], i + 56] >= 1
zmiu[zgm[s, i]] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgm[s, i] >= 1 if zgch[s, i]

# ── 芯が変数の鎖のガード（種1: (写像)%法。写しなし、枠 56+i 一枚） ──
zfck[s, i] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgcha[s, i]
zfclt[s, i] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgcha[s, i]
zfpu[zgrul[s, i], i + 56] <- true for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgcha[s, i] if zgrul[s, i] >= 0
zfpk[zgrul[s, i], i + 56] <- 1 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgcha[s, i] if zgrul[s, i] >= 0
zfpmo[zgrul[s, i], i + 56] <- zgcmo[s, i] for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgcha[s, i] if zgrul[s, i] >= 0
      if zgcmo[s, i] >= 1
zfplt[zgrul[s, i], i + 56] <- 0 for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgcha[s, i] if zgrul[s, i] >= 0
zfpam[zgrul[s, i], i + 56] <- zgrul[s, i] * 128 + 10 + i * 3
      for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgcha[s, i] if zgrul[s, i] >= 0
# 変数の写像（枠 10+3i）
zmu[zgm3[s, i]] <- true for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgcha[s, i] if zgrul[s, i] >= 0
zmc[zgm3[s, i]] <- 0 for (s) in 0 .. nstz[0]
      for (i) in 0 .. 7 if zgcha[s, i] if zgrul[s, i] >= 0
zmj0[zgm3[s, i]] <- zvlpz[zgcav[s, i]]
      for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgcha[s, i] if zgrul[s, i] >= 0 if zgcav[s, i] >= 0
zmc0[zgm3[s, i]] <- zvcolz[zgcav[s, i]]
      for (s) in 0 .. nstz[0] for (i) in 0 .. 7
      if zgcha[s, i] if zgrul[s, i] >= 0 if zgcav[s, i] >= 0
      if lkd[s, zvlpz[zgcav[s, i]]] == 0
zmc0[zgm3[s, i]] <- 0
